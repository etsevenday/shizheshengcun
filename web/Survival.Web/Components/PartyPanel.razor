@inherits GameComponent

@* B8（R08 §1—§4、A11 §5—§8；开发计划 v0.9 B8 M189）：右栏人物页顶部的“队伍”块——同行与候补各人的六项/病毒/速度/两件武器，
   营区（v3 前替身：临时营地）安全空闲时编入/留守、号位前后移、RB01 登记补员与借用矛报失；当前地点的遗物可取出。
   只读预览与禁用原因都来自内核同名 *Blocked 函数，按钮不另判。正式招募任务在后续批次，名册现在只能经 ?dev=1 加人。
   多人战斗（队友入场、逐人操作）未做，见开发计划 B8.4。 *@
@{
    var s = G.S;
    var e = G.E;
    var cap = e.PartyCapacity(s);
    var alive = s.Roster.Where(r => !r.Dead).ToList();
    var dead = s.Roster.Where(r => r.Dead).ToList();
    var remains = e.RemainsHere(s);
    var show = s.Roster.Count > 0 || remains.Count > 0;
    var care = e.Config.Party.ReserveCare;
}
@if (show)
{
    <section class="party-block" aria-label="队伍">
        <div class="party-head">
            <b>队伍 @s.Party.Count/@cap</b>
            <span class="muted tiny">容量 C@(cap) 含你 · 名册 @alive.Count 人存活@(dead.Count > 0 ? $"、{dead.Count} 人已故" : "")</span>
        </div>
        <div class="party-list">
            @* B8a（Q86）：号位来自 4 格编队预设（可空位、不连续），改号位统一走顶栏“编队”；这里只显示 *@
            @{ var slotsNow = e.RepairedFormation(s, s.FormationPreset); }
            @for (var k = 0; k < slotsNow.Count; k++)
            {
                if (slotsNow[k] == "") continue;
                @Row(slotsNow[k], $"{k + 1}号位", true)
            }
            @foreach (var r in e.Reserves(s))
            {
                @Row(r.ActorId, "候补", false)
            }
        </div>
        <div class="ca-note tiny">开战号位在顶栏“编队”里改（任何地点空闲时都可以）；编入同行/留作候补只在@(e.LocName(e.HubLocation(s)))办理。</div>
        @if (e.Reserves(s).Count > 0)
        {
            <div class="ca-note">候补留在@(e.LocName(e.HubLocation(s)))，接受公共照护：饱食/水分每段自然消耗后不低于@(Fmt.T(care.SatietyFloor))（只托底、不生成食水），22:00—06:00 遮蔽睡眠、其余时段等待；伤病与病毒照常发展。</div>
        }
        @{
            var rbWhy = e.EscortRegistrationBlocked(s);
            var slots = e.LoanSlotIds(s).Where(x => s.LoanSlots.ContainsKey(x)).ToList();
        }
        <div class="btn-row party-btns">
            <button type="button" class="secondary small-btn" disabled="@(rbWhy != null)" title="@(rbWhy ?? $"在{e.LocName(e.ShelterLocation(s))}（收容所服务）登记一名通用护送员（30分钟等待，全队按等待消耗）：技能均1级、速度4、借用木矛")" @onclick="() => G.StartEscortRegistration()">登记同行补员（30分钟）</button>
            @foreach (var slot in slots)
            {
                var sl = slot;
                var lostWhy = e.ReportLostLoanBlocked(s, sl);
                <button type="button" class="secondary small-btn" disabled="@(lostWhy != null)" title="@(lostWhy ?? $"借用矛确实已损毁或找不回：旧的作废，按固定模板（白色无词条、耐久30）新补一件，放在{e.LocName(e.ShelterLocation(s))}地面（不自动装备、不进谁的随身）")" @onclick="() => G.ReportLostLoan(sl)">报失借用矛（@sl）</button>
            }
        </div>
        @if (rbWhy != null)
        {
            <div class="ca-note tiny">补员：@rbWhy</div>
        }
        @foreach (var kv in remains)
        {
            var deadId = kv.Key;
            var rem = kv.Value;
            var items = e.RemainsItems(s, deadId);
            <div class="remains-card" data-remains="@deadId">
                <div><b>@(rem.Name)的遗物</b> <span class="muted tiny">死于@(Clock.DayTime(rem.Minute))（@rem.Cause）</span></div>
                @foreach (var it in items)
                {
                    var iid = it.InstanceId;
                    var whyCarry = e.TakeFromRemainsBlocked(s, deadId, iid, false);
                    var whyGround = e.TakeFromRemainsBlocked(s, deadId, iid, true);
                    <div class="remains-row">
                        <span>@e.ItemName(it.ItemId)@(it.Count > 1 ? $"×{it.Count}" : "")#@iid@(it.LoanSlot != null ? "（借用）" : "")</span>
                        <button type="button" class="eq-btn" disabled="@(whyCarry != null)" title="@(whyCarry ?? "取到你的随身（五张卡与30公斤校验）")" @onclick="() => G.TakeRemains(deadId, iid, false)">取到随身</button>
                        <button type="button" class="eq-btn" disabled="@(whyGround != null)" title="@(whyGround ?? "放到当前地面")" @onclick="() => G.TakeRemains(deadId, iid, true)">放地面</button>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private RenderFragment Row(string id, string where, bool active) => __builder =>
    {
        var s = G.S;
        var e = G.E;
        var a = s.Actor(id);
        var st = a.Stats;
        var isMe = id == GameState.PlayerId;
        var name = isMe ? "你" : e.ActorDisplayName(s, id);
        var w1 = e.WornItem(s, id, EquipSlots.Weapon1);
        var w2 = e.WornItem(s, id, EquipSlots.Weapon2);
        var weapons = string.Join(" / ", new[] { w1, w2 }.Select(w => w == null ? "空" : e.ItemName(w.ItemId) + (w.LoanSlot != null ? "（借用）" : "")));
        var toggleWhy = isMe ? null : e.SetActiveBlocked(s, id, !active);
        <div class="party-row @(active ? "" : "reserve")" data-actor="@id">
            @* M191（B8 试玩）：按钮并到姓名行右侧（窄时折到下一行），每人少占一行，1280×720 下最后一人的按钮不再落到右栏底部说明条下面 *@
            <div class="party-name"><span class="party-pos">@where</span> <b>@name</b> <span class="muted tiny">速度@(Fmt.T(e.ActorBaseSpeed(s, id)))</span>
            @if (!isMe)
            {
                <span class="party-acts">
                    <button type="button" class="eq-btn" disabled="@(toggleWhy != null)" title="@(toggleWhy ?? (active ? "留在营区作候补（公共照护：饱食/水分不低于40，伤病照常）" : "编入同行队伍"))" @onclick="() => G.SetActive(id, !active)">@(active ? "留作候补" : "编入同行")</button>
                </span>
            }
            </div>
            <div class="party-stats tiny" title="健康/饱食/水分/体力/清醒/精神/病毒">
                健@(Fmt.T(st.Health)) 饱@(Fmt.T(st.Satiety)) 水@(Fmt.T(st.Hydration)) 体@(Fmt.T(st.Energy)) 醒@(Fmt.T(st.Wakefulness)) 精@(Fmt.T(st.Morale))@(a.Body.Infected ? $" 病毒{Fmt.N(a.Body.VirusLoad)}" : "")
            </div>
            <div class="party-weapons tiny muted">武器：@weapons</div>
        </div>
    };
}
