@inherits GameComponent
@inject IJSRuntime JS
@using Survival.Core.Save

@{
    var s = G.S;
    var e = G.E;
    var f = s.Progress.Flags;
    // B13：七日检查退役（S15 §7），死亡结算列序章任务完成情况；七日成功窗不再出现。
    // 试玩修复 M269 P9：“出区条件”按 QMAP01 三条件（首战胜利或旧档等效、得知营区路线、到过废弃村庄），不再列 PRO04/16/18
    var proTasks = e.PrologueTasks(s);
    var exitFrom = e.Config.Prologue.Exit.From;
    var exitConds = new (string Label, bool Ok)[]
    {
        ("赢下首战（农野荒地的游荡尸）", s.Story.TutorialWon || s.Story.Legacy),
        ("从来客处得知营区路线", f.Contains(GameEngine.FactCampRouteKnown)),
        ($"到过{e.LocName(exitFrom)}", s.Locations.TryGetValue(exitFrom, out var exl) && exl.Visited),
    };
    // B11：v3 地图有 143 个地点，“走遍”只数新手区 8 地点；总数不泄露未知地点（S02 §4）
    var starter = G.E.Config.Locations.Where(l => l.IsStarter).Select(l => l.Id).ToList();
    var visited = starter.Count(id => s.Locations.TryGetValue(id, out var ls) && ls.Visited);
    var visitedAll = s.Locations.Count(l => l.Value.Visited);
}

@if (s.Progress.Dead && s.Progress.Death != null)
{
    var d = s.Progress.Death;
    var alive = d.Minute - e.Config.Time.StartAbsoluteMinute;
    @* B31d（Q333）：结算菜单开着时结算层不可操作、不取得键盘焦点（菜单盖在上面，关闭后回到同一结算） *@
    <div class="end-back" role="alertdialog" aria-label="@(d.Zombified ? "尸变结算" : "死亡结算")" inert="@(G.MenuOpen || G.DeathLogOpen)">
        <div class="end-card @(d.Zombified ? "zombified" : "")">
            <div class="eyebrow">第@(Clock.Day(d.Minute))日 @Clock.HHmm(d.Minute) · @e.LocName(d.LocationId)</div>
            <h2>@(d.Zombified ? "你已尸变" : "你没能活下来")</h2>
            @if (d.Zombified)
            {
                <p class="muted" style="margin:0 0 8px;line-height:1.7">病毒程度达到@(Ui.T(e.Config.Infection.ZombificationAtLoad))，即使健康尚存也无法继续。本局结束，不能再用药补救。</p>
            }
            <div class="lines">
                <div><span>直接原因</span><b class="danger-text">@d.Cause</b></div>
                <div><span>存活时长</span><b>@(alive / 1440)天@(alive % 1440 / 60)小时@(alive % 60)分</b></div>
                <div><span>已访问地点</span><b>@(visitedAll)处（新手区@(visited)/@(starter.Count)）</b></div>
                <div><span>种子</span><b>@s.Seed</b></div>
            </div>
            <div class="eyebrow">序章任务 @(proTasks.Count(t => t.Done))/@(proTasks.Count) · 出区条件</div>
            <ul class="checklist">
                @foreach (var c in exitConds) { <li class="@(c.Ok ? "done" : "")">@c.Label</li> }
            </ul>
            @* B40（S01 Q382 / Q409-4）：终局快照写失败时在结算卡内显示带槽名的实际失败句及「重试」；返回标题或确认重开后作废 *@
            @if (G.Saves?.TerminalFailure is { } tf)
            {
                <div class="save-fail end-save-fail" role="alert">
                    <span>@tf.Text </span>
                    <button class="linkish" disabled="@(G.Saves.RetryBlockedText != null)" title="@G.Saves.RetryBlockedText" @onclick="G.RetryTerminal">@SaveSlots.RetryButton</button>
                </div>
            }
            @if (confirmRestart)
            {
                @* Q335 / Q386：终局重开与标题新游戏共用确认；取消保留结算卡及重试（Q409-4） *@
                <div class="confirm-box">
                    @SaveSlots.NewGameConfirmText
                    <div class="row">
                        <button class="secondary danger" @onclick="DoRestart">@SaveSlots.NewGameConfirmButton</button>
                        <button class="secondary" @onclick="() => confirmRestart = false">@SaveSlots.BackButton</button>
                    </div>
                </div>
            }
            <div class="btn-row">
                <button class="primary" @onclick="Restart">重新开始</button>
                <button class="secondary" @onclick="ShowLog">查看记录</button>
                <button class="secondary" @onclick="G.BackToTitle">返回标题</button>
                @* B31d（逐字稿 §1.2 Q333 选 A）：结算页「菜单」，Esc 同效；菜单只开放阅读字体、动画速度与「反馈与留言」 *@
                <button class="secondary" @ref="_menuBtn" title="菜单（ESC）" aria-keyshortcuts="Escape" @onclick="() => G.SetMenu(true)">@ShellText.Menu<EscCap On="@(G.EscOwner == EscOwner.OpenMenu)" /></button>
            </div>
            <div class="under">原型不提供跨局继承，重新开始会完整重置世界与角色。</div>
        </div>
    </div>
    @if (G.DeathLogOpen) { <div class="end-back" style="z-index:70" inert="@G.MenuOpen" @onclick="() => G.SetDeathLog(false)"><div class="end-card" style="max-height:80vh;overflow:auto">@foreach (var l in Enumerable.Reverse(s.Log).Take(80)) {<div class="small"><span class="muted">@Clock.DayTime(l.Minute)</span> @G.E.HideInstanceTags(l.Text)</div>}</div></div> }
}

@code {
    private ElementReference _menuBtn;
    private bool _menuWasOpen;

    private bool confirmRestart;

    private void Restart()
    {
        // Q335「终局重开走同一确认」/ Q409-2：每5分钟槽已有数据（含不可读）时先确认
        if (G.NewGameNeedsConfirm(false)) confirmRestart = true;
        else DoRestart();
    }

    private void DoRestart()
    {
        confirmRestart = false;
        G.NewGame();
    }

    private void ShowLog() => G.SetDeathLog(true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // B31d（Q333「关闭返回同一结算」）：结算菜单关掉后键盘焦点回到结算页的「菜单」键
        var open = G.State != null && G.S.Progress.Dead && G.MenuOpen;
        if (_menuWasOpen && !open && G.State != null && G.S.Progress.Dead && !G.DeathLogOpen)
        {
            try { await _menuBtn.FocusAsync(); } catch (Exception) { /* 结算层已收起 */ }
        }
        _menuWasOpen = open;
    }
}
