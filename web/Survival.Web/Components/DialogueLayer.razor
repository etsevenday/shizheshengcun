@inherits GameComponent
@inject IJSRuntime JS

@* 人物对话层（S14 §10、S07 §7、Q10）：覆盖中部“地图/场景 + 设施/资源”两行的完整区域；顶栏、左右栏、当前地面与随身保持可见但整局输入锁定。
   主角临时形象恒在最左、对话对象恒在最右（未发言一侧弱化但保留位置），发言者以姓名牌 + 高亮框 + “发言中”区分，不只靠颜色；
   正文按 22px 排版，同一次对话按顺序累计追加到一个纵向对话流（不清空、不替换），滚轮只回看本流、不推进也不透传；
   停在底部时新句自动跟随，向上回看时保持位置并出现“回到最新”。不显示任何剩余句数；末句按钮为“结束对话”，明确结束才撤层解锁。
   对话本身不推进时间、不消耗物品、不发奖励（推进由内核 AckDialogue 按当前句 ID 去重，双击不会跳句）。
   B15a（Q156 选 B）：同行邀约的末句不显示“结束对话”，改为“暂不登记”“登记同行”两选项（内核 AnswerRecruit 同样按当前句 ID 去重）。 *@
@* B39（N02 附录 §1「Q305–Q316 · B39 开工定稿」）：正文上方标题按真实组名→真实对象名→省略（Q307）；整组无对方发言时右侧留空、
   读屏名用组名或「当前对白」（Q306）；非人物行不点亮头像（Q305）；控制条辅助位依次为等待行动状态句（Q310）与文书阅读脚注（Q313），
   两者各占一位、可换行，正文独立滚动，继续/结束/招募选择始终可达。 *@
@* BM4b（S14「B45 Q581—Q590」§Q585，N02 2026-11-13 节）：去掉整个对白区的大块背景与装饰边框，上部原场景可见；主角头像框左下、对话对象右下（不交换），
   台词在说话者头像内侧的下方阅读区出现，旁白／文档／引导／结果／状态行用中性段落、不配头像；短引导只占头像、台词与控制条所需高度。
   透明处仍由本层承接点击（不点穿），对白锁、ESC 菜单（Q322／Q501）、继续／结束去重与“回到最新”跟随沿原合同。 *@
@* BM5a（S14「2026-11-13 试玩后续修订：对白恢复背景并覆盖下两行」DLG-LOWER-A01—A06，取代上面 BM4b 的透明大区与“上两行”定位）：
   主界面普通对白由 GameScreen 放在四行网格的③④位置、恢复不透明底板（fourrows.css）；本组件结构不变，全屏战斗内仍由 BattleScreen 的 .bfs-dlg 承载。
   「回到最新」按 Q614 选 A：手动离开已显示最新即出现（app.js survivalDlg）。 *@
@{
    var v = G.State == null ? null : G.E.DialogueLayer(G.S);
}
@if (v != null)
{
    var cur = v.Current;
    var leftSpeaking = v.CurrentIsPerson && cur.Side == DialogueSide.Left;
    var rightSpeaking = v.CurrentIsPerson && cur.Side == DialogueSide.Right;
    var other = v.Counterpart;
    var more = v.HasMore;
    @* B31b（Q322）：游戏菜单／战斗菜单开着时对白层不可操作，菜单不会消费对白继续键；关菜单后回到原对白行 *@
    <div class="dlg-layer" role="dialog" aria-modal="true" aria-label="@v.AriaName" inert="@(G.MenuOpen || G.BattleMenuOpen)">
        <div class="dlg-side left @(leftSpeaking ? "speaking" : "idle")">
            <div class="dlg-face">
                <img class="dlg-portrait" src="img/portraits/protagonist.svg" alt="主角（临时形象）" draggable="false" />
                <div class="dlg-name"><b>你</b>@if (leftSpeaking) {<em>发言中</em>}</div>
            </div>
        </div>
        <div class="dlg-main">
            @if (v.Title != null) { <div class="dlg-title">@v.Title</div> }
            <div class="dlg-stream" @ref="_stream" tabindex="0" aria-live="polite" aria-label="对话内容（可滚动回看）">
                <DialogueLines Lines="v.Session.Lines" CurrentOrder="cur.Order" />
            </div>
            <div class="dlg-ctrl">
                <span class="dlg-latest-host"><button type="button" class="secondary dlg-latest" @onclick="Latest">回到最新 ↓</button></span>
                <div class="dlg-aux">
                    @if (v.StatusLine != null)
                    {
                        @* Q310：有行动在安全边界等待对话时的状态句（中央推进条并入这里，暂隐条形动画，不叠放第二个可执行层） *@
                        <span class="dlg-hint dlg-action" role="status">@v.StatusLine</span>
                    }
                    @if (v.Footnote != null)
                    {
                        <span class="dlg-hint dlg-foot" id="dlg-foot">@v.Footnote</span>
                    }
                </div>
                @if (v.RecruitQuestId is string rq)
                {
                    @* B15a（Q156 选 B）：同行邀约读完后，末句按钮换成两选项：登记同行（入名册候补）/暂不登记（以后可再谈），都是 0 分钟 *@
                    <button type="button" class="secondary dlg-next" title="暂不登记：结束对话，不登记也不拒招，以后可以再来交谈（0分钟）" @onclick="() => G.AnswerRecruit(rq, cur.LineId, false)">暂不登记</button>
                    <button type="button" class="primary dlg-next" title="登记同行：进名册候补，首次两件装备随登记一次生成，不自动编队（0分钟，0物资）" @onclick="() => G.AnswerRecruit(rq, cur.LineId, true)">登记同行</button>
                }
                else
                {
                    @* B43：唯一无分支的推进键「继续 Enter／结束对话 Enter」（data-dlg-next）：焦点不在具体控件上时回车按一次只确认当前行一次；招募两选项不带 Enter *@
                    <button type="button" class="primary dlg-next" data-dlg-next aria-keyshortcuts="Enter" aria-describedby="@(v.Footnote != null ? "dlg-foot" : null)" @onclick="() => Ack(cur.LineId)">@(more ? "继续" : "结束对话") <kbd class="kc">@ShellKeys.Enter</kbd></button>
                }
            </div>
        </div>
        <div class="dlg-side right @(rightSpeaking ? "speaking" : "idle")">
            @if (other.Length > 0)
            {
                <div class="dlg-face">
                    <img class="dlg-portrait" src="@(other == "饱饱" ? "img/portraits/baobao.svg" : "img/portraits/unknown.svg")" alt="@($"{other}（临时形象）")" draggable="false" />
                    <div class="dlg-name"><b>@other</b>@if (rightSpeaking) {<em>发言中</em>}</div>
                </div>
            }
        </div>
    </div>
}

@code {
    private ElementReference _stream;
    private int _shown;
    private int _session = -1;

    private void Ack(string lineId) => G.AckDialogue(lineId);

    private async Task Latest()
    {
        try { await JS.InvokeVoidAsync("survivalDlg.latest", _stream); } catch (JSException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var d = G.State == null ? null : G.E.ActiveDialogue(G.S);
        if (d == null) { _shown = 0; _session = -1; return; }
        if (d.Id != _session) { _session = d.Id; _shown = 0; }
        if (d.Lines.Count == _shown) return;
        _shown = d.Lines.Count;
        // 停在底部就跟随最新；正在向上回看则保持位置并亮出“回到最新”（S14 §10.3）
        try { await JS.InvokeVoidAsync("survivalDlg.sync", _stream, _shown); } catch (JSException) { }
    }
}
