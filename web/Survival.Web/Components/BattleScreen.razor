@inherits GameComponent
@inject IJSRuntime JS

@* 全屏四对四战斗（A10 §1.2/§2.2/§3，S14「2026-10-30 全系统更新目标」，R03 §7；开发计划 v0.9 批次 B9）：
   战斗覆盖整个应用内容区，取代两行战斗（S14 §18.1/§18.4、R03 §7/§7.2/§7.4 的冲突展示条款）。外层顶栏、左右栏、地面/随身与底栏留在下面不可操作（inert），
   战后原样露出；对象信息改用战斗内右栏，地面与随身收进只读“物资查看”。
   五条纵区：顶条（地点·轮次·当前激活·菜单）/ 行动队列 / 场景（八锚点）/ 操作台 / 底部短反馈与阅读入口。
   B34a（S14 2026-11-13 Q570 选 B；新稿 a9b93f0 P05a）：右栏撤掉，战场八站位与操作台三区用全宽；1600×900 站位足底 y=466、同队间距 169、敌我最近 360、人形高 244。
   对象信息、关键预测与战报改到操作台下方默认收起的「战斗信息／战报」阅读区（底部两个入口展开），执行与目标切换留在底部反馈位。 *@
@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    var b = s.Battle!;
    var dlg = G.DialogueLocked;
    var w = e.CurrentWeapon(s, out var wi);
    // B9a：正在激活的我方成员（主角 0、队友 −k）；没有人在激活时取队列游标上的那一项（没有为 int.MinValue）
    var acting = GameEngine.ActingAlly(b);
    var activeIdx = acting != null ? GameEngine.QueueCode(b, acting) : (b.Cursor < b.Queue.Count ? b.Queue[b.Cursor] : int.MinValue);
    var actorId = acting ?? (activeIdx <= 0 && activeIdx != int.MinValue ? GameEngine.QueueActor(b, activeIdx) : null);
    var meName = actorId == null || actorId == GameState.PlayerId ? "你" : e.ActorDisplayName(s, actorId);
    // B9a 试玩修复 3：操作台摘要写这名成员自己的号位、体力、恐慌（等待中轮到的队友也一样，不借主角的）
    var whoId = actorId ?? GameState.PlayerId;
    var whoF = b.Fighter(whoId);
    var opts = e.BattleOptions(s);
    var sel = G.BattleAction == null ? null : opts.FirstOrDefault(o => o.Action == G.BattleAction && (G.BattleItem == null || o.ItemInstanceId == G.BattleItem));
    var waiting = !e.AwaitingPlayer(s);
    var locked = waiting || G.BattleBusy;
    var slotCount = cfg.Scope.Slots.Count;
    // B6（R03 §3）：本次激活得到的 AP（普通激活按训练阶位 3/4/5，追击 2）；不在激活中时按下一次普通激活显示
    var apMax = b.PlayerActing && b.ActivationAp > 0 ? b.ActivationAp : e.NormalActivationAp(s.Player);
    var mySpeed = e.PlayerSpeedParts(s, b);
    var aiming = G.BattleAiming;
    var aimSet = G.AimTargets();
    var token = G.BattleExecToken();
    var skills = opts.Where(o => o.Group is "attack" or "move").ToList();
    var cards = e.OperatorSkillCards(s, skills);
    // 灰卡说明跟随悬停；键盘（Tab、1—5）落到灰卡时留着，鼠标点灰卡不算；切页或升级后那张已不是灰卡就清掉；选了别的指令时不留说明（试玩修复 M503、M504）
    if (_lockFocus != null && !cards.Any(c => c.LockedText != null && c.Node.Id == _lockFocus)) _lockFocus = null;
    var lockShown = _lockHover ?? (sel == null ? _lockFocus : null);
    var lockNote = lockShown ?? _lockGhost;
    var general = opts.Where(o => o.Group == "general").ToList();
    var items = opts.Where(o => o.Group == "item" && CarriedFor(o) > 0).ToList();
    // B9（A10 §4.5）：瞄准中悬停合法目标时，目标生命条上画“预计”条纹——与右栏同一次 PreviewCommand（只读、不抽随机）
    _forecast = null;
    _takenBy = new HashSet<int>();
    if (aiming && G.BattleAimTarget is int hov && aimSet.Contains(hov))
    {
        var pv = e.PreviewCommand(s, BattleCommand.Of(G.BattleAction!, G.AreaAction ? null : hov, G.BattleItem));
        if (pv.Ok && pv.Targets.Count > 0) _forecast = pv.Targets.ToDictionary(t => t.Index, t => (t.DamageMin, t.DamageMax));
        if (pv.Ok) _takenBy = pv.Targets.Where(t => t.AimedIndex != null && t.AimedIndex != t.Index).Select(t => t.Index).ToHashSet();
    }
    // 试玩修复 B9-4：对白锁期间 AwaitingPlayer 为假，但轮到的仍是队列游标上的角色——顶条/底栏写真实行动者，不写“敌方行动中”
    // B9 遗留 1：敌方逐条展示中，游标已越过刚出手的敌人——按会话记下的“刚出手的那一只”点名（第一只与最后一只也写名字）
    var shownIdx = waiting && !dlg && G.BattleShownActor is int sa ? sa : activeIdx;
    var turnFoe = shownIdx > 0 ? e.BattleEnemyAt(b, shownIdx) : null;
    var allyTurn = activeIdx <= 0 && activeIdx != int.MinValue;
    var turnName = allyTurn && turnFoe == null ? meName : turnFoe != null ? $"{turnFoe.Pos}号 {e.EnemyName(turnFoe)}" : "敌方";
    var actorText = dlg
        ? (allyTurn ? $"{meName} · {(b.ActingPursuit ? "追击" : "普通激活")} · 读完对话再行动" : $"{turnName} · 对话中，时间未推进")
        : waiting ? WaitText(turnFoe, turnName) : $"{meName} · {(b.ActingPursuit ? "追击" : "普通激活")} · AP {b.PlayerAp}/{apMax}";
    var actorWait = dlg ? !allyTurn : waiting;
    var allyAim = G.BattleAllyAiming;
    var allyAimSet = G.AllyAimTargets();
    // B34b（S14 Q570／Q572）：特写播放中，播放层是最高输入层——战场、操作台、阅读入口与阅读区都不可操作、点击不穿透（只读子页已开着时它仍在最上层）
    var fxLock = G.PlaybackActive && !G.FxUnderReading;
    var lockedUi = dlg || fxLock;
}

<div class="bfs" role="region" aria-label="@($"{BattleInfoCopy.Title(e.LocName(b.LocationId))} · {BattleInfoCopy.RoundText(b.Round)}")">
    <div class="bfs-grid @(aiming ? "aiming" : "")" @oncontextmenu="CancelAim" @oncontextmenu:preventDefault="true">
        @* 顶条：「战斗 · {地点}」· 第{回合}回合 · 当前激活 [普通/追击] · AP 当前/本次上限 · 战斗菜单（A10 §2.2、§4.1）。
           B34（S14 Q575／Q576）：首战与普通战同一标题；容量、噪声、追击条件挪到队列行右端；系统说明只在战斗菜单里 *@
        <header class="bfs-top" inert="@lockedUi">
            <b class="bfs-title">@BattleInfoCopy.Title(e.LocName(b.LocationId))</b>
            <span class="bfs-where">@BattleInfoCopy.RoundText(b.Round)</span>
            <span class="bfs-actor @(actorWait ? "wait" : "now")" aria-live="polite">@actorText</span>
            <span class="bfs-top-btns">
                <button type="button" class="secondary @(G.BattleMenuOpen ? "on" : "")" @onclick="() => G.ToggleBattleMenu()" aria-keyshortcuts="Escape" title="@ShellKeys.MenuHover">@ShellText.Menu <kbd class="kc">@ShellKeys.Esc</kbd></button>
            </span>
        </header>

        @* 行动队列（R03 §2、A10 §4.1）：本轮已排定的实际顺序，最多 8 个头像；追击用同一角色再出现并带“追”角标。
           未来的追击还没判定，只在“追击条件”里写进度与条件，不伪造确定队列；悬停写速度来源，点击只固定查看（不夺回合）。 *@
        <div class="bfs-queue" inert="@lockedUi" role="list" aria-label="本轮行动顺序">
            <span class="bq-label">顺序</span>
            @{
                var shown = 0;
                var hidden = new List<string>();
            }
            @for (var k = 0; k < b.Queue.Count; k++)
            {
                var qi = b.Queue[k];
                var qAlly = qi <= 0 ? GameEngine.QueueActor(b, qi) : null;
                var be = qi <= 0 ? null : e.BattleEnemyAt(b, qi);
                if (qi > 0 && (be == null || !be.Alive)) continue;
                if (qi <= 0 && (qAlly == null || !GameEngine.AllyInBattle(b, qAlly))) continue;   // B9a：战死的队友不再列
                var chase = GameEngine.IsPursuitSlot(b, k);
                var now = (qi == activeIdx && b.Cursor == k) || (waiting && qi > 0 && qi == G.BattleShownActor && b.Cursor == k + 1);
                var done = k < b.Cursor && !now;
                var qName = qi <= 0 ? (qAlly == GameState.PlayerId ? "你" : $"{GameEngine.AllyPos(b, qAlly!)}号 {e.ActorDisplayName(s, qAlly!)}") : $"{be!.Pos}号 {e.EnemyName(be)}";
                var qSpeed = Ui.Speed(b.Initiative.ElementAtOrDefault(k));
                // B41e2（R05 Q537）：第一完整回合先手方开场参战者的轮初速度已含×1.5（与队列同源），悬停括注追加「先手×1.5」；已有构成说明的只在其中追加，不另开括注
                var qFs = qi <= 0 ? e.FirstStrikeRoundSpeedFactor(b, qAlly!) : e.FirstStrikeRoundSpeedFactor(b, GameEngine.FirstStrikeKeyOf(be!));
                var qFsTag = qFs > 1 ? GameEngine.FirstStrikeTag(qFs) : null;
                var qSrc = qi <= 0 && qAlly == actorId ? $"（{SpeedSource(mySpeed)}{(qFsTag != null ? "、" + qFsTag : "")}）" : qFsTag != null ? $"（含{qFsTag}）" : "";
                if (shown >= 8) { hidden.Add($"{(chase ? "追击·" : "")}{qName}（速度{qSpeed}）"); continue; }
                if (shown > 0) { <span class="bq-arrow" aria-hidden="true">→</span> }
                shown++;
                var qIdx = qi;
                <button type="button" role="listitem" class="q-av @(now ? "now" : "") @(done ? "done" : "") @(qi <= 0 ? "me" : "q-foe") @(chase ? "chase" : "")" data-peek="@(qi <= 0 ? Peek.Ally(qAlly!) : Peek.Foe(qi))"
                        title="@($"{qName}：轮初有效速度{qSpeed}{qSrc}{(chase ? "；追击：速度优势攒满100进度，正常激活之后多一次2AP" : "；正常激活")}{(now ? "；正在行动" : done ? "；已行动" : "")}。点击只查看，不改顺序")"
                        aria-label="@($"{(chase ? "追击 " : "")}{qName}{(now ? "，行动中" : done ? "，已行动" : "")}")"
                        @onclick="() => QueueClick(qIdx)">
                    <span class="q-art" aria-hidden="true">@if (qi <= 0) {<img src="img/portraits/protagonist.svg" alt="" />} else { @Icons.Markup("enemy_" + be!.EnemyId) }</span>
                    <span class="q-name">@qName</span>
                    @if (chase) { <span class="q-chase bdg" aria-hidden="true">追</span> }
                </button>
            }
            @if (hidden.Count > 0) { <span class="q-more bdg" tabindex="0" title="@string.Join("；", hidden)">+@hidden.Count</span> }
            @* B34a（S14 Q528.3）：首战系统提示在主画面只占一行「系统提示」＋「查看提示」，全文与原两项操作在只读子页「操作提示」 *@
            @if (G.E.BattleHint(s) is { } bh)
            {
                <div class="bfs-hintline" role="note">
                    <span class="tc-sys">@BattleInfoCopy.HintLabel</span><span class="bfs-hintline-text" title="@bh.Text">@bh.Text</span>
                    <button type="button" class="tc-link" id="bi-hint-open" @onclick='() => G.OpenBattleSub("hint", "bi-hint-open")'>@BattleInfoCopy.HintOpen</button>
                </div>
            }
            @* B34（S14 Q575）：队列行右端——容量、噪声、追击条件（原值与悬停说明不变；窄窗随行换行） *@
            <span class="bq-facts">
                <span class="bfs-cap" title="@e.CapacityText(s)">容量@(b.Capacity) · 敌人最多@(b.Capacity)只</span>
                <span class="bt-noise" title="枪声+@(Ui.T(cfg.Noise.GunGain))、弩+@(Ui.T(cfg.Noise.CrossbowGain))；满@(Ui.T(cfg.Noise.Max))可能引来同地丧尸（每场最多1次）">
                    噪声<span class="track thin"><i style="width:@Ui.Bar(b.Noise, cfg.Noise.Max)%"></i></span>@Ui.T(b.Noise)/@Ui.T(cfg.Noise.Max)
                </span>
                <span class="bq-cond" tabindex="0" title="@PursuitCondition(b)">追击条件</span>
            </span>
        </div>

        @* 场景：八个永久锚点（A10 §2.2、§4.1；R03 §1）——从左到右己方 4/3/2/1、敌方 1/2/3/4，中线两边的 1 号位最近；
           按我方真实槽（Allies）与敌人真实号位数据驱动渲染：空位画空锚点，人少、死亡、悬停、读数变长都不重排、不跳位。 *@
        <section class="bfs-scene" inert="@lockedUi" aria-label="战场：我方从左到右4、3、2、1号位，敌方从左到右1、2、3、4号位">
            <div class="bfs-side ally" aria-label="我方">
                @for (var p = slotCount; p >= 1; p--) { @AllyAnchor(p, activeIdx, allyAim, allyAimSet, token, locked) }
            </div>
            <div class="bfs-mid" aria-hidden="true"><span>VS</span></div>
            <div class="bfs-side foes" aria-label="敌方">
                @for (var p = 1; p <= slotCount; p++) { @FoeAnchor(p, aiming, aimSet, activeIdx, token, locked) }
            </div>
        </section>

        @* 操作台（A10 §2.2、§4.2、§5）：左——当前行动者摘要与战斗装备（本页武器/防具/战斗饰品，另一把武器在页签上，七槽在“装备查看”）；
           中——武器Ⅰ/Ⅱ两页签（切页0AP）+ 本页五个技能位（对应 1/3/5/7/10 级；Q227 未解锁的是灰卡，写条件、不可执行）+ 敌方目标位图；
           右——通用动作与“医疗”入口（快捷医疗小盘）。“结束行动”在底部常驻。 *@
        <section class="bfs-console" inert="@lockedUi" aria-label="操作台">
            <div class="bc-who" aria-label="@BattleInfoCopy.WhoPanel">
                <h3 class="bc-title">@BattleInfoCopy.WhoPanel</h3>
                <div class="bc-who-head">
                    <span class="bc-face" aria-hidden="true"><img src="img/portraits/protagonist.svg" alt="" /></span>
                    <span class="bc-who-name"><b>@meName · @(Math.Max(1, GameEngine.AllyPos(b, whoId)))号位</b><small class="@(actorWait ? "" : "now")">@(actorWait ? (GameEngine.AlliesOnField(b).Count > 1 ? "等待轮到我方" : "等待轮到你") : dlg ? "读完对话再行动" : $"{(b.ActingPursuit ? "追击" : "普通激活")} · AP {b.PlayerAp}/{apMax}")</small></span>
                </div>
                @* B34a（P05a）：当前行动者四行——行动点、体力、恐慌、当前武器 *@
                <dl class="bc-who-lines">
                    <div><dt>@BattleInfoCopy.WhoAp</dt><dd>@(actorWait || dlg ? "等待" : $"{b.PlayerAp}/{apMax}")</dd></div>
                    <div><dt>@BattleInfoCopy.WhoEnergy</dt><dd>@Ui.N(s.Actor(whoId).Stats.Energy)/@Ui.T(s.Actor(whoId).Stats.EnergyMax)</dd></div>
                    <div title="恐慌越高命中能力越低"><dt>@BattleInfoCopy.WhoPanic</dt><dd>@Ui.N(whoF.Panic)@(whoF.Frightened ? "·受惊" : "")</dd></div>
                    <div><dt>@BattleInfoCopy.WhoWeapon</dt><dd>@(wi == null ? "拳" : w.Name)</dd></div>
                    @if (whoF.Guard) { <div class="good" title="下一次直接伤害减免"><dt>@(whoF.GuardSourceId != null ? "盾格挡" : "防御")</dt><dd>×@Ui.T(whoF.GuardFactor)</dd></div> }
                </dl>
                <div class="bc-gear" aria-label="战斗装备">
                    @{ var armor = e.WornItem(s, GameEngine.MeId(s), EquipSlots.Armor); var trinket = e.WornItem(s, GameEngine.MeId(s), EquipSlots.CombatAccessory); }
                    <span class="bc-gear-slot" title="@(wi == null ? "本页：拳" : $"本页武器：{w.Name}")">@Icons.Markup(wi?.ItemId ?? "fists")</span>
                    <span class="bc-gear-slot @(armor == null ? "none" : "")" title="@(armor == null ? "防具：空" : $"防具：{e.ItemName(armor.ItemId)}{(armor.Durability != null ? $"，耐久{GameEngine.DurabilityText(armor)}" : "")}")">@if (armor != null) { @Icons.Markup(armor.ItemId) } else { <i class="bdg">甲</i> }</span>
                    <span class="bc-gear-slot @(trinket == null ? "none" : "")" title="@(trinket == null ? "战斗饰品：空" : $"战斗饰品：{e.ItemName(trinket.ItemId)}")">@if (trinket != null) { @Icons.Markup(trinket.ItemId) } else { <i class="bdg">饰</i> }</span>
                </div>
            </div>

            <div class="bc-main">
                <h3 class="bc-title">@BattleInfoCopy.SkillPanel</h3>
                <div class="bc-tabs" role="tablist" aria-label="武器页（切页0AP）">
                    @for (var pg = 1; pg <= 2; pg++)
                    {
                        var page = pg;
                        var pi = e.WeaponOnPage(s, page, out var pw);
                        var onPage = b.ActiveWeaponSlot == page;
                        var slotName = EquipSlots.Name(EquipSlots.WeaponSlotOfPage(page)!);
                        var warn = pi != null && !GameEngine.HasWear(pi, cfg.Wear.PerExecutedAttackCommand) ? "耐久不足" : pi != null && pw.UsesMagazine && pi.LoadedAmmo <= 0 ? "弹仓空" : null;
                        var sub = string.Join(" · ", new[] {
                            warn,
                            warn == null && pi?.Durability != null ? $"耐久{GameEngine.DurabilityText(pi)}" : null,
                            pw.UsesMagazine && pi != null ? $"弹{pi.LoadedAmmo}/{pw.MagazineCapacity}" : null,
                            pw.ConsumesLooseAmmo ? $"箭{s.Items.Where(i => GameEngine.CarriedByMe(s, i) && i.ItemId == pw.AmmoId).Sum(i => i.Count)}" : null,
                            pi == null ? "空槽·拳" : null,
                        }.Where(x => x != null));
                        var pageCap = page == 1 ? ShellKeys.WeaponPage1Cap : ShellKeys.WeaponPage2Cap;
                        <button type="button" role="tab" class="bc-tab @(onPage ? "on" : "")" aria-selected="@onPage" data-page="@(page)" aria-keyshortcuts="@pageCap"
                                title="@($"{slotName}：{(pi == null ? "空槽（拳）" : $"{pw.Name}")}{(sub != "" ? "，" + sub : "")} · 切页0AP，只换可选技能，取消已选目标")"
                                @onclick="() => G.SelectWeaponPage(page)">
                            <span class="bc-tab-art" aria-hidden="true">@Icons.Markup(pi?.ItemId ?? "fists")</span>
                            <span class="bc-tab-text"><b>@(page == 1 ? ShellKeys.WeaponPage1 : ShellKeys.WeaponPage2) <kbd class="kc">@pageCap</kbd> @(pi == null ? "拳" : pw.Name)</b><small class="@(warn != null ? "warn" : "")">@sub</small></span>
                        </button>
                    }
                </div>
                <div class="bc-skills" role="toolbar" aria-label="@($"{(b.ActiveWeaponSlot == 1 ? "Ⅰ" : "Ⅱ")}页技能（1、3、5、7、10级）")">
                    @foreach (var card in cards)
                    {
                        @SkillSlot(card, sel, wi, w, locked)
                    }
                </div>
                @RangeMap(sel ?? HoverSkill(skills), aimSet)
                @if (cards.FirstOrDefault(c => c.LockedText != null && c.Node.Id == lockNote) is { } lockCard)
                {
                    @* 说明盖着通用区：鼠标移入就隐去，隐去后再留一小会接住紧跟着的点击，看不见的按钮不会被点中（试玩修复 M504、M516） *@
                    <div class="bc-locknote @(lockShown == null ? "ghost" : "")" role="note" @onmouseenter="() => HideLockNote(lockCard.Node.Id)" @onclick="CloseLockNote">
                        <b>@lockCard.Node.Name</b><span>@(e.SkillName(lockCard.Node.SkillId))@(lockCard.Node.Level)级</span>
                        <p>@lockCard.Node.Text</p>
                        <p class="bc-locknote-why">@lockCard.LockedText</p>
                    </div>
                }
            </div>

            <div class="bc-side">
                <h3 class="bc-title">@BattleInfoCopy.GeneralPanel</h3>
                <div class="bc-general" role="toolbar" aria-label="通用动作">
                    @foreach (var o in general.Where(x => x.Action != "end_turn")) { @Cmd(o, sel, wi, w, locked) }
                    @foreach (var o in skills.Where(x => x.NodeId == null)) { @Cmd(o, sel, wi, w, locked) }
                    @{ var meds = opts.Where(o => o.Group == "item").ToList(); var medCount = meds.Sum(CarriedFor); }
                    <button type="button" class="cmdt med @(G.MedTrayOpen ? "on" : "") @(meds.Any(m => m.Available) ? "" : "off")" id="cmd-med" aria-expanded="@G.MedTrayOpen"
                            title="@($"快捷医疗与战术品：随身{medCount}份（绷带/抗生素/特效药，闪光标记器/支撑护带包/鼓舞提示贴）；点开看数量、成本与原因，选好后再确认（点敌人/友方的会进入瞄准）")" @onclick="() => G.ToggleMedTray()">
                        <span class="cmdt-art">@Icons.Markup("bandage")</span>
                        <span class="cmdt-text"><span class="cmdt-name">@BattleInfoCopy.MedEntry</span><small class="bdg">×@medCount</small></span>
                    </button>
                </div>
                @if (G.MedTrayOpen)
                {
                    <div class="bc-medtray" role="dialog" aria-label="@BattleInfoCopy.MedEntry">
                        <div class="bc-medtray-head"><b>@BattleInfoCopy.MedEntry</b><button type="button" class="secondary bc-medtray-back" @onclick="() => G.ToggleMedTray(false)">@BattleInfoCopy.BackToBattle<EscCap On="@(G.EscOwner == EscOwner.MedTray)" /></button></div>
                        @* B34a（Q298、P05d）：上段「药品」（当前行动者自用），下段「战术物品」（每人每完整回合共 1 次） *@
                        @foreach (var grp in meds.GroupBy(m => G.E.TacticalItemOf(m.Action) != null).OrderBy(g => g.Key))
                        {
                            <div class="bc-medtray-sec"><b>@(grp.Key ? BattleInfoCopy.MedTactical : BattleInfoCopy.MedDrugs)</b><small>@(grp.Key ? BattleInfoCopy.MedTacticalNote : BattleInfoCopy.MedDrugsNote)</small></div>
                        @foreach (var m in grp)
                        {
                            var mo = m;
                            var have = CarriedFor(m);
                            <button type="button" class="bc-med @(m.Available ? "" : "off")" disabled="@locked" aria-disabled="@(!m.Available)"
                                    title="@(m.Reason ?? $"{ShortName(m)}：{ApText(m.Ap)}，随身{have}份；选中后在底部确认")"
                                    @onclick="() => { G.ToggleMedTray(false); if (mo.Available) G.PickBattleAction(mo.Action, mo.ItemInstanceId); else G.ExplainBlocked(ShortName(mo), mo.Reason); }">
                                <span class="cmdt-art">@Icons.Markup(MedItem(m.Action))</span>
                                <span class="bc-med-text"><b>@G.E.ItemName(MedItem(m.Action)) ×@have</b><small>@(m.Available ? ApText(m.Ap) : ShortWhy(m.Reason))</small></span>
                            </button>
                        }
                        }
                    </div>
                }
                @* B34a（P05a／P05c／P05f）：通用行动区底行——「查看物资」「查看装备」「结束行动」 *@
                <div class="bc-side-btns">
                    <button type="button" class="secondary @(G.BattleDrawer == "supplies" ? "on" : "")" @onclick='() => G.OpenBattleDrawer("supplies")' title="只读查看随身五卡、容器内容与当前地面；战斗中不能吃喝、拾取、转移或换入第三把武器">@BattleInfoCopy.SuppliesEntry</button>
                    <button type="button" class="secondary @(G.BattleDrawer == "equip" ? "on" : "")" @onclick='() => G.OpenBattleDrawer("equip")' title="只读查看七个装备槽（战斗中不能换装或换入第三把武器）">@BattleInfoCopy.EquipEntry</button>
                    @if (general.FirstOrDefault(x => x.Action == "end_turn") is BattleCommandOption endOpt)
                    {
                        <button type="button" class="secondary bfs-end @(sel?.Action == "end_turn" ? "on" : "")" id="cmd-end_turn" disabled="@locked" title="@(endOpt.Reason ?? "结束本次行动：剩余AP清零，不积攒到下轮（点后再确认）")"
                                @onclick='() => { if (endOpt.Available) G.PickBattleAction("end_turn"); else G.ExplainBlocked(endOpt.Label, endOpt.Reason); }'>结束行动</button>
                    }
                </div>
            </div>
        </section>

        @* 底部：一条最新短反馈/瞄准提示 + 物资查看 + 结束行动（A10 §2.2、§5） *@
        <footer class="bfs-feed" inert="@(lockedUi || G.BattleDrawer != null)" aria-live="polite">
            @if (dlg)
            {
                <span class="bx-hint">对话中，时间未推进；读完后@(allyTurn ? $"轮到{meName}行动" : $"{turnName}继续行动")</span>
            }
            else if (waiting)
            {
                <span class="bx-hint warn">@(WaitText(turnFoe, turnName))…</span>
            }
            else if (sel != null && aiming)
            {
                <span class="bx-hint">@AimHint(sel) · 右键/ESC 取消</span>
                @* B34a（Q570）：目标切换与「执行{指令名}」留在原操作台／目标处（底部反馈位），不进阅读区 *@
                @TargetCycle(aimSet.Count)
                @AimConfirm()
            }
            else if (sel != null)
            {
                var p = e.PreviewCommand(s, G.CurrentBattleCommand());
                @if (G.BattlePairAiming) { <span class="bx-hint">@PairHint()</span> }
                else if (allyAim) { <span class="bx-hint">点亮起的我方成员指定目标@(p.Ok ? "；直接确认＝对自己" : "")</span> }
                @if (!(G.BattlePairAiming && !p.Ok && G.BattleAllyTarget2 == null))
                {
                    <span class="bx-hint @(p.Ok ? "" : "warn")" title="@(p.Ok ? string.Join("；", p.Notes) : p.Reason)">@(p.Ok ? (p.RetreatChance.HasValue ? $"成功率{Ui.Pct(p.RetreatChance.Value)}" : p.Notes.FirstOrDefault() ?? ShortName(sel)) : p.Reason)</span>
                }
                <button type="button" class="bx-go" id="bt-confirm" disabled="@(!p.Ok || locked)" title="@(p.Ok ? "点击确认才提交；同一指令只提交一次" : p.Reason)"
                        aria-keyshortcuts="Enter" @onclick="() => Exec(token)">@G.BattleConsoleConfirmText()<EnterCap On="@(p.Ok && !locked)" /></button>
                <button type="button" class="bx-x" aria-label="取消（ESC）" title="取消（ESC/右键），不执行" @onclick="G.ClearBattleAction">×</button>
            }
            else
            {
                @* B34（S14 Q577）：没选动作时不写文字催促；有真实战报就显示最新一条，没有就留空 *@
                <span class="bx-last">@b.Log.LastOrDefault()</span>
            }
            @* B34a（Q570）：主画面两个阅读入口——只展开对应页并聚焦页签，不选人、不确认 *@
            <span class="bfs-feed-btns" role="group" aria-label="阅读区入口">
                @foreach (var (pg, label) in InfoPages)
                {
                    var page = pg;
                    <button type="button" class="secondary bi-entry @(G.BattleInfoPage == page ? "on" : "")" id="@("bi-entry-" + page)" aria-expanded="@(G.BattleInfoPage == page)" aria-controls="bfs-infoarea"
                            @onclick="() => G.OpenBattleInfo(page)">@label</button>
                }
            </span>
        </footer>

        @* B34a（S14 Q570）：操作台下方全宽阅读区，默认收起；页签「战斗信息」「战报」单一内容区切换，「收起」或一次 Esc 只收起它。只读，不新增模态锁。 *@
        @if (G.BattleInfoPage is string infoPage)
        {
            <section class="bfs-infoarea" id="bfs-infoarea" inert="@lockedUi" aria-label="@($"{BattleInfoCopy.InfoTab}／{BattleInfoCopy.LogTab}")">
                <div class="bi-head">
                    <div class="bi-tabs" role="tablist">
                        @foreach (var (pg, label) in InfoPages)
                        {
                            var page = pg;
                            <button type="button" role="tab" class="bi-tab @(infoPage == page ? "on" : "")" id="@("bi-tab-" + page)" aria-selected="@(infoPage == page)" @onclick="() => G.OpenBattleInfo(page)">@label</button>
                        }
                    </div>
                    @if (infoPage == "info")
                    {
                        <button type="button" class="secondary" id="bi-detail" @onclick='() => G.OpenBattleSub("detail", "bi-detail")'>@BattleInfoCopy.Detail</button>
                    }
                    <button type="button" class="secondary bi-collapse" @onclick="G.CollapseBattleInfo">@BattleInfoCopy.Collapse<EscCap On="@(G.EscOwner == EscOwner.BattleInfo)" /></button>
                </div>
                <div class="bi-body detail" data-wheel="y">
                    @if (infoPage == "info") { <div class="detail-body"><BattlePanel Mode="info" /></div> }
                    else { @RecentLog(b) }
                </div>
            </section>
        }

        @* 战斗对白（A10 §6.2）：在战场内上层覆盖场景与操作台的主要阅读区；读完前战斗不接受输入、不推进 *@
        @if (dlg)
        {
            <div class="bfs-dlg" inert="@fxLock"><DialogueLayer /></div>
        }
        @if (G.BattleDrawer != null && !dlg)
        {
            <div class="bfs-drawer" role="dialog" aria-label="@DrawerTitle(G.BattleDrawer)">
                @if (G.BattleDrawer == "help") { <HelpOverlay /> }
                else
                {
                    <div class="bfs-drawer-head">
                        <h2>@DrawerTitle(G.BattleDrawer)@if (G.BattleDrawer == "log") {<small class="bfs-drawer-sub">@BattleInfoCopy.LogSubtitle(b.Log.Count, b.LogMayBeIncomplete)</small>}</h2>
                        <button type="button" class="secondary" @onclick="() => G.OpenBattleDrawer(null)">@BattleInfoCopy.BackToBattle<EscCap On="@(G.EscOwner == EscOwner.BattleDrawer)" /></button>
                    </div>
                    <div class="bfs-drawer-body" id="bfs-drawer-body" data-wheel="y">
                        @if (G.BattleDrawer == "supplies") { <BattleSupplies /> }
                        else if (G.BattleDrawer == "equip") { <BattleEquip /> }
                        else if (G.BattleDrawer == "detail") { <div class="detail bi-detail-wrap"><BattlePanel Mode="detail" /></div> }
                        else if (G.BattleDrawer == "hint") { @HintPage() }
                        else if (G.BattleDrawer == "log") { @FullLog(b) }
                    </div>
                    @if (G.BattleDrawer == "log" && b.Log.Count > 0)
                    {
                        <div class="blog-foot">
                            @if (_logNew > 0) { <button type="button" class="secondary blog-new" @onclick="LogToLatest">@BattleInfoCopy.NewRecords(_logNew)</button> }
                            <button type="button" class="secondary" @onclick="LogToLatest">@BattleInfoCopy.BackToLatest</button>
                        </div>
                    }
                }
            </div>
        }
    </div>
    @* B34b：特写播放层在战斗页之内（菜单之下、只读子页打开时退到子页之下） *@
    <BattleFxLayer />
    @if (G.BattleMenuOpen) { <MenuOverlay Battle="true" /> }
</div>

@code {
    /// <summary>
    /// 等待中的顶条/底栏文字（B9a 试玩修复 2）：有敌人在出手写“敌方行动中：N号 名字”；队列游标停在我方下一名（激活马上开始）写“轮到××”；
    /// 本轮队列走完、正在推进轮末 5 分钟写“轮末结算”。不再出现光秃的“敌方行动中”。
    /// </summary>
    private string WaitText(BattleEnemy? turnFoe, string turnName)
    {
        var b = G.S.Battle!;
        if (turnFoe != null) return $"敌方行动中：{turnName}";
        if (b.Cursor >= b.Queue.Count) return "轮末结算（本轮推进5分钟）";
        var q = b.Queue[b.Cursor];
        if (q <= 0 && GameEngine.QueueActor(b, q) is string next) return $"轮到{(next == GameState.PlayerId ? "你" : G.E.ActorDisplayName(G.S, next))}";
        return "轮末结算（本轮推进5分钟）";
    }

    /// <summary>B34b（R03 §Q571）：短反馈——锚点上亮一下（两套同样的动画交替，连续两次也能重播）。</summary>
    private string Pulse(string side, string id) => G.PulseOf(side, id) is int n ? (n % 2 == 0 ? "fx-pulse b" : "fx-pulse a") : "";

    private static string DrawerTitle(string? d) => d switch
    {
        "supplies" => BattleInfoCopy.SuppliesTitle,
        "log" => BattleInfoCopy.LogTitle,
        "equip" => BattleInfoCopy.EquipTitle,
        "detail" => BattleInfoCopy.Detail,
        "hint" => BattleInfoCopy.HintTitle,
        "help" => "系统说明",
        _ => "",
    };

    /// <summary>整队（Q105）底部步骤提示：第一步点 A，第二步点 A 的相邻友方 B，选齐后确认；再点已选的人取消该步，Esc/右键取消整条。</summary>
    private string PairHint()
    {
        var s = G.S;
        var b = s.Battle!;
        string N(string id) => id == GameState.PlayerId ? "你" : G.E.ActorDisplayName(s, id);
        if (G.BattleAllyTarget == null) return "整队第1步：点要交换站位的第一名友方（可以是自己）· ESC 取消";
        if (G.BattleAllyTarget2 == null) return $"整队第2步：已选{N(G.BattleAllyTarget)}（{GameEngine.AllyPos(b, G.BattleAllyTarget)}号位），再点与他相邻、亮起的一名友方 · 再点{N(G.BattleAllyTarget)}重选";
        return $"整队：{N(G.BattleAllyTarget)} ⇄ {N(G.BattleAllyTarget2)}，确认后交换 · 再点任一人改选";
    }

    private static string AimHint(BattleCommandOption sel) =>
        sel.TargetMode == "area" ? $"点亮起的任一1、2号位目标提交{sel.Label}（1、2号位都打）"
        : sel.TargetMode == "suffix" ? "点起点敌人：从它的号位打到4号位，按离起点的格数×0.65/0.50/0.35/0.25，空位不重排；悬停看右侧逐个预测"
        : sel.TargetMode == "pair" ? "点1、2号位打12，点3号位打23；悬停看右侧预测"
        : "把鼠标移到亮起的目标上看右侧预测，点击目标执行";

    /// <summary>
    /// 我方锚点（A10 §2.1/§4.1）：按我方真实槽数据驱动——空槽画空锚点；有人的画立绘、脚下生命/体力与状态。
    /// 现在只有主角会在号位上（队友入场是 B9a）；队友的号位到时由同一个函数渲染，点击只查看、不夺回合。
    /// </summary>
    private RenderFragment AllyAnchor(int pos, int activeIdx, bool allyAim, IReadOnlyCollection<string> allyAimSet, string token, bool locked) => __builder =>
    {
        var s = G.S;
        var e = G.E;
        var b = s.Battle!;
        var id = GameEngine.AllyAt(b, pos);
        if (id == null)
        {
            <div class="anc ally empty" data-slot="@pos" title="@($"我方{pos}号位：空位（可用“调整站位”移过来；空位不是未解锁）")" aria-label="@($"我方{pos}号位，空位")">
                <span class="anc-plate">@BattleInfoCopy.Plate(pos, null)</span>
            </div>
            return;
        }
        var me = id == GameState.PlayerId;
        // B9a：每名在场成员一个锚点；正在激活的那一名金框、带 AP；队友显示自己的生命/体力与状态
        var acting = activeIdx == GameEngine.QueueCode(b, id) && GameEngine.ActingAlly(b) == id;
        var viewing = G.BattleAllyView == id;
        var name = me ? "你" : e.ActorDisplayName(s, id);
        var st = s.Actors.TryGetValue(id, out var act) ? act.Stats : s.Stats;
        var fa = b.Fighter(id);
        var apMax = fa.Acting && fa.ActivationAp > 0 ? fa.ActivationAp : e.NormalActivationAp(s.Actor(id));
        var targetable = allyAim && allyAimSet.Contains(id);
        // 整队（Q105）：已选的 A/B 带角标，不算“非目标”变灰
        var pairMark = G.BattlePairAiming ? (G.BattleAllyTarget == id ? "A" : G.BattleAllyTarget2 == id ? "B" : null) : null;
        var notTarget = allyAim && !targetable && pairMark == null;
        // B34（S14 Q577）：真正等待玩家下令、还没选动作时，当前实际行动者轻微高亮＋微动态待机＋人物局部微聚焦（只作用于立绘层，不改站位与点击对象）
        var awaitCmd = acting && G.BattleAction == null && !G.DialogueLocked && !G.PlaybackActive && G.E.AwaitingPlayer(s);
        <div class="anc ally @Pulse(BattleFxUnit.AllySide, id) @(acting ? "acting" : "") @(awaitCmd ? "await-cmd" : "") @(viewing ? "selected" : "") @(targetable ? "targetable" : "") @(notTarget ? "unreachable" : "") @(pairMark != null ? "pair-picked" : "")" data-slot="@pos" data-actor="@id" data-peek="@Peek.Ally(id)" role="button" tabindex="0" aria-pressed="@viewing"
             aria-label="@($"{(acting ? BattleInfoCopy.CurrentActorAria(name) + "，" : "")}我方{pos}号位 {name}，健康{Ui.N(st.Health)}/{Ui.T(st.HealthMax)}，体力{Ui.N(st.Energy)}{(targetable ? "，可作为目标" : "")}")"
             title="@(pairMark != null ? $"整队已选为{(pairMark == "A" ? "第一" : "第二")}名，再点取消这一步" : targetable ? (G.BattlePairAiming ? (G.BattleAllyTarget == null ? "点击选为整队的第一名" : "点击选为与他交换的第二名") : "点击即对他执行所选技能") : notTarget ? "不是所选技能的目标" : "点击在右侧查看状态（只查看，不改变行动顺序）")" @onclick="() => ClickAlly(id, token, locked)" @onkeydown="ev => AllyKey(ev, id)"
             @onmouseenter="() => G.HoverBattleAlly(targetable ? id : null)" @onmouseleave="() => G.HoverBattleAlly(null)">
            @* B34（S14 Q574）：头顶名牌「{号位}号位 · {姓名}」；下一行是 AP／当前行动事实 *@
            <div class="anc-top anc-plate-row">@if (acting) {<span class="anc-ptr" aria-hidden="true">▼</span>}<b class="anc-plate">@BattleInfoCopy.Plate(pos, name)</b></div>
            <div class="anc-head" title="@(acting ? $"本次{(b.ActingPursuit ? "追击" : "普通激活")}剩{fa.Ap}AP（不带入下次）" : "还没轮到；行动顺序见上方队列")">
                <span class="anc-ap">@(acting ? $"{(b.ActingPursuit ? "追击" : "行动中")} {fa.Ap}/{apMax}AP" : "等待")</span>
            </div>
            @if (G.PulseNameOf(BattleFxUnit.AllySide, id) is string pulseName) { <span class="fx-pulse-name" aria-hidden="true">@pulseName</span> }
            <div class="anc-art">
                <img src="img/portraits/protagonist.svg" alt="" draggable="false" />
                @{ WeaponConfig cw; ItemInstance? cwi; using (e.FocusOn(s, id)) cw = e.CurrentWeapon(s, out cwi); }
                <span class="anc-weapon" title="@(cwi == null ? "当前页：拳" : $"当前页：{cw.Name}")">@Icons.Markup(cwi?.ItemId ?? "fists")</span>
                @if (targetable) { <span class="anc-aim" aria-hidden="true">⌖</span> }
                @if (pairMark != null) { <span class="anc-pair bdg" aria-label="@($"整队已选{pairMark}")">@pairMark</span> }
            </div>
            <div class="anc-foot">
                <div class="anc-chips">@AllyChips(id)</div>
                <div class="anc-nums"><span title="健康">♥@(Ui.N(st.Health))</span><span title="体力">体@(Ui.N(st.Energy))</span></div>
                <div class="track hp"><i style="width:@Ui.Bar(st.Health, st.HealthMax)%"></i></div>
                <div class="track en"><i style="width:@Ui.Bar(st.Energy, st.EnergyMax)%"></i></div>
            </div>
        </div>
    };

    private void AllyKey(KeyboardEventArgs ev, string id)
    {
        if (ev.Key is "Enter" or " ") G.ViewBattleAlly(id);
    }

    /// <summary>点我方锚点：瞄准友方技能时提交（执行锁期间不受理），否则只查看。</summary>
    private async Task ClickAlly(string id, string token, bool locked)
    {
        if (G.BattleAllyAiming && locked) return;
        await G.ClickBattleAlly(id, token);
    }

    /// <summary>主角脚下的状态角标（短徽标，完整说明在右侧对象信息）：防御/格挡、架矛、蓄力、失衡、减速、出血、感染等。</summary>
    private RenderFragment AllyChips(string id) => __builder =>
    {
        var s = G.S;
        var b = s.Battle!;
        using var _focus = G.E.FocusOn(s, id);   // B9a：按这名成员本人的状态画角标
        if (b.PlayerGuard) { <span class="st good bdg" title="@($"{(b.PlayerGuardSourceId != null ? "盾格挡" : "防御")}：下一次直接伤害×{Ui.T(b.PlayerGuardFactor)}")">@(b.PlayerGuardSourceId != null ? "盾" : "防")×@Ui.T(b.PlayerGuardFactor)</span> }
        if (b.BraceCharges > 0) { <span class="st good bdg" title="架矛：敌人主动前移后迎击">架矛×@b.BraceCharges</span> }
        if (b.CounterFactor > 0) { <span class="st good bdg" title="反击架势">反击</span> }
        if (GameEngine.AxeChargeOn(b)) { <span class="st good bdg" title="斧蓄力">蓄力</span> }
        if (b.PlayerStagger) { <span class="st bad bdg">失衡</span> }
        if (b.PlayerSlowActive || b.PlayerSlowPending) { <span class="st bad bdg">减速</span> }
        if (GameEngine.PlayerArmorBroken(b)) { <span class="st bad bdg">破甲</span> }
        if (GameEngine.PlayerWeakActive(b)) { <span class="st bad bdg">虚弱</span> }
        if (s.Body.BleedTriggers > 0) { <span class="st bad bdg">出血×@s.Body.BleedTriggers</span> }
        if (s.Body.Infected) { <span class="st bad bdg" title="@($"已感染：病毒{Ui.N(s.Body.VirusLoad)}")">感染</span> }
    };

    /// <summary>
    /// 敌方锚点（A10 §4.1）：头像上方一枚意图图标和短名（完整意图在右侧对象信息与悬停/读屏文字），立绘，脚下生命、状态角标；
    /// 瞄准时合法目标加准星、不可选的加叉线与短原因；空号位画空锚点。
    /// </summary>
    private RenderFragment FoeAnchor(int pos, bool aiming, IReadOnlyCollection<int> aimSet, int activeIdx, string token, bool locked) => __builder =>
    {
        var s = G.S;
        var e = G.E;
        var b = s.Battle!;
        var en = b.Alive.FirstOrDefault(x => x.Pos == pos);
        if (en == null)
        {
            <div class="anc foe empty" data-slot="@pos" title="@($"敌方{pos}号位：空位")" aria-label="@($"敌方{pos}号位，空位")">
                <span class="anc-plate">@BattleInfoCopy.Plate(pos, null)</span>
            </div>
            return;
        }
        var ec = e.Enemy(en.EnemyId);
        var idx = en.Index;
        var targetable = aiming && aimSet.Contains(idx);
        var unreachable = aiming && !aimSet.Contains(idx);
        var reachWhy = unreachable ? (e.CommandBlocked(s, BattleCommand.Of(G.BattleAction!, idx, G.BattleItem)) ?? "不在本指令范围内") : null;
        var picked = G.BattleTarget == idx;
        var taken = _takenBy.Contains(idx);
        var tip = reachWhy ?? (targetable ? "点击即对它执行所选技能（右侧是实际预测）" : "点击选中查看（不会攻击）；先选技能再点亮起的目标才执行");
        <div @key="@("foe" + idx)" id="@($"foe-{idx}")" data-slot="@pos" data-peek="@Peek.Foe(idx)" class="anc foe @Pulse(BattleFxUnit.EnemySide, "e" + idx) @(idx == activeIdx ? "acting" : "") @(targetable ? "targetable" : "") @(unreachable ? "unreachable" : "") @(en.Acted ? "acted-done" : "") @(picked ? "selected" : "") @(G.BattleHover == idx || (aiming && G.BattleAimTarget == idx) ? "hover" : "")"
             role="button" tabindex="0" aria-pressed="@picked" aria-disabled="@(unreachable || (targetable && locked))"
             aria-label="@($"敌方{pos}号位 {ec.Name}，健康{Ui.N(en.Hp)}/{Ui.N(ec.Hp)}{(en.Acted ? "，本轮已行动" : "")}{(taken ? "，" + BattleInfoCopy.TakenBy : "")}{(reachWhy != null ? "；" + reachWhy : "")}")"
             title="@tip" @onclick="() => ClickFoe(idx, token, locked)" @onkeydown="ev => FoeKey(ev, idx, token, locked)"
             @onmouseenter="() => G.HoverBattleTarget(idx)" @onmouseleave="() => G.HoverBattleTarget(null)" @onfocus="() => G.FocusBattleTarget(idx)">
            @* B34（S14 Q574）：头顶名牌「{号位}号位 · {姓名}」；不显示敌人尚未执行的计划（意图图标、动作、计划伤害、目标与分支），悬停与读屏也不写 *@
            <div class="anc-top anc-plate-row">@if (idx == activeIdx) {<span class="anc-ptr" aria-hidden="true">▼</span>}<b class="anc-plate" title="@ec.Name">@BattleInfoCopy.Plate(pos, ec.Name)</b></div>
            <div class="anc-head none"></div>
            @if (G.PulseNameOf(BattleFxUnit.EnemySide, "e" + idx) is string pulseName) { <span class="fx-pulse-name" aria-hidden="true">@pulseName</span> }
            <div class="anc-art">
                @Icons.Markup("enemy_" + ec.Id)
                @if (en.Acted) { <span class="anc-done bdg" title="本轮已行动">已动</span> }
                @if (taken) { <span class="anc-taken bdg">@BattleInfoCopy.TakenBy</span> }
                @if (targetable) { <span class="anc-aim" aria-hidden="true">⌖</span> }
                @if (unreachable) { <span class="anc-no" aria-hidden="true"></span> }
            </div>
            <div class="anc-foot">
                @FoeChips(b, en, ec)
                <div class="anc-nums @(ForecastText(en) != null ? "fc-on" : "")">@if (ForecastText(en) is string fct) {<span class="fc-tag" title="预计剩余生命（未暴击；暴击见右侧）">预计</span><span title="预计剩余生命（未暴击；暴击见右侧）">@fct</span>} else {<span title="健康">♥@(Ui.N(en.Hp))/@(Ui.N(ec.Hp))</span>}</div>
                <div class="track hp">@HpForecast(en, ec)<i style="width:@Ui.Bar(en.Hp, ec.Hp)%"></i></div>
                @if (unreachable) { <div class="anc-why" title="@reachWhy">@ShortReach(reachWhy)</div> }
            </div>
        </div>
    };

    private Dictionary<int, (double Min, double Max)>? _forecast;

    /// <summary>B34（S14 Q574）：本次预测里原目标被保护转移时，实际承受者的敌人号（站位上标「实际承伤」）。</summary>
    private HashSet<int> _takenBy = new();

    /// <summary>敌人已生效的状态角标（S14 Q574：在数值条上方）；只写已发生的事实，不写未执行计划。</summary>
    private RenderFragment FoeChips(BattleState b, BattleEnemy en, EnemyConfig ec) => __builder =>
    {
        <div class="anc-chips">
            @if (en.Guard) { <span class="st good bdg">防御</span> }
            @if (en.ProtectingIndex > 0) { <span class="st good bdg" title="对同伴的单体攻击由它接下">保护</span> }
            @if (en.Stagger) { <span class="st bad bdg">失衡</span> }
            @if (en.SlowActive || en.SlowPending) { <span class="st bad bdg">减速</span> }
            @if (en.BleedTriggers > 0) { <span class="st bad bdg">出血×@en.BleedTriggers</span> }
            @if (GameEngine.EnemyMarked(b, en)) { <span class="st bad bdg">标记</span> }
            @if (en.ArmorBreak > 0 && en.ArmorBreakUntilRound >= b.Round) { <span class="st bad bdg">破甲</span> }
            @if (GameEngine.EnemyWeak(b, en)) { <span class="st bad bdg">虚弱</span> }
            @if (!en.Hostile) { <span class="st bdg">中立</span> }
            @if (ec.Elite) { <span class="st bdg" title="精英：每次正常激活4AP">精英</span> }
        </div>
    };

    /// <summary>
    /// 目标生命条上的预计伤害（A10 §4.5）：悬停合法目标时，从“打满最大值后剩余”到当前生命之间画条纹（不写入真实生命）；
    /// 区间来自与右栏、实际结算同源的 PreviewCommand（未暴击，护甲/防御已扣）。
    /// </summary>
    private RenderFragment HpForecast(BattleEnemy en, EnemyConfig ec) => __builder =>
    {
        if (_forecast == null || !_forecast.TryGetValue(en.Index, out var f) || ec.Hp <= 0) return;
        var lo = Math.Max(0, en.Hp - f.Max);
        var l = Math.Clamp(lo / ec.Hp * 100, 0, 100);
        var r = Math.Clamp(en.Hp / ec.Hp * 100, 0, 100);
        <s class="fc" style="@(FormattableString.Invariant($"left:{l:0.##}%;width:{Math.Max(0, r - l):0.##}%"))" aria-hidden="true"></s>
    };

    private string? ForecastText(BattleEnemy en) =>
        _forecast != null && _forecast.TryGetValue(en.Index, out var f) ? $"♥{Ui.N(Math.Max(0, en.Hp - f.Max))}—{Ui.N(Math.Max(0, en.Hp - f.Min))}" : null;

    private static string ShortReach(string? why) =>
        why == null ? "" : why.StartsWith("射程不足") ? "射程不足" : why.Contains("号位") ? "位置不符" : "不可选";

    /// <summary>点队列头像：敌人只固定查看，自己/队友在右侧看状态；不改顺序、不夺回合。</summary>
    private void QueueClick(int qi)
    {
        if (qi <= 0) G.ViewBattleAlly(GameEngine.QueueActor(G.S.Battle!, qi) ?? GameState.PlayerId);
        else G.PickBattleTarget(qi);
    }

    private static string SpeedSource((double Speed, double Base, double Gear, List<string> Status) p) =>
        $"基础{Ui.Speed(p.Base)}、装备{Ui.SignedT(p.Gear)}{(p.Status.Count > 0 ? "、" + string.Join("、", p.Status) : "")}";

    /// <summary>未来追击只写条件与当前进度（R03 §2），不伪造确定队列。</summary>
    private string PursuitCondition(BattleState b)
    {
        var e = G.E;
        var parts = GameEngine.AlliesOnField(b).Select(id => $"{(id == GameState.PlayerId ? "你" : G.E.ActorDisplayName(G.S, id))}{Ui.T(b.Fighter(id).Pursuit)}/100").ToList();
        parts.AddRange(b.Alive.OrderBy(x => x.Pos).Select(x => $"{x.Pos}号{e.EnemyName(x)}{Ui.T(x.PursuitProgress)}/100"));
        return "追击条件：每轮初按“自己的轮初速度÷对方最快者−1”×50 攒进度，满100在本轮正常激活之后多一次2AP（每轮至多一次）；速度变化从下轮起算。现在进度：" + string.Join("，", parts);
    }

    /// <summary>
    /// 焦点在敌人锚点上按 Enter／空格。BM3（Q511）：瞄准中走与「执行{指令名}」、全局回车同一瞄准确认（提交本次明确目标，与预测、按钮一致），
    /// 不按锚点旧的原生激活去打焦点所在的那只——目标已换成别的敌人、残留焦点不改打；无明确合法目标或不可提交时什么也不做。未瞄准仍只选中查看。
    /// </summary>
    private async Task FoeKey(KeyboardEventArgs ev, int idx, string token, bool locked)
    {
        if (ev.Key is not ("Enter" or " ")) return;
        if (G.BattleAiming) { if (!locked && !ev.Repeat) await G.BattleAimSubmit(token); return; }
        await ClickFoe(idx, token, locked);
    }

    /// <summary>瞄准中点合法目标=提交（执行锁期间不受理）；未瞄准只选中查看。</summary>
    private async Task ClickFoe(int idx, string token, bool locked)
    {
        if (G.BattleAiming && locked) return;
        await G.ClickBattleTarget(idx, token);
    }

    private int CarriedFor(BattleCommandOption o)
    {
        var itemId = G.E.Config.CombatActions.FirstOrDefault(a => a.Id == o.Action)?.ItemId ?? G.E.TacticalItemOf(o.Action);   // B22 战术品
        return itemId == null ? 0 : G.S.Items.Where(i => GameEngine.CarriedByMe(G.S, i) && i.ItemId == itemId).Sum(i => i.Count);
    }

    private void CancelAim()
    {
        if (G.BattleAction != null) G.ClearBattleAction();
    }

    /// <summary>
    /// 本页一个技能位（A10 §4.2/§4.3、Q227）：该门在这一级的专属节点——已解锁的主动技能为可点按钮（不可用写短原因）；
    /// 已解锁的战斗被动只读显示；未解锁的是灰卡：卡上写正式名、所需等级（左上角）与当前等级，悬停/键盘聚焦在操作台右侧通用区上层读说明与完整条件（不挡场景里的健康体力），点它只写原因，不选目标、不耗 AP。
    /// </summary>
    private RenderFragment SkillSlot(OperatorSkillCard card, BattleCommandOption? sel, ItemInstance? wi, WeaponConfig w, bool locked) => __builder =>
    {
        var e = G.E;
        var node = card.Node;
        var lv = node.Level;
        if (card.Option != null) { @Cmd(card.Option, sel, wi, w, locked, lv) return; }
        if (card.LockedText == null)
        {
            <div class="cmdt passive" data-level="@lv" tabindex="0" title="@($"{node.Name}（{e.SkillName(node.SkillId)}{lv}级被动）：{node.Text}")" aria-label="@($"{node.Name}，被动，自动生效")">
                <span class="cmdt-lv bdg">@(lv)级</span>
                @SlotCap(lv)
                <span class="cmdt-art">@Icons.Markup(wi?.ItemId ?? "fists")</span>
                <span class="cmdt-text"><span class="cmdt-name">@node.Name</span><small class="bdg">被动</small></span>
            </div>
            return;
        }
        var why = card.LockedText;
        var id = node.Id;
        <button type="button" @ref="_lockRefs[id]" class="cmdt skill locked-card" data-level="@lv" data-node="@id" aria-disabled="true"
                aria-label="@($"{node.Name}，未解锁，{why}。{node.Text}")"
                @onmouseenter="() => SetLockHover(id)" @onmouseleave="() => SetLockHover(null)" @onfocus="() => SetLockFocus(id)" @onblur="() => SetLockFocus(null)"
                @onclick="ev => ClickLocked(ev, node.Name, why, locked)">
            <span class="cmdt-lv bdg" aria-hidden="true">@(lv)级</span>
            <span class="cmdt-ap bdg cmdt-lock" aria-hidden="true">锁</span>
            @SlotCap(lv)
            <span class="cmdt-art">@Icons.Markup(wi?.ItemId ?? "fists")</span>
            <span class="cmdt-text">
                <span class="cmdt-name">@node.Name</span>
                <span class="cmdt-why cmdt-need">当前@(e.SkillLevel(G.S, node.SkillId))级</span>
            </span>
        </button>
    };

    /// <summary>悬停中、键盘操作停留的灰卡节点（分开记：Tab 或 1—5 落到的卡在鼠标移开后继续显示说明；鼠标点中的卡不留，只存界面）。</summary>
    private string? _lockHover;
    private string? _lockFocus;
    private readonly Dictionary<string, ElementReference> _lockRefs = new();
    private void SetLockHover(string? id) { if (_lockHover != id) { _lockHover = id; StateHasChanged(); } }
    private void SetLockFocus(string? id) { if (_lockFocus != id) { _lockFocus = id; StateHasChanged(); } }
    private void CloseLockNote() { _lockHover = null; _lockGhost = null; SetLockFocus(null); }

    /// <summary>刚隐去、还接着点击的说明（只存界面）；说明一消失下面的按钮就露出来，移入后紧跟的点击会落到按钮上（试玩修复 M516）。</summary>
    private string? _lockGhost;

    private async Task HideLockNote(string id)
    {
        _lockGhost = id;
        _lockHover = null;
        SetLockFocus(null);
        StateHasChanged();
        await Task.Delay(400);
        if (_lockGhost == id) { _lockGhost = null; StateHasChanged(); }
    }

    /// <summary>点灰卡：只写原因。鼠标点的（Detail≥1；回车/空格触发的是 0）不把说明留在焦点上，移开就收起（试玩修复 M504）。</summary>
    private void ClickLocked(MouseEventArgs ev, string name, string why, bool locked)
    {
        if (ev.Detail > 0) _lockFocus = null;
        if (!locked) G.ExplainBlocked(name, why);
    }

    /// <summary>正在读页面的瞄准上下文（同一次瞄准只读一次）。</summary>
    private string? _aimProbing;

    /// <summary>
    /// BM3（Q510、Q511）：新一次敌方瞄准成立后（数字键、点技能卡等任一入口），读一次页面上当下真实的键盘焦点敌人与鼠标所在敌人，
    /// 交给会话按「合法焦点敌人 → 合法鼠标所在敌人 → 不指定」初始化本次明确目标。只读，不提交；读不到（断线等）按都没有处理。
    /// </summary>
    private async Task InitAim()
    {
        if (!G.AimInitPending) return;
        var ctx = G.AimInitKey;
        if (_aimProbing == ctx) return;
        _aimProbing = ctx;
        int?[]? r = null;
        try { r = await JS.InvokeAsync<int?[]>("survivalAim.probe"); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
        G.InitAimTarget(ctx, r is { Length: > 0 } ? r[0] : null, r is { Length: > 1 } ? r[1] : null);
    }

    /// <summary>快捷键 1—5 落在灰卡上：焦点移到那张卡，说明与右栏原因写的是同一张（试玩修复 M503）。</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await InitAim();
        await AfterRenderInfo();
        if (G.BattleFocusNode is not string id) return;
        G.BattleFocusNode = null;
        if (!_lockRefs.TryGetValue(id, out var el)) return;
        try { await el.FocusAsync(); } catch (InvalidOperationException) { } catch (JSException) { }
        SetLockFocus(id);   // 焦点原本就在这张卡上（鼠标点过）时不会再发 focus 事件
    }

    /// <summary>悬停中的技能（未选技能时目标位图跟着悬停显示）。</summary>
    private string? _hoverSkill;
    private BattleCommandOption? HoverSkill(List<BattleCommandOption> skills) => _hoverSkill == null ? null : skills.FirstOrDefault(o => o.Action == _hoverSkill);
    private void SetHoverSkill(string? action) { if (_hoverSkill != action) { _hoverSkill = action; StateHasChanged(); } }

    /// <summary>
    /// 敌方目标位图（A10 §4.4）：固定画敌方 1/2/3/4 小槽——技能（或武器）规定能打的号位亮起，再叠加主案的实际合法性：
    /// 现在真能选的目标加准星，范围内但当前不能选（空位/被挡/站位不符）画斜线。与执行同一个 SkillTargetPositions / 目标列表。
    /// </summary>
    private RenderFragment RangeMap(BattleCommandOption? o, IReadOnlyCollection<int> aimSet) => __builder =>
    {
        var s = G.S;
        var e = G.E;
        var b = s.Battle!;
        var w = e.CurrentWeapon(s, out _);
        var node = o?.NodeId != null ? e.SkillNode(o.NodeId) : null;
        HashSet<int>? range = null;
        HashSet<int>? own = null;
        if (o != null && (o.NeedsTarget || o.TargetMode == "area"))
        {
            if (node != null) { range = e.SkillTargetPositions(s, node, w); own = e.SkillOwnPositions(node, w); }
            else if (o.Action == "desperate_punch") range = new HashSet<int> { 1 };
        }
        var legal = o == null ? new HashSet<int>() : (G.BattleAiming && G.BattleAction == o.Action ? aimSet : o.Targets).Select(i => e.BattleEnemyAt(b, i)?.Pos ?? 0).ToHashSet();
        <div class="bc-range" aria-label="@(range == null ? "目标位：选一个攻击技能后显示" : $"{o!.Label}可打敌方{string.Join("、", range.OrderBy(x => x))}号位，现在可选{(legal.Count == 0 ? "无" : string.Join("、", legal.OrderBy(x => x)) + "号位")}")">
            <span class="bc-range-label">@(range == null ? "目标位" : $"{ShortName(o!)} 打")</span>
            @for (var p = 1; p <= 4; p++)
            {
                var inR = range?.Contains(p) == true;
                var ok = inR && legal.Contains(p);
                <span class="rg bdg @(inR ? "in" : "") @(ok ? "ok" : "") @(inR && !ok ? "blocked" : "")" title="@($"敌方{p}号位：{(range == null ? "—" : !inR ? "不在这个技能的目标位" : ok ? "可以选" : "在目标位里，但现在没有可选目标（空位、被挡或你的站位不符）")}")">@p</span>
            }
            @if (own != null) { <span class="bc-range-own" title="@($"这个技能要你站在我方{string.Join("、", own.OrderBy(x => x))}号位；你在{GameEngine.PlayerPos(b)}号位")">使用位@(string.Join("", own.OrderBy(x => x)))@(own.Contains(GameEngine.PlayerPos(b)) ? "" : "（不符）")</span> }
        </div>
    };

    private string MedItem(string action) => G.E.Config.CombatActions.FirstOrDefault(a => a.Id == action)?.ItemId ?? G.E.TacticalItemOf(action) ?? "placeholder";

    /// <summary>操作台上的一条带图指令：点选进入瞄准/待确认，不执行；不可用保留禁用态与短原因。</summary>
    /// <summary>
    /// B43（S14「战斗五个技能位」）：技能卡位固定键帽 1—5，按本页卡位序号（1/3/5/7/10 级依次为 1—5），不是所需等级；
    /// 放在卡顶中间，不压左上等级、右上 AP／锁、名称与原因。与快捷键 BattleHotkeySkill 同一张表（ShellKeys.SkillSlotLevels）。
    /// </summary>
    private static RenderFragment SlotCap(int level) => __builder =>
    {
        var cap = ShellKeys.SkillSlotCap(level);
        if (cap != "") { <kbd class="kc cmdt-key">@cap</kbd> }
    };

    private RenderFragment Cmd(BattleCommandOption o, BattleCommandOption? sel, ItemInstance? wi, WeaponConfig w, bool locked, int level = 0) => __builder =>
    {
        var on = sel != null && sel.Action == o.Action && sel.ItemInstanceId == o.ItemInstanceId;
        var (art, glyph, qty) = CmdArt(o, wi, w);
        var oo = o;
        var range = o.TargetMode == "ally" ? (o.AllyTargets.Count > 0 ? $"点我方成员（可选{o.AllyTargets.Count}名）" : "当前没有可选的友方") : o.TargetMode == "area" ? "1、2号位群攻" : o.TargetMode == "suffix" ? (o.Targets.Count > 0 ? $"点起点打到4号位（可选起点{o.Targets.Count}个）" : "当前没有可选目标") : o.TargetMode == "pair" ? (o.Targets.Count > 0 ? "相邻双位（点12或23）" : "当前没有可选目标") : o.NeedsTarget ? (o.Targets.Count > 0 ? $"可选目标{o.Targets.Count}个" : "当前没有可选目标") : o.Action == "swap" ? "我方站位" : "自用/无目标";
        @* 试玩修复 M150：不可用的指令真正禁用（冷却中、AP 不足……都不进入瞄准），点它只在右栏写原因；悬停照样写原因 *@
        <button type="button" id="@($"cmd-{o.Action}{(o.ItemInstanceId is int ii ? "-" + ii : "")}")" class="cmdt @(on ? "on" : "") @(o.Available ? "" : "off") @(o.NodeId != null || o.Action == "desperate_punch" ? "skill" : "plain")" disabled="@locked" aria-disabled="@(!o.Available)" data-level="@(level > 0 ? level : null)"
                @onmouseenter="() => SetHoverSkill(oo.Action)" @onmouseleave="() => SetHoverSkill(null)" @onfocus="() => SetHoverSkill(oo.Action)" @onblur="() => SetHoverSkill(null)"
                aria-label="@($"{ShortName(o)}，{ApText(o.Ap)}{(qty != null ? "，" + qty : "")}{(o.Reason != null ? "；不可用：" + o.Reason : "")}")"
                title="@(o.Reason ?? $"{o.Label}：{ApText(o.Ap)}{(o.Energy > 0 ? $"，体力{Ui.N(o.Energy)}" : "")}{(o.CooldownRounds > 0 ? $"，冷却{o.CooldownRounds}轮" : "")}；{range}。{(o.EffectText != null ? o.EffectText + "。" : "")}{(o.NeedsTarget || o.TargetMode == "area" ? "点选后点亮起的目标执行" : "点选后在旁边确认")}")"
                @onclick="() => { if (oo.Available) G.PickBattleAction(oo.Action, oo.ItemInstanceId); else G.ExplainBlocked(oo.Label, oo.Reason); }">
            @if (level > 0) { <span class="cmdt-lv bdg" aria-hidden="true">@(level)级</span>@SlotCap(level) }
            <span class="cmdt-ap bdg" aria-hidden="true">@ApText(o.Ap)</span>
            <span class="cmdt-art">@Icons.Markup(art)@if (glyph != null) {<em class="cmdt-glyph bdg">@glyph</em>}</span>
            <span class="cmdt-text">
                <span class="cmdt-name">@ShortName(o)</span>
                @if (!o.Available) { <span class="cmdt-why">@ShortWhy(o.Reason)</span> }
                else if (qty != null) { <small class="bdg">@qty</small> }
            </span>
        </button>
    };

    /// <summary>指令图（S14 §14.2）：攻击用当前武器/拳图，招式用武器图 + 招式字角标，医疗用真实物品图与随身数量，装填用实际弹药图；缺图统一占位。</summary>
    private (string art, string? glyph, string? qty) CmdArt(BattleCommandOption o, ItemInstance? wi, WeaponConfig w)
    {
        var weaponArt = wi?.ItemId ?? "fists";
        var e = G.E;
        string? Qty(string id)
        {
            var itemId = e.Config.CombatActions.FirstOrDefault(a => a.Id == id)?.ItemId;
            return itemId == null ? null : $"×{G.S.Items.Where(i => GameEngine.CarriedByMe(G.S, i) && i.ItemId == itemId).Sum(i => i.Count)}";
        }
        string ItemArt(string id) => e.Config.CombatActions.FirstOrDefault(a => a.Id == id)?.ItemId ?? "placeholder";
        return o.Action switch
        {
            "basic_attack" => (weaponArt, null, null),
            "desperate_punch" => ("fists", "勉", null),
            // B7：五节点技能用当前武器图 + 技能名首字角标
            _ when o.NodeId != null => (weaponArt, o.Label.Length > 0 ? o.Label[..1] : null, null),
            "guard" => ("cmd_guard", null, null),
            "swap" => ("cmd_switch", o.ItemInstanceId is int to && to < GameEngine.PlayerPos(G.S.Battle!) ? "前" : "后", null),
            "breathe" => ("cmd_breathe", null, null),
            "reload" => (w.AmmoId ?? "cmd_reload", null, null),
            "retreat" => ("cmd_retreat", null, null),
            "end_turn" => ("cmd_end_turn", null, null),
            "bandage" or "use_antibiotics" or "use_antiviral_cure" => (ItemArt(o.Action), null, Qty(o.Action)),
            _ => ("placeholder", null, null),
        };
    }

    // BM3（Q512）：短名表移到会话（GameSession.BattleShortName），确认按钮与右栏指引同一命名结果
    private static string ShortName(BattleCommandOption o) => GameSession.BattleShortName(o);

    private static string ApText(int ap) => ap < 0 ? "剩余AP" : $"{ap}AP";

    /// <summary>禁用短原因（完整原因在悬停/辅助名称）。</summary>
    private static string ShortWhy(string? why)
    {
        if (string.IsNullOrEmpty(why)) return "";
        if (why.StartsWith("行动点不足")) return "AP不足";
        if (why.StartsWith("还没轮到")) return "等待";
        if (why.StartsWith("只在体力不足")) return "体力足";
        if (why.StartsWith("体力不足")) return "体力不足";
        if (why.StartsWith("随身没有")) return why.Contains("弹") || why.Contains("箭") || why.Contains("矢") ? "无弹药" : "无物品";
        if (why.StartsWith("随身") && why.Contains("不足")) return "弹药不足";
        if (why.StartsWith("弹仓不足")) return "需装填";
        if (why.StartsWith("弹仓已满")) return "弹仓满";
        if (why.StartsWith("弹仓空")) return "需装填";
        if (why.Contains("耐久不足")) return "耐久不足";
        if (why.Contains("冷却") || why.Contains("间隔中")) return "冷却中";
        if (why.Contains("没有效果")) return "无效果";
        if (why.StartsWith("本回合已")) return "本轮已用";
        if (why.StartsWith("已在防御")) return "已防御";
        if (why.StartsWith("需要") && why.Contains("级")) return "等级不足";
        if (why.StartsWith("射程不足")) return "射程不足";
        if (why.StartsWith("只有你一人")) return "无队友";
        if (why.StartsWith("已在") || why.StartsWith("已蓄力") || why.StartsWith("已架矛") || why.StartsWith("已有")) return "已生效";
        if (why.Contains("单发弩")) return "单发弩";
        if (why.Contains("不能直接攻击")) return "不能攻击";
        if (why.StartsWith("健康高于") || why.StartsWith("健康已满") || why.StartsWith("你没有") || why.StartsWith("恐慌已是0")) return "无效果";
        if (why.Contains("只能在我方")) return "站位不符";
        if (why.Contains("不需要装填") || why.Contains("不用装填")) return "无需装填";
        if (why.StartsWith("当前武器") && why.Contains("不能用")) return "武器不符";
        if (why.Contains("不需要装填")) return "无需装填";
        if (why.StartsWith("冷却中")) return "冷却中";
        // 试玩修复 M150：不再截原文（曾把“随身箭矢不足2支”截成“随身箭矢不”），没归类的写“不可用”，完整原因在悬停/右栏
        return why.Length <= 4 ? why : "不可用";
    }

    private async Task Exec(string token) => await G.ExecuteBattleCommand(token);

    // ───── B34a（S14 Q570、Q528.2/Q528.3、Q529）：阅读区、只读子页与确认焦点 ─────

    private static readonly (string Page, string Label)[] InfoPages = { ("info", BattleInfoCopy.InfoTab), ("log", BattleInfoCopy.LogTab) };

    /// <summary>
    /// 阅读区「战报」页：标题、计数「最近{n}条 · 共{N}条」（旧档可能缺早段时「已保存」）与「全记录」；最近 5 条按发生顺序、最新在底，
    /// 每条一行原文（视觉超长才省略），点开定位到战斗记录里的同一条（按本场日志下标，不按可见第几行）。0 条只写空态，不补假条。
    /// </summary>
    private RenderFragment RecentLog(BattleState b) => __builder =>
    {
        var recent = BattleInfoCopy.Recent(b.Log);
        <div class="bi-log">
            <div class="bi-loghead">
                <b id="bi-log-title" tabindex="-1">@BattleInfoCopy.LogTab</b>
                <span class="bi-count">@BattleInfoCopy.RecentCount(recent.Count, b.Log.Count, b.LogMayBeIncomplete)</span>
                <button type="button" class="secondary" id="bi-fulllog" @onclick='() => G.OpenBattleSub("log", "bi-fulllog")'>@BattleInfoCopy.FullLog</button>
            </div>
            @if (recent.Count == 0) { <p class="bi-empty">@BattleInfoCopy.LogEmpty</p> }
            else
            {
                <ol class="bi-recent">
                    @foreach (var (idx, line) in recent)
                    {
                        var at = idx;
                        <li @key="@($"{b.BattleId}-{at}")"><button type="button" class="bi-rec" id="@($"bi-rec-{at}")" title="@line" @onclick='() => G.OpenBattleSub("log", $"bi-rec-{at}", at)'>@line</button></li>
                    }
                </ol>
            }
        </div>
    };

    /// <summary>战斗记录子页（Q528.2）：本场全部已提交记录按发生顺序从早到晚完整换行；旧档可能缺早段时页首提示，不补造。</summary>
    private RenderFragment FullLog(BattleState b) => __builder =>
    {
        if (b.LogMayBeIncomplete) { <p class="blog-legacy" role="note">@BattleInfoCopy.LegacyMissing</p> }
        if (b.Log.Count == 0) { <p class="bi-empty">@BattleInfoCopy.LogEmpty</p> return; }
        <ol class="notes bfs-full-log" id="blog-list">
            @for (var i = 0; i < b.Log.Count; i++)
            {
                <li @key="i" id="@($"blog-{i}")" tabindex="-1">@b.Log[i]</li>
            }
        </ol>
    };

    /// <summary>操作提示子页（Q528.3）：原提示全文与原「关闭这条」「暂停后续提示」；只有明确点这两个才改变原回执。没有提示时写空态。</summary>
    private RenderFragment HintPage() => __builder =>
    {
        if (G.E.BattleHint(G.S) is not { } bh) { <p class="bi-empty">@BattleInfoCopy.HintEmpty</p> return; }
        <div class="tc-hint bfs-hint" role="note">
            <span class="tc-sys">@BattleInfoCopy.HintLabel</span><span class="tc-hint-text">@bh.Text</span>
            <span class="tc-hint-btns">
                <button type="button" class="tc-link" @onclick="() => G.DismissHint(bh.TaskId)">关闭这条</button>
                <button type="button" class="tc-link" title="只关闭中性操作提示与教学短句；剧情、危险提示与任务不受影响，可在任务册恢复" @onclick="() => G.SetHintsPaused(true)">暂停后续提示</button>
            </span>
        </div>
    };

    /// <summary>
    /// B43（S14「战斗目标预测切换」）：瞄准中「上一目标 ←」「下一目标 →」，与方向键同一入口 BattleCycleTarget——只在合法目标间移动预测，不提交攻击；
    /// 没有合法目标时禁用。B34a 起放在底部反馈位（原右栏撤销）。
    /// </summary>
    private RenderFragment TargetCycle(int legal) => __builder =>
    {
        <span class="bp-cycle" role="group" aria-label="切换预测目标">
            <button type="button" class="secondary" aria-keyshortcuts="ArrowLeft" disabled="@(legal == 0)" @onclick="() => G.BattleCycleTarget(-1)">@ShellKeys.PrevTarget <kbd class="kc kc-sym">@ShellKeys.PrevTargetCap</kbd></button>
            <button type="button" class="secondary" aria-keyshortcuts="ArrowRight" disabled="@(legal == 0)" @onclick="() => G.BattleCycleTarget(1)">@ShellKeys.NextTarget <kbd class="kc kc-sym">@ShellKeys.NextTargetCap</kbd></button>
        </span>
    };

    /// <summary>
    /// BM2（Q497）：瞄准中「执行{指令名} Enter」——业务名与键帽同一按钮；不可用时禁用并在旁写第一条真实原因。点击与回车同一入口 BattleAimSubmit。
    /// B34a 起放在底部反馈位（原右栏撤销），阅读区里不再有执行入口。
    /// </summary>
    private RenderFragment AimConfirm() => __builder =>
    {
        if (!G.BattleAiming) return;
        var st = G.BattleAimConfirm();
        var token = G.BattleExecToken();
        <span class="bp-confirm">
            <button type="button" class="primary bp-go" data-aim-confirm aria-keyshortcuts="Enter" disabled="@(!st.Ok)" title="@st.Why"
                    @onclick="() => G.BattleAimSubmit(token)">@ShellAim.ConfirmLabel(st.Name)<EnterCap On="@st.Ok" /></button>
            @if (!string.IsNullOrEmpty(st.Why)) { <span class="bp-why warn-text" role="status">@st.Why</span> }
        </span>
    };

    /// <summary>战斗记录子页：阅读旧段时新增的条数（只存界面）；点「有{n}条新记录」或「回到最新」才回到末尾。</summary>
    private int _logNew;
    private int _logSeenCount = -1;
    private string? _logOpenKey;

    private async Task LogToLatest()
    {
        _logNew = 0;
        try { await JS.InvokeVoidAsync("survivalBattleUi.logBottom", "bfs-drawer-body"); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    /// <summary>
    /// 渲染后：Q529 新选无目标指令把焦点交给实际确认按钮一次；阅读区展开滚进视野／收起滚回顶部；子页返回把焦点交回发起入口（已不在时回战报标题）；
    /// 战斗记录打开时定位最新或所点的那一条，之后在末尾时跟随新记录，阅读旧段时只累计「有{n}条新记录」不抢滚动。
    /// </summary>
    private async Task AfterRenderInfo()
    {
        try
        {
            if (G.BattleConfirmFocusPending)
            {
                G.BattleConfirmFocusPending = false;
                await JS.InvokeVoidAsync("survivalBattleUi.focus", "bt-confirm", null, true);
            }
            if (G.BattleScrollTo is string where)
            {
                G.BattleScrollTo = null;
                await JS.InvokeVoidAsync("survivalBattleUi.scroll", where);
            }
            if (G.BattleFocusId is string fid)
            {
                G.BattleFocusId = null;
                await JS.InvokeVoidAsync("survivalBattleUi.focus", fid, fid.StartsWith("bi-rec-") ? "bi-log-title" : null, false);
            }
            var b = G.S.Battle;
            if (G.BattleDrawer == "log" && b != null)
            {
                var key = $"{b.BattleId}:{G.BattleLogLocate}";
                if (_logOpenKey != key)
                {
                    _logOpenKey = key;
                    _logNew = 0;
                    _logSeenCount = b.Log.Count;
                    await JS.InvokeVoidAsync("survivalBattleUi.logOpen", "bfs-drawer-body", G.BattleLogLocate is int at ? $"blog-{at}" : null);
                }
                else if (b.Log.Count > _logSeenCount)
                {
                    var added = b.Log.Count - _logSeenCount;
                    _logSeenCount = b.Log.Count;
                    var followed = await JS.InvokeAsync<bool>("survivalBattleUi.logFollow", "bfs-drawer-body");
                    if (!followed) { _logNew += added; StateHasChanged(); }
                }
            }
            else { _logOpenKey = null; _logNew = 0; }
        }
        catch (JSException) { }
        catch (InvalidOperationException) { }
        catch (TaskCanceledException) { }
    }

}
