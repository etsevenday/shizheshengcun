@inherits GameComponent

@* 顶栏“对话记录”（S14 §10.4）：与行动日志分开。按每次对话分组，左侧列表显示游戏内日期时间、地点与对话对象，
   右侧按原顺序显示发言者、正文与左右归属（正文 22px，可滚动）。只收录已实际展示并结束的对话，不暴露未触发或未展示的后续句。
   只允许浏览、切换记录和关闭：关闭或 Esc 只退出回看，不重播剧情、不推进时间、不发奖励。对话进行中与战斗中入口禁用。 *@
@{
    var s = G.S;
    var e = G.E;
    var hist = e.DialogueHistory(s);
    var pick = hist.FirstOrDefault(h => h.Id == G.DialogLogPick) ?? hist.LastOrDefault();
}

<div class="sub-panel dlog-panel" role="dialog" aria-label="对话记录">
    <div class="sub-head">
        @* Q315：有记录时副标题「已收录{数量}段 · 回看不消耗时间」（一组一段），无记录时省略副标题 *@
        <div><h2>对话记录</h2>@if (GameEngine.DialogueLogSubtitle(hist.Count) is string subtitle) {<span class="sub">@subtitle</span>}</div>
        <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
    </div>
    @if (hist.Count == 0)
    {
        <div class="sub-body">
            <div class="empty-zone dlog-empty"><span>@GameEngine.DialogueLogEmptyText</span></div>
        </div>
    }
    else
    {
        <div class="sub-body dlog-body">
            <div class="dlog-list" data-wheel="y" role="listbox" aria-label="对话列表">
                @foreach (var h in Enumerable.Reverse(hist))
                {
                    var id = h.Id;
                    var on = pick != null && pick.Id == id;
                    <button type="button" role="option" aria-selected="@on" class="dlog-item @(on ? "on" : "")" @onclick="() => Pick(id)">
                        @* 试玩修复 B11：每组标出事件名（同一时刻的“首战胜利”“融合完成”可区分）；旧存档组只写一次“时间地点未记录” *@
                        @* Q306：整组无对方发言时省略对象项及其分隔符 *@
                        <b><span class="dlog-event">@EventName(h)</span>@if (!string.IsNullOrEmpty(h.Counterpart)) {<span>· @h.Counterpart</span>}</b>
                        <small>@WhenWhere(h)</small>
                    </button>
                }
            </div>
            @if (pick != null)
            {
                <div class="dlog-read" data-wheel="y" tabindex="0" aria-label="对话内容">
                    <div class="dlog-read-head">
                        <img src="img/portraits/protagonist.svg" alt="主角（临时形象）" />
                        <span><b>@EventName(pick)</b> · @WhenWhere(pick)</span>
                        @if (!string.IsNullOrEmpty(pick.Counterpart))
                        {
                            <img src="@(pick.Counterpart == "饱饱" ? "img/portraits/baobao.svg" : "img/portraits/unknown.svg")" alt="@($"{pick.Counterpart}（临时形象）")" />
                        }
                    </div>
                    <div class="dlg-stream static">
                        <DialogueLines Lines="pick.Lines" />
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private void Pick(int id)
    {
        G.DialogLogPick = id;
        G.Notify();
    }

    private void Close() => G.OpenPanel(null);

    /// <summary>对话所属事件的玩家可读名称；旧存档导入组统一叫“旧存档记录”。</summary>
    private string EventName(DialogueSession h) => h.Legacy ? "旧存档记录" : G.E.DialogueSetTitle(h.EventId) ?? h.EventId switch
    {
        "opening" => "开场",
        "tutorial_arrive" => "首战到达",
        "tutorial_won" => "首战胜利",
        "fusion_done" => "融合完成",
        _ => "对话",
    };

    private string WhenWhere(DialogueSession h)
    {
        if (h.Minute == null && h.LocationId == null) return "时间地点未记录";
        return $"{(h.Minute is int m ? Clock.DayTime(m) : "时间未记录")} · {(h.LocationId != null ? G.E.LocName(h.LocationId) : "地点未记录")}";
    }
}
