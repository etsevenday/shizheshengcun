@inherits GameComponent

@{
    var s = G.S;
    var e = G.E;
    var main = s.Main!;
    var sub = s.Sub;
    var travel = main.Type == ActionType.Travel;
    var allowGround = !travel;
    var stat = main.PauseStat;
    var zero = main.PauseReason == PauseReason.StatZero;
    var work = main.IsWorkType;
    var remaining = work ? Math.Max(0, main.BaseWorkMinutes - main.WorkDone) : Math.Max(0, main.PlannedMinutes - main.ElapsedMinutes);
    var supplies = new[] { "clean_water", "boiled_root", "cooked_root", "boiled_meat", "cooked_meat", "canned_food", "berry", "bandage", "antibiotics" };
    var busy = sub != null || G.Running;
}

<div class="center-layer" role="alertdialog" aria-label="行动暂停">
    @if (sub != null)
    {
        <div class="eyebrow"><span class="status-chip sub">正在补给／维护</span></div>
        <h2>@sub.Label</h2>
        <p class="lead">“@(main.Label)”保持暂停，进度与预留不变。补给完成后需要确认才会继续。</p>
    }
    else
    {
        <div class="eyebrow"><span class="status-chip paused">已暂停</span> · @main.Label</div>
        @if (stat.HasValue)
        {
            <h2>@(GameEngine.StatName(stat.Value))@(zero ? "归零" : "偏低") · @(main.Label)已暂停</h2>
            <p class="lead">@e.AlertText(stat.Value, zero)当前@(GameEngine.StatName(stat.Value))为@(Ui.N(s.Stats.Get(stat.Value)))。补给不会自动进行，请选择处理方式。</p>
        }
        else
        {
            <h2>@(main.Label)已暂停</h2>
        }
    }

    <div class="lines" style="max-width:520px">
        <div><span>@(work ? "剩余工作量" : "剩余时长")</span><b>@(Ui.T(remaining))分钟</b></div>
        @if (main.ReservedItemIds.Count > 0)
        {
            var res = s.Items.Where(i => main.ReservedItemIds.Contains(i.InstanceId)).GroupBy(i => i.ItemId).Select(g => $"{e.ItemName(g.Key)}{g.Sum(i => i.Count)}");
            <div><span>预留材料</span><b>@string.Join("、", res)</b></div>
        }
        @if (main.ReservedResourceUnits > 0)
        {
            <div><span>预留库存</span><b>@main.ReservedResourceUnits</b></div>
        }
        @if (travel) { <div><span>位置</span><b>前往@(e.LocName(main.TargetId))途中 · 只能使用随身物品</b></div> }
    </div>

    @if (sub == null)
    {
        {
            <h3 style="margin:4px 0 0;font-weight:500">可用补给@(travel ? "（随身）" : "（随身与地面）")</h3>
            <div class="supply-grid">
                @foreach (var id in supplies)
                {
                    var batch = e.UsableBatches(s, id, allowGround, true).FirstOrDefault();
                    if (batch == null) continue;
                    var cfg = e.Item(id);
                    var req = ActionRequest.UseInstance(batch.InstanceId);
                    var p = G.Preview(req);
                    <button class="secondary supply-btn" disabled="@(!p.Ok || busy)" title="@p.Reason" @onclick="() => Sub(req)"><span class="ir-icon">@Icons.Markup(id)</span><span class="sb-name">@GameEngine.UseVerb(cfg)1份@(cfg.Name)·5分钟</span><small>@(cfg.Use == null ? "" : e.MedicineEffectText(s, cfg.Use) ?? GameEngine.UseEffectText(cfg.Use))</small></button>
                }
                <button class="secondary supply-btn rest" disabled="@busy" @onclick="() => Sub(ActionRequest.Rest(30))"><span class="sb-name">休息30分钟@(travel ? "（露天）" : "")</span></button>
            </div>
            var dirty = e.UsableBatches(s, "dirty_water", allowGround, true).FirstOrDefault();
            @if (dirty != null)
            {
                <div class="risk" style="max-width:820px">
                    脏水可以应急补水30，但必定腹泻12小时（期间每小时额外失水3）。
                    <button class="linkish" disabled="@busy" @onclick="() => Sub(ActionRequest.UseInstance(dirty.InstanceId))">仍然饮用1份脏水</button>
                </div>
            }
            @if (!supplies.Any(id => e.UsableBatches(s, id, allowGround, true).Any()))
            {
                <div class="risk none">@(travel ? "随身没有可用的补给。" : "随身和地面都没有可用的补给。")</div>
            }
        }

        @* 暂停层点火（系统策划总册 v1.0 Q5-3，S01 §7、S09 §6）：主行动暂停、不在移动途中、当地火堆未燃烧时，选一把具体打火器开始 5 分钟点火维护；
           结束仍回到暂停，主行动要明确继续。移动途中、战斗中不提供。 *@
        @if (!travel && e.Location(s.CurrentLocation).HasFire && !s.Locations[s.CurrentLocation].Facility.FireLit)
        {
            var fac = s.Locations[s.CurrentLocation].Facility;
            var opts = e.IgniteToolOptions(s);
            <h3 style="margin:4px 0 0;font-weight:500">点燃火堆 · @(e.LocName(s.CurrentLocation))（燃料@(fac.FuelMinutes)分钟）</h3>
            <div class="supply-grid">
                @foreach (var o in opts)
                {
                    var req = ActionRequest.Ignite(o.InstanceId);
                    var p = G.Preview(req);
                    <button class="secondary supply-btn" disabled="@(!o.Usable || busy)" title="@(o.Reason ?? "选定这把打火器，开始5分钟点火；结束后主行动仍暂停")" @onclick="() => Sub(req)">
                        <span class="ir-icon">@Icons.Markup(o.ItemId)</span><span class="sb-name">用@(o.Name)点火·@(e.Config.Fire.IgniteMinutes)分钟</span>
                        <small>@o.Source@(o.Durability.HasValue ? $" · 耐久{Ui.N(o.Durability.Value)}→{Ui.N(Math.Max(0, o.Durability.Value - e.LighterWear))}" : "")@(p.AutoWood ? " · 自动投入1木材" : "")@(o.Reason != null ? " · " + o.Reason : "")</small>
                    </button>
                }
            </div>
            @if (e.IgniteNoToolReason(s) is string noTool) { <div class="risk none">@noTool</div> }
        }

        <div class="btn-row" style="max-width:520px;margin-top:auto">
            <button class="primary" disabled="@busy" @onclick="G.Resume">继续@(main.Label)</button>
            <button class="secondary danger" disabled="@busy" @onclick="G.Cancel">取消@(main.Label)</button>
        </div>
        <div class="tiny muted">@CancelHint(main)</div>
    }
    @if (G.Notice != null) { <div class="notice" style="max-width:720px">@G.Notice</div> }
</div>

@code {
    private async Task Sub(ActionRequest r) => await G.StartAction(r);


    private static string CancelHint(ActionState a) => a.Type switch
    {
        ActionType.Travel => "取消移动：留在出发地，已经流逝的时间与身体消耗保留。",
        ActionType.Gather => "取消搜集：不给产物、不磨损工具，预留库存释放。",
        ActionType.Craft or ActionType.Build => "取消制作：预留材料返还当前地面，不生成半成品。",
        ActionType.Explore => "取消探索：探索度不变、不给随机物资，已消耗的时间保留。",
        ActionType.Clear => "取消清理：不给物资，已扣除的1次清理机会不返还，已消耗的时间保留。",
        _ => "取消后已流逝的时间不返还。",
    };
}
