@inherits GameComponent
@inject IJSRuntime JS

@* 选中物品卡时贴在卡片旁边的拾取/放下条（试玩留言 fb68265e，按策划要求：拾取界面出现在卡片下方，可直接输入数字）。
   地面物品卡在卡片下方弹出“拾取”，随身物品卡在上方弹出“放下”；回车确认，Esc 收起。卡片角上的三角箭头是另一条路：直接转移 1 件，不抢焦点。
   光标不在条内时的回车由 app.js 的 hookKeys 转成点击“拾取/放下”按钮，所以点完卡片直接回车也能按默认数量确认。 *@
@{
    var info = Current();
    SyncDefault(info);
}
@if (info != null && info.Facility)
{
    var e = G.E;
    var s = G.S;
    var it = s.Items.First(i => i.InstanceId == info.InstanceId);
    var name = $"{e.ItemName(it.ItemId)}#{it.InstanceId}";
    var grams = e.ItemGrams(s, it);
    var downWhy = e.IsBusy(s) || G.Running ? "行动进行中，暂不能整理物品" : e.TakeOutBlocked(s, it, s.CurrentLocation);
    var upWhy = e.IsBusy(s) || G.Running ? "行动进行中，暂不能整理物品" : e.TakeOutBlocked(s, it, ItemInstance.Carried);
    @* 设施与锅里的物品：卡边操作条给出两个明确目标（统一卡片案第 5 节），与拖出同一校验 *@
    <div @ref="bar" class="tbar below" role="dialog" aria-label="@($"转移{name}")" @onkeydown="OnKey">
        <span class="tbar-tip"></span>
        <div class="tbar-head">
            <span class="ir-icon">@Icons.Markup(it.ItemId)</span>
            <b>@name@(e.IsPot(it) ? "（含内容）" : "")</b>
            <span>@e.WherePath(s, it) · @(Ui.Kg(grams))公斤</span>
        </div>
        <div class="tbar-row">
            <button type="button" class="tbar-go" disabled="@(downWhy != null)" title="@downWhy" @onclick="() => Take(it, s.CurrentLocation)">@(e.IsPot(it) ? "取下到地面" : "取出到地面")</button>
            <button type="button" class="tbar-go" disabled="@(upWhy != null)" title="@upWhy" @onclick="() => Take(it, ItemInstance.Carried)">拾取到随身</button>
        </div>
        <div class="tbar-note @(downWhy != null || upWhy != null ? "bad" : "")">@(upWhy ?? downWhy ?? $"拾取后随身{Ui.Kg(e.CarriedGrams(s) + grams)}公斤 · 取出即清零该对象的加工进度 · 不耗时")</div>
    </div>
}
else if (info != null)
{
    var e = G.E;
    var s = G.S;
    var item = e.Item(info.ItemId);
    var busy = e.IsBusy(s) || G.Running;
    var verb = info.ToCarried ? "拾取" : "放下";
    var n = Parse();
    var invalid = n < 1 || n > info.Available;
    var tooHeavy = !invalid && info.ToCarried && n > info.Max;
    var after = e.CarriedGrams(s) + (info.ToCarried ? 1 : -1) * item.WeightGrams * (invalid ? 0 : n);
    <div @ref="bar" class="tbar @(info.ToCarried ? "below" : "above")" role="dialog" aria-label="@($"{verb}{item.Name}")" @onkeydown="OnKey">
        <span class="tbar-tip"></span>
        <div class="tbar-head">
            <span class="ir-icon">@Icons.Markup(item.Id)</span>
            <b>@(verb)@(item.Name)</b>
            <span>@(info.ToCarried ? $"{e.LocName(info.Owner)}地面" : "随身") ×@info.Available@(info.ExpiresAt.HasValue ? $" · {Ui.Fresh(info.ExpiresAt.Value - s.GameMinute)}" : "")</span>
        </div>
        @if (busy)
        {
            <div class="tbar-note">行动进行中，暂不能整理物品</div>
        }
        else if (info.Available == 0)
        {
            <div class="tbar-note">该物品正被当前行动预留，不能@(verb)</div>
        }
        else if (info.Single)
        {
            <div class="tbar-row">
                <button type="button" class="tbar-go" disabled="@(info.ToCarried && info.Max < 1)" @onclick="() => Go(1)">@(verb)</button>
                @if (info.InstanceId.HasValue && e.IsPot(s.Items.First(i => i.InstanceId == info.InstanceId)) && e.Location(s.CurrentLocation).HasFire)
                {
                    var potItem = s.Items.First(i => i.InstanceId == info.InstanceId);
                    e.MaxPutInFire(s, potItem, out var fireWhy);
                    <button type="button" class="tbar-go" disabled="@(fireWhy != null)" title="@fireWhy" @onclick="() => PutInFire(potItem.InstanceId)">放入火堆</button>
                }
            </div>
            @if (info.InstanceId.HasValue && e.IsPot(s.Items.First(i => i.InstanceId == info.InstanceId)) && e.Location(s.CurrentLocation).HasFire
                 && Why(s.Items.First(i => i.InstanceId == info.InstanceId)) is string fw)
            {
                <div class="tbar-note bad">放入火堆：@fw</div>
            }
            @if (info.ToCarried && info.Max < 1)
            {
                <div class="tbar-note bad">携带后将超过@(e.Config.Carry.HardGrams / 1000)公斤，拿不动了</div>
            }
            else
            {
                <div class="tbar-note">@(verb)后随身@(Ui.Kg(after))公斤 · 不耗时</div>
            }
        }
        else
        {
            <div class="tbar-row">
                <button type="button" class="tbar-step" aria-label="减少" @onclick="() => Step(-1)">−</button>
                <input @ref="input" type="text" inputmode="numeric" value="@text" @oninput="OnInput" aria-label="数量" />
                <button type="button" class="tbar-step" aria-label="增加" @onclick="() => Step(1)">+</button>
                <button type="button" class="tbar-max" @onclick="() => SetN(info.ToCarried ? info.Max : info.Available)">@(info.ToCarried ? $"最多{info.Max}" : "全部")</button>
                <button type="button" class="tbar-go" disabled="@(invalid || tooHeavy)" @onclick="() => Go(n)">@(verb)@(invalid ? "" : $" {n}")</button>
            </div>
            @if (invalid)
            {
                <div class="tbar-note bad">请输入 1 到 @info.Available 之间的数字</div>
            }
            else if (tooHeavy)
            {
                <div class="tbar-note bad">携带后将超过@(e.Config.Carry.HardGrams / 1000)公斤，最多可取@(info.Max)份</div>
            }
            else
            {
                <div class="tbar-note @(after > e.Config.Carry.SoftGrams ? "warn" : "")">@(verb)后随身@(Ui.Kg(after))公斤@(after > e.Config.Carry.SoftGrams ? "，超过20公斤会减速" : "") · 回车确认</div>
            }
        }
    </div>
}

@code {
    private sealed record Info(string Owner, string ItemId, int? InstanceId, int? ExpiresAt, int Available, int Max, bool ToCarried, bool Single, bool Facility = false)
    {
        public string Key => InstanceId.HasValue ? $"{Owner}|{ItemId}|{InstanceId}" : $"{Owner}|{ItemId}";
    }

    private ElementReference bar;
    private ElementReference input;
    private string text = "1";
    private string lastKey = "";
    private bool anchored;

    /// <summary>按当前选中的物品卡计算可转移的批次与数量；选中的不是当前可取用的物品时返回 null。</summary>
    private Info? Current()
    {
        if (G.State == null) return null;
        // 二级面板或暂停面板盖住卡片时不显示（设施菜单只盖地块区，照常显示）
        if (G.Panel != null || G.S.Sub != null || G.S.Main?.Status == ActionStatus.Paused || G.S.Progress.Dead) return null;
        var sel = G.Selected;
        if (sel.Kind != SelectionKind.ItemGroup && sel.Kind != SelectionKind.Tool) return null;
        var s = G.S;
        if (sel.InstanceId is int fid && s.Items.FirstOrDefault(i => i.InstanceId == fid) is ItemInstance fi
            && (fi.InFacility || (fi.InContainer && !G.E.IsLiquid(fi))))
        {
            var place = G.E.PlaceOf(s, fi);
            return place == ItemInstance.Carried || place == s.CurrentLocation
                ? new Info(fi.Owner, fi.ItemId, fi.InstanceId, null, 1, 1, false, true, true) : null;
        }
        if (sel.Owner != ItemInstance.Carried && sel.Owner != s.CurrentLocation) return null;
        var toCarried = sel.Owner != ItemInstance.Carried;
        if (sel.Kind == SelectionKind.Tool && sel.InstanceId.HasValue)
        {
            var t = s.Items.FirstOrDefault(i => i.InstanceId == sel.InstanceId.Value && i.Owner == sel.Owner);
            if (t == null) return null;
            var free = t.ReservedBy == null ? 1 : 0;
            return new Info(sel.Owner, sel.Id, t.InstanceId, null, free, toCarried ? G.MaxPickup(sel.Id, free, t) : free, toCarried, true);
        }
        var all = s.Items.Where(i => i.Owner == sel.Owner && i.ItemId == sel.Id).ToList();
        if (all.Count == 0) return null;
        var stacks = all.Where(i => i.ReservedBy == null).ToList();
        if (stacks.Count == 0) return new Info(sel.Owner, sel.Id, null, null, 0, 0, toCarried, true);
        var expires = stacks.OrderBy(i => i.ExpiresAt ?? int.MaxValue).ThenBy(i => i.InstanceId).First().ExpiresAt;
        var available = stacks.Where(i => i.ExpiresAt == expires).Sum(i => i.Count);
        var max = toCarried ? G.MaxPickup(sel.Id, available) : available;
        return new Info(sel.Owner, sel.Id, null, expires, available, max, toCarried, available == 1);
    }

    /// <summary>
    /// 选中的卡或它的可取数量一变，就把输入框重置为默认数量。
    /// 放在渲染路径里而不是 ShouldRender：卡角箭头一次点击里先选中再转移，连着两次 StateHasChanged
    /// 会被合并成一次渲染，第二次不再调用 ShouldRender，输入框就会留着转移前的数量。
    /// </summary>
    private void SyncDefault(Info? info)
    {
        var key = info == null ? "" : $"{info.Key}|{info.ExpiresAt}|{info.Available}";
        if (key == lastKey) return;
        lastKey = key;
        if (info != null) text = (info.ToCarried ? Math.Max(1, Math.Min(info.Available, info.Max)) : info.Available).ToString();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var info = Current();
        if (info == null)
        {
            if (anchored)
            {
                anchored = false;
                await JS.InvokeVoidAsync("survival.releaseBar");
            }
            return;
        }
        anchored = true;
        // 不抢焦点：点卡片后快捷键照常可用，按数字或回车由 app.js 的 hookKeys 转到条内
        await JS.InvokeVoidAsync("survival.anchorBar", bar, info.Key, info.Facility || info.ToCarried ? "below" : "above");
    }

    private int Parse() => int.TryParse(text.Trim(), out var v) ? v : 0;

    private void OnInput(ChangeEventArgs ev) => text = new string((ev.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());

    private void SetN(int v) => text = Math.Max(1, v).ToString();

    private void Step(int d)
    {
        var info = Current();
        if (info == null) return;
        SetN(Math.Clamp(Parse() + d, 1, Math.Max(1, info.Available)));
    }

    private void OnKey(KeyboardEventArgs ev)
    {
        if (ev.Key == "Enter")
        {
            var info = Current();
            if (info == null) return;
            Go(info.Single ? 1 : Parse());
        }
        else if (ev.Key == "Escape")
        {
            G.ClearSelection();
        }
    }

    private string? Why(ItemInstance pot)
    {
        G.E.MaxPutInFire(G.S, pot, out var why);
        return why;
    }

    private void PutInFire(int potId)
    {
        if (G.E.IsBusy(G.S) || G.Running) return;
        G.Instant(InstantRequest.PutInFire(potId));
        G.ClearSelection();
    }

    private void Take(ItemInstance it, string zone)
    {
        if (G.E.IsBusy(G.S) || G.Running) return;
        G.TransferOne(it.Owner, it.ItemId, it.InstanceId, zone);
    }

    private void Go(int n)
    {
        var info = Current();
        if (info == null || G.E.IsBusy(G.S) || G.Running) return;
        if (n < 1 || n > info.Available || (info.ToCarried && n > info.Max)) return;
        if (info.InstanceId.HasValue) G.TransferOne(info.Owner, info.ItemId, info.InstanceId);
        else G.TransferBatch(info.Owner, info.ItemId, info.ExpiresAt, n, info.ToCarried);
        // 这一堆全部转走后收起拾取条
        if (!G.S.Items.Any(i => i.Owner == info.Owner && i.ItemId == info.ItemId && (!info.InstanceId.HasValue || i.InstanceId == info.InstanceId)))
            G.ClearSelection();
    }
}
