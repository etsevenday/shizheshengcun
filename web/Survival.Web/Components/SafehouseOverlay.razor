@inherits GameComponent

@* 安全屋面板（S09 X2.5、X2.6、X2.9；开发计划 v0.9 B17 R54/R55）：
   ① 在某屋屋内时：这间屋的柜子（容量条、柜内每堆“取到随身/取到屋内地面”，随身与屋内地面每堆“放进柜子”；0 分钟，超容量/五卡/30kg 整次拒绝）；
   ② 全部已建安全屋：改名、设为常用（只是收藏）、返程路线文字（只定位，不传送）、远处柜子的“上次记录”（只读，不能取放）。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var inside = s.CurrentZone == GameState.SafehouseZone && e.SafehouseBuilt(s, here);
    var houses = e.BuiltSafehouses(s);
    var blocked = inside ? e.CabinetBlocked(s) : null;
}

<div class="sub-panel safehouse-panel" role="dialog" aria-label="安全屋">
    <div class="sub-head">
        <div><h2>安全屋</h2><span class="sub">@(inside ? $"{e.SafehouseName(s, here)}屋内 · 柜子存取0分钟" : "收藏、改名与返程路线 · 柜子只能在屋内存取")</span></div>
        <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
    </div>
    <div class="sub-body sh-body" data-wheel="y">
        @if (inside)
        {
            var grams = e.CabinetGrams(s, here);
            var cap = e.CabinetCapacityGrams;
            var items = e.CabinetItems(s, here);
            var mine = s.Items.Where(i => (i.IsCarried || i.Owner == s.Ground) && !i.InContainer).OrderBy(i => i.IsCarried ? 0 : 1).ThenBy(i => i.ItemId).ThenBy(i => i.InstanceId).ToList();
            <section class="sh-cabinet">
                <h3>柜子 <small class="muted">@Ui.Kg(grams)/@Ui.Kg(cap)公斤 · 不保鲜 · 不限卡数</small></h3>
                <div class="fuel-track"><i style="width:@(Math.Min(100, grams * 100 / Math.Max(1, cap)))%"></i></div>
                @if (blocked != null) { <div class="risk">@blocked</div> }
                <div class="sh-cols">
                    <div>
                        <div class="tiny muted">柜内（@(items.Count)堆）</div>
                        @foreach (var it in items)
                        {
                            var id = it.InstanceId;
                            var n = it.Count;
                            var maxC = e.MaxTakeFromCabinet(s, it, ItemInstance.Carried, out var whyC);
                            <ItemRow Icon="@it.ItemId" Name="@($"{e.ItemName(it.ItemId)}")" Qty="@($"×{n}")" Status="@($"{Ui.Kg(e.ItemGrams(s, it))}公斤{ExpiryText(it)}")">
                                <button type="button" class="linkish" disabled="@(blocked != null || maxC < 1)" title="@(whyC ?? $"取{n}份到随身（0分钟）")" @onclick="() => Take(id, n, ItemInstance.Carried)">到随身</button>
                                <button type="button" class="linkish" disabled="@(blocked != null)" title="@($"取{n}份到屋内地面（0分钟）")" @onclick="() => Take(id, n, G.S.Ground)">到地面</button>
                            </ItemRow>
                        }
                        @if (items.Count == 0) { <div class="risk none">柜子是空的。</div> }
                    </div>
                    <div>
                        <div class="tiny muted">随身与屋内地面</div>
                        @foreach (var it in mine)
                        {
                            var id = it.InstanceId;
                            var n = it.Count;
                            var max = e.MaxStoreInCabinet(s, it, out var why);
                            <ItemRow Icon="@it.ItemId" Name="@($"{e.ItemName(it.ItemId)}")" Qty="@($"×{n}")" Status="@($"{(it.IsCarried ? "随身" : "屋内地面")} · {Ui.Kg(e.ItemGrams(s, it))}公斤")">
                                <button type="button" class="linkish" disabled="@(max < n)" title="@(why ?? (max < n ? $"柜子只放得下{max}份" : $"{n}份放进柜子（0分钟）"))" @onclick="() => Store(id, n)">放进柜子</button>
                            </ItemRow>
                        }
                        @if (mine.Count == 0) { <div class="risk none">随身与屋内地面没有物品。</div> }
                    </div>
                </div>
            </section>
        }
        <section class="sh-list">
            <h3>已建成的安全屋（@(houses.Count)）</h3>
            @foreach (var loc in houses)
            {
                var l = loc;
                var (lines, minute) = e.CabinetRecord(s, l);
                var fav = s.FavoriteSafehouse == l;
                <div class="sh-row">
                    <div class="sh-row-head">
                        <b>@e.SafehouseName(s, l)@(fav ? " ★常用" : "")</b>
                        <span class="muted">@e.LocName(l)</span>
                        <button type="button" class="linkish" @onclick="() => Favorite(l, fav)">@(fav ? "取消常用" : "设为常用")</button>
                        <input class="sh-name" maxlength="12" placeholder="改名（最多12字）" value="@(_names.TryGetValue(l, out var v) ? v : "")" @onchange="ev => SetName(l, ev)" />
                        <button type="button" class="linkish" @onclick="() => Rename(l)">改名</button>
                    </div>
                    <div class="tiny">@e.SafehouseRouteText(s, l)</div>
                    @if (!(inside && l == here))
                    {
                        <div class="tiny muted">柜子上次记录@(minute is int m ? $"（{Clock.DayTime(m)}）" : "（还没进过屋）")：@(lines.Count == 0 ? "空" : string.Join("、", lines.Select(x => $"{x.Name}×{x.Count}")))（只读，不能远程取放）</div>
                    }
                </div>
            }
            @if (houses.Count == 0) { <div class="risk none">还没有建成的安全屋。在可建地点的设施栏“安全屋”卡或制作面板“营地建造”里建。</div> }
        </section>
    </div>
</div>

@code {
    private readonly Dictionary<string, string> _names = new Dictionary<string, string>();

    private void Close() => G.OpenPanel(null);

    private void SetName(string loc, ChangeEventArgs ev) => _names[loc] = ev.Value?.ToString() ?? "";

    private string ExpiryText(ItemInstance it)
    {
        if (!it.ExpiresAt.HasValue) return "";
        return G.E.IsSpoiled(G.S, it) ? " · 已腐败" : $" · 剩{Clock.Duration(it.ExpiresAt.Value - G.S.GameMinute)}";
    }

    private void Take(int id, int n, string zone) => G.Instant(InstantRequest.TakeCabinet(id, n, zone));
    private void Store(int id, int n) => G.Instant(InstantRequest.StoreCabinet(id, n));
    private void Favorite(string loc, bool fav) => G.EngineDo(() => G.E.SetFavoriteSafehouse(G.S, fav ? null : loc));
    private void Rename(string loc) => G.EngineDo(() => G.E.RenameSafehouse(G.S, loc, _names.TryGetValue(loc, out var v) ? v : ""));
}
