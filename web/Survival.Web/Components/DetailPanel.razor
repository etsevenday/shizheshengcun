@inherits GameComponent

@* 右栏（基础UI布局与操作修订案 v0.7 第 6.1 节；S14 §11.1 起执行进度移到中央推进条）：
   固定两个页签「对象」「人物」（B31b R54，逐字稿 §2 右栏）→ 详情区；对象页顶部区标题「对象详情」。
   悬停具体操作时详情区临时显示预测，离开恢复原页签；无选中时默认人物页，选中任何对象自动切到对象页；
   对象页没有当前对象、也没有面板详情／临时预估／战斗详情接管时，显示 Q328「当前位置」摘要和「选择对象查看详情。」。页签只在会话内，不持久化。 *@
@{
    var s = G.S;
    var e = G.E;
    var sel = G.Selected;
    var craftPaused = s.Main != null && s.Main.Status == ActionStatus.Paused && (s.Main.Type == ActionType.Craft || s.Main.Type == ActionType.Build);
    var craftDetail = G.Panel == "craft" && s.Sub == null && (s.Main == null || craftPaused);
    var dragPreview = sel.Kind == SelectionKind.Action && G.PendingAction != null && s.Sub == null
                      && (s.Main == null || s.Main.Status == ActionStatus.Paused) && !G.Running;
    var tab = G.DetailTab;
    // 悬停预测临时占用详情区时，页签高亮跟着内容走（显示的是对象预测，不是人物页）（试玩修复 L6）
    var battlePanel = G.InBattleUi && tab == DetailTab.Object && !(s.Encounter != null && G.HoverPreview != null);
    // B32a 试玩修复（R61、Q351）：指着已选中资源卡自己的采集键时，悬停预测与选中预估是同一请求，右栏保持「已选中」与来源行，
    // 不再换成「预测」（采到库存 0 后按钮变禁用、指针仍停在上面时，原来会一直停在预测）
    var hover = sel.Kind == SelectionKind.Resource && G.HoverPreview is { Type: ActionType.Gather, ToolInstanceId: null, BareHands: false } hp && hp.TargetId == sel.Id
        ? null : G.HoverPreview;
    // B33（Q450）：整备页内点来源卡或已穿戴装备，只读整备详情临时覆盖右栏（不改真正选中与页签记忆）；关闭或切人即恢复
    var gearPeek = battlePanel || G.BattleFullscreen ? null : G.GearPeekItem;
    // B42（S14 2026-11-12 悬停卡片／条目立即显示右栏详情）：悬停或键盘焦点所在的真实对象临时覆盖详情区，页签高亮跟着内容走（原页签与点击选择不动）；
    // 具体操作预测（动作键悬停、拖拽落点）与拖拽打开的行动预览优先，离开后回到最后有效的悬停对象。全屏战斗的悬停在战斗画面右侧（BattlePanel）。
    var peekKey = G.BattleFullscreen ? null : G.PeekKeyNow;
    if (PeekKey.KindOf(peekKey) is PeekKey.Foe or PeekKey.Ally) peekKey = null;
    var peekShown = peekKey != null && !dragPreview && !(hover != null && G.Panel == null);
    var shownTab = gearPeek != null || peekShown || (!battlePanel && hover != null && G.Panel == null) ? DetailTab.Object : tab;
}

<aside class="panel detail" aria-label="@($"{ShellText.ObjectTab}与{ShellText.CharacterTab}")" inert="@G.DialogueLocked">
    @* 开始后的执行进度、剩余时间与退出统一在屏幕中央（S14 §5.1、§11.1），右栏不再重复显示；开始前悬停/选中的预估照常在下方显示 *@
    <div class="detail-tabs" role="tablist" aria-label="右栏页签">
        <button type="button" role="tab" aria-selected="@(shownTab == DetailTab.Object)" class="@(shownTab == DetailTab.Object ? "on" : "")"
                @onclick="() => G.SetDetailTab(DetailTab.Object)">@ShellText.ObjectTab</button>
        <button type="button" role="tab" aria-selected="@(shownTab == DetailTab.Character)" class="@(shownTab == DetailTab.Character ? "on" : "")"
                @onclick="() => G.SetDetailTab(DetailTab.Character)">@ShellText.CharacterTab</button>
    </div>
    @if (shownTab == DetailTab.Object && !G.BattleFullscreen)
    {
        <h2 class="sr-title">@ShellText.ObjectTitle</h2>
    }
    @* B13 序章任务框（试玩修复 M269：从地图卡内移到这里，三档都能直接看到、不压任何按钮） *@
    <TaskCorner />
    <div class="detail-body" role="tabpanel">
    @if (G.BattleFullscreen)
    {
        @* B9：全屏战斗时对象信息在战斗画面内的右栏，这里留在下面不可操作，不重复计算预测 *@
        <div class="empty-detail">战斗中：对象信息在战斗画面右侧</div>
    }
    else if (battlePanel && !peekShown)
    {
        @* 战斗与敌踪：指令预览 → 执行；选中目标详情（v0.5 §16） *@
        <BattlePanel />
    }
    else if (hover != null && G.Panel == null)
    {
        @* 指向或聚焦动作按钮、拖拽悬停时的临时预测；离开后回到原页签（统一卡片案第 3 节、v0.7 第 4.1 节） *@
        <PreviewView Request="G.HoverPreview" Eyebrow="@($"预测 · {e.LocName(s.CurrentLocation)}")" Title="@G.HoverTitle" Confirmable="false" />
    }
    else if (peekShown)
    {
        <PeekDetail Key="@peekKey" />
    }
    else if (gearPeek != null)
    {
        <GearPeekDetail Item="gearPeek" />
    }
    else if (tab == DetailTab.Character)
    {
        <CharacterPanel />
    }
    else if (craftDetail)
    {
        @* 二级面板打开时，右栏显示该面板的详细预估（试玩留言 8f9a7c9b 第 2 点）；开始入口在所选配方卡内（S08 §5、S14 §14.1） *@
        <CraftOverlay Part="detail" />
    }
    else if (dragPreview)
    {
        @* 拖拽打开的耗时交互（指定工具采集）：与按钮同一份内核预估；“开始”在资源卡旁的浮窗（01 案 3.2、S14 §14.1） *@
        <PreviewView Request="G.PendingAction!" Eyebrow="拖拽 · 行动预览" Title="@G.PendingActionTitle" Confirmable="false" FootNote="在资源卡旁的浮窗确认开始；时间为预计值" />
    }
    else if (G.Panel == "map")
    {
        <MapOverlay Part="detail" />
    }
    else if (G.Panel == "rest")
    {
        <RestOverlay Part="detail" />
    }
    else
    {
        <SelectionDetail Sel="sel" />
    }
    </div>
</aside>

@code {
    // B42：悬停对象登记的公开内容变了或登记它的卡片已移除（悬停被清）时立即重绘，不等下一次会话刷新
    protected override void OnInitialized()
    {
        base.OnInitialized();
        G.PeekFactsChanged += OnPeekChanged;
    }

    private void OnPeekChanged() => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        base.Dispose();
        G.PeekFactsChanged -= OnPeekChanged;
    }
}
