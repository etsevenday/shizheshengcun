@inherits GameComponent

@* 右栏（基础UI布局与操作修订案 v0.7 第 6.1 节；S14 §11.1 起执行进度移到中央推进条）：
   固定两个页签「对象」「人物」（B31b R54，逐字稿 §2 右栏）→ 详情区；对象页顶部区标题「对象详情」。
   悬停具体操作时详情区临时显示预测，离开恢复原页签；无选中时默认人物页，选中任何对象自动切到对象页；
   对象页没有当前对象、也没有面板详情／临时预估／战斗详情接管时，显示 Q328「当前位置」摘要和「选择对象查看详情。」。页签只在会话内，不持久化。 *@
@{
    var s = G.S;
    var e = G.E;
    var sel = G.Selected;
    var craftPaused = s.Main != null && s.Main.Status == ActionStatus.Paused && (s.Main.Type == ActionType.Craft || s.Main.Type == ActionType.Build);
    var craftDetail = G.Panel == "craft" && s.Sub == null && (s.Main == null || craftPaused);
    var dragPreview = sel.Kind == SelectionKind.Action && G.PendingAction != null && s.Sub == null
                      && (s.Main == null || s.Main.Status == ActionStatus.Paused) && !G.Running;
    var tab = G.DetailTab;
    // 悬停预测临时占用详情区时，页签高亮跟着内容走（显示的是对象预测，不是人物页）（试玩修复 L6）
    var battlePanel = G.InBattleUi && tab == DetailTab.Object && !(s.Encounter != null && G.HoverPreview != null);
    var shownTab = !battlePanel && G.HoverPreview != null && G.Panel == null ? DetailTab.Object : tab;
}

<aside class="panel detail" aria-label="@($"{ShellText.ObjectTab}与{ShellText.CharacterTab}")" inert="@G.DialogueLocked">
    @* 开始后的执行进度、剩余时间与退出统一在屏幕中央（S14 §5.1、§11.1），右栏不再重复显示；开始前悬停/选中的预估照常在下方显示 *@
    <div class="detail-tabs" role="tablist" aria-label="右栏页签">
        <button type="button" role="tab" aria-selected="@(shownTab == DetailTab.Object)" class="@(shownTab == DetailTab.Object ? "on" : "")"
                @onclick="() => G.SetDetailTab(DetailTab.Object)">@ShellText.ObjectTab</button>
        <button type="button" role="tab" aria-selected="@(shownTab == DetailTab.Character)" class="@(shownTab == DetailTab.Character ? "on" : "")"
                @onclick="() => G.SetDetailTab(DetailTab.Character)">@ShellText.CharacterTab</button>
    </div>
    @if (shownTab == DetailTab.Object && !G.BattleFullscreen)
    {
        <h2 class="sr-title">@ShellText.ObjectTitle</h2>
    }
    @* B13 序章任务框（试玩修复 M269：从地图卡内移到这里，三档都能直接看到、不压任何按钮） *@
    <TaskCorner />
    <div class="detail-body" role="tabpanel">
    @if (G.BattleFullscreen)
    {
        @* B9：全屏战斗时对象信息在战斗画面内的右栏，这里留在下面不可操作，不重复计算预测 *@
        <div class="empty-detail">战斗中：对象信息在战斗画面右侧</div>
    }
    else if (battlePanel)
    {
        @* 战斗与敌踪：指令预览 → 执行；选中目标详情（v0.5 §16） *@
        <BattlePanel />
    }
    else if (G.HoverPreview != null && G.Panel == null)
    {
        @* 指向或聚焦动作按钮、拖拽悬停时的临时预测；离开后回到原页签（统一卡片案第 3 节、v0.7 第 4.1 节） *@
        <PreviewView Request="G.HoverPreview" Eyebrow="@($"预测 · {e.LocName(s.CurrentLocation)}")" Title="@G.HoverTitle" Confirmable="false" />
    }
    else if (tab == DetailTab.Character)
    {
        <CharacterPanel />
    }
    else if (craftDetail)
    {
        @* 二级面板打开时，右栏显示该面板的详细预估（试玩留言 8f9a7c9b 第 2 点）；开始入口在所选配方卡内（S08 §5、S14 §14.1） *@
        <CraftOverlay Part="detail" />
    }
    else if (dragPreview)
    {
        @* 拖拽打开的耗时交互（指定工具采集）：与按钮同一份内核预估；“开始”在资源卡旁的浮窗（01 案 3.2、S14 §14.1） *@
        <PreviewView Request="G.PendingAction!" Eyebrow="拖拽 · 行动预览" Title="@G.PendingActionTitle" Confirmable="false" FootNote="在资源卡旁的浮窗确认开始；时间为预计值" />
    }
    else if (G.Panel == "map")
    {
        <MapOverlay Part="detail" />
    }
    else if (G.Panel == "rest")
    {
        <RestOverlay Part="detail" />
    }
    else
    {
        switch (sel.Kind)
        {
            case SelectionKind.Location when s.Locations[s.CurrentLocation].Progress < 100:
                <PreviewView Request="ActionRequest.Explore()" Eyebrow="@($"已选中 · {e.LocName(s.CurrentLocation)}")" Title="探索周边" Confirmable="false"
                             Subtitle="探索推进地块调查，并有机会取得零散物资；探索度达到100%后不再探索。" />
                break;
            case SelectionKind.Location:
                @* 已充分探索：不把选中态转给清理（试玩修复 B4），清理要新的点击或悬停 *@
                <div class="empty-detail">@e.LocName(s.CurrentLocation)已充分探索<br />点清理按钮或资源卡查看预测</div>
                break;
            case SelectionKind.Clear:
                <PreviewView Request="ActionRequest.Clear()" Eyebrow="@($"已选中 · {e.LocName(s.CurrentLocation)}")" Title="@e.ClearLabelAt(s.CurrentLocation)" Confirmable="false"
                             Subtitle="@(e.Location(s.CurrentLocation).ClearPerGeneration ? "翻找地牢房间里的零散物资。每代只能做1次，不随时间恢复；不领物资箱、守卫或核心记录，不增加探索度。" : "翻找、整理地块表层的零散基础物资。每地有独立次数，随游戏世界时间恢复；不增加探索度。")" />
                break;
            case SelectionKind.Entrance:
                @* B21（R03 D3）：去地牢入口缓冲或从 01 去危险房间时，右栏先给完整进入预告 *@
                // B21 试玩修复 M399：完整预告放进预估的滚动区里（原来放在滚动区外撑高右栏，页面一闪滚动条、相邻卡浮窗被收起）；
                // 01→危险房间时右栏也给“确认开始远征并前往”，不依赖卡旁浮窗
                var dEnt = e.DungeonAt(sel.Id);
                var needExp = e.NeedsExpeditionConfirm(s, sel.Id);
                var showExp = dEnt != null && e.ExpeditionEnabled(dEnt) && (needExp || (e.BufferNodeOf(dEnt) == sel.Id && e.DungeonAt(s.CurrentLocation) != dEnt));
                <PreviewView Request="ActionRequest.Travel(sel.Id, needExp)" Eyebrow="@($"已选中 · 前往{e.LocName(sel.Id)}")" Title="@($"前往{e.LocName(sel.Id)}")" Confirmable="needExp"
                             ConfirmLabel="@(needExp ? "确认开始远征并前往" : null)"
                             FootNote="在相邻地图卡旁的浮窗确认移动；时间为预计值"
                             Subtitle="位置在到达时一次更新；途中不能取用两端的物资。">
                    <Extra>
                        @if (showExp)
                        {
                            <div class="exp-detail"><div class="eyebrow">进入预告 · 只读，不建实例、不抽物资</div><ExpeditionInfo Info="@e.ExpeditionPreview(s, dEnt!)" /></div>
                        }
                    </Extra>
                </PreviewView>
                break;
            case SelectionKind.Resource:
                var r = e.Resource(sel.Id);
                <PreviewView Request="ActionRequest.Gather(sel.Id)" Eyebrow="@($"已选中 · {r.Name}")" Title="@($"{e.GatherVerbNow(s, r)}{r.Name}")" Confirmable="false"
                             Subtitle="工具与成本已计入本次预估。">
                    <Extra>
                        @* B32a Q351：来源行「{资源所在地点名} · {资源账短标}」，地名与账短标取当前配置与现行资源显示口径 *@
                        <div class="facts res-source"><div class="fact"><span>来源</span><strong>@CardStates.ResourceSource(e, r)</strong></div></div>
                    </Extra>
                </PreviewView>
                break;
            case SelectionKind.ItemGroup:
            case SelectionKind.Tool:
            case SelectionKind.PotLiquid:
                <ItemDetail />
                break;
            case SelectionKind.Facility:
                <FireDetail />
                break;
            case SelectionKind.Enemy:
                <EnemyDetail />
                break;
            default:
                @* Q328：读当前实际地点（不跟随选中的地图节点或未抵达的目的地），字段缺失时省略该行；下面保留当前有效的原反馈 *@
                <div class="empty-detail place-summary">
                    <h3>@ShellText.PlaceTitle</h3>
                    <ul class="ps-lines">
                        @foreach (var line in e.CurrentPlaceSummary(s)) { <li>@line</li> }
                    </ul>
                    <p class="ps-hint">@ShellText.ObjectEmptyHint</p>
                    @if (G.RightNotice != null) { <div class="notice">@G.RightNotice</div> }
                </div>
                break;
        }
    }
    </div>
</aside>
