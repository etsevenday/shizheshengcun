@inherits GameComponent

@* 地块上的世界敌人（v0.6 §15“角色当前地点已有的可见敌人卡可主动接近”）：右栏只作详情阅读；“接近并开战”在敌踪卡旁的浮窗（R05 §7、S14 §14.2）。主动接近不受随机接敌保护期限制。 *@
@{
    var s = G.S;
    var e = G.E;
    var wid = G.Selected.InstanceId ?? 0;
    var w = e.FindWorldEnemy(s, wid);
}
@if (w == null || w.LocationId != s.CurrentLocation)
{
    <div class="empty-detail">这个敌人已经离开。<br />选择地点、路线、资源或物品查看信息</div>
}
else
{
    var ec = e.Enemy(w.EnemyId);
    var why = e.CanApproach(s, wid);
    var weapon = e.CurrentWeapon(s, out var wi);
    <div class="detail-scroll">
        <div class="op-head">
            <div class="eyebrow">敌踪 · @e.LocName(w.LocationId)</div>
            <h2>@ec.Name</h2>
            <p>@(ec.IsZombie ? "丧尸" : "动物")@(w.Hostile ? "" : " · 中立（被攻击才转敌对）") · 稀有层级@(ec.Rarity switch { "common" => "普通", "rare" => "稀有", _ => "强敌" })</p>
        </div>
        <div class="detail-icon">@Icons.Markup("enemy_" + ec.Id)</div>
        <div class="lines">
            <div><span>健康</span><b>@Ui.N(w.Hp)/@Ui.N(ec.Hp)</b></div>
            <div><span>护甲 / 闪避 / 速度</span><b>@Ui.T(ec.Armor) / @Ui.T(ec.Dodge) / @Ui.T(ec.Speed)</b></div>
            <div><span>攻击能力 / 对你命中率</span><b>@Ui.T(ec.AttackRating) / @Ui.Pct(GameEngine.HitChance(ec.AttackRating, e.Config.Scope.BasePlayerDodge))</b></div>
            <div><span>伤害</span><b>@Ui.N(ec.DamageMin)—@Ui.N(ec.DamageMax)</b></div>
            <div><span>当前武器</span><b>@(wi == null ? "徒手" : $"{weapon.Name}#{wi.InstanceId}")（战前可在随身武器卡下调整）</b></div>
            <div><span>你的命中率</span><b>@Ui.Pct(GameEngine.HitChance(weapon.AccuracyRating + e.SkillAccuracyBonus(e.SkillLevel(s, weapon.SkillId)), ec.Dodge))（命中能力@(Ui.T(weapon.AccuracyRating + e.SkillAccuracyBonus(e.SkillLevel(s, weapon.SkillId))))）</b></div>
        </div>
        @if (wi != null && weapon.UsesMagazine && wi.LoadedAmmo <= 0)
        {
            @* 试玩修复 D3：弹仓为0时提前提示，开战后第一件事是装填 *@
            <div class="risk">@($"{weapon.Name}#{wi.InstanceId}")弹仓为0：开战后需先装填（1AP），或在随身武器卡下换一把再接近。</div>
        }
        @if (ec.IsZombie) { <div class="risk">咬击命中且造成伤害时可能感染僵尸病毒（当前一次@(Ui.Pct(e.ExposureChance(s.Body.Immunity)))）。</div> }
        <ul class="notes">
            <li>主动接近：@e.FearNote(s, new[] { w }, GameEngine.FearApproach)；不受随机接敌保护期限制；只与这一只交战。</li>
            <li>每轮推进5分钟世界时间；撤退成功留在原地，存活敌人保留血量。</li>
        </ul>
        @if (G.Notice != null) { <div class="notice">@G.Notice</div> }
    </div>
    <div class="detail-foot">
        @* S14 §14.1：右栏只作可选详细阅读，接近的确认在敌踪卡旁（R05 §7），不在这里重复执行按钮 *@
        <div class="under">@(why != null ? why : "点敌踪卡上的“接近”，在卡旁确认“接近并开战”")；Esc 不能关掉战斗</div>
    </div>
}
