@inherits GameComponent

@* 敌踪详情（B41e1）：右栏只作详情阅读，处理按钮都在点卡打开的居中操作盘里。 *@
@{
    var s = G.S;
    var e = G.E;
    // B41e1：按卡键读当前地点、当前区域的可操作卡（B42：悬停查看传入悬停的敌踪）
    var card = e.EnemyCardHere(s, (Sel ?? G.Selected).Id);
}
@* B41e1 敌踪详情（逐字稿「右栏原「接敌还是绕行？」标题」→「敌踪详情」；Q446 ④：删旧「不受随机接敌保护期限制」，保留真实受惊预览，单卡／固定名单按真实卡写参战范围，
   组卡不写「只与这一只交战」；脚注与固定关键敌人补句复用逐字稿原句）。组卡、固定战按锁定名单原顺序逐个成员列原详情行。 *@
@if (card == null)
{
    <div class="empty-detail">这个敌人已经离开。<br />选择地点、路线、资源或物品查看信息</div>
}
else
{
    var members = e.EnemyCardPreviewMembers(s, card);
    var why = e.CanApproachCard(s, card.Key);
    var weapon = e.CurrentWeapon(s, out var wi);
    var page = e.DefaultWeaponPage(s);
    var pageName = EquipSlots.Name(EquipSlots.WeaponSlotOfPage(page)!);
    var otherName = EquipSlots.Name(EquipSlots.WeaponSlotOfPage(page == 1 ? 2 : 1)!);
    var range = card.Kind is "single" or "elite" ? "只与这一只交战" : card.Kind == "fixed" ? "全名单一起入场（从1号位起）" : null;
    var anyBite = members.Any(m => e.CanBite(e.Enemy(m.EnemyId)));
    // BM5b1（R05 Q613）：整卡对当前实际队伍的即时交战风险（派生值，按事实版本缓存）
    var risk = G.EngageRisk(card);
    @* BM4b（S14 Q589「敌踪」）：首屏＝卡名／状态（警觉、撤退保护）、当前查看成员（锁定名单第一位）的健康与攻防速核心值、开战武器与感染等风险；
       组卡其余成员的完整原详情行在「成员（{数量}）」组，接近／撤退等长说明在「说明」组。中央盘的逐成员预览不在本批改动。 *@
    <div class="detail-scroll rail-page" data-rail-type="@RailTypes.Enemy">
        <RailHead Source="@($"{GameEngine.EnemyCardDetailTitle} · {e.LocName(card.LocationId)}")">
            <Thumb>@Icons.Markup("enemy_" + card.EnemyIds[0])</Thumb>
            <Name>@card.Title</Name>
            <Sub>
                <div class="rail-src">@card.Badge · @GameEngine.VigilanceText(card.Vigilance)</div>
                @* R05 Q613 首屏顺序：身份 → 交战风险 → 真实状态／倒计时／原因 → 「战斗详情」折叠；只显示等级与通用提示，不展示后台分值。没有有效敌方活成员时不留旧等级 *@
                @if (risk.Invalid) { <div class="risk" data-engage-risk="invalid">@GameEngine.EnemyCardInvalidText</div> }
                else
                {
                    <div class="rail-risk" data-engage-risk="@(risk.Unknown ? "unknown" : risk.Level.ToString())">@risk.Text</div>
                    <div class="rail-risk-note">@GameEngine.EngageRiskNote</div>
                }
                @* Q589「敌踪」首屏：当前状态／倒计时或撤退保护，与卡面同源（CardApproachStatus） *@
                @if (e.CardApproachStatus(s, card) is string approach) { <div class="rail-status" data-approach>@approach</div> }
            </Sub>
        </RailHead>
        @* 1280×720 窄栏（约200px）里先放当前风险与原因，再放当前查看成员的核心值；成员类别长行与开战武器长句排在其后（仍在主区，不进折叠组） *@
        @if (e.CardGuardNote(s, card) is string guard) { <div class="risk none ecard-guard">@guard</div> }
        @if (wi != null && weapon.UsesMagazine && wi.LoadedAmmo <= 0)
        {
            <div class="risk">@($"{weapon.Name}")弹仓为0：开战后需先装填（1AP），或在右栏人物“装备”区换一把再接近。</div>
        }
        @if (anyBite) { <div class="risk">咬击命中并造成伤害时可能感染。单次咬伤感染概率@(Ui.Pct(e.ExposureChance(s.Body.Immunity)))。</div> }
        @if (members.Count > 0 && !e.CanBite(e.Enemy(members[0].EnemyId)) && e.Enemy(members[0].EnemyId).IsZombie) { <div class="risk none">它的意图里没有咬击，不会咬伤，攻击不传播病毒。</div> }
        @if (why != null) { <div class="risk">@why</div> }
        @if (G.RightNotice != null) { <div class="notice">@G.RightNotice</div> }
        <div class="lines rail-main">
            @if (members.Count > 0) { @MemberKind(members[0]) }
            <div class="wide"><span>开战武器</span><b>@(wi == null ? $"{pageName}空（拳）" : $"{pageName} {weapon.Name}")（战前可在右栏人物“装备”区调整，战斗中可切到@(otherName)页）</b></div>
        </div>

        @* R05 Q613：健康、护甲／闪避／速度、攻击能力、伤害与我方命中预估归「战斗详情」，默认收起（展开偏好沿 Q589 按对象类型保存）。
           成员类别行、开战武器、感染与弹仓风险、「成员」「说明」组的去处待 Q639，本批原位不动 *@
        @if (members.Count > 0)
        {
            <RailFold Type="@RailTypes.Enemy" Group="@RailGroups.BattleDetail" Name="@RailText.BattleDetail">
                @MemberLines(members[0], false)
            </RailFold>
        }
        @if (members.Count > 1)
        {
            <RailFold Type="@RailTypes.Enemy" Group="@RailGroups.Members" Name="@RailText.Members" Count="@members.Count">
                @foreach (var m in members.Skip(1))
                {
                    @MemberLines(m)
                    @if (!e.CanBite(e.Enemy(m.EnemyId)) && e.Enemy(m.EnemyId).IsZombie) { <div class="risk none">它的意图里没有咬击，不会咬伤，攻击不传播病毒。</div> }
                }
            </RailFold>
        }
        <RailFold Type="@RailTypes.Enemy" Group="@RailGroups.Desc" Name="@RailText.Desc">
            <ul class="notes">
                <li>@GameEngine.ApproachCardButton：@e.EnemyCardFearNote(s, card, false)@(range != null ? "；" + range : "")。</li>
                <li>每回合推进5分钟世界时间；@e.RetreatOutlookHere(s)。</li>
                @if (card.KeyEnemy) { <li>@GameEngine.KeyEnemyDetailNote</li> }
                @* B41e2（Q551）：可选强敌的特殊掉落说明，与卡悬停同源 *@
                @if (e.EliteDropNote(card) is string drop) { <li class="ecard-drop">@drop</li> }
            </ul>
        </RailFold>
    </div>
    <div class="detail-foot">
        <div class="under">@GameEngine.EnemyCardFootnote</div>
    </div>
}

@code {
    /// <summary>B42：要显示的敌踪（悬停查看时传入）；null 为真正选中的 G.Selected。</summary>
    [Parameter] public Selection? Sel { get; set; }

    /// <summary>一名成员的原详情行（锁定名单原顺序）。</summary>
    /// <param name="withKind">false：首屏当前查看成员，类别长行由 <see cref="MemberKind"/> 排在风险之后。</param>
    private RenderFragment MemberLines((string EnemyId, WorldEnemy? Enemy) m, bool withKind = true) => __builder =>
    {
        var s = G.S;
        var e = G.E;
        var ec = e.Enemy(m.EnemyId);
        var hit = e.OutOfBattleHit(s, ec);
        <div class="lines rail-main enemy-lines">
            @if (withKind) { @MemberKind(m) }
            <div><span>健康</span><b>@Ui.N(m.Enemy?.Hp ?? ec.Hp)/@Ui.N(ec.Hp)</b></div>
            <div><span>护甲 / 闪避 / 速度</span><b>@Ui.T(ec.Armor) / @Ui.T(ec.Dodge) / @Ui.Speed(ec.Speed)</b></div>
            <div><span>攻击能力 / 对你命中率</span><b>@Ui.T(ec.AttackRating) / @Ui.Pct(GameEngine.HitChance(ec.AttackRating, e.Config.Scope.BasePlayerDodge))</b></div>
            <div><span>伤害</span><b>@Ui.N(ec.DamageMin)—@Ui.N(ec.DamageMax)</b></div>
            @* R05 Q613：没有合适攻击者／目标时写「当前无可用攻击」，不造 0% 占位 *@
            @if (e.OutOfBattleHasAttack(s))
            {
                <div title="开战默认页普通攻击：(武器命中+3×熟练等级+8+装备命中)×疲劳；恐慌、失衡开战后才计"><span>你的命中率</span><b>@Ui.Pct(hit.HitChance)（命中能力@(Ui.N(hit.Accuracy))）</b></div>
            }
            else { <div><span>你的命中率</span><b>@GameEngine.NoAttackHitText</b></div> }
        </div>
    };

    /// <summary>成员类别行：名称、族类、稀有层级、AP、站位、控制抗性（原句不改）。</summary>
    private RenderFragment MemberKind((string EnemyId, WorldEnemy? Enemy) m) => __builder =>
    {
        var ec = G.E.Enemy(m.EnemyId);
        <div class="wide"><span>@ec.Name</span><b>@ec.FamilyName@(ec.Elite ? "精英" : "")@(m.Enemy == null || m.Enemy.Hostile ? "" : " · 中立（被攻击才转敌对）") · 稀有层级@(ec.Rarity switch { "common" => "普通", "rare" => "稀有", _ => "强敌" }) · @(ec.Ap)AP · 己位@(ec.OwnSlots)→目标@(ec.TargetSlots) · 控制抗性@(Ui.T(ec.ControlResist))%</b></div>
    };
}
