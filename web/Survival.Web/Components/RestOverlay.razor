@inherits GameComponent

@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    var here = s.CurrentLocation;
    var sheltered = e.IsSheltered(s, here);
    var fac = s.Locations[here].Facility;
    var lowMorale = cfg.Thresholds["morale"].IsBelow(s.Stats.Morale);
    var req = kind switch
    {
        "sleep" => ActionRequest.Sleep(minutes),
        "wait" => ActionRequest.Wait(minutes),
        _ => ActionRequest.Rest(minutes),
    };
}

<div class="overlay" role="dialog" aria-label="休息与睡眠">
    <div class="overlay-head">
        <div><h2 style="display:inline">休息与睡眠</h2><span class="sub">@e.LocName(here) · @(sheltered ? "遮蔽" : "露天")@(fac.BedBuilt ? " · 有床垫" : "")</span></div>
        <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
    </div>
    <div class="overlay-body rest-body">
        <div class="panel" style="padding:16px;display:flex;flex-direction:column;gap:16px;overflow-y:auto">
            <div>
                <h3 style="margin:0 0 8px;font-weight:500">休息 <small class="muted">只恢复体力，不恢复清醒度</small></h3>
                <div class="choice-group">
                    @foreach (var m in cfg.Actions.RestMinutes)
                    {
                        var mm = m;
                        <button class="choice @(kind == "rest" && minutes == m ? "on" : "")" @onclick='() => Pick("rest", mm)'>
                            <b>@Clock.Duration(m)</b><span class="tiny muted">体力每小时+@(lowMorale ? "10（精神低减半）" : "20")</span>
                        </button>
                    }
                </div>
            </div>
            <div>
                <h3 style="margin:0 0 8px;font-weight:500">睡眠 <small class="muted">恢复清醒度与体力；任何时间都可以睡</small></h3>
                <div class="choice-group">
                    @foreach (var m in cfg.Actions.SleepMinutes)
                    {
                        var mm = m;
                        <button class="choice @(kind == "sleep" && minutes == m ? "on" : "")" @onclick='() => Pick("sleep", mm)'>
                            <b>@Clock.Duration(m)</b><span class="tiny muted">@(sheltered ? "遮蔽：清醒+12/小时" : "露天：清醒+6/小时")</span>
                        </button>
                    }
                </div>
            </div>
            <div>
                <h3 style="margin:0 0 8px;font-weight:500">等待 <small class="muted">不恢复，只让时间过去（例如等天亮）</small></h3>
                <div class="choice-group">
                    @foreach (var m in cfg.Actions.WaitMinutes)
                    {
                        var mm = m;
                        <button class="choice @(kind == "wait" && minutes == m ? "on" : "")" @onclick='() => Pick("wait", mm)'>
                            <b>@Clock.Duration(m)</b><span class="tiny muted">按等待消耗</span>
                        </button>
                    }
                </div>
            </div>
            <div class="lines" style="max-width:560px">
                <div><span>当前条件</span><b>@(sheltered ? "遮蔽" : "露天")@(fac.BedBuilt && sheltered ? "，床垫：睡眠体力+5/小时" : "")</b></div>
                <div><span>精神</span><b class="@(lowMorale ? "warn-text" : "")">@Ui.Floor(s.Stats.Morale)@(lowMorale ? "（低于20，体力恢复减半）" : "")</b></div>
                <div><span>健康自然恢复</span><b>@(sheltered ? "遮蔽中，饱食与水分≥40且精神≥20时每小时+1" : "露天不恢复")</b></div>
            </div>
            <div class="tiny muted">休息与睡眠期间仍消耗饱食、水分与火堆燃料，不会因为满值自动结束；越过低值阈值时会暂停，可补给后继续。</div>
        </div>
        <div class="panel detail">
            <PreviewView Request="req" Eyebrow="@(kind == "sleep" ? "睡眠" : kind == "wait" ? "等待" : "休息")" Title="" Subtitle="" OnStarted="Close" />
        </div>
    </div>
</div>

@code {
    private string kind = "rest";
    private int minutes = 60;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        var st = G.S.Stats;
        if (st.Wakefulness < 50 || !G.E.IsDaylight(G.S.GameMinute))
        {
            kind = "sleep";
            minutes = 480;
        }
    }

    private void Pick(string k, int m)
    {
        kind = k;
        minutes = m;
    }

    private Task Close()
    {
        G.Panel = null;
        G.Notify();
        return Task.CompletedTask;
    }
}
