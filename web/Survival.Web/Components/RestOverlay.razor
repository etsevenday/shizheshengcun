@inherits GameComponent

@* 休息与睡眠。Part="center"：中部两行小时档、休息条件／风险与开始条（RestPlan，就近执行，S14 §14.1）；Part="detail"：右栏的详细预估（只读）。
   B36a（02 Q815、Q887 B、Q896 A、Q897 A）：右栏显示悬停／聚焦中的那一档，否则显示已选那一档；都没有时右栏回常规内容（DetailPanel 不进本组件，D3＝02 Q1125 A）。
   本页右栏的计划时长用小时（预计耗时），结束时刻仍 HH:mm。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.Ground;
    var sheltered = e.IsSheltered(s, here);
    var tarpOnly = e.SleepSheltered(s, here) && !sheltered;
    var fac = e.FacOf(s, here) ?? s.Locations[s.CurrentLocation].Facility;
    var shown = G.RestShown;
}

@if (Part == "center")
{
    <div class="sub-panel rest-panel" data-enter-scope tabindex="-1" role="dialog" aria-label="休息与睡眠">
        <div class="sub-head">
            <div><h2>休息与睡眠</h2><span class="sub">@e.ZoneName(s, here) · @(sheltered ? "遮蔽" : tarpOnly ? "露天（野营布：睡眠算遮蔽）" : "露天")@(fac.BedBuilt ? " · 有床垫" : "") · 选时长后在下方开始，详细预估在右侧</span></div>
            <button class="secondary" data-pt="rest-close" @onclick="Close">@G.PanelCloseLabel<EscCap On="@(G.EscOwner == EscOwner.Panel)" /></button>
        </div>
        <RestPlan />
    </div>
}
else if (shown is var (kind, minutes))
{
    <PreviewView Request="RestPlan.RestRequest(kind, minutes)" Eyebrow="@($"休息与睡眠 · {RestPlan.KindName(kind)}")" Title="" Subtitle=""
                 Confirmable="false" DurationText="RestPlan.Hours" FootNote="在中间所选时长下方点开始；时间为预计值" />
}

@code {
    [Parameter] public string Part { get; set; } = "center";

    private void Close() => G.OpenPanel(null);
}
