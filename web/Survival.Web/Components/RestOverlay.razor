@inherits GameComponent

@* 休息与睡眠。Part="center"：中部的时长选择、条件说明与开始按钮（就近执行，S14 §14.1）；Part="detail"：右栏的详细预估（只读）。 *@
@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    var here = s.CurrentLocation;
    var sheltered = e.IsSheltered(s, here);
    var fac = s.Locations[here].Facility;
    var lowMorale = cfg.Thresholds["morale"].IsBelow(s.Stats.Morale);
    var kind = G.RestKind;
    var restE = cfg.HourlyRates["rest"].Energy;
    var sleepR = cfg.HourlyRates[sheltered ? "sleep_sheltered" : "sleep_exposed"];
    var minutes = G.RestMinutes;
    var req = kind switch
    {
        "sleep" => ActionRequest.Sleep(minutes),
        "wait" => ActionRequest.Wait(minutes),
        _ => ActionRequest.Rest(minutes),
    };
}

@if (Part == "center")
{
    <div class="sub-panel" role="dialog" aria-label="休息与睡眠">
        <div class="sub-head">
            <div><h2>休息与睡眠</h2><span class="sub">@e.LocName(here) · @(sheltered ? "遮蔽" : "露天")@(fac.BedBuilt ? " · 有床垫" : "") · 选时长后在下方开始，详细预估在右侧</span></div>
            <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
        </div>
        <div class="sub-body rest-scroll">
            <div>
                <h3 class="choice-title">休息 <small class="muted">只恢复体力，不恢复清醒度</small></h3>
                <div class="choice-group">
                    @foreach (var m in cfg.Actions.RestMinutes)
                    {
                        var mm = m;
                        <button class="choice @(kind == "rest" && minutes == m ? "on" : "")" @onclick='() => Pick("rest", mm)'>
                            <b>@Clock.Duration(m)</b><span class="tiny muted">体力每小时@(Ui.SignedT(restE * (lowMorale ? cfg.FacilityEffects.LowMoraleEnergyRecoveryFactor : 1)))@(lowMorale ? "（精神低减半）" : "")</span>
                        </button>
                    }
                </div>
            </div>
            <div>
                <h3 class="choice-title">睡眠 <small class="muted">恢复清醒度与体力；任何时间都可以睡</small></h3>
                <div class="choice-group">
                    @foreach (var m in cfg.Actions.SleepMinutes)
                    {
                        var mm = m;
                        <button class="choice @(kind == "sleep" && minutes == m ? "on" : "")" @onclick='() => Pick("sleep", mm)'>
                            <b>@Clock.Duration(m)</b><span class="tiny muted">@(sheltered ? "遮蔽" : "露天")：清醒@(Ui.SignedT(sleepR.Wakefulness))/小时</span>
                        </button>
                    }
                </div>
            </div>
            <div>
                <h3 class="choice-title">等待 <small class="muted">不恢复，只让时间过去（例如等天亮）</small></h3>
                <div class="choice-group">
                    @foreach (var m in cfg.Actions.WaitMinutes)
                    {
                        var mm = m;
                        <button class="choice @(kind == "wait" && minutes == m ? "on" : "")" @onclick='() => Pick("wait", mm)'>
                            <b>@Clock.Duration(m)</b><span class="tiny muted">按等待消耗</span>
                        </button>
                    }
                </div>
            </div>
            @* Q21（S14 §19）：恢复条件等教学短文移进悬浮说明，一级只留当前条件与实际风险（精神偏低减半） *@
            <div class="lines" style="max-width:560px"
                 title="@($"健康自然恢复：{(sheltered ? $"饱食与水分≥{Ui.T(cfg.HealthRules.RecoveryMinSatiety)}且精神≥{Ui.T(cfg.HealthRules.RecoveryMinMorale)}时每小时{Ui.SignedT(cfg.HealthRules.ShelteredRestRecoveryPerHour)}" : "露天不恢复")}。期间仍消耗饱食、水分与火堆燃料，不会因满值自动结束；越过低值阈值时会暂停，可补给后继续。完整规则见系统说明。")">
                <div><span>当前条件</span><b>@(sheltered ? "遮蔽" : "露天")@(fac.BedBuilt && sheltered ? $"，床垫：睡眠体力{Ui.SignedT(cfg.FacilityEffects.BedExtraSleepEnergyPerHour)}/小时" : "")</b></div>
                @if (lowMorale)
                {
                    <div><span>精神</span><b class="warn-text">@Ui.N(s.Stats.Morale)（低于@(Ui.T(cfg.Thresholds["morale"].Value))，体力恢复减半）</b></div>
                }
            </div>
        </div>
        @* 就近执行（S14 §14.1）：开始按钮紧挨所选时长卡，右栏只作可选详细预测；仍是一次确认 *@
        @{
            var p = G.Preview(req);
            var busy = G.Running || s.Main != null && !p.AsSubAction || _starting;
        }
        <div class="rest-go">
            <span class="rg-pick">
                <b>@(kind == "sleep" ? "睡眠" : kind == "wait" ? "等待" : "休息") · @Clock.Duration(minutes)</b>
                <small class="@(p.Ok ? "" : "warn-text")">@(p.Ok ? $"预计{Clock.HHmm(p.EstimatedEndMinute)}结束{(p.Warnings.Count > 0 ? " · " + p.Warnings[0] : "")}" : p.Reason)</small>
            </span>
            <button type="button" class="primary rg-start" disabled="@(!p.Ok || busy)" @onclick="Start">@(p.Ok ? p.ConfirmText : "无法开始")</button>
        </div>
    </div>
}
else
{
    <PreviewView Request="req" Eyebrow="@(kind == "sleep" ? "休息与睡眠 · 睡眠" : kind == "wait" ? "休息与睡眠 · 等待" : "休息与睡眠 · 休息")" Title="" Subtitle=""
                 Confirmable="false" FootNote="在中间所选时长下方点开始；时间为预计值" />
}

@code {
    [Parameter] public string Part { get; set; } = "center";

    private void Pick(string k, int m)
    {
        G.RestKind = k;
        G.RestMinutes = m;
        G.Notify();
    }

    private void Close() => G.OpenPanel(null);

    private bool _starting;

    /// <summary>开始所选休息/睡眠/等待（内核再校验）；开始成功后收起面板，让中央推进条与地块栏可见。执行中锁住按钮，重复点击不重复开始。</summary>
    private async Task Start()
    {
        if (_starting) return;
        _starting = true;
        try
        {
            var t = G.StartAction(G.RestKind switch
            {
                "sleep" => ActionRequest.Sleep(G.RestMinutes),
                "wait" => ActionRequest.Wait(G.RestMinutes),
                _ => ActionRequest.Rest(G.RestMinutes),
            });
            if (G.S.Main != null && G.Panel == "rest") G.OpenPanel(null);
            await t;
        }
        finally { _starting = false; }
    }
}
