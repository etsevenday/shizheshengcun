@inherits GameComponent
@inject IJSRuntime JS

@* 地块栏两行（基础UI布局与操作修订案 v0.7 第 2 节）：
   第一行 .map-row：当前地图大图卡固定在最左（不在横滚容器里，浏览相邻地图时探索/清理不滚出视野），相邻地图子栏 .map-adjacent 独立横滚；
   第二行 .facility-row：设施（火堆 → 遮蔽棚 → 床垫）→ 分组标题“采集资源” → 已发现资源卡，独立横滚、顶端对齐，按内容高度排。
   两行不混排；地块区整块的场景底图与暗层已移除，场景图只作当前地图卡的大图。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var lc = e.Location(here);
    var sel = G.Selected;
    var resources = e.Config.Resources.Where(r => r.LocationId == here && s.Resources[r.NodeId].Discovered).ToList();
    var entrances = e.AdjacentUnlocked(s).Select(x => x.Other(here)).ToList();
    var busy = e.IsBusy(s) || G.Running;
    var hasFacilities = lc.HasFire || lc.CanBuildShelter;
    var enemies = e.VisibleEnemiesAt(s, here);
}

@* 四区同屏（S14 §1.3）：两行高度按中部可用高度分配，不再固定 180/220 或 220—300 起始高度；行首竖排区标题常驻可见 *@
<div class="panel map-row" aria-label="@($"地图与场景 · {lc.Name}")">
    <div class="row-tag" aria-hidden="true">地图与场景</div>
    <LocationCard LocationId="@here" Current="true" />
    <div class="map-adjacent" data-wheel="x" aria-label="相邻地图">
        @foreach (var to in entrances)
        {
            <LocationCard @key="to" LocationId="@to" />
        }
        @if (entrances.Count == 0)
        {
            <div class="desk-hint">还没有发现通往别处的路线，探索周边可能找到线索</div>
        }
    </div>
</div>

<div class="panel facility-row" aria-label="设施与可交互对象">
    <div class="row-tag" aria-hidden="true">设施与资源</div>
    <div class="fac-scroll" data-wheel="x">
        @if (hasFacilities)
        {
            <div class="desk-group facilities">
                <div class="dg-title">设施</div>
                <div class="dg-cards">
                    @if (lc.HasFire) { <FireCard /> }
                    @if (lc.CanBuildShelter)
                    {
                        <FacilityCard Kind="shelter" />
                        <FacilityCard Kind="bed" />
                    }
                </div>
            </div>
        }
        @if (enemies.Count > 0)
        {
            @* v0.6 §15：当前地块的可见世界敌人，放在设施行“敌踪”分组（开发计划 v0.5 假设 11）；点卡选中看详情，“接近”在卡旁确认（R05 §7） *@
            <div class="desk-group enemies">
                <div class="dg-title">敌踪</div>
                <div class="dg-cards">
                    @foreach (var w in enemies)
                    {
                        var ec = e.Enemy(w.EnemyId);
                        var wid = w.Id;
                        var open = G.Pop?.Kind == "approach" && G.Pop.Id == wid.ToString();
                        <ObjectCard @key="@("we" + wid)" Id="@($"en-{wid}")" CssClass="enemy-card world" Title="@ec.Name" Badge="@(w.Hostile ? "敌对" : "中立")" BadgeClass="@(w.Hostile ? "new" : "")"
                                    Selected="@(sel.Kind == SelectionKind.Enemy && sel.InstanceId == wid)" Fresh="@G.Highlights.Contains($"enemy:{wid}")"
                                    Tooltip="敌人：点击查看详情；点“接近”在卡旁预览并确认开战" OnClick="() => SelectEnemy(wid)">
                            <Art>@Icons.Markup("enemy_" + ec.Id)</Art>
                            <ChildContent>
                                <div class="hp-line"><span>健康</span><b>@Ui.N(w.Hp)/@Ui.N(ec.Hp)</b></div>
                                <div class="track"><i style="width:@Ui.Bar(w.Hp, ec.Hp)%"></i></div>
                                <div class="oc-line">伤害@(Ui.N(ec.DamageMin))—@(Ui.N(ec.DamageMax)) · 速度@(Ui.T(ec.Speed))</div>
                            </ChildContent>
                            <Footer>
                                @* R05 §7、S14 §14.2：点“接近”只在卡旁打开对象/风险预览，点浮窗里的“接近并开战”才接敌 *@
                                <button type="button" class="loc-btn res-btn @(open ? "on" : "")" disabled="@(busy)" aria-expanded="@open" title="@(busy ? "行动进行中" : "在卡旁预览风险并确认接近")"
                                        @onclick="() => OpenApproach(wid)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <strong>接近 ▸</strong>
                                </button>
                            </Footer>
                        </ObjectCard>
                    }
                </div>
            </div>
        }
        <div class="desk-group resources">
            <div class="dg-title">采集资源</div>
            <div class="dg-cards">
                @foreach (var r in resources)
                {
                    var rs = s.Resources[r.NodeId];
                    var empty = !r.IsUnlimited && (rs.Available ?? 0) <= 0;
                    var nodeId = r.NodeId;
                    var tool = r.ToolBonus != null ? e.BestTool(s, r.ToolBonus.ToolTag) : null;
                    var minutes = tool != null && r.ToolBonus?.BaseMinutesOverride != null ? r.ToolBonus.BaseMinutesOverride.Value : r.BaseMinutes;
                    var req = ActionRequest.Gather(r.NodeId);
                    var why = busy ? (s.Main?.Status == ActionStatus.Paused ? "行动暂停中" : "行动进行中") : e.CanStart(s, req);
                    var stock = r.IsCache ? (empty ? "已搜空" : "可搜1次") : r.IsUnlimited ? "不限量" : $"{rs.Available}/{r.Cap}";
                    <ObjectCard @key="r.NodeId" Id="@($"res-{nodeId}")" CssClass="res-card" Title="@r.Name" Badge="@stock" BadgeClass="@(empty ? "unbuilt" : "")" Dim="empty"
                                Selected="@(sel.Kind == SelectionKind.Resource && sel.Id == r.NodeId)" Fresh="@G.Highlights.Contains(r.NodeId)"
                                DataDrop="@($"res:{nodeId}")" Tooltip="资源点：点击查看采集预估；把对应工具拖到这里指定使用" OnClick="() => SelectResource(nodeId)">
                        <Art>@Icons.Markup(Icons.ForResource(r.NodeId, r.Outputs))</Art>
                        <ChildContent>
                            @if (r.IsCache)
                            {
                                <div class="oc-line">@string.Join("、", r.Outputs.Select(o => $"{e.ItemName(o.Key)}{o.Value}")) · @(minutes)分</div>
                            }
                            else
                            {
                                var per = r.Outputs.Values.First() * (tool != null && r.ToolBonus != null && !r.IsUnlimited ? r.ToolBonus.OutputMultiplier : 1);
                                <div class="oc-line">每次@(per)@(e.ItemName(r.Outputs.Keys.First())) · @(minutes)分@(r.Refills ? $" · 日补{r.DailyRefill}" : "")</div>
                            }
                            @if (r.Hazard != null) { <div class="oc-line warn-line">@Ui.Pct(r.Hazard.Probability)@r.Hazard.Label · 健康−@Ui.T(r.Hazard.HealthLoss)</div> }
                            @* Q28：按钮缩成“动词 + 时长”让出约70%图片区，不能开始的实际原因改写在卡面状态角标里，不隐藏 *@
                            @if (why != null) { <div class="oc-line warn-line res-why">@why</div> }
                        </ChildContent>
                        <Footer>
                            @* 试玩修复 B5：与探索/清理同一按钮形态，悬停或聚焦即在右栏预测，离开恢复 *@
                            @{ var verb = r.IsCache ? "搜集" : "采集"; var title = $"{verb}{r.Name}"; }
                            <button type="button" class="loc-btn res-btn" disabled="@(why != null)" title="@(why ?? "单击直接开始；右侧显示预测")"
                                    @onmouseenter="() => G.Hover(req, title)" @onfocus="() => G.Hover(req, title)" @onmouseleave="() => G.Hover(null)" @onblur="() => G.Hover(null)"
                                    @onclick="() => Quick(req, nodeId)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <strong>@verb</strong>
                                <small>@(minutes)分钟</small>
                            </button>
                        </Footer>
                    </ObjectCard>
                }
                @if (resources.Count == 0)
                {
                    <div class="desk-hint">@(s.Locations[here].Progress < 100 ? "这里还没有发现资源点，探索周边可能找到线索" : "这里没有可采集的资源")</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private void SelectResource(string id) => G.Select(new Selection { Kind = SelectionKind.Resource, Id = id });

    private void SelectEnemy(int worldId) => G.Select(new Selection { Kind = SelectionKind.Enemy, Id = worldId.ToString(), InstanceId = worldId });

    private void OpenApproach(int worldId)
    {
        SelectEnemy(worldId);
        G.OpenPop("approach", worldId.ToString(), $"en-{worldId}");
    }

    /// <summary>资源卡底部按钮：选中并直接开始（留言 649cdad9）。</summary>
    private async Task Quick(ActionRequest r, string nodeId)
    {
        G.Hover(null);
        SelectResource(nodeId);
        await G.StartAction(r);
    }

    private string _lastLocation = "";

    /// <summary>到达新地点后两行横滚容器都回到最左（试玩修复 B10，v0.7 起是相邻地图子栏与第二行两个容器）。</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (G.State == null) return;
        var here = G.S.CurrentLocation;
        if (here == _lastLocation) return;
        _lastLocation = here;
        try { await JS.InvokeVoidAsync("survival.resetDesk"); }
        catch (JSException) { /* 旧缓存的 app.js 没有这个函数时只是不复位，不影响游戏 */ }
    }
}
