@inherits GameComponent
@inject IJSRuntime JS

@* 地块栏两行（基础UI布局与操作修订案 v0.7 第 2 节）：
   第一行 .map-row：当前地图大图卡固定在最左（不在横滚容器里，浏览相邻地图时探索/清理不滚出视野），相邻地图子栏 .map-adjacent 独立横滚；
   第二行 .facility-row：设施（火堆 → 遮蔽棚 → 床垫）→ 分组标题“采集资源” → 已发现资源卡，独立横滚、顶端对齐，按内容高度排。
   两行不混排；地块区整块的场景底图与暗层已移除，场景图只作当前地图卡的大图。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var lc = e.Location(here);
    var sel = G.Selected;
    var resources = e.Config.Resources.Where(r => r.LocationId == here && s.Resources[r.NodeId].Discovered).ToList();
    var entrances = e.AdjacentUnlocked(s).Select(x => x.Other(here)).ToList();
    // B11（S03、EXP30-01）：已揭示但门槛未满足的路线显示为“未开通”卡并写明原因，不能前往
    var locked = e.AdjacentLocked(s);
    var busy = e.IsBusy(s) || G.Running;
    // B14b（Q141）：营区工坊、试制工坊、营区广场、医务室的公共工坊站卡与火堆/棚/床同在“设施”组
    var publicStations = e.PublicStationsHere(s);
    // B17（S09 X2）：当前所在区（外部区 / 安全屋屋内）的设施；屋内不显示外部的棚/床/公共站/资源/敌踪
    var inside = s.CurrentZone == GameState.SafehouseZone;
    var place = s.Ground;
    var zfac = e.FacOf(s, place) ?? s.Locations[here].Facility;
    var showSafehouse = e.SafehousePermissionBlocked(here) == null || e.SafehouseBuilt(s, here);
    var tarp = !inside && zfac.TarpInstanceId is int tarpId ? e.FindItem(s, tarpId) : null;
    var hasFacilities = e.HasFireAt(s, place) || (!inside && lc.CanBuildShelter) || (!inside && publicStations.Count > 0) || showSafehouse || tarp != null || e.DryingRackHere(s);
    // B41e1：单卡、随机组卡、固定战、可选强敌并成一个「敌踪」分组，读内核 EnemyCardsHere（B41e3 删旧三组）
    var cards = !inside ? e.EnemyCardsHere(s) : new List<EnemyCardView>();
    if (inside) resources = new List<ResourceConfig>();
    // B21（R03 D5、A10 §7）：本次远征的安全点（safeNodes）给“终止本次远征”明显入口
    // 试玩修复 M399：撤出中不显示（按钮本就不可用，且会被中央撤出进度条盖住）
    var expHere = s.Expedition != null && !s.Expedition.IsExtracting && !inside && e.DungeonAt(here) == s.Expedition.DungeonId
                  && e.DungeonCfg(s.Expedition.DungeonId)!.SafeNodes.Contains(here) ? s.Expedition : null;
    // B22（R03 D7.1）：本次远征地牢里任何房间都能整理封存战利品；父地点给“地牢重置”与回收箱入口（R03 D8、A10 §7）
    var sealHere = s.Expedition != null && !inside && e.DungeonAt(here) == s.Expedition.DungeonId ? s.Expedition : null;
    var sealableN = sealHere != null ? e.SealableItems(s).Count : 0;
    var sealedN = sealHere != null ? e.SealedItems(s, sealHere.InstanceId).Sum(i => i.Count) : 0;
    var parentOf = e.Config.Map.Dungeons.Where(d => !inside && d.Parent == here && s.DungeonInstances.ContainsKey(d.Id)).ToList();
}

@* 四区同屏（S14 §1.3）：两行高度按中部可用高度分配，不再固定 180/220 或 220—300 起始高度；行首竖排区标题常驻可见 *@
<div class="panel map-row" aria-label="@($"地图与场景 · {lc.Name}")">
    <div class="row-tag" aria-hidden="true">地图与场景</div>
    <LocationCard LocationId="@here" Current="true" />
    <div class="map-adjacent" data-wheel="x" aria-label="相邻地图">
        @foreach (var to in entrances)
        {
            <LocationCard @key="to" LocationId="@to" />
        }
        @{
            // B12（B11 遗留）：有同一原因 ≥3 条的未开通路线时，全部未开通路线收成一张“N 条路线未开通”叠卡（原因各写一次），
            // 点开在卡旁按原因逐条列名称/方位/分钟；营区广场 10 条未开通不再长横滚。否则仍一条一张卡。
            var lockGroups = e.AdjacentLockedGroups(s);
            var stackAll = lockGroups.Any(g => g.Routes.Count >= 3);
        }
        @if (stackAll)
        {
            var all = lockGroups.SelectMany(g => g.Routes).ToList();
            var names = string.Join("、", all.Select(x => e.LocName(x.Target)));
            var why = lockGroups.Count == 1 ? lockGroups[0].Reason : $"需要的条件有{lockGroups.Count}种，点开按条件逐条查看";
            var open = G.Pop?.Kind == "lockstack";
            @* B32a：叠卡同用重墨 V2 模板，副标路线名、第二行原因；未开通为不可用 *@
            <ObjectCard Ink2="true" @key="@("lockstack")" Id="lockstack" CssClass="k2-route locked lock-stack" Title="@($"{all.Count}条路线未开通")" Badge="未开通" BadgeClass="unbuilt" Dim="true" Dashed="true"
                        AriaLabel="@($"{all.Count}条路线未开通：{names}；{why}")" Tooltip="@($"{names}；{why}")" OnClick="OpenStack">
                <Art><span class="exp-art" aria-hidden="true">⋯</span></Art>
                <SubContent><div class="oc-line" title="@names">@names</div></SubContent>
                <Line2><div class="oc-line warn-line lock-why" title="@why">@why</div></Line2>
                <Footer>
                    <button type="button" class="loc-btn res-btn @(open ? "on" : "")" aria-expanded="@open" title="在卡旁按条件逐条列出这些路线"
                            @onclick="OpenStack" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        <strong>逐条查看 ▸</strong>
                    </button>
                </Footer>
            </ObjectCard>
        }
        else
        {
            foreach (var lk in locked)
            {
                <LocationCard @key="@("lock-" + lk.Target)" LocationId="@lk.Target" LockReason="@lk.Reason" LockMinutes="@lk.Edge.BaseMinutes" />
            }
        }
        @if (entrances.Count == 0 && locked.Count == 0)
        {
            <div class="desk-hint">还没有发现通往别处的路线，探索周边可能找到线索</div>
        }
    </div>
</div>

<div class="panel facility-row" aria-label="设施与可交互对象">
    <div class="row-tag" aria-hidden="true">设施与资源</div>
    <div class="fac-scroll" data-wheel="x">
        @if (hasFacilities)
        {
            <div class="desk-group facilities">
                <div class="dg-title">设施</div>
                <div class="dg-cards">
                    @if (e.HasFireAt(s, place)) { <FireCard /> }
                    @if (!inside && lc.CanBuildShelter)
                    {
                        <FacilityCard Kind="shelter" />
                        <FacilityCard Kind="bed" />
                    }
                    @if (showSafehouse) { <SafehouseCard /> }
                    @* B10 试玩修复 9：营地设施栏显示已建工坊（只在可建工坊的地点；B17 起含已完工安全屋屋内） *@
                    @if (G.E.CanBuildWorkshopsHere(G.S)) { <FacilityCard Kind="workshops" /> }
                    @* B22c（Q170）：当前区建成晾制架时单独一张卡（8 个晾制位在面板里操作） *@
                    @if (G.E.DryingRackHere(G.S)) { <DryingRackCard /> }
                    @if (tarp != null)
                    {
                        var packWhy = G.Running || s.Main != null ? "行动进行中" : e.CanStart(s, GameEngine.Pack(tarp));
                        <ObjectCard Ink2="true" @key="@("tarp")" PeekId="@Peek.Card("tarp")" CssClass="k2-fac" Title="野营遮雨布" Badge="已铺开" BadgeClass="built" Sub="睡眠遮蔽 · 不挡遭遇" Tooltip="铺开期间在这里睡眠算遮蔽（至多4人）；不挡遭遇，没有安全屋休息加成">
                            <Art>@Icons.Markup("field_tarp")</Art>
                            <Footer>
                                <button type="button" class="loc-btn res-btn" disabled="@(packWhy != null)" title="@(packWhy ?? $"收起野营遮雨布（{e.Config.Safehouse.Camping.TarpPackMinutes}分钟）")"
                                        @onclick="() => PackTarp(tarp)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><strong>收起 · @(e.Config.Safehouse.Camping.TarpPackMinutes)分</strong></button>
                            </Footer>
                        </ObjectCard>
                    }
                    @if (!inside)
                    {
                        foreach (var ps in publicStations)
                        {
                            <PublicStationCard @key="@("ps-" + ps.Id)" Station="ps" />
                        }
                    }
                </div>
            </div>
        }
        @* B13：人物组（来客程望，首个 NPC 卡框架）与可查看对象（救助残页、南口路标） *@
        <PrologueCards />
        @if (expHere != null)
        {
            var abortWhy = busy ? "行动进行中" : e.CanAbortExpedition(s);
            var dname = e.DungeonCfg(expHere.DungeonId)!.Name;
            // 试玩修复 M399（B21-12）：本代已通关时写“已通关，直接离开”，不再写终止代价
            var cleared = e.DungeonCleared(s, expHere.DungeonId);
            var tipX = cleared
                ? $"{dname}本代已通关：从出口或原路回{e.LocName(e.DungeonCfg(expHere.DungeonId)!.Parent)}都不扣惩罚，不需要终止远征。"
                : $"{dname}本次远征：未通关离开要在这里（或菜单里）终止，每人{e.AbortPenaltyText()}、{e.ShakenText()}，撤出至少{e.Config.DungeonExpedition.ExtractMinMinutes}分钟并且途中不能取消；已拿到的物资不没收。战斗里的撤退只退回来路上的房间，不算离开。";
            <div class="desk-group expedition">
                <div class="dg-title">远征</div>
                <div class="dg-cards">
                    <ObjectCard Ink2="true" @key="@("exp-" + expHere.Id)" Id="expedition-abort" CssClass="k2-exp" Title="@dname" Badge="@(cleared ? "已通关" : "安全点")" BadgeClass="new" Tooltip="@tipX">
                        <Art><span class="exp-art" aria-hidden="true">⇱</span></Art>
                        <SubContent>
                            <div class="oc-line" title="@e.DungeonStatusLabel(s, expHere.DungeonId)">第@(expHere.Generation)代 · @e.DungeonStatusLabel(s, expHere.DungeonId)</div>
                        </SubContent>
                        <Line2>
                            @if (cleared)
                            {
                                <div class="oc-line" title="@tipX">已通关：出口或原路离开都不扣惩罚</div>
                            }
                            else
                            {
                                <div class="oc-line" title="@tipX">终止：撤出至少@(e.Config.DungeonExpedition.ExtractMinMinutes)分钟、扣属性</div>
                            }
                        </Line2>
                        <Footer>
                            @if (cleared)
                            {
                                <button type="button" class="loc-btn res-btn" disabled title="@tipX"><strong>已通关·直接离开</strong></button>
                            }
                            else
                            {
                                <button type="button" class="loc-btn res-btn" disabled="@(abortWhy != null)" title="@(abortWhy ?? "先看即时损失与返程时间，确认前可以取消")"
                                        @onclick="G.OpenAbort" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <strong>终止远征…</strong>
                                </button>
                            }
                        </Footer>
                    </ObjectCard>
                </div>
            </div>
        }
        @if (sealHere != null && (sealableN > 0 || sealedN > 0))
        {
            var tipS = "封存只收本次地牢里已经领到的奖励（物资箱、守卫回收、首通补给、胜利掉落）：不占随身卡位、暂时不能用；成功撤出或通关离开后放进父地点的远征回收箱。外带物、自制物不能封存。";
            <div class="desk-group expedition">
                <div class="dg-title">封存</div>
                <div class="dg-cards">
                    <ObjectCard Ink2="true" @key="@("seal-" + sealHere.Id)" Id="expedition-seal" CssClass="k2-exp" Title="封存战利品" Badge="@($"已封存{sealedN}")" BadgeClass="new" Tooltip="@tipS">
                        <Art><span class="exp-art" aria-hidden="true">▣</span></Art>
                        <SubContent><div class="oc-line" title="@tipS">可封存@(sealableN)堆 · 已封存@(sealedN)份</div></SubContent>
                        <Line2><div class="oc-line" title="@tipS">不占卡位，撤出后进父地点回收箱</div></Line2>
                        <Footer>
                            <button type="button" class="loc-btn res-btn" disabled="@(s.Battle != null)" title="@tipS" @onclick="G.OpenSeal" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <strong>整理封存…</strong>
                            </button>
                        </Footer>
                    </ObjectCard>
                </div>
            </div>
        }
        @if (parentOf.Count > 0)
        {
            <div class="desk-group expedition">
                <div class="dg-title">地牢</div>
                <div class="dg-cards">
                    @foreach (var d in parentOf)
                    {
                        var did = d.Id;
                        var status = e.DungeonStatus(s, did);
                        var resetText = e.ResetStatusText(s, did);
                        var recN = e.RemainsItems(s, GameEngine.RecoveryBoxKey(did)).Sum(i => i.Count);
                        var relN = e.RemainsItems(s, GameEngine.RelicBoxKey(did)).Sum(i => i.Count);
                        var ready = e.DungeonResetReady(s, did);
                        <ObjectCard Ink2="true" @key="@("reset-" + did)" Id="@("dungeon-reset-" + did)" CssClass="k2-exp" Title="@d.Name" Badge="@ShortStatus(status)" BadgeClass="@(ready ? "new" : "")" Tooltip="@($"{d.Name} · {GameEngine.DungeonStatusName(status)}：{resetText}")">
                            <Art><span class="exp-art" aria-hidden="true">↻</span></Art>
                            <SubContent>
                                <div class="oc-line" title="@resetText">第@(s.DungeonInstances[did].Generation)代 · @(ready ? "已可重置" : e.DungeonCleared(s, did) ? $"可重置于{Clock.DayTime(s.DungeonInstances[did].ResetEligibleAt ?? 0)}" : "未通关，不计时")</div>
                            </SubContent>
                            <Footer>
                                <button type="button" class="loc-btn res-btn" disabled="@(busy)" title="@(busy ? "行动进行中" : "查看重置条件、会刷新与不重发的内容、旧实例遗留物清单；条件满足才能确认")"
                                        @onclick="() => G.OpenReset(did)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <strong>@(ready ? "重置地牢…" : "重置条件…")</strong>
                                </button>
                            </Footer>
                        </ObjectCard>
                        @if (recN + relN > 0)
                        {
                            var tipB = "远征回收箱（成功撤出带回的封存战利品）与旧实例遗物认领箱（重置前迁出的旧实例遗留物）：无卡位上限、只能在这里取；在右栏人物页“队伍”块逐件取到随身（验五卡与负重）或放地面。";
                            <ObjectCard Ink2="true" @key="@("box-" + did)" Id="@("dungeon-box-" + did)" CssClass="k2-exp" Title="回收箱" Badge="@($"{recN + relN}份")" BadgeClass="new" Tooltip="@tipB">
                                <Art><span class="exp-art" aria-hidden="true">▤</span></Art>
                                <SubContent>
                                    <div class="oc-line" title="@($"远征回收箱{recN}份 · 旧实例遗物认领箱{relN}份。{tipB}")">回收@(recN) · 遗物@(relN)</div>
                                </SubContent>
                                <Footer>
                                    <button type="button" class="loc-btn res-btn" title="@tipB" @onclick="() => G.ShowDungeonBoxes(did)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                        <strong>取出…</strong>
                                    </button>
                                </Footer>
                            </ObjectCard>
                        }
                    }
                </div>
            </div>
        }
        @if (cards.Count > 0)
        {
            @* B41e1（逐字稿「B41 Q426–Q428 正式文案」卡片与倒计时、Q427 卡名与角标、Q446 ⑥ 三类卡悬停）：一个「敌踪」分组，按内核 EnemyCardsHere 的顺序排；
               标题、角标、危险叠层取卡视图；第二行放卡面接近状态句（CardApproachStatus）。点卡选中（右栏敌踪详情）并打开居中操作盘，处理按钮都在盘里。 *@
            <div class="desk-group enemies">
                <div class="dg-title">敌踪</div>
                <div class="dg-cards">
                    @foreach (var c in cards)
                    {
                        var key = c.Key;
                        var anchor = EnemyCardAnchor(key);
                        var lead = e.Enemy(c.EnemyIds[0]);
                        var one = c.Kind is "single" or "elite" ? c.Members.FirstOrDefault() : null;
                        var status = e.CardApproachStatus(s, c);
                        // BM5b1（R05 Q639）：卡面直接给卡自身的真实受阻原因（首战门控／固定关键限制），再接无时长状态句；长句换行、悬停／焦点读全文
                        var faceWhy = GameEngine.EnemyCardFaceReason(c);
                        var hover = e.EnemyCardHoverLines(s, c);
                        // B41e2（Q539）：随机组卡第一副标照固定卡格式，列锁定名单原序的存活成员公开名（「、」连接、同名不合并；长名单由卡的副标悬停读全文）
                        var names = e.EnemyCardMemberNames(c);
                        // 副标沿旧卡：常驻／可选强敌写健康数值，固定战、随机组卡写名单
                        var sub = c.Kind is "single" or "elite" ? $"健康 {Ui.N(one?.Hp ?? lead.Hp)}/{Ui.N(lead.Hp)}" : names;
                        <ObjectCard Ink2="true" Danger="@c.Danger" @key="@("ecard-" + key)" Id="@anchor" PeekId="@Peek.Sel(SelectionKind.Enemy, key)"
                                    CssClass="@(c.Kind == "fixed" ? "k2-enemy fixed" : c.Kind == "elite" ? "k2-enemy elite" : "k2-enemy")" Title="@c.Title"
                                    Badge="@c.Badge" BadgeClass="@(c.Badge == "中立" ? "" : "new")" Sub="@sub" SubClass="@(one != null || c.Kind == "elite" ? "hp" : "")"
                                    Selected="@(sel.Kind == SelectionKind.Enemy && sel.Id == key)" Fresh="@c.Members.Any(w => G.Highlights.Contains($"enemy:{w.Id}"))"
                                    Tooltip="@(hover.Count > 0 ? string.Join("\n", hover) : null)" OnClick="() => OpenEnemyCard(key)">
                            <Art>@Icons.Markup("enemy_" + lead.Id)</Art>
                            <Line2>
                                @if (one != null) { <div class="track"><i style="width:@Ui.Bar(one.Hp, lead.Hp)%"></i></div> }
                                @if (c.Kind == "fixed" && e.FixedHurtNote(s, here) is string hurt) { <div class="oc-line" title="@hurt">@hurt</div> }
                                @if (faceWhy != null) { <div class="oc-line ecard-status ecard-why" title="@faceWhy">@faceWhy</div> }
                                @if (status != null) { <div class="oc-line ecard-status" title="@status">@status</div> }
                            </Line2>
                        </ObjectCard>
                    }
                </div>
            </div>
        }
        @* B17 试玩修复 B1：屋内不采集，整组不显示（让出宽度，避免设施行横向滚动） *@
        @if (!inside)
        {
        <div class="desk-group resources">
            <div class="dg-title">采集资源</div>
            <div class="dg-cards">
                @foreach (var r in resources)
                {
                    var (stock, empty) = e.ResourceCardStock(s, r);   // B12：四账角标（日补/不补/无限/本代剩余/已领取）；Q260：本次搜集占着的预留算作还在
                    var nodeId = r.NodeId;
                    var tool = e.BestToolFor(s, r);   // B13b（Q121）：新表按物品 ID（石刀/简易斧/撬棍），旧 20 条按原标签
                    var toolNames = e.QualifiedToolNames(r);
                    var minutes = tool != null && r.ToolBonus?.BaseMinutesOverride != null ? r.ToolBonus.BaseMinutesOverride.Value
                        : e.StagedRecord(r) ? e.StagedLeft(s, r) : r.BaseMinutes;   // B23 试玩修复（EXQ-A05）：两段续做的记录写剩余分钟
                    var req = ActionRequest.Gather(r.NodeId);
                    var why = busy ? (s.Main?.Status == ActionStatus.Paused ? "行动暂停中" : "行动进行中") : e.CanStart(s, req);   // 按钮的锁与悬停原因
                    var cardWhy = e.ResourceCardReason(s, req, busy);   // Q252：卡面第二行只写资源自身状态，全局状态不让主图消失
                    var noOutputLine = e.NoOutputYieldLine(r);   // Q254：没有确定产出的资源点
                    @* B32a（Q340、Q345）：重墨 V2 卡模板——副标＝账短标 · 每次产量（日补写在悬停与右栏），第二行＝风险行与资源自身原因；
                       库存为 0（Dim）与资源自身阻断（Blocked）为不可用，当前采集对象为加工中 *@
                    <ObjectCard Ink2="true" @key="r.NodeId" Id="@($"res-{nodeId}")" PeekId="@Peek.Sel(SelectionKind.Resource, nodeId)" CssClass="k2-res" Title="@r.Name" AriaLabel="@(noOutputLine == null ? null : $"{r.Name}：{noOutputLine}")" Badge="@stock" BadgeClass="@(empty ? "unbuilt" : "")" Dim="empty"
                                Blocked="@(cardWhy != null)" Busy="@CardStates.BusyResource(s, nodeId)"
                                Selected="@(sel.Kind == SelectionKind.Resource && sel.Id == r.NodeId)" Fresh="@G.Highlights.Contains(r.NodeId)"
                                DataDrop="@($"res:{nodeId}")" Tooltip="@(r.IsRecord ? "核心记录：点击查看领取预估" : r.IsCampaign ? "本局唯一领取：点击查看领取预估" : toolNames != null ? $"{(r.ToolBonus!.LockedSearch ? "锁闭储物点" : "资源点")}：点击查看采集预估；可用工具：{toolNames}（把它拖到这里指定使用）{(r.ToolBonus.LockedSearch ? "；" + e.ConditionalToolHint(r) : "")}" : "资源点：点击查看采集预估；这里没有可用工具，徒手进行")" OnClick="() => SelectResource(nodeId)">
                        <Art>@Icons.Markup(Icons.ForResource(r.NodeId, r.Outputs))</Art>
                        <SubContent>
                            @* M84：耗时只写在按钮上（“采集/搜集 + N分钟”），状态行不再重复，给名称和产出留位 *@
                            @if (r.IsRecord)
                            {
                                <div class="oc-line" title="核心记录：本局唯一一次，地牢换代后也不再发放；记作记录，不占物资卡"><AccountIcon Label="@GameEngine.AccountLabel(r)" />核心记录 · 本局唯一</div>
                            }
                            else if (noOutputLine != null)
                            {
                                @* 全句可能长，窄卡单行省略，全文在悬停、聚焦朗读和点选详情 *@
                                <div class="oc-line res-yield" title="@noOutputLine"><AccountIcon Label="@GameEngine.AccountLabel(r)" />@noOutputLine</div>
                            }
                            else if (r.IsCampaign)
                            {
                                var packLine = string.Join("、", r.Outputs.Select(o => $"{e.ItemName(o.Key)}{o.Value}"));
                                <div class="oc-line" title="本局唯一一次领取：@packLine"><AccountIcon Label="@GameEngine.AccountLabel(r)" />本局唯一 · @packLine</div>
                            }
                            else if (r.IsCache)
                            {
                                var cacheLine = $"{GameEngine.AccountLabel(r)} · " + string.Join("、", r.Outputs.Select(o => $"{e.ItemName(o.Key)}{o.Value}"));   // B23（A10 §3）：四类账短标
                                <div class="oc-line" title="@cacheLine"><AccountIcon Label="@GameEngine.AccountLabel(r)" />@cacheLine</div>
                            }
                            else
                            {
                                var per = r.Outputs.Values.First() * (tool != null && r.ToolBonus != null && !r.IsUnlimited ? r.ToolBonus.OutputMultiplier : 1) + e.PassiveGatherBonus(s, s.Player, r, r.Outputs.Keys.First());
                                // B23（A10 §3）：卡面先写四类账短标（有限/每日补充/本实例/持续），确定产量写“每次”
                                // B32a Q340：卡面副标只写账短标与每次产量，日补放悬停（右栏照原显示）
                                var perLine = $"{GameEngine.AccountLabel(r)} · 每次{per}{e.ItemName(r.Outputs.Keys.First())}";
                                var perTip = perLine + (r.Refills ? $" · 日补{r.DailyRefill}" : "");
                                <div class="oc-line" title="@perTip"><AccountIcon Label="@GameEngine.AccountLabel(r)" />@perLine</div>
                            }
                        </SubContent>
                        <Line2>
                            @if (r.Hazard != null) { var hz = $"{Ui.Pct(e.HazardChance(s, r))}{r.Hazard.Label} · 健康−{Ui.T(e.HazardLoss(s, r))}"; <div class="oc-line warn-line" title="@hz">@hz</div> }
                            @* Q28：按钮缩成“动词 + 时长”让出约70%图片区，不能开始的实际原因改写在卡面状态角标里，不隐藏 *@
                            @if (cardWhy != null) { <div class="oc-line warn-line res-why" title="@cardWhy">@cardWhy</div> }
                        </Line2>
                        <Footer>
                            @* 试玩修复 B5：与探索/清理同一按钮形态，悬停或聚焦即在右栏预测，离开恢复 *@
                            @{ var verb = e.GatherVerbNow(s, r); var title = $"{verb}{r.Name}"; }
                            <button type="button" class="loc-btn res-btn" disabled="@(why != null)" title="@(why ?? "单击直接开始；右侧显示预测")"
                                    @onmouseenter="() => G.Hover(req, title)" @onfocus="() => G.Hover(req, title)" @onmouseleave="() => G.Hover(null)" @onblur="() => G.Hover(null)"
                                    @onclick="() => Quick(req, nodeId)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <strong>@verb</strong>
                                <small>@(minutes)分钟</small>
                            </button>
                        </Footer>
                    </ObjectCard>
                }
                @if (resources.Count == 0)
                {
                    <div class="desk-hint">@(s.Locations[here].Progress < 100 ? "这里还没有发现资源点，探索周边可能找到线索" : "这里没有可采集的资源")</div>
                }
            </div>
        </div>
        }
    </div>
</div>

@code {
    /// <summary>B22 试玩修复 M408：父地点“地牢”卡角标用短状态（长状态会把地牢名挤成“教会…”；全称写在卡片悬停里）。</summary>
    private static string ShortStatus(string status) => status switch
    {
        DungeonStatuses.Active => "未通关",
        DungeonStatuses.Unopened => "未进入",
        _ => GameEngine.DungeonStatusName(status),
    };

    private void OpenStack() => G.OpenPop("lockstack", "all", "lockstack");

    private async Task PackTarp(ItemInstance tarp) => await G.StartAction(GameEngine.Pack(tarp));

    private void SelectResource(string id) => G.Select(new Selection { Kind = SelectionKind.Resource, Id = id });

    /// <summary>B41e1：敌踪卡的 DOM id（居中操作盘关闭后焦点回到它；卡键里的冒号换成连字符）。</summary>
    public static string EnemyCardAnchor(string cardKey) => "ecard-" + cardKey.Replace(':', '-');

    /// <summary>B41e1：点敌踪卡——选中（右栏敌踪详情）并打开居中操作盘。</summary>
    private void OpenEnemyCard(string cardKey) => G.OpenEnemyCard(cardKey, EnemyCardAnchor(cardKey));

    /// <summary>资源卡底部按钮：选中并直接开始（留言 649cdad9）。</summary>
    private async Task Quick(ActionRequest r, string nodeId)
    {
        G.Hover(null);
        SelectResource(nodeId);
        await G.StartAction(r);
    }

    private string _lastLocation = "";

    /// <summary>到达新地点后两行横滚容器都回到最左（试玩修复 B10，v0.7 起是相邻地图子栏与第二行两个容器）。</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (G.State == null) return;
        var here = G.S.Ground;
        if (here == _lastLocation) return;
        _lastLocation = here;
        try { await JS.InvokeVoidAsync("survival.resetDesk"); }
        catch (JSException) { /* 旧缓存的 app.js 没有这个函数时只是不复位，不影响游戏 */ }
    }
}
