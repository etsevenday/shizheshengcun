@inherits GameComponent

@* 地块卡片桌面（卡片统一与设施烹饪 v0.4 · 01 案第 1 节）：当前地图卡 → 已发现相邻地图卡 → 固定设施卡 → 已发现资源卡。
   场景底图只作弱化背景（昼夜调色与火光照旧），每个对象都有自己的图卡；视口不足时本区内部横向滚动，不遮 HUD 与地面栏。
   点击火堆或其内容物入口，在本区打开设施次级菜单（FacilityMenu）。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var lc = e.Location(here);
    var fac = s.Locations[here].Facility;
    var sel = G.Selected;
    var resources = e.Config.Resources.Where(r => r.LocationId == here && s.Resources[r.NodeId].Discovered).ToList();
    var entrances = e.AdjacentUnlocked(s).Select(x => x.Other(here)).ToList();
    var busy = e.IsBusy(s) || G.Running;
    var light = Ui.Light(Clock.MinuteOfDay(s.GameMinute), lc.IsIndoor);
    var scene = lc.Scene ?? $"scenes/{lc.Id}.svg";
    var fireOn = lc.HasFire && fac.FireLit && lc.SceneFireX.HasValue && lc.SceneFireY.HasValue;
    string F(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="panel hero desk @(lc.IsIndoor ? "indoor" : "")" data-phase="@light.Phase" aria-label="@($"{lc.Name} · 地块卡片")">
    <div class="scene-art" style="background-image:url('@scene');filter:brightness(@F(light.Brightness)) saturate(@F(light.Saturate))"></div>
    <div class="scene-tint" style="background:@light.Tint"></div>
    <svg class="scene-over" viewBox="0 0 1200 650" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        @if (light.Stars > 0.05)
        {
            <g fill="#f3efd9" opacity="@F(light.Stars)">
                @foreach (var (x, y, r) in Stars) { <circle cx="@x" cy="@y" r="@F(r)" /> }
            </g>
        }
        @if (fireOn)
        {
            <defs>
                <radialGradient id="fireGlow"><stop stop-color="#ffb35c" stop-opacity=".75" /><stop offset=".45" stop-color="#ff8a3c" stop-opacity=".28" /><stop offset="1" stop-color="#ff8a3c" stop-opacity="0" /></radialGradient>
            </defs>
            <circle cx="@F(lc.SceneFireX!.Value)" cy="@F(lc.SceneFireY!.Value)" r="@F(170 + 160 * light.Night)" fill="url(#fireGlow)" opacity="@F(.45 + .55 * light.Night)" />
        }
    </svg>
    <div class="hero-shade"></div>

    @if (G.FacilityLayer != null && lc.HasFire)
    {
        <FacilityMenu />
    }
    else
    {
    <div class="desk-row">
        <LocationCard LocationId="@here" Current="true" />
        @foreach (var to in entrances)
        {
            <LocationCard @key="to" LocationId="@to" />
        }
        @if (lc.HasFire) { <FireCard /> }
        @if (lc.CanBuildShelter)
        {
            <FacilityCard Kind="shelter" />
            <FacilityCard Kind="bed" />
        }
        @foreach (var r in resources)
        {
            var rs = s.Resources[r.NodeId];
            var empty = !r.IsUnlimited && (rs.Available ?? 0) <= 0;
            var nodeId = r.NodeId;
            var tool = r.ToolBonus != null ? e.BestTool(s, r.ToolBonus.ToolTag) : null;
            var minutes = tool != null && r.ToolBonus?.BaseMinutesOverride != null ? r.ToolBonus.BaseMinutesOverride.Value : r.BaseMinutes;
            var req = ActionRequest.Gather(r.NodeId);
            var why = busy ? "行动进行中" : e.CanStart(s, req);
            var stock = r.IsCache ? (empty ? "已搜空" : "可搜1次") : r.IsUnlimited ? "不限量" : $"{rs.Available}/{r.Cap}";
            <ObjectCard @key="r.NodeId" CssClass="res-card" Title="@r.Name" Badge="@stock" BadgeClass="@(empty ? "unbuilt" : "")" Dim="empty"
                        Selected="@(sel.Kind == SelectionKind.Resource && sel.Id == r.NodeId)" Fresh="@G.Highlights.Contains(r.NodeId)"
                        DataDrop="@($"res:{nodeId}")" Tooltip="资源点：点击查看采集预估；把对应工具拖到这里指定使用" OnClick="() => SelectResource(nodeId)">
                <Art>@Icons.Markup(Icons.ForResource(r.NodeId, r.Outputs))</Art>
                <ChildContent>
                    @if (r.IsCache)
                    {
                        <div class="oc-line">@string.Join("、", r.Outputs.Select(o => $"{e.ItemName(o.Key)}{o.Value}")) · @(minutes)分</div>
                    }
                    else
                    {
                        var per = r.Outputs.Values.First() * (tool != null && r.ToolBonus != null && !r.IsUnlimited ? r.ToolBonus.OutputMultiplier : 1);
                        <div class="oc-line">每次@(per)@(e.ItemName(r.Outputs.Keys.First())) · @(minutes)分@(r.Refills ? $" · 日补{r.DailyRefill}" : "")</div>
                    }
                    @if (r.Hazard != null) { <div class="oc-line warn-line">@Ui.Pct(r.Hazard.Probability)@r.Hazard.Label · 健康−@r.Hazard.HealthLoss.ToString("0")</div> }
                </ChildContent>
                <Footer>
                    <button type="button" class="oc-btn primary-ish" disabled="@(why != null)" title="@(why ?? "直接开始，详情可看右侧预估")"
                            @onclick="() => Quick(req, nodeId)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">@(r.IsCache ? "搜集" : "采集")</button>
                </Footer>
            </ObjectCard>
        }
        @if (resources.Count == 0)
        {
            <div class="desk-hint">@(s.Locations[here].Progress < 100 ? "这里还没有发现资源点，探索周边可能找到线索" : "这里没有可采集的资源")</div>
        }
    </div>
    }
</div>

@code {
    // 夜空星点（固定位置，只在上半部天空）
    private static readonly (int x, int y, double r)[] Stars = BuildStars();

    private static (int, int, double)[] BuildStars()
    {
        var rng = new Random(7);
        return Enumerable.Range(0, 46).Select(_ => (rng.Next(20, 1180), rng.Next(20, 230), 1 + rng.NextDouble() * 1.6)).ToArray();
    }

    private void SelectResource(string id) => G.Select(new Selection { Kind = SelectionKind.Resource, Id = id });

    /// <summary>资源卡底部按钮：选中并直接开始（留言 649cdad9）。</summary>
    private async Task Quick(ActionRequest r, string nodeId)
    {
        SelectResource(nodeId);
        await G.StartAction(r);
    }
}
