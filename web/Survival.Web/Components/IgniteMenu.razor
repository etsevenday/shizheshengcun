@inherits GameComponent
@inject IJSRuntime JS

@* 点火盘 P02e「选择点火工具」（B31c 起按 Q324 居中，B31d 起按 Q338 加四轨遮罩）。
   B32b（逐字稿 §1.2 Q344 选 A、§1.5 Q366 选 A）改两步：打开时默认未选（只有一把也一样），未选写「请选择打火器。」；
   每个选项写实际工具名，旁列真实来源与「耐久{当前}/{上限}」（不显示内部编号，选择绑定该把工具）；选中后列「火堆」「点火工具」「耐久」「耗时」、
   磨损与点火后的燃料提示（数值按原预演），按「点火（{时长}）」才提交（带新 requestId、组件级防连点），盘收起。
   条件变化时按原真实原因禁用并重验选定的那一把。悬停工具时右栏仍显示对应预测。没有可用工具仍能打开，写“没有可用点火工具”及原因。
   直接把打火器拖到火堆仍走原直接点火，暂停层独立点火入口沿原规则。Esc、×、遮罩只收起。
   B32f（逐字稿 §1.5 Q395，同 Q390）：游戏菜单打开期间只隐藏（menu-hidden）、不卸载，所选工具保留；点顶栏「菜单」与菜单里的点按不算点盘外；
   关菜单后按当前状态重算预演与按钮可用性（所选那把失效时按原原因禁用），火堆已燃或不在时照原条件不显示；恢复不提交。 *@
@{
    var s = G.S;
    var e = G.E;
    var fac = e.FacOf(s, s.Ground)!;
    var opts = e.IgniteToolOptions(s);
    var none = e.IgniteNoToolReason(s);
    var picked = _picked is int pid ? opts.FirstOrDefault(o => o.InstanceId == pid) : null;
    var p = picked is { Usable: true } ? G.Preview(ActionRequest.Ignite(picked.InstanceId)) : null;
    var minutes = p is { Ok: true } ? p.EstimatedMinutes : e.Config.Fire.IgniteMinutes;
    var why = picked == null ? null : !picked.Usable ? picked.Reason : p is { Ok: false } ? p.Reason : null;
}
<AnchorPop AnchorId="fc-ignite" Title="选择点火工具" Place="below,above,right,left" CssClass="@("ignite" + G.MenuHideCss)" OnClose="Close">
    <Art>@Icons.Markup("fire_out")</Art>
    <ChildContent>
        <div @ref="box" class="ignite-menu in-pop" aria-label="选择点火工具">
            <div class="im-list" role="radiogroup" aria-label="点火工具" data-wheel="y">
                @foreach (var o in opts)
                {
                    var id = o.InstanceId;
                    var title = $"用{o.Name}点火";
                    var on = picked != null && picked.InstanceId == id;
                    <button type="button" role="radio" aria-checked="@(on ? "true" : "false")" class="im-item @(o.Usable ? "" : "off") @(on ? "on" : "")" disabled="@(G.Running || starting)"
                            title="@(o.Usable ? $"选择这把{o.Name}" : o.Reason)"
                            @onmouseenter="() => HoverTool(id, title)" @onfocus="() => HoverTool(id, title)"
                            @onmouseleave="Unhover" @onblur="Unhover" @onclick="() => Pick(id)">
                        <span class="ir-icon">@Icons.Markup(o.ItemId)</span>
                        <span class="im-text">
                            <b>@o.Name</b>
                            <small>@o.Source@(o.MaxDurability.HasValue && o.Durability.HasValue ? $" · 耐久{Ui.N(o.Durability.Value)}/{Ui.N(o.MaxDurability.Value)}" : "")@(o.Usable ? "" : " · " + o.Reason)</small>
                        </span>
                    </button>
                }
                @if (none != null)
                {
                    <div class="im-none"><b>没有可用点火工具</b><span>@none</span></div>
                }
            </div>
            <div class="lines im-detail">
                <div><span>火堆</span><b>@CardStates.IgniteFireLine(fac)</b></div>
                @if (picked == null)
                {
                    <div class="im-hint">@CardStates.IgnitePickHint</div>
                }
                else
                {
                    <div><span>点火工具</span><b>@picked.Name · @picked.Source</b></div>
                    @if (picked.MaxDurability.HasValue && picked.Durability.HasValue)
                    {
                        <div><span>耐久</span><b>@Ui.N(picked.Durability.Value)/@Ui.N(picked.MaxDurability.Value)</b></div>
                    }
                    <div><span>耗时</span><b>@Clock.Duration(minutes)</b></div>
                }
            </div>
            <div class="im-foot">
                @if (picked != null)
                {
                    <div>成功点火磨损打火器@(Ui.T(e.LighterWear))。</div>
                    @if (p != null && p.Ok)
                    {
                        <div>@(p.AutoWood ? $"燃料为0：将自动投入1份木材（+{e.Config.Fire.BurnMinutesPerWood}分钟），" : $"现有燃料{p.FuelBefore}分钟，")点火完成时剩@(p.FuelAtEnd)分钟</div>
                        @if (p.DiesOutAtEnd) { <div class="warn-text">点火完成时燃料耗尽、火堆随即熄灭，建议先投入木材</div> }
                    }
                    @if (why != null) { <div class="warn-text">@why</div> }
                }
            </div>
        </div>
    </ChildContent>
    <Actions>
        <button type="button" class="primary apop-go" data-enter disabled="@(picked == null || why != null || G.Running || starting)" @onclick="Go">@CardStates.IgniteButton(minutes)<EnterCap On="@(!(picked == null || why != null || G.Running || starting))" /></button>
        <button type="button" class="secondary apop-cancel" @onclick="Close">取消<EscCap On="@G.EscOnDisk" /></button>
    </Actions>
</AnchorPop>

@code {
    private ElementReference box;
    private DotNetObjectReference<IgniteMenu>? _ref;
    private bool starting;
    /// <summary>Q344：玩家手动选中的那一把（实例号）；打开时为空，只有一把也不预选。</summary>
    private int? _picked;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        // 点盘外（不含“点燃”按钮本身）只收起；不拦截那次点击，也不影响拖拽
        try { await JS.InvokeVoidAsync("survival.watchOutside", box, _ref, ".fc-btn.ignite, .apop.ignite, [data-menu-key], .menu-scrim"); }
        catch (JSException) { }
    }

    /// <summary>点盘外只收起；游戏菜单开着时（盘被隐藏）菜单里的点按不收盘（Q395）。</summary>
    [JSInvokable]
    public void OutsideClick()
    {
        if (G.MenuHidesDisks) return;
        Close();
    }

    private void Close()
    {
        G.Hover(null);
        G.CloseIgniteMenu();
    }

    private void HoverTool(int id, string title) => G.Hover(ActionRequest.Ignite(id), title);

    private void Unhover() => G.Hover(null);

    private void Pick(int id) => _picked = id;

    private async Task Go()
    {
        if (starting || G.Running || _picked is not int id) return;
        starting = true;
        try
        {
            G.Hover(null);
            G.CloseIgniteMenu();
            await G.StartAction(ActionRequest.Ignite(id));
        }
        finally
        {
            starting = false;
        }
    }

    public override void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("survival.unwatchOutside"); } catch { }
        _ref?.Dispose();
        base.Dispose();
    }
}
