@inherits GameComponent

@* PRO17 远行准备（S15 §6、A10-TUTOR §6；开发计划 v0.9 B13 R42）：显示已知基础路线 village→m01(30)→m02(20)→h01(15)→h02(5) 合计 70 基础分钟，
   明确“已知边基础合计，不是全旅程预算”；当前全员状态、随身物资卡/装备/耐久；建议净水2份+可食2份+防身物只列缺项，不是硬门槛。
   “准备好了”只锁存 PRO17（知情确认），不赠物、不强吃、不自动拿地面物资；程望在场时可“先准备”。浏览不推进时间。 *@
@{
    var s = G.S;
    var e = G.E;
    var pv = e.JourneyPreviewOf(s);
}

<div class="sub-panel journey-panel" data-enter-scope tabindex="-1" role="dialog" aria-label="远行准备">
    <div class="sub-head">
        <div><h2>远行准备</h2><span class="sub">知情确认，不是出发门槛 · 浏览不耗时</span></div>
        <button class="secondary" @onclick="Close">关闭<EscCap On="@(G.EscOwner == EscOwner.Panel)" /></button>
    </div>
    <div class="sub-body journey-body" data-wheel="y">
        <section class="jr-route">
            <h3>已知基础路线</h3>
            <ol class="jr-legs">
                @foreach (var l in pv.Legs)
                {
                    <li><b>@e.LocName(l.From)</b> → <b>@e.LocName(l.To)</b><span>@(l.Minutes)基础分钟</span>@if (l.Open) {<em class="good-text">已开通</em>} else {<em class="muted">未开通</em>}</li>
                }
            </ol>
            <p class="jr-total">合计<b>@(pv.BaseMinutesTotal)基础分钟</b>：这是已知道路的基础合计，<b>不是整个旅程的预算</b>——探索、清障、行动倍率、战斗与回程都另算。主世界与营区之间没有传送。</p>
        </section>
        <section class="jr-pack">
            <h3>建议携带（只是提示）</h3>
            <div class="lines">
                <div><span>净水</span><b>@pv.CleanWater / @(e.Config.Prologue.Journey.SuggestedCleanWater)份</b></div>
                <div><span>可直接吃的食物</span><b>@pv.Food / @(e.Config.Prologue.Journey.SuggestedFood)份</b></div>
                <div><span>防身武器</span><b>@(pv.HasWeapon ? "已装备" : "未装备")</b></div>
            </div>
            @if (pv.Missing.Count > 0)
            {
                <p class="warn-text">还缺：@string.Join("；", pv.Missing)。缺项也可以知情继续。</p>
            }
            else
            {
                <p class="good-text">建议物都已带上。</p>
            }
            @foreach (var w in pv.Warnings) { <p class="warn-text">@w</p> }
        </section>
        <section class="jr-party">
            <h3>当前状态</h3>
            @foreach (var line in pv.PartyLines) { <div class="small">@line</div> }
            <h3>随身与装备</h3>
            @if (pv.CarryLines.Count == 0) { <div class="small muted">没有随身物品</div> }
            @foreach (var line in pv.CarryLines) { <div class="small">@line</div> }
        </section>
        <div class="btn-row">
            @if (pv.Confirmed)
            {
                <span class="good-text">已确认准备（为远行打包：已记录）。出发仍需沿真实道路移动。</span>
            }
            else
            {
                <button class="primary" disabled="@(pv.ConfirmBlocked != null)" title="@(pv.ConfirmBlocked ?? "确认已看过路线与预览（不耗时、不赠物）")" data-enter @onclick="Confirm">准备好了<EnterCap On="@(pv.ConfirmBlocked == null)" /></button>
            }
            @if (pv.CanSayNotReady)
            {
                <button class="secondary" title="对来客说先准备（不写任何门槛）" @onclick="NotReady">先准备</button>
            }
            @if (pv.ConfirmBlocked != null) { <span class="muted small">@pv.ConfirmBlocked</span> }
        </div>
    </div>
</div>

@code {
    private void Close() => G.OpenPanel(null);

    private void Confirm() => G.ConfirmJourney();

    private void NotReady() => G.SayNotReady();
}
