@inherits GameComponent

@* 地图卡。当前地图卡（基础UI修订 v0.7 第 2.1 节）：横向大图卡，场景图铺满卡面，地名、室内外、昼夜、探索度与按钮放在图片边缘的局部衬底上，
   不再整张覆盖暗层；探索/清理直接放在卡内，指向或聚焦即在右栏预测，单击直接开始；100% 时不渲染探索按钮，保留“已充分探索”；
   清理 0 次或角色忙碌时按钮可见并写明原因。相邻地图卡：图、名称、访问状态、单程时间与移动入口。 *@
@{
    var s = G.S;
    var e = G.E;
    var lc = e.Location(LocationId);
    var ls = s.Locations[LocationId];
    var sel = G.Selected;
    var scene = ArtAssets.Scene(lc.Id, lc.Scene);
}

@if (Current)
{
    var busy = e.IsBusy(s) || G.Running || starting;
    var full = ls.Progress >= 100;
    var exploreWhy = busy ? BusyReason() : e.CanStart(s, ActionRequest.Explore());
    var clearWhy = busy ? BusyReason() : e.CanStart(s, ActionRequest.Clear());
    var (charges, _) = e.ClearChargesAt(s, LocationId);
    var light = Ui.Light(Clock.MinuteOfDay(s.GameMinute), lc.IsIndoor);
    var fireOn = lc.HasFire && s.Locations[LocationId].Facility.FireLit && lc.SceneFireX.HasValue && lc.SceneFireY.HasValue;
    var picked = sel.Kind is SelectionKind.Location or SelectionKind.Clear;
    @* 试玩修复 M298：主目标的下一段还没发现时点亮当前地点卡（探索入口），不泄露未发现的地点 *@
    <div class="map-card @(picked ? "selected" : "") @(lc.IsIndoor ? "indoor" : "") @(G.TutorialFocus == "loc:" + LocationId ? "tut-lit" : "")" data-drop="@($"loc:{LocationId}")" data-drop-level="card"
         role="button" tabindex="0" aria-label="@($"当前地点{lc.Name}，探索{ls.Progress}%")"
         title="当前地点：点卡片查看探索预估；把建材拖到营地地点卡可查看营地设施" @onclick="SelectLocation" @onkeydown="CardKey">
        <div class="mc-art" style="background-image:url('@scene');filter:brightness(@F(light.Brightness)) saturate(@F(light.Saturate))" role="img" aria-label="@($"{lc.Name}场景图")"></div>
        <div class="mc-tint" style="background:@light.Tint"></div>
        <svg class="mc-over" viewBox="0 0 1200 650" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            @if (light.Stars > 0.05)
            {
                <g fill="#f3efd9" opacity="@F(light.Stars)">
                    @foreach (var (x, y, r) in Stars) { <circle cx="@x" cy="@y" r="@F(r)" /> }
                </g>
            }
            @if (fireOn)
            {
                <defs>
                    <radialGradient id="fireGlow"><stop stop-color="#ffb35c" stop-opacity=".75" /><stop offset=".45" stop-color="#ff8a3c" stop-opacity=".28" /><stop offset="1" stop-color="#ff8a3c" stop-opacity="0" /></radialGradient>
                </defs>
                <circle cx="@F(lc.SceneFireX!.Value)" cy="@F(lc.SceneFireY!.Value)" r="@F(170 + 160 * light.Night)" fill="url(#fireGlow)" opacity="@F(.45 + .55 * light.Night)" />
            }
        </svg>
        <div class="mc-top">
            <span class="mc-chip name" title="@lc.Name"><b>@lc.Name</b>@* P01a 地点角标 *@<em>@ShellText.PlaceTitle</em></span>
            <span class="mc-chip">@(Current && s.CurrentZone == GameState.SafehouseZone ? "屋内·遮蔽" : lc.IsIndoor ? "室内" : "露天") · @light.Phase</span>
            @if (lc.Danger is int danger)
            {
                @* B11（Q31）：危险度 0—3 只作提示，不改接敌率与敌人强度 *@
                <span class="mc-chip" title="@GameEngine.DangerText(danger)">危险@(danger)</span>
            }
            <span class="mc-chip" title="天气玩法待独立立项：现在只是占位，没有任何数值效果">天气：待接入</span>
        </div>
        <div class="mc-bottom">
            <div class="mc-progress">
                <span>@(full ? "已充分探索" : $"探索{ls.Progress}%")</span>
                <div class="loc-progress" aria-label="@($"探索度{ls.Progress}%")"><i style="width:@(ls.Progress)%"></i></div>
            </div>
            <div class="loc-actions">
                @if (e.CityOf(LocationId) != null)
                {
                    @* B24（A10-CITY §3）：三城父节点与城内建筑（营门登记前也有）显示“主城鸟瞰”；浏览 0 分钟，再按一次只退浏览层 *@
                    var cityWhy = e.CityOverviewBlocked(s);
                    var cityOn = G.Panel == "citymap";
                    <button @key="@("citymap")" type="button" class="loc-btn city-btn @(cityOn ? "on" : "")" disabled="@(cityWhy != null && !cityOn)" aria-pressed="@cityOn"
                            title="@(cityWhy ?? (cityOn ? "返回当前地点（关闭鸟瞰，不移动）" : $"{e.CityTitle(e.CityOf(LocationId)!)}主城鸟瞰：查看城内建筑、人物与路线（浏览不耗时）"))"
                            @onclick="() => G.ToggleCityOverview()" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        <strong>主城鸟瞰</strong>
                        @if (cityWhy != null && !cityOn) { <small>@cityWhy</small> }
                    </button>
                }
                @if (!full)
                {
                    <button @key="@("explore")" type="button" class="loc-btn" disabled="@(exploreWhy != null)" title="@(exploreWhy ?? "单击直接开始；右侧显示预测")"
                            @onmouseenter="HoverExplore" @onfocus="HoverExplore" @onmouseleave="Unhover" @onblur="Unhover"
                            @onclick="Explore" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        <strong>探索 · @(e.ExploreMinutesAt(LocationId))分钟</strong>
                        @if (exploreWhy != null) { <small>@exploreWhy</small> }
                    </button>
                }
                @if (lc.ClearEnabled)
                {
                    @* B12（Q31）：新节点清理开放，按钮写 clearLabel（“清理翻找”/城市“整理搜集”）与逐点分钟；地牢房间每代 1 次 *@
                    var clearLabel = e.ClearLabelAt(LocationId);
                    <button @key="@("clear")" type="button" class="loc-btn" disabled="@(clearWhy != null)" title="@(clearWhy ?? "单击直接开始；右侧显示预测")"
                            @onmouseenter="HoverClear" @onfocus="HoverClear" @onmouseleave="Unhover" @onblur="Unhover"
                            @onclick="Clear" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        <strong>@clearLabel · @(e.ClearMinutesAt(LocationId))分钟</strong>
                        <small>@e.ClearCountText(s, LocationId)@(clearWhy != null && charges > 0 ? $" · {clearWhy}" : "")</small>
                    </button>
                }
                @if (full && e.HasSurvey(LocationId))
                {
                    @* 遗迹勘整（Q55）：探索100%的四个旧遗迹的搜集训练，不产物；每地点每日2次 *@
                    var sv = e.SurveyRules;
                    var surveyWhy = busy ? BusyReason() : e.CanStart(s, ActionRequest.Survey());
                    <button @key="@("survey")" type="button" class="loc-btn" data-survey disabled="@(surveyWhy != null)" title="@(surveyWhy ?? "搜集练习：不产物、不消耗库存；单击直接开始，右侧显示预测")"
                            @onmouseenter="HoverSurvey" @onfocus="HoverSurvey" @onmouseleave="Unhover" @onblur="Unhover"
                            @onclick="Survey" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                        <strong>@sv.Name · @(sv.BaseMinutes)分钟</strong>
                        @* 1280 下小字会截断：今日次数放最前，“练习不产物”缩成“不产物”（B7b 试玩修复） *@
                        <small>今日@(e.SurveyDoneToday(s, LocationId))/@(sv.DailyPerActorNode)次 · 不产物@(surveyWhy != null && e.SurveyDoneToday(s, LocationId) < sv.DailyPerActorNode ? $" · {surveyWhy}" : "")</small>
                    </button>
                }
            </div>
        </div>
    </div>
}
else if (LockReason != null)
{
    @* B11（S03、EXP30-01）：已揭示、门槛未满足的路线：显示名称与原因，不能前往（不打开移动浮窗、不耗时） *@
    @* B22f2 试玩修复 M431：主目标下一段已知未开通（Q139 KnownBlocked）时内核焦点指向这张卡，与其他分支同一判断加 tut-lit *@
    var ldir = e.DirectionFromHere(s, LocationId);
    var lhint = GameEngine.DirectionHint(ldir);
    @* B32a（Q340、Q345）：重墨 V2 卡模板——副标方向与单程时间，第二行未开通原因；未开通为不可用 *@
    <ObjectCard Ink2="true" Id="@($"lock-{LocationId}")" CssClass="@($"k2-route locked{(G.TutorialFocus == "loc:" + LocationId ? " tut-lit" : "")}")" Title="@lc.Name" Badge="未开通" BadgeClass="unbuilt" Dim="true" Dashed="true"
                AriaLabel="@($"{lc.Name}，{(ldir == MapDirection.None ? "" : lhint + "，")}单程{LockMinutes}分钟，路线未开通：{LockReason}")" Tooltip="@($"路线未开通：{LockReason}")"
                SubTitle="@($"{(ldir == MapDirection.None ? "" : lhint + " · ")}单程{LockMinutes}分钟 · 未开通")">
        <Art>
            <div class="loc-art" style="background-image:url('@scene')" role="img" aria-label="@($"{lc.Name}图片")"></div>
        </Art>
        <SubContent>
            @if (ldir != MapDirection.None)
            {
                <span class="dir-mark" role="img" aria-label="@lhint" title="@($"{lhint}（方位图标，只作展示）")">
                    <svg viewBox="0 0 24 24" aria-hidden="true" style="transform:rotate(@(((int)ldir - 1) * 45)deg)"><path d="M12 2.5 19.5 11h-4.6v10.5H9.1V11H4.5Z" /></svg>
                </span>
            }
            <span class="k2-subtext">单程@(LockMinutes)分钟</span>
        </SubContent>
        <Line2><div class="oc-line warn-line lock-why" title="@LockReason">@LockReason</div></Line2>
    </ObjectCard>
}
else
{
    var edge = e.AdjacentUnlocked(s).FirstOrDefault(x => x.Other(s.CurrentLocation) == LocationId);
    var selected = sel.Kind == SelectionKind.Entrance && sel.Id == LocationId;
    // 相对方位徽标（S14 §16、S02 §3.1）：以主角当前所在地为参照，数据唯一来自内核 DirectionFromHere（区域图 mapX/mapY）；
    // 移动途中/暂停/取消仍按起点，到达后统一刷新。只是展示：不绑定方向键、点击无操作（不移动、不打开移动浮窗）。
    var dir = e.DirectionFromHere(s, LocationId);
    var dirHint = GameEngine.DirectionHint(dir);
    var open = G.Pop?.Kind == "travel" && G.Pop.Id == LocationId;
    @* B32a（Q340、Q345）：重墨 V2 卡模板——副标方向箭头与单程时间（室内/露天写在悬停），主操作「前往 ▸」仍在卡上；正在前往这里时为加工中 *@
    <ObjectCard Ink2="true" Id="@AnchorId" CssClass="@($"k2-route{(G.TutorialFocus == "loc:" + LocationId ? " tut-lit" : "")}")" Title="@lc.Name" Badge="@(ls.Visited ? "已访问" : "待访问")" BadgeClass="@(ls.Visited ? "" : "new")"
                Selected="selected" Fresh="@(edge != null && G.Highlights.Contains(edge.Id))" Busy="@CardStates.BusyRoute(s, LocationId)"
                AriaLabel="@($"{lc.Name}，{(dir == MapDirection.None ? "" : dirHint + "，")}单程{edge?.BaseMinutes ?? 0}分钟")"
                SubTitle="@($"{(dir == MapDirection.None ? "" : dirHint + " · ")}单程{edge?.BaseMinutes ?? 0}分钟 · {(lc.IsIndoor ? "室内" : "露天")}")"
                Tooltip="相邻地点：点击在卡旁查看移动预估并确认出发" OnClick="OpenTravel">
        <Art>
            <div class="loc-art" style="background-image:url('@scene')" role="img" aria-label="@($"{lc.Name}图片")"></div>
        </Art>
        <SubContent>
            @if (dir != MapDirection.None)
            {
                @* 试玩修复 B10：点方位图标不打开移动浮窗、不选中（阻止冒泡，无操作），S14 §16 *@
                <span class="dir-mark" role="img" aria-label="@dirHint" title="@($"{dirHint}（方位图标，只作展示，点它不会移动；移动请点“前往”）")"
                      @onclick:stopPropagation="true" @onclick:preventDefault="true">
                    <svg viewBox="0 0 24 24" aria-hidden="true" style="transform:rotate(@(((int)dir - 1) * 45)deg)"><path d="M12 2.5 19.5 11h-4.6v10.5H9.1V11H4.5Z" /></svg>
                </span>
            }
            <span class="k2-subtext">单程@(edge?.BaseMinutes ?? 0)分钟</span>
        </SubContent>
        <Footer>
            <button type="button" class="oc-btn @(open ? "on" : "")" aria-expanded="@open" title="在卡旁预览并确认移动"
                    @onclick="OpenTravel" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">前往 ▸</button>
        </Footer>
    </ObjectCard>
}

@code {
    [Parameter, EditorRequired] public string LocationId { get; set; } = "";
    [Parameter] public bool Current { get; set; }
    /// <summary>B11：已揭示但门槛未满足的相邻路线——显示原因，不能前往。</summary>
    [Parameter] public string? LockReason { get; set; }
    [Parameter] public int LockMinutes { get; set; }

    private bool starting;

    private string BusyReason() => G.S.Main?.Status == ActionStatus.Paused ? "行动暂停中" : "行动进行中";

    private void SelectLocation() => G.Select(new Selection { Kind = SelectionKind.Location, Id = LocationId });

    private void CardKey(KeyboardEventArgs ev)
    {
        if (ev.Key is "Enter" or " ") SelectLocation();
    }

    private static string F(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    // 夜空星点（固定位置，只在上半部天空）
    private static readonly (int x, int y, double r)[] Stars = BuildStars();

    private static (int, int, double)[] BuildStars()
    {
        var rng = new Random(7);
        return Enumerable.Range(0, 46).Select(_ => (rng.Next(20, 1180), rng.Next(20, 230), 1 + rng.NextDouble() * 1.6)).ToArray();
    }
    private string AnchorId => "loc-" + LocationId;

    /// <summary>点相邻卡或“前往”：选中路线（右栏可选详细预测），并在卡旁打开移动确认浮窗（S02 §5、S14 §14.1）；本身不移动、不扣资源。</summary>
    private void OpenTravel()
    {
        G.Select(new Selection { Kind = SelectionKind.Entrance, Id = LocationId });
        G.OpenPop("travel", LocationId, AnchorId);
    }

    private void HoverExplore() => G.Hover(ExploreReq, "探索周边");
    private void HoverClear() => G.Hover(ClearReq, G.E.ClearLabelAt(LocationId));
    private void HoverSurvey() => G.Hover(SurveyReq, G.E.SurveyRules.Name);
    private void Unhover() => G.Hover(null);

    // 同一个请求对象，悬停时右栏不必每次重算
    private static readonly ActionRequest ExploreReq = ActionRequest.Explore();
    private static readonly ActionRequest ClearReq = ActionRequest.Clear();
    private static readonly ActionRequest SurveyReq = ActionRequest.Survey();

    /// <summary>单击直接开始（玩法层再次校验）；请求发出后立即锁定，重复点击不排队。</summary>
    private async Task Explore() => await Go(ActionRequest.Explore(), SelectionKind.Location);
    private async Task Clear() => await Go(ActionRequest.Clear(), SelectionKind.Clear);
    private async Task Survey() => await Go(ActionRequest.Survey(), SelectionKind.Location);

    private async Task Go(ActionRequest r, SelectionKind kind)
    {
        if (starting || G.Running) return;
        starting = true;
        try
        {
            G.Hover(null);
            G.Select(new Selection { Kind = kind, Id = LocationId });
            await G.StartAction(r);
            // 最后一次探索完成、探索按钮移除时，选中态不继承给清理（01 案第 3 节，试玩修复 B4）
            if (kind == SelectionKind.Location && G.S.Locations[LocationId].Progress >= 100 && G.Selected.Kind == SelectionKind.Location)
                G.ClearSelection();
        }
        finally
        {
            starting = false;
        }
    }
}
