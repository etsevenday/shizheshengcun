@inherits GameComponent

@* 选中火堆时的右栏对象信息（v0.7 第 3.1 节：点击火堆主图只选中火堆并刷新右栏）：所在、燃烧状态、燃料、两个加工位的真实内容。
   这里只展示，不放执行按钮；投料、点火、熄灭在火堆卡底部。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var fac = s.Locations[here].Facility;
    var slots = e.FireSlots(s, here);
    var state = fac.FireLit ? "燃烧中" : fac.WentOut ? "熄灭" : "未点燃";
    var hot = e.FireHot(s, here);
}
<div class="detail-scroll">
    <div class="op-head">
        <div class="eyebrow">@e.LocName(here)／火堆</div>
        <h2>火堆 <small class="muted">@state</small></h2>
        <p>固定设施，不能拾取。燃烧且燃料至少够一段时，加工位里的锅与食材随世界时间自动受热，不占角色时间。</p>
    </div>
    <div class="detail-icon">@Icons.Markup(fac.FireLit ? "fire_lit" : "fire_out")</div>
    <div class="lines">
        <div><span>燃料</span><b>@(fac.FuelMinutes)/@(e.Config.Fire.MaxFuelMinutes)分钟</b></div>
        <div><span>每份木材</span><b>+@(e.Config.Fire.BurnMinutesPerWood)分钟</b></div>
        <div><span>加工位</span><b>@slots.Count(x => x != null)/@slots.Count</b></div>
        <div><span>本段受热</span><b class="@(hot ? "" : "warn-text")">@(hot ? "可以" : "火堆未燃烧，加工暂停")</b></div>
    </div>
    <div class="outputs">
        @for (var k = 0; k < slots.Count; k++)
        {
            var it = slots[k];
            if (it == null)
            {
                <ItemRow Icon="slot_empty" Name="@($"加工位{k + 1}")" Status="空位 · 拖入金属锅或生块根" />
            }
            else
            {
                <ItemRow Icon="@it.ItemId" Name="@($"{e.ItemName(it.ItemId)}#{it.InstanceId}")" Qty="@($"加工位{k + 1}")"
                         Status="@(e.IsPot(it) ? $"{e.PotLabel(s, it)} · 食材{e.PotFood(s, it.InstanceId).Count}/{e.PotConfig(it).FoodSlots} · {e.ContentStatus(s, it)}" : e.ContentStatus(s, it))" />
            }
        }
    </div>
    @if (!fac.FireLit)
    {
        <div class="risk none">点火：把打火器拖到火堆直接开始，或点火堆卡下方“点燃”选一把打火器；耗时@(e.Config.Fire.IgniteMinutes)分钟，打火器不消耗。</div>
    }
    @if (G.Notice != null) { <div class="notice">@G.Notice</div> }
</div>
