@inherits GameComponent

@* 选中火堆／柴炉时的右栏火堆详情（P02a）。B32b（逐字稿 §1.2 Q339 选 C、Q343 A）：
   层级路径「{火堆名}」；「剩余燃料」；固定两行「加工位1」「加工位2」——空位写「空位」，有内容时用真实物品名、工序与状态；
   工位和锅内容的执行入口与合法落点在这里（Q323 的局部例外）：空位是 fireslot: 落点，锅行沿锅卡的拖拽把手、取到随身箭头与装水／食材落点，
   直烤与煅烧行沿原取到随身箭头；点锅、水或食材行选中该对象，操作在原选卡盘里。第一处可用空位的行有「煅烧木炭」（打开居中投料盘）。
   「木炭工位」是煅烧规则说明行，真实占用仍是两位之一。实际受热的加工位行挂加工中（Q362）；成品落在可见加工位时亮该行一次（Q368）。
   燃料、点燃／熄灭、等待加工仍在火堆卡上。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.Ground;
    var fac = e.FacOf(s, here)!;
    var slots = e.FireSlots(s, here);
    var state = CardStates.FireStateText(fac);
    var hot = e.FireHot(s, here);
    var charcoal = G.CharcoalPreview();
    var charcoalOpen = G.Pop is { Kind: "charcoal" };
    var firstEmpty = slots.FindIndex(x => x == null);
}
<div class="detail-scroll fire-detail">
    <FireCrumbs Path="@e.FireCrumbs(s, null)" />
    <div class="op-head">
        <div class="eyebrow">@e.LocName(here)</div>
        <h2>@CardStates.FireName(fac) <small class="muted">@state</small></h2>
        <p>固定设施，不能拾取。燃烧且燃料至少够一段时，加工位里的锅与食材随世界时间自动受热，不占角色时间。</p>
    </div>
    <div class="lines">
        <div><span>剩余燃料</span><b>@(fac.FuelMinutes)/@(e.FuelCapOf(fac))分钟</b></div>
        <div><span>每份木材</span><b>+@(e.Config.Fire.BurnMinutesPerWood)分钟</b></div>
        <div><span>本段受热</span><b class="@(hot ? "" : "warn-text")">@(hot ? "可以" : "火堆未燃烧，加工暂停")</b></div>
    </div>
    <div class="fire-slots">
        @for (var k = 0; k < slots.Count; k++)
        {
            var it = slots[k];
            var slotName = CardStates.FireSlotName(k);
            var lit = G.Highlights.Contains(GameEngine.FireSlotHighlight(here, k));
            var heating = e.FireSlotHeating(s, here, k);
            if (it == null)
            {
                <div @key="@("empty" + k)" class="fire-slot empty @(lit ? "fresh" : "")" data-drop="@($"fireslot:{here}")" data-drop-level="hot"
                     title="空加工位：拖入锅（最多1口）或生块根（每份占1位）">
                    <div class="fs-head"><b>@slotName</b><span class="muted">空位</span></div>
                    @if (k == firstEmpty && charcoal.InputCount > 0)
                    {
                        @* Q111／Q339：只在第一处可用空位出现（投料进的就是这一位）；点开居中投料盘确认，按钮本身不投料 *@
                        <button type="button" id="fc-charcoal" class="secondary slot-charcoal @(charcoalOpen ? "on" : "")" aria-haspopup="dialog" aria-expanded="@charcoalOpen"
                                title="@($"煅烧木炭：{e.CharcoalRuleText()}。点开看原料来源与燃料，确认后投料{(charcoal.Ok ? "" : "（现在不能：" + charcoal.Reason + "）")}")" @onclick="ToggleCharcoal">煅烧木炭</button>
                    }
                </div>
            }
            else
            {
                <div @key="it.InstanceId" class="fire-slot @(e.IsPot(it) ? "pot" : "food") @(heating ? "st-busy" : "") @(lit ? "fresh" : "")">
                    <div class="fs-head"><b>@slotName</b><span class="muted">@SlotState(it)</span></div>
                    @if (e.IsPot(it))
                    {
                        <PotCard Pot="it" />
                    }
                    else
                    {
                        <FoodCard Item="it" Slot="@(k + 1)" />
                    }
                </div>
            }
        }
    </div>
    @if (e.CharcoalProcess != null)
    {
        <div class="lines">
            <div><span>@CardStates.CharcoalRuleTitle</span><b>@e.CharcoalRuleText()</b></div>
        </div>
        <div class="risk @(charcoal.FuelWoodShort > 0 ? "" : "none")">煅烧燃料：@charcoal.FuelNote。拖木材到火堆仍是添加燃料；煅烧要点空加工位的“煅烧木炭”投一批。</div>
    }
    @if (!fac.FireLit)
    {
        <div class="risk none">点火：把打火器拖到火堆直接开始，或点火堆卡上的“点燃”选一把打火器再点火；耗时@(e.Config.Fire.IgniteMinutes)分钟，打火器不消耗。</div>
    }
    @if (G.RightNotice != null) { <div class="notice">@G.RightNotice</div> }
</div>

@code {
    /// <summary>加工位行的状态短句（沿原右栏火堆详情：锅为水量、食材数与加工状态，其余为加工状态）。</summary>
    private string SlotState(ItemInstance it)
    {
        var s = G.S;
        var e = G.E;
        return e.IsPot(it) ? $"{e.PotLabel(s, it)} · 食材{e.PotFood(s, it.InstanceId).Count}/{e.PotConfig(it).FoodSlots} · {e.ContentStatus(s, it)}" : e.ContentStatus(s, it);
    }

    private void ToggleCharcoal()
    {
        if (G.Pop is { Kind: "charcoal" }) G.ClosePop();
        else G.OpenPop("charcoal", G.S.Ground, "fc-charcoal");
    }
}
