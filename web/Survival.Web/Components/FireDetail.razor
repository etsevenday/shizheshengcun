@inherits GameComponent

@* 选中火堆／柴炉时的右栏火堆详情（P02a）。B32b（逐字稿 §1.2 Q339 选 C、Q343 A）：
   层级路径「{火堆名}」；「剩余燃料」；固定两行「加工位1」「加工位2」——空位写「空位」，有内容时用真实物品名、工序与状态；
   工位和锅内容的执行入口与合法落点在这里（Q323 的局部例外）：空位是 fireslot: 落点，锅行沿锅卡的拖拽把手、取到随身箭头与装水／食材落点，
   直烤与煅烧行沿原取到随身箭头；点锅、水或食材行选中该对象，操作在原选卡盘里。第一处可用空位的行有「煅烧木炭」（打开居中投料盘）。
   「木炭工位」是煅烧规则说明行，真实占用仍是两位之一。实际受热的加工位行挂加工中（Q362）；成品落在可见加工位时亮该行一次（Q368）。
   燃料、点燃／熄灭、等待加工仍在火堆卡上。
   B45（S14「设施加工改在中央次级菜单操作」第 3 条、Q548）：本详情只读——移除空位落点、「煅烧木炭」入口、锅卡与直烤食材的拖拽把手、落点与取到随身箭头；
   工位与锅、水、食材的执行全部在点击火堆／柴炉卡打开的中央加工菜单里。这里点锅、水或食材只换右栏显示（只读层级），不开操作盘、不改中央菜单。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.Ground;
    var fac = e.FacOf(s, here)!;
    var slots = e.FireSlots(s, here);
    var state = CardStates.FireStateText(fac);
    var hot = e.FireHot(s, here);
    var charcoal = G.CharcoalPreview();
}
@* BM4b（S14 Q589「锅／设施／加工」）：紧凑表头（缩略图＋名称与状态＋真实位置）→ 燃料、受热与两工位内容摘要 → 当前风险 → 次要组（说明、内容）。
   根层不再在名称上方重复同名路径（Q587 同理）；进入锅、水或食材后的层级路径仍在 SelectionDetail。执行入口仍在中央加工菜单。 *@
@{
    var placeLine = e.LocName(s.CurrentLocation) + (s.CurrentZone == GameState.SafehouseZone ? " · 屋内" : e.SafehouseBuilt(s, s.CurrentLocation) ? " · 屋外" : "");
    var filled = slots.Count(x => x != null);
    var crumbs = e.FireCrumbs(s, null);
}
<div class="detail-scroll fire-detail rail-page" data-rail-type="@RailTypes.Facility">
    @if (crumbs.Count > 1) { <FireCrumbs Path="@crumbs" /> }
    <RailHead Source="@placeLine">
        <Thumb>@Icons.Markup(fac.FireLit ? "fire_lit" : "fire_out")</Thumb>
        <Name>@CardStates.FireName(fac) <small class="muted">@state</small></Name>
    </RailHead>
    <div class="lines rail-main">
        <div><span>剩余燃料</span><b>@(fac.FuelMinutes)/@(e.FuelCapOf(fac))分钟</b></div>
        <div><span>本段受热</span><b class="@(hot ? "" : "warn-text")">@(hot ? "可以" : "火堆未燃烧，加工暂停")</b></div>
        @for (var k = 0; k < slots.Count; k++)
        {
            var it = slots[k];
            <div class="fire-sum @(e.FireSlotHeating(s, here, k) ? "st-busy" : "") @(G.Highlights.Contains(GameEngine.FireSlotHighlight(here, k)) ? "fresh" : "") @(it != null && SlotState(it).Length > 12 ? "wide" : "")"><span>@CardStates.FireSlotName(k)</span><b>@Ui.KeepUnits(it == null ? "空位" : $"{e.ItemName(it.ItemId)} · {SlotState(it)}")</b></div>
        }
    </div>
    @if (G.RightNotice != null) { <div class="notice">@G.RightNotice</div> }

    <RailFold Type="@RailTypes.Facility" Group="@RailGroups.Desc" Name="@RailText.Desc">
        <p class="rail-text">固定设施，不能拾取。燃烧且燃料至少够一段时，加工位里的锅与食材随世界时间自动受热，不占角色时间。</p>
        <div class="lines">
            <div><span>每份木材</span><b>+@(e.Config.Fire.BurnMinutesPerWood)分钟</b></div>
            @if (e.CharcoalProcess != null)
            {
                <div class="wide"><span>@CardStates.CharcoalRuleTitle</span><b>@e.CharcoalRuleText()</b></div>
            }
        </div>
        @if (e.CharcoalProcess != null)
        {
            @* 煅烧燃料是下一批煅烧的配方规则（不是正在进行的加工），归长规则；不足时仍按原样式标出 *@
            <div class="risk @(charcoal.FuelWoodShort > 0 ? "" : "none")">煅烧燃料：@charcoal.FuelNote。拖木材到火堆仍是添加燃料；点击火堆或柴炉卡，在加工菜单的空加工位点「煅烧木炭」投一批。</div>
        }
        @if (!fac.FireLit)
        {
            <div class="rail-text">点火：把打火器拖到火堆直接开始，或点火堆卡上的“点燃”选一把打火器再点火；耗时@(e.Config.Fire.IgniteMinutes)分钟，打火器不消耗。</div>
        }
    </RailFold>
    @if (filled > 0)
    {
        <RailFold Type="@RailTypes.Facility" Group="@RailGroups.Content" Name="@RailText.Content" Count="@filled">
            <div class="fire-slots">
                @for (var k = 0; k < slots.Count; k++)
                {
                    var it = slots[k];
                    var slotName = CardStates.FireSlotName(k);
                    var lit = G.Highlights.Contains(GameEngine.FireSlotHighlight(here, k));
                    var heating = e.FireSlotHeating(s, here, k);
                    if (it == null) continue;
                    <div @key="it.InstanceId" class="fire-slot @(e.IsPot(it) ? "pot" : "food") @(heating ? "st-busy" : "") @(lit ? "fresh" : "")">
                        <div class="fs-head"><b>@slotName</b><span class="muted">@SlotState(it)</span></div>
                        @if (e.IsPot(it))
                        {
                            <PotCard Pot="it" ReadOnly="true" />
                        }
                        else
                        {
                            <FoodCard Item="it" Slot="@(k + 1)" ReadOnly="true" />
                        }
                    </div>
                }
            </div>
        </RailFold>
    }
</div>

@code {
    /// <summary>加工位行的状态短句（内核 FireSlotStatus：锅为水量、食材数与加工状态，其余为加工状态；煅烧批写「煅烧木炭 · 」，Q343）。</summary>
    private string SlotState(ItemInstance it) => G.E.FireSlotStatus(G.S, it);
}
