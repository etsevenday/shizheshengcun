@inherits GameComponent

@* 城市岗位“事项”面板（开发计划 v0.9 B14，A11「Q33 城市岗位完整服务表」、narrative-texts serviceOfferLines）：
   列出该岗位名下全部事项的实时预览（工时、费用、效果、现在能否办），需要目标的选一名当前同行者，施济另选一项；
   预览与浏览 0 分钟、不提交。B14b（Q146 选 B）：未实装的事项不列出；已实装但条件不足的照常列出并写真实原因。
   名称与摘要用策划正式名（Q145 选 B）。
   B18：鉴定所“活性样本鉴定”换成专用的鉴定交易面板（AppraisalPanel）。B19：收容所“同行者名册”换成周期招募面板（RecruitPanel）。
   B39（N02 附录 §1 Q308、Q309）：受阻按钮用 GateButton——保持禁用语义、键盘可定位，读屏名「{按钮名}，不可用：{原因}」，
   轻点或 Enter／空格在原反馈位显示实时原因（按钮旁的原因句照旧）。
   Q317（N02 附录 §2）：盘内实际阻断原因为当前行动占用时，接取、委托工作、普通服务与鉴定所、收容所子盘统一写 GameEngine.CityBusyText，
   按钮旁、读屏名与触发受阻后的反馈位同句；暂停、对白、敌踪等其他原因沿原句与原优先级。
   B15：顶部列这名岗位名下的主线与委托（接取、阅读/核对、回看、AC02 外部医疗线索）；任务类服务（整理调查记录、CH02/AC01/AC02）照常在下面办理。 *@
@{
    var s = G.S;
    var e = G.E;
    var npcId = G.CityNpcId ?? "";
    var npc = e.CityNpc(npcId);
    var services = e.CityServicesOf(s, npcId);
    var quests = e.CityPanelQuests(s, npcId);   // Q317：接取与工作按钮的行动占用原因用事项盘统一句
    var absent = npc != null && s.City.Absent.Contains(npcId);
}

<div class="sub-panel city-panel" role="dialog" aria-label="事项">
    <div class="sub-head">
        <div>
            <h2>@(absent ? "机构当班接续员" : npc?.Name ?? "事项")</h2>
            <span class="sub">@(npc == null ? "" : $"{e.FactionName(npc.FactionId)} · {(absent ? "代" : "")}{npc.Role}") · 查看不耗时</span>
        </div>
        <button class="secondary" @onclick="Close">@G.PanelCloseLabel<EscCap On="@(G.EscOwner == EscOwner.Panel)" /></button>
    </div>
    <div class="sub-body city-body" data-wheel="y">
        @if (npc != null)
        {
            <p class="city-offer"><b>@(absent ? "机构当班接续员" : npc.Name)：</b>@e.CityOfferLine(npcId)</p>
        }
        @* B15：这名岗位名下的主线与委托（正式名、状态、下一步；接取与交谈同效，0 分钟；完成后可回看，不重发奖励） *@
        @foreach (var q in quests)
        {
            var qid = q.Id;
            var qbusy = G.Running ? GameEngine.CityBusyText : null;
            var qkey = Peek.Card("city-q-" + qid);
            var qstate = $"{q.KindLabel} · {q.StatusText}{(q.ChoiceLabel != null ? $" · {q.ChoiceLabel}" : "")}{(q.Retro ? " · 旧档追认" : "")}";
            <section class="city-svc city-quest @(q.Status)" data-peek="@qkey">
                <h3>@q.Title <small>@qstate</small></h3>
                @QuestLines(q)
                @* B42：悬停事项时右栏显示同一事项的原公开内容（只读，不含接取／工作等按钮） *@
                <PeekSource Key="@qkey" Title="@q.Title" State="@qstate" Body="@QuestLines(q)" />
                <div class="btn-row">
                    @if (q.AcceptHere)
                    {
                        var why = q.AcceptBlocked ?? qbusy;
                        <GateButton Class="primary" Name="接取（0分钟）" Blocked="@why" Title="接取（0分钟，与交谈同效）" OnClick="() => G.AcceptQuest(qid)">接取（0分钟）</GateButton>
                        @if (why != null) { <span class="muted small">@why</span> }
                    }
                    @if (q.WorkLabel != null)
                    {
                        var why = q.WorkBlocked ?? qbusy;
                        <GateButton Class="primary" Name="@q.WorkLabel" Blocked="@why" Title="@q.WorkLabel" OnClick="() => QuestWork(qid)">@q.WorkLabel</GateButton>
                        @if (why != null) { <span class="muted small">@why</span> }
                    }
                    @if (q.CanReview)
                    {
                        <button class="secondary" title="回看对白（0分钟，不重发奖励）" @onclick="() => G.ReviewQuest(qid)">回看</button>
                    }
                    @if (q.HasNote)
                    {
                        <button class="secondary" title="回看外部医疗线索（0分钟）" @onclick="() => G.ReviewQuest(qid, true)">外部医疗线索</button>
                    }
                </div>
            </section>
        }
        @foreach (var v in services.Where(x => e.IsAppraisalService(x.Id)))
        {
            @* B18：鉴定所三项在专用面板里分页办理（R07 X3.6） *@
            <AppraisalPanel Title="@v.Title" NpcLine="@v.NpcLine" />
        }
        @foreach (var v in services.Where(x => e.IsRecruitService(x.Id)))
        {
            @* B19：收容所周期候选与退役在专用面板里办理（R08 RC3/RC4） *@
            <RecruitPanel Title="@v.Title" NpcLine="@v.NpcLine" />
        }
        @foreach (var v in services.Where(x => !e.IsAppraisalService(x.Id) && !e.IsRecruitService(x.Id)))
        {
            var id = v.Id;
            var pickTarget = PickedTarget(v);
            var pickChoice = PickedChoice(v);
            var t = v.Targets.FirstOrDefault(x => x.ActorId == pickTarget);
            var c = v.Choices.FirstOrDefault(x => x.Id == pickChoice);
            var why = v.Blocked ?? (v.NeedsTarget && t?.Blocked != null ? t.BlockedLine ?? $"{t.Name}：{t.Blocked}" : null)
                      ?? (v.Choices.Count > 0 && c == null ? "先选一项。" : null)
                      ?? c?.Blocked
                      ?? (G.Running ? GameEngine.CityBusyText : null);
            @* B38b（N02 附录 §2、Q285 选 A）：服务名下依次为岗位短句、对象与选项、耗时与费用、完成结果（EffectText，缺失时才用 Summary，只出现一次）、
               实际限制与原确认区；普通按钮“{服务名}（{工时}）”，打开类沿原动词 *@
            var skey = Peek.Card("city-s-" + id);
            <section class="city-svc @(v.Implemented ? "" : "pending")" data-peek="@skey">
                <h3>@v.Title</h3>
                <PeekSource Key="@skey" Title="@v.Title" Body="@SvcLines(v)" />
                @if (!string.IsNullOrEmpty(v.NpcLine)) { <p class="city-line">“@v.NpcLine”</p> }
                @if (v.NeedsTarget && v.Implemented)
                {
                    <div class="city-targets">
                        @foreach (var x in v.Targets)
                        {
                            var aid = x.ActorId;
                            <label class="@(x.Blocked != null ? "muted" : "")" title="@(x.Blocked ?? x.Detail)">
                                <input type="radio" name="@($"tgt-{id}")" checked="@(aid == pickTarget)" @onchange="() => SetTarget(id, aid)" />
                                <b>@x.Name</b> <span class="small">@x.Detail</span>
                                @if (x.Blocked != null) { <em class="warn-text small">（@x.Blocked）</em> }
                            </label>
                        }
                    </div>
                }
                @if (v.Choices.Count > 0 && v.Implemented)
                {
                    <div class="btn-row">
                        @foreach (var ch in v.Choices)
                        {
                            var cid = ch.Id;
                            @* B23：公开抄录完全已知的资料包禁用（灰色，原因写在悬停与按钮下） *@
                            <GateButton Class="@($"{(cid == pickChoice ? "primary" : "secondary")} {(ch.Blocked != null ? "btn-off" : "")}")" Name="@ch.Label" Blocked="@ch.Blocked"
                                        Title="@ch.Label" data-choice="@cid" OnClick="() => SetChoice(id, cid)">@ch.Label</GateButton>
                        }
                    </div>
                    @foreach (var ch in v.Choices.Where(x => x.Blocked != null)) { <p class="muted small">@ch.Label：@ch.Blocked</p> }
                }
                @SvcFacts(v)
                <div class="btn-row">
                    @{ var startLabel = v.StartLabel ?? (v.OpensCraft ? "打开制作" : $"{v.Title}（{v.TimeText}）"); }
                    <GateButton Class="primary" Name="@startLabel" Blocked="@why" Title="@($"办理：{v.Title}")" OnClick="() => Do(id, pickTarget, pickChoice)">
                        @startLabel
                    </GateButton>
                    @if (why != null) { <span class="muted small">@why</span> }
                </div>
            </section>
        }
    </div>
</div>

@code {
    /// <summary>事项条目的原说明行（盘内与 B42 右栏悬停共用同一片段）。</summary>
    private RenderFragment QuestLines(QuestView q) => __builder =>
    {
        <p class="city-summary">@(q.Status == "done" ? "结果：" : "下一步：")@q.Step</p>
        @if (!string.IsNullOrEmpty(q.WorkHint)) { <p class="small muted">@q.WorkHint</p> }
        @if (q.Status == "locked" && q.AcceptBlocked != null) { <p class="small muted">@q.AcceptBlocked</p> }
    };

    /// <summary>服务的耗时费用、完成结果与限制行（盘内与右栏共用）。</summary>
    private RenderFragment SvcFacts(CityServiceView v) => __builder =>
    {
        <p class="small city-cost">@v.TimeText · @v.CostText</p>
        <p class="small city-effect">@(string.IsNullOrEmpty(v.EffectText) ? v.Summary : v.EffectText)</p>
        @foreach (var line in v.Lines) { <p class="small city-line-extra">@line</p> }
    };

    /// <summary>B42 右栏：岗位短句 + 原说明行；对象、选项与办理按钮不进右栏（只读）。</summary>
    private RenderFragment SvcLines(CityServiceView v) => __builder =>
    {
        @if (!string.IsNullOrEmpty(v.NpcLine)) { <p class="city-line">“@v.NpcLine”</p> }
        @SvcFacts(v)
    };

    private readonly Dictionary<string, string> _target = new();
    private readonly Dictionary<string, string> _choice = new();

    private string PickedTarget(CityServiceView v) =>
        _target.TryGetValue(v.Id, out var t) && v.Targets.Any(x => x.ActorId == t) ? t
        : v.Targets.FirstOrDefault(x => x.Blocked == null)?.ActorId ?? v.Targets.FirstOrDefault()?.ActorId ?? "";

    private string? PickedChoice(CityServiceView v) => _choice.TryGetValue(v.Id, out var c) && v.Choices.Any(x => x.Id == c) ? c
        : v.Choices.Count(x => x.Blocked == null) == 1 && v.Choices.Count == 1 ? v.Choices[0].Id : null;   // B23：只有一项可选（h04 物资登记资料）时直接选中

    private void SetTarget(string svc, string actor) { _target[svc] = actor; StateHasChanged(); }

    private void SetChoice(string svc, string choice) { _choice[svc] = choice; StateHasChanged(); }

    private void Close() => G.OpenPanel(null);

    private async Task Do(string svc, string target, string? choice) => await G.StartCityService(svc, string.IsNullOrEmpty(target) ? null : target, choice);

    private async Task QuestWork(string questId)
    {
        // 同行邀约（选择登记）走接取；其余为委托工作
        if (G.E.Quest(questId)?.Accept == "roster") G.AcceptQuest(questId);
        else await G.StartQuestWork(questId);
    }
}
