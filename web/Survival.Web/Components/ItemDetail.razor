@inherits GameComponent

@{
    var s = G.S;
    var e = G.E;
    var sel = G.Selected;
    var cfg = e.Item(sel.Id);
    var here = s.CurrentLocation;
    var carried = sel.Owner == ItemInstance.Carried;
    // 设施与锅里的物品按根位置判断：仍在随身或当前地点（含当前火堆与锅）才可操作
    var probe = s.Items.FirstOrDefault(i => i.Owner == sel.Owner);
    var stillThere = probe != null && (e.PlaceOf(s, probe) == ItemInstance.Carried || e.PlaceOf(s, probe) == here);
    // 锅里的液体按锅与液体种类选中（InstanceId 是锅），其余按真实实例或同区同物品
    var potLiquid = sel.Kind == SelectionKind.PotLiquid;
    var list = s.Items.Where(i => i.Owner == sel.Owner && i.ItemId == sel.Id && (potLiquid || sel.InstanceId == null || i.InstanceId == sel.InstanceId))
        .OrderBy(i => i.ExpiresAt ?? int.MaxValue).ThenBy(i => i.InstanceId).ToList();
    // Q24：同区同物品按真实批次（到期 + 来源 + 预留状态）列出，所选批次与卡下操作窗共用会话里的 SelectedBatchKey，真正作用于食用与转移
    var group = sel.Kind == SelectionKind.ItemGroup;
    var batches = group
        ? e.BatchesOf(s, sel.Owner, sel.Id).Select(b => new Batch(b.Key, b.ExpiresAt, b.Count, b.Reserved, b.Stacks)).ToList()
        : list.GroupBy(i => i.ExpiresAt).Select(g => new Batch(g.Key?.ToString() ?? "-", g.Key, g.Sum(i => i.Count), g.Any(i => i.ReservedBy != null), g.ToList())).ToList();
    var busy = e.IsBusy(s) || G.Running;
}

@if (!stillThere || list.Count == 0)
{
    <div class="empty-detail">这件物品已不在此处。<br />选择地点、路线、资源或物品查看操作</div>
}
else
{
    var groupKey = group ? G.CurrentBatch(sel.Owner, sel.Id)?.Key : null;
    var chosen = (group ? batches.FirstOrDefault(b => b.Key == groupKey) : batches.FirstOrDefault(b => b.Key == batchKey && batchPicked))
                 ?? batches.FirstOrDefault(b => !b.Reserved && !Spoiled(b)) ?? batches[0];
    var inst = chosen.Stacks.FirstOrDefault(i => i.ReservedBy == null) ?? chosen.Stacks[0];
    var spoiled = Spoiled(chosen);
    var total = batches.Sum(b => b.Count);

    <div class="detail-scroll">
        <div class="op-head">
            <div class="eyebrow">@(carried ? "随身物品" : e.WherePath(s, inst))</div>
            @* 工具、锅等单件实例与卡下操作条同样写“名称#实例”；可自用物品的摘要用内核的“饱食+35”写法，与卡片、操作条一致（试玩修复 B9） *@
            @if (!cfg.IsStackable || sel.Kind == SelectionKind.Tool && sel.InstanceId.HasValue && !potLiquid)
            {
                <h2>@cfg.Name#@inst.InstanceId@if (cfg.IsEquipment) { <small class="qtag q-@(inst.Quality ?? "white")">@e.QualityName(inst)</small> }</h2>
            }
            else
            {
                <h2>@cfg.Name <small class="muted">×@total</small></h2>
            }
            <p>@(cfg.Use != null && cfg.Use.IsMedicine ? (cfg.Use.IsBandage ? "药品：止血、回血、压低病毒（本次实际效果见下）" : cfg.Use.IsAntibiotic ? "药品：抑制病毒（本次实际效果见下）" : "药品：清除感染（本次实际效果见下）")
                 : cfg.Use != null ? GameEngine.UseEffectText(cfg.Use) + (e.UseRiskText(cfg) is string rk ? $"；{rk}" : "") : cfg.Desc)</p>
        </div>
        <div class="detail-icon">@Icons.Markup(cfg.Id)</div>

        <div class="lines">
            @* Q35：紧凑模式卡面不常驻的火堆加工位编号，选中详情写等价全文 *@
            @if (Ui.FireSlotNo(e, s, inst) is int slotNo)
            {
                <div><span>所在加工位</span><b>@($"{e.WherePath(s, inst)}／加工位{slotNo}")</b></div>
            }
            <div><span>单件重量</span><b>@Ui.Kg(cfg.WeightGrams)公斤</b></div>
            <div><span>合计重量</span><b>@Ui.Kg(list.Sum(i => e.ItemGrams(s, i)))公斤@(e.IsPot(inst) ? "（含锅内）" : "")</b></div>
            @if (inst.MaxDurability.HasValue && inst.Durability.HasValue)
            {
                <div><span>耐久</span><b class="@(inst.Durability <= 0 ? "danger-text" : "")">@(inst.Durability <= 0 ? "已损坏" : GameEngine.DurabilityText(inst))</b></div>
                <div><span>成色</span><b>@Ui.Pct(GameEngine.Condition(inst))</b></div>
                @if (cfg.DurabilityMaxRange is double[] range)
                {
                    @* M120：带“耐用”词条的本件 = 区间内抽定 × 1.15，写明，避免看起来超出区间 *@
                    var durableMul = (inst.Affixes ?? new List<string>()).Select(e.Affix).Where(a => a != null).SelectMany(a => a!.Effects).Where(x => x.Key == "durability.max").Select(x => x.Value).FirstOrDefault();
                    <div><span>最大耐久区间</span><b>@Ui.T(range[0])—@Ui.T(range[1])@(durableMul > 0 ? $"，耐用×{Ui.T(durableMul)}后本件{Ui.N(inst.MaxDurability.Value)}（生成时抽定）" : $"（本件{Ui.N(inst.MaxDurability.Value)}，生成时抽定）")</b></div>
                }
            }
            @if (e.Weapon(cfg.Id) is WeaponConfig { CanAttack: false } lw)
            {
                @* B7：指挥、医疗器具不能直接攻击，只提供本门技能（技能体力按本件基础体力换算） *@
                <div><span>技能器具</span><b>不能直接攻击；提供@(Survival.Core.State.WeaponKinds.Name(lw.WeaponKind))技能 · 基础体力@(Ui.T(lw.EnergyCost))/次（技能按“本件÷该类基准”换算）</b></div>
            }
            else if (e.Weapon(cfg.Id) is WeaponConfig wp)
            {
                <div><span>武器</span><b>@(wp.SkillId == "" ? "（无对应熟练度）" : e.SkillName(wp.SkillId)) · 伤害@(Ui.N(wp.DamageMin))—@(Ui.N(wp.DamageMax)) · 命中能力@(Ui.T(wp.AccuracyRating)) · 暴击能力@(Ui.T(wp.CritRatingBase))</b></div>
                <div><span>攻击范围</span><b>@($"我方{GameEngine.PosList(GameEngine.OwnPositionsOf(wp))}→敌方{GameEngine.PosList(GameEngine.TargetPositionsOf(wp))}")@(wp.UsesMagazine ? $" · 弹仓{inst.LoadedAmmo}/{wp.MagazineCapacity}（{e.ItemName(wp.AmmoId!)}）" : wp.ConsumesLooseAmmo ? $" · 每射消耗随身{e.ItemName(wp.AmmoId!)}1" : "")</b></div>
                <div><span>基础体力</span><b>@Ui.T(wp.EnergyCost)/次（按熟练度折减）</b></div>
            }
            @* B4（A05 §1、§2、§4、§5；开发计划 v0.9 B4 H10）：品质、附加词条、阶、速度、站位、固定特性/效果、生效情况与拆解产出 *@
            @foreach (var (label, value) in e.EquipDetailLines(s, inst))
            {
                <div class="@(label == "品质" ? "q-" + (inst.Quality ?? "white") : "")"><span>@label</span><b>@value</b></div>
            }
            @if (cfg.ShelfLifeMinutes.HasValue)
            {
                <div><span>保质期</span><b>@(cfg.ShelfLifeMinutes / 60)小时</b></div>
            }
        </div>

        @* v0.7 第 7 节：右栏只保留详情、预测与说明；自用、倒出、取出、放入火堆都在被选中卡片（或锅内那一行）的下方操作条里 *@
        @if (e.IsPot(inst))
        {
            var pc = e.PotConfig(inst);
            var liquids = e.PotLiquids(s, inst.InstanceId);
            var foods = e.PotFood(s, inst.InstanceId);
            var free = e.PotFreeWaterUnits(s, inst);
            <div class="pot-detail">
                <div class="lines">
                    <div><span>水量</span><b>@e.PotLabel(s, inst)</b></div>
                    <div><span>食材位</span><b>@foods.Count/@pc.FoodSlots</b></div>
                    <div><span>状态</span><b>@e.ContentStatus(s, inst)</b></div>
                </div>
                @if (liquids.Count == 0 && foods.Count == 0)
                {
                    <div class="tiny muted">空锅。净水或脏水卡拖到锅的水量条装入（每份@(pc.UnitMl)毫升，同一锅只装一种水）；生块根拖到锅的食材区（@(pc.FoodSlots)个食材位）。</div>
                }
                @foreach (var c in liquids)
                {
                    var lockedWhy = free < 1 ? e.ReservedWaterText(s, c) : null;
                    <ItemRow Icon="@c.ItemId" Name="@e.ItemName(c.ItemId)" Qty="@($"×{c.Count}")" Status="@($"{c.Count * pc.UnitMl}毫升{(lockedWhy != null ? " · " + lockedWhy : "")}")" />
                }
                @foreach (var f in foods)
                {
                    <ItemRow Icon="@f.ItemId" Name="@($"{e.ItemName(f.ItemId)}#{f.InstanceId}")" Qty="×1" Status="@e.ContentStatus(s, f)" />
                }
                @if (inst.InFacility)
                {
                    <div class="risk none">取下这口锅：@e.TakeOutConsequenceOf(s, inst).Text</div>
                }
                @if (e.IsLocked(s, inst)) { <div class="risk none">行动占用：这口锅正被当前行动使用，不能移动、取水或加水。</div> }
            </div>
        }
        else if (inst.InFacility || inst.InContainer)
        {
            <div class="pot-detail">
                <div class="lines"><div><span>加工</span><b>@(inst.InContainer && e.IsLiquid(inst) ? e.ContentStatus(s, e.ContainerOf(s, inst) ?? inst) : e.ContentStatus(s, inst))</b></div></div>
                @if (!e.IsLiquid(inst)) { <div class="risk none">取出：@e.TakeOutConsequenceOf(s, inst).Text</div> }
                @if (cfg.Use != null && e.UseCookNote(s, inst) is string cookNote) { <div class="risk none">直接@(GameEngine.UseVerb(cfg))：@cookNote</div> }
            </div>
        }

        @if (batches.Count > 1 || cfg.ShelfLifeMinutes.HasValue)
        {
            <div>
                <div class="tiny muted" style="margin-bottom:5px">@(group ? (GameEngine.CanSelfUse(cfg) ? "批次（默认最早到期的有效批次；点选后食用、转移都用所选这一批）" : "批次（默认最早到期的有效批次；点选后转移用所选这一批）") : "批次（默认先用最早到期的有效批次）")</div>
                @foreach (var b in batches)
                {
                    var key = b.Key;
                    <button class="batch @(b == chosen ? "on" : "")" @onclick="() => PickBatch(key, group)">
                        <span>×@b.Count@(b.Reserved ? " · 预留" : "")</span>
                        @* 试玩修复 M77-B9：受本次烹饪保护的食材不显示普通倒计时，写“受热保护中（原期限N小时）” *@
                        <span class="@(Spoiled(b) ? "danger-text" : "muted")">@(!b.ExpiresAt.HasValue ? "不会腐败" : b.Stacks.Count == 1 && e.IsHeatProtected(s, b.Stacks[0]) ? Ui.FreshOf(e, s, b.Stacks[0]) : Ui.Fresh(b.ExpiresAt.Value - s.GameMinute))</span>
                    </button>
                }
            </div>
        }

        @if (cfg.Use != null && !spoiled)
        {
            var req = ActionRequest.UseInstance(inst.InstanceId);
            var p = G.Preview(req);
            <div class="lines">
                <div><span>即时效果</span><b>@(e.MedicineEffectText(s, cfg.Use) ?? UseEffect(cfg))</b></div>
                @if (cfg.Use.IsMedicine && !string.IsNullOrEmpty(cfg.Desc)) { <div><span>药效</span><b>@cfg.Desc</b></div> }
                @if (p.Ok && p.StatsAfterImmediate != null)
                {
                    // 与卡下操作条同一口径：属性写“使用当下”的即时结算值；之后5分钟按等待正常消耗另起一行（试玩修复 G4）
                    var later = new List<string>();
                    foreach (var id in new[] { StatId.Satiety, StatId.Hydration, StatId.Health, StatId.Morale })
                    {
                        var b0 = Ui.N(p.StatsBefore.Get(id));
                        var b1 = Ui.N(p.StatsAfterImmediate.Get(id));
                        if (b0 != b1) { <div><span>@GameEngine.StatName(id)（即时）</span><b>@b0 → @b1</b></div> }
                        var b2 = Ui.N(p.StatsAfter.Get(id));
                        if (b2 != b1) later.Add($"{GameEngine.StatName(id)}{b2}");
                    }
                    if (later.Count > 0) { <div><span>5分钟后</span><b>@string.Join("，", later)（按等待消耗）</b></div> }
                }
                <div><span>耗时</span><b>@(e.Config.ItemActions.UseMinutes)分钟（不可中途取消）</b></div>
            </div>
            @if (p.OverflowText is string ov) { <div class="risk">@ov</div> }
            @if (e.UseRiskText(cfg) is string risk) { <div class="risk">⚠ @(risk)。建议在营地烧开后再喝。</div> }
            @if (!p.Ok) { <div class="blocked">@p.Reason</div> }
        }
        else if (spoiled)
        {
            <div class="blocked">已腐败，不能食用或用于配方。仍有重量，可以放下丢弃。</div>
        }
        else if (cfg.RequiresCooking)
        {
            <div class="risk none">放进营地燃烧火堆的空加工位烤熟，或放进有净水的锅里、锅放进燃烧的火堆水煮后才能食用。</div>
        }
        @if (chosen.Reserved)
        {
            <div class="risk none">该批次正被当前行动预留，不能拾取、放下或使用。</div>
        }
        @if (G.Notice != null) { <div class="notice">@G.Notice</div> }
    </div>

    <div class="detail-foot">
        <div class="under">@(busy ? "行动进行中，暂不能整理物品" : GameEngine.CanSelfUse(cfg) ? $"在被选中卡片旁的操作窗里点“{GameEngine.UseButtonText(cfg)}”使用；转移目标与数量也在那里" : "转移目标与数量在被选中卡片旁的操作窗里")</div>
    </div>
}

@code {
    private sealed record Batch(string Key, int? ExpiresAt, int Count, bool Reserved, List<ItemInstance> Stacks);

    private string? batchKey;
    private bool batchPicked;
    private string lastSelection = "";

    protected override void OnParametersSet()
    {
        if (G.Selected.Key != lastSelection)
        {
            lastSelection = G.Selected.Key;
            batchPicked = false;
        }
    }

    private bool Spoiled(Batch b) => b.ExpiresAt.HasValue && b.Stacks.All(i => G.E.IsSpoiled(G.S, i));

    private void PickBatch(string key, bool group)
    {
        if (group)
        {
            G.PickBatch(G.Selected.Owner, G.Selected.Id, key);
            return;
        }
        batchKey = key;
        batchPicked = true;
    }

    private void OpenCraft(string recipe, int potId)
    {
        G.OpenPanel("craft", recipe);
        G.CraftPot = potId;
        G.Notify();
    }

    private static string UseEffect(ItemConfig cfg) => GameEngine.UseEffectText(cfg.Use!);

}
