@inherits GameComponent

@{
    var s = G.S;
    var e = G.E;
    var sel = G.Selected;
    var cfg = e.Item(sel.Id);
    var here = s.CurrentLocation;
    var onGround = sel.Owner == here;
    var carried = sel.Owner == ItemInstance.Carried;
    // 设施与锅里的物品按根位置判断：仍在随身或当前地点（含当前火堆与锅）才可操作
    var probe = s.Items.FirstOrDefault(i => i.Owner == sel.Owner);
    var stillThere = probe != null && (e.PlaceOf(s, probe) == ItemInstance.Carried || e.PlaceOf(s, probe) == here);
    var list = s.Items.Where(i => i.Owner == sel.Owner && i.ItemId == sel.Id && (sel.InstanceId == null || i.InstanceId == sel.InstanceId))
        .OrderBy(i => i.ExpiresAt ?? int.MaxValue).ThenBy(i => i.InstanceId).ToList();
    var batches = list.GroupBy(i => i.ExpiresAt).Select(g => new Batch(g.Key, g.Sum(i => i.Count), g.Any(i => i.ReservedBy != null), g.ToList())).ToList();
    var busy = e.IsBusy(s) || G.Running;
}

@if (!stillThere || list.Count == 0)
{
    <div class="empty-detail">这件物品已不在此处。<br />选择地点、路线、资源或物品查看操作</div>
}
else
{
    var chosen = batches.FirstOrDefault(b => b.ExpiresAt == batchKey && batchPicked) ?? batches.FirstOrDefault(b => !b.Reserved && !Spoiled(b)) ?? batches[0];
    var inst = chosen.Stacks.FirstOrDefault(i => i.ReservedBy == null) ?? chosen.Stacks[0];
    var spoiled = Spoiled(chosen);
    var total = batches.Sum(b => b.Count);

    <div class="detail-scroll">
        <div class="op-head">
            <div class="eyebrow">@(carried ? "随身物品" : e.WherePath(s, inst))</div>
            <h2>@cfg.Name <small class="muted">×@total</small></h2>
            <p>@cfg.Desc</p>
        </div>
        <div class="detail-icon">@Icons.Markup(cfg.Id)</div>

        <div class="lines">
            <div><span>单件重量</span><b>@Ui.Kg(cfg.WeightGrams)公斤</b></div>
            <div><span>合计重量</span><b>@Ui.Kg(list.Sum(i => e.ItemGrams(s, i)))公斤@(e.IsPot(inst) ? "（含锅内）" : "")</b></div>
            @if (cfg.MaxDurability.HasValue)
            {
                <div><span>耐久</span><b class="@(inst.Durability <= 0 ? "danger-text" : "")">@(inst.Durability <= 0 ? "已损坏" : $"{inst.Durability}/{cfg.MaxDurability}")</b></div>
            }
            @if (cfg.ShelfLifeMinutes.HasValue)
            {
                <div><span>保质期</span><b>@(cfg.ShelfLifeMinutes / 60)小时</b></div>
            }
        </div>

        @if (e.IsPot(inst))
        {
            var liquids = e.PotLiquids(s, inst.InstanceId);
            var foods = e.PotFood(s, inst.InstanceId);
            var free = e.PotFreeWaterUnits(s, inst);
            var potBusy = busy || e.IsLocked(s, inst);
            <div class="pot-detail">
                <div class="tiny muted">@e.WherePath(s, inst)</div>
                <PotGauge Pot="inst" />
                @if (liquids.Count == 0 && foods.Count == 0)
                {
                    <div class="tiny muted">空锅。净水或脏水卡拖到水量条装入（每份500毫升，同一锅只装一种水）；生块根拖到食材行放进锅里（2个食材位）。</div>
                }
                @foreach (var c in liquids)
                {
                    var cid = c.InstanceId;
                    var ccfg = e.Item(c.ItemId);
                    var up = G.Preview(ActionRequest.UseInstance(cid));
                    var lockedWhy = free < 1 ? e.ReservedWaterText(s, c) : null;
                    <ItemRow Icon="@c.ItemId" Name="@ccfg.Name" Qty="@($"×{c.Count}")" Status="@($"{c.Count * e.PotConfig(inst).UnitMl}毫升{(lockedWhy != null ? " · 已被水煮预留" : "")}")"
                             CssClass="pot-child" DataDrag="@($"potchild:{cid}")" DragFrom="@($"{e.ItemName(inst.ItemId)}#{inst.InstanceId}内")"
                             Title="可拖到随身或地面倒出，拖到“自身”饮用" />
                    <div class="btn-row">
                        <button class="secondary" disabled="@(potBusy || !up.Ok)" title="@up.Reason" @onclick="() => Use(cid)">@GameEngine.UseVerb(ccfg)1份</button>
                        @if (!inst.IsCarried) { <button class="secondary" disabled="@(potBusy || lockedWhy != null)" title="@lockedWhy" @onclick="() => Decant(cid, ItemInstance.Carried)">倒出1份到随身</button> }
                        <button class="secondary" disabled="@(potBusy || lockedWhy != null)" title="@lockedWhy" @onclick="() => Decant(cid, here)">倒出1份到地面</button>
                    </div>
                }
                @foreach (var f in foods)
                {
                    <ItemRow Icon="@f.ItemId" Name="@($"{e.ItemName(f.ItemId)}#{f.InstanceId}")" Qty="×1" Status="@e.ContentStatus(s, f)"
                             CssClass="pot-child" DataDrag="@($"potchild:{f.InstanceId}")" DragFrom="@($"{e.ItemName(inst.ItemId)}#{inst.InstanceId}内")" />
                    <TakeOutButtons Item="f" Busy="busy" />
                }
                @if (inst.InFacility)
                {
                    <div class="btn-row">
                        <button class="secondary" @onclick='() => G.OpenFacility($"pot:{inst.InstanceId}")'>打开锅内容 ▸</button>
                    </div>
                    <TakeOutButtons Item="inst" Busy="busy" />
                }
                else if (e.Location(here).HasFire)
                {
                    <div class="tiny muted">把锅拖到地块区火堆的空加工位，燃烧时自动烧水、水煮。</div>
                }
                @if (e.IsLocked(s, inst)) { <div class="risk none">行动占用：这口锅正被当前行动使用，不能移动、取水或加水。</div> }
            </div>
        }
        else if (inst.InFacility)
        {
            <div class="pot-detail">
                <div class="tiny muted">@e.WherePath(s, inst)</div>
                <div class="pot-status">@e.ContentStatus(s, inst)</div>
                <TakeOutButtons Item="inst" Busy="busy" />
            </div>
        }

        @if (batches.Count > 1 || cfg.ShelfLifeMinutes.HasValue)
        {
            <div>
                <div class="tiny muted" style="margin-bottom:5px">批次（默认先用最早到期的有效批次）</div>
                @foreach (var b in batches)
                {
                    var key = b.ExpiresAt;
                    <button class="batch @(b == chosen ? "on" : "")" @onclick="() => PickBatch(key)">
                        <span>×@b.Count@(b.Reserved ? " · 预留" : "")</span>
                        <span class="@(Spoiled(b) ? "danger-text" : "muted")">@(b.ExpiresAt.HasValue ? Ui.Fresh(b.ExpiresAt.Value - s.GameMinute) : "不会腐败")</span>
                    </button>
                }
            </div>
        }

        @if (cfg.Use != null && !spoiled)
        {
            var req = ActionRequest.UseInstance(inst.InstanceId);
            var p = G.Preview(req);
            <div class="lines">
                <div><span>即时效果</span><b>@UseEffect(cfg)</b></div>
                @if (p.Ok)
                {
                    foreach (var id in new[] { StatId.Satiety, StatId.Hydration, StatId.Health, StatId.Morale })
                    {
                        var b0 = Ui.Floor(p.StatsBefore.Get(id));
                        var b1 = Ui.Floor(p.StatsAfter.Get(id));
                        if (b0 == b1) continue;
                        <div><span>@GameEngine.StatName(id)</span><b>@b0 → @b1</b></div>
                    }
                }
                <div><span>耗时</span><b>@(e.Config.ItemActions.UseMinutes)分钟（不可中途取消）</b></div>
            </div>
            @if (Overflow(cfg, s.Stats) is string ov) { <div class="risk">@ov</div> }
            @if (cfg.Use.CausesDiarrhea) { <div class="risk">⚠ 脏水必定引起腹泻12小时：期间每小时额外失水3。建议在营地烧开后再喝。</div> }
            @if (!p.Ok) { <div class="blocked">@p.Reason</div> }
        }
        else if (spoiled)
        {
            <div class="blocked">已腐败，不能食用或用于配方。仍有重量，可以放下丢弃。</div>
        }
        else if (cfg.RequiresCooking)
        {
            <div class="risk none">放进营地燃烧火堆的空加工位烤熟，或放进有净水的锅里、锅放进燃烧的火堆水煮后才能食用。</div>
        }
        @if (chosen.Reserved)
        {
            <div class="risk none">该批次正被当前行动预留，不能拾取、放下或使用。</div>
        }
        @if (G.Notice != null) { <div class="notice">@G.Notice</div> }
    </div>

    <div class="detail-foot">
        @if (cfg.Use != null && !spoiled)
        {
            var label = $"{GameEngine.UseVerb(cfg)}1份{cfg.Name}·{e.Config.ItemActions.UseMinutes}分钟";
            var p = G.Preview(ActionRequest.UseInstance(inst.InstanceId));
            <button class="primary" disabled="@(!p.Ok || busy || chosen.Reserved)" @onclick="() => Use(inst.InstanceId)">@label</button>
        }
        <div class="under">@(busy ? "行动进行中，暂不能整理物品" : onGround ? "拾取在卡片下方操作，可输入数量" : carried ? "放下在卡片上方操作，可输入数量" : inst.InFacility || inst.InContainer ? "在火堆或锅里：用上面的按钮取出，或把卡片拖出" : "物品只能在当前地点取用")</div>
    </div>
}

@code {
    private sealed record Batch(int? ExpiresAt, int Count, bool Reserved, List<ItemInstance> Stacks);

    private int? batchKey;
    private bool batchPicked;
    private string lastSelection = "";

    protected override void OnParametersSet()
    {
        if (G.Selected.Key != lastSelection)
        {
            lastSelection = G.Selected.Key;
            batchPicked = false;
        }
    }

    private bool Spoiled(Batch b) => b.ExpiresAt.HasValue && b.ExpiresAt.Value <= G.S.GameMinute;

    private void PickBatch(int? key)
    {
        batchKey = key;
        batchPicked = true;
    }

    private async Task Use(int instanceId) => await G.StartAction(ActionRequest.UseInstance(instanceId));

    private void Decant(int childId, string zone) => G.Instant(InstantRequest.Decant(childId, zone));

    private void OpenCraft(string recipe, int potId)
    {
        G.OpenPanel("craft", recipe);
        G.CraftPot = potId;
        G.Notify();
    }

    private static string UseEffect(ItemConfig cfg) => GameEngine.UseEffectText(cfg.Use!);

    private static string? Overflow(ItemConfig cfg, Stats st)
    {
        var u = cfg.Use!;
        var over = new List<string>();
        if (u.Satiety > 0 && st.Satiety + u.Satiety > 100) over.Add($"饱食溢出{Ui.Floor(st.Satiety + u.Satiety - 100)}");
        if (u.Hydration > 0 && st.Hydration + u.Hydration > 100) over.Add($"水分溢出{Ui.Floor(st.Hydration + u.Hydration - 100)}");
        if (u.Health > 0 && st.Health + u.Health > 100) over.Add($"健康溢出{Ui.Floor(st.Health + u.Health - 100)}");
        return over.Count > 0 ? $"接近上限：{string.Join("，", over)}，溢出部分浪费。" : null;
    }
}
