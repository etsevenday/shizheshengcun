@inherits GameComponent
@inject IJSRuntime JS

@{
    var s = G.S;
    var e = G.E;
    var main = s.Main;
    var pausedLayer = main != null && main.Status == ActionStatus.Paused && G.Panel != "craft";
    var subRunning = s.Sub != null;
    // 战斗与敌踪选择：顶栏地图/制作/休息/日志入口锁定（v0.5 §16），覆盖层替换地块栏两行
    var battleUi = G.InBattleUi;
    // 对话读完锁（Q10、S14 §10.1）：整局游戏输入锁定，未被对话层盖住的区域只保持可见
    var dlgLock = G.DialogueLocked;
    var navOff = battleUi || dlgLock;
}

<div class="game">
    <header class="top">
        <div class="brand">
            <b>适者生存</b>
            <em>第@(Clock.Day(s.GameMinute))日 · @e.LocName(s.CurrentLocation)@(main?.Type == ActionType.Travel ? $" → {e.LocName(main.TargetId)}" : "")</em>
        </div>
        <nav class="nav" aria-label="主菜单">
            @* 顶栏按钮（S14 §7、§12.3、§13.3）：战斗/敌踪中与对话读完锁期间，导航与浏览入口按同一规则禁用；反馈不属于游戏操作，始终可用 *@
            <button class="@(G.Panel == "map" ? "on" : "")" disabled="@navOff" title="@NavTitle("区域地图", "M")" @onclick='() => Toggle("map")'>区域地图<kbd>M</kbd></button>
            <button class="@(G.Panel == "craft" ? "on" : "")" disabled="@navOff" title="@NavTitle("手工制作", "C")" @onclick='() => Toggle("craft")'>手工制作<kbd>C</kbd></button>
            <button class="@(G.Panel == "rest" ? "on" : "")" disabled="@navOff" title="@NavTitle("休息", "R")" @onclick='() => Toggle("rest")'>休息<kbd>R</kbd></button>
            <button class="@(G.Panel == "log" ? "on" : "")" disabled="@navOff" title="@NavTitle("行动日志", "L")" @onclick='() => Toggle("log")'>行动日志<kbd>L</kbd></button>
            <span class="nav-sep" aria-hidden="true"></span>
            <button class="@(G.Panel == "goals" ? "on" : "")" disabled="@navOff" title="@NavTitle("本局生存目标与完成情况", null)" @onclick='() => Toggle("goals")'>生存目标</button>
            <button class="@(G.Panel == "tips" ? "on" : "")" disabled="@navOff" title="@NavTitle("当前求生建议", null)" @onclick='() => Toggle("tips")'>生存提示</button>
            <button class="@(G.Panel == "dialogs" ? "on" : "")" disabled="@navOff" title="@NavTitle("已经展示过的人物对话", null)" @onclick='() => Toggle("dialogs")'>对话记录</button>
            <button class="@(G.Panel == "help" ? "on" : "")" disabled="@navOff" title="@NavTitle("各系统通用规则说明", null)" @onclick='() => Toggle("help")'>系统说明</button>
            <span class="nav-sep" aria-hidden="true"></span>
            <button class="feedback-btn" @onclick="OpenFeedback" title="把遇到的问题或想法留给作者（F）">反馈<kbd>F</kbd></button>
            <button class="@(G.Panel == "menu" || G.BattleMenuOpen ? "on" : "")" disabled="@dlgLock" title="@(dlgLock ? "请先读完对话" : "菜单（Esc）")" @onclick='() => { if (battleUi) G.ToggleBattleMenu(); else Toggle("menu"); }'>菜单<kbd>Esc</kbd></button>
        </nav>
    </header>

    <main class="body">
        <Hud />

        @{
            // 手工制作层盖住中部上方时，地面卡挪到下方与随身卡并排，仍能拖进材料槽（01 案第 5 节“手工拖入优先使用指定批次”）
            var craftOpen = G.Panel == "craft";
            // 顶栏面板只替换中部上方（地块两行与地面），随身栏固定在下方（S14 §7）
            var centerPanel = GameSession.IsTopPanel(G.Panel);
        }
        @* 四区同屏（S14 §1.3）：地图行、设施行、当前地面、随身物品按中部可用高度分配，各区溢出在区内滚动；
           只有低于基准分辨率的更小窗口才由 .center-scroll 整体纵滚兜底。 *@
        <section class="center" aria-label="当前地点">
            <div class="center-scroll quad @(centerPanel ? "locked" : "") @(craftOpen ? "craft" : "") @(battleUi ? "battle" : "")" data-wheel="y">
            <div class="center-top">
                <div class="rows2">
                    <div class="rows2-inner" inert="@dlgLock">
                        @* 战斗/敌踪覆盖层替换地块栏两行（组件替换而非叠加，拖拽不会收集到隐藏的落点） *@
                        @if (battleUi) { <BattleOverlay /> } else { <LocationStrip /> }
                    </div>
                    @* 人物对话层覆盖地图与设施两行的完整区域（S14 §10.1），地面/随身与左右栏保持可见 *@
                    <DialogueLayer />
                </div>
                @if (!craftOpen) { <ItemShelf Owner="@s.CurrentLocation" Title="当前地面" Sub="@e.LocName(s.CurrentLocation)" /> }
                @* 二级面板只替换这一块，周围的状态栏、随身物品与右侧详情不动 *@
                @if (centerPanel)
                {
                    <div class="panel-host" inert="@dlgLock">
                        @switch (G.Panel)
                        {
                            case "map": <MapOverlay Part="center" /> break;
                            case "craft": <CraftOverlay Part="center" /> break;
                            case "rest": <RestOverlay Part="center" /> break;
                            case "log": <LogOverlay /> break;
                            case "goals": <GoalsOverlay /> break;
                            case "tips": <TipsOverlay /> break;
                            case "help": <HelpOverlay /> break;
                            case "dialogs": <DialogueLogOverlay /> break;
                        }
                    </div>
                }
            </div>
            @if (craftOpen)
            {
                <div class="shelves-split">
                    <ItemShelf Owner="@s.CurrentLocation" Title="当前地面" Sub="@e.LocName(s.CurrentLocation)" />
                    <ItemShelf Owner="@ItemInstance.Carried" Title="随身物品" />
                </div>
            }
            else
            {
                <ItemShelf Owner="@ItemInstance.Carried" Title="随身物品" />
            }
            </div>

            @if (pausedLayer)
            {
                <PauseLayer />
            }
            else if (subRunning)
            {
                <PauseLayer />
            }
        </section>

        <DetailPanel />

        @if (G.Panel == "menu") { <MenuOverlay /> }
        @if (G.BattleMenuOpen && battleUi) { <MenuOverlay Battle="true" /> }
        <StatusPop />


        @if (G.Toast != null && !s.Progress.Dead)
        {
            var bad = G.Toast.Kind is GameEventKind.Hazard or GameEventKind.ActionAborted;
            <div class="toast @(bad ? "bad" : "")" role="status">
                <span>@G.Toast.Text</span>
                <button aria-label="关闭结果提示" @onclick="G.DismissToast">×</button>
            </div>
        }
    </main>

    <footer class="footer">
        @{ var last = G.Recent.LastOrDefault(); }
        <div class="event">@if (last != null) {<b>@Clock.HHmm(last.Minute)</b>@last.Text}</div>
        <div>@(G.Running ? "时间流逝中…" : "浏览与整理不推进时间")</div>
        <div class="save @(G.SaveState == SaveStatus.Failed ? "failed" : "")">
            @switch (G.SaveState)
            {
                case SaveStatus.Failed:
                    <span>保存失败：@G.SaveError </span><button class="linkish" @onclick="G.RetrySave">重试</button>
                    break;
                case SaveStatus.Saving:
                    <span>保存中…</span>
                    break;
                case SaveStatus.Saved:
                    <span>● 已保存</span>
                    break;
            }
        </div>
    </footer>
</div>

<DropQuantity />
<EndScreens />

@code {
    private DotNetObjectReference<GameScreen>? _ref;
    private DotNetObjectReference<DragController>? _drag;

    private string? _topKey;
    private string? _selKey;

    private bool _lockSeen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 对话出现：取消未提交的拖拽（物品保持原归属，不补一次松手），收起键盘焦点，避免回车/空格落到背后的按钮（S07 §7）
        var locked = G.DialogueLocked;
        if (locked && !_lockSeen)
        {
            try { await JS.InvokeVoidAsync("survival.dialogueOnset"); }
            catch (JSException) { }
        }
        _lockSeen = locked;
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("survival.hookKeys", _ref);
            _drag = DotNetObjectReference.Create(new DragController(G));
            await JS.InvokeVoidAsync("survivalDrag.init", _drag, G.E.Config.Ui.DragThresholdPx);
        }
        // 中部二级面板（地图/制作/休息/日志）打开、战斗或敌踪出现（含读档恢复）时，中部纵滚回顶，
        // 面板与覆盖层才能完整替换地块两行，不被之前的滚动位置切掉标题（试玩修复 G1、G2）
        if (G.State != null)
        {
            var panel = GameSession.IsTopPanel(G.Panel) ? G.Panel : "";
            var mode = G.S.Battle != null ? "battle" : G.S.Encounter != null ? "encounter" : "";
            var key = panel + "|" + mode;
            if (key != _topKey)
            {
                var need = panel != "" || mode != "";
                _topKey = key;
                if (need) await JS.InvokeVoidAsync("survival.centerTop");
            }
            var sk = G.Selected.Key;
            if (sk != _selKey)
            {
                _selKey = sk;
                if (G.Selected.Kind != SelectionKind.None) await JS.InvokeVoidAsync("survival.revealBar");
            }
        }
    }

    private async Task OpenFeedback() => await JS.InvokeVoidAsync("survival.openFeedback");

    private void Toggle(string panel)
    {
        G.OpenPanel(G.Panel == panel ? null : panel);
    }

    private string NavTitle(string what, string? key)
    {
        if (G.DialogueLocked) return "请先读完对话";
        if (G.InBattleUi) return "战斗中锁定";
        return key == null ? what : $"{what}（{key}）";
    }

    [JSInvokable]
    public void OnKey(string key)
    {
        if (key == "F") { _ = OpenFeedback(); return; }
        if (G.State == null || G.S.Progress.Dead) return;
        // 对话读完锁（Q10、S14 §10.1）：快捷键与 Esc 全部无效，Esc 不转入背后的游戏菜单；只有对话层自己的按钮能推进
        if (G.DialogueLocked) return;
        if (G.InBattleUi)
        {
            // 战斗中：M/C/R/L 锁定；Esc 栈：拖拽（drag.js 先拦截）→ 数量框 → 状态浮层 → 人物二级页 → 收起战斗菜单 → 收起指令预览/物品选中 → 战斗菜单（只含继续、保存并返回标题，不能脱战）
            if (key != "Escape") return;
            if (G.PendingDrop != null) G.CancelDropQuantity();
            else if (G.StatusPinned != null) G.PinStatus(null);
            else if (G.CharPage != null && G.DetailTab == DetailTab.Character) G.OpenCharPage(null);
            else if (G.BattleMenuOpen) G.ToggleBattleMenu(false);
            else if (G.BattleAction != null) G.ClearBattleAction();
            else if (G.Selected.Kind != SelectionKind.None) G.ClearSelection();
            else G.ToggleBattleMenu(true);
            return;
        }
        switch (key)
        {
            case "M": Toggle("map"); break;
            case "C": Toggle("craft"); break;
            case "R": Toggle("rest"); break;
            case "L": Toggle("log"); break;
            case "Escape":
                // Esc 层级栈，每次只退一级，不取消主行动、不当作“退出”（S14 §7、§11.2）：
                // 拖拽中（drag.js 先拦截）→ 数量框 → 状态浮层 → 点火工具菜单 → 系统说明逐层 → 二级面板 → 人物二级页 → 清选中 → 菜单
                if (G.PendingDrop != null) G.CancelDropQuantity();
                else if (G.StatusPinned != null) G.PinStatus(null);
                else if (G.IgniteMenuOpen) { G.Hover(null); G.CloseIgniteMenu(); }
                else if (G.Panel == "help") G.HelpBack();
                else if (G.Panel != null) G.OpenPanel(null);
                else if (G.CharPage != null && G.DetailTab == DetailTab.Character) G.OpenCharPage(null);
                else if (G.Selected.Kind != SelectionKind.None) G.ClearSelection();
                else Toggle("menu");
                break;
        }
    }

    public override void Dispose()
    {
        base.Dispose();
        _ref?.Dispose();
        _drag?.Dispose();
    }
}
