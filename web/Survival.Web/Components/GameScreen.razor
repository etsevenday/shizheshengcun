@inherits GameComponent
@inject IJSRuntime JS
@inject NavigationManager Navigation

@{
    var s = G.S;
    var e = G.E;
    var main = s.Main;
    // 暂停层（主行动暂停且不在制作面板，或补给子行动进行中）的显示条件见 G.PauseLayerShown（Q318 右栏去重共用）
    // 战斗与敌踪选择：顶栏地图/制作/休息/日志入口锁定（v0.5 §16），覆盖层替换地块栏两行
    var battleUi = G.InBattleUi;
    // B9 全屏四对四战斗（A10 §1.2）：战斗中整个应用内容区由 BattleScreen 覆盖，外层顶栏/左右栏/地面随身/底栏留在下面不可操作
    var fullBattle = G.BattleFullscreen && !s.Progress.Dead;
    // 对话读完锁（Q10、S14 §10.1）：整局游戏输入锁定，未被对话层盖住的区域只保持可见
    var dlgLock = G.DialogueLocked;
    var navOff = battleUi || dlgLock;
    // 中央推进条（S14 §11）：死亡后由结算层接管
    var progress = s.Progress.Dead ? null : G.ProgressInfo();
    if (progress != null) { _lastInfo = progress; _fadeInfo = null; }
    else if (_lastInfo != null && !s.Progress.Dead) { _fadeInfo = _lastInfo; _lastInfo = null; _ = FadeOut(_fadeInfo); }
}

<div class="game wasteland" style="--scene-art: url('@Navigation.ToAbsoluteUri(ArtAssets.Scene(s.CurrentLocation, e.Location(s.CurrentLocation).Scene))')">
    <header class="top" inert="@fullBattle">
        <div class="brand">
            <b>@ShellText.Brand</b>
            @* §2「第{世界日}日 · {地点}」；真实移动中沿 Q331「第{世界日}日 · {起点} → {终点}」 *@
            <em>第@(Clock.Day(s.GameMinute))日 · @e.LocName(s.CurrentLocation)@(main?.Type == ActionType.Travel ? $" → {e.LocName(main.TargetId)}" : "")</em>
        </div>
        <nav class="nav" aria-label="主菜单">
            @* 顶栏 12 键一排（Q292、§2「顶栏从左到右」，B31b R51）：战斗/敌踪中与对话读完锁期间，导航与浏览入口按同一规则禁用（S14 §7、§12.3、§13.3）；
               反馈只在游戏菜单里（Q322），「菜单」在对白锁、战斗与敌踪中也能打开。快捷键写在悬停提示里。 *@
            <button class="@(G.Panel == "map" ? "on" : "")" disabled="@navOff" title="@NavTitle(ShellText.TopKeys[0], "M")" @onclick='() => Toggle("map")'>@ShellText.TopKeys[0]</button>
            <button class="@(G.Panel == "craft" ? "on" : "")" disabled="@navOff" title="@NavTitle(ShellText.TopKeys[1], "C")" @onclick='() => Toggle("craft")'>@ShellText.TopKeys[1]</button>
            <button class="@(G.Panel == "rest" ? "on" : "")" disabled="@navOff" title="@NavTitle(ShellText.TopKeys[2], "R")" @onclick='() => Toggle("rest")'>@ShellText.TopKeys[2]</button>
            <button class="@(G.Panel == "log" ? "on" : "")" disabled="@navOff" title="@NavTitle(ShellText.TopKeys[3], "L")" @onclick='() => Toggle("log")'>@ShellText.TopKeys[3]</button>
            @* Q86（S14 本轮章）：顶栏“编队”只在空白操作时期可用；不可用时不打开，点击/悬停写具体原因（战斗与对白锁同其他入口）。
               敌踪/战斗中按钮照样禁用，但悬停写内核 FormationEditBlocked 的原因（“先处理眼前的敌踪”），不用统一的“战斗中锁定”（试玩修复 B8a 第 1 轮 B1） *@
            @{ var formWhy = G.Panel == "formation" ? null : G.FormationBlocked; }
            <button class="@(G.Panel == "formation" ? "on" : "") @(formWhy != null ? "off" : "")" disabled="@navOff" aria-disabled="@(formWhy != null)" data-nav="formation"
                    title="@(G.DialogueLocked ? NavTitle("编队", null) : formWhy != null ? $"现在不能编队：{formWhy}" : navOff ? NavTitle("编队", null) : "编队：安排开战号位（前排1→后排4），保存不花时间")"
                    @onclick="ToggleFormation">@ShellText.TopKeys[4]</button>
            <button class="@(G.Panel == "gear" ? "on" : "")" disabled="@navOff" data-nav="gear" title="@NavTitle("整备：七槽装备、随身五卡与队员交接（不花时间）", null)" @onclick='() => Toggle("gear")'>@ShellText.TopKeys[5]</button>
            <button class="@(G.Panel == "growth" ? "on" : "")" disabled="@navOff" data-nav="growth" title="@NavTitle("成长：十五门熟练度的十级轨道与技能节点（只浏览）", null)" @onclick='() => Toggle("growth")'>@ShellText.TopKeys[6]</button>
            <button class="@(G.Panel == "goals" ? "on" : "")" disabled="@navOff" title="@NavTitle("序章任务册：主目标、建议与完整18项", null)" @onclick='() => Toggle("goals")'>@ShellText.TopKeys[7]</button>
            <button class="@(G.Panel == "tips" ? "on" : "")" disabled="@navOff" title="@NavTitle("当前求生建议", null)" @onclick='() => Toggle("tips")'>@ShellText.TopKeys[8]</button>
            <button class="@(G.Panel == "dialogs" ? "on" : "")" disabled="@navOff" title="@NavTitle("已经展示过的人物对话", null)" @onclick='() => Toggle("dialogs")'>@ShellText.TopKeys[9]</button>
            <button class="@(G.Panel == "help" ? "on" : "")" disabled="@navOff" title="@NavTitle("各系统通用规则说明", null)" @onclick='() => Toggle("help")'>@ShellText.TopKeys[10]</button>
            <button class="@(G.MenuOpen || G.BattleMenuOpen ? "on" : "")" title="菜单（Esc）" @onclick="ToggleMenu">@ShellText.TopKeys[11]</button>
        </nav>
    </header>

    <main class="body" inert="@fullBattle">
        <Hud />

        @{
            // 顶栏面板（地图/制作/休息/日志/目标/提示/对话记录/说明）只覆盖①②两行，③当前地面、④随身不动（S14 §18.1：
            // 导航面板不得重新分配四行高度）；手工制作仍能把地面卡拖进材料槽
            var centerPanel = GameSession.IsTopPanel(G.Panel);
            // B31b（R55）：一级面板开着时中央行动位收成中部底部窄条，不盖面板里的按钮；三城鸟瞰沿用自己的右下角位置（B24）。
            var dockProgress = centerPanel && G.Panel != "citymap";
            // B31c（Q324）：没开面板、居中局部盘开着时同样收成窄条，居中盘不挡「退出行动」
            if (!centerPanel && G.LocalDiskOpen) dockProgress = true;
        }
        @* 固定四行（S14 §18.1）：中部净高均分四份——①地图/场景 ②设施/资源 ③当前地面 ④随身；选卡、展开锅、悬停、开面板、对白、
           战斗都不改行高，行内放不下的在行内滚动（随身五张卡不滚动）。对白/战斗/面板只占①②合并区域。 *@
        <section class="center @(G.Panel == "citymap" ? "city-open" : "")" aria-label="当前地点">
            <div class="center-scroll four @(centerPanel ? "locked" : "") @(G.Panel == "craft" ? "craft-panel" : "") @(G.Panel is "gear" or "growth" ? "full-panel" : G.Panel is "craft" or "safehouse" or "drying" or "citymap" || (G.Panel == "city" && G.CityPanelTall) ? "tall-panel" : "") @(battleUi ? "battle" : "") @(dockProgress && (G.PauseLayerShown || progress != null) ? "docked-prog" : "")">
                <div class="rows2" data-row="1-2">
                    <div class="rows2-inner" inert="@dlgLock">
                        @* 战斗/敌踪覆盖层替换地块栏两行（组件替换而非叠加，拖拽不会收集到隐藏的落点） *@
                        @if (G.BattleFullscreen) { <div class="rows2-blank" aria-hidden="true"></div> }
                        else if (battleUi) { <BattleOverlay /> } else { <LocationStrip /> }
                    </div>
                    @* 人物对话层覆盖地图与设施两行的完整区域（S14 §10.1），地面/随身与左右栏保持可见；全屏战斗中的对白在战场内显示（A10 §6.2） *@
                    @if (!G.BattleFullscreen) { <DialogueLayer /> }
                    @if (centerPanel)
                    {
                        <div class="panel-host" inert="@dlgLock">
                            @switch (G.Panel)
                            {
                                case "map": <MapOverlay Part="center" /> break;
                                case "craft": <CraftOverlay Part="center" /> break;
                                case "rest": <RestOverlay Part="center" /> break;
                                case "log": <LogOverlay /> break;
                                case "goals": <GoalsOverlay /> break;
                                case "journey": <JourneyOverlay /> break;
                                case "city": <CityServiceOverlay /> break;
                                case "tips": <TipsOverlay /> break;
                                case "help": <HelpOverlay /> break;
                                case "dialogs": <DialogueLogOverlay /> break;
                                case "formation": <FormationOverlay /> break;
                                case "gear": <GearOverlay /> break;
                                case "growth": <GrowthOverlay /> break;
                                case "safehouse": <SafehouseOverlay /> break;
                                case "drying": <DryingOverlay /> break;
                                case "citymap": <CityOverview /> break;
                            }
                        </div>
                    }
                </div>
                <ItemShelf Owner="@s.Ground" Title="@(s.CurrentZone == GameState.SafehouseZone ? "屋内地面" : "当前地面")" Sub="@e.ZoneName(s, s.Ground)" />
                <ItemShelf Owner="@ItemInstance.Carried" Title="随身物品" />
            </div>

            @if (G.PauseLayerShown)
            {
                @* 暂停/补给：中央行动位嵌在「行动暂停中」弹窗正中一行；开着一级面板时收成底部窄条（B31b） *@
                <PauseLayer Docked="@dockProgress" />
            }
            else if (progress != null && !progress.DialogueWaiting)
            {
                <CentralProgress Info="progress" Docked="@dockProgress" />
            }
            else if (_fadeInfo != null)
            {
                @* 完成/退出/终止：150ms 淡出，期间不拦截操作 *@
                <CentralProgress Info="_fadeInfo" Fading="true" />
            }
        </section>

        <DetailPanel />

        @* 就近操作浮窗（S14 §14.1）：渲染在卡片之外（fixed 定位锚在卡旁），点击不会冒泡成卡片选择/使用/拖拽 *@
        <div class="apop-host" inert="@dlgLock">
            <ActionPops />
            @* 选卡操作（S14 §18.3）：锚定在所选卡片下方的紧凑浮窗，脱离文档流，不撑高所在行；同屏只有一个 *@
            <CardPop />
            @* B29：给同行者吃喝的局部盘，开着时选卡浮窗让位 *@
            <FeedPop />
            @* 点火工具菜单：锚定在火堆卡“点燃”按钮旁的浮窗，不在卡内撑高设施行（试玩修复 B1） *@
            @if (G.IgniteMenuOpen && !battleUi && e.HasFireAt(s, s.Ground) && !e.FacOf(s, s.Ground)!.FireLit) { <IgniteMenu /> }
        </div>

        @* 旧档非法同类双武器整理先于超五卡整理（B3 H8）；两者都只在安全空闲出现 *@
        @if (G.DuplicateWeaponsPending && !G.MenuOpen) { <DuplicateWeaponOverlay /> }
        else if (G.OverflowPending && !G.MenuOpen) { <OverflowOverlay /> }
        @if (G.MenuOpen && !battleUi && !s.Progress.Dead) { <MenuOverlay /> }
        @if (G.Panel == "abort" && !battleUi) { <ExpeditionAbort /> }
        @if (G.Panel == "seal" && !battleUi) { <ExpeditionSeal /> }
        @if (G.Panel == "reset" && !battleUi) { <DungeonReset /> }
        @if (G.BattleMenuOpen && battleUi && !G.BattleFullscreen && !s.Progress.Dead) { <MenuOverlay Battle="true" /> }
        <StatusPop />


        @if (G.Toast != null && !s.Progress.Dead && !fullBattle)
        {
            var bad = ResultToast.IsCritical(G.Toast);
            @* B22h 试玩修复（M448）：长结果（如带敌踪的撤退落点）在 1280 下两行放不下，放宽到最多五行、宽度稍大，完整内容仍在悬停提示。
               B31c（Q330）：危险、行动中止（.bad）保持到点 × 或下一次有效提交；一般提示约 8 秒先淡出再收起（.leaving，R114 toast） *@
            <div @key="G.Toast" class="toast @(bad ? "bad" : "") @(G.Toast.Text.Length > 80 ? "long" : "") @(G.ToastLeaving ? "leaving" : "")" role="@(bad ? "alert" : "status")">
                <span title="@G.Toast.Text">@G.Toast.Text</span>
                <button aria-label="关闭结果提示" @onclick="G.DismissToast">×</button>
            </div>
        }
    </main>

    <footer class="footer" inert="@fullBattle">
        @{ var last = G.Recent.LastOrDefault(); }
        <div class="event" title="@last?.Text">@if (last != null) {<b>@Clock.HHmm(last.Minute)</b>@last.Text}</div>
        <div>@(G.Running ? "时间流逝中…" : "浏览与整理不推进时间")</div>
        <div class="save @(G.SaveState == SaveStatus.Failed ? "failed" : "")">
            @switch (G.SaveState)
            {
                case SaveStatus.Failed:
                    @* Q282：配额用尽时整句「存档失败：浏览器存储空间已满。」，其他错误仍为“保存失败：”+原始信息；都后接重试 *@
                    <span>@G.SaveErrorText </span><button class="linkish" @onclick="G.RetrySave">重试</button>
                    break;
                case SaveStatus.Saving:
                    <span>保存中…</span>
                    break;
                case SaveStatus.Saved:
                    @* §2 底栏：保存完成「已保存」（B31b 去掉前面的圆点字符，状态色由样式给） *@
                    <span class="saved">@ShellText.Saved</span>
                    break;
            }
        </div>
    </footer>
    @if (fullBattle) { <BattleScreen /> }
</div>

<DropQuantity />
<EndScreens />
@if (G.MenuOpen && G.S.Progress.Dead)
{
    @* B31d（逐字稿 §1.2 Q333 选 A）：死亡结算页的「菜单」或 Esc 打开的游戏菜单——盖在结算层之上（结算层在 .game 之外），只开放阅读字体、动画速度与
       「反馈与留言」，关闭回到同一结算。外层带 .wasteland 以沿用游戏菜单的按钮与偏好样式 *@
    <div class="wasteland end-menu"><MenuOverlay /></div>
}

@code {
    private DotNetObjectReference<GameScreen>? _ref;
    private DotNetObjectReference<DragController>? _drag;

    private string? _topKey;
    private string? _selKey;

    private bool _lockSeen;
    private ActionProgressInfo? _lastInfo;
    private ActionProgressInfo? _fadeInfo;

    /// <summary>中央条淡出 150ms（UI 初值，S14 §11.2）后移除；只是表现，不推进 tick、不拦截操作。</summary>
    private async Task FadeOut(ActionProgressInfo info)
    {
        await Task.Delay(G.MotionMs(150));
        if (!ReferenceEquals(_fadeInfo, info)) return;
        _fadeInfo = null;
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 对话出现：取消未提交的拖拽（物品保持原归属，不补一次松手），收起键盘焦点，避免回车/空格落到背后的按钮（S07 §7）
        var locked = G.DialogueLocked;
        if (locked && !_lockSeen)
        {
            try { await JS.InvokeVoidAsync("survival.dialogueOnset"); }
            catch (JSException) { }
        }
        _lockSeen = locked;
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("survival.hookKeys", _ref);
            _drag = DotNetObjectReference.Create(new DragController(G));
            await JS.InvokeVoidAsync("survivalDrag.init", _drag, G.E.Config.Ui.DragThresholdPx);
            // B31d（Q336）：游戏菜单版本行的实际构建
            try { G.AppBuild = await JS.InvokeAsync<string>("survival.appBuild"); } catch (JSException) { /* 旧缓存 app.js：版本行省略构建段 */ }
        }
        // 中部二级面板（地图/制作/休息/日志）打开、战斗或敌踪出现（含读档恢复）时，中部纵滚回顶，
        // 面板与覆盖层才能完整替换地块两行，不被之前的滚动位置切掉标题（试玩修复 G1、G2）
        if (G.State != null)
        {
            var panel = GameSession.IsTopPanel(G.Panel) ? G.Panel : "";
            var mode = G.S.Battle != null ? "battle" : G.S.Encounter != null ? "encounter" : "";
            var key = panel + "|" + mode;
            if (key != _topKey)
            {
                var need = panel != "" || mode != "";
                _topKey = key;
                if (need) await JS.InvokeVoidAsync("survival.centerTop");
            }
            var sk = G.Selected.Key;
            if (sk != _selKey)
            {
                _selKey = sk;
                if (G.Selected.Kind != SelectionKind.None) await JS.InvokeVoidAsync("survival.revealBar");
            }
        }
    }

    private void Toggle(string panel)
    {
        G.OpenPanel(G.Panel == panel ? null : panel);
    }

    /// <summary>编队按钮：开着就取消草稿关闭；不在空白操作时期就只提示原因（OpenFormation 内判断）。</summary>
    private void ToggleFormation()
    {
        if (G.Panel == "formation") G.CancelFormation();
        else G.OpenFormation();
    }

    private string NavTitle(string what, string? key)
    {
        if (G.DialogueLocked) return "请先读完对话";
        if (G.InBattleUi) return "战斗中锁定";
        return key == null ? what : $"{what}（{key}）";
    }

    /// <summary>顶栏「菜单」：战斗与敌踪开战斗菜单，其余（含对白锁、行动推进、暂停）开游戏菜单（Q322）。</summary>
    private void ToggleMenu()
    {
        if (G.InBattleUi) G.ToggleBattleMenu();
        else G.SetMenu(!G.MenuOpen);
    }

    [JSInvokable]
    public void OnKey(string key)
    {
        if (G.State == null) return;
        if (key == "Escape") { Escape(); return; }
        // 死亡结算（B31d Q333）：只有 Esc（同结算页「菜单」键），其余快捷键无效
        if (G.S.Progress.Dead) return;
        // 对话读完锁（Q10、S14 §10.1）与菜单打开时：快捷键全部无效，只有 Esc（开关菜单）
        if (G.DialogueLocked || G.MenuOpen || G.BattleMenuOpen) return;
        if (G.BattleFullscreen)
        {
            // 全屏战斗（A10 §6.3）：M/C/R/L 锁定
            switch (key)
            {
                case "1" or "2" or "3" or "4" or "5": G.BattleHotkeySkill(key[0] - '0'); break;
                case "Q": G.SelectWeaponPage(1); break;
                case "E": G.SelectWeaponPage(2); break;
                case "ArrowLeft": G.BattleCycleTarget(-1); break;
                case "ArrowRight": G.BattleCycleTarget(1); break;
                case "Enter": _ = G.BattleConfirmHover(); break;
            }
            return;
        }
        // 敌踪选择中：M/C/R/L 锁定
        if (G.InBattleUi) return;
        switch (key)
        {
            case "M": Toggle("map"); break;
            case "C": Toggle("craft"); break;
            case "R": Toggle("rest"); break;
            case "L": Toggle("log"); break;
        }
    }

    /// <summary>
    /// Esc（逐字稿 §1.1 Q322，判定在内核 <see cref="ShellEsc"/>）：先按原层级收起最上方看得见、可关闭的子层；没有时打开当前情境的游戏菜单——
    /// 战斗／敌踪、强制对白、行动推进和暂停均可。对白本身不由 Esc 结束；Esc 不取消主行动、不当作“退出”（S14 §7、§11.2）。
    /// </summary>
    private void Escape()
    {
        var full = G.BattleFullscreen;
        var dead = G.S.Progress.Dead;
        var route = ShellEsc.Route(new ShellEscInput
        {
            Dead = dead,
            DialogueLocked = G.DialogueLocked,
            BattleUi = G.InBattleUi,
            MenuOpen = G.MenuOpen,
            BattleMenuOpen = G.BattleMenuOpen,
            HasClosableLayer = dead ? G.DeathLogOpen : full ? G.BattleHasEscLayer : G.InBattleUi ? EncounterLayer() : NormalLayer(),
        });
        // B31d（Q333）：死亡结算页上 Esc 只在结算页这几层之间走：先收「查看记录」，再开／关结算菜单
        if (dead)
        {
            if (route == ShellEscRoute.CloseLayer) { G.DeathLogOpen = false; StateHasChanged(); }
            else if (route == ShellEscRoute.OpenMenu) G.SetMenu(true);
            else if (route == ShellEscRoute.CloseMenu) G.SetMenu(false);
            return;
        }
        switch (route)
        {
            case ShellEscRoute.CloseMenu: G.SetMenu(false); break;
            case ShellEscRoute.CloseBattleMenu: G.ToggleBattleMenu(false); break;
            case ShellEscRoute.OpenMenu: G.SetMenu(true); break;
            case ShellEscRoute.OpenBattleMenu: G.ToggleBattleMenu(true); break;
            case ShellEscRoute.CloseLayer:
                if (full) G.BattleEscape();
                else if (G.InBattleUi) EncounterStep();
                else NormalStep();
                break;
        }
    }

    private bool ShelfSelection => G.Selected.Kind is SelectionKind.ItemGroup or SelectionKind.Tool or SelectionKind.PotLiquid;

    /// <summary>敌踪选择中可关闭的子层：拖拽（drag.js 先拦截）→ 数量框 → 状态浮层 → 人物二级页 → 就近浮窗 → 指令预览 → ③④物品选中（①②被敌踪层替换，那里的残留选中看不见，不吃 Esc）。</summary>
    private bool EncounterLayer() =>
        G.PendingDrop != null || G.StatusPinned != null || (G.CharPage != null && G.DetailTab == DetailTab.Character) || G.Pop != null
        || G.BattleAction != null || ShellEsc.BattleSelectionVisible(false, ShelfSelection);

    private void EncounterStep()
    {
        if (G.PendingDrop != null) G.CancelDropQuantity();
        else if (G.StatusPinned != null) G.PinStatus(null);
        else if (G.CharPage != null && G.DetailTab == DetailTab.Character) G.OpenCharPage(null);
        else if (G.Pop != null) G.ClosePop();
        else if (G.BattleAction != null) G.ClearBattleAction();
        else if (ShelfSelection) G.ClearSelection();
    }

    /// <summary>常态可关闭的子层，每次只退一级：数量框 → 状态浮层 → 就近操作浮窗（只收起、不提交） → 鸟瞰说明/鸟瞰 → 点火工具菜单 → 食饮与交接浮窗 → 面板里的选中 → 系统说明逐层 → 面板 → 人物二级页 → 清选中。</summary>
    private bool NormalLayer() =>
        G.PendingDrop != null || G.StatusPinned != null || G.Pop != null || G.Panel != null || G.IgniteMenuOpen || G.FeedPending != null || G.GivePending != null
        || (G.CharPage != null && G.DetailTab == DetailTab.Character) || G.Selected.Kind != SelectionKind.None;

    private void NormalStep()
    {
        if (G.PendingDrop != null) G.CancelDropQuantity();
        else if (G.StatusPinned != null) G.PinStatus(null);
        else if (G.Pop != null) G.ClosePop();
        // B24（A10-CITY §7）：鸟瞰里 Esc 先收固定说明/确认窗，再关鸟瞰；不撤销已发生的移动
        else if (G.Panel == "citymap" && G.CityPick != null) G.PickCity(null);
        else if (G.Panel == "citymap") G.OpenPanel(null);
        else if (G.IgniteMenuOpen) { G.Hover(null); G.CloseIgniteMenu(); }
        // B10 试玩修复 2/6：最上层先退——交接确认浮窗、面板开着时选中卡的操作浮窗，再到面板本身
        else if (G.FeedPending != null && G.Panel != "help") G.CancelFeed();
        else if (G.GivePending != null) G.CancelGive();
        else if (G.Panel != null && G.Panel != "help" && G.Selected.Kind is SelectionKind.ItemGroup or SelectionKind.Tool or SelectionKind.PotLiquid) G.ClearSelection();
        else if (G.Panel == "help") G.HelpBack();
        else if (G.Panel != null) G.OpenPanel(null);
        else if (G.CharPage != null && G.DetailTab == DetailTab.Character) G.OpenCharPage(null);
        else if (G.Selected.Kind != SelectionKind.None) G.ClearSelection();
        else if (G.FeedPending != null) G.CancelFeed();
    }

    public override void Dispose()
    {
        base.Dispose();
        _ref?.Dispose();
        _drag?.Dispose();
    }
}
