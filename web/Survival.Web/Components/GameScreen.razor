@inherits GameComponent
@inject IJSRuntime JS
@inject NavigationManager Navigation

@{
    var s = G.S;
    var e = G.E;
    var main = s.Main;
    // 暂停层（主行动暂停且不在制作面板，或补给子行动进行中）的显示条件见 G.PauseLayerShown（Q318 右栏去重共用）
    // 战斗与敌踪选择：顶栏地图/制作/休息/日志入口锁定（v0.5 §16），覆盖层替换地块栏两行
    var battleUi = G.InBattleUi;
    // B9 全屏四对四战斗（A10 §1.2）：战斗中整个应用内容区由 BattleScreen 覆盖，外层顶栏/左右栏/地面随身/底栏留在下面不可操作
    var fullBattle = (G.BattleFullscreen || G.BattleClosingHold) && !s.Progress.Dead;   // B34 试玩修复 E2：收束前短反馈停留期间战斗画面仍在（冻结）
    // 对话读完锁（Q10、S14 §10.1）：整局游戏输入锁定，未被对话层盖住的区域只保持可见
    var dlgLock = G.DialogueLocked;
    var navOff = battleUi || dlgLock;
    // 中央推进条（S14 §11）：死亡后由结算层接管
    var progress = s.Progress.Dead ? null : G.ProgressInfo();
    if (progress != null) { _lastInfo = progress; _fadeInfo = null; }
    else if (_lastInfo != null && !s.Progress.Dead) { _fadeInfo = _lastInfo; _lastInfo = null; _ = FadeOut(_fadeInfo); }
}

<div class="game wasteland" style="--scene-art: url('@Navigation.ToAbsoluteUri(ArtAssets.Scene(s.CurrentLocation, e.Location(s.CurrentLocation).Scene))')">
    <header class="top" inert="@fullBattle">
        <div class="brand">
            <b>@ShellText.Brand</b>
            @* §2「第{世界日}日 · {地点}」；真实移动中沿 Q331「第{世界日}日 · {起点} → {终点}」 *@
            <em>第@(Clock.Day(s.GameMinute))日 · @e.LocName(s.CurrentLocation)@(main?.Type == ActionType.Travel ? $" → {e.LocName(main.TargetId)}" : "")</em>
        </div>
        <nav class="nav" aria-label="主菜单">
            @* 顶栏 12 键（Q292、§2「顶栏从左到右」，B31b R51）：战斗/敌踪中与对话读完锁期间，导航与浏览入口按同一规则禁用（S14 §7、§12.3、§13.3）；
               反馈只在游戏菜单里（Q322），「菜单」在对白锁、战斗与敌踪中也能打开。
               B43（S14 2026-11-12）：按钮内常驻「功能名＋键帽」（ShellKeys.TopCaps），键帽是按钮的一部分、不是第二个按钮；禁用时键帽随按钮一同变灰。
               键盘与鼠标走同一个 ActivateTop（OnKey 按 ShellKeys.TopIndexOf 找到同一按钮），可用条件相同。 *@
            <button class="@(G.Panel == "map" ? "on" : "")" disabled="@navOff" aria-keyshortcuts="M" title="@NavTitle(ShellText.TopKeys[0], 0)" @onclick="() => ActivateTop(0)">@TopFace(0)</button>
            <button class="@(G.Panel == "craft" ? "on" : "")" disabled="@navOff" aria-keyshortcuts="C" title="@NavTitle(ShellText.TopKeys[1], 1)" @onclick="() => ActivateTop(1)">@TopFace(1)</button>
            <button class="@(G.Panel == "rest" ? "on" : "")" disabled="@navOff" aria-keyshortcuts="R" title="@NavTitle(ShellText.TopKeys[2], 2)" @onclick="() => ActivateTop(2)">@TopFace(2)</button>
            <button class="@(G.Panel == "log" ? "on" : "")" disabled="@navOff" aria-keyshortcuts="L" title="@NavTitle(ShellText.TopKeys[3], 3)" @onclick="() => ActivateTop(3)">@TopFace(3)</button>
            @* Q86（S14 本轮章）：顶栏“编队”只在空白操作时期可用；不可用时不打开，点击/悬停写具体原因（战斗与对白锁同其他入口）。
               敌踪/战斗中按钮照样禁用，但悬停写内核 FormationEditBlocked 的原因（“先处理眼前的敌踪”），不用统一的“战斗中锁定”（试玩修复 B8a 第 1 轮 B1） *@
            @{ var formWhy = G.Panel == "formation" ? null : G.FormationBlocked; }
            <button class="@(G.Panel == "formation" ? "on" : "") @(formWhy != null ? "off" : "")" disabled="@navOff" aria-disabled="@(formWhy != null)" data-nav="formation" aria-keyshortcuts="P"
                    title="@(G.DialogueLocked ? NavTitle("编队", -1) : formWhy != null ? $"现在不能编队：{formWhy}" : navOff ? NavTitle("编队", -1) : NavTitle("编队：安排开战号位（前排1→后排4），保存不花时间", 4))"
                    @onclick="() => ActivateTop(4)">@TopFace(4)</button>
            <button class="@(G.Panel == "gear" ? "on" : "")" disabled="@navOff" data-nav="gear" aria-keyshortcuts="G" title="@NavTitle("整备：七槽装备、随身五卡与队员交接（不花时间）", 5)" @onclick="() => ActivateTop(5)">@TopFace(5)</button>
            <button class="@(G.Panel == "growth" ? "on" : "")" disabled="@navOff" data-nav="growth" aria-keyshortcuts="K" title="@NavTitle("成长：十六门熟练度的十级轨道与技能节点", 6)" @onclick="() => ActivateTop(6)">@TopFace(6)</button>
            <button class="@(G.Panel == "goals" ? "on" : "")" disabled="@navOff" aria-keyshortcuts="J" title="@NavTitle("序章任务册：主目标、建议与完整18项", 7)" @onclick="() => ActivateTop(7)">@TopFace(7)</button>
            <button class="@(G.Panel == "tips" ? "on" : "")" disabled="@navOff" aria-keyshortcuts="T" title="@NavTitle("当前求生建议", 8)" @onclick="() => ActivateTop(8)">@TopFace(8)</button>
            <button class="@(G.Panel == "dialogs" ? "on" : "")" disabled="@navOff" aria-keyshortcuts="D" title="@NavTitle("已经展示过的人物对话", 9)" @onclick="() => ActivateTop(9)">@TopFace(9)</button>
            <button class="@(G.Panel == "help" ? "on" : "")" disabled="@navOff" aria-keyshortcuts="H" title="@NavTitle("各系统通用规则说明", 10)" @onclick="() => ActivateTop(10)">@TopFace(10)</button>
            <button class="@(G.MenuOpen || G.BattleMenuOpen ? "on" : "")" data-menu-key aria-keyshortcuts="Escape" title="@ShellKeys.MenuHover" @onclick="ToggleMenu">@TopFace(11)</button>
        </nav>
    </header>

    <main class="body" inert="@fullBattle">
        <Hud />

        @{
            // 顶栏面板（地图/制作/休息/日志/目标/提示/对话记录/说明）只覆盖①②两行，③当前地面、④随身不动（S14 §18.1：
            // 导航面板不得重新分配四行高度）；手工制作仍能把地面卡拖进材料槽
            var centerPanel = GameSession.IsTopPanel(G.Panel);
            // B31b（R55）：一级面板开着时中央行动位收成中部底部窄条，不盖面板里的按钮；三城鸟瞰沿用自己的右下角位置（B24）。
            var dockProgress = centerPanel && G.Panel != "citymap";
            // B31c（Q324）：没开面板、居中局部盘开着时同样收成窄条，居中盘不挡「退出行动」
            if (!centerPanel && G.LocalDiskOpen) dockProgress = true;
            // B31d（Q338）：居中局部盘开着时四轨加遮罩（点遮罩＝取消本盘）；窄条在遮罩之上
            _diskMask = G.DiskMaskShown;
        }
        @* 固定四行（S14 §18.1）：中部净高均分四份——①地图/场景 ②设施/资源 ③当前地面 ④随身；选卡、展开锅、悬停、开面板、对白、
           战斗都不改行高，行内放不下的在行内滚动（随身五张卡不滚动）。战斗/面板只占①②合并区域；普通对白（BM5a）覆盖③④。 *@
        <section class="center @(G.Panel == "citymap" ? "city-open" : "")" aria-label="当前地点">
            <div class="center-scroll four @(centerPanel ? "locked" : "") @(G.Panel == "craft" ? "craft-panel" : "") @(G.Panel is "gear" or "growth" or GameSession.FireMenuPanel ? "full-panel" : G.Panel is "craft" or "safehouse" or "drying" or "citymap" || (G.Panel == "city" && G.CityPanelTall) ? "tall-panel" : "") @(battleUi ? "battle" : "") @(dockProgress && (G.PauseLayerShown || progress != null) ? "docked-prog" : "")">
                <div class="rows2" data-row="1-2">
                    <div class="rows2-inner" inert="@dlgLock">
                        @* 全屏战斗时地块栏两行换成空白（组件替换而非叠加，拖拽不会收集到隐藏的落点） *@
                        @if (G.BattleFullscreen) { <div class="rows2-blank" aria-hidden="true"></div> }
                        else { <LocationStrip /> }
                    </div>
                    @if (centerPanel)
                    {
                        <div class="panel-host" data-panel="@G.Panel" inert="@dlgLock">
                            @switch (G.Panel)
                            {
                                case "map": <MapOverlay Part="center" /> break;
                                case "craft": <CraftOverlay Part="center" /> break;
                                case "rest": <RestOverlay Part="center" /> break;
                                case "log": <LogOverlay /> break;
                                case "goals": <GoalsOverlay /> break;
                                case "journey": <JourneyOverlay /> break;
                                case "city": <CityServiceOverlay /> break;
                                case "tips": <TipsOverlay /> break;
                                case "help": <HelpOverlay /> break;
                                case "dialogs": <DialogueLogOverlay /> break;
                                case "formation": <FormationOverlay /> break;
                                case "gear": <GearOverlay /> break;
                                case "growth": <GrowthOverlay /> break;
                                case "safehouse": <SafehouseOverlay /> break;
                                case "drying": <DryingOverlay /> break;
                                case GameSession.FireMenuPanel: <FireMenu /> break;
                                case "citymap": <CityOverview /> break;
                            }
                        </div>
                    }
                </div>
                <ItemShelf Owner="@s.Ground" Title="@(s.CurrentZone == GameState.SafehouseZone ? "屋内地面" : "当前地面")" Sub="@e.ZoneName(s, s.Ground)" />
                <ItemShelf Owner="@ItemInstance.Carried" Title="随身物品" />
                @* BM5a（S14「2026-11-13 试玩后续修订：对白恢复背景并覆盖下两行」，DLG-LOWER-A01—A06；取代 Q585 透明对白与 §10.1 只盖上两行）：
                   普通对白层是四行网格的直接子项，锚定③当前地面顶边至④随身物品底边，不透明底板叠在两栏之上、不挤动四行；
                   顶栏面板（含加工菜单、整备、成长等全屏面板）开着时仍按同一四行几何定位，层级高于面板。①②保持可见但随对白锁 inert。
                   全屏战斗中的对白在战场内专用区域显示（A10 §6.2），不走这里。 *@
                @if (!G.BattleFullscreen) { <DialogueLayer /> }
            </div>

            @if (_diskMask)
            {
                @* B31d（逐字稿 §1.2 Q338 选 B）：遮罩盖住四轨（含盖在四轨上的一级面板），点遮罩只撤回本盘未提交的意图，焦点回到仍存在的触发控件；
                   四轨的 inert（不能点、拖、取得键盘焦点）由 survivalPop 在盘真正显示时加上。中央行动位窄条在遮罩之上 *@
                <div class="disk-scrim" aria-hidden="true" @onclick="CancelDisk"></div>
            }

            @if (G.PauseLayerShown)
            {
                @* 暂停/补给：中央行动位嵌在「行动暂停中」弹窗正中一行；开着一级面板时收成底部窄条（B31b） *@
                <PauseLayer Docked="@dockProgress" />
            }
            else if (progress != null && !progress.DialogueWaiting)
            {
                <CentralProgress Info="progress" Docked="@dockProgress" />
            }
            else if (_fadeInfo != null)
            {
                @* 完成/退出/终止：150ms 淡出，期间不拦截操作 *@
                <CentralProgress Info="_fadeInfo" Fading="true" />
            }
        </section>

        <DetailPanel />

        @* 就近操作浮窗（S14 §14.1）：渲染在卡片之外（fixed 定位锚在卡旁），点击不会冒泡成卡片选择/使用/拖拽 *@
        <div class="apop-host" inert="@dlgLock">
            <ActionPops />
            @* 选卡操作（S14 §18.3）：锚定在所选卡片下方的紧凑浮窗，脱离文档流，不撑高所在行；同屏只有一个 *@
            <CardPop />
            @* B29：给同行者吃喝的局部盘，开着时选卡浮窗让位 *@
            <FeedPop />
            @* 点火工具菜单：锚定在火堆卡“点燃”按钮旁的浮窗，不在卡内撑高设施行（试玩修复 B1） *@
            @if (G.IgniteMenuOpen && !battleUi && e.HasFireAt(s, s.Ground) && !e.FacOf(s, s.Ground)!.FireLit) { <IgniteMenu /> }
        </div>

        @* 旧档非法同类双武器整理先于超五卡整理（B3 H8）；两者都只在安全空闲出现 *@
        @if (G.DuplicateWeaponsPending && !G.MenuOpen) { <DuplicateWeaponOverlay /> }
        else if (G.OverflowPending && !G.MenuOpen) { <OverflowOverlay /> }
        @if (G.MenuOpen && !battleUi && !s.Progress.Dead) { <MenuOverlay /> }
        @if (G.Panel == "abort" && !battleUi) { <ExpeditionAbort /> }
        @if (G.Panel == "seal" && !battleUi) { <ExpeditionSeal /> }
        @if (G.Panel == "reset" && !battleUi) { <DungeonReset /> }
        @if (G.BattleMenuOpen && battleUi && !G.BattleFullscreen && !s.Progress.Dead) { <MenuOverlay Battle="true" /> }
        <StatusPop />


        @if (G.Toast != null && !s.Progress.Dead && !fullBattle)
        {
            var bad = ResultToast.IsCritical(G.Toast);
            @* B22h 试玩修复（M448）：长结果（如带敌踪的撤退落点）在 1280 下两行放不下，放宽到最多五行、宽度稍大，完整内容仍在悬停提示。
               B31c（Q330）：危险、行动中止（.bad）保持到点 × 或下一次有效提交；一般提示约 8 秒先淡出再收起（.leaving，R114 toast） *@
            <div @key="G.Toast" class="toast @(bad ? "bad" : "") @(G.Toast.Text.Length > 80 ? "long" : "") @(G.ToastLeaving ? "leaving" : "")" role="@(bad ? "alert" : "status")">
                <span title="@G.Toast.Text">@G.Toast.Text</span>
                <button aria-label="关闭结果提示" @onclick="G.DismissToast">×</button>
            </div>
        }
    </main>

    <footer class="footer" inert="@fullBattle">
        @{ var last = G.Recent.LastOrDefault(); }
        <div class="event" title="@last?.Text">@if (last != null) {<b>@Clock.HHmm(last.Minute)</b>@last.Text}</div>
        <div>@(G.Running ? "时间流逝中…" : "浏览与整理不推进时间")</div>
        @* B40（S01 Q335 / Q387 / Q406 / Q408）：底栏保存状态——写权限提示与「在此页面继续保存」最先；自动档失败按槽各一行失败句加「重试」
           （没有写权限时重试禁用、悬停给原因）；否则写「已保存 {时:分}」（最近一次任何存档成功写入的浏览器本地时刻）；还没写过时留空。 *@
        @{ var sv = G.Saves; var autoFails = sv?.AutoFailures ?? (IReadOnlyList<Survival.Core.Save.SaveFailure>)Array.Empty<Survival.Core.Save.SaveFailure>(); }
        <div class="save @(autoFails.Count > 0 || sv?.PermissionNotice != null ? "failed" : "")">
            @if (sv?.PermissionNotice != null)
            {
                <span>@sv.PermissionNotice </span>
                @if (sv.CanReclaim)
                {
                    <button class="linkish" @onclick="G.ReclaimSaves">@Survival.Core.Save.SaveSlots.ReclaimButton</button>
                }
            }
            @foreach (var f in autoFails)
            {
                var kind = f.Kind;
                <span class="save-fail"><span>@f.Text </span><button class="linkish" disabled="@(sv!.RetryBlockedText != null)" title="@sv.RetryBlockedText" @onclick="() => G.RetrySlot(kind)">@Survival.Core.Save.SaveSlots.RetryButton</button></span>
            }
            @if (sv?.PermissionNotice == null && autoFails.Count == 0 && sv?.LastSavedAtMs is long savedMs)
            {
                <span class="saved">@(Survival.Core.Save.SaveSlots.SavedPrefix + G.LocalTime(savedMs, false))</span>
            }
        </div>
    </footer>
    @* BM6（S14 Q625，沿 Q612）：对白聚焦——普通对白（含全屏面板开着时）整屏其余背景（顶栏、左右栏、底栏、上方场景／设施与原打开页面）一次性压暗＋模糊，
       只有一层遮罩；对白层与原本就可用的顶栏「菜单」、底栏「在此页面继续保存」「重试」、结果提示 × 在遮罩的洞里保持原亮度、清晰与原权限（DialogueFocus.MainKeep），
       其余背景从入场到退场完成都点不穿。全屏战斗由 BattleScreen 自己的一层负责；死亡结算不亮。读档恢复的在办对白直接静态聚焦（.static） *@
    <div class="dlg-focus main @(DialogueFocus.MainOn(dlgLock, fullBattle, s.Progress.Dead) ? "on" : "") @(dlgLock && G.FocusStaticDialogue != null && G.FocusStaticDialogue == e.ActiveDialogue(s)?.Id ? "static" : "")" data-keep="@DialogueFocus.MainKeep" aria-hidden="true"></div>
    @if (fullBattle) { <BattleScreen /> }
</div>

<DropQuantity />
<EndScreens />
@* B34b（R03 §Q572）：战斗已经收束（胜利、撤退、死亡）时，最后几段特写在结算画面之上播完或被跳过，再露出收束画面；菜单在它之上 *@
@* B34 试玩修复 B2（S14 Q528.2）：自然胜利／撤退收束时已打开的全记录持有本场最终只读内容；最后几段特写仍在它之上播完 *@
@if (G.EndedLog != null && !G.InBattleUi && !G.BattleClosingHold && !G.S.Progress.Dead) { <EndedBattleLog /> }
@* B34 试玩修复 E2（Q572-A01）：撤退成功等收束前的短反馈停留——透明层接住点击／Enter／Space，不穿透到冻结的战斗画面。
   BM7a（S14 Q633）：不可跳过，点击什么也不做；ESC 记下，停留自然结束后再开菜单 *@
@if (G.BattleClosingHold) { <div class="bfx-hold" data-active></div> }
@if (G.PlaybackActive && !G.InBattleUi) { <BattleFxLayer /> }
@if (G.MenuOpen && G.S.Progress.Dead)
{
    @* B31d（逐字稿 §1.2 Q333 选 A）：死亡结算页的「菜单」或 Esc 打开的游戏菜单——盖在结算层之上（结算层在 .game 之外），只开放阅读字体、动画速度与
       「反馈与留言」，关闭回到同一结算。外层带 .wasteland 以沿用游戏菜单的按钮与偏好样式 *@
    <div class="wasteland end-menu"><MenuOverlay /></div>
}

@code {
    private DotNetObjectReference<GameScreen>? _ref;
    private DotNetObjectReference<DragController>? _drag;
    private DotNetObjectReference<PeekController>? _peek;

    private string? _topKey;
    /// <summary>BM4a：上一帧显示的面板（判断是新开还是恢复，新开的清掉 app.js 里的旧滚动／焦点记忆）。</summary>
    private string? _panelSeen;
    private string? _selKey;

    private bool _lockSeen;
    private bool _diskMask;
    private ActionProgressInfo? _lastInfo;
    private ActionProgressInfo? _fadeInfo;

    /// <summary>中央条淡出 150ms（UI 初值，S14 §11.2）后移除；只是表现，不推进 tick、不拦截操作。</summary>
    private async Task FadeOut(ActionProgressInfo info)
    {
        await Task.Delay(G.MotionMs(150));
        if (!ReferenceEquals(_fadeInfo, info)) return;
        _fadeInfo = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>B34 试玩修复 E2：收束前短反馈停留期间外壳照常绘制（承接透明层、点亮冻结画面上的锚点）。</summary>
    protected override bool RenderDuringClosingHold => true;

    private object? _holdShown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (G.ClosingPulse is { } hp && !ReferenceEquals(hp, _holdShown))
        {
            _holdShown = hp;
            try { await JS.InvokeVoidAsync("survivalBattleUi.holdPulse", hp.Actor.Side, hp.Actor.Id, hp.Name); }
            catch (JSException) { }
        }
        // 对话出现：取消未提交的拖拽（物品保持原归属，不补一次松手），收起键盘焦点，避免回车/空格落到背后的按钮（S07 §7）
        var locked = G.DialogueLocked;
        if (locked && !_lockSeen)
        {
            try { await JS.InvokeVoidAsync("survival.dialogueOnset"); }
            catch (JSException) { }
        }
        // B45b（Q585 首段）：首次火堆引导等对白盖在火堆加工菜单上，读完回到同一菜单并恢复焦点（不再开一次引导、不执行）
        else if (!locked && _lockSeen && G.Panel == GameSession.FireMenuPanel)
        {
            try { await JS.InvokeVoidAsync("survival.dialogueEnd", ".fire-menu"); }
            catch (JSException) { }
        }
        _lockSeen = locked;
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("survival.hookKeys", _ref);
            _drag = DotNetObjectReference.Create(new DragController(G));
            await JS.InvokeVoidAsync("survivalDrag.init", _drag, G.E.Config.Ui.DragThresholdPx);
            // B42（S14 2026-11-12）：悬停／键盘焦点进入对象热区，右栏立即只读显示该对象
            _peek = DotNetObjectReference.Create(new PeekController(G));
            try { await JS.InvokeVoidAsync("survivalPeek.init", _peek); } catch (JSException) { /* 旧缓存 app.js：只是没有悬停查看，点击照常 */ }
            // B31d（Q336）：游戏菜单版本行的实际构建
            try { G.AppBuild = await JS.InvokeAsync<string>("survival.appBuild"); } catch (JSException) { /* 旧缓存 app.js：版本行省略构建段 */ }
        }
        // B32b（Q367、Q370）：成功的拾取、放下、拖拽转移播一次轨迹；实际切换地点或场景时旧景淡出、新景淡入
        if (G.State != null)
        {
            var sw = G.TakeSwap();
            try
            {
                if (sw is { } x) await JS.InvokeVoidAsync("survivalFx.swap", x.Owner, x.ItemId);
                // B33（Q435）：整备更换、交接、卸下与右栏快捷卸下的成功轨迹（起点在提交前已 mark）
                if (G.TakeFly() is string fly) await JS.InvokeVoidAsync("survivalFx.fly", fly);
                if (G.TakeLit() is string lit) await JS.InvokeVoidAsync("survivalFx.litIfVisible", lit);
                await JS.InvokeVoidAsync("survivalFx.sceneSync", G.SceneSerial);
            }
            catch (JSException) { /* 旧缓存 app.js：只少了表现，结果照常 */ }
        }
        // B32g（逐字稿 §1.5 Q401 选 C）：新开的一级浏览／工具面板已收起原物品操作盘；盘卸下、遮罩解除后焦点交给新面板第一个可用控件
        // B45：关闭火堆加工菜单后焦点回原火堆卡（卡已失效则不动）
        if (G.FocusIdPending is string fid)
        {
            G.FocusIdPending = null;
            G.FocusIdSoftPending = null;
            try { await JS.InvokeVoidAsync("survivalPop.focusId", fid); }
            catch (JSException) { /* 旧缓存 app.js：焦点留在原处 */ }
        }
        // BM5b1（Q604）：加工菜单里内容自动消失／失效后的焦点修复——只在当前焦点因此失效（落到页面本身）时才交给相关加工位卡或菜单标题
        else if (G.FocusIdSoftPending is string sfid)
        {
            G.FocusIdSoftPending = null;
            try { await JS.InvokeVoidAsync("survivalPop.focusIdIfLost", sfid); }
            catch (JSException) { /* 旧缓存 app.js：焦点留在原处 */ }
        }
        // BM4a（Q590）：关上层后恢复的那一层取回它自己的滚动与发起焦点（失效回该层标题）；新开的面板不沿用旧记忆
        var shownPanel = GameSession.IsTopPanel(G.Panel) ? G.Panel : null;
        if (G.PanelRestorePending is string rk)
        {
            G.PanelRestorePending = null;
            _panelSeen = shownPanel;
            if (rk == shownPanel)
            {
                try { await JS.InvokeVoidAsync("survivalPanels.restore", rk); }
                catch (JSException) { /* 旧缓存 app.js：只是不恢复滚动与焦点 */ }
            }
        }
        else if (shownPanel != _panelSeen)
        {
            _panelSeen = shownPanel;
            if (shownPanel != null)
            {
                try { await JS.InvokeVoidAsync("survivalPanels.forget", shownPanel); }
                catch (JSException) { }
            }
        }
        if (G.PanelFocusPending)
        {
            G.PanelFocusPending = false;
            try { await JS.InvokeVoidAsync("survivalPop.focusPanel"); }
            catch (JSException) { /* 旧缓存 app.js：焦点留在原处，收盘结果照常 */ }
        }
        // B31d（Q338）：Pop 失效在子组件渲染时被静默丢掉（ActionPops.Valid），遮罩这一帧已画出；与当前状态不符时再渲染一次
        if (G.State != null && _diskMask != G.DiskMaskShown) StateHasChanged();
        // 中部二级面板（地图/制作/休息/日志）打开、战斗或敌踪出现（含读档恢复）时，中部纵滚回顶，
        // 面板与覆盖层才能完整替换地块两行，不被之前的滚动位置切掉标题（试玩修复 G1、G2）
        if (G.State != null)
        {
            var panel = GameSession.IsTopPanel(G.Panel) ? G.Panel : "";
            var mode = G.S.Battle != null ? "battle" : "";
            var key = panel + "|" + mode;
            if (key != _topKey)
            {
                var need = panel != "" || mode != "";
                _topKey = key;
                if (need) await JS.InvokeVoidAsync("survival.centerTop");
            }
            var sk = G.Selected.Key;
            if (sk != _selKey)
            {
                _selKey = sk;
                if (G.Selected.Kind != SelectionKind.None) await JS.InvokeVoidAsync("survival.revealBar");
            }
        }
    }

    /// <summary>BM4a（Q590）：顶栏按钮与快捷键——当前最上层就是它则关闭并返回下层，否则盖在原窗口上打开（原窗口留在下层，已在下层则提到最上层）。</summary>
    private void Toggle(string panel) => G.OpenTopPanel(panel);

    /// <summary>编队按钮：开着就取消草稿关闭；不在空白操作时期就只提示原因（OpenFormation 内判断）。</summary>
    private void ToggleFormation()
    {
        if (G.Panel == "formation") G.CancelFormation();
        // BM4a（Q590）：编队页已在下层（草稿未提交）时提到最上层，沿用原草稿，不另建一份
        else if (G.PanelsUnder.Contains("formation")) G.OpenTopPanel("formation");
        else G.OpenFormation();
    }

    /// <summary>悬停提示：原说明后接同一键位（与按钮上的键帽同源 ShellKeys.TopCaps）；i&lt;0 不带键。</summary>
    private string NavTitle(string what, int i)
    {
        if (G.DialogueLocked) return "请先读完对话";
        if (G.InBattleUi) return "战斗中锁定";
        return i < 0 ? what : $"{what}（{ShellKeys.TopCaps[i]}）";
    }

    /// <summary>B43：顶栏按钮面——功能名与键帽同时常驻（读屏名「功能名 键位」）。</summary>
    private RenderFragment TopFace(int i) => __builder =>
    {
        <span class="nk-name">@ShellText.TopKeys[i]</span> <kbd class="kc">@ShellKeys.TopCaps[i]</kbd>
    };

    /// <summary>
    /// B43：顶栏第 i 个功能（0—10），鼠标点按钮与键盘快捷键共用：编队沿原编队流程（开着就取消草稿关闭，不保存、不提交），其余打开／收起对应面板。
    /// 可用条件由调用方保证与按钮一致（按钮 disabled；OnKey 在对白锁、菜单、战斗与敌踪、死亡结算时不调用）。
    /// </summary>
    private void ActivateTop(int i)
    {
        switch (i)
        {
            case 0: Toggle("map"); break;
            case 1: Toggle("craft"); break;
            case 2: Toggle("rest"); break;
            case 3: Toggle("log"); break;
            case 4: ToggleFormation(); break;
            case 5: Toggle("gear"); break;
            case 6: Toggle("growth"); break;
            case 7: Toggle("goals"); break;
            case 8: Toggle("tips"); break;
            case 9: Toggle("dialogs"); break;
            case 10: Toggle("help"); break;
        }
    }

    /// <summary>顶栏「菜单」：战斗与敌踪开战斗菜单，其余（含对白锁、行动推进、暂停）开游戏菜单（Q322）。</summary>
    private void ToggleMenu()
    {
        if (G.InBattleUi) G.ToggleBattleMenu();
        else G.SetMenu(!G.MenuOpen);
    }

    [JSInvokable]
    public void OnKey(string key)
    {
        if (G.State == null) return;
        if (G.BattleClosingHold) { if (key == "Escape") G.ClosingHoldEscape(); return; }   // B34 试玩修复 E2；BM7a（Q633）：停留不可跳过，ESC 停留后开菜单
        // BM5c（S14 Q605）：探索遭遇短提示——点击／Enter／Space 只跳过提示；ESC 打开战斗菜单（冻结计时），菜单开着时 ESC 按原路由关闭；其余键不穿透
        if (G.EncounterPromptActive)
        {
            if (key == "Skip") G.SkipEncounterPrompt();
            else if (key == "Escape") { if (!G.BattleMenuOpen && !G.MenuOpen) G.ToggleBattleMenu(true); else Escape(); }
            return;
        }
        if (key == "Escape") { Escape(); return; }
        // B34b（S14 Q572）：特写播放层独占画面点击、Enter、Space；BM7a（Q633）：敌我出手都不可跳过——这些输入被播放层接住、什么也不做
        if (key == "Skip") return;
        if (G.PlaybackActive && !G.FxUnderReading) return;
        if (G.EndedLog != null && !G.InBattleUi) return;   // B34 试玩修复 B2：只读记录页屏蔽背后快捷键，只认 ESC
        // 死亡结算（B31d Q333）：只有 Esc（同结算页「菜单」键），其余快捷键无效
        if (G.S.Progress.Dead) return;
        // 对话读完锁（Q10、S14 §10.1）与菜单打开时：快捷键全部无效，只有 Esc（开关菜单）
        if (G.DialogueLocked || G.MenuOpen || G.BattleMenuOpen) return;
        if (G.BattleFullscreen)
        {
            // 全屏战斗（A10 §6.3）：M/C/R/L 锁定
            // B34a（S14 Q528.2／Q570）：只读子页（物资、装备、战斗记录、预测详情、操作提示、说明）开着时背后的数字指令、切页与回车确认都不受理
            if (G.BattleDrawer != null) return;
            switch (key)
            {
                case "1" or "2" or "3" or "4" or "5": G.BattleHotkeySkill(key[0] - '0'); break;
                case "Q": G.SelectWeaponPage(1); break;
                case "E": G.SelectWeaponPage(2); break;
                case "ArrowLeft": G.BattleCycleTarget(-1); break;
                case "ArrowRight": G.BattleCycleTarget(1); break;
                case "Enter": _ = G.BattleConfirmHover(); break;
            }
            return;
        }
        // 敌踪选择中：顶栏字母锁定（同按钮禁用）
        if (G.InBattleUi) return;
        // B43：顶栏 11 个字母键（M C R L P G K J T D H）各触发同一按钮一次；F 不绑定
        var top = ShellKeys.TopIndexOf(key);
        if (top >= 0) ActivateTop(top);
    }

    /// <summary>
    /// Esc（逐字稿 §1.1 Q322，判定在内核 <see cref="ShellEsc"/>）：先按原层级收起最上方看得见、可关闭的子层；没有时打开当前情境的游戏菜单——
    /// 战斗／敌踪、强制对白、行动推进和暂停均可。对白本身不由 Esc 结束；Esc 不取消主行动、不当作“退出”（S14 §7、§11.2）。
    /// </summary>
    private void Escape()
    {
        // B34b（S14 Q572）：播放中只有 ESC 打开当前情境菜单（战斗中为战斗菜单，已收束为游戏菜单）；菜单沿原阅读暂停停住当前帧。
        // 只读子页开着时它是最上层，ESC 先按原层级收它。菜单已开时交给下面的原路由关闭。
        if (G.PlaybackActive && !G.MenuOpen && !G.BattleMenuOpen)
        {
            if (G.FxUnderReading) G.BattleEscape();
            else if (G.InBattleUi && !G.S.Progress.Dead) G.ToggleBattleMenu(true);
            else G.SetMenu(true);
            return;
        }
        var full = G.BattleFullscreen;
        var dead = G.S.Progress.Dead;
        var route = ShellEsc.Route(new ShellEscInput
        {
            Dead = dead,
            DialogueLocked = G.DialogueLocked,
            BattleUi = G.InBattleUi,
            MenuOpen = G.MenuOpen,
            BattleMenuOpen = G.BattleMenuOpen,
            MenuSubPage = !dead && G.ManualPageOpen,
            HasClosableLayer = dead ? G.DeathLogOpen : full ? G.BattleHasEscLayer : G.NormalEscOwner() != EscOwner.OpenMenu,
        });
        // B31d（Q333）：死亡结算页上 Esc 只在结算页这几层之间走：先收「查看记录」，再开／关结算菜单
        if (dead)
        {
            if (route == ShellEscRoute.CloseLayer) G.SetDeathLog(false);
            else if (route == ShellEscRoute.OpenMenu) G.SetMenu(true);
            else if (route == ShellEscRoute.CloseMenu) G.SetMenu(false);
            return;
        }
        switch (route)
        {
            case ShellEscRoute.CloseMenu: G.SetMenu(false); break;
            // BM2（Q500）：手动存档子页先收覆盖确认，再回菜单首页；菜单首页再按 ESC 才关菜单
            case ShellEscRoute.CloseMenuSubPage: G.ManualPageEscape(); break;
            case ShellEscRoute.CloseBattleMenu: G.ToggleBattleMenu(false); break;
            case ShellEscRoute.OpenMenu: G.SetMenu(true); break;
            case ShellEscRoute.OpenBattleMenu: G.ToggleBattleMenu(true); break;
            case ShellEscRoute.CloseLayer:
                if (full) G.BattleEscape();
                else NormalStep();
                break;
        }
    }

    /// <summary>常态逐层收，每次只退一级（顺序在 GameSession.NormalEscOwner，B43 起与界面上的 ESC 键帽同源）。</summary>
    private void NormalStep()
    {
        switch (G.NormalEscOwner())
        {
            case EscOwner.EndedLog: G.CloseEndedLog(); break;
            case EscOwner.DropQty: G.CancelDropQuantity(); break;
            case EscOwner.Status: G.PinStatus(null); break;
            // B31d（Q338）：居中局部盘是当前操作层，Esc 先撤回本盘（同点遮罩），焦点回到触发控件
            case EscOwner.Disk: CancelDisk(); break;
            case EscOwner.Pop: G.ClosePop(); break;
            // B24（A10-CITY §7）：鸟瞰里 Esc 先收固定说明/确认窗，再关鸟瞰；不撤销已发生的移动
            case EscOwner.CityPick: G.PickCity(null); break;
            case EscOwner.CityMap: G.OpenPanel(null); break;
            case EscOwner.Ignite: G.Hover(null); G.CloseIgniteMenu(); break;
            // B10 试玩修复 2/6：最上层先退——交接确认浮窗、面板开着时选中卡的操作浮窗，再到面板本身
            case EscOwner.Feed: G.CancelFeed(); break;
            // B33（Q453-8、Q460）：整备交接盘→比较／来源工作区→空态逐层退回，空态时下一步才关整备
            case EscOwner.GearSub: G.GearBack(); break;
            // B32d（Q378）：选卡盘已因来源被面板盖住收起时，Esc 直接退面板（焦点已交给面板），不先清选中
            case EscOwner.PanelSelection: G.ClearSelection(); break;
            case EscOwner.HelpBack: G.HelpBack(); break;
            case EscOwner.FacBack: G.FireMenuBack(); break;
            // BM4a（Q554）：成长页练习盘开着时 ESC 与盘内「返回」同效，只收盘、丢草稿，焦点回「练习潜行」入口；下一次 ESC 才关成长页
            case EscOwner.PracticeBack: G.ClosePractice(); break;
            // B45（Q560）：经「选择设施」进入的制作面板先回选择层
            case EscOwner.Panel: G.PanelEscape(); break;
            case EscOwner.CharPage: G.OpenCharPage(null); break;
            case EscOwner.Selection: G.ClearSelection(); break;
            case EscOwner.FeedTail: G.CancelFeed(); break;
        }
    }

    /// <summary>B31d（Q338）：点遮罩或 Esc 撤回本盘——先告诉 survivalPop 这是取消（收盘后把焦点还给触发控件），再按该盘自己的取消处理。</summary>
    private void CancelDisk()
    {
        try { if (JS is IJSInProcessRuntime ip) ip.InvokeVoid("survivalPop.markCancel"); }
        catch (JSException) { /* 旧缓存 app.js：只收盘、不还焦点 */ }
        G.CancelLocalDisk();
    }

    public override void Dispose()
    {
        base.Dispose();
        _ref?.Dispose();
        _drag?.Dispose();
        _peek?.Dispose();
    }
}
