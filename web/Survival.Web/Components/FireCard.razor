@inherits GameComponent

@* 火堆／柴炉设施卡。B32b（逐字稿 §1.2 Q339 选 C、Q350，§1.5 Q362、Q372）：第二轨只放这一张卡，用重墨 V2 卡模板——
   副标「燃料{当前}/{上限}分钟」，角标燃烧状态「燃烧中／熄灭／未点燃」，两个加工位都占用时另加「加工位满」；任一加工位实际受热时挂加工中。
   卡上保留设施级入口：投入木材、点燃（打开点火盘）／熄灭、等待加工。点卡查看右栏火堆详情：两个加工位、锅及其水和食材从右栏进入（Q323 的局部例外）。
   整张卡面仍是 fire: 落点（木材投料、打火器直接点火、锅和生块根进空加工位）。
   选中火堆里的锅、水或食材时，本卡带 id="card-sel" 作为选卡操作盘的来源（原先锅卡嵌在火堆卡里，来源滚出或消失时照原规则收盘）。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.Ground;   // B17：当前所在区（外部或安全屋屋内）的火堆
    var fac = e.FacOf(s, here)!;
    var slots = e.FireSlots(s, here);
    var state = CardStates.FireStateText(fac);
    var name = CardStates.FireName(fac);
    var fireId = GameEngine.FireIdOf(here);
    var selected = G.Selected.Kind == SelectionKind.Facility && G.Selected.Id == fireId;
    var childSelected = G.SelectedInFire != null;
    // 火堆维护（投料、熄灭、点火）：空闲或主行动暂停时可做，移动途中与执行中不可（拖拽与容器案 8）
    var maintBlocked = G.Running || s.Sub != null || (s.Main != null && (s.Main.Status != ActionStatus.Paused || s.Main.Type == ActionType.Travel));
    var wood = e.AvailableCount(s, "wood", true);
    var room = e.MaxWoodForFire(fac);
    var hasContent = slots.Any(x => x != null);
    var full = slots.Count > 0 && slots.All(x => x != null);
    var woodWhy = maintBlocked ? "行动进行中，暂不能维护火堆" : room < 1 ? $"至少需要{e.Config.Fire.BurnMinutesPerWood}分钟空余容量（燃料上限{e.FuelCapOf(fac)}分钟）" : wood < 1 ? "随身和当前地面没有木材" : null;
    // Q368：成品落在加工位而右栏没在看这只火堆时，亮火堆卡一次
    var fresh = !selected && !childSelected && G.Highlights.Any(h => h.StartsWith($"slot:fire:{here}:", StringComparison.Ordinal));
    var tip = fac.StoveInstanceId.HasValue ? "折叠柴炉：收起请选中地面上的柴炉卡（先取空、熄火；剩余燃料要明确放弃）。点卡查看两个加工位"
        : s.CurrentZone == GameState.SafehouseZone ? "安全屋屋内火堆（与外部火堆分开）。点卡查看两个加工位；木材、打火器、锅和生块根可拖到卡上"
        : fac.FireBuilt ? "野外固定火堆（不能拾取或拆除，不挡遭遇）。点卡查看两个加工位；木材、打火器、锅和生块根可拖到卡上"
        : "点卡查看两个加工位；木材、打火器、锅和生块根可拖到卡上";
}
<ObjectCard Ink2="true" Id="@(childSelected ? "card-sel" : "fire-card")" CssClass="@(fac.FireLit ? "k2-fire lit" : "k2-fire")" Title="@name"
            Badge="@state" BadgeClass="@(fac.FireLit ? "lit" : "")" Badge2="@(full ? CardStates.FireSlotsFull : null)"
            Selected="@(selected || childSelected)" Busy="@e.FireHeating(s, here)" Fresh="@fresh"
            Sub="@CardStates.FireFuelSub(e, fac)" Tooltip="@tip" AriaLabel="@($"{name}，{state}，燃料{fac.FuelMinutes}分钟")"
            DataDrop="@($"fire:{here}")" OnClick="G.SelectFire">
    <Art>@Icons.Markup(fac.FireLit ? "fire_lit" : "fire_out")</Art>
    <Line2><div class="fuel-track"><i style="width:@(fac.FuelMinutes * 100 / Math.Max(1, e.FuelCapOf(fac)))%"></i></div></Line2>
    <Footer>
        <button type="button" class="loc-btn res-btn fc-btn" disabled="@(woodWhy != null)" title="@(woodWhy ?? $"投入1木材，燃料+{e.Config.Fire.BurnMinutesPerWood}分钟，不耗时（可用{wood}）")"
                @onclick="AddFuel" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><strong>投入木材</strong><small>余@(wood)</small></button>
        @if (fac.FireLit)
        {
            <button type="button" class="loc-btn res-btn fc-btn plain" disabled="@maintBlocked" title="熄灭火堆，剩余燃料保留"
                    @onclick="Extinguish" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><strong>熄灭</strong></button>
        }
        else
        {
            <button type="button" id="fc-ignite" class="loc-btn res-btn fc-btn ignite @(G.IgniteMenuOpen ? "on" : "")" aria-haspopup="dialog" aria-expanded="@G.IgniteMenuOpen"
                    title="打开点火盘：先选一把打火器，再点「点火」" @onclick="G.ToggleIgniteMenu" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><strong>点燃</strong></button>
        }
        @if (hasContent)
        {
            @* 等待加工（原“等待烹饪”，Q111 起含煅烧；S14 §11.3、S09 §7、S11 §9）：火堆里有内容时出现，绑定本火堆；悬停/聚焦在右栏预览；
               点击直接开始，不另加确认；不可开始时禁用并在按钮上写明原因。不会自动点火、加木、补水或开第二个主行动。 *@
            var plan = G.CookWaitPreview();
            var cookWhy = plan.Ok ? null : plan.Reason;
            <button type="button" class="loc-btn res-btn fc-btn cook" disabled="@(cookWhy != null || cooking)" title="@(cookWhy ?? "点击直接开始：等本火堆当前全部可加工内容完成；右侧显示预览")"
                    @onmouseenter="HoverCook" @onfocus="HoverCook" @onmouseleave="Unhover" @onblur="Unhover" @onclick="StartCook" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <strong>等待加工</strong><small>@(cookWhy != null ? ShortReason(cookWhy) : plan.EstimatedMinutes is int m ? $"预计{Clock.Duration(m)}" : "燃料耗尽时停止")</small>
            </button>
        }
    </Footer>
</ObjectCard>

@code {
    private static readonly ActionRequest CookReq = ActionRequest.WaitCook();

    /// <summary>按钮上只放原因主句（括号与冒号后的补充说明在悬停提示里看全文；B10b 试玩修复：1280 下“火堆未燃烧：请先点火”被截）。</summary>
    private static string ShortReason(string why)
    {
        var k = why.IndexOf('（');
        if (k > 0) why = why[..k];
        var c = why.IndexOf('：');
        return c > 0 ? why[..c] : why;
    }
    private bool cooking;

    private void HoverCook() => G.Hover(CookReq, "等待加工");
    private void Unhover() => G.Hover(null);

    private async Task StartCook()
    {
        if (cooking || G.Running) return;
        cooking = true;
        try
        {
            G.Hover(null);
            await G.StartAction(ActionRequest.WaitCook());
        }
        finally
        {
            cooking = false;
        }
    }

    private void AddFuel() => G.Instant(InstantRequest.AddFuel());
    private void Extinguish() => G.Instant(InstantRequest.Extinguish());
}
