@inherits GameComponent

@* 火堆／柴炉设施卡。B32b（逐字稿 §1.2 Q339 选 C、Q350，§1.5 Q362、Q372）：第二轨只放这一张卡，用重墨 V2 卡模板——
   副标「燃料{当前}/{上限}分钟」，角标燃烧状态「燃烧中／熄灭／未点燃」，两个加工位都占用时另加「加工位满」；任一加工位实际受热时挂加工中。
   卡上保留设施级入口：投入木材、点燃（打开点火盘）／熄灭、等待加工。点卡查看右栏火堆详情：两个加工位、锅及其水和食材从右栏进入（Q323 的局部例外）。
   整张卡面仍是 fire: 落点（木材投料、打火器直接点火、锅和生块根进空加工位）。
   选中火堆里的锅、水或食材时，本卡带 id="card-sel" 作为选卡操作盘的来源（原先锅卡嵌在火堆卡里，来源滚出或消失时照原规则收盘）。
   B45（S14「设施加工改在中央次级菜单操作」、Q546）：点卡主体打开中央加工菜单（G.OpenFireMenu），悬停仍只看右栏；卡上投木／点燃／熄灭／等待加工
   阻止冒泡、语义不变。火堆内容不再用选卡盘执行，本卡 id 固定 fire-card（关闭菜单后焦点回这里）。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.Ground;   // B17：当前所在区（外部或安全屋屋内）的火堆
    var fac = e.FacOf(s, here)!;
    var slots = e.FireSlots(s, here);
    var state = CardStates.FireStateText(fac);
    var name = CardStates.FireName(fac);
    var fireId = GameEngine.FireIdOf(here);
    var selected = G.Selected.Kind == SelectionKind.Facility && G.Selected.Id == fireId;
    var childSelected = G.SelectedInFire != null;
    var full = slots.Count > 0 && slots.All(x => x != null);
    // Q368：成品落在加工位而右栏没在看这只火堆时，亮火堆卡一次
    var fresh = !selected && !childSelected && G.Highlights.Any(h => h.StartsWith($"slot:fire:{here}:", StringComparison.Ordinal));
    // B45（逐字稿 Q546 火堆卡悬停全文）
    var tip = fac.StoveInstanceId.HasValue ? "折叠柴炉：收起请选中地面上的柴炉卡（先取空、熄火；剩余燃料要明确放弃）。悬停查看信息，点击打开加工菜单。"
        : s.CurrentZone == GameState.SafehouseZone ? "安全屋屋内火堆（与外部火堆分开）。悬停查看信息，点击打开加工菜单。木材、打火器、锅和生块根可拖到卡上。"
        : fac.FireBuilt ? "野外固定火堆（不能拾取或拆除，不挡遭遇）。悬停查看信息，点击打开加工菜单。木材、打火器、锅和生块根可拖到卡上。"
        : "悬停查看信息，点击打开加工菜单。木材、打火器、锅和生块根可拖到卡上。";
}
<ObjectCard Ink2="true" Id="fire-card" PeekId="@Peek.Sel(SelectionKind.Facility, GameEngine.FireIdOf(here))" CssClass="@(fac.FireLit ? "k2-fire lit" : "k2-fire")" Title="@name"
            Badge="@state" BadgeClass="@(fac.FireLit ? "lit" : "")" Badge2="@(full ? CardStates.FireSlotsFull : null)"
            Selected="@(selected || childSelected)" Busy="@e.FireHeating(s, here)" Fresh="@fresh"
            Sub="@CardStates.FireFuelSub(e, fac)" Tooltip="@tip" AriaLabel="@($"{name}，{state}，燃料{fac.FuelMinutes}分钟")"
            DataDrop="@($"fire:{here}")" OnClick="G.OpenFireMenu">
    <Art>@Icons.Markup(fac.FireLit ? "fire_lit" : "fire_out")</Art>
    <Line2><div class="fuel-track"><i style="width:@(fac.FuelMinutes * 100 / Math.Max(1, e.FuelCapOf(fac)))%"></i></div></Line2>
    <Footer>
        @* B45b（Q581）：卡面快捷入口与火堆加工菜单主层同一组件（FireQuickActions），按钮原句、条件、原因、工具选择、耗时与结算同源 *@
        <FireQuickActions />
    </Footer>
</ObjectCard>
