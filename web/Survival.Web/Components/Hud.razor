@inherits GameComponent

@* 左栏（S14 §5.1、§12）：时间、基础状态数值/条、各属性下方的实际生效状态图标、携重摘要。
   原“生存目标”“生存提示”长板块已迁到顶栏同名按钮（S14 §12.3、S15 §6）；点属性在右栏打开该属性的二级说明页。 *@
@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    var day = e.IsDaylight(s.GameMinute);
    var toSwitch = Clock.MinutesToSwitch(s.GameMinute, cfg.Time.DaylightStartMinute, cfg.Time.DaylightEndMinute);
    var grams = e.CarriedGrams(s);
    var currentDay = Clock.Day(s.GameMinute);
    var chips = StatusView.Ordered(StatusView.All(e, s));
    var locked = G.DialogueLocked;
}

<aside class="sidebar" aria-label="求生状态" inert="@locked">
    <div class="panel clock">
        <div class="eyebrow">存活第@(currentDay)日</div>
        <div class="time">@Clock.HHmm(s.GameMinute)</div>
        <div class="sun">@(day ? "白昼" : "夜间") · 距@(day ? "入夜" : "天亮")@Clock.Duration(toSwitch)</div>
    </div>

    <div class="panel vitals">
        @foreach (var id in Stats.All)
        {
            var v = s.Stats.Get(id);
            var key = GameEngine.StatKey(id);
            var th = cfg.Thresholds[key];
            var below = th.IsBelow(v);
            var zero = v <= 0;
            var cls = zero || (id == StatId.Health && below) ? "critical" : below ? "warning" : "";
            var statId = id;
            <button class="vital @cls" data-stat="@key" @onclick="() => OpenStat(statId)" title="@($"在右栏查看{GameEngine.StatName(id)}说明")">
                <VitalIcon Stat="@key" />
                <div class="vital-label">
                    <span>@GameEngine.StatName(id)@if (zero && id != StatId.Health) {<em class="flag danger-text">归零</em>} else if (below) {<em class="flag">偏低</em>}</span>
                    <b>@Ui.N(v) <small class="muted">/@Ui.T(s.Stats.Max(id))</small></b>
                </div>
                <div class="track"><i style="width:@Ui.Bar(v, s.Stats.Max(id))%"></i><span class="mark" style="left:@Ui.Bar(th.Value, s.Stats.Max(id))%"></span></div>
            </button>
            <StatusIcons Chips="@chips.Where(c => c.Anchor == key).ToList()" Label="@GameEngine.StatName(id)" />
        }
        @* v0.6 §07：免疫与病毒；病毒未感染写“未感染” *@
        @{
            var body = s.Body;
            var immLow = body.Immunity < 40;
        }
        <button class="vital @(immLow ? "warning" : "")" data-stat="immunity" @onclick='() => G.OpenCharPage("immunity")' title="在右栏查看免疫力说明">
            <VitalIcon Stat="immunity" />
            <div class="vital-label">
                <span>@("免疫")@if (immLow) {<em class="flag">偏低</em>}</span>
                <b>@Ui.N(body.Immunity) <small class="muted">/@Ui.T(cfg.Immunity.Max)</small></b>
            </div>
            <div class="track"><i style="width:@Ui.Bar(body.Immunity, cfg.Immunity.Max)%"></i><span class="mark" style="left:@Ui.Bar(cfg.Infection.NaturalCure.ConsecutiveImmunityAtLeast, cfg.Immunity.Max)%"></span></div>
        </button>
        <StatusIcons Chips="@chips.Where(c => c.Anchor == "immunity").ToList()" Label="免疫" />
        <button class="vital @(body.Infected ? (body.VirusLoad >= 50 ? "critical" : "warning") : "")" data-stat="virus" @onclick='() => G.OpenCharPage("virus")' title="在右栏查看病毒说明">
            <VitalIcon Stat="virus" />
            <div class="vital-label">
                <span>@("病毒")@if (body.Infected) {<em class="flag danger-text">已感染</em>}</span>
                <b>@(body.Infected ? Ui.N(body.VirusLoad) : "未感染")@if (body.Infected) {<small class="muted">/@Ui.T(cfg.Infection.ZombificationAtLoad)</small>}</b>
            </div>
            <div class="track"><i style="width:@Ui.Bar(body.VirusLoad, cfg.Infection.ZombificationAtLoad)%"></i></div>
        </button>
        <StatusIcons Chips="@chips.Where(c => c.Anchor == "virus").ToList()" Label="病毒" />
    </div>

    @* v0.7 第 6 节：左栏“自身”投放卡已取消（没有任何投放热区）；对自身使用统一在选中物品的卡下按钮 *@

    <div class="panel weight">
        <div class="eyebrow">携带重量 · @(grams > cfg.Carry.SoftGrams ? "超重" : "轻装")</div>
        <strong class="@(grams > cfg.Carry.SoftGrams ? "warn-text" : "")">@Ui.KgText(grams)</strong>
        <div class="tiny muted">超过@(cfg.Carry.SoftGrams / 1000)公斤减速 · 上限@(cfg.Carry.HardGrams / 1000)公斤</div>
    </div>
</aside>

@code {
    private void OpenStat(StatId id) => G.OpenCharPage("stat:" + GameEngine.StatKey(id));
}
