@inherits GameComponent

@* 战斗覆盖层（人物与战斗 v0.5 §16、v0.6 §07；开发计划 v0.5 假设 8、9、11）：
   替换地块栏两行（地图行 + 设施行），不叠加；地面/随身栏、左 HUD、右栏、顶栏保持可见。
   战斗（S14 §18.4、R03 §7.4 取代 §14.3/§7.2 的左右混排与“执行”条）：第①行队伍场景（我方左、敌方右；B6 起敌方 1—4 号位，1、2 号位靠中线、3、4 号位更靠右），
   第②行操作台（装备/技能/指令/道具/状态/一行短反馈）；右栏对象信息显示悬停或选中对象与实际预测。
   敌踪选择：同一位置显示敌方组成与“接敌 / 绕行10分钟”。 *@
@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    var b = s.Battle;
}

@if (b == null && s.Encounter != null)
{
    var group = e.EncounterEnemies(s);
    var joinIds = e.EncounterJoiners(s).Select(x => x.Id).ToHashSet();
    var capNote = e.EncounterCapacityNote(s);
    <div class="panel battle-overlay encounter" role="region" aria-label="发现敌踪">
        <div class="bt-head">
            <b>发现敌踪</b>
            <span class="muted">@e.LocName(s.Encounter.LocationId) · @(s.Encounter.Source == "explore" ? "探索" : "清理")结果已提交</span>
        </div>
        <div class="bt-cards" data-wheel="x">
            @foreach (var w in group)
            {
                var ec = e.Enemy(w.EnemyId);
                var stays = !joinIds.Contains(w.Id);
                <ObjectCard @key="w.Id" CssClass="@(stays ? "enemy-card stays" : "enemy-card")" Title="@ec.Name" Badge="@(stays ? "留在原地" : ec.FamilyName + (ec.Elite ? "·精英" : ""))" OnClick="() => {}">
                    <Art>@Icons.Markup("enemy_" + ec.Id)</Art>
                    <ChildContent>
                        <div class="hp-line"><span>健康</span><b>@Ui.N(w.Hp)/@Ui.N(ec.Hp)</b></div>
                        <div class="track"><i style="width:@Ui.Bar(w.Hp, ec.Hp)%"></i></div>
                        <div class="oc-line">护甲@(Ui.T(ec.Armor)) · 闪避@(Ui.T(ec.Dodge)) · 速度@(Ui.Speed(ec.Speed))</div>
                        <div class="oc-line">伤害@(Ui.N(ec.DamageMin))—@(Ui.N(ec.DamageMax)) · @(ec.Ap)AP</div>
                    </ChildContent>
                </ObjectCard>
            }
        </div>
        <div class="enc-actions">
            <button type="button" class="enc-go fight" disabled="@G.BattleBusy" @onclick="G.EngageEncounter">
                <strong>接敌</strong><small>@e.FearNote(s, e.EncounterJoiners(s), GameEngine.FearEncounter)@(capNote != null ? "；" + capNote : "")</small>
            </button>
            <button type="button" class="enc-go" disabled="@(e.CanStart(s, ActionRequest.Bypass()) != null)"
                    @onmouseenter="() => G.Hover(BypassReq, BypassTitle)" @onfocus="() => G.Hover(BypassReq, BypassTitle)" @onmouseleave="() => G.Hover(null)" @onblur="() => G.Hover(null)"
                    @onclick="Bypass">
                <strong>绕行 · @(cfg.Encounters.BypassMinutes)分钟</strong><small>按移动消耗；敌人仍在；@(Clock.Duration(cfg.Encounters.PostExitRandomEncounterGraceMinutes))内不再随机遇敌</small>
            </button>
        </div>
        <div class="bt-log muted">只会遇到这里已有的敌人，不会凭空出现新敌人。Esc 打开菜单，不能关掉这个选择。</div>
    </div>
}
else if (b != null)
{
    var w = e.CurrentWeapon(s, out var wi);
    var activeIdx = b.PlayerActing ? 0 : (b.Cursor < b.Queue.Count ? b.Queue[b.Cursor] : -1);
    var opts = e.BattleOptions(s);
    var sel = G.BattleAction == null ? null : opts.FirstOrDefault(o => o.Action == G.BattleAction && (G.BattleItem == null || o.ItemInstanceId == G.BattleItem));
    var waiting = !e.AwaitingPlayer(s);
    var locked = waiting || G.BattleBusy;
    @* 四对四（R03 §1）：敌方左至右 1/2/3/4，1 最靠中央；两行战斗里 1、2 号位一列，3、4 号位一列 *@
    var front = cfg.Scope.Slots.Take(2).ToList();
    var back = cfg.Scope.Slots.Skip(2).ToList();
    // B6（R03 §3）：本次激活得到的 AP（普通激活按训练阶位 3/4/5，追击 2）；不在激活中时按下一次普通激活显示
    var apMax = b.PlayerActing && b.ActivationAp > 0 ? b.ActivationAp : e.NormalActivationAp(s.Player);
    var mySpeed = e.PlayerSpeedParts(s, b);
    var aiming = G.BattleAiming;
    var aimSet = G.AimTargets();
    var token = G.BattleExecToken();
    var skills = opts.Where(o => o.Group is "attack" or "move").ToList();
    var general = opts.Where(o => o.Group == "general").ToList();
    // 操作台道具区只放随身确实有的药品（试玩修复 M77-B5：1280 下没有的药品占位把道具挤出可见宽度）；系统说明“指令一览”仍列全部并写原因
    var items = opts.Where(o => o.Group == "item" && CarriedFor(o) > 0).ToList();
    @* 两行战斗（S14 §18.4、R03 §7.4，参考暗黑地牢1的分层）：第①行队伍场景——我方左、敌方右，脚下只放健康/AP/状态/槽位；
       第②行当前行动者操作台——装备、带图技能、通用指令、道具、状态与一行短反馈。两行严格等于正常行高，不在两行外另铺指令/日志。
       选技能进入瞄准：合法目标高亮、悬停看右栏实际预测、点击合法目标即提交；自用/无目标指令在操作台就近“确认”。右键/Esc 只取消瞄准。 *@
    <div class="panel battle-overlay bt-team @(aiming ? "aiming" : "")" role="region" aria-label="战斗队伍" @oncontextmenu="CancelAim" @oncontextmenu:preventDefault="true">
        <div class="bt-head">
            <b>@(b.Tutorial ? "首战" : "战斗") · 第@(b.Round)轮</b>
            @* B6（R03 §2）：本轮队列按轮初有效速度排，正常激活之后是本轮的追击（“追”），每角色每轮至多一次 *@
            <div class="bt-queue" aria-label="本轮行动顺序">
                @for (var k = 0; k < b.Queue.Count; k++)
                {
                    var qi = b.Queue[k];
                    var be = qi == 0 ? null : e.BattleEnemyAt(b, qi);
                    if (qi != 0 && (be == null || !be.Alive)) continue;
                    var chase = GameEngine.IsPursuitSlot(b, k);
                    var now = qi == activeIdx && (b.Cursor == k || (qi == 0 && b.PlayerActing && b.Cursor == k));
                    var done = k < b.Cursor && !(qi == 0 && b.PlayerActing && b.Cursor == k);
                    <span class="q-chip @(now ? "now" : "") @(done ? "done" : "") @(qi == 0 ? "me" : "") @(chase ? "chase" : "")"
                          title="@($"速度{Ui.Speed(b.Initiative.ElementAtOrDefault(k))}{(chase ? "；追击：速度优势带来的额外2AP激活" : "")}")">@(chase ? "追·" : "")@(qi == 0 ? "你" : $"{be!.Slot}号 {e.EnemyName(be)}")</span>
                }
            </div>
            <span class="bt-noise" title="枪声+@(Ui.T(cfg.Noise.GunGain))、弩+@(Ui.T(cfg.Noise.CrossbowGain))；满@(Ui.T(cfg.Noise.Max))可能引来同地丧尸（每场最多1次）">
                噪声<span class="track thin"><i style="width:@Ui.Bar(b.Noise, cfg.Noise.Max)%"></i></span>@Ui.T(b.Noise)/@Ui.T(cfg.Noise.Max)
            </span>
        </div>
        <div class="bt-scene">
            <div class="bt-ally" aria-label="我方">
                <div class="ally-card @(activeIdx == 0 ? "acting" : "")" id="bt-me">
                    <div class="ally-art">
                        <img src="img/portraits/protagonist.svg" alt="" />
                        <span class="ally-weapon" title="@(wi == null ? "徒手" : $"{w.Name}#{wi.InstanceId}")">@Icons.Markup(wi?.ItemId ?? "fists")</span>
                    </div>
                    <div class="ally-foot">
                        @{ var myPos = GameEngine.PlayerPos(b); }
                        <div class="ally-head"><b>你</b><small class="ally-pos" title="@($"我方真实站位：你在{myPos}号位。使用位按真实号位判断（只剩你一人也一样），不在使用位时先“调整站位”（1AP）；倒下、被拉动都不会自动补位")">@(myPos)号位</small>
                            @* Q80 最小真实槽（A10 本轮章）：我方 4/3/2/1 号位条，1 号位靠中线；空位写“空” *@
                            <span class="ally-slots" aria-label="@($"我方站位：你在{myPos}号位，其余空位")">
                                @for (var sp = cfg.Scope.Slots.Count; sp >= 1; sp--)
                                {
                                    var who = GameEngine.AllyAt(b, sp);
                                    <i class="@(who == GameState.PlayerId ? "me" : who != null ? "mate" : "")" title="@($"{sp}号位：{(who == GameState.PlayerId ? "你" : who != null ? "同伴" : "空")}")">@(who == GameState.PlayerId ? "你" : sp.ToString())</i>
                                }
                            </span>
                            <span class="ap-pips" aria-label="@($"行动点{(b.PlayerActing ? b.PlayerAp : 0)}/{apMax}")" title="@(b.PlayerActing ? $"本次{(b.ActingPursuit ? "追击" : "激活")}剩{b.PlayerAp}AP（不带入下次）" : $"等待轮到你；每次普通激活{e.NormalActivationAp(s.Player)}AP（战术训练阶位{s.Player.TacticalTier}）")">
                                @for (var i = 0; i < apMax; i++) { <i class="@(b.PlayerActing && i < b.PlayerAp ? "on" : "")"></i> }
                                <small>@(b.PlayerActing ? $"{(b.ActingPursuit ? "追击 " : "")}AP {b.PlayerAp}/{apMax}" : "等待")</small>
                            </span>
                        </div>
                        <div class="track" title="@($"健康{Ui.N(s.Stats.Health)}/{Ui.T(s.Stats.HealthMax)}")"><i style="width:@Ui.Bar(s.Stats.Health, s.Stats.HealthMax)%"></i></div>
                        <div class="track en" title="@($"体力{Ui.N(s.Stats.Energy)}/{Ui.T(s.Stats.EnergyMax)}")"><i style="width:@Ui.Bar(s.Stats.Energy, s.Stats.EnergyMax)%"></i></div>
                        <div class="hp-line"><span>健康@(Ui.N(s.Stats.Health))</span><b>体力@(Ui.N(s.Stats.Energy))</b></div>
                        <div class="hp-line speed-line" title="@($"有效速度=max(1, 基础{Ui.Speed(mySpeed.Base)}+装备{Ui.SignedT(mySpeed.Gear)}{(mySpeed.Status.Count > 0 ? "，" + string.Join("，", mySpeed.Status) : "")})，四舍五入到0.01；追击进度{Ui.T(b.PlayerPursuit)}/100")"><span>速度@(Ui.Speed(mySpeed.Speed))</span><b>追击@(Ui.T(b.PlayerPursuit))/100</b></div>
                    </div>
                </div>
            </div>

            <div class="bt-mid" aria-hidden="true"><span>VS</span></div>

            <div class="bt-foes" aria-label="敌方">
                <div class="foe-col front">
                    @foreach (var slot in front) { @Foe(slot, aiming, aimSet, activeIdx, token, locked) }
                </div>
                <div class="foe-col back">
                    @foreach (var slot in back) { @Foe(slot, aiming, aimSet, activeIdx, token, locked) }
                </div>
            </div>
        </div>
    </div>

    <div class="panel battle-overlay bt-console" role="region" aria-label="操作台" @oncontextmenu="CancelAim" @oncontextmenu:preventDefault="true">
        @* B3（A10 §4.2、A05 §5、R02 §1；开发计划 v0.9 B3 H6）：两个武器页签取代旧“装备”格与“换武器1AP”浮窗。开战锁定两槽，
           切页只换本次可选技能组、0AP、不耗体力，随时可切（敌方行动展示中也可切页查看，R90a）；切页取消尚未提交的瞄准。空槽页即拳；不能从随身换入第三把。
           开战停在第一个有武器的页（B3a H3）。 *@
        <div class="bc-equip bc-pages" role="tablist" aria-label="武器页">
            <span class="bc-label">武器</span>
            @for (var pg = 1; pg <= 2; pg++)
            {
                var page = pg;
                var pi = e.WeaponOnPage(s, page, out var pw);
                var onPage = b.ActiveWeaponSlot == page;
                var slotName = EquipSlots.Name(EquipSlots.WeaponSlotOfPage(page)!);
                var warn = pi != null && !GameEngine.HasWear(pi, cfg.Wear.PerExecutedAttackCommand) ? "耐久不足" : pi != null && pw.UsesMagazine && pi.LoadedAmmo <= 0 ? "弹仓空" : null;
                <button type="button" role="tab" class="bc-page @(onPage ? "on" : "")" aria-selected="@onPage"
                        title="@($"{slotName}：{(pi == null ? "空槽（拳）" : $"{pw.Name}#{pi.InstanceId}")}{(warn != null ? $"，{warn}" : "")} · 切页0AP，只换可选技能，取消已选目标")"
                        @onclick="() => G.SelectWeaponPage(page)">
                    <span class="bc-weapon-art">@Icons.Markup(pi?.ItemId ?? "fists")</span>
                    <span class="bc-weapon-text"><b>@(page == 1 ? "Ⅰ" : "Ⅱ") @(pi == null ? "拳" : pw.Name)</b>
                        <small class="@(warn != null ? "warn-text" : "")">@(warn ?? "")@(warn == null && pi?.Durability != null ? $"耐久{GameEngine.DurabilityText(pi)}" : "")@(pw.UsesMagazine && pi != null ? $" 弹{pi.LoadedAmmo}/{pw.MagazineCapacity}" : "")@(pw.ConsumesLooseAmmo ? $" 箭{s.Items.Where(i => i.IsCarried && i.ItemId == pw.AmmoId).Sum(i => i.Count)}" : "")</small></span>
                </button>
            }
        </div>
        <div class="bc-groups" data-wheel="x">
        <div class="bc-group skills" role="toolbar" aria-label="技能">
            <span class="bc-label">技能</span>
            <div class="bc-cmds">
                @foreach (var o in skills) { @Cmd(o, sel, wi, w, locked) }
            </div>
        </div>
        <div class="bc-group general" role="toolbar" aria-label="通用指令">
            <span class="bc-label">指令</span>
            <div class="bc-cmds">
                @foreach (var o in general) { @Cmd(o, sel, wi, w, locked) }
            </div>
        </div>
        @if (items.Count > 0)
        {
            <div class="bc-group items" role="toolbar" aria-label="道具">
                <span class="bc-label">道具</span>
                <div class="bc-cmds">
                    @foreach (var o in items) { @Cmd(o, sel, wi, w, locked) }
                </div>
            </div>
        }
        </div>
        <div class="bc-status" aria-label="战斗状态">
            <span class="bc-label">状态</span>
            <div class="st-chips">
                <span class="st" title="恐慌越高命中能力越低">恐慌@(Ui.N(b.Panic))@(b.Frightened ? "·受惊" : "")</span>
                @if (b.PlayerGuard) { <span class="st good" title="@(b.PlayerGuardSourceId is int gsid ? $"盾类格挡：防御时当前页的{e.ItemName(e.FindItem(s, gsid)?.ItemId ?? "")}，已锁定，切页不改" : "普通防御：防御时当前页不是可用的盾")">@(b.PlayerGuardSourceId != null ? "盾格挡" : "防御")×@Ui.T(b.PlayerGuardFactor)@(b.PlayerGuardCharges > 1 ? $"（{b.PlayerGuardCharges}次）" : "")</span> }
                @if (b.PlayerSteadyUntilRound >= b.Round) { <span class="st good" title="控制成功后至下一大回合末，控制抗性+30个百分点">稳态</span> }
                @if (b.PlayerStagger) { <span class="st bad">失衡</span> }
                @if (b.PlayerSlowActive || b.PlayerSlowPending) { <span class="st bad">减速</span> }
                @* B7 技能状态（A06 §2、R03 §4） *@
                @if (b.PlayerGuard && b.PlayerGuardCharges > 1) { <span class="st good" title="坚守：格挡次数">格挡×@b.PlayerGuardCharges</span> }
                @if (b.CounterFactor > 0) { <span class="st good" title="受到直接攻击命中后反击1次">反击架势</span> }
                @if (b.BraceCharges > 0) { <span class="st good" title="敌人主动前移后迎击">架矛×@b.BraceCharges</span> }
                @if (GameEngine.AxeChargeOn(b)) { <span class="st good" title="@($"下次用这把斧攻击伤害×{Ui.T(b.ChargeFactor)}，到第{b.ChargeUntilRound}轮末")">蓄力×@Ui.T(b.ChargeFactor)</span> }
                @if (GameEngine.InspireActive(b)) { <span class="st good" title="@($"下一次攻击命中能力+{Ui.T(b.InspireBonus)}，到第{b.InspireUntilRound}轮末")">鼓舞+@Ui.T(b.InspireBonus)</span> }
                @if (GameEngine.AllOutActive(b)) { <span class="st good" title="@($"下一次攻击伤害×{Ui.T(b.AllOutFactor)}，到第{b.AllOutUntilRound}轮末")">总攻令</span> }
                @if (b.DisplaceResist > 0 && b.DisplaceUntilRound >= b.Round) { <span class="st good" title="位移抵抗：被拉扯/击退判控制时生效">稳固</span> }
                @if (GameEngine.PlayerArmorBroken(b)) { <span class="st bad" title="@($"护甲−{Ui.T(b.PlayerArmorBreak)}，到第{b.PlayerArmorBreakUntilRound}轮末")">破甲−@Ui.T(b.PlayerArmorBreak)</span> }
                @if (GameEngine.PlayerWeakActive(b)) { <span class="st bad">虚弱</span> }
                @if (s.Body.BleedTriggers > 0) { <span class="st bad">出血×@s.Body.BleedTriggers</span> }
                @if (s.Body.Infected) { <span class="st bad">感染@(Ui.N(s.Body.VirusLoad))</span> }
            </div>
        </div>
        @* 一行短反馈 + 自用/无目标指令的就近确认；完整日志在右栏与行动日志 *@
        <div class="bc-feed" aria-live="polite">
            @if (waiting)
            {
                <span class="bx-hint warn">敌方行动中…</span>
            }
            else if (sel != null && aiming)
            {
                <span class="bx-hint">@(sel.TargetMode == "area" ? $"点亮起的任一1、2号位目标提交{sel.Label}（1、2号位都打）" : sel.TargetMode == "suffix" ? "点起点敌人：从它的号位打到4号位，按离起点的格数×0.65/0.50/0.35/0.25，空位不重排；悬停看右侧逐个预测" : sel.TargetMode == "pair" ? "点1、2号位打12，点3号位打23；悬停看右侧预测" : "把鼠标移到亮起的目标上看右侧预测，点击目标执行") · 右键/Esc 取消</span>
            }
            else if (sel != null)
            {
                var p = e.PreviewCommand(s, G.CurrentBattleCommand());
                <span class="bx-hint @(p.Ok ? "" : "warn")" title="@(p.Ok ? string.Join("；", p.Notes) : p.Reason)">@(p.Ok ? (p.RetreatChance.HasValue ? $"成功率{Ui.Pct(p.RetreatChance.Value)}" : p.Notes.FirstOrDefault() ?? ShortName(sel)) : p.Reason)</span>
                <button type="button" class="bx-go" id="bt-confirm" disabled="@(!p.Ok || locked)" title="@(p.Ok ? "点击确认才提交；同一指令只提交一次" : p.Reason)"
                        @onclick="() => Exec(token)">确认 · @ShortName(sel) · @(p.Ap)AP</button>
                <button type="button" class="bx-x" aria-label="取消（Esc）" title="取消（Esc/右键），不执行" @onclick="G.ClearBattleAction">×</button>
            }
            else
            {
                <span class="bx-last" title="完整战斗记录在右栏与行动日志">@(b.Log.LastOrDefault() ?? "选一个技能，再点亮起的目标")</span>
            }
        </div>
    </div>

}

@code {
    private static readonly ActionRequest BypassReq = ActionRequest.Bypass();
    private const string BypassTitle = "绕行敌踪";

    private async Task Bypass()
    {
        G.Hover(null);
        await G.StartAction(ActionRequest.Bypass());
    }

    private RenderFragment Foe(string slot, bool aiming, IReadOnlyCollection<int> aimSet, int activeIdx, string token, bool locked) => __builder =>
    {
        var s = G.S;
        var e = G.E;
        var b = s.Battle!;
        var en = b.Alive.FirstOrDefault(x => x.Slot == slot);
        if (en == null)
        {
            <div class="foe-empty" aria-label="@($"{slot}号位空")" title="@($"{slot}号位空")"><b>@(slot)号</b>空</div>
            return;
        }
        var ec = e.Enemy(en.EnemyId);
        var idx = en.Index;
        var targetable = aiming && aimSet.Contains(idx);
        var unreachable = aiming && !aimSet.Contains(idx);
        var reachWhy = unreachable ? (e.CommandBlocked(s, BattleCommand.Of(G.BattleAction!, idx, G.BattleItem)) ?? "不在本指令范围内") : null;
        var picked = G.BattleTarget == idx;
        var tip = reachWhy ?? (targetable ? "点击即对它执行所选技能（右侧是实际预测）" : "点击选中查看（不会攻击）；先选技能再点亮起的目标才执行");
        <div @key="@("foe" + idx)" id="@($"foe-{idx}")" class="foe @(idx == activeIdx ? "acting" : "") @(targetable ? "targetable" : "") @(unreachable ? "unreachable" : "") @(en.Acted ? "acted-done" : "") @(picked ? "selected" : "") @(G.BattleHover == idx ? "hover" : "")"
             role="button" tabindex="0" aria-pressed="@picked" aria-disabled="@(unreachable || (targetable && locked))" aria-label="@($"{slot}号位 {ec.Name}，健康{Ui.N(en.Hp)}/{Ui.N(ec.Hp)}，意图{G.E.IntentShown(G.S.Battle!, en)}{(reachWhy != null ? "；" + reachWhy : "")}")"
             title="@tip" @onclick="() => ClickFoe(idx, token, locked)" @onkeydown="ev => FoeKey(ev, idx, token, locked)"
             @onmouseenter="() => G.HoverBattleTarget(idx)" @onmouseleave="() => G.HoverBattleTarget(null)">
            <div class="foe-head"><span class="slot-tag">@(slot)号</span><b>@ec.Name</b>@if (en.Acted) {<span class="acted-mark">已行动</span>}</div>
            <div class="foe-main">
                <span class="foe-art">@Icons.Markup("enemy_" + ec.Id)</span>
                <div class="foe-body">
                    <div class="hp-line" title="健康"><span>♥</span><b>@Ui.N(en.Hp)/@Ui.N(ec.Hp)</b></div>
                    <div class="track"><i style="width:@Ui.Bar(en.Hp, ec.Hp)%"></i></div>
                    @{ var far = G.E.IntentOutOfReach(G.S.Battle!, en); }
                    <div class="intent @(far ? "calm" : en.Intent is "bite" ? "bite" : en.Intent is "flee" or "watch" or "guard" or "protect" or "buff" or "reload" ? "calm" : "")"
                         title="@(far ? $"本轮公开意图是{G.E.IntentLabel(en, G.S.Battle)}，但站在{slot}号位、你在{GameEngine.PlayerPos(G.S.Battle!)}号位，不能照原样出手：{G.E.IntentShown(G.S.Battle!, en)}（敌人{ec.Ap}AP：前移1AP，余下只做一次普通攻击；你躲在后排且前面全空时，它可付1AP迫近再2AP弱近袭×0.7，不咬不控制）" : $"本轮公开意图（轮初锁定，不公开伤害抽值）；{ec.Ap}AP{(ec.Elite ? "精英" : "")}，每次激活一个主意图")">
                        <span class="intent-ico">@(far ? FarIcon(G.E.PlanFor(G.S.Battle!, en, G.E.StepOf(en))) : IntentIcon(en.Intent))</span>@NoBreakRange(G.E.IntentShown(G.S.Battle!, en))
                    </div>
                </div>
            </div>
            <div class="st-chips">
                <span class="st" title="@($"护甲 · 闪避 · 有效速度；追击进度{Ui.T(en.PursuitProgress)}/100")">甲@(Ui.T(ec.Armor)) 闪@(Ui.T(ec.Dodge)) 速@(Ui.Speed(e.EnemyEffectiveSpeed(en)))</span>
                @if (en.Guard) { <span class="st good">防御</span> }
                @if (en.Stagger) { <span class="st bad">失衡</span> }
                @if (en.SteadyUntilRound >= b.Round) { <span class="st" title="控制成功后至下一大回合末，控制抗性+30个百分点">稳态</span> }
                @if (en.SlowActive || en.SlowPending) { <span class="st bad">减速</span> }
                @if (en.BleedTriggers > 0) { <span class="st bad">出血×@en.BleedTriggers</span> }
                @if (!en.Hostile) { <span class="st">中立</span> }
                @if (ec.Elite) { <span class="st" title="精英：每次正常激活4AP">精英</span> }
                @if (GameEngine.EnemyMarked(b, en)) { <span class="st bad" title="@($"被标记：我方对它命中能力+{Ui.T(en.MarkBonus)}，到第{en.MarkUntilRound}轮末")">标记</span> }
                @if (en.ArmorBreak > 0 && en.ArmorBreakUntilRound >= b.Round) { <span class="st bad" title="@($"护甲−{Ui.T(en.ArmorBreak)}，到第{en.ArmorBreakUntilRound}轮末")">破甲</span> }
                @if (GameEngine.EnemyWeak(b, en)) { <span class="st bad" title="@($"伤害×{Ui.T(en.WeakFactor)}，到第{en.WeakUntilRound}轮末")">虚弱</span> }
                @if (en.ProtectingIndex > 0) { <span class="st good" title="对同伴的单体攻击由它接下">保护中</span> }
                @if (unreachable && reachWhy != null) { <span class="st bad">@(reachWhy.StartsWith("射程不足") ? "射程不足" : "不可选")</span> }
            </div>
        </div>
    };

    private async Task FoeKey(KeyboardEventArgs ev, int idx, string token, bool locked)
    {
        if (ev.Key is "Enter" or " ") await ClickFoe(idx, token, locked);
    }

    /// <summary>瞄准中点合法目标=提交（执行锁期间不受理）；未瞄准只选中查看。</summary>
    private async Task ClickFoe(int idx, string token, bool locked)
    {
        if (G.BattleAiming && locked) return;
        await G.ClickBattleTarget(idx, token);
    }

    private int CarriedFor(BattleCommandOption o)
    {
        var itemId = G.E.Config.CombatActions.FirstOrDefault(a => a.Id == o.Action)?.ItemId;
        return itemId == null ? 0 : G.S.Items.Where(i => i.IsCarried && i.ItemId == itemId).Sum(i => i.Count);
    }

    private void CancelAim()
    {
        if (G.BattleAction != null) G.ClearBattleAction();
    }

    /// <summary>操作台上的一条带图指令：点选进入瞄准/待确认，不执行；不可用保留禁用态与短原因。</summary>
    private RenderFragment Cmd(BattleCommandOption o, BattleCommandOption? sel, ItemInstance? wi, WeaponConfig w, bool locked) => __builder =>
    {
        var on = sel != null && sel.Action == o.Action && sel.ItemInstanceId == o.ItemInstanceId;
        var (art, glyph, qty) = CmdArt(o, wi, w);
        var oo = o;
        var range = o.TargetMode == "area" ? "1、2号位群攻" : o.TargetMode == "suffix" ? (o.Targets.Count > 0 ? $"点起点打到4号位（可选起点{o.Targets.Count}个）" : "当前没有可选目标") : o.TargetMode == "pair" ? (o.Targets.Count > 0 ? "相邻双位（点12或23）" : "当前没有可选目标") : o.NeedsTarget ? (o.Targets.Count > 0 ? $"可选目标{o.Targets.Count}个" : "当前没有可选目标") : o.Action == "swap" ? "我方站位" : "自用/无目标";
        @* 试玩修复 M150：不可用的指令真正禁用（冷却中、AP 不足……都不进入瞄准），点它只在右栏写原因；悬停照样写原因 *@
        <button type="button" id="@($"cmd-{o.Action}{(o.ItemInstanceId is int ii ? "-" + ii : "")}")" class="cmdt @(on ? "on" : "") @(o.Available ? "" : "off") @(o.NodeId != null || o.Action == "desperate_punch" ? "skill" : "plain")" disabled="@locked" aria-disabled="@(!o.Available)"
                aria-label="@($"{ShortName(o)}，{ApText(o.Ap)}{(qty != null ? "，" + qty : "")}{(o.Reason != null ? "；不可用：" + o.Reason : "")}")"
                title="@(o.Reason ?? $"{o.Label}：{ApText(o.Ap)}{(o.Energy > 0 ? $"，体力{Ui.N(o.Energy)}" : "")}{(o.CooldownRounds > 0 ? $"，冷却{o.CooldownRounds}轮" : "")}；{range}。{(o.EffectText != null ? o.EffectText + "。" : "")}{(o.NeedsTarget || o.TargetMode == "area" ? "点选后点亮起的目标执行" : "点选后在旁边确认")}")"
                @onclick="() => { if (oo.Available) G.PickBattleAction(oo.Action, oo.ItemInstanceId); else G.ExplainBlocked(oo.Label, oo.Reason); }">
            <span class="cmdt-art">@Icons.Markup(art)@if (glyph != null) {<em class="cmdt-glyph">@glyph</em>}</span>
            <span class="cmdt-text">
                <span class="cmdt-name">@ShortName(o)</span>
                @if (o.Available) { <small>@(qty != null ? qty + " · " : "")@ApText(o.Ap)</small> }
                else { <span class="cmdt-why">@ShortWhy(o.Reason)</span> }
            </span>
        </button>
    };

    /// <summary>指令图（S14 §14.2）：攻击用当前武器/拳图，招式用武器图 + 招式字角标，医疗用真实物品图与随身数量，装填用实际弹药图；缺图统一占位。</summary>
    private (string art, string? glyph, string? qty) CmdArt(BattleCommandOption o, ItemInstance? wi, WeaponConfig w)
    {
        var weaponArt = wi?.ItemId ?? "fists";
        var e = G.E;
        string? Qty(string id)
        {
            var itemId = e.Config.CombatActions.FirstOrDefault(a => a.Id == id)?.ItemId;
            return itemId == null ? null : $"×{G.S.Items.Where(i => i.IsCarried && i.ItemId == itemId).Sum(i => i.Count)}";
        }
        string ItemArt(string id) => e.Config.CombatActions.FirstOrDefault(a => a.Id == id)?.ItemId ?? "placeholder";
        return o.Action switch
        {
            "basic_attack" => (weaponArt, null, null),
            "desperate_punch" => ("fists", "勉", null),
            // B7：五节点技能用当前武器图 + 技能名首字角标
            _ when o.NodeId != null => (weaponArt, o.Label.Length > 0 ? o.Label[..1] : null, null),
            "guard" => ("cmd_guard", null, null),
            "swap" => ("cmd_switch", o.ItemInstanceId is int to && to < GameEngine.PlayerPos(G.S.Battle!) ? "前" : "后", null),
            "breathe" => ("cmd_breathe", null, null),
            "reload" => (w.AmmoId ?? "cmd_reload", null, null),
            "retreat" => ("cmd_retreat", null, null),
            "end_turn" => ("cmd_end_turn", null, null),
            "bandage" or "use_antibiotics" or "use_antiviral_cure" => (ItemArt(o.Action), null, Qty(o.Action)),
            _ => ("placeholder", null, null),
        };
    }

    private static string ShortName(BattleCommandOption o) => o.Action switch
    {
        "bandage" => "包扎",
        "use_antibiotics" => "抗生素",
        "use_antiviral_cure" => "特效药",
        "swap" => o.ItemInstanceId is int to ? $"站位→{to}号" : "调整站位",   // Q80：每个相邻目的槽一条
        _ when o.NodeId != null => o.Label,   // B7：拳击/斩击/割伤……（1级攻击技能即普通攻击）
        _ => GameEngine.ActionName(o.Action),
    };

    private static string ApText(int ap) => ap < 0 ? "剩余AP" : $"{ap}AP";

    /// <summary>禁用短原因（完整原因在悬停/辅助名称）。</summary>
    private static string ShortWhy(string? why)
    {
        if (string.IsNullOrEmpty(why)) return "";
        if (why.StartsWith("行动点不足")) return "AP不足";
        if (why.StartsWith("还没轮到")) return "等待";
        if (why.StartsWith("只在体力不足")) return "仅缺体力";
        if (why.StartsWith("体力不足")) return "体力不足";
        if (why.StartsWith("随身没有")) return why.Contains("弹") || why.Contains("箭") || why.Contains("矢") ? "无弹药" : "无物品";
        if (why.StartsWith("随身") && why.Contains("不足")) return "弹药不足";
        if (why.StartsWith("弹仓不足")) return "需装填";
        if (why.StartsWith("弹仓已满")) return "弹仓满";
        if (why.StartsWith("弹仓空")) return "需装填";
        if (why.Contains("耐久不足")) return "耐久不足";
        if (why.Contains("冷却") || why.Contains("间隔中")) return "冷却中";
        if (why.Contains("没有效果")) return "无效果";
        if (why.StartsWith("本回合已")) return "本轮已用";
        if (why.StartsWith("已在防御")) return "已防御";
        if (why.StartsWith("需要") && why.Contains("级")) return "等级不足";
        if (why.StartsWith("射程不足")) return "射程不足";
        if (why.StartsWith("只有你一人")) return "无队友";
        if (why.StartsWith("已在") || why.StartsWith("已蓄力") || why.StartsWith("已架矛") || why.StartsWith("已有")) return "已生效";
        if (why.Contains("单发弩")) return "单发弩";
        if (why.Contains("不能直接攻击")) return "不能攻击";
        if (why.StartsWith("健康高于") || why.StartsWith("健康已满") || why.StartsWith("你没有") || why.StartsWith("恐慌已是0")) return "无效果";
        if (why.Contains("只能在我方")) return "站位不符";
        if (why.Contains("不需要装填") || why.Contains("不用装填")) return "无需装填";
        if (why.StartsWith("当前武器") && why.Contains("不能用")) return "武器不符";
        if (why.Contains("不需要装填")) return "无需装填";
        if (why.StartsWith("冷却中")) return "冷却中";
        // 试玩修复 M150：不再截原文（曾把“随身箭矢不足2支”截成“随身箭矢不”），没归类的写“不可用”，完整原因在悬停/右栏
        return why.Length <= 4 ? why : "不可用";
    }

    private async Task Exec(string token) => await G.ExecuteBattleCommand(token);

    /// <summary>意图里的伤害区间“0.70—1.10”不在破折号处折行（破折号两侧加 U+2060 不断行符，只影响显示，B2a M94）。</summary>
    private static string NoBreakRange(string label) => label.Replace("—", "\u2060—\u2060");

    /// <summary>够不到时的意图图标（试玩修复 M150 UX8）：前移“移”、弱攻击“弱”、改防御“防”、空前排迫近“迫”（Q80）。</summary>
    private static string FarIcon(GameEngine.ReachPlan plan) => plan switch
    {
        GameEngine.ReachPlan.Weak => "弱",
        GameEngine.ReachPlan.Guard => "防",
        GameEngine.ReachPlan.Approach => "迫",
        _ => "移",
    };

    private static string IntentIcon(string intent) => intent switch
    {
        "bite" => "咬",
        "attack" => "攻",
        "charge" => "撞",
        "charge_prepare" => "蓄",
        "guard" => "防",
        "howl" => "嚎",
        "flee" => "逃",
        "watch" => "望",
        "protect" => "护",
        "signal" => "鸣",
        "buff" => "势",
        "sweep" => "扫",
        "spit" => "喷",
        "pull" => "拉",
        "shoot" => "射",
        "reload" => "装",
        _ => "·",
    };
}
