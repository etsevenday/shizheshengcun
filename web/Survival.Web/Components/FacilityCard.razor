@inherits GameComponent

@* B35a1（S14／S09 Q795 B、Q594、Q796、Q909、Q936）：设施栏独立设施卡——遮蔽棚、床垫、每座已建自建工坊、每座公共设施各一张（GameEngine.FacilityCardsHere）。
   撤工坊聚合卡与「选择设施」层；未建设施不出占位卡（未建条目在手工制作「设施建造」里）。
   遮蔽棚、床垫施工中照原样保留带忙碌样式的虚线卡（判断集中在 GameEngine.BuildStageHere，B57 持续工地替换）。
   工坊状态「{设施名} · 制作中／空闲」（Q796），陶窑、固定净水台沿 Q727 被动批次汇总句；公共卡角标「公共」、状态只写「制作中／空闲」、悬停「公共设施。」（Q936），
   未开放保留原真实原因。点卡进入该座真实设施的工作区（只列本座配方）。 *@
@{
    var s = G.S;
    var e = G.E;
    var v = View;
    var shelterLike = v.Kind is "shelter" or "bed";
    var built = v.Stage == FacilityStage.Built;
    var fac = e.FacOf(s, s.Ground) ?? s.Locations[s.CurrentLocation].Facility;
    string sub, tip, badge;
    var blocked = v.Kind == "public" && v.Blocked != null;
    if (shelterLike)
    {
        var effect = v.Kind == "bed" ? "营地睡眠体力每小时额外+5" : "营地可遮蔽睡眠，休息额外恢复精神";
        var need = v.Kind == "bed" && !fac.ShelterBuilt ? "需先建成遮蔽棚" : "点击查看建造条件";
        sub = built ? effect : need;
        tip = built ? effect : $"{v.Name}未建造：{need}";
        badge = built ? GameEngine.BuiltBadge : "未建造";
    }
    else if (v.Kind == "public")
    {
        sub = v.State;
        tip = blocked ? $"{v.Name}未开放：{v.Blocked}" : GameEngine.PublicTooltip;
        badge = blocked ? "未开放" : GameEngine.PublicBadge;
    }
    else
    {
        sub = v.State;
        tip = v.State;
        badge = GameEngine.BuiltBadge;
    }
    var title = shelterLike ? (v.Kind == "bed" ? "床垫" : "遮蔽棚") : v.Name;
    var busy = shelterLike ? !built : v.Crafting || (v.Kind == "station" && fac.StationBatches.Any(b => b.StationId == v.StationId));
    var id = v.Kind == "public" ? $"ps-{v.Workspace!.PublicId}" : $"fac-{v.StationId}";
    var art = shelterLike ? ArtCatalog.FacilityCardKey(v.Kind) : "facility:" + v.StationId;
}
<ObjectCard Ink2="true" Id="@id" PeekId="@Peek.Card(id)" CssClass="@($"k2-fac{(v.Kind == "public" ? " public-station" : "")}")" Title="@title" Badge="@badge"
            BadgeClass="@(built && !blocked ? "built" : "unbuilt")" Dashed="@(!built || blocked)" Blocked="@blocked"
            Busy="@busy" Sub="@sub" SubClass="@(blocked ? "warn-line" : "")" Tooltip="@tip" OnClick="Open">
    <Art>@Icons.Markup(art)</Art>
</ObjectCard>

@code {
    [Parameter, EditorRequired] public FacilityCardView View { get; set; } = null!;

    /// <summary>遮蔽棚、床垫打开手工制作「设施建造」里的对应条目；工坊与公共设施进入该座真实设施的工作区。</summary>
    private void Open()
    {
        if (View.Workspace is { } w) { G.OpenWorkspace(w); return; }
        G.OpenHandCraft(View.StationId);
    }
}
