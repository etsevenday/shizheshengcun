@inherits GameComponent

@* 固定设施卡：遮蔽棚、床垫（01 案第 1、7 节）。未建造用同一建筑插画 + 虚线框 + “未建造”角标，点击打开手工制作并选中对应配方；
   不可拖动、不计为已建成，插画显示不开启设施收益。 *@
@{
    var s = G.S;
    var e = G.E;
    var fac = s.Locations[s.CurrentLocation].Facility;
    var stations = e.Config.Workshops.Stations.Where(x => x.BuildRecipe != null).ToList();
    var builtWs = stations.Where(x => fac.Workshops.Contains(x.Id)).Select(x => x.Name).ToList();
    var built = Kind == "workshops" ? builtWs.Count > 0 : Kind == "bed" ? fac.BedBuilt : fac.ShelterBuilt;
    var title = Kind == "workshops" ? "工坊" : Kind == "bed" ? "床垫" : "遮蔽棚";
    var effect = Kind == "workshops" ? $"已建{string.Join("、", builtWs)}" : Kind == "bed" ? "营地睡眠体力每小时额外+5" : "营地可遮蔽睡眠，休息额外恢复精神";
    var need = Kind == "workshops" ? "点击在“营地建造”里建" : Kind == "bed" && !fac.ShelterBuilt ? "需先建成遮蔽棚" : "点击查看建造条件";
    var badge = Kind == "workshops" ? $"已建{builtWs.Count}/{stations.Count}" : built ? "已建成" : "未建造";
}
<ObjectCard CssClass="fac-card" Title="@title" Badge="@badge" BadgeClass="@(built ? "built" : "unbuilt")" Dashed="@(!built)"
            Tooltip="@(built ? effect : $"{title}未建造：{need}")" OnClick="Open">
    <Art>@Icons.Markup(Kind == "workshops" ? "parts" : Kind)</Art>
    <ChildContent>
        <div class="oc-line">@(built ? effect : need)</div>
    </ChildContent>
</ObjectCard>

@code {
    /// <summary>shelter、bed 或 workshops（B10：本地已建工坊汇总）。</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "shelter";

    private void Open()
    {
        if (Kind != "workshops") { G.OpenPanel("craft", Kind); return; }
        G.OpenPanel("craft", "build_workbench");
        G.CraftTab = "camp";
        G.Notify();
    }
}
