@inherits GameComponent
@implements IDisposable
@inject IJSRuntime JS

@* 分层地图（开发计划 v0.9 批次 B12，R38；A10「A10-EXUI」§1「分层导航与发现权限」、S14「地图、来源与四类账」、S02「最新地图与道路」）。
   Part="center"：中部 ①② 合并区的地图（相邻地点旁锚定“确认移动”浮窗）；Part="detail"：右栏的地点信息、远处路径预览与详细移动预估（只读）。
   三层：主世界 → 城内/地牢；面包屑与层切换只换阅读，不移动、不退出地牢；“回到当前位置”只平移视口。
   缩放档的地名 15px、状态 14px 不随缩放变小；“总览”档只画点（悬停看名称），不画小于 14px 的字（S14 §1.2）。
   视图数据全部来自 GameEngine.BuildMapView（只读，未知节点不泄露）；缩放、拖图、切层不耗时。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var adjacent = e.AdjacentUnlocked(s).Select(x => x.Other(here)).ToHashSet();
    var picked = G.MapPicked;
}

@if (Part == "center")
{
    var v = e.BuildMapView(s, G.MapLayer);
    var layers = e.KnownMapLayers(s);
    var regions = e.KnownMapRegions(s);   // Q124（B13c）：主世界分区导航，只列有已知地点的分区
    var k = Zooms[Math.Clamp(G.MapZoom, 0, Zooms.Length - 1)];
    var overview = G.MapZoom == 0;
    var labels = k >= 0.75;
    var w = (v.MaxX - v.MinX) * k + 2 * PadX;
    var h = (v.MaxY - v.MinY) * k + 2 * PadY;
    var nodeAt = v.Nodes.ToDictionary(n => n.Id);
    _view = v; _k = k;
    <div class="sub-panel map-panel" role="dialog" aria-label="区域地图">
        <div class="map-bar">
            <nav class="map-crumbs" aria-label="地图层级">
                @for (var i = 0; i < v.Breadcrumb.Count; i++)
                {
                    var crumb = v.Breadcrumb[i];
                    if (i > 0) { <span class="sep" aria-hidden="true">/</span> }
                    if (i == 0 && v.LayerKey != GameEngine.WorldLayer)
                    {
                        <button type="button" class="crumb" title="返回主世界（只切换查看，不移动）" @onclick="() => SwitchLayer(GameEngine.WorldLayer)">@crumb</button>
                    }
                    else
                    {
                        <span class="crumb @(i == v.Breadcrumb.Count - 1 ? "now" : "")" title="@crumb">@crumb</span>
                    }
                }
            </nav>
            <div class="map-tools">
                @* 层切换与主世界分区导航合在一个下拉里（1280 档工具条放不下第二个下拉）；选分区＝切到主世界并把视口移到该分区已知地点中间，0 分钟、不移动 *@
                <select class="map-layer" @key="_selectKey" aria-label="切换地图层或定位主世界分区" title="切换查看的层，或定位到主世界的某个分区（只切换查看，不移动，0分钟）" value="@v.LayerKey" @onchange="OnLayer">
                    @if (layers.Count > 1)
                    {
                        <optgroup label="地图层">
                            @foreach (var (key, name) in layers) { <option value="@key">@name</option> }
                        </optgroup>
                    }
                    else { <option value="@GameEngine.WorldLayer">主世界</option> }
                    <optgroup label="主世界分区（定位）">
                        @foreach (var r in regions)
                        {
                            <option value="@("region:" + r.Key)">@r.Name@(r.HasHere ? "·当前" : "")（已知@(r.Known)处）</option>
                        }
                    </optgroup>
                </select>
                <button type="button" class="secondary" title="缩小（−）" disabled="@(G.MapZoom <= 1)" @onclick="() => Zoom(G.MapZoom - 1)">−</button>
                <button type="button" class="secondary" title="放大（+）" disabled="@(G.MapZoom >= Zooms.Length - 1)" @onclick="() => Zoom(G.MapZoom + 1)">+</button>
                <button type="button" class="secondary @(overview ? "on" : "")" title="总览：只画点，悬停看地名" @onclick="() => Zoom(overview ? GameSession.MapDefaultZoom : 0)">总览</button>
                <button type="button" class="secondary" title="视口回到当前位置（只平移，不移动，0）" @onclick="BackToHere">回到当前位置</button>
                @if (G.E.BuiltSafehouses(G.S).Count > 0)
                {
                    @* B17 试玩修复 B2（S09 X2.5）：任意地点打开安全屋面板看返程路线与合计分钟，只定位、不传送 *@
                    <button type="button" class="secondary" title="回安全屋的已知路线与合计分钟（只定位，不自动寻路或传送）" @onclick='() => G.OpenPanel("safehouse")'>安全屋返程</button>
                }
                <button type="button" class="secondary @(G.MapLegend ? "on" : "")" aria-expanded="@G.MapLegend" @onclick="ToggleLegend">图例</button>
                <button type="button" class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
            </div>
        </div>
        <div class="map-stage">
        @if (G.SourceItem is string srcItem)
        {
            @* B23（A10-EXUI §4）：缺料来源查询——只列已发现的来源（产量、工时、库存/日补、合格工具、路线），耗尽/已领/本代搜空不亮“可获取”；
               “定位”只切层并居中，不移动；关闭地图（或“返回制作”）回制作面板并恢复原选择 *@
            var srcs = e.ItemSources(s, srcItem);
            var srcHint = e.ItemSourceHint(srcs, srcItem);   // Q250：没有一行可获取时末尾一条公开线索，全空时也只有这一条
            <div class="map-sources" data-wheel="y" data-sources="@srcItem">
                <div class="ms-head">
                    <b>@e.ItemName(srcItem)的已知来源</b>
                    <button type="button" class="secondary ms-back" title="回到手工制作，恢复刚才的配方与选择（关闭地图或 Esc 同效）" @onclick="G.ReturnFromSources">返回制作</button>
                </div>
                @foreach (var x in srcs)
                {
                    var loc = x.LocationId;
                    <div class="ms-row @(x.Usable ? "ok" : "off")" data-source-kind="@x.Kind">
                        <div class="ms-title">@if (!string.IsNullOrEmpty(x.Account)) { <span class="ms-acct"><AccountIcon Label="@x.Account" />@x.Account</span> }<b>@x.Title</b></div>
                        <div class="ms-detail">@x.Detail</div>
                        <div class="ms-status @(x.Usable ? "" : "warn-text")">@x.Status@(string.IsNullOrEmpty(x.Route) ? "" : $" · {x.Route}")</div>
                        @if (loc != null)
                        {
                            <button type="button" class="secondary ms-loc" title="在地图上定位（只平移视口，不移动）" @onclick="() => G.FocusSource(loc)">定位</button>
                        }
                    </div>
                }
                @if (srcHint != null) { <div class="ms-row ms-hint" data-source-hint>@srcHint</div> }
            </div>
        }
            <div class="map-viewport" @ref="_vp" tabindex="0" aria-label="@($"{v.LayerName}，已知{v.Nodes.Count}处；拖动平移，+ − 缩放，0 回到当前位置")"
                 data-map-key="@MapKey(v.LayerKey)" @onkeydown="Key">
                <svg class="map-canvas" width="@F(w)" height="@F(h)" viewBox="@($"0 0 {F(w)} {F(h)}")" role="img" aria-label="地点与路线">
                    <defs><marker id="oneway" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="#e2c27e" /></marker></defs>
                    @foreach (var ed in v.Edges)
                    {
                        var a = nodeAt[ed.A]; var b = nodeAt[ed.B];
                        var (x1, y1) = P(v, a, k); var (x2, y2) = P(v, b, k);
                        // 线端留出节点框，箭头落在框边
                        var (sx, sy, tx, ty) = Trim(x1, y1, x2, y2, overview ? 10 : 30);
                        var oneWay = ed.OneWayFrom != null;
                        if (oneWay && ed.OneWayFrom == ed.B) { (sx, sy, tx, ty) = (tx, ty, sx, sy); }
                        var mx = (x1 + x2) / 2; var my = (y1 + y2) / 2;
                        var tip = ed.Open ? $"{e.LocName(ed.A)}—{e.LocName(ed.B)} · {ed.Minutes}分钟{(oneWay ? " · 单向出口" : "")}" : $"未开通：{ed.Reason}";
                        <g class="map-edge @(ed.Open ? "open" : "locked") @(ed.Near ? "near" : "")">
                            <title>@tip</title>
                            <line x1="@F(sx)" y1="@F(sy)" x2="@F(tx)" y2="@F(ty)" marker-end="@(oneWay ? "url(#oneway)" : null)" />
                            @if (labels)
                            {
                                var text = ed.Open ? $"{ed.Minutes}分{(oneWay ? "·单向" : "")}" : "未开通";
                                var tw = 16 + 14 * text.Length;
                                <rect x="@F(mx - tw / 2.0)" y="@F(my - 12)" width="@tw" height="24" rx="4" />
                                @T(mx, my + 5, null, text)
                            }
                        </g>
                    }
                    @foreach (var n in v.Nodes)
                    {
                        var (x, y) = P(v, n, k);
                        var id = n.Id;
                        var isPicked = id == picked;
                        var state = n.IsHere || n.HereInside ? "here" : n.Visited ? "visited" : "known";
                        var status = n.IsHere ? "● 当前位置" : n.HereInside ? "● 你在城内" : n.Visited ? $"探索度{n.Progress}%" : "待访问";
                        var tip = $"{n.Name} · {status}{(n.Danger is int dg ? $" · 危险{dg}" : "")}{(n.Roles.Count > 0 ? " · " + string.Join("、", n.Roles) : "")}{(n.Water.Count > 0 ? " · " + string.Join("、", n.Water.Select(m => m.Title)) : "")}";
                        <g class="map-node @state @(isPicked ? "picked" : "")" id="@($"mn-{id}")" tabindex="0" role="button" aria-label="@tip" data-peek="@Peek.Node(id)"
                           @onclick="() => Pick(id)" @onkeydown="ev => NodeKey(ev, id)" @onkeydown:stopPropagation="true">
                            <title>@tip</title>
                            @if (overview)
                            {
                                <circle cx="@F(x)" cy="@F(y)" r="9" />
                                @if (state == "here") { <circle class="ring" cx="@F(x)" cy="@F(y)" r="15" /> }
                            }
                            else
                            {
                                <rect x="@F(x - NodeW / 2)" y="@F(y - NodeH / 2)" width="@NodeW" height="@NodeH" rx="7" />
                                @T(x, y - 3, "nm", Short(n.Name))
                                @T(x, y + 17, "st", status)
                                @if (n.Roles.Count > 0)
                                {
                                    var rt = string.Join("·", n.Roles);
                                    var rw = 16 + 14 * rt.Length;
                                    <g class="map-role"><rect x="@F(x - rw / 2.0)" y="@F(y - NodeH / 2 - 24)" width="@rw" height="22" rx="4" /><text x="@F(x)" y="@F(y - NodeH / 2 - 8)" text-anchor="middle">@rt</text></g>
                                }
                                @* Q220（A10-EXUI §5）：节点右上方框外的水源图标，左边的形状写水源形态、右边的水滴写水种（脏水带斜杠），不靠颜色区分；悬停写资源点名、四类账、水种。
                                   B27 试玩修复：放在框外上方，右端对齐框右，不压节点名和框；有角色标签时排到标签右边，方向徽标在框左上角 *@
                                var waterX = x + NodeW / 2 - (46 * n.Water.Count - 2);
                                if (n.Roles.Count > 0) waterX = Math.Max(waterX, x + (16 + 14 * string.Join("·", n.Roles).Length) / 2.0 + 2);
                                @for (var wi = 0; wi < n.Water.Count; wi++)
                                {
                                    var wm = n.Water[wi];
                                    <g class="map-water" data-water="@wm.Shape" transform="@($"translate({F(waterX + wi * 46)},{F(y - NodeH / 2 - 26)})")">
                                        <title>@wm.Title</title>
                                        <rect width="44" height="24" rx="6" />
                                        <g class="wg" transform="translate(3,3) scale(0.75)">
                                            @switch (wm.Shape)
                                            {
                                                case "flow": <path d="M2 7c3.3-3 6.7-3 10 0s6.7 3 10 0M2 13c3.3-3 6.7-3 10 0s6.7 3 10 0M2 19c3.3-3 6.7-3 10 0s6.7 3 10 0" /> break;
                                                case "bottle": <path d="M9.5 2h5v4l2.5 3.5V21a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1V9.5L9.5 6zM7 13h10" /> break;
                                                case "cistern": <path d="M4 6c0-3 16-3 16 0v12c0 3-16 3-16 0zM4 6c0 3 16 3 16 0M4 12c0 3 16 3 16 0" /> break;
                                                default: <path d="M3 4h18l-7 8.5V20l-4 2v-9.5zM7 8h10" /> break;
                                            }
                                        </g>
                                        @if (wm.Clean is bool clean)
                                        {
                                            <g class="wd @(clean ? "clean" : "dirty")" transform="translate(23,3) scale(0.75)">
                                                <path d="M12 2.5C8 8 5 11.5 5 15a7 7 0 0 0 14 0c0-3.5-3-7-7-12.5z" />
                                                @if (!clean) { <path class="slash" d="M4 21 20 5" /> }
                                            </g>
                                        }
                                    </g>
                                }
                                @if (labels && !n.IsHere)
                                {
                                    var nd = e.DirectionFromHere(s, id);
                                    @if (nd != MapDirection.None)
                                    {
                                        @* Q22（S02、S14 §19）：已知非当前节点的八方向徽标，与地块卡同一数据；只作展示 *@
                                        <g class="map-dir" transform="@($"translate({F(x - NodeW / 2 - 6)},{F(y - NodeH / 2 - 10)})")" pointer-events="none">
                                            <circle cx="11" cy="11" r="11" fill="#20271d" stroke="#e9d9ad" stroke-width="1.5" />
                                            <g transform="@($"translate(2,2) scale(0.75) rotate({((int)nd - 1) * 45} 12 12)")"><path d="M12 2.5 19.5 11h-4.6v10.5H9.1V11H4.5Z" fill="#f0d9a0" /></g>
                                        </g>
                                    }
                                }
                            }
                        </g>
                        var pills = overview ? new List<(string, string, string)>() : Pills(v, n);   // 总览只画点
                        var py = y + (overview ? 14 : NodeH / 2 + 4);
                        @foreach (var (label, layer, title) in pills)
                        {
                            var pw = 16 + 14 * label.Length;
                            var targetLayer = layer;
                            <g class="map-pill" role="button" tabindex="0" aria-label="@title" @onclick="() => SwitchLayer(targetLayer)" @onclick:stopPropagation="true"
                               @onkeydown="ev => PillKey(ev, targetLayer)" @onkeydown:stopPropagation="true">
                                <title>@title</title>
                                <rect x="@F(x - pw / 2.0)" y="@F(py)" width="@pw" height="22" rx="11" />
                                <text x="@F(x)" y="@F(py + 16)" text-anchor="middle">@label</text>
                            </g>
                            py += 25;
                        }
                    }
                </svg>
            </div>
            @if (G.MapLegend)
            {
                <div class="map-legend-pop" role="note">
                    <div><i class="lg-line open"></i>实线：已开通的路线（金色为当前地点相连）</div>
                    <div><i class="lg-line locked"></i>红色虚线“未开通”：已发现但门槛未满足，悬停看原因</div>
                    <div><i class="lg-arrow">➜</i>箭头：单向出口，只能从箭尾一侧走</div>
                    <div><i class="lg-box dashed"></i>虚线框：已发现、还没去过</div>
                    <div><i class="lg-pill"></i>圆角标签：进入城内/地牢查看，或通往其他层的路口（只切换查看）</div>
                    <div>浏览、拖动、缩放和切层都不推进时间，也不会发现新地点；一次只移动一段相邻路线</div>
                </div>
            }
            @if (!overview && v.Nodes.Count >= 6)
            {
                var mw = 168.0; var mh = 96.0;
                var sw = Math.Max(1, v.MaxX - v.MinX); var shh = Math.Max(1, v.MaxY - v.MinY);
                var m = Math.Min((mw - 16) / sw, (mh - 16) / shh);
                <svg class="map-mini" width="@mw" height="@mh" role="img" aria-label="缩略导航：点一下把视口移到那里" @onclick="MiniClick">
                    @foreach (var n in v.Nodes)
                    {
                        <circle cx="@F(8 + (n.X - v.MinX) * m)" cy="@F(8 + (n.Y - v.MinY) * m)" r="@(n.IsHere || n.HereInside ? 4.5 : 3)" class="@(n.IsHere || n.HereInside ? "here" : n.Visited ? "visited" : "")" />
                    }
                </svg>
                _mini = m;
            }
        </div>
    </div>
}
else
{
    @* B42：悬停已公开节点时右栏临时读该节点（与点选同一份内容，只读）；离开保留，点选或切层后回到点选结果 *@
    var target = PeekNode ?? picked ?? here;
    var tl = e.Location(target);
    var ts = s.Locations[target];
    if (target == here)
    {
        <div class="detail-scroll">
            <div class="op-head">
                <div class="eyebrow">区域地图 · 当前位置</div>
                <h2>@tl.Name</h2>
                <p>@(tl.IsIndoor ? "室内，可遮蔽睡眠" : "露天")@(tl.CanBuildShelter ? " · 营地" : "") · 探索度@(ts.Progress)% · @e.RegionName(e.RegionOf(target))</p>
            </div>
            <div class="lines">
                @foreach (var ed in e.AdjacentUnlocked(s))
                {
                    <div><span>→ @e.LocName(ed.Other(here))@(ed.Bidirectional ? "" : "（单向出口）")</span><b>@(ed.BaseMinutes)分钟</b></div>
                }
            </div>
            @{ var groups = e.AdjacentLockedGroups(s); }
            @if (groups.Count > 0)
            {
                <div class="eyebrow">未开通的路线</div>
                <div class="lines">
                    @foreach (var (reason, routes) in groups)
                    {
                        @foreach (var lk in routes)
                        {
                            <div title="@reason"><span>✕ @e.LocName(lk.Target)</span><b>@(lk.Edge.BaseMinutes)分钟</b></div>
                        }
                        <div class="tiny muted">@reason</div>
                    }
                </div>
            }
            <div class="tiny muted">在地图上点选相邻地点：地点旁出现移动确认，这里显示详细预估。点远处地点可看实际路线。</div>
        </div>
    }
    else if (adjacent.Contains(target) && !e.IsBusy(s))
    {
        <PreviewView Request="ActionRequest.Travel(target, e.NeedsExpeditionConfirm(s, target))" Eyebrow="@($"区域地图 · {tl.Name} · {(ts.Visited ? $"探索度{ts.Progress}%" : "待访问")}")" Title="@($"前往{tl.Name}")"
                     Confirmable="false" FootNote="在地图上该地点旁的浮窗确认移动；时间为预计值"
                     Subtitle="一次只移动一段相邻路线，不提供自动寻路。" />
    }
    else
    {
        var lockHere = e.AdjacentLocked(s).FirstOrDefault(x => x.Target == target);
        var path = lockHere.Edge == null ? e.MapPathTo(s, target) : null;
        <div class="detail-scroll">
            <div class="op-head">
                <div class="eyebrow">区域地图 · @(ts.Visited ? $"探索度{ts.Progress}%" : "已发现 · 待访问")</div>
                <h2>@tl.Name</h2>
                <p>@(tl.IsIndoor ? "室内" : "露天")@(tl.Danger is int dg ? $" · 危险{dg}" : "") · @e.RegionName(e.RegionOf(target)) · @e.MapLayerName(e.MapLayerOf(target))</p>
            </div>
            @if (e.IsBusy(s))
            {
                <div class="blocked">行动进行中，地图只能浏览</div>
            }
            else if (lockHere.Edge != null)
            {
                <div class="blocked">路线未开通，@lockHere.Reason</div>
            }
            else if (path != null && path.Count > 0)
            {
                @* A10-EXUI §1：远处节点显示实际可达路径与分段时间，只能确认下一段相邻路 *@
                <div class="eyebrow">实际路线（共@(path.Count)段，基础@(path.Sum(p => p.Minutes))分钟）</div>
                <div class="lines">
                    @foreach (var st in path)
                    {
                        <div><span>@e.LocName(st.From) → @e.LocName(st.To)</span><b>@(st.Minutes)分钟</b></div>
                    }
                </div>
                var next = path[0].To;
                <div class="tiny muted">不提供自动寻路：一次只能确认下一段。</div>
                @if (PeekNode == null)
                {
                    <button type="button" class="primary small-btn" @onclick="() => PickNext(next)">选中下一段：前往@(e.LocName(next))</button>
                }
            }
            else
            {
                <div class="blocked">目前没有已开通的路线能走到这里</div>
            }
        </div>
    }
}

@code {
    [Parameter] public string Part { get; set; } = "center";
    /// <summary>B42：右栏悬停查看的地图节点（只读，不选中、不开移动浮窗、不给「选中下一段」）。</summary>
    [Parameter] public string? PeekNode { get; set; }

    /// <summary>缩放档：0 为“总览”（只画点，不画字），其余档地名 15px、状态 14px 固定，不随缩放变小。</summary>
    public static readonly double[] Zooms = { 0.3, 0.55, 0.75, 1.0 };
    private const double NodeW = 136, NodeH = 50;
    /// <summary>画布四周留白：至少半个视口（B12 试玩修复：1280 档视口约 726×240，当前位置在边上时也能居中），按视口实测更新。</summary>
    private double PadX = 110, PadY = 76;
    private bool _firstCenter = true;

    private ElementReference _vp;
    private MapView? _view;
    private double _k = 0.75;
    private double _mini = 1;
    private bool _needCenter = true;
    private (double X, double Y)? _centerWorld;
    private string _lastHere = "";
    private string _lastLayer = "";

    private static string F(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private (double, double) P(MapView v, MapViewNode n, double k) => ((n.X - v.MinX) * k + PadX, (n.Y - v.MinY) * k + PadY);

    private static (double, double, double, double) Trim(double x1, double y1, double x2, double y2, double r)
    {
        var dx = x2 - x1; var dy = y2 - y1; var len = Math.Sqrt(dx * dx + dy * dy);
        if (len < 2 * r + 1) return (x1, y1, x2, y2);
        // 节点框 136×50：沿方向收到框边（横向收得多、纵向收得少）
        var fx = dx / len; var fy = dy / len;
        var cut = r <= 10 ? r : Math.Min(NodeW / 2 / Math.Max(Math.Abs(fx), 1e-6), NodeH / 2 / Math.Max(Math.Abs(fy), 1e-6)) + 2;
        return (x1 + fx * cut, y1 + fy * cut, x2 - fx * cut, y2 - fy * cut);
    }

    /// <summary>SVG 文字（Razor 代码块里不能直接写带属性的 text 标签）。</summary>
    private const string SvgTextTag = "te" + "xt";

    private static MarkupString T(double x, double y, string? cls, string content) =>
        new("<" + SvgTextTag + (cls != null ? " class=\"" + cls + "\"" : "") + " x=\"" + F(x) + "\" y=\"" + F(y) + "\" text-anchor=\"middle\">"
            + System.Net.WebUtility.HtmlEncode(content) + "</" + SvgTextTag + ">");

    private static string Short(string name) => name.Length > 8 ? name.Substring(0, 7) + "…" : name;

    private string MapKey(string layer) => $"{G.S.CurrentLocation}|{layer}|{G.MapZoom}|{PadX:0}x{PadY:0}";

    /// <summary>节点下的圆角标签：可进入的城内/地牢、跨层路口（多于 2 个时合成一张）。</summary>
    private List<(string Label, string Layer, string Title)> Pills(MapView v, MapViewNode n)
    {
        var list = new List<(string, string, string)>();
        if (n.SubLayer != null) list.Add((n.SubLabel!, n.SubLayer, $"查看{G.E.MapLayerName(n.SubLayer)}（只切换查看，不移动）"));
        var ports = v.Portals.Where(p => p.FromNode == n.Id).ToList();
        string Port(MapPortal p) => $"{(p.OneWayOut ? "出口" : "")}→{p.TargetName}{(p.Open ? "" : "（未开通）")}";
        string PortTitle(MapPortal p) => $"通往{p.TargetName}（{p.TargetLayerName}）· {p.Minutes}分钟{(p.OneWayOut ? " · 单向出口" : "")}{(p.Open ? "" : $" · 未开通：{p.Reason}")}；点一下切到{p.TargetLayerName}查看";
        if (ports.Count <= 2) list.AddRange(ports.Select(p => (Port(p), p.TargetLayer, PortTitle(p))));
        else list.Add(($"通往{ports[0].TargetLayerName}{ports.Count}处 ▸", ports[0].TargetLayer, string.Join("\n", ports.Select(PortTitle))));
        return list;
    }

    private int _selectKey;

    private void OnLayer(ChangeEventArgs ev)
    {
        var value = ev.Value?.ToString() ?? GameEngine.WorldLayer;
        if (value.StartsWith("region:")) GoRegion(value.Substring(7));
        else SwitchLayer(value);
    }

    /// <summary>
    /// 主世界分区导航（Q124 选 A，A10-EXUI §1、NAME-Q124-01）：切到主世界层，把视口平移到该分区已知地点的中间；只读，不移动、不发现、不耗时。
    /// 下拉随后回到显示当前层（换 key 重建，避免停在分区项上）。
    /// </summary>
    private void GoRegion(string key)
    {
        var r = G.E.KnownMapRegions(G.S).FirstOrDefault(x => x.Key == key);
        _selectKey++;
        if (r == null) { G.Notify(); return; }
        G.MapLayer = GameEngine.WorldLayer;
        G.MapAnchor = G.S.CurrentLocation;
        G.ClosePop();
        _centerWorld = (r.CenterX, r.CenterY);
        _needCenter = true;
        G.Notify();
    }

    /// <summary>切换查看的层：只换阅读，不移动、不退出地牢；当前位置在该层就居中到当前位置，否则居中到该层已知范围。</summary>
    private void SwitchLayer(string layer)
    {
        G.MapLayer = layer;
        G.MapAnchor = G.S.CurrentLocation;
        G.ClosePop();
        _centerWorld = null;
        _needCenter = true;
        G.Notify();
    }

    private async Task Zoom(int idx)
    {
        idx = Math.Clamp(idx, 0, Zooms.Length - 1);
        if (idx == G.MapZoom || _view == null) return;
        try
        {
            var c = await JS.InvokeAsync<double[]>("survivalMap.getCenter", _vp);
            _centerWorld = ((c[0] - PadX) / _k + _view.MinX, (c[1] - PadY) / _k + _view.MinY);
        }
        catch (JSException) { _centerWorld = null; }
        G.MapZoom = idx;
        G.MapAnchor = G.S.CurrentLocation;
        G.ClosePop();
        _needCenter = true;
        G.Notify();
    }

    /// <summary>“回到当前位置”：当前位置不在正在看的层就切回默认层，然后把视口平移到当前位置（不移动角色）。</summary>
    private void BackToHere()
    {
        if (_view?.HereNode == null) G.MapLayer = null;
        _centerWorld = null;
        _needCenter = true;
        G.Notify();
    }

    private void ToggleLegend()
    {
        G.MapLegend = !G.MapLegend;
        G.Notify();
    }

    private async Task Key(KeyboardEventArgs ev)
    {
        if (ev.Key is "+" or "=") await Zoom(G.MapZoom + 1);
        else if (ev.Key is "-" or "_") await Zoom(Math.Max(1, G.MapZoom - 1));
        else if (ev.Key == "0") BackToHere();
    }

    private void NodeKey(KeyboardEventArgs ev, string id)
    {
        if (ev.Key is "Enter" or " ") Pick(id);
    }

    private void PillKey(KeyboardEventArgs ev, string layer)
    {
        if (ev.Key is "Enter" or " ") SwitchLayer(layer);
    }

    private async Task MiniClick(MouseEventArgs ev)
    {
        if (_view == null || _mini <= 0) return;
        var wx = (ev.OffsetX - 8) / _mini + _view.MinX;
        var wy = (ev.OffsetY - 8) / _mini + _view.MinY;
        try { await JS.InvokeVoidAsync("survivalMap.center", _vp, (wx - _view.MinX) * _k + PadX, (wy - _view.MinY) * _k + PadY); }
        catch (JSException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Part != "center" || G.State == null || _view == null) return;
        var here = G.S.CurrentLocation;
        if (here != _lastHere) { _lastHere = here; _needCenter = true; _centerWorld = null; }
        if (_view.LayerKey != _lastLayer) { _lastLayer = _view.LayerKey; _needCenter = true; }
        // B23 来源查询“定位”：居中到所选来源地点（只平移视口）
        if (G.MapFocus is string focus && _view.Nodes.FirstOrDefault(n => n.Id == focus) is MapViewNode fn)
        {
            G.MapFocus = null;
            _centerWorld = (fn.X, fn.Y);
            _needCenter = true;
        }
        try
        {
            // 视口实测后把四周留白放到至少半个视口，再按新尺寸重画一次后居中
            var sz = await JS.InvokeAsync<double[]>("survivalMap.size", _vp);
            var px = Math.Max(110, Math.Ceiling(sz[0] / 2)); var py = Math.Max(76, Math.Ceiling(sz[1] / 2));
            if (Math.Abs(px - PadX) > 1 || Math.Abs(py - PadY) > 1)
            {
                PadX = px; PadY = py; _needCenter = true;
                StateHasChanged();
                return;
            }
        }
        catch (JSException) { }
        if (!_needCenter) return;
        _needCenter = false;
        try
        {
            var first = _firstCenter;
            _firstCenter = false;
            if (_centerWorld == null && first && await JS.InvokeAsync<bool>("survivalMap.restore", _vp, MapKey(_view.LayerKey))) return;
            double wx, wy;
            if (_centerWorld is (double cx, double cy)) { wx = cx; wy = cy; }
            else if (_view.HereNode != null) { var n = _view.Nodes.First(x => x.Id == _view.HereNode); wx = n.X; wy = n.Y; }
            else { wx = (_view.MinX + _view.MaxX) / 2; wy = (_view.MinY + _view.MaxY) / 2; }
            _centerWorld = null;
            await JS.InvokeVoidAsync("survivalMap.center", _vp, (wx - _view.MinX) * _k + PadX, (wy - _view.MinY) * _k + PadY);
        }
        catch (JSException) { /* 旧缓存的脚本没有 survivalMap 时只是不居中 */ }
    }

    /// <summary>点地图节点：右栏显示详细预估或远处路线；相邻且空闲时在节点旁打开移动确认浮窗（S02 §5、S14 §14.1），本身不移动。</summary>
    private void Pick(string id)
    {
        G.PeekClear();   // B42：明确点选结束悬停查看，右栏回到点选结果
        G.MapPicked = id;
        G.Guide("location", id);   // B13d（Q128）：在地图上查看外出/返营/出区路线是操作前引导的上下文
        var s = G.S;
        var adjacent = G.E.AdjacentUnlocked(s).Any(x => x.Other(s.CurrentLocation) == id);
        if (adjacent && !G.E.IsBusy(s) && !G.Running && !G.DialogueLocked) G.OpenPop("mapnode", id, $"mn-{id}");
        else G.ClosePop();
        G.Notify();
    }

    /// <summary>右栏“选中下一段”：切到下一段目的地所在层并选中它（只确认下一段相邻路，A10-EXUI §1）。</summary>
    private void PickNext(string id)
    {
        var layer = G.E.MapLayerOf(id);
        var v = G.E.BuildMapView(G.S, G.MapLayer);
        if (!v.Nodes.Any(n => n.Id == id)) { G.MapLayer = layer.StartsWith("city:") && !G.S.Locations[layer.Substring(5)].Discovered ? GameEngine.WorldLayer : layer; _needCenter = true; }
        Pick(id);
    }

    private Task Close()
    {
        G.OpenPanel(null);
        return Task.CompletedTask;
    }

    public void Dispose() { }
}
