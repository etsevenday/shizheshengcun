@inherits GameComponent

@* 区域地图。Part="center"：中部的地图画布（相邻地点旁锚定“确认移动”浮窗）；Part="detail"：右栏的地点信息与详细移动预估（只读）。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var adjacent = e.AdjacentUnlocked(s).Select(x => x.Other(here)).ToHashSet();
    var picked = G.MapPicked;
}

@if (Part == "center")
{
    var known = e.Config.Locations.Where(l => s.Locations[l.Id].Discovered).ToList();
    var edges = e.Config.Edges.Where(x => s.UnlockedEdges.Contains(x.Id)).ToList();
    <div class="sub-panel" role="dialog" aria-label="区域地图">
        <div class="sub-head">
            <div><h2>区域地图</h2><span class="sub">已发现@(known.Count)处 · 只显示已知路线 · 点相邻地点在旁边确认移动</span></div>
            <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
        </div>
        <div class="sub-body map-only">
            @{
                // 视野按已发现地点缩放：前期只有两三个地点时不会缩成一角
                var minX = known.Min(l => l.MapX) - 130; var maxX = known.Max(l => l.MapX) + 130;
                var minY = known.Min(l => l.MapY) - 80; var maxY = known.Max(l => l.MapY) + 80;
                var w = Math.Max(maxX - minX, 620); var h = Math.Max(maxY - minY, 300);
                var vx = (minX + maxX - w) / 2; var vy = (minY + maxY - h) / 2;
                var viewBox = FormattableString.Invariant($"{vx:0} {vy:0} {w:0} {h:0}");
            }
            <svg class="map-canvas" viewBox="@viewBox" preserveAspectRatio="xMidYMid meet" role="img" aria-label="地点与路线">
                @foreach (var ed in edges)
                {
                    var a = e.Location(ed.A);
                    var b = e.Location(ed.B);
                    var mx = (a.MapX + b.MapX) / 2;
                    var my = (a.MapY + b.MapY) / 2;
                    var near = ed.Touches(here);
                    <line x1="@a.MapX" y1="@a.MapY" x2="@b.MapX" y2="@b.MapY" stroke="@(near ? "#d6b779" : "#6b7a68")" stroke-width="@(near ? 5 : 3)" stroke-dasharray="@(near ? "" : "10 7")" />
                    <rect x="@(mx - 30)" y="@(my - 15)" width="60" height="28" rx="4" fill="#1b221e" />
                    @SvgText(mx, my + 6, 17, "#c9cfbf", $"{ed.BaseMinutes}分")
                }
                @foreach (var l in known)
                {
                    var st = s.Locations[l.Id];
                    var isHere = l.Id == here;
                    var isPicked = l.Id == picked;
                    var id = l.Id;
                    <g class="map-node" id="@($"mn-{id}")" @onclick="() => Pick(id)" role="button" aria-label="@l.Name">
                        <rect x="@(l.MapX - 95)" y="@(l.MapY - 34)" width="190" height="68" rx="8"
                              fill="@(isHere ? "#3a4a33" : st.Visited ? "#2b3a2e" : "#222b24")"
                              stroke="@(isPicked ? "#f0d9a0" : isHere ? "#d6b779" : "#5d6b58")" stroke-width="@(isPicked || isHere ? 4 : 2)"
                              stroke-dasharray="@(st.Visited ? "" : "8 5")" />
                        @SvgText(l.MapX, l.MapY + 2, 22, "#eee9db", l.Name)
                        @SvgText(l.MapX, l.MapY + 24, 14, "#aab2a4", isHere ? "● 当前位置" : st.Visited ? $"探索度{st.Progress}%" : "待访问")
                        @{ var nd = isHere ? MapDirection.None : e.DirectionFromHere(s, id); }
                        @if (nd != MapDirection.None)
                        {
                            @* Q22（S02、S14 §19）：已显示的非当前已知节点加相对主角的八方向徽标，与地块卡同一数据（DirectionFromHere）；
                               只作展示，不改变可达性；未知节点不在 known 里，不泄露 *@
                            <g class="map-dir" transform="@($"translate({l.MapX - 95 + 4},{l.MapY - 34 - 14})")" pointer-events="none">
                                <title>@GameEngine.DirectionHint(nd)（方位图标，只作展示）</title>
                                <circle cx="16" cy="16" r="16" fill="#20271d" stroke="#e9d9ad" stroke-width="2" />
                                <g transform="@($"translate(4,4) rotate({((int)nd - 1) * 45} 12 12)")"><path d="M12 2.5 19.5 11h-4.6v10.5H9.1V11H4.5Z" fill="#f0d9a0" /></g>
                            </g>
                        }
                    </g>
                }
            </svg>
            <div class="map-legend"><span>金色实线：当前地点的可走路线</span><span>虚线框：已发现未访问</span><span>浏览地图不推进时间</span></div>
        </div>
    </div>
}
else
{
    var target = picked ?? here;
    var tl = e.Location(target);
    var ts = s.Locations[target];
    if (target == here)
    {
        <div class="detail-scroll">
            <div class="op-head">
                <div class="eyebrow">区域地图 · 当前位置</div>
                <h2>@tl.Name</h2>
                <p>@(tl.IsIndoor ? "室内，可遮蔽睡眠" : "露天")@(tl.CanBuildShelter ? " · 营地" : "") · 探索度@(ts.Progress)%</p>
            </div>
            <div class="lines">
                @foreach (var ed in e.AdjacentUnlocked(s))
                {
                    <div><span>→ @e.LocName(ed.Other(here))</span><b>@(ed.BaseMinutes)分钟</b></div>
                }
            </div>
            <div class="tiny muted">在地图上点选相邻地点：地点旁出现移动确认，这里显示详细预估。</div>
        </div>
    }
    else if (adjacent.Contains(target) && !e.IsBusy(s))
    {
        <PreviewView Request="ActionRequest.Travel(target)" Eyebrow="@($"区域地图 · {tl.Name} · {(ts.Visited ? $"探索度{ts.Progress}%" : "待访问")}")" Title="@($"前往{tl.Name}")"
                     Confirmable="false" FootNote="在地图上该地点旁的浮窗确认移动；时间为预计值"
                     Subtitle="一次只移动一段相邻路线，不提供自动寻路。" />
    }
    else
    {
        <div class="detail-scroll">
            <div class="op-head">
                <div class="eyebrow">区域地图 · @(ts.Visited ? $"探索度{ts.Progress}%" : "已发现 · 待访问")</div>
                <h2>@tl.Name</h2>
                <p>@(tl.IsIndoor ? "室内" : "露天")</p>
            </div>
            <div class="blocked">@(e.IsBusy(s) ? "行动进行中，地图只能浏览" : "请先前往相邻地点")</div>
        </div>
    }
}

@code {
    [Parameter] public string Part { get; set; } = "center";

    private static MarkupString SvgText(double x, double y, int size, string fill, string content) =>
        new($"<text x=\"{x}\" y=\"{y}\" text-anchor=\"middle\" font-size=\"{size}\" fill=\"{fill}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    /// <summary>点地图节点：右栏显示详细预估；相邻且空闲时在节点旁打开移动确认浮窗（S02 §5、S14 §14.1），本身不移动。</summary>
    private void Pick(string id)
    {
        G.MapPicked = id;
        var s = G.S;
        var adjacent = G.E.AdjacentUnlocked(s).Any(x => x.Other(s.CurrentLocation) == id);
        if (adjacent && !G.E.IsBusy(s) && !G.Running) G.OpenPop("mapnode", id, $"mn-{id}");
        else G.ClosePop();
        G.Notify();
    }

    private Task Close()
    {
        G.OpenPanel(null);
        return Task.CompletedTask;
    }
}
