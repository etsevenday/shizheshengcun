@inherits GameComponent

@* B42（S14「2026-11-12 悬停卡片／条目立即显示右栏详情」）：右栏「对象」区的悬停只读详情。按对象键分派到点击时用的同一组件、同一事实来源；
   没有独立详情组件的公开条目（PeekKey.Card）显示它自己登记的原公开标题、状态、说明与卡面内容，不另写句子。
   全部只读：不改真正选中、批次、草稿与任务，不提供批次点选与操作页脚。 *@
@{
    PeekKey.TryParse(Key, out var kind, out var parts);
    var first = parts.Length > 0 ? parts[0] : "";
}
<div class="peek-detail" data-peek-shown="@Key">
@switch (kind)
{
    case PeekKey.Sel:
        if (Peek.ParseSel(Key) is Selection sel)
        {
            <SelectionDetail Sel="sel" Peek="true" Batch="@PeekKey.Part(Key, 4)" />
        }
        break;
    case PeekKey.Gear:
        @* 整备来源卡与已穿戴装备：与页内点选同一只读整备详情（Q450、Q462 只列事实） *@
        if (int.TryParse(first, out var gid) && G.E.FindItem(G.S, gid) is ItemInstance git)
        {
            <GearPeekDetail Item="git" />
        }
        break;
    case PeekKey.Node:
        @* 地图已公开节点：与点选同一份右栏地点信息、相邻预估或远处路线（只读，不选中、不开移动盘） *@
        <MapOverlay Part="detail" PeekNode="@first" />
        break;
    case PeekKey.Recipe:
        @* 配方或自动加工说明：与点选同一份右栏详细预估（只读，不换所选配方、份数与材料槽） *@
        <CraftOverlay Part="detail" PeekRecipe="@first" />
        break;
    case PeekKey.Skill:
        @* 熟练度门类：与成长页详情同一份内容（只读，不换所选门类） *@
        <GrowthOverlay Part="detail" PeekSkill="@first" />
        break;
    case PeekKey.Status:
        @* 生存状态项：与状态图标说明同源（名称、效果、剩余时间） *@
        if (StatusView.All(G.E, G.S).FirstOrDefault(c => c.Id == first) is StatusChip chip)
        {
            <div class="detail-scroll peek-status">
                <div class="op-head">
                    <h2><span class="st-ico @(chip.Danger ? "danger" : chip.Harmful ? "bad" : "good")" aria-hidden="true">@Icons.Markup(chip.Icon)</span> @chip.Name</h2>
                    <p>@chip.Effect</p>
                    <p class="muted">@StatusView.RemainingText(chip)</p>
                </div>
            </div>
        }
        break;
    case PeekKey.Card:
        if (G.PeekFactsOf(Key) is PeekFacts f)
        {
            <div class="detail-scroll peek-card">
                <div class="op-head">
                    @if (!string.IsNullOrEmpty(f.Title)) { <h2>@f.Title@if (!string.IsNullOrEmpty(f.State)) { <small class="muted"> @f.State</small> }</h2> }
                    @if (!string.IsNullOrEmpty(f.Desc)) { <p>@f.Desc</p> }
                </div>
                @if (f.Art != null) { <div class="detail-icon peek-art">@f.Art</div> }
                @if (f.Body != null) { <div class="peek-body">@f.Body</div> }
            </div>
        }
        break;
}
</div>

@code {
    [Parameter, EditorRequired] public string Key { get; set; } = "";

    // 登记内容变了（卡片随状态重绘）时立即重绘，不保留过期快照
    protected override void OnInitialized()
    {
        base.OnInitialized();
        G.PeekFactsChanged += OnFacts;
    }

    private void OnFacts() => InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        base.Dispose();
        G.PeekFactsChanged -= OnFacts;
    }
}
