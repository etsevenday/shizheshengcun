@inherits GameComponent

@* B34b（R03 文首「2026-11-13 B34主要Q570—Q572」§Q571／§Q572；a9b93f0 动效合同 battle 七类、《给开发的动效说明》1200ms 时序与近战特写分镜）：
   战斗特写播放层。只读 G.FxNow 这一段出手快照（行动者、承受者、按真实次序的各段结果、同次战报原文），不读当前战斗状态——
   上一场的最后几段播放时下一场的演员、HP 不会混进来。BM7a（S14 Q633）：不可跳过——画面点击由这一层接住、什么也不做（不跳、不点穿、不排队）。
   B52b（R03 Q737）：只读子页（全记录等）开着时也不再退到下面——特写全屏，正文只在镜头间隙可读。
   B34（S14 Q573）：标题为本次真实指令名；结果字用战报原词「未命中」「格挡」「暴击」「倒地」及这次真实新生效的状态名，恢复「+{数值}」、扣血「−{数值}」取真实变化值；
   不另加「行动名 · 伤害」结果条（同次战报原句只给读屏）。BM7a（Q633）：撤去「跳到结果」「跳过余下」按钮与键帽。人物图沿用战场现有立绘（主角立绘、敌人图标）。
   B37a2（动效合同 battle 七类“攻击者及目标素材 ID”）：我方按出手快照里的角色 ID 画其全身图（ActorArt 身份顺序），敌人仍是敌人图。 *@
@if (G.FxNow is BattleFxEvent ev)
{
    var look = ev.Look;
    var allies = Units(ev, true);
    var foes = Units(ev, false);
    @* B52b（R03 Q737）：特写全屏盖住战场、战斗信息与普通全记录，不因全记录打开退层；只有菜单／原系统子页冻结当前帧 *@
    <div class="bfx-layer @(G.FxPaused ? "paused" : "")" data-active
         style="--fx-ms:@(G.FxDurationMs)ms">
        <h2 class="bfx-title" aria-hidden="true">@ev.Name</h2>
        @* B47b（R09 Q692）：战斗外／远处只读生命镜头的标识行“{人物} · {地点}” *@
        @if (ev.Where != null) { <p class="bfx-where" aria-hidden="true">@ev.Where</p> }
        <div class="bfx-stage bfx-@look bfx-m-@ev.Motion @(ev.Actor.IsAlly ? "from-ally" : "from-foe") @(ev.ContinuesSeq != null ? "cont" : "")" @key="G.FxSegment" aria-hidden="true">
            <div class="bfx-group left">@foreach (var u in allies) { @Figure(ev, u) }</div>
            <div class="bfx-group right">@foreach (var u in foes) { @Figure(ev, u) }</div>
            @if (ev.Motion == BattleFxMotion.Ranged) { <i class="bfx-trail @(ev.Actor.IsAlly ? "ltr" : "rtl")"></i> }
        </div>
        <div class="bfx-caption sr-only" aria-live="polite">
            @if (ev.Where != null) { <p>@ev.Where</p> }
            @foreach (var line in ev.Lines) { <p>@line</p> }
        </div>
    </div>
}

@code {
    /// <summary>S14 Q573 列出的战报原词；B47b（R09 Q693）：敌我确死的结果字统一“死亡”（不再用“倒地”兼指仍活着的濒死）。</summary>
    private const string MissWord = "未命中", GuardWord = "格挡", CritWord = "暴击", DownWord = GameEngine.DeathWord;

    /// <summary>
    /// 一段结果的结果字（S14 Q573）：未中「未命中」；格挡「格挡」；暴击「暴击」；扣血「−{数值}」、恢复「+{数值}」取真实变化值（鼓舞提示贴等不显示数值）；
    /// 护甲完全挡住沿同侧战报原句（我方打敌人「被护甲完全挡住」，敌人打我方「被完全挡住」）；无数值效果只显示新生效的状态名（另列）。
    /// </summary>
    private static IEnumerable<string> Words(BattleFxEvent ev, BattleFxResult r)
    {
        if (r.Outcome == "miss") { yield return MissWord; yield break; }
        if (r.Guarded) yield return GuardWord;
        if (r.Outcome == "crit") yield return CritWord;
        if (ev.NoNumbers) yield break;
        if (r.Outcome is "hit" or "crit" && r.Amount > 0) yield return "−" + Ui.N(r.Amount);
        else if (r.Outcome == "heal" && r.Amount > 0) yield return "+" + Ui.N(r.Amount);
        else if (r.Outcome == "blocked" && !r.Guarded) yield return r.Target.IsAlly ? "被完全挡住" : "被护甲完全挡住";
    }

    /// <summary>这一段里出现的角色（行动者在前，再按结果出现的先后），按阵营分到左（我方）右（敌方）。</summary>
    private static List<BattleFxUnit> Units(BattleFxEvent ev, bool ally)
    {
        var list = new List<BattleFxUnit>();
        void Add(BattleFxUnit u) { if (u.IsAlly == ally && !list.Any(x => x.Id == u.Id)) list.Add(u); }
        Add(ev.Actor);
        foreach (var r in ev.Results) Add(r.Target);
        return list;
    }

    private RenderFragment Figure(BattleFxEvent ev, BattleFxUnit u) => __builder =>
    {
        var isActor = u.Side == ev.Actor.Side && u.Id == ev.Actor.Id;
        var rs = ev.Results.Where(r => r.Target.Side == u.Side && r.Target.Id == u.Id).ToList();
        var down = rs.Any(r => r.Down || r.Life == BattleFxLife.Zombie);   // B52b（R09 Q732）：尸变沿确死倒下姿态，结果字仍“尸变”
        // B47b（R09 §7、S14 Q615／Q616）：濒死转黯淡跪姿；医疗回血脱离濒死做起身；支援受益者微光；换位只做动作
        var dying = !down && rs.Any(r => r.Life is BattleFxLife.Dying or BattleFxLife.Resisted);
        var revived = rs.Any(r => r.Life == BattleFxLife.Revived);
        var moved = rs.Any(r => r.Moved);
        var aided = ev.Motion == BattleFxMotion.Support && rs.Count > 0;
        var allMiss = rs.Count > 0 && rs.All(r => r.Outcome == "miss");
        var guarded = rs.Any(r => r.Guarded || r.Outcome == "blocked");
        var hurt = rs.Any(r => r.Outcome is "hit" or "crit");
        var healed = rs.Any(r => r.Outcome == "heal") || (ev.Motion == BattleFxMotion.Heal && rs.Count > 0);
        <div class="bfx-fig @(isActor ? "actor" : "") @(rs.Count > 0 ? "target" : "") @(down ? "down" : "") @(dying ? "dying" : "") @(revived ? "revived" : "") @(moved ? "moved" : "") @(aided ? "aided" : "") @(allMiss ? "dodge" : "") @(guarded ? "guard" : "") @(hurt ? "hurt" : "") @(healed ? "healed" : "")">
            <div class="bfx-chips">
                @for (var i = 0; i < rs.Count; i++)
                {
                    var r = rs[i];
                    <span class="bfx-chip o-@r.Outcome @(r.Guarded ? "g" : "")" style="--i:@i">@foreach (var w in Words(ev, r)) {<span class="bfx-w @(w.StartsWith("−") || w.StartsWith("+") ? "num" : "")">@w</span>}</span>
                    @foreach (var st in r.States) { <span class="bfx-chip o-state" style="--i:@i">@st</span> }
                    @foreach (var ch in r.Changes) { <span class="bfx-chip o-state o-change" style="--i:@i">@ch</span> }
                    @if (r.Down) { <span class="bfx-chip o-down" style="--i:@i">@DownWord</span> }
                    else if (r.Life != null) { <span class="bfx-chip o-life o-@r.Life" style="--i:@i">@GameEngine.LifeWord(r.Life)</span> }
                }
            </div>
            <div class="bfx-art">
                @if (u.IsAlly) { @ArtAssets.ActorFigure(G.VS, u.Id) }
                else { @Icons.Markup("enemy_" + u.EnemyId) }
                @if (guarded) { <i class="bfx-shield"></i> }
                @if (healed || aided) { <i class="bfx-glow @(aided ? "aid" : "")"></i> }
            </div>
            <b class="bfx-name">@u.Name</b>
        </div>
    };
}
