@inherits GameComponent

@* 共用锅卡（基础UI布局与操作修订案 v0.7 第 3 节）：地面栏、随身栏与火堆加工位三处是同一个组件、同一种内容结构——
   锅图与“金属锅#N”、水量条、每种液体一行（图标、名称×份数、毫升、预留说明）、最多两个食材行（图标、名称#实例、加工状态）。
   锅在火堆内时只在火堆卡内渲染，地面/随身栏不出现副本。
   点击：标题行选中整口锅，液体行选中该锅该液体（PotLiquid），食材行选中该份食材；每次点击都阻止冒泡，不同时选中父火堆。
   拖拽把手：标题行（整锅，全部内容随行）、液体图标、食材图标；水量条、按钮、箭头不起拖。
   落点：卡面 card:（等同装水区）、水量条 potfill:、食材区 potfood:（热区优先于卡面，锅满不冒泡成火堆直烤）。 *@
@{
    var s = G.S;
    var e = G.E;
    var c = e.PotConfig(Pot);
    var key = $"{Pot.Owner}|{Pot.ItemId}|{Pot.InstanceId}";
    var name = $"{e.ItemName(Pot.ItemId)}#{Pot.InstanceId}";
    var where = e.WherePath(s, Pot);
    var units = e.PotUnits(s, Pot.InstanceId);
    var liquid = e.PotLiquid(s, Pot.InstanceId);
    var ml = units * c.UnitMl;
    var pct = c.CapacityMl > 0 ? ml * 100 / c.CapacityMl : 0;
    var liquids = e.PotLiquids(s, Pot.InstanceId);
    var foods = e.PotFood(s, Pot.InstanceId);
    var reservedMl = e.PotReservedMl(s, Pot.InstanceId);
    var free = e.PotFreeWaterUnits(s, Pot);
    var sel = G.Selected;
    var potSelected = sel.Kind == SelectionKind.Tool && sel.InstanceId == Pot.InstanceId;
    var batch = e.ProcessOf(s, Pot);
    var loc = e.PotFireLocation(Pot);
    var hot = loc != null && e.FireHot(s, loc);
    var locked = e.IsLocked(s, Pot) || Pot.ReservedBy != null;
    var busy = e.IsBusy(s) || G.Running;
}
@if (!Expanded)
{
    @* 卡面（试玩修复 M77-B2/B3）：固定四行里锅卡只放名称、水量摘要与食材摘要，不再把水/食材行铺在卡内撑高或卡内滚动；
       点锅（或锅里任一项）时，完整内容与操作在锚定于锅卡下方的浮窗里展开（CardPop + PotCard Expanded）。
       落点不变：卡面 card:（等同装水区）、水量条 potfill:、食材摘要 potfood:。 *@
    var childSel = (sel.Kind == SelectionKind.PotLiquid && sel.InstanceId == Pot.InstanceId)
                   || (sel.Kind == SelectionKind.Tool && foods.Any(f => f.InstanceId == sel.InstanceId));
    var foodHeat = foods.Select(f => (f, p: e.ProcessOf(s, f))).ToList();
    // Q35：紧凑模式（屏高≤800）卡面不常驻“#编号·重量”（火堆加工位里各尺寸都不常驻），悬停/键盘聚焦提示写等价全文
    var potSlot = Pot.InFacility ? Ui.FireSlotNo(e, s, Pot) : null;
    var potTip = $"{name} · {Ui.Kg(e.ItemGrams(s, Pot))}公斤{(foods.Count > 0 || units > 0 ? "（含锅内）" : "")} · {where}{(potSlot is int ps ? $"／加工位{ps}" : "")}";
    <div class="pot-card compact @(Pot.InFacility ? "in-fire" : "in-shelf") @(potSelected || childSel ? "selected" : "") @(locked ? "reserved" : "")"
         data-card="@key" data-drop="@($"card:{key}")" data-drop-level="card" @onclick:stopPropagation="true">
        <div class="pc-head" id="@(potSelected || childSel ? "card-sel" : null)" role="button" tabindex="0" data-drag="@($"card:{key}")" data-drag-title="@name" data-drag-from="@where"
             title="@($"{potTip}：点击展开锅里的水与食材并操作；按住标题拖动整锅（水与食材随行）")" data-tip="@potTip"
             @onclick="SelectPot" @onclick:stopPropagation="true" @onkeydown="ev => Key(ev, SelectPot)" @onkeydown:stopPropagation="true">
            <span class="pc-icon">@Icons.Markup(Pot.ItemId)</span>
            @* 卡面窄：名称不带实例号，实例号与重量放第二行（M78：1280 随身行锅名被截成“金…”）；火堆加工位里也写单锅重量（含锅内，M95：Q35“≥801 照常显示”） *@
            <span class="pc-title"><b>@e.ItemName(Pot.ItemId)</b><small>#@Pot.InstanceId · @(Ui.Kg(e.ItemGrams(s, Pot)))公斤</small></span>
            @if (Pot.InFacility)
            {
                <button type="button" class="row-arrow" aria-label="@($"把整口{name}取到随身")" title="取到随身：整锅连同水与食材（不打开操作窗；点标题可选目的地）"
                        disabled="@(locked || busy)" @onclick="TakePot" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">▼</button>
            }
            else
            {
                <TransferArrow Owner="@Pot.Owner" ItemId="@Pot.ItemId" InstanceId="@Pot.InstanceId" Enabled="@(!locked && !busy)" />
            }
        </div>
        <div class="pot-fill @(liquid == "clean_water" ? "clean" : liquid == "dirty_water" ? "dirty" : "")" data-drop="@($"potfill:{Pot.InstanceId}")" data-drop-level="hot"
             title="@($"水量：{e.PotLabel(s, Pot)}{(reservedMl > 0 ? $"，已预留{reservedMl}毫升" : "")}。把净水或脏水卡拖到这里装入1份；按住 Shift 可选数量；点击展开")"
             @onclick="() => { if (liquid != null) SelectLiquid(liquid); else SelectPot(); }" @onclick:stopPropagation="true">
            <div class="pot-fill-head"><b>@(liquid == null ? "空锅" : e.ItemName(liquid)) @(ml)/@(c.CapacityMl)</b>@if (batch != null) {<em>@(hot ? "" : "火灭·")@e.Process(batch.RecipeId).Name @(batch.HeatDoneMinutes)/@(batch.RequiredHeatMinutes)</em>}</div>
            <div class="pot-track"><i style="width:@(pct)%"></i></div>
        </div>
        <div class="pc-sum" data-drop="@($"potfood:{Pot.InstanceId}")" data-drop-level="hot" role="button" tabindex="0"
             title="@($"食材区：生块根、生肉、烤肉拖到这里放进锅（水煮肉只存放），{e.PotFoodHint(s, Pot)}。点击展开")"
             @onclick="() => { if (foods.Count > 0) SelectFood(foods[0]); else SelectPot(); }" @onclick:stopPropagation="true" @onkeydown="ev => Key(ev, SelectPot)" @onkeydown:stopPropagation="true">
            <span class="pc-sum-label">食材@(foods.Count)/@(c.FoodSlots)</span>
            @foreach (var (f, fp) in foodHeat)
            {
                <span class="pc-sum-food @(e.IsSpoiled(s, f) ? "spoiled" : "")" title="@($"{e.ItemName(f.ItemId)}#{f.InstanceId}：{e.ContentStatus(s, f)}{(e.CookXpLine(s, f) is string cx ? " · " + cx : "")}")">@Icons.Markup(f.ItemId)@if (fp != null) {<i style="width:@(Math.Min(100, fp.HeatDoneMinutes * 100 / Math.Max(1, fp.RequiredHeatMinutes)))%"></i>}</span>
            }
        </div>
    </div>
}
else
{
    @* 展开内容（在选卡浮窗里）：每种液体一行、每份食材一行（选中、拖拽把手、取到随身箭头），空食材位落点 *@
    <div class="pot-pop-detail" @onclick:stopPropagation="true">
    @foreach (var w in liquids)
    {
        var wid = w.InstanceId;
        var wsel = sel.Kind == SelectionKind.PotLiquid && sel.InstanceId == Pot.InstanceId && sel.Id == w.ItemId;
        var wReserved = Math.Min(w.Count * c.UnitMl, reservedMl);
        <div class="pc-row liquid @(wsel ? "selected" : "")" role="button" tabindex="0"
             title="@($"{e.ItemName(w.ItemId)} · {where}／{name}：点击选中这份水")"
             @onclick="() => SelectLiquid(w.ItemId)" @onclick:stopPropagation="true" @onkeydown="ev => Key(ev, () => SelectLiquid(w.ItemId))" @onkeydown:stopPropagation="true">
            <span class="pc-ico" data-drag="@($"potchild:{wid}")" data-drag-title="@e.ItemName(w.ItemId)" data-drag-from="@($"{where}／{name}")">@Icons.Markup(w.ItemId)</span>
            <span class="pc-text">
                <span class="pc-name">@e.ItemName(w.ItemId)<b>×@w.Count</b><em>@(w.Count * c.UnitMl)毫升</em></span>
                @if (wReserved > 0) { <span class="pc-status warn" title="@e.ReservedWaterText(s, w)">已预留@(wReserved)毫升@(free < 1 ? " · 暂不可饮用/转移" : "")</span> }
            </span>
            <button type="button" class="row-arrow" aria-label="@($"从锅中取1份{e.ItemName(w.ItemId)}到随身")" title="@($"从锅中取到随身：1份（{c.UnitMl}毫升）成为独立随身卡{(Pot.IsCarried ? "，总携重不变" : "")}")"
                    disabled="@busy" @onclick="() => TakeWater(w)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">▼</button>
        </div>
    }
    <div class="pc-foods" data-drop="@($"potfood:{Pot.InstanceId}")" data-drop-level="hot" title="@($"食材区：生块根、生肉、烤肉拖到这里放进锅（水煮肉只存放），{e.PotFoodHint(s, Pot)}")">
        @foreach (var f in foods)
        {
            var fid = f.InstanceId;
            var fsel = sel.Kind == SelectionKind.Tool && sel.InstanceId == fid;
            var p = e.ProcessOf(s, f);
            var spoiled = e.IsSpoiled(s, f);
            var fname = $"{e.ItemName(f.ItemId)}#{fid}";
            <div class="pc-row food @(fsel ? "selected" : "") @(spoiled ? "spoiled" : "")" role="button" tabindex="0"
                 title="@($"{fname} · {where}／{name}：{e.ContentStatus(s, f)}{(e.CookXpLine(s, f) is string cx ? " · " + cx : "")}")"
                 @onclick="() => SelectFood(f)" @onclick:stopPropagation="true" @onkeydown="ev => Key(ev, () => SelectFood(f))" @onkeydown:stopPropagation="true">
                <span class="pc-ico" data-drag="@($"potchild:{fid}")" data-drag-title="@fname" data-drag-from="@($"{where}／{name}")">@Icons.Markup(f.ItemId)</span>
                <span class="pc-text">
                    <span class="pc-name">@fname</span>
                    <span class="pc-status">@e.ContentStatus(s, f)</span>
                    @if (!spoiled && e.CookXpLine(s, f) is string fcx) { <span class="pc-status">@fcx</span> }
                    @if (p != null && !spoiled)
                    {
                        <span class="heat-track"><i style="width:@(Math.Min(100, p.HeatDoneMinutes * 100 / Math.Max(1, p.RequiredHeatMinutes)))%"></i></span>
                    }
                </span>
                <button type="button" class="row-arrow" aria-label="@($"把{fname}从锅中取到随身")" title="@($"从锅中取到随身：成为独立随身卡{(Pot.IsCarried ? "，总携重不变" : "")}")"
                        disabled="@busy" @onclick="() => TakeFood(f)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">▼</button>
            </div>
        }
        @if (foods.Count < c.FoodSlots)
        {
            <div class="pc-slot" title="空位可拖入生块根、生肉、烤肉或水煮肉">食材 @foods.Count/@c.FoodSlots · 拖入食材</div>
        }
    </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ItemInstance Pot { get; set; } = null!;
    /// <summary>true：选卡浮窗里的展开内容（液体行、食材行）；false：行内卡面摘要。</summary>
    [Parameter] public bool Expanded { get; set; }


    private void SelectPot() =>
        G.Select(new Selection { Kind = SelectionKind.Tool, Id = Pot.ItemId, Owner = Pot.Owner, InstanceId = Pot.InstanceId });

    private void SelectLiquid(string liquidId) =>
        G.Select(new Selection { Kind = SelectionKind.PotLiquid, Id = liquidId, Owner = ItemInstance.ContainerOwner(Pot.InstanceId), InstanceId = Pot.InstanceId });

    private void SelectFood(ItemInstance f) =>
        G.Select(new Selection { Kind = SelectionKind.Tool, Id = f.ItemId, Owner = f.Owner, InstanceId = f.InstanceId });

    // 箭头直接转移（系统策划总册 v1.0 Q5-2，S10 §6、S14 §9.2）：失败整次拒绝、不换目的地，原因写在右栏提示
    private void TakePot() => G.TransferOne(Pot.Owner, Pot.ItemId, Pot.InstanceId, ItemInstance.Carried);

    private void TakeFood(ItemInstance f) => G.TransferOne(f.Owner, f.ItemId, f.InstanceId, ItemInstance.Carried);

    private void TakeWater(ItemInstance w) => G.Instant(InstantRequest.Decant(w.InstanceId, ItemInstance.Carried, 1));

    private static void Key(KeyboardEventArgs ev, Action act)
    {
        if (ev.Key is "Enter" or " ") act();
    }
}
