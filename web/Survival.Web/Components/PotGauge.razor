@inherits GameComponent

@* 锅的两个容量维度（设施与烹饪案第 2 节）：
   水量条（标签“水量”，装载比例，不是角色水分也不是加工进度）是装水热区 potfill:；食材行是食材热区 potfood:，显示 0/2 与加工状态。 *@
@{
    var s = G.S;
    var e = G.E;
    var c = e.PotConfig(Pot);
    var units = e.PotUnits(s, Pot.InstanceId);
    var liquid = e.PotLiquid(s, Pot.InstanceId);
    var ml = units * c.UnitMl;
    var pct = c.CapacityMl > 0 ? ml * 100 / c.CapacityMl : 0;
    var foods = e.PotFood(s, Pot.InstanceId);
    var status = e.ContentStatus(s, Pot);
}
<div class="pot-fill @(liquid == "clean_water" ? "clean" : liquid == "dirty_water" ? "dirty" : "")" data-drop="@($"potfill:{Pot.InstanceId}")" data-drop-level="hot"
     title="@($"水量：{e.PotLabel(s, Pot)}。把净水或脏水卡拖到这里装入1份；按住 Shift 可选数量")">
    <div class="pot-fill-head"><span>水量</span><b>@(liquid == null ? "空锅" : e.ItemName(liquid))@(pct)%</b></div>
    <div class="pot-track"><i style="width:@(pct)%"></i></div>
    @if (!Compact) { <div class="pot-ml">@ml/@(c.CapacityMl)毫升</div> }
</div>
<div class="pot-food" data-drop="@($"potfood:{Pot.InstanceId}")" data-drop-level="hot"
     title="@($"食材区：生块根拖到这里放进锅，{e.PotFoodHint(s, Pot)}")">
    <span>食材</span>
    <span class="pot-food-icons">@foreach (var f in foods) { <i title="@($"{e.ItemName(f.ItemId)}#{f.InstanceId}")">@Icons.Markup(f.ItemId)</i> }</span>
    <b>@foods.Count/@c.FoodSlots</b>
</div>
@if (ShowStatus && !string.IsNullOrEmpty(status) && liquid != null && status != $"{e.ItemName(liquid)}{ml}毫升")
{
    <div class="pot-status">@status</div>
}

@code {
    [Parameter, EditorRequired] public ItemInstance Pot { get; set; } = null!;
    /// <summary>紧凑：火堆卡内的缩略锅卡，不显示毫升行。</summary>
    [Parameter] public bool Compact { get; set; }
    [Parameter] public bool ShowStatus { get; set; } = true;
}
