@inherits GameComponent

@* 晾制架卡（策划答复 Q170，开发计划 v0.9 B22c）：设施栏“设施”组，只在当前区已建成晾制架时出现。卡面写 8 位概况（晾制中/待取/腐败/空），
   点卡打开“晾制架”面板（8 个晾制位：选食谱与空位预览后投料、取消、取出、清理）。样式同安全屋卡。 *@
@{
    var s = G.S;
    var e = G.E;
    var line = e.DryingSummary(s);
    var tip = $"晾制架（{e.ZoneName(s, s.Ground)}）：{e.DryingSlotCount}个独立晾制位，每位一批果干或肉干，被动晾制、不占行动，离开也继续；点击打开晾制架面板";
}
<ObjectCard CssClass="fac-card dry-card" Id="drying-rack" Title="晾制架" Badge="@($"{e.DryingSlotCount}位")" BadgeClass="built" Tooltip="@tip" OnClick="Open" AriaLabel="@($"晾制架：{line}")">
    <Art>@Icons.Markup("dried_meat")</Art>
    <ChildContent>
        <div class="oc-line" title="@tip">@line</div>
    </ChildContent>
</ObjectCard>

@code {
    private void Open() => G.OpenPanel("drying");
}
