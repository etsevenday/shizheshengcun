@inherits GameComponent
@inject IJSRuntime JS

@* 战斗右栏“对象信息”（v0.6 §07；S14 §18.4、R03 §7.4）：只读预测；BM2（Q497）起瞄准中目标预测区底部另有「执行{指令名} Enter」，
   与 Enter、点亮起的合法目标同一校验与去重（取代旧「右栏绝不保留执行按钮」）。
   瞄准中本次明确查看的合法目标（BattleAimTarget：悬停或 ←/→ 指定，移出锚点保留）→ 对该目标的实际预测（AP、体力、命中能力与命中率、暴击、伤害区间、弹药、耐久、噪声、撤退率）；
   未瞄准时显示悬停或选中的敌人详情，移开恢复已选对象；另列最近战斗记录。敌踪选择时显示敌方组成与绕行预测。 *@
@{
    var s = G.S;
    var e = G.E;
    var b = s.Battle;
    // B42（S14 2026-11-12 悬停卡片／条目立即显示右栏详情）：全屏战斗沿用这里的对象信息区。悬停或聚焦敌方锚点、我方锚点或队列头像，
    // 这里临时显示它（与点选查看同一份内容，只读，不改目标、瞄准与行动顺序）；离开保留最后一个，点选查看或换对象即替换；
    // 瞄准预测与指令预览（具体操作）优先。
    var peekKey = b == null ? null : G.PeekKeyNow;
    int? peekFoe = PeekKey.KindOf(peekKey) == PeekKey.Foe && int.TryParse(PeekKey.Part(peekKey!, 0), out var pf) ? pf : null;
    var peekAlly = PeekKey.KindOf(peekKey) == PeekKey.Ally ? PeekKey.Part(peekKey!, 0) : null;
}

@if (b == null && s.Encounter != null)
{
    <div class="detail-scroll">
        <div class="op-head">
            <div class="eyebrow">发现敌踪 · @e.LocName(s.Encounter.LocationId)</div>
            <h2>接敌还是绕行？</h2>
            <p>原@(s.Encounter.Source == "explore" ? "探索" : "清理")的结果已经提交，不会因为这次选择回滚。</p>
        </div>
        @* 试玩修复 M553：这一支 b（s.Battle）一定为空，视角成员取 MeId（敌踪时就是主角），不能读战斗里的 FocusId *@
        @{ var joinIds = e.EncounterJoiners(s).Select(x => x.Id).ToHashSet(); }
        @foreach (var w in e.EncounterEnemies(s))
        {
            var ec = e.Enemy(w.EnemyId);
            @if (!joinIds.Contains(w.Id))
            {
                @* 试玩修复 B7c-2：容量 C 以外的不参战，不列命中/伤害 *@
                <div class="lines enemy-lines"><div><span>@ec.Name</span><b>留在原地、不参战（超出本场容量）</b></div></div>
                continue;
            }
            <div class="lines enemy-lines">
                <div><span>@ec.Name</span><b>健康@(Ui.N(w.Hp))/@(Ui.N(ec.Hp)) · 甲@(Ui.T(ec.Armor))</b></div>
                <div><span>对@(GameEngine.MeId(s) == GameState.PlayerId ? "你" : e.ActorDisplayName(s, GameEngine.MeId(s)))命中率</span><b>@Ui.Pct(GameEngine.HitChance(ec.AttackRating, e.MyBaseDodge(s)))（攻击能力@(Ui.T(ec.AttackRating))对闪避@(Ui.T(e.MyBaseDodge(s)))）</b></div>
                <div><span>伤害</span><b>@Ui.N(ec.DamageMin)—@Ui.N(ec.DamageMax)@(ec.IsZombie ? BiteText(ec) : "")</b></div>
            </div>
        }
        <div class="risk">当前免疫@(Ui.N(s.Body.Immunity))。咬击命中并造成伤害时可能感染。单次咬伤感染概率@(Ui.Pct(e.ExposureChance(s.Body.Immunity)))。</div>
        <ul class="notes">
            <li>接敌：入战恐慌=(100−精神)/2；@e.FearNote(s, e.EncounterJoiners(s), GameEngine.FearEncounter)。每轮推进5分钟世界时间。</li>
            <li>@e.CapacityText(s)：本场最多@(e.BattleCapacity(s))只敌人（含之后被噪声吸引来的增援）。@(e.EncounterStayNote(s) is string cn ? cn + "。" : "")</li>
            <li>绕行：固定@(e.Config.Encounters.BypassMinutes)分钟、按移动消耗；敌人仍留在这里；之后@(Clock.Duration(e.Config.Encounters.PostExitRandomEncounterGraceMinutes))内不会再随机遇敌，主动接近仍可。</li>
        </ul>
    </div>
    <div class="detail-foot"><div class="under">在中间的敌踪卡下方选择接敌或绕行</div></div>
}
else if (b != null)
{
    var awaiting = e.AwaitingPlayer(s);
    var aiming = G.BattleAiming;
    var aimSet = G.AimTargets();
    // 瞄准中：只对本次明确查看的合法目标给出预测（不预选目标、不自动攻击）；BM2（Q497）移出锚点到右栏时保留同一目标；自用/无目标指令按所选指令预测
    int? hoverTarget = aiming && G.BattleAimTarget is int hv && aimSet.Contains(hv) ? hv : null;
    var aimName = aiming ? G.BattleAimConfirm().Name : "";
    var cmd = aiming
        ? BattleCommand.Of(G.BattleAction!, G.AreaAction ? null : hoverTarget, G.BattleItem)
        : G.CurrentBattleCommand();
    @if (G.BattleAction == null && G.Selected.Kind is SelectionKind.ItemGroup or SelectionKind.Tool or SelectionKind.PotLiquid)
    {
        @* 战斗中地面与随身物品仍可查看 *@
        <ItemDetail />
    }
    @* B3：旧“换武器对照页”已删除，改为战斗区武器Ⅰ/武器Ⅱ页签（0AP） *@
    else if (G.BattleAction != null && aiming && hoverTarget == null && !G.AreaAction)
    {
        var o = e.BattleOptions(s).FirstOrDefault(x => x.Action == G.BattleAction);
        <div class="detail-scroll">
            <div class="op-head">
                <div class="eyebrow">战斗第@(b.Round)轮 · 瞄准中</div>
                <h2>@(o?.Label ?? GameEngine.ActionName(G.BattleAction))</h2>
                <p>@(o == null ? "" : $"{(o.Ap < 0 ? "剩余AP" : o.Ap + "AP")}{(o.Energy > 0 ? $" · 体力{Ui.N(o.Energy)}" : "")} · 可选目标{aimSet.Count}个{(o.CooldownRounds > 0 ? $" · 冷却{o.CooldownRounds}轮" : "")}")</p>
                @if (o?.EffectText != null) { <p class="muted">@o.EffectText</p> }
                @if (o?.TargetMode == "suffix") { <p class="muted">贯穿：点哪个敌人就从它的号位打到4号位，每个目标独立判命中；离起点0/1/2/3格伤害×0.65/0.50/0.35/0.25，空位也占一格、不重排。</p> }
            </div>
            @if (G.BattleAimTarget is int hx && !aimSet.Contains(hx) && e.BattleEnemyAt(b, hx) is BattleEnemy he && he.Alive)
            {
                @* 试玩修复 B7c-3：悬停够不到/不可选的目标时，右栏也写原因（与执行同源的 CommandBlocked） *@
                <div class="blocked">@($"{he.Slot}号位 {e.EnemyName(he)}：{e.CommandBlocked(s, BattleCommand.Of(G.BattleAction!, hx, G.BattleItem)) ?? "不是这个指令的目标"}")</div>
            }
            <div class="risk none">@ShellAim.Guide(aimName)</div>
            @if (G.RightNotice != null) { <div class="notice">@G.RightNotice</div> }
        </div>
        <div class="detail-foot">@TargetCycle(aimSet.Count)@AimConfirm(null)<div class="under">@ShellAim.ReadOnly</div></div>
    }
    else if (G.BattleAction != null)
    {
        var p = e.PreviewCommand(s, cmd);
        <div class="detail-scroll">
            <div class="op-head">
                <div class="eyebrow">战斗第@(b.Round)轮 · 指令预览</div>
                <h2>@p.Title</h2>
                <p>@(p.Ap)AP · 体力@(Ui.N(p.EnergyBefore))→@(Ui.N(p.EnergyAfter))@(p.EnergyCost > 0 ? $"（−{Ui.N(p.EnergyCost)}）" : "")</p>
            </div>
            @foreach (var t in p.Targets)
            {
                @* B9（A10 §4.5）：固定写“行动者 → 实际目标”；被保护者接下时写“瞄准A，实际由B承受” *@
                <div class="pv-route">@(b.FocusId == GameState.PlayerId ? "你" : e.ActorDisplayName(s, b.FocusId))（@(GameEngine.PlayerPos(b))号位）→ @(t.Slot)号位 @t.Name@if (t.AimedIndex is int ai && e.BattleEnemyAt(b, ai) is BattleEnemy aimed) {<em>（瞄准@(aimed.Slot)号位@(e.EnemyName(aimed))，实际由它承受）</em>}</div>
                <div class="facts">
                    <div class="fact"><span>目标</span><strong>@(t.Slot)号位 @t.Name</strong></div>
                    <div class="fact"><span>实际命中率</span><strong>@Ui.Pct(t.HitChance)</strong></div>
                    <div class="fact"><span>命中能力 / 对方闪避</span><strong>@Ui.N(t.AccuracyRating) / @Ui.T(t.Evasion)</strong></div>
                    <div class="fact"><span>暴击（命中后）</span><strong>@Ui.Pct(t.CritChance)</strong></div>
                </div>
                @* BM3（Q513）：每目标「伤害（未暴击）」排在「命中能力构成」之前（构成为空不显示、不留空行）；其余行与相对顺序、数值不变 *@
                <div class="lines">
                    <div><span>伤害（未暴击）</span><b>@Ui.N(t.DamageMin)—@Ui.N(t.DamageMax)</b></div>
                    @if (t.AccuracyText != "") { <div><span>命中能力构成</span><b>@t.AccuracyText</b></div> }
                    <div><span>伤害（暴击×@(Ui.T(e.Config.CombatMath.CritFactor))）</span><b>@Ui.N(t.CritDamageMin)—@Ui.N(t.CritDamageMax)</b></div>
                    <div><span>目标健康</span><b>@Ui.N(t.Hp)@(t.Armor > 0 ? $" · 护甲{Ui.T(t.Armor)}{(t.Penetration > 0 ? $"−穿透{Ui.T(t.Penetration)}" : "")}（已扣）" : "")@(t.Guarded ? " · 防御中×0.5" : "")@(t.DamageBuff > 1 + 1e-9 ? $" · 伤害增益×{Ui.T(t.DamageBuff)}{(t.RawDamageBuff > t.DamageBuff + 1e-9 ? $"（合计×{Ui.T(t.RawDamageBuff)}，超过×1.35的部分递减）" : "")}" : "")</b></div>
                </div>
            }
            @if (p.RetreatChance.HasValue)
            {
                <div class="facts"><div class="fact"><span>撤退成功率</span><strong>@Ui.Pct(p.RetreatChance.Value)</strong></div>
                    <div class="fact"><span>速度（@(b.FocusId == GameState.PlayerId ? "你" : e.ActorDisplayName(s, b.FocusId))/敌方最高）</span><strong>@Ui.Speed(e.PlayerEffectiveSpeed(s, b)) / @Ui.Speed(b.Alive.Where(x => x.Hostile).Select(e.EnemyEffectiveSpeed).DefaultIfEmpty(0).Max())</strong></div></div>
            }
            <div class="lines">
                @if (p.AmmoText != null) { <div><span>弹药</span><b>@p.AmmoText</b></div> }
                @if (p.WearText != null) { <div><span>耐久</span><b>@p.WearText</b></div> }
                @if (p.NoiseAfter > p.NoiseBefore) { <div><span>噪声</span><b>@Ui.T(p.NoiseBefore)→@Ui.T(p.NoiseAfter)/@Ui.T(e.Config.Noise.Max)</b></div> }
            </div>
            @if (p.Notes.Count > 0) { <ul class="notes">@foreach (var n in p.Notes) { <li>@n</li> }</ul> }
            @if (!p.Ok) { <div class="blocked">@p.Reason</div> }
            @if (G.RightNotice != null) { <div class="notice">@G.RightNotice</div> }
        </div>
        <div class="detail-foot">
            @* S14 §18.4、R03 §7.4：无目标类指令的提交入口在战斗区操作台“确认”，这里只作完整预测；BM2（Q497）瞄准中补「执行{指令名} Enter」 *@
            @if (aiming) { @TargetCycle(aimSet.Count) @AimConfirm(p.Ok ? null : p.Reason) }
            @* BM3（Q512）：无目标类指令的指引引用操作台真实确认按钮的同一业务文字（不含 Enter 键帽）；没有该按钮时不显示 *@
            @if (aiming) { <div class="under">@ShellAim.Guide(aimName)</div> }
            else if (G.BattleConsoleConfirmText() is string confirmText) { <div class="under">@ShellAim.ConsoleGuide(confirmText)</div> }
        </div>
    }
    else if ((peekAlly ?? G.BattleAllyView) != null && G.BattleHover == null && peekFoe == null)
    {
        @* B9（A10 §4.1）：点我方锚点/队列头像只查看状态，不夺回合、不替换当前行动者 *@
        // B9a：按被查看的那名成员本人取数（不是当前行动者）；B42：悬停的成员优先于点选查看的成员
        var vid = (peekAlly ?? G.BattleAllyView)!;
        (double Speed, double Base, double Gear, List<string> Status) mySpeed;
        using (e.FocusOn(s, vid)) mySpeed = e.PlayerSpeedParts(s, b);
        var vf = b.Fighter(vid);
        var va = s.Actor(vid);
        var vAct = GameEngine.ActingAlly(b) == vid;
        var apMax = vAct && vf.ActivationAp > 0 ? vf.ActivationAp : e.NormalActivationAp(va);
        <div class="detail-scroll">
            @if (G.RightNotice != null) { <div class="blocked pin">@G.RightNotice</div> }
            <div class="op-head">
                <div class="eyebrow">战斗第@(b.Round)轮 · 我方@(GameEngine.AllyPos(b, vid))号位 · 只查看</div>
                <h2>@(vid == GameState.PlayerId ? "你" : e.ActorDisplayName(s, vid))</h2>
            </div>
            <div class="lines">
                <div><span>健康 / 体力</span><b>@Ui.N(va.Stats.Health)/@Ui.T(va.Stats.HealthMax) · @Ui.N(va.Stats.Energy)/@Ui.T(va.Stats.EnergyMax)</b></div>
                <div><span>行动点</span><b>@(vAct ? $"本次{(b.ActingPursuit ? "追击" : "普通激活")}剩{vf.Ap}/{apMax}" : $"等待；每次普通激活{e.NormalActivationAp(va)}AP（战术训练阶位{va.TacticalTier}）")</b></div>
                <div><span>有效速度</span><b>@Ui.Speed(mySpeed.Speed)（基础@(Ui.Speed(mySpeed.Base))、装备@(Ui.SignedT(mySpeed.Gear))@(mySpeed.Status.Count > 0 ? "、" + string.Join("、", mySpeed.Status) : "")）</b></div>
                <div><span>追击进度</span><b>@Ui.T(vf.Pursuit)/100</b></div>
                <div><span>恐慌</span><b>@Ui.N(vf.Panic)@(vf.Frightened ? "（受惊）" : "")</b></div>
                @if (va.Body.Infected) { <div><span>感染</span><b>病毒@(Ui.N(va.Body.VirusLoad))</b></div> }
                @if (va.Body.BleedTriggers > 0) { <div><span>出血</span><b>@Ui.T(va.Body.BleedDamage)×@va.Body.BleedTriggers</b></div> }
                @if (GameEngine.AllyProtector(b, vid) is string pg) { <div><span>保护</span><b>@(pg == GameState.PlayerId ? "你" : e.ActorDisplayName(s, pg))护着（接下一次单体攻击）</b></div> }
            </div>
        </div>
        <div class="detail-foot"><div class="under">点己方只查看；行动顺序由队列决定</div></div>
    }
    else
    {
        var focus = G.BattleHover ?? peekFoe ?? G.BattleTarget;
        var t = focus.HasValue ? e.BattleEnemyAt(b, focus.Value) : null;
        <div class="detail-scroll">
            @* 试玩修复 B7d-6：点了不可用的技能/指令，原因放在最上面（原先在最近战斗记录下面，常常看不到）；
               试玩修复 M503：1280×720 首战系统提示开着时右栏只剩一百多像素，放到说明之下会被裁，所以放在滚动区最顶并贴住 *@
            @if (G.RightNotice != null) { <div class="blocked pin">@G.RightNotice</div> }
            <div class="op-head">
                <div class="eyebrow">战斗第@(b.Round)轮 · @(awaiting ? $"{(b.FocusId == GameState.PlayerId ? "你" : e.ActorDisplayName(s, b.FocusId))}的行动（剩{b.PlayerAp}AP）" : G.BattleShownActor > 0 ? "敌方行动中" : b.Cursor >= b.Queue.Count ? "轮末结算" : b.Queue[b.Cursor] <= 0 ? "等待我方行动" : "敌方行动中")</div>
                <h2>@(t != null && t.Alive ? $"{t.Slot}号位 {e.EnemyName(t)}" : "选择指令")</h2>
                @if (t == null || !t.Alive) { <p>先在操作台选技能，再把鼠标移到亮起的目标上看预测、点击目标执行；没选技能时点敌卡只查看。</p> }
            </div>
            @if (t != null && t.Alive)
            {
                var ec = e.Enemy(t.EnemyId);
                <div class="lines">
                    <div><span>健康</span><b>@Ui.N(t.Hp)/@Ui.N(ec.Hp)</b></div>
                    @{ var brk = t.ArmorBreak > 0 && t.ArmorBreakUntilRound >= b.Round ? t.ArmorBreak : 0; }
                    @* 试玩修复 M150 UX9：被破甲时写有效护甲（基础与破甲量在括号里） *@
                    <div><span>护甲 / 闪避 / 速度</span><b>@(brk > 0 ? $"{Ui.T(Math.Max(0, ec.Armor - brk))}（基础{Ui.T(ec.Armor)}，破甲−{Ui.T(brk)}）" : Ui.T(ec.Armor)) / @Ui.T(ec.Dodge) / @Ui.Speed(e.EnemyEffectiveSpeed(t))</b></div>
                    <div><span>行动点 / 站位</span><b>@(ec.Ap)AP@(ec.Elite ? "（精英）" : "") · 己位@(ec.OwnSlots)→目标@(ec.TargetSlots) · 控制抗性@(Ui.T(ec.ControlResist))%</b></div>
                    <div><span>攻击能力 / 对@(b.FocusId == GameState.PlayerId ? "你" : e.ActorDisplayName(s, b.FocusId))命中率</span><b>@Ui.T(ec.AttackRating) / @Ui.Pct(GameEngine.HitChance(ec.AttackRating, e.MyBaseDodge(s)))</b></div>
                    @{ var plan = G.E.PlanFor(G.S.Battle!, t, G.E.StepOf(t)); var approach = plan is GameEngine.ReachPlan.Approach or GameEngine.ReachPlan.AdvanceThenApproach; }
                    @* 试玩修复 B7d-3：迫近时不再把原意图（可能是咬击）写成“公开意图”，免得误会迫近会咬；Q97/Q103：有合法迎击者才写“会触发××的架矛迎击”（与敌卡意图、执行同源） *@
                    @{ var braceBy = approach ? G.E.BraceResponder(G.S, G.S.Battle!, t, plan == GameEngine.ReachPlan.AdvanceThenApproach ? t.Pos - 1 : t.Pos) : null; var multi = GameEngine.AlliesOnField(G.S.Battle!).Count > 1; }
                    <div><span>本轮意图</span><b>@G.E.IntentShown(G.S.Battle!, t, G.S)@(approach ? $"（迫近先花1AP、算一次主动前移，{(braceBy != null ? $"会触发{(multi ? $"{(braceBy == GameState.PlayerId ? "你" : G.E.ActorDisplayName(G.S, braceBy))}（{GameEngine.AllyPos(G.S.Battle!, braceBy)}号位）的" : "你的")}架矛迎击（{(multi ? "号位从前到后第一名合法的架矛者，一次只迎击一人；" : "")}出手时再按武器、射程、耐久与剩余次数判断）；被迎击打死或打断就不再近袭" : $"{(multi ? "我方" : "你")}现在没有能迎击它的架矛，不会被迎击")}；只做一次弱近袭：不咬、不附控制、不改号位；够得着你时的原意图：{G.E.IntentLabel(t, G.S.Battle)}）" : G.E.IntentOutOfReach(G.S.Battle!, t) ? $"（公开意图：{G.E.IntentLabel(t, G.S.Battle)}）" : "")</b></div>
                    @* B8b Q91：意图只公开目标范围与“攻击时随机”，不预先写抽中谁（抽中的人在攻击提交后写进战斗日志） *@
                    @if (G.E.IntentTargetNote(G.S, G.S.Battle!, t) is string tn) { <div><span>目标</span><b>@tn</b></div> }
                </div>
                @if (ec.IsZombie && !e.CanBite(ec)) { <div class="risk none">它的意图里没有咬击，不会咬伤，攻击不传播病毒。</div> }
                else if (ec.IsZombie) { <div class="risk">咬击命中并造成伤害时可能感染。单次咬伤感染概率@(Ui.Pct(e.ExposureChance(s.Body.Immunity)))。抓击、喷吐、尖啸不会感染。</div> }
                else if (ec.IsHuman) { <div class="risk none">敌对人类的攻击不会传染僵尸病毒。</div> }
                else { <div class="risk none">动物撕咬不会传染僵尸病毒，@(ec.Intents.Cycle.Any(x => x.BleedPct > 0) ? "但命中有概率出血" : "但仍会造成伤害")。</div> }
                @if (B7Status(b, t) is string est) { <div class="risk none">@est</div> }
            }
            <div class="lines">
                <div><span>恐慌</span><b>@Ui.N(b.Panic)@(e.Config.Panic.PenaltyFor(b.Panic) is PanicPenaltyConfig pp ? $"（≥{Ui.T(pp.Minimum)}：命中能力×{Ui.T(pp.AccuracyRatingFactor)}、撤退×{Ui.T(pp.RetreatFactor)}）" : "")</b></div>
                <div><span>@(b.FocusId == GameState.PlayerId ? "你" : e.ActorDisplayName(s, b.FocusId))的闪避能力</span><b>@Ui.T(e.MyBaseDodge(s))</b></div>
                <div title="控制成功率=clamp(75%+控制能力−抗性, 10%, 95%)；稳态期间抗性再+30；装备“位移抵抗”只防拉扯/击退，不防失衡/减速"><span>@(b.FocusId == GameState.PlayerId ? "你" : e.ActorDisplayName(s, b.FocusId))的控制抗性</span><b>基础@(Ui.T(e.MyBaseControlResist(s))) · 拉扯/击退@(Ui.T(e.PlayerControlResist(s, b, "pull")))@(b.PlayerSteadyUntilRound >= b.Round ? "（稳态另+30）" : "")</b></div>
                <div><span>本场世界时间</span><b>@Clock.Duration(b.Ticks * e.Config.Time.TickMinutes)（每轮5分钟）</b></div>
            </div>
            @* B9：最近战斗记录移到右下“战报”（完整记录点“查看记录”），这里只放对象信息 *@
        </div>
        <div class="detail-foot"><div class="under">地面与随身在底部“物资查看”（只读）；切页、装填与用药在操作台。</div></div>
    }
}

@code {
    /// <summary>
    /// B43（S14「战斗目标预测切换」）：瞄准中原目标预测区的「上一目标 ←」「下一目标 →」，与方向键同一入口 BattleCycleTarget——
    /// 只在合法目标间移动预测（悬停），不提交攻击；没有合法目标时禁用（键也无效）。只在全屏战斗里给（方向键只在全屏战斗路由）。
    /// </summary>
    private RenderFragment TargetCycle(int legal) => __builder =>
    {
        if (!G.BattleFullscreen) return;
        <div class="bp-cycle" role="group" aria-label="切换预测目标">
            <button type="button" class="secondary" aria-keyshortcuts="ArrowLeft" disabled="@(legal == 0)" @onclick="() => G.BattleCycleTarget(-1)">@ShellKeys.PrevTarget <kbd class="kc kc-sym">@ShellKeys.PrevTargetCap</kbd></button>
            <button type="button" class="secondary" aria-keyshortcuts="ArrowRight" disabled="@(legal == 0)" @onclick="() => G.BattleCycleTarget(1)">@ShellKeys.NextTarget <kbd class="kc kc-sym">@ShellKeys.NextTargetCap</kbd></button>
        </div>
    };

    /// <summary>
    /// BM2（Q497）：目标预测区底部「执行{指令名} Enter」——业务名与键帽同一按钮；只在全屏战斗瞄准中出现（无所选指令的查看、无目标类指令不出现）。
    /// 不可用时禁用并在按钮下写第一条真实原因（与上方预测里已写的同一句不重复写）；点击与回车同一入口 BattleAimSubmit。
    /// </summary>
    private RenderFragment AimConfirm(string? shownAbove) => __builder =>
    {
        if (!G.BattleFullscreen || !G.BattleAiming) return;
        var st = G.BattleAimConfirm();
        var token = G.BattleExecToken();
        <div class="bp-confirm">
            <button type="button" class="primary bp-go" data-aim-confirm aria-keyshortcuts="Enter" disabled="@(!st.Ok)" title="@st.Why"
                    @onclick="() => G.BattleAimSubmit(token)">@ShellAim.ConfirmLabel(st.Name)<EnterCap On="@st.Ok" /></button>
            @if (!string.IsNullOrEmpty(st.Why) && st.Why != shownAbove) { <div class="bp-why warn-text" role="status">@st.Why</div> }
        </div>
    };

    // B42 试玩修复：悬停换成另一名敌人或队友时对象信息区滚动回到顶部；同一对象刷新不复位
    private string? _shownPeek;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var k = G.State != null && G.S.Battle != null && PeekKey.KindOf(G.PeekKeyNow) is PeekKey.Foe or PeekKey.Ally ? G.PeekKeyNow : null;
        if (k == _shownPeek) return;
        _shownPeek = k;
        if (k == null) return;
        try { await JS.InvokeVoidAsync("survivalPeek.top", ".bfs-info .detail-body"); }
        catch (JSException) { /* 旧缓存 app.js 没有 top：只是不复位 */ }
    }

    /// <summary>丧尸的咬击口径（A09 §1 意图循环）：抓击类的咬击改判概率，或循环里固定的一次咬击；没有咬击写明。</summary>
    private static string BiteText(EnemyConfig ec)
    {
        var steps = ec.Intents.Opening.Concat(ec.Intents.Cycle).ToList();
        var pct = steps.Where(x => x.Kind == "attack").Select(x => x.BitePct).DefaultIfEmpty(0).Max();
        if (pct > 0) return $" · 攻击时{Ui.T(pct)}%改为咬击";
        return steps.Any(x => x.Kind == "bite") ? " · 循环里有一次咬击" : " · 不咬击";
    }

    /// <summary>敌人身上的技能状态（B7）：标记、破甲、虚弱、保护、弹药。</summary>
    private static string? B7Status(BattleState b, BattleEnemy t)
    {
        var parts = new List<string>();
        if (GameEngine.EnemyMarked(b, t)) parts.Add($"被标记：命中能力+{Ui.T(t.MarkBonus)}（到第{t.MarkUntilRound}轮末）");
        if (t.ArmorBreak > 0 && t.ArmorBreakUntilRound >= b.Round) parts.Add($"破甲−{Ui.T(t.ArmorBreak)}（到第{t.ArmorBreakUntilRound}轮末）");
        if (GameEngine.EnemyWeak(b, t)) parts.Add($"虚弱：伤害×{Ui.T(t.WeakFactor)}（到第{t.WeakUntilRound}轮末）");
        if (t.ProtectingIndex > 0) parts.Add("正在保护同伴：对同伴的单体攻击由它接下");
        if (t.Mag >= 0) parts.Add($"弹仓{t.Mag}，备弹{t.Reserve}（打空不补）");
        return parts.Count == 0 ? null : string.Join("；", parts);
    }
}
