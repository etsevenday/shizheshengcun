@inherits GameComponent

@* 鉴定所鉴定交易面板（开发计划 v0.9 B18；R07 X3.6 玩家界面必要字段）：挂在陶岑“事项”面板里“活性样本鉴定”一项下（三城鸟瞰随 B24）。
   服务所在地/可用状态/执行者、免费说明/详细鉴定/换物三页；样本列表（白色品质、来源类别、数量1、持有处、预留、鉴定状态）；
   既定融合预览；鉴定耗时与耗材真实来源；当日报价v2（份数/普通品质/重量/落点/报价日/下次午夜）与剩余包数；不可用写具体原因。
   浏览、换样本、换报价都 0 分钟、不提交；只有按“开始鉴定”“交出1份并换取……”才开工。 *@
@{
    var s = G.S;
    var e = G.E;
    var v = e.AppraisalPreview(s);
    var sample = v.Samples.FirstOrDefault(x => x.InstanceId == _sample) ?? v.Samples.FirstOrDefault(x => !x.Reserved) ?? v.Samples.FirstOrDefault();
    // B38c（N02 附录 Q299）：换物页地面样本按地面卡一堆一行，行上绑定的实例由引擎按现行样本顺序挑；按行键记住所选行，没选过就跟随另两页所选样本所在的行
    var trade = _tab == "trade";
    var tsample = v.TradeSamples.FirstOrDefault(x => x.RowKey == _tradeRow)
                  ?? (_tradeRow == null && sample != null ? v.TradeSamples.FirstOrDefault(x => x.MemberIds.Contains(sample.InstanceId)) : null)
                  ?? v.TradeSamples.FirstOrDefault(x => !x.Reserved) ?? v.TradeSamples.FirstOrDefault();
    var rows = trade ? v.TradeSamples : v.Samples;
    var busy = G.Running ? GameEngine.CityBusyText : null;
}

<section class="city-svc appraisal-panel">
    <h3>@Title <small>@v.LocationName · 执行者：@v.ActorName · @v.Status</small></h3>
    @if (!string.IsNullOrEmpty(NpcLine)) { <p class="city-line">“@NpcLine”</p> }
    <div class="btn-row ap-tabs" role="tablist">
        <button class="@(_tab == "info" ? "primary" : "secondary")" role="tab" @onclick='() => _tab = "info"'>免费说明 · 0分钟</button>
        <button class="@(_tab == "appraise" ? "primary" : "secondary")" role="tab" @onclick='() => _tab = "appraise"'>详细鉴定 · @(v.AppraiseMinutes)分钟</button>
        <button class="@(_tab == "trade" ? "primary" : "secondary")" role="tab" @onclick='() => _tab = "trade"'>以物换物 · @(v.TradeMinutes)分钟</button>
    </div>
    @if (v.PendingText != null) { <p class="warn-text small">@v.PendingText</p> }

    @if (v.Samples.Count == 0)
    {
        <p class="small muted">随身和@(v.OutputPlace.Split('（')[0])都没有活性物质。没有样本也可以先听说明（陶岑的委托“鉴定之前”“样本去向”），不用交样本。</p>
    }
    else
    {
        <div class="city-targets ap-samples">
            @foreach (var x in rows)
            {
                var id = x.InstanceId;
                var rk = x.RowKey;
                var on = trade ? tsample?.RowKey == rk : sample?.InstanceId == id;
                <label @key="rk" class="@(x.Reserved ? "muted" : "")" title="@($"来源事件（开发核验）：{(x.DevSource == "" ? "无" : x.DevSource)}")">
                    <input type="radio" name="ap-sample" checked="@on" @onchange="() => { if (trade) _tradeRow = rk; else _tradeRow = null; _sample = id; }" />
                    <b>@x.Name</b>
                    <span class="small">@x.QualityText · @x.SourceText · @x.PickText · @x.HolderText@(x.Reserved ? " · 已预留" : "") · @x.AppraisalText</span>
                </label>
            }
        </div>
    }

    @if (_tab == "info")
    {
        <p class="small">说明不耗时、不扣东西，也不要求先鉴定；只想判断能不能融合，看这里就够了。</p>
        @if (sample != null)
        {
            <p class="small">@sample.FusionText</p>
            @if (sample.Tutorial)
            {
                var sid = sample.InstanceId;
                <div class="btn-row">
                    <GateButton Class="primary" Name="看教学样本免费说明（0分钟）" Blocked="@busy" Title="0分钟、不扣植物纤维、不耗样本；首次查看把所选这一份记为已鉴定（改名“活性物质（白色·已鉴定·首战教学）”，同堆其余份不变）" OnClick="() => G.AppraisalTutorialNote(sid)">看教学样本免费说明（0分钟）</GateButton>
                    <span class="muted small">教学样本可看免费说明，不能交易。</span>
                </div>
            }
        }
    }
    else if (_tab == "appraise")
    {
        <p class="small">耗时@(v.AppraiseMinutes)分钟（固定等待，同行者一起等）· 耗材：@v.AppraiseCost · 来源：@v.FiberSourceText</p>
        <p class="small">详细鉴定只为普通白色写一份档案：不会提升品质、不会产生新词条，也不改变融合结果；不给经验。已鉴定的再看免费、不重复收费。</p>
        var why = v.Blocked ?? (sample == null ? "先选一份样本" : sample.AppraiseBlocked) ?? v.FiberBlocked ?? busy;
        var sid = sample?.InstanceId ?? 0;
        <div class="btn-row">
            @{ var startName = $"开始鉴定（{v.AppraiseMinutes}分钟，完成扣{v.AppraiseCost.Split('（')[0]}）"; }
            <GateButton Class="primary" Name="@startName" Blocked="@why" Title="开始后中途停下：已过时间保留，样本与纤维都不扣" OnClick="() => G.StartAppraise(sid)">@startName</GateButton>
            @if (why != null) { <span class="muted small">@why</span> }
        </div>
    }
    else
    {
        @* B38b（N02 附录 §2、Q288 选 A）：主句只写实际地面名；删去货币与回售长说明 *@
        <p class="small">交出所选普通样本1份，任选一包。换得的物资落在@(v.OutputGround)。</p>
        @if (v.Offers.Count > 0)
        {
            var offer = v.Offers.FirstOrDefault(o => o.OfferId == _offer) ?? v.Offers[0];
            <div class="city-targets ap-offers">
                @foreach (var o in v.Offers)
                {
                    var oid = o.OfferId;
                    <label title="@o.RangeText">
                        <input type="radio" name="ap-offer" checked="@(offer.OfferId == oid)" @onchange="() => _offer = oid" />
                        <b>@o.Text</b> <span class="small muted">@o.RangeText</span>
                    </label>
                }
            </div>
            @* Q288：报价锁定时三行——额度、报价名与锁定日、下次世界午夜恢复；锁表说明沿原句另列 *@
            <p class="small">可用@(v.QuotaAvailable) · 预留@(v.QuotaReserved) · 已用@(v.QuotaUsed)（全队每日共@(v.QuotaTotal)包）</p>
            <p class="small">@v.QuoteTitle：第@(v.QuoteDay)日锁定</p>
            <p class="small">下次世界午夜@(v.NextMidnightText)起恢复@(v.QuotaTotal)包</p>
            <p class="small muted">@v.QuoteLockNote</p>
            var why = v.Blocked ?? v.TradeBlocked ?? (tsample == null ? "先选一份样本" : tsample.TradeBlocked) ?? busy;
            var sid = tsample?.InstanceId ?? 0;
            var oid2 = offer.OfferId;
            <div class="btn-row">
                @{ var tradeName = $"交出1份并换取{offer.ItemName}×{offer.Quantity}（{v.TradeMinutes}分钟）"; }
                <GateButton Class="primary" Name="@tradeName" Blocked="@why" Title="@($"交出{tsample?.Name}1份（{tsample?.HolderText}），{v.TradeMinutes}分钟后{offer.Text}落在{v.OutputPlace}；中途停下不交样")"
                            OnClick="() => G.StartAppraisalTrade(sid, oid2)">@tradeName</GateButton>
                @if (why != null) { <span class="muted small">@why</span> }
            </div>
        }
        else
        {
            <p class="small muted">@(v.TradeBlocked ?? "当日报价表还没锁定")</p>
        }
    }
</section>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string NpcLine { get; set; } = "";

    private string _tab = "info";
    private int _sample;
    private string? _tradeRow;
    private string _offer = "";
}
