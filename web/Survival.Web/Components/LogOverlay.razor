@inherits GameComponent

<div class="overlay" role="dialog" aria-label="行动日志">
    <div class="overlay-head">
        <div><h2 style="display:inline">行动日志</h2><span class="sub">最近@(G.S.Log.Count)条 · 最新在上</span></div>
        <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
    </div>
    <div class="log-list">
        @foreach (var l in Enumerable.Reverse(G.S.Log))
        {
            <div><span class="t">@Clock.DayTime(l.Minute)</span><span class="@Cls(l.Kind)">@l.Text</span></div>
        }
    </div>
</div>

@code {
    private static string Cls(string kind) => kind switch
    {
        "Alert" or "ActionPaused" => "warn-text",
        "Hazard" or "Death" or "ActionAborted" => "danger-text",
        "ActionCompleted" or "SevenDay" => "good-text",
        _ => "",
    };

    private void Close()
    {
        G.Panel = null;
        G.Notify();
    }
}
