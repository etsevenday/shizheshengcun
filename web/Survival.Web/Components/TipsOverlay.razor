@inherits GameComponent

@* 顶栏“生存提示”（S14 §12.3、S15 §6）：当前有效的身体提醒（与暂停提醒同源 AlertText）+ 既有求生建议。
   只浏览，不是任务门槛；危险原因、保存失败、死亡等即时反馈仍在主界面（中央条、结果条、页脚）立即显示，不只藏在这里。 *@
@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    var tips = cfg.Progress.Tips;
    var now = Stats.All.Where(id => s.Stats.Get(id) <= 0 && id != StatId.Health || cfg.Thresholds[GameEngine.StatKey(id)].IsBelow(s.Stats.Get(id)))
        .Select(id => (id, zero: s.Stats.Get(id) <= 0 && id != StatId.Health)).ToList();
    var cur = tips.Count == 0 ? -1 : ((G.TipIndex % tips.Count) + tips.Count) % tips.Count;
}

<div class="sub-panel tips-panel" role="dialog" aria-label="生存提示">
    <div class="sub-head">
        <div><h2>生存提示</h2><span class="sub">求生建议，不消耗时间</span></div>
        <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
    </div>
    <div class="sub-body tips-body" data-wheel="y">
        <section class="tips-now">
            <h3>当前状况</h3>
            @if (now.Count == 0)
            {
                <div class="risk none">各项状态都在提醒线以上。</div>
            }
            @foreach (var (id, zero) in now)
            {
                <div class="risk @(zero || id == StatId.Health ? "danger" : "")">@e.AlertText(id, zero) 当前@(GameEngine.StatName(id))@Ui.N(s.Stats.Get(id))。</div>
            }
        </section>
        @if (tips.Count > 0)
        {
            <section class="tips-list">
                <h3>求生建议</h3>
                <ol>
                    @for (var k = 0; k < tips.Count; k++)
                    {
                        <li class="@(k == cur ? "now" : "")">@Ui.TipText(e, tips[k])</li>
                    }
                </ol>
            </section>
        }
    </div>
</div>

@code {
    private void Close() => G.OpenPanel(null);
}
