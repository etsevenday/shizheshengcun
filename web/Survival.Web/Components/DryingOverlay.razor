@inherits GameComponent
@inject IJSRuntime JS

@* 晾制架面板（策划答复 Q170，S11/A07「八位晾架完整定稿」；开发计划 v0.9 B22c）：当前区晾制架的 8 个独立晾制位。
   空位：选食谱（果干/肉干）→ 预览写明投到第几位、取哪几份原料（只取随身与当前地面）、完成时刻、经验与日额 → 确认投料（0 分钟）。
   晾制中：进度条、剩余时间、原料保质；“取消·到随身/到地面”：果干按原截止退回，肉干恢复投料时的剩余保质（Q215）。已晾好：“取到随身/取到地面”。原料腐败：“清理·到随身/到地面”（原样取出）。
   全部数据来自内核 DryingSlotViews / DryingPreview；按钮的禁用原因写在悬停提示里。样式沿用安全屋面板。
   B22k（Q214/Q215）：肉干预览与位上写“开始制作后暂停原料保质计时，取消后恢复剩余时长”，不再标制作中腐败红字；果干临期红字“会在完成前腐败，届时停止且没有成品”。
   点“投料…”记下当时预览的来源（SourceKey），确认时带给内核重验；预览变了先提示、要求看新预览再确认，不悄悄换料。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = e.DryingRackHere(s);
    var views = here ? e.DryingSlotViews(s) : new List<DryingSlotView>();
    var recipes = e.DryingRecipes.ToList();
    var busy = G.Running || s.Sub != null;
    var pick = _pickSlot is int ps && views.Any(v => v.Slot == ps && v.Status == "empty") ? ps : (int?)null;
}

<div class="sub-panel safehouse-panel drying-panel" role="dialog" aria-label="晾制架">
    <div class="sub-head">
        <div><h2>晾制架</h2><span class="sub" title="被动晾制按世界时间推进：不吃熟练加速、不耗火和燃料、不占行动；离开也继续，暂停不推进。果干原料没有受热保护，到期即腐败、没有成品；肉干@(GameEngine.DryingShelfPauseText)。">@(here ? $"{e.ZoneName(s, s.Ground)} · {e.DryingSummary(s)} · 每位一批" : "当前区没有晾制架") ⓘ</span></div>
        <button class="secondary" @onclick="Close">@G.PanelCloseLabel<EscCap On="@(G.EscOwner == EscOwner.Panel)" /></button>
    </div>
    <div class="sub-body sh-body" data-wheel="y">
        @if (!here)
        {
            <div class="risk none">@e.ZoneName(s, s.Ground)没有晾制架。晾制架在临时营地或已建成的安全屋屋内用“营地建造”建（木材4、绳索2，60分钟），只能在当地操作。</div>
        }
        else
        {
            <div class="dry-grid">
                @foreach (var v in views)
                {
                    var k = v.Slot;
                    var lit = G.Highlights.Contains(GameEngine.DryingSlotHighlight(s.Ground, k));
                    @* B32b（P02c、Q362）：「工位{序号}」+ 状态（空闲／晾制中／可收取／原料已腐败），下列「配方」「原料」「加工进度」；晾制中的位挂加工中，晾好时亮一次（Q368） *@
                    <div class="sh-row dry-slot @v.Status @(pick == k ? "on" : "") @(v.Status == "drying" ? "st-busy" : "") @(lit ? "fresh" : "")" data-dry-slot="@k">
                        <div class="sh-row-head"><b>@v.Title</b><span class="dry-state @(v.Status == "spoiled" ? "warn-text" : "muted")">@CardStates.DryingStatusText(v.Status)</span></div>
                        @if (v.RecipeName != null)
                        {
                            <div class="tiny dry-line"><span class="muted">配方</span> @v.RecipeName</div>
                        }
                        @if (v.Contents.Count > 0)
                        {
                            <div class="tiny dry-line"><span class="muted">原料</span> @string.Join("、", v.Contents)</div>
                        }
                        @if (v.Status == "drying")
                        {
                            <div class="tiny dry-line"><span class="muted">加工进度</span> @(v.DoneMinutes)/@(v.RequiredMinutes)分钟</div>
                            <div class="fuel-track"><i style="width:@(v.DoneMinutes * 100 / Math.Max(1, v.RequiredMinutes))%"></i></div>
                        }
                        <div class="tiny @(v.Status == "spoiled" || v.Line.Contains("会在完成前腐败") ? "warn-text" : "muted")">@v.Line</div>
                        @if (v.XpText != null && v.Status != "empty")
                        {
                            <div class="tiny cg-xp">@v.XpText</div>
                        }
                        <div class="btn-row dry-btns">
                            @switch (v.Status)
                            {
                                case "empty":
                                    @* Q363：只在空闲位显示「查看配方」，替代原「投到这一位」：选中这一位并在下方定位可用食谱（只查看，不投料） *@
                                    <button type="button" class="secondary" disabled="@busy" title="选这一位，在下方看可用食谱与预览" @onclick="() => ViewRecipes(k)">查看配方</button>
                                    break;
                                case "drying":
                                    <button type="button" class="secondary" disabled="@(busy || v.ToCarriedBlocked != null)" title="@(v.ToCarriedBlocked ?? v.CancelHint + "（退回随身）")" @onclick="() => Cancel(k, true)">取消·到随身</button>
                                    <button type="button" class="secondary" disabled="@(busy || v.ToGroundBlocked != null)" title="@(v.ToGroundBlocked ?? v.CancelHint + "（退回当前地面）")" @onclick="() => Cancel(k, false)">取消·到地面</button>
                                    break;
                                case "done":
                                    @* Q346、Q364：「收取」打开居中盘「收取」，盘里「取到随身」「取到地面」各自直接提交 *@
                                    <button type="button" id="@($"dry-take-{k}")" class="primary" disabled="@busy" title="选择去向：取到随身或当前地面（0分钟），这一位空出" @onclick="() => Harvest(k)">收取</button>
                                    break;
                                default:
                                    <button type="button" class="secondary" disabled="@(busy || v.ToCarriedBlocked != null)" title="@(v.ToCarriedBlocked ?? "把原料原样取到随身（腐败的不能吃），这一位空出")" @onclick="() => Take(k, true)">清理·到随身</button>
                                    <button type="button" class="secondary" disabled="@(busy || v.ToGroundBlocked != null)" title="@(v.ToGroundBlocked ?? "把原料原样取到当前地面（腐败的不能吃），这一位空出")" @onclick="() => Take(k, false)">清理·到地面</button>
                                    break;
                            }
                        </div>
                    </div>
                }
            </div>
            <section class="dry-recipes" @ref="recipesBox">
                <h3>@(pick is int p0 ? $"投到{CardStates.DryingSlotName(p0)}：选食谱" : "选食谱（默认投到第一个空位，也可先在上面选一位）")</h3>
                @foreach (var rc in recipes)
                {
                    var o = e.DryingPreview(s, rc.Id, pick);
                    var id = rc.Id;
                    var slotText = o.Slot >= 0 ? CardStates.DryingSlotName(o.Slot) : "没有空位";
                    <div class="sh-row dry-option @(o.Ok ? "" : "missing")" data-dry-recipe="@id">
                        <div class="sh-row-head">
                            <span class="dry-icon">@Icons.Markup(rc.Outputs.Keys.First())</span>
                            <b>@rc.Name</b>
                            <span class="muted">@o.InputText → @o.OutputText · 被动@(Clock.Duration(o.Minutes))</span>
                        </div>
                        @if (o.Ok)
                        {
                            <div class="tiny">投到@(slotText)，预计@(Clock.DayTime(o.FinishMinute))完成；会取：@for (var i = 0; i < o.Sources.Count; i++) {@(i > 0 ? "、" : "")<span class="dry-src">@o.Sources[i]</span>}</div>
                        }
                        else
                        {
                            <div class="tiny warn-text">@o.Reason</div>
                        }
                        @foreach (var w in o.Warnings)
                        {
                            <div class="tiny danger-text">@w</div>
                        }
                        @if (o.PausesShelf)
                        {
                            <div class="tiny dry-pause">@GameEngine.DryingShelfPauseText</div>
                        }
                        <div class="tiny cg-xp">@o.XpText</div>
                        <div class="tiny muted dry-note" title="@o.Note">@o.Note</div>
                        <div class="btn-row dry-btns">
                            @if (_confirm == id && o.Ok && _confirmKey != o.SourceKey)
                            {
                                <div class="tiny warn-text dry-changed">@GameEngine.DryingPreviewChanged</div>
                                <button type="button" class="primary" disabled="@busy" title="已看过上面更新后的预览，按它确认" @onclick="() => _confirmKey = o.SourceKey">看过新预览，重新确认…</button>
                                <button type="button" class="secondary" @onclick="() => _confirm = null">先不投</button>
                            }
                            else if (_confirm == id)
                            {
                                <button type="button" class="primary" disabled="@(!o.Ok || busy)" title="@(o.Reason ?? "确认：0分钟把上面列出的原料放进晾制位，开始被动晾制")" @onclick="() => Load(id, o.Slot)">确认投料（@slotText）</button>
                                <button type="button" class="secondary" @onclick="() => _confirm = null">先不投</button>
                            }
                            else
                            {
                                <button type="button" class="primary" disabled="@(!o.Ok || busy)" title="@(o.Reason ?? "看预览后确认投料")" @onclick="() => { _confirm = id; _confirmKey = o.SourceKey; }">投料…</button>
                            }
                        </div>
                    </div>
                }
            </section>
        }
        @if (G.Notice != null) { <div class="notice">@G.Notice</div> }
    </div>
</div>

@code {
    private int? _pickSlot;
    private string? _confirm;
    /// <summary>点“投料…”时看到的预览来源（Q214：确认按它重验，变了要求再确认）。</summary>
    private string? _confirmKey;

    private void Close() => G.OpenPanel(null);

    private ElementReference recipesBox;
    private bool _scrollRecipes;

    /// <summary>Q363「查看配方」：选中这一位并把下方食谱区滚到可见（只查看，不投料）。</summary>
    private void ViewRecipes(int k)
    {
        _pickSlot = k;
        _confirm = null;
        _scrollRecipes = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollRecipes) return;
        _scrollRecipes = false;
        try { await JS.InvokeVoidAsync("survival.scrollIntoView", recipesBox); } catch (Exception) { /* 只影响定位 */ }
    }

    /// <summary>Q364：成品「收取」打开居中盘（去向二选一，各自直接提交）。</summary>
    private void Harvest(int k) => G.OpenPop("harvest", k.ToString(), $"dry-take-{k}");

    private void Load(string recipeId, int slot)
    {
        var key = _confirmKey;
        var r = G.EngineDo(() => G.E.StartDrying(G.S, recipeId, slot >= 0 ? slot : null, Guid.NewGuid().ToString("N"), key));
        if (r.Ok)
        {
            _confirm = null;
            _pickSlot = null;
        }
        else if (r.Reason != GameEngine.DryingPreviewChanged) _confirm = null;   // 预览变了：留在确认处，显示新预览与“重新确认”
    }

    private void Cancel(int slot, bool toCarried) => G.EngineDo(() => G.E.CancelDrying(G.S, slot, toCarried, Guid.NewGuid().ToString("N")));
    private void Take(int slot, bool toCarried) => G.EngineDo(() => G.E.TakeDrying(G.S, slot, toCarried, Guid.NewGuid().ToString("N")));
}
