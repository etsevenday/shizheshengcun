@inherits GameComponent
@inject IJSRuntime JS

@* B33 整备（P03a，《重墨 V2 开工裁定与界面逐字稿》B33 Q429—Q435、第二轮 Q448—Q453、Q458—Q462；05 P03；INK2-09、UX2-A05—A07）：
   三栏——左队员、中立绘与现有七槽、右「来源」列表（本人随身全部根卡最多5张含非装备，当前地面只列可穿装备）及操作工作区；不设底部托盘。
   点来源卡：可穿的打开同槽比较（P03b），非装备只显示名称与「交给…」；拖候选到槽等同点选并明确选该槽。比较、拖入、切槽都只读预演，
   只有「确认更换」「确认交接」与槽上一键卸下提交。页内点选只临时覆盖右栏只读详情（Q450），不改主界面选中。 *@
@{
    var s = G.S;
    var e = G.E;
    var me = G.GearActorId;
    var members = s.Party.ToList();
    var carriedOwner = ItemInstance.CarriedOwner(me);
    var carried = s.Items.Where(i => i.Owner == carriedOwner).OrderBy(i => i.InstanceId).ToList();
    var ground = s.Items.Where(i => i.Owner == s.Ground && e.IsWearable(i.ItemId)).OrderBy(i => i.InstanceId).ToList();
    var src = G.GearSource;
    var name = e.ActorDisplayName(s, me);
}

<div class="sub-panel gear-panel gear3" role="dialog" aria-label="@GearPanelCopy.Title">
    <div class="sub-head">
        <div><h2>@GearPanelCopy.Title</h2></div>
        <button class="secondary" @onclick="Close">@GearPanelCopy.Close<kbd>Esc</kbd></button>
    </div>
    <div class="sub-body g3-body" data-wheel="y">
        <section class="g3-col g3-members" aria-label="@GearPanelCopy.Members">
            <div class="eyebrow">@GearPanelCopy.Members <span class="g3-cap">@GearPanelCopy.PartyHead(members.Count, e.PartyCapacity(s))</span></div>
            <div role="tablist" aria-label="@GearPanelCopy.Members" class="g3-member-list">
                @foreach (var id in members)
                {
                    var aid = id;
                    <button type="button" role="tab" aria-selected="@(aid == me)" class="g3-member @(aid == me ? "on" : "")" data-actor="@aid" data-gear-member="@aid" @onclick="() => G.GearPickActor(aid)">
                        <img class="g3-face" src="@Face(aid)" alt="" draggable="false" />
                        <span class="g3-mtext"><b>@e.ActorDisplayName(s, aid)</b><small>@GearPanelCopy.MemberLine(e.CarriedGramsOf(s, aid), e.RootCardCountOf(s, aid), e.MaxRootCards)</small></span>
                    </button>
                }
            </div>
        </section>

        <section class="g3-col g3-figure-col" aria-label="@GearPanelCopy.Slots">
            <div class="g3-figure">
                <img src="@Face(me)" alt="" draggable="false" />
                <b>@name</b>
            </div>
            <div class="g3-summary">
                <span>@GearPanelCopy.SummaryCards(e.RootCardCountOf(s, me), e.MaxRootCards)</span>
                <span>@GearPanelCopy.SummaryWeight(e.CarriedGramsOf(s, me))</span>
            </div>
            <div class="eyebrow">@GearPanelCopy.Slots</div>
            <div class="g3-slots">
                @foreach (var slot in EquipSlots.All)
                {
                    var sl = slot;
                    var it = e.WornItem(s, me, sl);
                    var target = src != null && G.GearSlot == sl && G.GivePending == null;
                    <div class="gear-slot @(it == null ? "empty" : "") @(target ? "target" : "") @(it != null && G.GearPeekId == it.InstanceId ? "peek" : "")"
                         data-slot="@sl" data-gear-slot="@sl" data-drop="@($"gearslot:{sl}")" data-drop-level="hot" @onclick="() => G.GearClickSlot(sl)">
                        <span class="gs-name">@EquipSlots.Name(sl)</span>
                        @if (it == null)
                        {
                            <span class="muted">空</span>
                        }
                        else
                        {
                            var why = e.UnequipBlocked(s, me, sl, false);
                            var gwhy = e.UnequipBlocked(s, me, sl, true);
                            <span class="gs-item"><span class="eq-ico" aria-hidden="true">@Icons.Markup(it.ItemId)</span><b class="q-@(it.Quality ?? "white")">@e.ItemName(it.ItemId)</b><small>@Stat(it)</small></span>
                            <span class="gs-btns">
                                <button type="button" class="eq-btn" disabled="@(why != null)" title="@why" @onclick="() => Unequip(sl, false)" @onclick:stopPropagation="true">卸下</button>
                                @if (why != null && gwhy == null)
                                {
                                    <button type="button" class="eq-btn alt" @onclick="() => Unequip(sl, true)" @onclick:stopPropagation="true">放当前地面</button>
                                }
                            </span>
                            @if (why != null && gwhy != null) { <small class="warn-text gs-why">@why</small> }
                        }
                    </div>
                }
            </div>
            @foreach (var line in e.EquipSummaryLines(s, me))
            {
                <div class="tiny muted">@line</div>
            }
        </section>

        <section class="g3-col g3-side" aria-label="@GearPanelCopy.Sources">
            <div class="g3-sources">
                <div class="eyebrow">@GearPanelCopy.Sources</div>
                <div class="g3-group" aria-label="@GearPanelCopy.OwnCarried">
                    <div class="g3-gh">@GearPanelCopy.OwnCarried</div>
                    @if (carried.Count == 0) { <div class="muted tiny">@GearPanelCopy.CarriedEmpty</div> }
                    @foreach (var it in carried)
                    {
                        var inst = it;
                        <div class="gear-card g3-card @(src?.InstanceId == inst.InstanceId ? "on" : "")" role="button" tabindex="0" data-item="@inst.ItemId"
                             id="@($"feed-src-{inst.InstanceId}")" data-gear-src="@inst.InstanceId" data-drag="@($"gear:{inst.InstanceId}")" data-drag-title="@e.InstanceName(inst)"
                             @onclick="() => G.GearPickSource(inst.InstanceId)" @onkeydown="ev => Key(ev, inst.InstanceId)">
                            <span class="gs-item"><span class="eq-ico" aria-hidden="true">@Icons.Markup(inst.ItemId)</span><b class="q-@(inst.Quality ?? "white")">@e.InstanceName(inst)</b><small>×@inst.Count@(inst.MaxDurability.HasValue ? " · 耐久" + GameEngine.DurabilityText(inst) : "")</small></span>
                            @if (e.FeedEntry(s, inst.InstanceId) is { } fe)
                            {
                                @* B29（Q263）：整备的通用物品卡复用食饮入口，不替代队伍面板的展开 *@
                                var feedWhy = G.Running ? "行动进行中" : fe.Blocked;
                                <span class="gs-btns">
                                    <button type="button" class="eq-btn" data-feed-entry disabled="@(feedWhy != null)" title="@(feedWhy ?? fe.Title)" @onclick='() => G.OpenFeed(fe, $"feed-src-{inst.InstanceId}")' @onclick:stopPropagation="true">@fe.Title</button>
                                </span>
                            }
                        </div>
                    }
                </div>
                <div class="g3-group ground" aria-label="@GearPanelCopy.CurrentGround">
                    <div class="g3-gh">@GearPanelCopy.CurrentGround</div>
                    @if (ground.Count == 0) { <div class="muted tiny">@GearPanelCopy.GroundEmpty</div> }
                    @foreach (var it in ground)
                    {
                        var inst = it;
                        <div class="gear-card g3-card @(src?.InstanceId == inst.InstanceId ? "on" : "")" role="button" tabindex="0" data-ground-item="@inst.ItemId"
                             data-gear-src="@inst.InstanceId" data-drag="@($"gear:{inst.InstanceId}")" data-drag-title="@e.InstanceName(inst)"
                             @onclick="() => G.GearPickSource(inst.InstanceId)" @onkeydown="ev => Key(ev, inst.InstanceId)">
                            <span class="gs-item"><span class="eq-ico" aria-hidden="true">@Icons.Markup(inst.ItemId)</span><b class="q-@(inst.Quality ?? "white")">@e.InstanceName(inst)</b><small>@Stat(inst)</small></span>
                        </div>
                    }
                </div>
            </div>
            <div class="g3-work" aria-live="polite">
                @if (src != null && G.GivePending != null)
                {
                    <GearGive />
                }
                else if (src != null && G.GearSlot != null)
                {
                    <GearCompare />
                }
                else if (src != null)
                {
                    @* Q448：非装备来源工作区只显示物品名与「交给…」，不出现装备空态句 *@
                    <div class="g3-src-name"><span class="eq-ico" aria-hidden="true">@Icons.Markup(src.ItemId)</span><b>@e.InstanceName(src)</b></div>
                    <GearGiveEntry />
                }
                else
                {
                    <div class="muted g3-empty">@GearPanelCopy.EmptyWork</div>
                }
            </div>
        </section>
    </div>
</div>

@code {
    private void Close() => G.OpenPanel(null);

    private static string Face(string actorId) => actorId == GameState.PlayerId ? "img/portraits/protagonist.svg" : "img/portraits/unknown.svg";

    private void Key(KeyboardEventArgs ev, int id)
    {
        if (ev.Key is "Enter" or " ") G.GearPickSource(id);
    }

    private void Unequip(string slot, bool toGround)
    {
        Mark($"[data-gear-slot=\"{slot}\"]");
        G.GearUnequip(slot, toGround);
    }

    private void Mark(string selector)
    {
        try { if (JS is IJSInProcessRuntime ip) ip.InvokeVoid("survivalFx.mark", selector); }
        catch (JSException) { /* 旧缓存 app.js：只少了轨迹，结果照常 */ }
    }

    private string Stat(ItemInstance it)
    {
        var e = G.E;
        var parts = new List<string> { e.QualityName(it) + "色" };
        if (it.MaxDurability.HasValue) parts.Add("耐久" + GameEngine.DurabilityText(it));
        parts.Add(Ui.KgText(e.ItemGrams(G.S, it)));
        return string.Join(" · ", parts);
    }
}
