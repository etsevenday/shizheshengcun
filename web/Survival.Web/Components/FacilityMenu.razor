@inherits GameComponent

@* 设施次级菜单（01 案第 4 节）：覆盖地块区，HUD、地面、随身与右栏仍可见。层级 地块卡片区 → 火堆内容物 → 指定锅内容物。
   不用 .overlay 类（drag.js 遇 .overlay 禁拖），菜单里的卡照样可以拖进拖出。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var layer = G.FacilityLayer ?? "fire";
}
<div class="fac-menu" role="dialog" aria-label="火堆内容物">
    <div class="fac-menu-head">
        <div><b>@e.LocName(here)／火堆</b></div>
        <button type="button" class="secondary" @onclick="Back">@(layer.StartsWith("pot:") ? "返回火堆" : "关闭")<kbd>Esc</kbd></button>
    </div>
    <div class="fac-menu-body">
        @foreach (var it in e.FireContents(s, here))
        {
            <ContentThumb @key="it.InstanceId" Item="it" />
        }
    </div>
</div>

@code {
    private void Back() => G.BackFacility();
}
