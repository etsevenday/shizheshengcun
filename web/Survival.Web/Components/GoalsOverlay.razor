@inherits GameComponent

@* 顶栏“生存目标”= 序章任务册（S15 §3/§4、S14「序章引导」、A10-TUTOR §1/§5；开发计划 v0.9 B13 R39/R43）。
   前台七日目标、倒计时与七日成功窗已退役；这里列当前主目标与最多两条建议、完整 PRO01—18（按建议阶段分组，已完成写完成时间，旧档追认另标），
   每项的完成条件与中性系统提示（关闭过的也可回看），求医路线日志与远行准备入口，以及旧档的七日检查历史记录。
   只浏览：打开/关闭/Esc 不推进时间、不领奖、不重播剧情；建议日程不是失败倒计时。任务角与本入口并存（开发假设 B13-H10）。 *@
@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config.Prologue;
    var tasks = e.PrologueTasks(s);
    var done = tasks.Count(t => t.Done);
    var obj = e.CurrentObjective(s);
    var sugg = e.CurrentSuggestions(s);
    var routeKnown = s.Progress.Flags.Contains(GameEngine.FactCampRouteKnown);
}

<div class="sub-panel goals-panel" role="dialog" aria-label="生存目标">
    <div class="sub-head">
        <div><h2>生存目标</h2><span class="sub">存活第@(Clock.Day(s.GameMinute))日 · 序章任务 @(done)/@(tasks.Count) · 建议日程，不是失败倒计时</span></div>
        <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
    </div>
    <div class="sub-body goals-body" data-wheel="y">
        @if (obj != null)
        {
            <section class="goal-now">
                <header><b>主目标</b><span>@obj.Title</span></header>
                <p>@obj.Step</p>
                @if (sugg.Count > 0)
                {
                    <div class="goal-sugg"><b>求生建议</b>@foreach (var x in sugg) {<span title="@x.Step">@x.Title</span>}</div>
                }
                <div class="btn-row">
                    @if (routeKnown)
                    {
                        <button class="secondary" title="重读求医路线（不移动、不揭开未知、不替你探索）" @onclick="RouteLog">查看路线</button>
                        <button class="secondary" title="路线、当前状态与随身预览，确认远行准备（不耗时）" @onclick='() => G.OpenPanel("journey")'>远行准备</button>
                    }
                    @if (GameEngine.VisitorRegistered(s))
                    {
                        <button class="secondary" title="在区域地图上定位临时营地（只看地图，不移动）" @onclick="LocateCamp">定位@(e.LocName(cfg.Visitor.LocationId))</button>
                    }
                    @if (s.Prologue.HintsPaused)
                    {
                        <button class="secondary" title="恢复中性操作提示" @onclick="() => G.SetHintsPaused(false)">恢复操作提示</button>
                    }
                    else
                    {
                        <button class="secondary" title="只关闭中性操作提示；剧情、危险提示与任务不受影响" @onclick="() => G.SetHintsPaused(true)">暂停操作提示</button>
                    }
                </div>
            </section>
        }
        <div class="goal-days">
            @foreach (var st in cfg.Stages)
            {
                var group = tasks.Where(t => t.Config.Stage == st.Id).ToList();
                if (group.Count == 0) continue;
                var now = st.Id == s.Prologue.StageId;
                var allDone = group.All(t => t.Done);
                <section class="goal-day @(now ? "now" : "") @(allDone ? "done" : "")">
                    <header><b>@st.Label</b><span>@st.Headline</span>@if (now) {<em class="oc-badge here">当前</em>}</header>
                    <ul>
                        @foreach (var t in group)
                        {
                            var c = t.Config;
                            var mark = t.Done ? "✓" : t.Relevant ? "○" : "·";
                            <li class="@(t.Done ? "done" : "") @(t.Relevant || t.Done ? "" : "later")" title="@($"{c.Guidance}；{c.ExitGateText}")">
                                <span class="goal-mark" aria-hidden="true">@mark</span>
                                <span class="goal-task">
                                    <b>@c.Id @c.Title</b>@if (c.ExitGate) {<em class="goal-gate">出区条件</em>}
                                    <small>@c.CompletionRule</small>
                                    @if (t.Done)
                                    {
                                        <small class="good-text">@(t.Retro ? "旧档追认" : $"已完成 · {Clock.DayTime(t.CompletedAt ?? 0)}")</small>
                                    }
                                    else if (t.Note != null)
                                    {
                                        <small class="muted">@t.Note</small>
                                    }
                                    else
                                    {
                                        <small class="goal-hint"><span class="tc-sys">系统提示</span>@c.Hint@(t.HintDismissed ? "（已关闭，可在此回看）" : "")</small>
                                    }
                                </span>
                                <span class="sr-only">@(t.Done ? "（已完成）" : "（未完成）")</span>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (s.Progress.SevenDayShown)
            {
                <section class="goal-day done">
                    <header><b>历史</b><span>七日基础生存检查（旧版记录，已退役，不再作为目标）</span></header>
                </section>
            }
        </div>
    </div>
</div>

@code {
    private void Close() => G.OpenPanel(null);

    private void RouteLog() => G.OpenRouteLog();

    /// <summary>“定位营地”：打开区域地图并选中营地（只聚焦已知地图，不移动）。</summary>
    private void LocateCamp()
    {
        G.OpenPanel("map");
        G.MapPicked = G.E.Config.Prologue.Visitor.LocationId;
        G.Notify();
    }
}
