@inherits GameComponent

@* 顶栏“系统说明”（B36a：02 Q812 A、Q889 A、Q890 B、Q899 A、Q955 B、Q821；逐字稿 §2 P08g、2026-11-16／11-17 B36 本批，取代 S14 §13.3 首页图标网格）：
   左栏「主题」列现有9主题，所选主题在左栏展开它的原条目；右栏是条目正文，没选条目时显示该主题摘要，顶栏正常新开（没选主题）时列9个主题的原摘要。
   两个退出控件：正文里的「‹ 返回」只回所属主题摘要（只在显示条目正文时出现）；另一个独立退出按真实来路写「关闭」（回主界面）或「返回」（回原窗口，含食饮盘）。
   Esc／返回语义每次一层：条目正文 → 所属主题摘要 → 真实原入口；直接定位进来的同样先退主题（撤掉原 _helpDirect 一步直关），不额外插9摘要总览。
   左栏目录点击不压窗口返回链。只读浏览：不推进时间、不改选择、不执行玩法。正文与插图由 HelpCatalog 按配置现算。 *@
@{
    var e = G.E;
    var s = G.S;
    var topic = HelpCatalog.Topic(G.HelpTopic);
    var entry = HelpCatalog.Entry(G.HelpTopic, G.HelpEntry);
}

<div class="sub-panel help-panel" role="dialog" aria-label="系统说明">
    <div class="sub-head">
        <div class="help-crumb">
            @if (entry != null)
            {
                <button type="button" class="secondary help-back" data-pt="help-back" @onclick="G.HelpBack">‹ 返回<EscCap On="@G.EscOnHelpBack" /></button>
            }
            <h2>系统说明</h2>
            @if (topic != null) { <span class="sub">@HelpCatalog.Crumb(topic, entry)</span> }
            else { <span class="sub">通用规则 · 只读浏览，不消耗时间</span> }
        </div>
        <button class="secondary" data-pt="help-exit" @onclick="G.CloseHelp">@G.HelpExitLabel<EscCap On="@G.EscOnHelpClose" /></button>
    </div>
    <ReadingSplit Pt="help-split" Class="help-body" NavTitle="@TopicsTitle" NavLabel="@TopicsTitle" BodyLabel="说明内容">
        <Nav>
            @foreach (var t in HelpCatalog.Topics)
            {
                var id = t.Id;
                var tOn = topic?.Id == id;
                <button type="button" class="@ReadingSplit.ItemClass(tOn && entry == null) help-topic-item" aria-expanded="@(tOn ? "true" : "false")" data-pt="help-topic" data-topic="@id" @onclick="() => G.HelpPick(id, null)">
                    <span class="ht-icon small">@Icons.Markup(t.Icon)</span><b>@t.Title</b>
                </button>
                @if (tOn)
                {
                    @foreach (var en in t.Entries)
                    {
                        var eid = en.Id;
                        <button type="button" class="@ReadingSplit.ItemClass(entry?.Id == eid) sub" data-pt="help-entry" data-entry="@eid" @onclick="() => G.HelpPick(id, eid)">@en.Title</button>
                    }
                }
            }
        </Nav>
        <Body>
        @if (topic == null)
        {
            <div class="help-overview" data-pt="help-overview">
                @foreach (var t in HelpCatalog.Topics)
                {
                    <div class="help-summary" data-pt="help-summary" data-topic="@t.Id">
                        <span class="ht-icon">@Icons.Markup(t.Icon)</span>
                        <span class="ht-text"><b>@t.Title</b><small>@t.Summary</small></span>
                    </div>
                }
            </div>
        }
        else if (entry == null)
        {
            @if (topic.Entries.Count == 0)
            {
                <div class="empty-zone help-empty" data-pt="help-topic-summary">
                    <strong>内容整理中</strong>
                    <span>@topic.Summary</span>
                </div>
            }
            else
            {
                <div class="help-summary one" data-pt="help-topic-summary">
                    <span class="ht-icon">@Icons.Markup(topic.Icon)</span>
                    <span class="ht-text"><b>@topic.Title</b><small>@topic.Summary</small></span>
                </div>
            }
        }
        else
        {
            <article class="help-article">
                <h3>@entry.Title</h3>
                @foreach (var para in entry.Paragraphs(e, s))
                {
                    <p>@para</p>
                }
                @if (entry.PersonLine?.Invoke(e, s, G.GearActorId) is string person) { <p class="help-person"><b>@person</b></p> }
                @if (entry.Figures != null)
                {
                    <div class="help-figs" role="list">
                        @foreach (var f in entry.Figures(e, s))
                        {
                            <div class="help-fig" role="listitem">
                                <span class="hf-ico" aria-hidden="true">@FigIcon(f.Icon)</span>
                                <span class="hf-text"><b>@f.Label</b>@if (f.Note != null) {<small>@f.Note</small>}</span>
                            </div>
                        }
                    </div>
                }
                @if (entry.KeyGroups != null)
                {
                    @* BM2（Q495）：「键盘快捷键」四个区——标签与按钮原文、键帽同源（ShellKeys），说明逐字；没有说明的区（顶栏）排成一组按钮原文 *@
                    @foreach (var g in entry.KeyGroups())
                    {
                        var flow = g.Rows.All(r => r.Note == null);
                        <section class="help-keys" aria-label="@g.Title">
                            <h4>@g.Title</h4>
                            <dl class="@(flow ? "hk-flow" : "hk-table")">
                                @foreach (var r in g.Rows)
                                {
                                    <div class="hk-row"><dt>@r.Label</dt>@if (r.Note != null) {<dd>@r.Note</dd>}</div>
                                }
                            </dl>
                        </section>
                    }
                }
                @if (entry.After != null)
                {
                    @foreach (var para in entry.After)
                    {
                        <p>@para</p>
                    }
                }
            </article>
        }
        </Body>
    </ReadingSplit>
</div>

@code {
    /// <summary>左栏标题（逐字稿 §2 P08g「主题」；2026-11-16 B36 逐字表「系统说明左栏：主题及现有9主题／原条目名」）。</summary>
    public const string TopicsTitle = "主题";

    /// <summary>插图：Icons 键，或 "dir:N" 方位箭头（与地块卡方位徽标同一画法）。</summary>
    private static MarkupString FigIcon(string key)
    {
        if (key.StartsWith("dir:") && int.TryParse(key[4..], out var d))
            return new MarkupString($"<span class=\"dir-badge static\"><svg viewBox=\"0 0 24 24\" style=\"transform:rotate({(d - 1) * 45}deg)\"><path d=\"M12 2.5 19.5 11h-4.6v10.5H9.1V11H4.5Z\" /></svg></span>");
        return Icons.Markup(key);
    }
}
