@inherits GameComponent

@* B10 成长页（A10 §8、A06「Q26 成长页与当前指令页分界」、验收 A06-U26/UI-E08/UI-E28）：先选角色再选门类，
   每门十级轨道，1/3/5/7/10 五个技能节点；未解锁的也显示（只写已公开的解锁条件“达到N级”）；战斗操作台是当前门类五张，未解锁置灰（Q227）。
   只浏览：不推进时间、不改经验；技能长说明点节点固定阅读。 *@
@{
    var s = G.S;
    var e = G.E;
    var me = G.GearActorId;
    var actor = s.Actors.TryGetValue(me, out var a) ? a : s.Player;
    var views = e.SkillViews(actor);
    var cur = views.FirstOrDefault(v => v.Id == G.GrowthSkill) ?? views.First();
    // B41e2（逐字稿「Q427 卡名、角标与 Q428 成长页」、Q446 ⑧⑨）：「求生」组改「求生与行动」，副标「{角色名} · 共16项熟练度」，潜行条目与练习入口
}

@if (Part == "detail")
{
    @* B42：右栏悬停查看熟练度门类，与成长页详情同一片段（只读，不换所选门类） *@
    if (views.FirstOrDefault(v => v.Id == PeekSkill) is { } pk)
    {
        <div class="detail-scroll growth-peek">@DetailOf(actor, pk)</div>
    }
    return;
}

<div class="sub-panel growth-panel" role="dialog" aria-label="成长">
    <div class="sub-head">
        <div>
            <h2>成长</h2>
            <span class="sub">@e.ActorDisplayName(s, me) · 共@(views.Count)项熟练度</span>
        </div>
        <button class="secondary" @onclick="Close">@G.PanelCloseLabel<EscCap On="@(G.EscOwner == EscOwner.Panel)" /></button>
    </div>
    @if (s.Party.Count > 1)
    {
        <div class="gear-members" role="tablist" aria-label="选角色">
            @foreach (var id in s.Party)
            {
                var aid = id;
                <button type="button" role="tab" aria-selected="@(aid == me)" class="gear-member @(aid == me ? "on" : "")" data-actor="@aid" @onclick="() => PickActor(aid)"><b>@e.ActorDisplayName(s, aid)</b></button>
            }
        </div>
    }
    <div class="sub-body growth-body">
        <div class="growth-list" data-wheel="y">
            @foreach (var grp in new[] { ("combat", "战斗"), ("both", "医疗（战内外）"), ("survival", "求生与行动") })
            {
                <div class="skill-group muted">@grp.Item2</div>
                @foreach (var sk in views.Where(x => x.Category == grp.Item1))
                {
                    var sid = sk.Id;
                    var unlocked = sk.Nodes.Count(n => sk.Level >= n.Level);
                    <button type="button" class="growth-skill @(sid == cur.Id ? "on" : "")" data-skill="@sid" data-peek="@Peek.Skill(sid)" @onclick="() => PickSkill(sid)">
                        <b>@sk.Name</b><span>@(sk.Level)/@(sk.Cap)级@(sk.Nodes.Count > 0 ? $" · 技能{unlocked}/{sk.Nodes.Count}" : "")</span>
                    </button>
                }
            }
        </div>
        @DetailOf(actor, cur)
    </div>
</div>

@code {
    [Parameter] public string Part { get; set; } = "center";
    /// <summary>B42：右栏悬停查看的熟练度门类（Part="detail"）。</summary>
    [Parameter] public string? PeekSkill { get; set; }

    private RenderFragment DetailOf(ActorState actor, SkillView sk) => __builder =>
    {
        var s = G.S;
        var e = G.E;
        var me = G.GearActorId;
        var stealth = sk.Id == GameEngine.StealthSkill;
        <div class="growth-detail" data-wheel="y">
            <div class="eyebrow">@e.ActorDisplayName(s, me) · @sk.Name</div>
            <div class="growth-head">
                <b>@(sk.Level)/@(sk.Cap)级</b>
                <span class="muted">@(sk.Maxed ? (stealth ? "潜行已满级" : "满级，不再获得经验") : $"经验{sk.Xp}/{sk.NextXp}，升到{sk.Level + 1}级")</span>
                @if (NextNode(sk) is { } nx) { <span>下一节点：@(nx.Level)级 @nx.Name</span> }
            </div>
            @* 十级轨道：1—10 格，五个节点格有技能名；已达到的点亮 *@
            <div class="growth-track" aria-label="十级轨道">
                @for (var lv = 1; lv <= Math.Min(10, sk.Cap); lv++)
                {
                    var l = lv;
                    var node = sk.Nodes.FirstOrDefault(n => n.Level == l);
                    <div class="gt-cell @(sk.Level >= l ? "reached" : "") @(node != null ? "node" : "")" title="@(node == null ? $"{l}级" : $"{l}级 {node.Name}")">
                        <span>@l</span>@if (node != null) { <small>@node.Name</small> }
                    </div>
                }
            </div>
            @if (stealth)
            {
                @* B41e2（Q428）：潜行说明与「练习潜行」入口；点入口在本页打开练习盘（逐字稿「队长与练习潜行」），盘的「返回」只放弃草稿 *@
                <p class="growth-stealth-note">潜行提高接近和躲避的成功率，判定使用小队队长的等级与身体状态。</p>
                @if (Part != "detail")
                {
                    @if (G.PracticeOpen) { @PracticeDisk() }
                    else { <button type="button" class="secondary growth-practice" id="@GameSession.PracticeEntryId" data-practice @onclick="G.OpenPractice">@GameEngine.PracticeTitle</button> }
                }
            }
            <div class="growth-nodes">
                @foreach (var n in sk.Nodes)
                {
                    var on = sk.Level >= n.Level;
                    <div class="growth-node @(on ? "unlocked" : "locked")" data-node="@n.Id">
                        <header><b>@(n.Level)级 · @n.Name</b><em class="@(on ? "ok" : "muted")">@(on ? "已解锁" : "未解锁")</em></header>
                        <p>@n.Text</p>
                        <small class="muted">@NodeMeta(n)</small>
                        <small class="@(on ? "muted" : "warn-text")">@(on ? Status(actor, sk, n) : $"解锁条件：{sk.Name}达到{n.Level}级（当前{sk.Level}级）")</small>
                    </div>
                }
            </div>
            <div class="tiny muted">经验只给实际出手/工作的本人；两件同门类武器不叠经验、不多解锁技能。命中、伤害等公式见系统说明。</div>
        </div>
    };

    /// <summary>
    /// B41e2 练习潜行盘（逐字稿 B41「队长与练习潜行」；R05 Q424、Q540）：标题「练习潜行」；「练习者」从主角与同地同区存活同行者里明确选；
    /// 「耗时30分钟」；经验或满级预览；「真实身体预估」下一行「等待期间每小时 …」（所选练习者本人）；练习说明；「开始练习」「返回」。
    /// 「开始练习」禁用时原因来自内核 CanPracticeStealth（按逐字稿禁用表取第一条），写在盘内并作按钮悬停。
    /// </summary>
    private RenderFragment PracticeDisk() => __builder =>
    {
        var s = G.S;
        var e = G.E;
        var who = G.PracticeActor;
        var why = G.PracticeBlocked;
        // 无选人／已失效的练习者不给预估（Q540：不用主角数据顶替）
        var valid = who != null && e.PracticeCandidates(s).Contains(who);
        var busy = G.Running || s.Sub != null;
        <section class="practice-disk" role="group" aria-label="@GameEngine.PracticeTitle">
            <header><b>@GameEngine.PracticeTitle</b></header>
            <div class="lines practice-lines">
                <div>
                    <span>@GameEngine.PracticeActorLabel</span>
                    <b class="practice-actors">
                        @foreach (var id in e.PracticeCandidates(s))
                        {
                            var aid = id;
                            <button type="button" class="choice @(aid == who ? "on" : "")" aria-pressed="@(aid == who)" data-practice-actor="@aid" @onclick="() => G.PickPracticeActor(aid)">@e.ActorDisplayName(s, aid)</button>
                        }
                    </b>
                </div>
                <div><span></span><b>@e.PracticeMinutesText</b></div>
                @if (valid && e.PracticeXpPreview(s, who!) is string xp) { <div><span></span><b>@xp</b></div> }
                @if (valid && e.PracticeBodyRateText(s, who!) is string body)
                {
                    <div><span>@GameEngine.PracticeBodyLabel</span><b>@body</b></div>
                }
            </div>
            <div class="tiny muted">@GameEngine.PracticeNote</div>
            @if (why != null) { <div class="risk practice-why">@why</div> }
            <div class="practice-actions">
                <button type="button" class="primary practice-start" disabled="@(why != null || busy)" title="@why" @onclick="StartPractice">@GameEngine.PracticeStart</button>
                <button type="button" class="secondary practice-back" @onclick="G.ClosePractice">@GameEngine.EnemyDiskBack<EscCap On="@(G.EscOwner == EscOwner.PracticeBack)" /></button>
            </div>
        </section>
    };

    private async Task StartPractice() => await G.StartPractice();

    private void Close() => G.OpenPanel(null);

    private void PickActor(string id)
    {
        G.GearActor = id;
        G.Notify();
    }

    private void PickSkill(string id)
    {
        G.PeekClear();   // B42：明确点选结束悬停查看
        G.GrowthSkill = id;
        G.Notify();
    }

    private static SkillNodeConfig? NextNode(SkillView sk) => sk.Nodes.FirstOrDefault(n => n.Level > sk.Level);

    private static string NodeMeta(SkillNodeConfig n)
    {
        if (n.IsSurvival) return "求生被动";
        var parts = new List<string>();
        if (n.Ap > 0) parts.Add($"{n.Ap}AP");
        if (n.Positions != "") parts.Add(n.Positions);
        if (n.CooldownRounds > 0) parts.Add($"冷却{n.CooldownRounds}轮");
        return parts.Count == 0 ? "战斗技能" : string.Join(" · ", parts);
    }

    private string Status(ActorState actor, SkillView sk, SkillNodeConfig n)
    {
        var e = G.E;
        if (n.IsSurvival) return e.PassiveStatus(actor, n);
        if (e.SkillExecOf(n.Id) is { NeedsAllies: true } && G.S.Party.Count < 2) return "已解锁，需要同行队友";
        return "已解锁，装上这一类武器后在该武器页使用";
    }
}
