@inject IJSRuntime JS

<label class="ink-reading-mode">
    <span>阅读字体</span>
    <select aria-label="阅读字体" value="@_mode" @onchange="SetMode">
        <option value="pixel">细像素</option>
        <option value="clear">清晰阅读 · 系统黑体</option>
    </select>
</label>

@code {
    private string _mode = "pixel";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _mode = await JS.InvokeAsync<string>("survival.readingMode");
        StateHasChanged();
    }

    private async Task SetMode(ChangeEventArgs e)
    {
        _mode = e.Value?.ToString() == "clear" ? "clear" : "pixel";
        await JS.InvokeVoidAsync("survival.setReadingMode", _mode);
    }
}
