@inherits GameComponent

@* 顶栏“编队”（策划答复 Q86，S14/R08 本轮章「顶栏编队与真实开战预设」；开发计划 v0.9 B8a）：
   四格（前排1→后排4）草稿：点角色再点号位——空位移入、有人交换；也可直接点有人的号位选中他。只改草稿，底部“保存编队/取消”，
   Esc 等于取消，关闭不自动保存。保存 0 时间、0AP、0 体力，下一场战斗按此开局（不按武器自动改位），战斗中的站位变化不反写。
   每人显示开战武器页的合法使用位作参考，站在用不了的号位也可以保存。禁用原因都来自内核 SaveFormationBlocked。
   C 只限制同行人数，不限制号位；单人也可选 1—4。队友暂不入战（多人战斗未做，开发计划 B8.4），下一战只有你按预设号位入场。 *@
@{
    var s = G.S;
    var e = G.E;
    var draft = G.FormationDraft ?? e.RepairedFormation(s, s.FormationPreset);
    var pick = G.FormationPick;
    var saveWhy = G.FormationSaveBlocked;
    var cap = e.PartyCapacity(s);
    var members = draft.Where(x => x != "").ToList();
}

<div class="sub-panel formation-panel" role="dialog" aria-label="编队">
    <div class="sub-head">
        <div><h2>编队</h2><span class="sub">开战号位 · 前排1号位→后排4号位 · 同行@(members.Count)/C@(cap)（C只限人数，不限号位）· 保存不花时间、AP和体力</span></div>
        <button class="secondary" @onclick="G.CancelFormation">取消<kbd>Esc</kbd></button>
    </div>
    <div class="sub-body formation-body" data-wheel="y">
        <div class="fm-slots" role="group" aria-label="四个号位">
            @for (var k = 0; k < draft.Count; k++)
            {
                var slot = k + 1;
                var who = draft[k];
                var on = who != "" && who == pick;
                var ok = who == "" || e.StartWeaponOf(s, who).own.Contains(slot);
                var target = pick != null && who != pick;
                <button type="button" class="fm-slot @(who == "" ? "empty" : "") @(on ? "on" : "") @(target ? "target" : "") @(ok ? "" : "warn")" data-slot="@slot"
                        aria-pressed="@on"
                        title="@SlotTitle(slot, who, pick)"
                        @onclick="() => G.PlaceFormationSlot(slot)">
                    @* 号位与名字同一行（1280×720 下压缩行高，底部说明不被挤出；试玩修复 B8a 第 1 轮 B5） *@
                    <span class="fm-top">
                        <span class="fm-num">@(slot)号位<small>@(slot == 1 ? "（前排）" : slot == 4 ? "（后排）" : "")</small></span>
                        <b class="fm-name">@(who == "" ? "空位" : e.ActorDisplayName(s, who))</b>
                    </span>
                    @if (who != "")
                    {
                        var (w, own) = e.StartWeaponOf(s, who);
                        @* 允许换行，“此位用不了”单独一行（1280/1600 下不再被省略号截断；试玩修复 B8a 第 1 轮 B3） *@
                        <span class="fm-weapon tiny @(ok ? "muted" : "warn-text")">@w.Name：可用@(PosText(own))</span>
                        @if (!ok) { <span class="fm-weapon-bad tiny warn-text">（此位用不了）</span> }
                    }
                </button>
            }
        </div>
        <div class="fm-members" role="group" aria-label="同行角色">
            @foreach (var id in members)
            {
                var aid = id;
                var (w, own) = e.StartWeaponOf(s, id);
                var at = draft.IndexOf(id) + 1;
                <button type="button" class="fm-member @(aid == pick ? "on" : "")" aria-pressed="@(aid == pick)" data-actor="@aid"
                        title="@($"在{at}号位 · 开战武器{w.Name}可用{PosText(own)}；" + (aid == pick ? "再点一次取消选择；点一个号位把他移过去（有人则交换）" : "选中后点一个号位"))"
                        @onclick="() => G.PickFormationActor(aid)">
                    @* 武器与可用号位已写在号位格里，这里只留名字与号位，四人一行放得下（B8a 第 1 轮 B5；完整信息在悬停） *@
                    <b>@e.ActorDisplayName(s, aid)</b> <span class="tiny muted">在@(at)号位</span>
                </button>
            }
        </div>
        <div class="ca-note tiny">
            站位不会按武器自动更正：站在用不了的号位也能保存，进战后那页技能按真实号位禁用，可以在战斗里花1AP“调整站位”。
            战斗中的拉扯、击退、调整站位不会改这里的编队。@(s.Roster.Any(r => !r.Dead) ? $"编入同行/留作候补只在{e.LocName(e.HubLocation(s))}办理；队友暂时还不会跟你进战斗，下一场只有你按这里的号位入场。" : "")
        </div>
    </div>
    <div class="fm-foot">
        <span class="tiny muted fm-draft">草稿：@e.FormationText(s, draft)</span>
        <button type="button" class="primary" disabled="@(saveWhy != null)" title="@(saveWhy ?? "保存这份编队，下一场战斗按此开局")" @onclick="() => G.SaveFormation()">保存编队</button>
        <button type="button" class="secondary" @onclick="G.CancelFormation">取消</button>
    </div>
    @if (saveWhy != null && G.FormationDirty)
    {
        <div class="fm-why tiny warn-text" role="status">不能保存：@saveWhy</div>
    }
</div>

@code {
    private static string PosText(HashSet<int> own) => string.Join("、", own.OrderBy(x => x)) + "号位";

    private string SlotTitle(int slot, string who, string? pick)
    {
        var s = G.S;
        if (pick == null) return who == "" ? $"{slot}号位空着：先点一名角色，再点这里" : $"点选{G.E.ActorDisplayName(s, who)}";
        if (who == pick) return "取消选择";
        var name = G.E.ActorDisplayName(s, pick);
        return who == "" ? $"把{name}移到{slot}号位" : $"{name}与{G.E.ActorDisplayName(s, who)}交换号位";
    }
}
