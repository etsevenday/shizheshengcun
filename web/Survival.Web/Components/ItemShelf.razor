@inherits GameComponent

@* 随身 / 当前地面的卡片区。卡片顺序来自内核 OrderedCards（存档里的手工顺序，新卡追加尾部）。
   拖拽：卡片 data-drag 为来源；区域 data-drop="zone:…" 是插入线落点，卡面 data-drop="card:…" 是组合落点，
   锅卡的水量条 data-drop="potfill:…" 是装水热区（交互与地图扩展 v0.3 · 01 案）。 *@
@{
    var s = G.S;
    var e = G.E;
    var carried = Owner == ItemInstance.Carried;
    var items = s.Items.Where(i => i.Owner == Owner).ToList();
    var order = e.OrderedCards(s, Owner);
    var kinds = items.Select(i => i.ItemId).Distinct().Count();
    var sel = G.Selected;
    var grams = items.Sum(i => e.ItemGrams(s, i));
    var busy = e.IsBusy(s) || G.Running;
    var from = carried ? "随身" : $"{e.LocName(Owner)}地面";
    // 随身五张根物品卡（S06 §8）：固定五个可见位置，已用卡数与内核同一计数；同物品多批或超堆叠的卡标“占N格”并占相应宽度
    var used = carried ? e.RootCardCount(s) : 0;
    var slots = carried ? Math.Max(e.MaxRootCards, used) : 0;
}

@{
    // Q34 答复（选 B）：③④区标题改为与①②一致的竖排行首标签，不再占一整条横向标题/元信息带；
    // 随身的携重/轻装/N/5张卡只在左栏携重摘要常驻（唯一常驻来源），这里只放进标签的悬停/聚焦说明。
    // B3：穿戴物不在随身行（不占卡），但重量计本人——本人总重含穿戴
    var personGrams = carried ? e.CarriedGrams(s) : grams;
    var wornGrams = carried ? e.WornGrams(s) : 0;
    var full = carried
        ? $"{Title}：{Ui.Kg(personGrams)}公斤{(wornGrams > 0 ? $"（含穿戴{Ui.Kg(wornGrams)}公斤）" : "")} · {(personGrams > e.Config.Carry.SoftGrams ? "超重" : "轻装")} · {used}/{e.MaxRootCards}张卡（穿戴不占卡；左栏携重摘要常驻）"
        : $"{Title}：{(string.IsNullOrEmpty(Sub) ? "" : Sub + " · ")}{kinds}种物品";
    const string help = "选中卡片在卡下使用或转移 · 卡角箭头转移1件 · 拖动整理或投放 · 不耗时";
}
<div class="panel section @(carried ? "carried" : "ground")" inert="@G.DialogueLocked" aria-label="@full">
    @* 行首竖排区标题常驻可见（S14 §1.3 四区同屏）；完整区域语义与操作教学在悬停/键盘聚焦说明里（S14 §13.1） *@
    <div class="row-tag" tabindex="0" title="@($"{full}\n{help}")" data-tip="@($"{full} · {help}")" aria-label="@full">@Title</div>
    <div class="row-scroll @(carried ? "slots5" : "")" data-wheel="@(carried ? null : "x")" data-drop="@($"zone:{Owner}")" data-drop-level="zone"
         style="@(carried ? $"--slots:{slots}" : null)">
        @foreach (var key in order)
        {
            var parts = key.Split('|');
            var id = parts[1];
            if (parts.Length == 2)
            {
                var list = items.Where(i => i.ItemId == id).OrderBy(i => i.ExpiresAt ?? int.MaxValue).ThenBy(i => i.InstanceId).ToList();
                if (list.Count == 0) continue;
                var total = list.Sum(i => i.Count);
                var head = list.FirstOrDefault(i => i.ReservedBy == null && !e.IsSpoiled(s, i)) ?? list[0];
                var allSpoiled = list.All(i => e.IsSpoiled(s, i));
                var anyReserved = list.Any(i => i.ReservedBy != null);
                // Q24：随身同物品按真实批次（到期 + 来源 + 预留状态）叠卡；最早到期在最前，无保质在后；占格仍按内核合堆计数
                var kb = carried ? e.BatchesOf(s, Owner, id) : null;
                var batches = kb?.Count ?? list.Select(i => i.ExpiresAt).Distinct().Count();
                var movable = list.Any(i => i.ReservedBy == null);
                var gSel = sel.Kind == SelectionKind.ItemGroup && sel.Id == id && sel.Owner == Owner;
                var span = carried ? Math.Max(1, e.RootCardsOf(s, list.Select(i => i.InstanceId))) : 1;
                // 只有真实批次确实占了多个卡位时才铺成叠卡；同批仅因制作预留临时拆堆（仍占1格）不叠
                var stacked = kb != null && kb.Count > 1 && span > 1;
                var pickedKey = stacked && gSel ? G.CurrentBatch(Owner, id, kb)?.Key : null;
                if (stacked) head = kb![0].Stacks.FirstOrDefault(i => i.ReservedBy == null) ?? kb[0].Stacks[0];
                var colStyle = (span > 1 ? $"grid-column:span {span};--span:{span};" : "") + (stacked ? $"--layers:{kb!.Count - 1};" : "");
                <div @key="@("g:" + id)" class="card-col @(gSel ? "open" : "") @(stacked ? "stacked" : "")"
                     style="@(colStyle.Length > 0 ? colStyle : null)">
                @if (stacked)
                {
                    @* 后层：从最晚到期到第二早，依次压在前一张下面；点后层 = 选中这一批（展开选批次），卡下操作窗随即作用于它 *@
                    for (var k = kb!.Count - 1; k >= 1; k--)
                    {
                        var b = kb[k];
                        var bk = b.Key;
                        var fresh = b.Spoiled ? "已腐败" : !b.ExpiresAt.HasValue ? "不会腐败" : Ui.Fresh(b.ExpiresAt.Value - s.GameMinute);
                        <button type="button" class="stack-layer @(pickedKey == bk ? "on" : "") @(b.Spoiled ? "spoiled" : "") @(b.Reserved ? "reserved" : "")" style="--i:@k"
                                title="@($"第{k + 1}批×{b.Count}：{fresh}{(b.Reserved ? " · 预留" : "")}（点选这一批）")" aria-label="@($"选择第{k + 1}批，{b.Count}份，{fresh}")"
                                @onclick="() => G.PickBatch(Owner, id, bk)">
                            <span class="sl-art">@Icons.Markup(id)</span>
                            <span class="sl-tag"><b>×@b.Count</b> @fresh</span>
                        </button>
                    }
                }
                @{ var infoLine = (stacked ? (kb![0].Spoiled ? "已腐败" : Ui.ItemLine(e, s, head)) : allSpoiled ? "已腐败" : Ui.ItemLine(e, s, head)) + (!stacked && batches > 1 ? $" · {batches}批" : ""); }
                @* Q35：长名一行省略时，键盘聚焦提示（data-tip）与名称悬停提示写全名、数量与效果行 *@
                <div id="@(gSel ? "card-sel" : null)" data-tip="@($"{e.ItemName(id)} ×{total} · {infoLine}{(span > 1 ? $" · 占{span}格" : "")}")" data-card="@key" data-drag="@($"card:{key}")" data-drag-from="@($"{from} ×{total}")" data-drop="@($"card:{key}")" data-drop-level="card"
                     class="card item @(allSpoiled ? "spoiled" : "") @(anyReserved ? "reserved" : "") @(gSel && (!stacked || pickedKey == kb![0].Key) ? "selected" : "") @(stacked ? "stack-front" : "") @(G.Highlights.Contains(id) && !carried ? "fresh" : "")"
                     role="button" tabindex="0" @onclick="() => SelectFront(id, kb)" @onkeydown="ev => OnCardKey(ev, () => SelectFront(id, kb))" title="@e.Item(id).Desc">
                    <div class="ctitle"><span title="@e.ItemName(id)">@e.ItemName(id)</span><span class="qty" title="@(stacked ? $"共{total}份，最前这一批×{kb![0].Count}" : null)">×@total</span></div>
                    <div class="art">@Icons.Markup(id)</div>
                    <div class="cinfo" title="@infoLine">@infoLine</div>
                    @if (span > 1) { <span class="slot-span" title="@($"同物品{batches}批/超过堆叠上限，占{span}张随身卡{(stacked ? $"；最前这一批×{kb![0].Count}" : "")}")">占@(span)格@(batches > 1 ? $"·{batches}批" : "")</span> }
                    <TransferArrow Owner="@Owner" ItemId="@id" Enabled="@(movable && !busy)" />
                </div>
                </div>
            }
            else
            {
                var t = items.FirstOrDefault(i => i.InstanceId.ToString() == parts[2]);
                if (t == null) continue;
                var broken = t.Durability.HasValue && t.Durability <= 0;
                var inst = t.InstanceId;
                var toolId = t.ItemId;
                var isPot = e.IsPot(t);
                var locked = e.IsLocked(s, t);
                if (isPot)
                {
                    @* 锅卡与火堆加工位同一个 PotCard（v0.7 第 3.1 节）：水量条、液体行、食材行直接可见 *@
                    <PotCard @key="@("t:" + inst)" Pot="t" />
                    continue;
                }
                var tSel = sel.Kind == SelectionKind.Tool && sel.InstanceId == inst;
                <div @key="@("t:" + inst)" class="card-col @(tSel ? "open" : "")">
                <div id="@(tSel ? "card-sel" : null)" data-tip="@($"{e.ItemName(t.ItemId)}#{t.InstanceId} · {Ui.ItemLine(e, s, t)}")" data-card="@key" data-drag="@($"card:{key}")" data-drag-from="@from" data-drop="@($"card:{key}")" data-drop-level="card"
                     class="card item @(broken ? "broken" : "") @(t.ReservedBy != null || locked ? "reserved" : "") @(tSel ? "selected" : "") @(G.Highlights.Contains(t.ItemId) && !carried ? "fresh" : "")"
                     role="button" tabindex="0" @onclick="() => SelectTool(inst, toolId)" @onkeydown="ev => OnCardKey(ev, () => SelectTool(inst, toolId))" title="@e.Item(t.ItemId).Desc">
                    <div class="ctitle"><span title="@($"{e.ItemName(t.ItemId)}#{t.InstanceId}")">@e.ItemName(t.ItemId)#@t.InstanceId</span></div>
                    <div class="art">@Icons.Markup(t.ItemId)</div>
                    <div class="cinfo" title="@Ui.ItemLine(e, s, t)">@Ui.ItemLine(e, s, t)</div>
                    <TransferArrow Owner="@Owner" ItemId="@toolId" InstanceId="@inst" Enabled="@(t.ReservedBy == null && !locked && !busy)" />
                </div>
                </div>
            }
        }
        @if (carried)
        {
            @* 空位轻量表示（S06 §8：固定五个可见位置，无滚动、无分页） *@
            for (var k = used; k < e.MaxRootCards; k++)
            {
                <div @key="@("empty" + k)" class="slot-free" aria-label="空随身卡位" title="空随身卡位：把地面物品卡拖到这里，或选中地面卡片后拾取">空位</div>
            }
        }
        @if (items.Count == 0 && !carried)
        {
            <div class="empty-zone">
                <strong>这里暂时没有散落物品</strong>
                <span>搜集、清理与探索的产物会留在这里</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Owner { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    /// <summary>标题后的补充（当前地面所在地点名）。</summary>
    [Parameter] public string Sub { get; set; } = "";

    private void SelectGroup(string itemId) =>
        G.Select(new Selection { Kind = SelectionKind.ItemGroup, Id = itemId, Owner = Owner });

    /// <summary>点叠卡最前一张：选中这一物品卡，批次回到默认（最前合法可用批次，Q24）。不叠卡时同 SelectGroup。</summary>
    private void SelectFront(string itemId, List<ItemBatch>? batches)
    {
        if (batches == null || batches.Count < 2) { SelectGroup(itemId); return; }
        G.PickBatch(Owner, itemId, null);
    }

    private static void OnCardKey(KeyboardEventArgs ev, Action select)
    {
        if (ev.Key == "Enter" || ev.Key == " ") select();
    }

    private void SelectTool(int instanceId, string itemId) =>
        G.Select(new Selection { Kind = SelectionKind.Tool, Id = itemId, Owner = Owner, InstanceId = instanceId });
}
