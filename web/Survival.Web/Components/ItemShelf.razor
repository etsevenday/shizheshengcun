@inherits GameComponent

@* 随身 / 当前地面的卡片区。卡片顺序来自内核 OrderedCards（存档里的手工顺序，新卡追加尾部）。
   拖拽：卡片 data-drag 为来源；区域 data-drop="zone:…" 是插入线落点，卡面 data-drop="card:…" 是组合落点，
   锅卡的水量条 data-drop="potfill:…" 是装水热区（交互与地图扩展 v0.3 · 01 案）。 *@
@{
    var s = G.S;
    var e = G.E;
    var carried = Owner == ItemInstance.Carried;
    var items = s.Items.Where(i => i.Owner == Owner).ToList();
    var order = e.OrderedCards(s, Owner);
    var kinds = items.Select(i => i.ItemId).Distinct().Count();
    var sel = G.Selected;
    var grams = items.Sum(i => e.ItemGrams(s, i));
    var busy = ((e.IsBusy(s) || G.Running) && !e.ExtractTidyAllowed(s)) || G.CityBrowsing;   // B24：鸟瞰浏览中转移箭头灰掉   // B22f Q199：撤出途中可拾放（只放开转移箭头）
    var from = carried ? "随身" : $"{e.LocName(Owner)}地面";
    // 随身五张根物品卡（S06 §8）：固定五个可见位置，已用卡数与内核同一计数；同物品多批或超堆叠的卡标“占N格”并占相应宽度
    var used = carried ? e.RootCardCount(s) : 0;
    var slots = carried ? Math.Max(e.MaxRootCards, used) : 0;
}

@{
    // Q34 答复（选 B）：③④区标题改为与①②一致的竖排行首标签，不再占一整条横向标题/元信息带；
    // 随身的携重/轻装/N/5张卡只在左栏携重摘要常驻（唯一常驻来源），这里只放进标签的悬停/聚焦说明。
    // B3：穿戴物不在随身行（不占卡），但重量计本人——本人总重含穿戴
    var personGrams = carried ? e.CarriedGrams(s) : grams;
    var wornGrams = carried ? e.WornGrams(s) : 0;
    var full = carried
        ? $"{Title}：{Ui.Kg(personGrams)}公斤{(wornGrams > 0 ? $"（含穿戴{Ui.Kg(wornGrams)}公斤）" : "")} · {(personGrams > e.Config.Carry.SoftGrams ? "超重" : "轻装")} · {used}/{e.MaxRootCards}张卡（穿戴不占卡；左栏携重摘要常驻）"
        : $"{Title}：{(string.IsNullOrEmpty(Sub) ? "" : Sub + " · ")}{kinds}种物品";
    const string help = "选中卡片在卡下使用或转移 · 卡角箭头转移1件 · 拖动整理或投放 · 不耗时";
}
@* B24（A10-CITY §3）：主城鸟瞰盖住第三行时地面不响应（不隔图拖放、不点穿）；第四行原位只读 *@
<div class="panel section @(carried ? "carried" : "ground") @(carried && G.CityBrowsing ? "city-readonly-row" : "")" inert="@(G.DialogueLocked || (!carried && G.CityBrowsing))" aria-label="@full">
    @* 行首竖排区标题常驻可见（S14 §1.3 四区同屏）；完整区域语义与操作教学在悬停/键盘聚焦说明里（S14 §13.1） *@
    <div class="row-tag" tabindex="0" title="@($"{full}\n{help}")" data-tip="@($"{full} · {help}")" aria-label="@full">@Title</div>
    <div class="row-scroll @(carried ? "slots5" : "")" data-wheel="@(carried ? null : "x")" data-drop="@($"zone:{Owner}")" data-drop-level="zone"
         style="@(carried ? $"--slots:{slots}" : null)">
        @foreach (var key in order)
        {
            var parts = key.Split('|');
            var id = parts[1];
            // B22 试玩修复 M408：本实例地牢战利品（可封存）单独成卡（键 owner|itemId|dr），不和同名外带物叠在一起
            // B22d Q178：已鉴定普通白色活性物质也单独成卡（键 owner|itemId|apr），标题“活性物质（白色·已鉴定）”，不和未鉴定的混在一个标题下
            var side = GameEngine.CardSideOfKey(parts);
            var dr = side == GameEngine.RewardCardSuffix;
            var title = e.CardTitle(id, side);
            if (parts.Length == 2 || side != null)
            {
                var list = items.Where(i => i.ItemId == id && e.CardSideOf(i) == side).OrderBy(i => i.ExpiresAt ?? int.MaxValue).ThenBy(i => i.InstanceId).ToList();
                if (list.Count == 0) continue;
                var allKb = e.BatchesOf(s, Owner, id);
                var sideKb = allKb.Where(b => e.CardSideOf(b.Stacks[0]) == side).ToList();
                var split = sideKb.Count < allKb.Count;   // 同物品另有一张普通卡/战利品卡
                var total = list.Sum(i => i.Count);
                var head = list.FirstOrDefault(i => i.ReservedBy == null && !e.IsSpoiled(s, i)) ?? list[0];
                var allSpoiled = list.All(i => e.IsSpoiled(s, i));
                var anyReserved = list.Any(i => i.ReservedBy != null);
                // Q24：随身同物品按真实批次（到期 + 来源 + 预留状态）叠卡；最早到期在最前，无保质在后；占格仍按内核合堆计数
                var kb = carried ? sideKb : null;
                var batches = kb?.Count ?? list.Select(i => i.ExpiresAt).Distinct().Count();
                var movable = list.Any(i => i.ReservedBy == null);
                var gSel = sel.Kind == SelectionKind.ItemGroup && sel.Id == id && sel.Owner == Owner
                           && (!split || G.CurrentBatch(Owner, id, allKb) is not { } cur || e.CardSideOf(cur.Stacks[0]) == side);
                var span = carried ? Math.Max(1, e.RootCardsOf(s, list.Select(i => i.InstanceId))) : 1;
                // 只有真实批次确实占了多个卡位时才铺成叠卡；同批仅因制作预留临时拆堆（仍占1格）不叠
                var stacked = kb != null && kb.Count > 1 && span > 1;
                var pickedKey = stacked && gSel ? G.CurrentBatch(Owner, id, kb)?.Key : null;
                if (stacked) head = kb![0].Stacks.FirstOrDefault(i => i.ReservedBy == null) ?? kb[0].Stacks[0];
                var colStyle = (span > 1 ? $"grid-column:span {span};--span:{span};" : "") + (stacked ? $"--layers:{kb!.Count - 1};" : "");
                <div @key="@("g:" + id + (side != null ? ":" + side : ""))" class="card-col @(gSel ? "open" : "") @(stacked ? "stacked" : "")"
                     style="@(colStyle.Length > 0 ? colStyle : null)">
                @if (stacked)
                {
                    @* 后层：从最晚到期到第二早，依次压在前一张下面；点后层 = 选中这一批（展开选批次），卡下操作窗随即作用于它 *@
                    for (var k = kb!.Count - 1; k >= 1; k--)
                    {
                        var b = kb[k];
                        var bk = b.Key;
                        var fresh = b.Spoiled ? "已腐败" : !b.ExpiresAt.HasValue ? "不会腐败" : Ui.Fresh(b.ExpiresAt.Value - s.GameMinute);
                        <button type="button" class="stack-layer @(pickedKey == bk ? "on" : "") @(b.Spoiled ? "spoiled" : "") @(b.Reserved ? "reserved" : "")" style="--i:@k"
                                title="@($"第{k + 1}批×{b.Count}：{fresh}{e.PatchDurabilitySuffix(b.Stacks[0])}{(b.Reserved ? " · 预留" : "")}（点选这一批）")" aria-label="@($"选择第{k + 1}批，{b.Count}份，{fresh}")"
                                @onclick="() => G.PickBatch(Owner, id, bk)">
                            <span class="sl-art">@Icons.Markup(id)</span>
                            <span class="sl-tag"><b>×@b.Count</b> @fresh@(e.PatchDurabilitySuffix(b.Stacks[0]))</span>
                        </button>
                    }
                }
                @{
                    // B17 试玩修复 B4：同物品部分被预留（陶窑/净水台/制作锁定）时，数量写“×5（预留2）”，重量/效果行按全部份数
                    var reservedN = list.Where(i => i.ReservedBy != null).Sum(i => i.Count);
                    var whole = head;
                    if (!stacked && reservedN > 0 && list.Count > 1) { whole = head.Clone(); whole.Count = total; }
                    var infoLine = (stacked ? (kb![0].Spoiled ? "已腐败" : Ui.ItemLine(e, s, head)) : allSpoiled ? "已腐败" : Ui.ItemLine(e, s, whole)) + (!stacked && batches > 1 ? $" · {batches}批" : "");
                    var qtyText = CardStates.ItemQtyText(total, reservedN);
                    // B32a Q356（取代 Q340 物品副标优先级）：副标固定写本卡实际数量（B32c Q361：部分或全部预留都写「×{总数}（预留{数量}）」），不再出主图数量角标；
                    // 第二行先写已腐败、已损坏等明确状态，其次实际保质/到期，再耐久；效果、重量、批次数与完整信息在悬停、聚焦提示与右栏
                    var spoiledFront = stacked ? kb![0].Spoiled : allSpoiled;
                    var line2 = spoiledFront ? "已腐败" : Ui.CardLine2(e, s, stacked ? head : whole);
                    var line2Danger = line2 is "已腐败" or "已损坏";
                }
                @* Q35：长名一行省略时，键盘聚焦提示（data-tip）与名称悬停提示写全名、数量与效果行 *@
                <div id="@(gSel ? "card-sel" : null)" data-tip="@($"{title} ×{total}{(dr ? "（本实例战利品，可封存）" : "")} · {infoLine}{(span > 1 ? $" · 占{span}格" : "")}")" data-card="@key" data-drag="@($"card:{key}")" data-drag-from="@($"{from} ×{total}")" data-drag-title="@title" data-drop="@($"card:{key}")" data-drop-level="card"
                     class="card item k2i @(spoiledFront ? "st-danger" : "") @(allSpoiled ? "spoiled" : "") @(anyReserved ? "reserved" : "") @(gSel && (!stacked || pickedKey == kb![0].Key) ? "selected" : "") @(stacked ? "stack-front" : "") @(G.Highlights.Contains(id) ? "fresh" : "") @(!carried && G.HeldHighlight(id) ? "held" : "")"
                     role="button" tabindex="0" @onclick="() => SelectSide(id, kb, split ? sideKb : null)" @onkeydown="ev => OnCardKey(ev, () => SelectSide(id, kb, split ? sideKb : null))" title="@(dr ? "本实例战利品：这次地牢里领到的奖励，可以封存；成功离开地牢后并回同名物品。" + e.Item(id).Desc : e.Item(id).Desc)">
                    @{ var qtyTip = stacked ? $"共{total}份，最前这一批×{kb![0].Count}" : reservedN > 0 ? $"共{total}份，其中{reservedN}份已被预留（不能拾取或另用）" : null; }
                    @* B32a（Q340、Q356）：重墨 V2 物品卡——上部主图，下部纸色信息条「名称 + 数量副标 + 状态第二行」，转移箭头在信息条右端 *@
                    <div class="k2-art @(side != null ? "has-loot" : "")">@Icons.Markup(id)@if (dr) { <span class="loot-badge" title="本实例战利品（可封存；离开地牢后并回同名物品）" aria-label="本实例战利品">战</span> }@if (side == GameEngine.IdentifiedCardSuffix) { <span class="loot-badge apr-badge" title="已鉴定（普通白色，融合无属性）" aria-label="已鉴定">鉴</span> }@if (side == GameEngine.TutorialCardSuffix) { <span class="loot-badge apr-badge" title="首战教学样本（未鉴定；不能交易，单独成卡）" aria-label="首战教学">教</span> }@if (side == GameEngine.TutorialIdentifiedCardSuffix) { <span class="loot-badge apr-badge" title="首战教学样本·已鉴定（看过免费说明；不能交易，单独成卡）" aria-label="首战教学，已鉴定">教鉴</span> }</div>
                    <div class="k2-info">
                        <div class="k2-name-row"><b class="k2-name" title="@(dr ? title + "（本实例战利品，可封存）" : title)">@title</b>@if (e.PatchGradeTag(id) is string pg) { <i class="qtag @e.PatchGradeClass(id)" title="@($"{title}：{pg}色品阶")">@pg</i> }</div>
                        <div class="k2-sub is-qty" title="@(qtyTip ?? infoLine)">@qtyText</div>
                        @if (line2 != null) { <div class="k2-l2 @(line2Danger ? "danger" : "")" title="@infoLine">@line2</div> }
                    </div>
                    @if (span > 1) { <span class="slot-span" title="@($"同物品{batches}批/超过堆叠上限，占{span}张随身卡{(stacked ? $"；最前这一批×{kb![0].Count}" : "")}")">占@(span)格@(batches > 1 ? $"·{batches}批" : "")</span> }
                    <TransferArrow Owner="@Owner" ItemId="@id" InstanceId="@(side != null ? head.InstanceId : (int?)null)" Enabled="@(movable && !busy)" />
                </div>
                </div>
            }
            else
            {
                var t = items.FirstOrDefault(i => i.InstanceId.ToString() == parts[2]);
                if (t == null) continue;
                var broken = t.Durability.HasValue && t.Durability <= 0;
                var inst = t.InstanceId;
                var toolId = t.ItemId;
                var isPot = e.IsPot(t);
                var locked = e.IsLocked(s, t);
                if (isPot)
                {
                    @* 锅卡与火堆加工位同一个 PotCard（v0.7 第 3.1 节）：水量条、液体行、食材行直接可见 *@
                    <PotCard @key="@("t:" + inst)" Pot="t" />
                    continue;
                }
                var tSel = sel.Kind == SelectionKind.Tool && sel.InstanceId == inst;
                // B32a 试玩修复（Q345）：不可堆叠的有保质物品（各类尸体）腐败后同样挂危险叠层
                var spoiledT = e.IsSpoiled(s, t);
                <div @key="@("t:" + inst)" class="card-col @(tSel ? "open" : "")">
                <div id="@(tSel ? "card-sel" : null)" data-tip="@($"{e.ItemName(t.ItemId)} · {Ui.ItemLine(e, s, t)}")" data-card="@key" data-drag="@($"card:{key}")" data-drag-from="@from" data-drag-title="@e.ItemName(t.ItemId)" data-drop="@($"card:{key}")" data-drop-level="card"
                     class="card item k2i @(t.Quality is "green" or "blue" ? "q-" + t.Quality : "") @(broken || CardStates.BrokenTool(t) ? "broken st-danger" : "") @(spoiledT ? "spoiled st-danger" : "") @(t.ReservedBy != null || locked ? "reserved" : "") @(tSel ? "selected" : "") @(G.Highlights.Contains(t.ItemId) ? "fresh" : "")"
                     role="button" tabindex="0" @onclick="() => SelectTool(inst, toolId)" @onkeydown="ev => OnCardKey(ev, () => SelectTool(inst, toolId))" title="@e.Item(t.ItemId).Desc">
                    @* B32a（Q345、Q356）：独立工具/单件卡副标固定「×{数量}」（B32c Q361：被预留时写「×1（预留1）」）；第二行先写已部署（自身阻断）、已腐败、已损坏（后两者挂危险叠层），
                       其次保质/到期，再耐久；远程武器弹仓、重量、用途在悬停与右栏 *@
                    <div class="k2-art">@Icons.Markup(t.ItemId)</div>
                    @{
                        var deployed = e.IsDeployed(s, t);
                        var tLine = deployed ? "已部署 · 先收起才能拾取" : Ui.ItemLine(e, s, t);
                        var tLine2 = deployed ? tLine : Ui.CardLine2(e, s, t);
                    }
                    <div class="k2-info">
                        <div class="k2-name-row"><b class="k2-name" title="@e.ItemName(t.ItemId)">@e.ItemName(t.ItemId)</b>@if (t.Quality is "green" or "blue") { <i class="qtag q-@t.Quality" title="@($"{e.QualityName(t)}色品质：附加词条{t.Affixes?.Count ?? 0}条")">@e.QualityName(t)</i> }</div>
                        <div class="k2-sub is-qty" title="@tLine">@CardStates.ItemQtyText(t.Count, t.ReservedBy != null ? t.Count : 0)</div>
                        @if (tLine2 != null) { <div class="k2-l2 @(deployed ? "warn" : tLine2 is "已腐败" or "已损坏" ? "danger" : "")" title="@tLine">@tLine2</div> }
                    </div>
                    <TransferArrow Owner="@Owner" ItemId="@toolId" InstanceId="@inst" Enabled="@(t.ReservedBy == null && !locked && !busy && !deployed)" Title="@(deployed ? "已部署 · 先收起才能拾取" : null)" />
                </div>
                </div>
            }
        }
        @if (carried)
        {
            @* 空位轻量表示（S06 §8：固定五个可见位置，无滚动、无分页） *@
            for (var k = used; k < e.MaxRootCards; k++)
            {
                <div @key="@("empty" + k)" class="slot-free" aria-label="空随身卡位" title="空随身卡位：把地面物品卡拖到这里，或选中地面卡片后拾取">空位</div>
            }
        }
        @if (items.Count == 0 && !carried)
        {
            <div class="empty-zone">
                <strong>这里暂时没有散落物品</strong>
                <span>搜集、清理与探索的产物会留在这里</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Owner { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    /// <summary>标题后的补充（当前地面所在地点名）。</summary>
    [Parameter] public string Sub { get; set; } = "";

    private void SelectGroup(string itemId) =>
        G.Select(new Selection { Kind = SelectionKind.ItemGroup, Id = itemId, Owner = Owner });

    /// <summary>B22 M408：同物品分成普通卡与战利品卡时，点哪张就选中那一侧的最前一批（之后转移/食用作用于它）；没有分卡时同 SelectFront。</summary>
    private void SelectSide(string itemId, List<ItemBatch>? batches, List<ItemBatch>? side)
    {
        if (side == null || side.Count == 0) { SelectFront(itemId, batches); return; }
        var pick = side.FirstOrDefault(b => !b.Reserved && !b.Spoiled) ?? side[0];
        G.PickBatch(Owner, itemId, pick.Key);
    }

    /// <summary>点叠卡最前一张：选中这一物品卡，批次回到默认（最前合法可用批次，Q24）。不叠卡时同 SelectGroup。</summary>
    private void SelectFront(string itemId, List<ItemBatch>? batches)
    {
        if (batches == null || batches.Count < 2) { SelectGroup(itemId); return; }
        G.PickBatch(Owner, itemId, null);
    }

    private static void OnCardKey(KeyboardEventArgs ev, Action select)
    {
        if (ev.Key == "Enter" || ev.Key == " ") select();
    }

    private void SelectTool(int instanceId, string itemId) =>
        G.Select(new Selection { Kind = SelectionKind.Tool, Id = itemId, Owner = Owner, InstanceId = instanceId });
}
