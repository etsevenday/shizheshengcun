@inherits GameComponent
@inject IJSRuntime JS

@*
    B53a（S14 2026-11-15 B50a、2026-11-17 B53；逐字稿 B50a 表与 B53 水句）：右栏「丢弃」／「丢弃水」子区。
    入口按钮 → 子区主层（可丢弃数、「选择数量」「全部丢弃」「取消」）→ 数量层（整数、默认 1、「下一步」「返回」）→ 最终「确认丢弃」层（真实清单、「确认丢弃」「返回」）。
    只有最后「确认丢弃」删除；不挂局部回车确认标记、不自动聚焦，无焦点的空格／Enter 不会删除；ESC 每次退一层（GameSession.EscOwner.Discard）。
    B53b（S06／S14／逐字稿文首 2026-11-17 §Q857 B、§Q862—Q866）：无右栏清单行末「丢弃」复用本组件（Host＝发起清单，入口按钮画在行末、子区画在该行下方）；
    子区顶部标题「丢弃 · {物名}」（水仍「丢弃水」）；「总数{总数}，可丢弃{可丢弃数}」一直显示（水按毫升），取代原「可丢弃：…」单行；命中的拒绝原因逐条列出。
*@
@{
    var open = G.DiscardOpenFor(Target, Host) ? G.Discarding : null;
    var escHere = G.EscOwner == EscOwner.Discard;
}

@if (open == null)
{
    @if (!HideButton)
    {
        <div class="discard-entry">
            <button type="button" class="discard-btn" data-pt="@(Target.IsWater ? "discard-water" : "discard")" @onclick="Open">@(Target.IsWater ? DiscardCopy.DiscardWater : DiscardCopy.Discard)</button>
        </div>
    }
}
else
{
    var v = G.DiscardViewOf(Target);
    var title = Target.IsWater ? DiscardCopy.DiscardWater : DiscardCopy.Title(v.Name);
    var totals = Target.IsWater ? DiscardCopy.WaterTotals(v.Total, v.Available) : DiscardCopy.Totals(v.Total, v.Available);
    <section @ref="_sub" class="discard-sub @(Host != null ? "in-list" : "")" data-pt="discard-sub" role="group" aria-label="@title" data-discard-host="@Host">
        <h4 class="discard-title">@title</h4>
        @switch (open.Stage)
        {
            case DiscardStage.Menu:
                @* B53b（§Q863 A）：总数行一直显示（相等、为 0 也显示），取代 B53a 的「可丢弃：…」单行；无可删量时其下逐条写真实原因（§Q866 B） *@
                <div class="discard-avail">@totals</div>
                @foreach (var why in DiscardRules.WhyLines(open.Error, v.Reasons))
                {
                    <div class="blocked">@why</div>
                }
                @* B56（S10 文首 B53a Q929；W100-Q929-03；02 Q979 B 定稿）：有尾水但不足一份（100毫升）时「选择数量」置灰，不写常驻原因行；
                   按钮用 aria-disabled 保持可聚焦，悬停（title）、读屏（aria-describedby）、点按或回车（会话把原因写进上面的原因行）才看到「水分不足。」；
                   「全部丢弃」仍可删真实尾水 *@
                <div class="discard-row">
                    @if (v.QuantityBlocked is string qb) { <span class="sr-only" id="discard-qty-why">@qb</span> }
                    <button type="button" class="discard-opt" data-pt="discard-qty" disabled="@(v.MaxUnits < 1 && v.QuantityBlocked == null)" aria-disabled="@(v.QuantityBlocked != null ? "true" : null)" aria-describedby="@(v.QuantityBlocked != null ? "discard-qty-why" : null)" title="@v.QuantityBlocked" @onclick="G.DiscardChooseQuantity">@DiscardCopy.ChooseQuantity</button>
                    <button type="button" class="discard-opt danger" data-pt="discard-all" disabled="@(v.Available < 1)" @onclick="G.DiscardAll">@DiscardCopy.DiscardAll</button>
                </div>
                <div class="discard-row">
                    <button type="button" class="discard-back" data-pt="discard-cancel" @onclick="G.CancelDiscard">@DiscardCopy.Cancel<EscCap On="@escHere" /></button>
                </div>
                break;
            case DiscardStage.Quantity:
                <div class="discard-avail">@totals</div>
                <div class="discard-qlabel">@(Target.IsWater ? DiscardCopy.WaterQuantity(v.UnitMl) : DiscardCopy.Quantity)</div>
                <div class="tbar-row discard-qty">
                    <button type="button" class="tbar-step" data-pt="discard-minus" aria-label="减少" @onclick="() => G.DiscardStep(-1)">−</button>
                    <input type="text" inputmode="numeric" value="@open.QuantityText" @oninput="e => G.DiscardSetQuantity(e.Value?.ToString() ?? string.Empty)" aria-label="@DiscardCopy.Quantity" />
                    <button type="button" class="tbar-step" data-pt="discard-plus" aria-label="增加" @onclick="() => G.DiscardStep(1)">+</button>
                    @* B56（02 Q979 B 定稿）：水沿「数量（每份100毫升）」标签，输入旁写所选「{毫升}毫升」 *@
                    @if (Target.IsWater)
                    {
                        var qn = int.TryParse(open.QuantityText.Trim(), out var qv) ? Math.Max(0, qv) : 0;
                        <span class="tbar-qlabel" data-pt="discard-ml">@DrinkCopy.AmountText(qn * v.UnitMl)</span>
                    }
                </div>
                @if (open.Error is string qe)
                {
                    <div class="blocked">@qe</div>
                }
                <div class="discard-row">
                    <button type="button" class="discard-opt" data-pt="discard-next" @onclick="G.DiscardNext">@DiscardCopy.Next</button>
                    <button type="button" class="discard-back" data-pt="discard-back" @onclick="G.DiscardBack">@DiscardCopy.Back<EscCap On="@escHere" /></button>
                </div>
                break;
            case DiscardStage.Confirm when open.Plan != null:
                <h4 class="discard-title">@DiscardCopy.ConfirmTitle</h4>
                @foreach (var line in open.Plan.Lines)
                {
                    <p class="discard-line">@line</p>
                }
                <div class="discard-row">
                    <button type="button" class="discard-opt danger" data-pt="discard-confirm" @onclick="Confirm">@DiscardCopy.Confirm</button>
                    <button type="button" class="discard-back" data-pt="discard-back" @onclick="G.DiscardBack">@DiscardCopy.Back<EscCap On="@escHere" /></button>
                </div>
                break;
        }
    </section>
}

@code {
    /// <summary>本次丢弃的真实目标（同组／单件／锅水／壶水）。</summary>
    [Parameter, EditorRequired] public DiscardTarget Target { get; set; } = null!;
    /// <summary>入口按钮已画在别处（水壶「水量」行末、清单行末）时只画子区。</summary>
    [Parameter] public bool HideButton { get; set; }
    /// <summary>B53b：从无右栏清单发起时为该清单（<see cref="DiscardHost"/>）；右栏为 null。</summary>
    [Parameter] public string? Host { get; set; }

    private void Open()
    {
        if (Host != null) G.OpenListDiscard(Target, Host);
        else G.OpenDiscard(Target);
    }

    private void Confirm() => G.ConfirmDiscard();

    private ElementReference _sub;
    private string? _shown;

    /// <summary>
    /// B53b 试玩修复 B3：清单行下方的子区展开或换层（主层→数量→确认）后，把子区滚到可见处（只定位，最近边对齐，不改状态、不抢焦点）；
    /// 远征物资窗、同伴随身列表里子区常展开在可视范围外。右栏子区沿 B53a 贴底容器，不在此滚动。
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var key = Host != null && G.DiscardOpenFor(Target, Host) && G.Discarding is DiscardDraft d ? $"{Target.Key}|{d.Stage}|{d.RequestId}" : null;
        if (key == _shown) return;
        _shown = key;
        if (key == null) return;
        try { await JS.InvokeVoidAsync("survival.revealNearest", _sub); } catch (Exception) { /* 只影响定位 */ }
    }

}
