@inherits GameComponent

@* 序章任务角（A10-TUTOR §3、S15 §4、S14「序章引导」；开发计划 v0.9 B13 R43）。
   试玩修复 M269：原放在当前地图卡内右上角，1280×720 下地图卡只有约 134px 高，任务角只露 14px 且压住探索/清理按钮，
   改为右栏页签下方的固定小框（占布局、不浮在任何卡上，下面的对象信息/人物在自己的区域里滚动）。
   内容：1 个主目标（标题 + 白话下一步）、“建议 N ▸”（点开读最多两条）、“任务册”、得知路线后“远行准备”，以及同一时刻最多一条中性“系统提示”
   （“关闭这条/暂停后续提示”，不锁输入、不推进时间，关闭不等于完成）。可收起为一行（偏好存浏览器本地，新局不清空）。
   新完成一项时显示 PROxx_done 约 8 秒（界面节奏）；对白显示期间不开始计时，读完对白后才显示（试玩修复 P6）。不进行动日志、不弹窗。 *@
@{
    var s = G.S;
    var e = G.E;
    var obj = e.CurrentObjective(s);
    var open = G.IsFoldOpen(FoldKey);
}
@if (obj != null && !s.Progress.Dead && !G.InBattleUi)
{
    var sugg = e.CurrentSuggestions(s);
    var hint = e.CurrentHint(s);
    var routeKnown = s.Progress.Flags.Contains(GameEngine.FactCampRouteKnown);
    <section class="task-box @(open ? "" : "folded")" aria-label="当前目标">
        <div class="tc-head">
            <span class="tc-tag">主目标</span>
            <span class="tc-title" title="@obj.Title">@obj.Title</span>
            <button type="button" class="tc-min" title="@(open ? "收起任务框（真实危险提示不受影响）" : "展开任务框")" aria-label="@(open ? "收起任务框" : "展开任务框")" aria-expanded="@open" @onclick="Toggle">@(open ? "–" : "+")</button>
        </div>
        @if (open)
        {
            <div class="tc-step" title="@obj.Step">@obj.Step</div>
            <div class="tc-row">
                @if (sugg.Count > 0)
                {
                    <button type="button" class="tc-link @(showSugg ? "on" : "")" aria-expanded="@showSugg" @onclick="() => showSugg = !showSugg">建议 @(sugg.Count) @(showSugg ? "▾" : "▸")</button>
                }
                <button type="button" class="tc-link" title="打开任务册（完整18项、已完成与提示）" disabled="@G.DialogueLocked" @onclick='() => G.OpenPanel("goals")'>任务册</button>
                @if (routeKnown)
                {
                    <button type="button" class="tc-link" title="路线、当前状态与随身预览，确认远行准备（不耗时）" disabled="@G.DialogueLocked" @onclick='() => G.OpenPanel("journey")'>远行准备</button>
                }
            </div>
            @if (showSugg)
            {
                <ul class="tc-sugg">
                    @foreach (var x in sugg)
                    {
                        <li title="@x.Step"><b>@x.Title</b><span>@x.Step</span></li>
                    }
                </ul>
            }
            @if (flash != null)
            {
                <div class="tc-done" role="status"><span class="tc-sys">系统</span>@flash</div>
            }
            else if (hint is { } h)
            {
                <div class="tc-hint" role="note">
                    <span class="tc-sys">系统提示</span><span class="tc-hint-text" title="@h.Text">@h.Text</span>
                    <span class="tc-hint-btns">
                        <button type="button" class="tc-link" @onclick="() => G.DismissHint(h.TaskId)">关闭这条</button>
                        <button type="button" class="tc-link" title="只关闭中性操作提示；剧情、危险提示与任务不受影响，可在任务册恢复" @onclick="() => G.SetHintsPaused(true)">暂停后续提示</button>
                    </span>
                </div>
            }
        }
        else if (sugg.Count > 0)
        {
            <span class="tc-count" aria-label="@($"另有{sugg.Count}条建议")">建议 @(sugg.Count)</span>
        }
    </section>
}

@code {
    /// <summary>任务框收起偏好（UiFoldPrefs，浏览器本地，不进存档）。</summary>
    public const string FoldKey = "task_corner";

    private bool showSugg;
    private string? flash;
    private string? _pending;
    private int _flashSeq;

    private void Toggle() => G.ToggleFold(FoldKey);

    protected override void OnAfterRender(bool firstRender) => CheckDone();

    /// <summary>
    /// 新完成一项：记下该项 PROxx_done；对白显示期间先挂起，对白结束后才显示并开始约 8 秒计时（P6）。
    /// 已显示过的键记在会话里（任务框重建也不重复闪）；首次只记下，不回放读档前的完成。
    /// </summary>
    private void CheckDone()
    {
        if (G.State == null) return;
        var p = G.S.Prologue;
        var key = $"{p.LastDoneTask}@{p.LastDoneAt}";
        if (G.TaskDoneSeen == null) { G.TaskDoneSeen = key; return; }
        if (key != G.TaskDoneSeen)
        {
            G.TaskDoneSeen = key;
            _pending = G.E.ProTask(p.LastDoneTask)?.Done;
        }
        if (_pending == null || G.DialogueLocked) return;
        flash = _pending;
        _pending = null;
        var seq = ++_flashSeq;
        _ = Clear(seq);
        StateHasChanged();
    }

    private async Task Clear(int seq)
    {
        await Task.Delay(8000);
        if (seq != _flashSeq) return;
        flash = null;
        await InvokeAsync(StateHasChanged);
    }
}
