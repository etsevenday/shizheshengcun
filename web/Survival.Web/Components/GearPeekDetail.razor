@inherits GameComponent

@* B33（Q435-2、Q450、Q459、Q462）：整备页内点来源卡或已穿戴装备时，右栏临时覆盖的只读整备详情。主角与同行者统一只读：
   真实位置、名称品质、说明／效果原句、重量、耐久成色、装备各行、保质、只读批次及锅内容；不显示按主角自用计算的
   「即时效果」「5分钟后」「耗时」预估，不提供批次点选和操作页脚。不改主界面真正选中、不计 PRO01、不触发引导。
   BM4b（S14 Q589）：同右栏紧凑表头（小缩略图＋名称＋来源行「{地点}[ · {区域}] · {持有人}」）→ 主要数据 → 次要组（说明、词条、内容）。 *@
@{
    var s = G.S;
    var e = G.E;
    var it = Item;
    var cfg = e.Item(it.ItemId);
    var railType = e.IsPot(it) ? RailTypes.Facility : cfg.IsEquipment || e.Weapon(cfg.Id) != null || it.MaxDurability.HasValue ? RailTypes.Gear : RailTypes.Supply;
    // BM5b1（S14 Q608）：同对象详情——已具备资格的固定特性进首屏「生效效果」摘要，说明组同一特性不重复
    var equipLines = e.RailEquipLines(s, it, out var activeTraits);
    // Q589「武器／装备／工具」首屏：类型（含速度修正）、固定效果（护甲等已生效摘要）、损坏状态；品质已在名称旁标签，“品质（附加词条n条）”行随词条组，
    // 固定特性（多为相关技能上线后生效）、站位、技能归属、噪声与拆解在说明组
    // BM7b（S14 Q650）：非武器固定效果已有真实消费者的分项进主区特性组（activeTraits），其余（未接入／暂停）的「固定效果」行归说明组
    var mainEquip = equipLines.Where(x => x.Label is "类型" or "状态").ToList();
    var affixLines = equipLines.Where(x => x.Label == "附加词条" || (x.Label == "品质" && equipLines.Any(y => y.Label == "附加词条"))).ToList();
    var moreEquip = equipLines.Where(x => !mainEquip.Contains(x) && !affixLines.Contains(x)).ToList();
    var descText = cfg.Use != null && !cfg.Use.IsMedicine ? GameEngine.UseEffectText(cfg.Use) + (e.UseRiskText(cfg) is string rk ? $"；{rk}" : "") : e.RailEquipDesc(it, cfg.Desc);
    var potLiquids = e.IsPot(it) ? e.PotLiquids(s, it.InstanceId) : new List<ItemInstance>();
    var potFoods = e.IsPot(it) ? e.PotFood(s, it.InstanceId) : new List<ItemInstance>();
}

<div class="detail-scroll gear-peek rail-page" data-gear-peek="@it.InstanceId" data-rail-type="@railType">
    <RailHead Source="@e.RailSourceLine(s, it)">
        <Thumb>@Icons.Markup(cfg.Id)</Thumb>
        <Name>@e.InstanceName(it)@if (cfg.IsEquipment) { <small class="qtag q-@(it.Quality ?? "white")">@e.QualityName(it)</small> }@if (it.Count > 1) { <small class="muted"> ×@it.Count</small> }</Name>
    </RailHead>
    <div class="lines rail-main">
        @if (e.Weapon(cfg.Id) is WeaponConfig { CanAttack: true } wp)
        {
            <div><span>伤害</span><b>@(Ui.N(wp.DamageMin))—@(Ui.N(wp.DamageMax))</b></div>
            <div><span>命中能力</span><b>@(Ui.T(wp.AccuracyRating))</b></div>
            <div><span>暴击能力</span><b>@(Ui.T(wp.CritRatingBase))</b></div>
            var rangeText = $"我方{GameEngine.PosList(GameEngine.OwnPositionsOf(wp))}→敌方{GameEngine.PosList(GameEngine.TargetPositionsOf(wp))}";
            <div class="@(rangeText.Length > 14 ? "wide" : "")"><span>攻击范围</span><b>@rangeText</b></div>
        }
        @foreach (var (label, value) in mainEquip)
        {
            <div class="@(label == "品质" ? "q-" + (it.Quality ?? "white") : "") @(value.Length > 14 ? "wide" : "")"><span>@label</span><b>@value</b></div>
        }
        <div><span>合计重量</span><b>@Ui.Kg(e.ItemGrams(s, it))公斤@(e.IsPot(it) ? "（含锅内）" : "")</b></div>
        @if (it.Count > 1) { <div><span>单件重量</span><b>@Ui.Kg(e.UnitGrams(it))公斤</b></div> }
        @if (it.MaxDurability.HasValue && it.Durability.HasValue)
        {
            <div><span>耐久</span><b class="@(it.Durability <= 0 ? "danger-text" : "")">@(it.Durability <= 0 ? "已损坏" : GameEngine.DurabilityText(it))</b></div>
            <div><span>成色</span><b>@Ui.Pct(GameEngine.Condition(it))</b></div>
        }
        @foreach (var fx in activeTraits)
        {
            <div class="wide rail-fx"><span>@e.EquipTraitGroupLabel(it)</span><b>@fx</b></div>
        }
        @if (activeTraits.Count > 0 && !it.IsWorn)
        {
            @* BM5b1（S14 Q638）：未穿戴也可介绍，组名「具备特性」，必要说明「穿戴后可触发」，不写生效中、不加人物属性 *@
            <div class="wide rail-fx-note">@GameEngine.WornTriggerHint</div>
        }
        @if (it.ExpiresAt.HasValue)
        {
            @* 只读批次：这一份的到期，不提供点选 *@
            <div><span>@RailText.Batch</span><b>×@it.Count@(it.ReservedBy != null ? " · 预留" : "") · @(e.IsHeatProtected(s, it) ? Ui.FreshOf(e, s, it) : Ui.Fresh(it.ExpiresAt.Value - s.GameMinute))</b></div>
        }
        @if (e.IsPot(it))
        {
            var pc = e.PotConfig(it);
            <div><span>水量</span><b>@(CardStates.PotWaterLine(e, s, it) ?? $"空锅 0/{pc.CapacityMl}毫升")</b></div>
            <div><span>食材</span><b>@potFoods.Count/@pc.FoodSlots</b></div>
            <div><span>处理进度</span><b>@e.ContentStatus(s, it)</b></div>
        }
    </div>
    @if (!string.IsNullOrEmpty(descText) || moreEquip.Count > 0 || cfg.ShelfLifeMinutes.HasValue || it.Count <= 1 || e.Weapon(cfg.Id) is { CanAttack: true })
    {
        <RailFold Type="@railType" Group="@RailGroups.Desc" Name="@RailText.Desc">
            @if (!string.IsNullOrEmpty(descText)) { <p class="rail-text">@descText</p> }
            <div class="lines">
                @if (e.Weapon(cfg.Id) is WeaponConfig { CanAttack: true } sw) { <div><span>武器</span><b>@(sw.SkillId == "" ? "（无对应熟练度）" : e.SkillName(sw.SkillId))</b></div> }
                @if (it.Count <= 1) { <div><span>单件重量</span><b>@Ui.Kg(e.UnitGrams(it))公斤</b></div> }
                @foreach (var (label, value) in moreEquip)
                {
                    <div class="wide"><span>@label</span><b>@value</b></div>
                }
                @if (cfg.ShelfLifeMinutes.HasValue)
                {
                    <div><span>保质期</span><b>@(cfg.ShelfLifeMinutes / 60)小时</b></div>
                }
            </div>
        </RailFold>
    }
    @if (affixLines.Count > 0)
    {
        <RailFold Type="@railType" Group="@UiFoldPrefs.Traits" Name="@RailText.Traits" Count="@affixLines.Count(x => x.Label == "附加词条")">
            <div class="lines">
                @foreach (var (label, value) in affixLines) { <div class="wide @(label == "品质" ? "q-" + (it.Quality ?? "white") : "")"><span>@label</span><b>@value</b></div> }
            </div>
        </RailFold>
    }
    @if (potLiquids.Count + potFoods.Count > 0)
    {
        var pc = e.PotConfig(it);
        <RailFold Type="@railType" Group="@RailGroups.Content" Name="@RailText.Content" Count="@(potLiquids.Count + potFoods.Count)">
            @foreach (var c in potLiquids)
            {
                <ItemRow Icon="@c.ItemId" Name="@e.ItemName(c.ItemId)" Qty="@($"×{c.Count}")" Status="@($"{c.Count * pc.UnitMl}毫升")" />
            }
            @foreach (var f in potFoods)
            {
                <ItemRow Icon="@f.ItemId" Name="@e.ItemName(f.ItemId)" Qty="×1" Status="@e.ContentStatus(s, f)" />
            }
        </RailFold>
    }
</div>

@code {
    [Parameter, EditorRequired] public ItemInstance Item { get; set; } = default!;
}
