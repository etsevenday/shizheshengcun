@inherits GameComponent

@* 手工制作。Part="center"：中部的配方列表、材料与火堆；Part="detail"：右栏的预估与确认，或暂停加工的继续/取消。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var lc = e.Location(here);
    var fac = s.Locations[here].Facility;
    var recipeId = G.CraftRecipe ?? (lc.HasFire ? "boil" : "knife");
    var rc = e.Recipe(recipeId);
    var main = s.Main;
    var craftPaused = main != null && main.Status == ActionStatus.Paused && (main.Type == ActionType.Craft || main.Type == ActionType.Build);
    var busy = G.Running || s.Sub != null;
    var maintBlocked = busy || (main != null && (main.Status != ActionStatus.Paused || main.Type == ActionType.Travel));
    var candidates = G.CraftCandidates;
    var recipes = candidates == null ? e.Config.Recipes : e.Config.Recipes.Where(r => candidates.Contains(r.Id)).ToList();
    var preferred = G.CraftPreferred.Where(id => s.Items.Any(i => i.InstanceId == id && rc.Inputs.ContainsKey(i.ItemId))).ToList();
    var request = ActionRequest.Craft(recipeId, G.CraftPot, preferred);
}

@if (Part == "center")
{
    <div class="sub-panel" role="dialog" aria-label="手工制作与营地设施">
        <div class="sub-head">
            <div><h2>手工制作</h2><span class="sub">材料来自随身与@(lc.Name)地面 · 配方全部已知 · 预估与确认在右侧</span></div>
            <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
        </div>
        <div class="sub-body craft-grid">
            <div class="recipe-list">
                @if (candidates != null)
                {
                    <div class="tiny muted candidates-head">拖拽找到的候选配方 · 缺料的不能开始 <button class="linkish" @onclick="ShowAll">显示全部</button></div>
                }
                @foreach (var r in recipes)
                {
                    var id = r.Id;
                    var built = r.FacilityResult != null && lc.CanBuildShelter && (r.FacilityResult == "shelterBuilt" ? fac.ShelterBuilt : fac.BedBuilt);
                    var icon = r.FacilityResult == "shelterBuilt" ? "shelter" : r.FacilityResult == "bedBuilt" ? "bed" : r.Outputs.Keys.First();
                    var why = candidates != null ? e.CanStart(s, ActionRequest.Craft(id)) : null;
                    <button class="recipe @(id == recipeId ? "on" : "") @(why != null ? "missing" : "")" @onclick="() => Pick(id)" title="@why">
                        @Icons.Markup(icon)
                        <span>@r.Name<small>@(built ? "已建造" : why != null ? why : $"{r.BaseMinutes}分钟{(r.NeedsFire ? " · 需火堆" : r.IsBuild ? " · 营地" : "")}")</small></span>
                    </button>
                }
            </div>

            <div class="craft-side">
                <div class="panel craft-mats">
                    <div class="eyebrow">@(rc.IsBuild ? "营地设施" : "配方") · @rc.Name</div>
                    <p class="small muted" style="margin:4px 0 8px">@RecipeHint(rc)</p>
                    @foreach (var kv in rc.Inputs)
                    {
                        var item = kv.Key;
                        if (rc.Pot != null && item == rc.Pot.InputItem)
                        {
                            var potForBoil = e.SelectPot(s, G.CraftPot, out _);
                            var inPot = potForBoil == null ? 0 : e.PotContents(s, potForBoil.InstanceId).Where(i => i.ItemId == item).Sum(i => i.Count);
                            <div class="mat @(inPot < kv.Value ? "missing" : "")">
                                <span>@e.ItemName(item) ×@kv.Value（锅内）</span>
                                <span>锅内@(inPot)/@(kv.Value)@(inPot < kv.Value ? " · 先把脏水卡拖进锅" : "")</span>
                            </div>
                            continue;
                        }
                        var have = e.AvailableCount(s, item, true);
                        var carried = e.UsableBatches(s, item, false).Sum(i => i.Count);
                        var plan = Fill(item, kv.Value, preferred);
                        <div class="mat slot @(have < kv.Value ? "missing" : "")" data-drop="@($"slot:{recipeId}:{item}")" data-drop-level="hot" title="把具体批次的卡拖到这里指定使用">
                            <span>@e.ItemName(item) ×@kv.Value</span>
                            <span>可用@(have)（随身@(carried)／地面@(have - carried)）</span>
                            <div class="slot-batches">
                                @foreach (var (b, n) in plan)
                                {
                                    var bid = b.InstanceId;
                                    var pinned = preferred.Contains(bid);
                                    <button type="button" class="batch-chip @(pinned ? "on" : "")" title="@(pinned ? "已手工指定，点击取消" : "点击固定使用这一批")" @onclick="() => TogglePreferred(bid)">
                                        @BatchText(b, n, pinned)
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    @foreach (var tag in rc.Catalysts)
                    {
                        var name = e.Config.Items.First(i => i.ToolTag == tag).Name;
                        if (e.Config.Items.Any(i => i.ToolTag == tag && i.ContainerId != null))
                        {
                            var pot = e.SelectPot(s, G.CraftPot, out var potWhy);
                            var place = pot == null ? "" : pot.IsCarried ? "随身" : e.AttachedPot(s, here)?.InstanceId == pot.InstanceId ? "锅位" : "地面";
                            <div class="mat @(pot == null ? "missing" : "")"><span>@name（容器，不消耗）</span><span>@(pot == null ? potWhy : $"{place} · {e.PotLabel(s, pot)}")</span></div>
                            continue;
                        }
                        var tool = e.AccessibleTool(s, tag);
                        <div class="mat @(tool == null ? "missing" : "")"><span>@name（催化工具，不消耗）</span><span>@(tool == null ? "需随身或在当前地面" : tool.IsCarried ? "随身 ✓" : "地面 ✓")</span></div>
                    }
                </div>

                <div class="panel fire-box">
                    @if (lc.HasFire)
                    {
                        <div class="fire-row">
                            <div class="art">@Icons.Markup("fire")</div>
                            <div class="lines" style="flex:1">
                                <div><span>营地火堆</span><b class="@(fac.FireLit ? "good-text" : "muted")">@(fac.FireLit ? "燃烧中" : "未点燃")</b></div>
                                <div><span>燃料</span><b>@(fac.FuelMinutes)/@(e.Config.Fire.MaxFuelMinutes)分钟</b></div>
                                <div><span>可用木材</span><b>@e.AvailableCount(s, "wood", true)</b></div>
                                <div><span>遮蔽棚 / 床垫</span><b>@(fac.ShelterBuilt ? "已建" : "未建") / @(fac.BedBuilt ? "已铺" : "未铺")</b></div>
                            </div>
                        </div>
                        <div class="btn-row">
                            <button class="secondary" disabled="@maintBlocked" @onclick="AddFuel">@(craftPaused ? "1. " : "")投入1木材·+60分钟</button>
                            @if (!fac.FireLit)
                            {
                                <IgnitePicker Prefix="@(craftPaused ? "2. " : "")" Busy="busy" />
                            }
                            else
                            {
                                <button class="secondary" disabled="@maintBlocked" @onclick="Extinguish">熄灭火堆（保留燃料）</button>
                            }
                        </div>
                        <div class="tiny muted">火堆点燃后按游戏时间持续燃烧，离开、休息、睡眠时也会烧；只照亮营地。</div>
                    }
                    else
                    {
                        <div class="tiny muted">@(lc.Name)没有火堆。普通手工可以在任何地点进行；烧水、烹饪和营地设施需要回到临时营地。</div>
                    }
                </div>
            </div>
        </div>
    </div>
}
else if (craftPaused && main!.TargetId == recipeId)
{
    <div class="detail-scroll">
        <div class="op-head"><div class="eyebrow"><span class="status-chip paused">已暂停</span> 手工制作</div><h2>@main.Label</h2>
            <p>@(main.PauseReason == PauseReason.FireOut ? "火堆熄灭，原材料与进度保留。请在中间的火堆区投料、点火，然后继续。" : "行动已暂停，可维护火堆或回到主界面处理。")</p></div>
        <div class="lines">
            <div><span>已完成工作量</span><b>@(Ui.Floor(main.WorkDone))/@(Ui.Floor(main.BaseWorkMinutes))分钟</b></div>
            <div><span>剩余工作量</span><b>@(Ui.Floor(Math.Max(0, main.BaseWorkMinutes - main.WorkDone)))分钟</b></div>
            <div><span>火堆燃料</span><b>@(fac.FuelMinutes)分钟 · @(fac.FireLit ? "燃烧中" : "未点燃")</b></div>
        </div>
    </div>
    <div class="detail-foot">
        <button class="primary" disabled="@(busy || (main.PauseReason == PauseReason.FireOut && !fac.FireLit))" @onclick="G.Resume">3. 继续@(main.Label)</button>
        <button class="secondary danger" style="width:100%;margin-top:8px" disabled="@busy" @onclick="G.Cancel">取消并返还材料</button>
        <div class="under">点火完成后不会自动继续</div>
    </div>
}
else
{
    <PreviewView Request="request" Eyebrow="@($"手工制作 · {(rc.IsBuild ? "营地设施" : "配方")}")" Title="@rc.Name" Subtitle="@RecipeHint(rc)" />
}

@code {
    [Parameter] public string Part { get; set; } = "center";

    private static string RecipeHint(RecipeConfig r) => r.Id switch
    {
        "knife" => "纤维采集耗时从20分钟降到10分钟，耐久20次。",
        "axe" => "木材采集每次产出翻倍，耐久30次。",
        "bandage" => "健康+5，每60分钟最多使用一次。",
        "boil" => "把锅里的2份脏水原地烧成净水，净水留在原锅。先把脏水卡拖进锅装满1升（不会自动补水）；锅可在随身或当前地面。需燃烧的营地火堆。",
        "cook" => "把2份生块根煮成2份熟块根，熟食保质24小时，放在当前地面。需一口空锅（随身或当前地面）与燃烧火堆。",
        "shelter" => "营地可遮蔽睡眠（清醒+12、体力+15、精神+1/小时），休息额外恢复精神。",
        "bed" => "营地睡眠体力每小时额外+5。需要先建成遮蔽棚。",
        _ => "",
    };

    private void Pick(string id)
    {
        G.CraftRecipe = id;
        G.Notify();
    }

    private void ShowAll()
    {
        G.CraftCandidates = null;
        G.Notify();
    }

    private void TogglePreferred(int id)
    {
        if (!G.CraftPreferred.Remove(id)) G.CraftPreferred.Add(id);
        G.Notify();
    }

    private string BatchText(ItemInstance b, int n, bool pinned)
    {
        var where = b.IsCarried ? "随身" : "地面";
        var fresh = b.ExpiresAt.HasValue ? " · " + Ui.Fresh(b.ExpiresAt.Value - G.S.GameMinute) : "";
        return $"{where}×{n}{fresh}{(pinned ? " · 指定" : "")}";
    }

    /// <summary>材料槽将用到的批次：手工指定的在前，其余按最早到期、随身优先、实例 ID 自动补齐。</summary>
    private List<(ItemInstance inst, int n)> Fill(string itemId, int need, List<int> preferred)
    {
        var list = G.E.UsableBatches(G.S, itemId, true)
            .OrderBy(b => preferred.Contains(b.InstanceId) ? preferred.IndexOf(b.InstanceId) : int.MaxValue).ToList();
        var res = new List<(ItemInstance, int)>();
        foreach (var b in list)
        {
            if (need <= 0) break;
            var n = Math.Min(need, b.Count);
            res.Add((b, n));
            need -= n;
        }
        return res;
    }

    private void AddFuel() => G.Instant(InstantRequest.AddFuel());
    private void Extinguish() => G.Instant(InstantRequest.Extinguish());

    private void Close() => G.OpenPanel(null);
}
