@inherits GameComponent

@* 手工制作。Part="center"：中部的配方列表、材料与配方卡内唯一的“开始制作/开始建造”（S08 §5、S14 §14.1）；Part="detail"：右栏的详细预估（只读）。
   v0.4（统一卡片案第 6 节）：材料、产物、催化工具都是 图标+名称+数量/状态 的行，缺料整行标出；
   烧水、烤制、水煮改为火堆自动加工，这里只保留三条“处理说明”（图示步骤 + 查看火堆），不再有占用角色时间的开始按钮。
   火堆的投料、点火在地块栏第二行的火堆卡上（v0.7 起锅与食材直接嵌在火堆卡内）。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var lc = e.Location(here);
    var fac = e.FacOf(s, s.Ground) ?? s.Locations[here].Facility;
    // B42：右栏悬停查看别的配方／处理说明时只换右栏读的条目（只读）；与当前所选不同时按点选新配方时的初值（1份、未指定锅／目标／修补包）预估，
    // 不改所选配方、份数与材料槽
    var peekOn = Part != "center" && PeekRecipe != null;
    var cur = peekOn ? PeekRecipe : G.CraftRecipe;
    var other = peekOn && PeekRecipe != G.CraftRecipe;
    var procId = cur != null && cur.StartsWith(ProcPrefix) ? cur.Substring(ProcPrefix.Length) : null;
    var proc = procId == null ? null : e.Config.Processes.FirstOrDefault(p => p.Id == procId);
    // B10（A10 §9.1）：未掌握的做法也列出、写“未掌握”与来源（取代 Q64 时“不列出”的做法），开工校验仍拒绝
    var recipeId = cur != null && e.Config.Recipes.Any(r => r.Id == cur && !r.IsSalvage) ? cur : "knife";
    var rc = e.Recipe(recipeId);
    var tab = procId != null ? AutoTab : G.CraftTab ?? TabOf(rc);
    var main = s.Main;
    var craftPaused = main != null && main.Status == ActionStatus.Paused && (main.Type == ActionType.Craft || main.Type == ActionType.Build);
    var busy = G.Running || s.Sub != null;
    var candidates = G.CraftCandidates;
    // 拆解（B4）走配方流程但只在选中装备的卡下开始，不进手工制作列表
    var recipes = (candidates == null ? e.Config.Recipes.Where(r => TabOf(r) == tab) : e.Config.Recipes.Where(r => candidates.Contains(r.Id) && e.RecipeKnown(s, r)))
        .Where(r => !r.IsSalvage).OrderBy(r => e.RecipeLocks(s, r).Count > 0 ? 1 : 0).ToList();
    var preferred = G.CraftPreferred.Where(id => s.Items.Any(i => i.InstanceId == id && rc.AllInputs.ContainsKey(i.ItemId))).ToList();
    var locks = e.RecipeLocks(s, rc);
    var batchable = !rc.IsBuild && !rc.IsRepair && !rc.IsFixedWait && !rc.IsDrying;   // B16：固定等待每次只做1批；B22c 试玩修复 M470：晾制每位一批
    var batch = batchable && !other ? Math.Max(1, G.CraftBatch) : 1;
    var stationRecipe = e.IsStationBatchRecipe(rc);   // B32e（Q380）：陶窑/固定净水台按「投料批数」连续投料、排队加工
    var sb = stationRecipe ? e.StationBatchHere(s, rc.Station) : null;
    var sbWait = stationRecipe ? e.StationWaitingHere(s, rc.Station) : new List<StationBatch>();
    var request = ActionRequest.Craft(recipeId, rc.NeedsExplicitPot && !other ? G.CraftPot : null, preferred, batch);
    if (rc.IsRepair) request.InstanceId = other ? null : G.CraftTarget;
    if (GameEngine.IsFieldPatchRecipe(rc)) request.PatchInstanceId = other ? null : G.CraftPatch;   // B22b（Q168）：选用的修补包，空为默认
}

@if (Part == "center")
{
    <div class="sub-panel" role="dialog" aria-label="手工制作与营地设施">
        <div class="sub-head">
            @* 试玩修复 M77-B7（Q21）：材料来源等教学短文移进悬浮说明 *@
            <div><h2>手工制作</h2><span class="sub" title="@($"材料来自随身与{lc.Name}地面（火堆与锅里的物资要先取出）；按工坊分类；未掌握的做法也列出并写来源；在配方卡下方开始，详细预估在右栏对象信息。")">配方 · 详细预估在右栏 ⓘ</span></div>
            <button class="secondary" @onclick="Close">关闭<EscCap On="@(G.EscOwner == EscOwner.Panel)" /></button>
        </div>
        <div class="sub-body craft-grid @(candidates == null ? "tabbed" : "")">
            @if (candidates == null)
            {
                    @* B10（A10 §9.1）：一级按工坊分类控制数量，长列表只在二级局部滚动；标签写本地工坊是否建成 *@
                    <div class="craft-tabs" role="tablist" aria-label="工坊分类">
                        @foreach (var (tid, tname) in Tabs())
                        {
                            var t = tid;
                            var st = e.Config.Workshops.Stations.FirstOrDefault(x => x.Id == t && x.BuildRecipe != null);
                            // B14b（Q141）：本地公共工坊站已开放也算可用（标签写“公共”）
                            var builtSt = st == null || e.StationUsableHere(s, t);
                            var pubSt = st != null && !e.WorkshopBuilt(s, s.Ground, t) && s.CurrentZone == GameState.ExteriorZone && e.PublicStationOpenHere(s, t);
                            <button type="button" role="tab" aria-selected="@(tab == t)" class="craft-tab @(tab == t ? "on" : "") @(builtSt ? "" : "unbuilt")" data-tab="@t"
                                    title="@(st == null ? tname : pubSt ? $"{tname}：{lc.Name}的公共{tname}已开放（0额外费用）" : builtSt ? $"{tname}：{lc.Name}已建成" : $"{tname}：{lc.Name}{TabSuffix(t).TrimStart('·')}（可浏览配方与门槛）")" @onclick="() => PickTab(t)">@tname@(pubSt ? "·公共" : builtSt ? "" : TabSuffix(t))</button>
                        }
                    </div>
            }
            <div class="recipe-list">
                @if (candidates != null)
                {
                    <div class="tiny muted candidates-head">拖拽找到的候选配方 · 缺料的不能开始 <button class="linkish" @onclick="ShowAll">显示全部</button></div>
                }
                @foreach (var r in recipes)
                {
                    var id = r.Id;
                    var built = e.FacilityBuiltHere(s, r);
                    var icon = RecipeIcon(r);
                    var rl = e.RecipeLocks(s, r);
                    var why = candidates != null ? e.CanStart(s, ActionRequest.Craft(id)) : rl.FirstOrDefault();
                    <button class="recipe @(id == recipeId && proc == null ? "on" : "") @(why != null && !built ? "missing" : "")" @onclick="() => Pick(id)" title="@(why ?? RecipeMeta(r))" data-recipe="@id" data-peek="@Peek.Recipe(id)">
                        @Icons.Markup(icon)
                        <span>@r.Name<small>@(built ? "已建成" : why != null ? e.RecipeLockShort(r, why) : RecipeMeta(r))</small></span>
                    </button>
                }
                @if (candidates == null && tab == AutoTab)
                {
                    <div class="tiny muted candidates-head">火堆自动加工 · 处理说明</div>
                    @foreach (var p in e.Config.Processes)
                    {
                        var pid = p.Id;
                        <button class="recipe proc @(procId == pid ? "on" : "")" @onclick="() => Pick(ProcPrefix + pid)" data-peek="@Peek.Recipe(ProcPrefix + pid)">
                            @Icons.Markup(p.OutputId)
                            <span>@ProcTitle(p)<small>自动加工 · 受热@(p.HeatMinutes)分钟</small></span>
                        </button>
                    }
                }
            </div>

            <div class="craft-side">
                @if (proc != null)
                {
                    <div class="panel craft-mats">
                        @* Q21：处理说明与“不占角色时间”教学短文移进悬浮说明 *@
                        <div class="eyebrow" title="@($"{ProcHint(proc)} 不额外占角色主行动，仍需世界时间推进：放进去后角色可以去探索、清理、休息或睡眠，世界时间推进时火堆自动加工；浏览与离线不推进。")">处理说明 · 自动加工 ⓘ</div>
                        <div class="steps">
                            @foreach (var (icon, name, note) in Steps(proc))
                            {
                                <ItemRow Icon="@icon" Name="@name" Status="@note" CssClass="step" />
                            }
                        </div>
                        <div class="btn-row" style="margin-top:10px">
                            <button class="secondary" disabled="@(!e.HasFireAt(s, s.Ground))" title="@(e.HasFireAt(s, s.Ground) ? "关闭手工制作，在地块栏第二行选中火堆" : $"{lc.Name}没有火堆，回到营地才能加工")"
                                    @onclick="G.SelectFire">查看火堆 ▸</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="panel craft-mats@(stationRecipe ? " station-mats" : "")">
                        <div class="eyebrow" title="@RecipeHint(rc)">@(rc.IsBuild ? (GameEngine.IsWildFireRecipe(rc) ? "野外建造" : "营地建造") : e.StationName(rc.Station)) · @rc.Name ⓘ</div>
                        @* B10（A10 §9.1）：来源、工坊与门槛一次写全；不满足的标出原因（不是缺料） *@
                        <div class="craft-source" data-craft-source>
                            <span>@RecipeMeta(rc)</span>
                            @if (SourceText(rc) is string src) { <span class="muted">来源：@src</span> }
                            @* B23（A10 §4）：配方状态逐类（知识未得/熟练不足/设施未到/工具燃料不足）；材料缺口在下面的原料行 *@
                            @foreach (var (cat, text, _) in e.RecipeStatus(s, rc, batch).Where(x => x.Category is not ("材料缺口" or "来源当前不可达"))) { <span class="warn-text" title="@text" data-recipe-status="@cat">@cat：@text</span> }
                            @if (GameEngine.IsWildFireRecipe(rc))
                            {
                                @* B22e（Q173）：建野外火堆的不合格原因逐项列出（地点/火源/敌踪/行动/材料），施工不能消除危险 *@
                                @foreach (var w in e.WildFireReasons(s).Except(locks)) { <span class="warn-text" data-wild-fire-reason title="@w">@w</span> }
                            }
                        </div>
                        @if (GameEngine.IsFieldPatchRecipe(rc))
                        {
                            @* B22b（Q168）：现场修补——先选目标，再选修补包（不选则默认用能恢复最多、消耗最少的一包）；一次只用一包 *@
                            var cands = e.RepairCandidates(s, rc);
                            var tgt = G.CraftTarget is int ct ? s.Items.FirstOrDefault(i => i.InstanceId == ct) : null;
                            @* B22b 试玩修复 M463：两张列表放进可滚动区，开工条留在卡底 *@
                            <div class="patch-scroll" data-wheel="y">
                            <div class="tiny muted">选择要修补的武器、工具或防具（本人随身、穿戴中或当前地面；有金属制作或拆解依据，枪械、锅、打火器不修）</div>
                            <div class="repair-list">
                                @foreach (var t in cands)
                                {
                                    var tid = t.InstanceId;
                                    var why = e.FieldPatchBlocked(s, tid, null, out _, out _, out _);
                                    <button type="button" class="repair-pick @(G.CraftTarget == tid ? "on" : "") @(why != null ? "missing" : "")" title="@(why ?? "选择这件")" @onclick="() => PickTarget(tid)">
                                        <span class="ir-icon">@Icons.Markup(t.ItemId)</span>
                                        <span><b>@e.ItemName(t.ItemId)（@e.QualityName(t)）</b><small>@e.WherePath(s, t) · 耐久@(GameEngine.DurabilityText(t))@(why != null ? $" · {why}" : "")</small></span>
                                    </button>
                                }
                                @if (cands.Count == 0) { <div class="risk none">随身、穿戴中和当前地面都没有可修补的武器、工具或防具。</div> }
                            </div>
                            @{ var packs = e.FieldPatchPacks(s); }
                            <div class="tiny muted">选择修补包（随身或当前地面；不选则默认用能恢复最多、消耗最少的一包）</div>
                            <div class="repair-list" data-patch-picks>
                                @foreach (var pk in packs)
                                {
                                    var pid = pk.InstanceId;
                                    var q = tgt != null ? e.FieldPatchQuote(tgt, pk) : (0, 0);
                                    var qText = tgt == null || q.Item1 < 1 ? "" : $" · 可恢复{Ui.T(q.Item1 / 10.0)}、包耐久−{q.Item2}";
                                    // B22b 试玩修复 M463：会超五卡/不够恢复的包事先标出；选了目标时置灰不可选
                                    var pnote = e.FieldPatchPackNote(s, pk, tgt);
                                    var pblock = pnote != null && tgt != null && G.CraftPatch != pid;
                                    <button type="button" class="repair-pick @(G.CraftPatch == pid ? "on" : "") @(pblock ? "missing" : pnote != null ? "warn" : "")" disabled="@pblock"
                                            title="@(pnote ?? (G.CraftPatch == pid ? "再点一次取消指定，改回默认" : "指定用这一包"))" @onclick="() => PickPatch(pid)">
                                        <span class="ir-icon">@Icons.Markup(pk.ItemId)</span>
                                        <span><b>@e.ItemName(pk.ItemId)@(pk.Count > 1 ? $"×{pk.Count}" : "")</b><small>@e.WherePath(s, pk) · 剩余@(e.PatchRemaining(pk))/@(e.PatchMax(pk))@qText@(pnote != null ? $" · {pnote}" : "")</small></span>
                                    </button>
                                }
                                @if (packs.Count == 0) { <div class="risk none">随身和当前地面都没有可用的野外修补包（工作台“远行基础做法”可做白/绿/蓝三品阶）。</div> }
                            </div>
                            </div>
                        }
                        else if (rc.IsRepair)
                        {
                            var cands = e.RepairCandidates(s, rc);
                            <div class="tiny muted">@(rc.RepairFilter != null ? "选择要小修的非枪金属武器或工具（随身、穿戴中或当前地面）；恢复其最大耐久的10%" : "选择要维护的工具或装备（随身、穿戴中或当前地面；锅须先取下并清空）")</div>
                            <div class="repair-list">
                                @foreach (var t in cands)
                                {
                                    var tid = t.InstanceId;
                                    var why = e.RepairBlocked(s, tid, out _, rc);
                                    <button type="button" class="repair-pick @(G.CraftTarget == tid ? "on" : "") @(why != null ? "missing" : "")" title="@(why ?? "选择这件工具")" @onclick="() => PickTarget(tid)">
                                        <span class="ir-icon">@Icons.Markup(t.ItemId)</span>
                                        <span><b>@e.ItemName(t.ItemId)</b><small>@e.WherePath(s, t) · 耐久@(GameEngine.DurabilityText(t))@(why != null ? $" · {why}" : "")</small></span>
                                    </button>
                                }
                                @if (cands.Count == 0) { <div class="risk none">@(rc.RepairFilter != null ? "随身、穿戴中和当前地面都没有可小修的非枪金属武器或工具。" : "随身、穿戴中和当前地面都没有带耐久的工具或装备。")</div> }
                            </div>
                        }
                        @if (rc.NeedsExplicitPot)
                        {
                            var pots = s.Items.Where(i => e.IsPot(i) && e.PlaceOf(s, i) is var pl && (pl == ItemInstance.Carried || pl == s.Ground)).ToList();
                            <div class="tiny muted">指定一口取下并清空的锅（不消耗；不会自动装锅或倒出原锅内容）</div>
                            <div class="repair-list">
                                @foreach (var pot in pots)
                                {
                                    var pid = pot.InstanceId;
                                    var why = e.ExplicitPotBlocked(s, pid, out _);
                                    <button type="button" class="repair-pick @(G.CraftPot == pid ? "on" : "") @(why != null ? "missing" : "")" title="@(why ?? "指定这口锅")" @onclick="() => PickPot(pid)">
                                        <span class="ir-icon">@Icons.Markup(pot.ItemId)</span>
                                        <span><b>@e.ItemName(pot.ItemId)</b><small>@e.WherePath(s, pot) · @e.PotLabel(s, pot)@(why != null ? $" · {why}" : "")</small></span>
                                    </button>
                                }
                                @if (pots.Count == 0) { <div class="risk none">随身和当前地面没有锅。</div> }
                            </div>
                        }
                        @if (stationRecipe)
                        {
                            @* B32e（Q380，S08「2026-11-10 Q380」）：陶窑/固定净水台的数量字段是「投料批数」，默认1；上限 = min(10−未完成批数, 材料与燃料够的完整批数)。
                               上限变小使所选批数无效时不自动缩批，原因写在下方投料按钮旁，由玩家重选 *@
                            var stMax = e.StationBatchMaxNew(s, rc);
                            <div class="batch-row" data-station-batches>
                                <span class="tiny muted">投料批数</span>
                                <button type="button" class="tbar-step" aria-label="减少批数" disabled="@(batch <= 1)" @onclick="() => SetBatch(batch - 1)">−</button>
                                <b>@batch</b>
                                <button type="button" class="tbar-step" aria-label="增加批数" disabled="@(batch >= stMax)" @onclick="() => SetBatch(batch + 1)">+</button>
                            </div>
                        }
                        else if (batchable)
                        {
                            var enough = rc.AllInputs.Count == 0 ? 1 : rc.AllInputs.Min(kv => e.AvailableCount(s, kv.Key, true) / Math.Max(1, kv.Value));
                            var maxBatch = Math.Max(1, enough);
                            @* Q112（S08/S14 本轮章）：数量是“配方份数”（执行一次配方的输入→输出），不是成品件数；钢材一份产2件 *@
                            <div class="batch-row">
                                <span class="tiny muted" title="N是配方执行份数，不是成品件数；同批次合并工作量">配方份数</span>
                                <button type="button" class="tbar-step" aria-label="减少份数" disabled="@(batch <= 1)" @onclick="() => SetBatch(batch - 1)">−</button>
                                <b>@batch</b>
                                <button type="button" class="tbar-step" aria-label="增加份数" disabled="@(batch >= maxBatch)" @onclick="() => SetBatch(batch + 1)">+</button>
                                <span class="tiny @(enough == 0 ? "warn-text" : "muted")" title="同批次合并工作量，高熟练度一段可做多份">@(enough == 0 ? "材料不足，一份也不够" : $"执行{batch}份 · 材料最多够{enough}份")</span>
                            </div>
                        }
                        @if (rc.IsFixedWait)
                        {
                            @* B16 试玩修复 M351：固定等待（净水片/滤芯处理脏水）每次一批 2L，份数锁在 1 *@
                            <div class="batch-row" title="固定等待的处理每次只做1批（一次2L）">
                                <span class="tiny muted">配方份数</span>
                                <button type="button" class="tbar-step" aria-label="减少份数" disabled>−</button>
                                <b>1</b>
                                <button type="button" class="tbar-step" aria-label="增加份数" disabled>+</button>
                                <span class="tiny muted">固定等待每次只做1批</span>
                            </div>
                        }
                        @if (rc.IsDrying)
                        {
                            @* B22c 试玩修复 M470：晾制每位一批，份数不可调；在晾制架面板选位投料 *@
                            <div class="batch-row" title="晾制每位一批，共@(e.DryingSlotCount)位；在晾制架面板选空位投料">
                                <span class="tiny muted">每位一批 · 共@(e.DryingSlotCount)位（在晾制架面板选位）</span>
                            </div>
                        }
                        @if (rc.Fuel.Count > 0)
                        {
                            @* Q112：锻炉每份配方另需木炭1；分列份数/成品/原料炭/燃料炭/总炭，原料与燃料按同一库存合计校验 *@
                            <div class="forge-fuel" data-forge-fuel>
                                @* Q398：陶窑／固定净水台写「批数」（等于投料批数），锻炉仍写「份数」 *@
                                <span>@(stationRecipe ? "批数" : "份数")<b>@batch</b></span>
                                <span>成品<b>@string.Join("、", rc.Outputs.Select(o => $"{e.ItemName(o.Key)}{o.Value * batch}"))</b></span>
                                @foreach (var fid in rc.Fuel.Keys)
                                {
                                    var (fing, ffuel, ftotal) = GameEngine.RecipeItemSplit(rc, fid, batch);
                                    var fhave = e.AvailableCount(s, fid, true);
                                    var fn = fid == "charcoal" ? "炭" : e.ItemName(fid);
                                    <span>原料@(fn)<b>@fing</b></span>
                                    <span>燃料@(fn)<b>@ffuel</b></span>
                                    <span>总@(fn)<b>@ftotal</b></span>
                                    <span class="@(fhave < ftotal ? "warn-text" : "muted")">现有@(fhave)@(fhave < ftotal ? $" · 缺少{ftotal - fhave}" : "")</span>
                                }
                                <span class="muted">@e.RecipeFuelRule(rc)</span>
                            </div>
                        }
                        <div class="mat-scroll @(rc.AllInputs.Count == 0 && rc.Outputs.Count == 0 && rc.Catalysts.Count == 0 ? "mat-empty" : "")" data-wheel="y">
                        @* B32e 试玩修复 M680：队列区放进原料滚动区顶部（原在滚动区外，1280×720 下把投料条挤出卡底被裁），投料条固定在卡底始终可见 *@
                            @if (sb != null || sbWait.Count > 0)
                            {
                                <div class="station-queue" data-station-queue>
                                    @if (sb != null)
                                    {
                                        var curId = sb.BatchId;
                                        <div class="sq-row">
                                            <span class="cg-facts"><b>加工中</b><small class="cg-xp" title="@e.StationBatchXpNote(s, sb)">@e.StationBatchXpNote(s, sb)</small><small class="cg-sum" title="@($"{sb.DoneMinutes}/{sb.RequiredMinutes}分钟 · 完成后放在{e.ZoneName(s, s.Ground)}地面")">@(sb.DoneMinutes)/@(sb.RequiredMinutes)分钟 · 完成后放在@(e.ZoneName(s, s.Ground))地面</small></span>
                                            <button type="button" class="secondary cg-start" data-station-cancel title="只取消实际加工中的一批，释放该批全部未核销材料和燃料到本区地面，不退时间，没有产物和经验" disabled="@StationHeld" @onclick="(MouseEventArgs ev) => CancelStation(rc.Station, curId, ev)">取消当前批</button>
                                        </div>
                                    }
                                    @if (sbWait.Count > 0)
                                    {
                                        var waitIds = sbWait.Select(w => w.BatchId).ToList();
                                        <div class="sq-row">
                                            <span class="cg-facts"><b>排队中@(sbWait.Count)批</b>
                                                <ol class="sq-list">@foreach (var w in sbWait) { <li>@e.Recipe(w.RecipeId).Name</li> }</ol>
                                            </span>
                                            <button type="button" class="secondary cg-start" data-station-cancel-queue title="一次取消所有尚未开始的批，释放这些批的预留到本区地面，当前批继续" disabled="@StationHeld" @onclick="(MouseEventArgs ev) => CancelStationQueue(rc.Station, waitIds, ev)">取消排队（@(sbWait.Count)批）</button>
                                        </div>
                                    }
                                </div>
                            }
                        <div class="tiny muted">原料@(rc.Fuel.Count > 0 ? "与燃料" : "")</div>
                        <div class="mat-grid">
                        @foreach (var kv in rc.Fuel)
                        {
                            @* Q112（A05/A07/S08 本轮章）：锻炉每份配方另需木炭1作燃料（N份扣N），与原料一起预留、完成一次核销；原料里也有木炭时合计校验 *@
                            @* B32g（S08 Q400）：陶窑／固定净水台燃料行计算部分写「每批{单批燃料数量}×{投料批数}批」，锻炉仍「每份配方{n}×{份数}份」 *@
                            var fneed = kv.Value * batch;
                            var fall = rc.AllInputs[kv.Key] * batch;
                            var fhave = e.AvailableCount(s, kv.Key, true);
                            <ItemRow Icon="@kv.Key" Name="@e.ItemName(kv.Key)" Qty="@($"燃料{fneed}")" Missing="@(fhave < fall)" CssClass="mat-row"
                                     Status="@($"{(stationRecipe ? $"每批{kv.Value}×{batch}批" : $"每份配方{kv.Value}×{batch}份")} · 现有{fhave}{(fall != fneed ? $"（连同原料共需{fall}）" : "")}{(fhave < fall ? $" · 缺少{fall - fhave}" : "")}")" />
                        }
                        @foreach (var kv in rc.Inputs)
                        {
                            var item = kv.Key;
                            var need = kv.Value * batch;
                            var have = e.AvailableCount(s, item, true);
                            var carried = e.UsableBatches(s, item, false).Sum(i => i.Count);
                            var reserved = s.Items.Where(i => i.ItemId == item && i.ReservedBy != null && (i.IsCarried || i.Owner == s.Ground)).Sum(i => i.Count);
                            var plan = Fill(item, need, preferred);
                            var lack = Math.Max(0, need - have);
                            <ItemRow Icon="@item" Name="@e.ItemName(item)" Qty="@($"需{need}")" Missing="@(lack > 0)" CssClass="mat-row"
                                     Status="@($"现有{have}（随身{carried}／地面{have - carried}）{(reserved > 0 ? $" · 预留{reserved}" : "")}{(lack > 0 ? $" · 缺少{lack}" : "")}")"
                                     DataDrop="@($"slot:{recipeId}:{item}")" Title="把具体批次的卡拖到这里指定使用">
                                @if (lack > 0)
                                {
                                    @* B23（A10 §4）：缺料→查看来源（只读地图定位，关掉地图回这里并恢复选择） *@
                                    <button type="button" class="linkish src-btn" data-source-item="@item" title="在地图上查看@(e.ItemName(item))的已知来源（只读，不移动；关掉地图回到这里）" @onclick="() => G.OpenSources(item)">查看来源</button>
                                }
                                <span class="slot-batches">
                                    @foreach (var (b, n) in plan)
                                    {
                                        var bid = b.InstanceId;
                                        var pinned = preferred.Contains(bid);
                                        <button type="button" class="batch-chip @(pinned ? "on" : "")" title="@(pinned ? "已手工指定，点击取消" : "点击固定使用这一批")" @onclick="() => TogglePreferred(bid)">
                                            @BatchText(b, n, pinned)
                                        </button>
                                    }
                                </span>
                            </ItemRow>
                        }
                        </div>
                        @foreach (var tag in rc.Catalysts)
                        {
                            var cfg = e.Config.Items.First(i => i.ToolTag == tag);
                            var tool = e.AccessibleTool(s, tag);
                            <ItemRow Icon="@cfg.Id" Name="@(tool == null ? cfg.Name : $"{cfg.Name}")" Qty="催化工具" Missing="@(tool == null)"
                                     Status="@(tool == null ? "缺少：需随身或在当前地面" : $"{(tool.IsCarried ? "随身" : "地面")} · 不消耗")" />
                        }
                        <div class="tiny muted" style="margin-top:8px">产物</div>
                        @if (rc.FacilityResult != null)
                        {
                            <ItemRow Icon="@RecipeIcon(rc)" Name="@rc.Name.Replace("建", "").Replace("铺", "")" Qty="×1" Status="@($"建在{e.ZoneName(s, s.Ground)}，不可搬动{(rc.Group == "workshop" ? "，每区每类一座" : GameEngine.IsWildFireRecipe(rc) ? "、不能拾取或拆除，每区只能有一处火源" : "")}")" />
                        }
                        @foreach (var kv in rc.Outputs)
                        {
                            <ItemRow Icon="@kv.Key" Name="@e.ItemName(kv.Key)" Qty="@($"×{kv.Value * batch}")" Status="@(rc.IsDrying ? "完成后留在晾制位占位，回到晾制架所在地取出" : $"完成后放在{e.ZoneName(s, s.Ground)}地面")" />
                        }
                        </div>
                        @* 唯一“开始制作/开始建造”入口在所选配方卡内（S08 §5、S14 §14.1）：选配方、改份数、指定批次/锅只预览，不扣物不预留；
                           点开始才交内核按真实材料/工具/锅/占用重验并预留开工（E.Start），执行中锁住按钮，重复点击不重复制作。右栏只作可选详细预测。 *@
                        @if (rc.IsDrying)
                        {
                            @* B22c（Q170）：晾制在设施栏“晾制架”卡的面板里选空位投料（0 分钟，被动晾制），这里只说明并跳转 *@
                            var dryHere = e.DryingRackHere(s);
                            var dryWhy = busy ? "行动进行中" : e.DryingBlocked(s, rc);
                            <div class="craft-go">
                                <span class="cg-facts">
                                    <b>被动@(Clock.Duration(rc.BaseMinutes))</b><small class="cg-xp">@e.DryingXpPreview(s, rc)</small>
                                    <small class="cg-sum" title="@e.RecipeModeText(rc)">@(dryWhy ?? $"在晾制架面板选空位投料：{e.DryingSummary(s)}")</small>
                                </span>
                                <button type="button" class="primary cg-start" disabled="@(!dryHere)" title="@(dryHere ? "打开晾制架面板，选食谱与空位，预览后确认投料" : $"{e.ZoneName(s, s.Ground)}没有晾制架（在“营地建造”里建）")"
                                        @onclick='() => G.OpenPanel("drying")'>打开晾制架</button>
                            </div>
                        }
                        else if (e.IsStationBatchRecipe(rc))
                        {
                            @* B17（A07 X1.4）：陶窑/固定净水台是被动批次：投料0分钟、不占行动，原料移到本区地面锁定，离开也继续。
                               B32e（Q380）：每座一个加工位＋等待队列（含加工中最多10批）；面板分列「加工中」「排队中{批数}批」（等待批按先后列配方），
                               「取消当前批」「取消排队（{批数}批）」各自绑定所见批次/等待名单，投料按钮「投料（{批数}批）」可在加工中继续加入队尾 *@
                            var sbWhy = busy ? "行动进行中" : e.StationBatchBlocked(s, rc, batch);
                            var loadKey = $"station-load:{s.Ground}:{rc.Station}:{s.NextActionId}:{batch}";
                            <div class="craft-go" data-station-go>
                                <span class="cg-facts">
                                    @if (sbWhy == null)
                                    {
                                        @* B22d 试玩修复 M418：经验句放在说明前面单独一行，窄屏（≤1400）时说明压成一行省略、悬停看全文，经验句不被裁掉。
                                           B32e：经验按队列与预计完成日分日写；各新批预计完成时刻 = 当前时刻 + 加工中剩余 + 前面等待批 + 自身时长 *@
                                        var etas = e.StationEtaText(s, rc, batch);   // Q399
                                        <b>被动@(rc.BaseMinutes)分钟</b><small class="cg-xp" title="@e.StationBatchXpPreview(s, rc, batch)">@e.StationBatchXpPreview(s, rc, batch)</small><small class="cg-sum cg-eta" title="@etas" data-station-eta>@etas</small><small class="cg-sum" title="@e.StationBatchSummary(rc)">@e.StationBatchSummary(rc)</small>
                                    }
                                    else { <small class="warn-text">@sbWhy</small> }
                                </span>
                                <button type="button" class="primary cg-start" disabled="@(sbWhy != null || StationHeld)" title="@(sbWhy ?? e.StationBatchSummary(rc) + "；" + e.StationBatchXpPreview(s, rc, batch))"
                                        @onclick="(MouseEventArgs ev) => LoadStation(rc.Id, batch, loadKey, ev)">投料（@(batch)批）</button>
                            </div>
                        }
                        else
                        {
                            var p = G.Preview(request);
                            var startBusy = busy || (main != null && !p.AsSubAction) || _starting;
                            <div class="craft-go">
                                <span class="cg-facts">
                                    @if (p.Ok)
                                    {
                                        <b>@Clock.Duration(p.EstimatedMinutes)</b><small>预计@(Clock.HHmm(p.EstimatedEndMinute))完成@(p.Warnings.Count > 0 ? " · " + p.Warnings[0] : "")</small>
                                    }
                                    else
                                    {
                                        <small class="warn-text">@p.Reason</small>
                                    }
                                </span>
                                <button type="button" class="primary cg-start" disabled="@(!p.Ok || startBusy)" title="@(p.Ok ? "确认后才预留材料并推进游戏时间" : p.Reason)"
                                        @onclick="() => Start(request)">@(p.Ok ? p.ConfirmText : StartLabel(rc))</button>
                            </div>
                        }
                    </div>
                }
                @* B10 试玩修复 7：火堆摘要只在“自动加工”里显示，让出配方卡的原料区 *@
                @if (e.HasFireAt(s, s.Ground) && proc != null)
                {
                    var used = e.FireContents(s, s.Ground).Count;
                    <div class="panel fire-box">
                        <ItemRow Icon="@(fac.FireLit ? "fire_lit" : "fire_out")" Name="营地火堆" Qty="@(fac.FireLit ? "燃烧中" : fac.WentOut ? "熄灭" : "未点燃")"
                                 Status="@($"燃料{fac.FuelMinutes}/{e.FuelCapOf(fac)}分钟 · 内容物{used}/{e.Config.Fire.ProcessingSlots}")">
                            <button class="secondary" @onclick="G.SelectFire">查看火堆 ▸</button>
                        </ItemRow>
                    </div>
                }
            </div>
        </div>
    </div>
}
else if (proc != null)
{
    <div class="detail-scroll">
        <div class="op-head"><div class="eyebrow">处理说明 · 自动加工</div><h2>@ProcTitle(proc)</h2><p>@ProcHint(proc)</p></div>
        <div class="lines">
            <div><span>有效受热</span><b>@(proc.HeatMinutes)分钟</b></div>
            <div><span>占用角色</span><b>不占用</b></div>
            @if (proc.WaterCostMl > 0) { <div><span>耗水</span><b>每份@(e.ItemName(proc.RequiredLiquid ?? ""))@(proc.WaterCostMl)毫升</b></div> }
            <div><span>成品留在</span><b>@(proc.IsPotBatch ? "原锅" : proc.InPot ? "原锅食材位" : proc.IsSlotBatch ? "原火堆加工位（取出才进包）" : "原火堆加工位")</b></div>
            @if (proc.IsSlotBatch)
            {
                <div><span>每批</span><b>@(e.ItemName(proc.InputId))×@(proc.InputCount) → @(e.ItemName(proc.OutputId))×@(proc.OutputCount)，占1个加工位</b></div>
                <div><span>燃料</span><b>火堆燃料另计，两批并行不倍扣</b></div>
                <div><span>经验</span><b>不给经验</b></div>
            }
        </div>
        @if (!proc.IsPotBatch)
        {
            // B10b 试玩修复：木炭等没有使用效果、不会腐败的产物不再按食物写（原来对 Use 为空的产物会崩）
            var o = e.Item(proc.OutputId);
            var use = o.Use != null ? GameEngine.UseEffectText(o.Use) : o.Kind == "material" ? "材料" : o.Name;
            var shelf = o.ShelfLifeMinutes is int sl ? $"保质{sl / 60}小时" : "不会腐败";
            <ItemRow Icon="@o.Id" Name="@o.Name" Qty="@($"×{proc.OutputCount}")" Status="@($"{use} · {shelf}")" />
        }
    </div>
    <div class="detail-foot">
        @if (!peekOn) { <button class="primary" disabled="@(!G.E.HasFireAt(G.S, G.S.Ground))" @onclick="G.SelectFire">查看火堆 ▸</button> }
        <div class="under">@(proc.IsSlotBatch ? "没有开始按钮：在火堆卡空加工位点“煅烧木炭”投料" : "没有开始按钮：放进燃烧的火堆即自动加工")</div>
    </div>
}
else
{
    <PreviewView Request="request" Eyebrow="@($"手工制作 · {(rc.IsBuild ? "营地设施" : "配方")}")" Title="@rc.Name" Subtitle="@RecipeHint(rc)"
                 Confirmable="false" FootNote="@(rc.IsDrying ? "晾制在设施栏“晾制架”卡的面板里选空位投料；0分钟投料、不占行动，离开也继续" : e.IsStationBatchRecipe(rc) ? $"在中间配方卡下方点“投料（{batch}批）”；被动加工0分钟投料、不占行动，离开也继续" : $"在中间配方卡下方点“{StartLabel(rc)}”；时间为预计值")" />
}

@code {
    [Parameter] public string Part { get; set; } = "center";
    /// <summary>B42：右栏悬停查看的配方或处理说明（"proc:" 前缀），只读；null 读当前所选。</summary>
    [Parameter] public string? PeekRecipe { get; set; }

    /// <summary>处理说明条目在 CraftRecipe 里的前缀，避免与配方 ID 混淆。</summary>
    public const string ProcPrefix = "proc:";

    private string RecipeHint(RecipeConfig r)
    {
        var c = G.E.Config;
        string Range(string id) => c.Items.FirstOrDefault(i => i.Id == id)?.DurabilityMaxRange is double[] d ? $"最大耐久{Ui.T(d[0])}—{Ui.T(d[1])}（每件随机）" : "";
        var sh = c.HourlyRates["sleep_sheltered"];
        return r.Id switch
        {
            "knife" => $"纤维采集耗时从20分钟降到10分钟；也是刀剑类武器（练刀剑熟练度）。{Range("stone_knife")}。",
            "axe" => $"木材采集每次产出翻倍；也是斧类武器（练斧熟练度）。{Range("hatchet")}。",
            "bandage" => $"止血；健康+1×(1+0.02×医疗等级)，{c.ItemActions.BandageCooldownMinutes}分钟冷却；已感染时还能压低病毒。",
            "shelter" => $"营地可遮蔽睡眠（清醒{Ui.SignedT(sh.Wakefulness)}、体力{Ui.SignedT(sh.Energy)}、精神{Ui.SignedT(sh.Morale)}/小时），休息额外恢复精神。",
            "bed" => $"营地睡眠体力每小时额外{Ui.SignedT(c.FacilityEffects.BedExtraSleepEnergyPerHour)}。需要先建成遮蔽棚。",
            "repair_selected_tool" => $"选定一件随身、穿戴中或当前地面的工具或装备，恢复它自身最大耐久的{Ui.Pct(G.E.RepairFraction(G.S, r))}{(G.E.RepairFraction(G.S, r) > r.RestoreOwnDurabilityMaxFraction + 1e-9 ? "（穿着维护手册，替代" + Ui.Pct(r.RestoreOwnDurabilityMaxFraction) + "）" : "")}，不超过上限、不重抽最大耐久，品质与词条不变；满耐久不能维护。",
            "field_patch_repair" => "战外安全空闲时手工修补一件有金属制作或拆解依据的武器、工具或防具（枪械、锅、打火器不修），一次只用一包野外修补包。" +
                                    "每包耐久100：同品阶从零修满耗20，包品阶每高一阶耗量减半、每低一阶翻倍，且低阶包修高阶装备单次最多恢复50%（差一阶）/25%（差两阶）；缺损小只耗对应耐久（最少1）。" +
                                    "不吃维修效果加成，不改品质、词条与最大耐久；用过的包单独占一张卡，用完销毁；取消不消耗。成功给制造经验2。",
            "make_wooden_spear" => $"矛类武器，可打敌方1—3号位。{Range("wooden_spear")}。",
            "make_wooden_bow" => $"弓弩类武器，可打敌方1—4号位；每射直接消耗随身箭矢1。{Range("wooden_bow")}。",
            "make_arrows" => "木弓的箭矢，首版不回收。",
            "wild_fixed_fire" => $"在普通野外的外部区建一处固定火堆（地牢、城市与势力公共地、任务保留地不行；不要求登记、安全屋或探索100%）。材料取随身与当前地面；" +
                                 $"建成初始熄灭、燃料0、没有锅，点火{c.Fire.IgniteMinutes}分钟、木材每份{c.Fire.BurnMinutesPerWood}分钟、燃料上限{c.Fire.MaxFuelMinutes}分钟、{c.Fire.ProcessingSlots}个加工位最多{c.Fire.MaxPots}口锅。" +
                                 "每区只能有一处火源：已有火堆或部署着折叠柴炉都不能建。不能拾取或拆除，不挡遭遇。",
            "make_antiviral_cure" => "立即清除病毒感染。需医疗≥15、制造≥12，在营地制作，并指定一口取下并清空的锅（不消耗）；净水作为原料直接消耗，不自动装锅。",
            _ => "",
        };
    }

    private string ProcTitle(ProcessConfig p) => p.IsPotBatch ? "烧水" : p.IsSlotBatch ? $"{p.Name}{G.E.ItemName(p.OutputId)}" : $"{p.Name}{G.E.ItemName(p.InputId).Replace("生", "")}";

    private string ProcHint(ProcessConfig p)
    {
        var e = G.E;
        if (p.IsSlotBatch)
            return $"在火堆卡空加工位点“煅烧木炭”投料：每批{e.ItemName(p.InputId)}×{p.InputCount}占1个加工位，{p.HeatMinutes}有效受热分钟后原位变成{e.ItemName(p.OutputId)}×{p.OutputCount}。"
                   + $"火堆燃料另计（两批并行不倍扣，点火那5分钟不计热）；把{e.ItemName(p.InputId)}拖到火堆是添加燃料，不是煅烧。不给经验。";
        return (p.IsPotBatch ? "boil_water" : p.InPot ? "boil_root" : "roast_root") switch
        {
            "boil_water" => $"装了{e.ItemName(p.InputId)}的金属锅放进燃烧的火堆，0.5升或1升都是{p.HeatMinutes}分钟原地烧成{e.ItemName(p.OutputId)}；不自动补水。",
            "roast_root" => $"{e.ItemName(p.InputId)}直接放进燃烧火堆的空加工位，每份{p.HeatMinutes}分钟烤成{e.ItemName(p.OutputId)}，不需要锅和水。",
            "boil_root" => $"{e.ItemName(p.InputId)}放进有{e.ItemName(p.RequiredLiquid ?? "")}的锅、锅放进燃烧的火堆，每份{p.HeatMinutes}分钟煮成{e.ItemName(p.OutputId)}，完成时扣{p.WaterCostMl}毫升；空锅只存放不加工。",
            _ => "",
        };
    }

    /// <summary>图示步骤：每步一行“图标+名称+说明”。</summary>
    private List<(string icon, string name, string note)> Steps(ProcessConfig p)
    {
        var e = G.E;
        var heat = $"受热{p.HeatMinutes}分钟";
        if (p.IsSlotBatch)
            return new()
            {
                (p.InputId, e.ItemName(p.InputId), $"1. 随身或当前地面备好{e.ItemName(p.InputId)}×{p.InputCount}（拖到火堆是加燃料）"),
                ("slot_empty", "空加工位", $"2. 点火堆卡空加工位里的“煅烧木炭”，确认投料（占1位，不耗时）"),
                ("fire_lit", "燃烧的火堆", $"3. 点火并保持燃料，{p.HeatMinutes}有效受热分钟；燃料另计，熄火保留进度"),
                (p.OutputId, e.ItemName(p.OutputId), $"4. 原位变成{e.ItemName(p.OutputId)}×{p.OutputCount}，取出才进包；不给经验"),
            };
        return (p.IsPotBatch ? "boil_water" : p.InPot ? "boil_root" : "roast_root") switch
        {
            "boil_water" => new()
            {
                (p.InputId, e.ItemName(p.InputId), "1. 把水卡拖到锅的水量条，每份500毫升"),
                ("pot", "金属锅", "2. 把锅拖到火堆的空加工位"),
                ("fire_lit", "燃烧的火堆", $"3. 点火并保持燃料，{heat}"),
                (p.OutputId, e.ItemName(p.OutputId), "4. 留在原锅，可饮用或倒出"),
            },
            "roast_root" => new()
            {
                (p.InputId, e.ItemName(p.InputId), "1. 拖到火堆的空加工位（每份占1位）"),
                ("fire_lit", "燃烧的火堆", $"2. {heat}，熄火保留进度"),
                (p.OutputId, e.ItemName(p.OutputId), "3. 留在加工位，取出后食用"),
            },
            _ => new()
            {
                (p.RequiredLiquid ?? "clean_water", e.ItemName(p.RequiredLiquid ?? "clean_water"), $"1. 锅里装净水，每份食材预留{p.WaterCostMl}毫升"),
                (p.InputId, e.ItemName(p.InputId), "2. 拖到锅的食材区（最多2份）"),
                ("pot", "金属锅", "3. 锅放进火堆的空加工位"),
                ("fire_lit", "燃烧的火堆", $"4. {heat}，完成时扣水"),
                (p.OutputId, e.ItemName(p.OutputId), "5. 留在原锅食材位"),
            },
        };
    }

    private bool _starting;

    private const string AutoTab = "auto";
    private const string CampTab = "camp";

    /// <summary>分类标签：六类工坊（含手工）、营地建造（棚/床/五类工坊）、火堆自动加工。</summary>
    private IEnumerable<(string id, string name)> Tabs()
    {
        foreach (var st in G.E.Config.Workshops.Stations) yield return (st.Id, st.Name);
        yield return (CampTab, "营地建造");
        yield return (AutoTab, "自动加工");
    }

    private static string TabOf(RecipeConfig r) => r.IsBuild ? CampTab : r.Station;

    /// <summary>工坊标签后缀：本地可建写“·未建”；本地有公共站但没开放写“·未开放”（B14b，Q141）；不能建的地点写“·营地已建”或“·本地无”（B10 试玩修复 9）。</summary>
    private string TabSuffix(string station)
    {
        var e = G.E;
        var here = G.S.CurrentLocation;
        if (e.CanBuildWorkshopsHere(G.S)) return "·未建";
        if (e.PublicStationsAt(here).Any(p => p.StationId == station)) return "·未开放";
        var camp = e.Config.Workshops.BuildLocations.FirstOrDefault();
        return camp != null && e.WorkshopBuilt(G.S, camp, station) ? "·营地已建" : "·本地无";
    }

    private void PickTab(string t)
    {
        G.CraftTab = t;
        if (t == AutoTab) { Pick(ProcPrefix + G.E.Config.Processes[0].Id, true); return; }
        var first = G.E.Config.Recipes.Where(r => !r.IsSalvage && TabOf(r) == t).OrderBy(r => G.E.RecipeLocks(G.S, r).Count > 0 ? 1 : 0).FirstOrDefault();
        if (first != null) Pick(first.Id, true);
        G.Notify();
    }

    private string RecipeIcon(RecipeConfig r) => r.FacilityResult switch
    {
        "shelterBuilt" => "shelter",
        "bedBuilt" => "bed",
        "workshop:workbench" => "parts",
        "workshop:forge" => "fire_lit",
        "workshop:sewing" => "cloth",
        "workshop:medical" => "bandage",
        "workshop:armory" => "crossbow",
        "workshop:kiln" => "ceramic_shell",
        "workshop:water_station" => "clean_water",
        "workshop:drying_rack" => "dried_meat",
        "safehouse" => "shelter",
        "fireBuilt" => "fire_out",
        _ => r.IsRepair ? "repair" : r.Outputs.Keys.FirstOrDefault() ?? "stone",
    };

    /// <summary>配方短元信息：基础分钟 · 门槛等级（按配方的技能门槛，医疗台加工读医疗）。</summary>
    private string RecipeMeta(RecipeConfig r)
    {
        var lv = r.MinSkills.Count == 0 ? "" : " · " + string.Join("、", r.MinSkills.Select(kv => $"{G.E.SkillName(kv.Key)}{kv.Value}级"));
        return $"{r.BaseMinutes}分钟{lv}{(r.IsBuild ? (GameEngine.IsWildFireRecipe(r) ? " · 普通野外" : " · 营地") : "")}";
    }

    /// <summary>配方需要的知识与来源（A05 §3 默认知识/蓝图）。</summary>
    private string? SourceText(RecipeConfig r)
    {
        var e = G.E;
        if (r.Knowledge != null && e.Config.Knowledge.FirstOrDefault(k => k.Id == r.Knowledge) is { } k)
            return $"{k.Name}（{(e.KnowsKnowledge(G.S, k.Id) ? "已掌握" : "未掌握")}）· {k.Source}";
        return null;
    }

    // B32e（Q380）：提交绑定所见的加工中批/等待名单，变了由内核回「队列已变化，请重新选择。」并刷新；请求号由渲染时所见状态决定。
    // B32e 试玩修复 M680：连点「取消当前批」时第一下刷新出新的当前批，第二下落在新按钮上按新批号提交、连取消两批。
    // 现在：同一次连击的后续点击（MouseEventArgs.Detail > 1）不提交；任一队列提交成功后三个按钮停用 StationHoldMs 再随重渲恢复。
    private const int StationHoldMs = 600;
    private DateTime _stationHoldUntil = DateTime.MinValue;
    private bool StationHeld => DateTime.UtcNow < _stationHoldUntil;

    /// <summary>这一下点击该不该提交：连击的第二下起、或刚提交过还在停用期内，都不提交。</summary>
    private bool StationClickAccepted(MouseEventArgs ev) => ev.Detail <= 1 && !StationHeld;

    private void HoldStation(ActionResult res)
    {
        if (!res.Ok) return;
        _stationHoldUntil = DateTime.UtcNow.AddMilliseconds(StationHoldMs);
        _ = ReleaseStationHold();
    }

    private async Task ReleaseStationHold()
    {
        await Task.Delay(StationHoldMs + 50);
        await InvokeAsync(StateHasChanged);
    }

    private void CancelStation(string stationId, int batchId, MouseEventArgs ev)
    {
        if (!StationClickAccepted(ev)) return;
        HoldStation(G.EngineDo(() => G.E.CancelStationBatch(G.S, stationId, batchId, $"station-cancel:{batchId}")));
    }

    private void CancelStationQueue(string stationId, List<int> waitIds, MouseEventArgs ev)
    {
        if (!StationClickAccepted(ev)) return;
        HoldStation(G.EngineDo(() => G.E.CancelStationQueue(G.S, stationId, waitIds, $"station-cancel-queue:{string.Join(",", waitIds)}")));
    }

    /// <summary>投料：所选批数整次提交，成功后批数回到默认 1（失败保留所选，不自动缩批）。</summary>
    private void LoadStation(string recipeId, int batches, string requestKey, MouseEventArgs ev)
    {
        if (!StationClickAccepted(ev)) return;
        var res = G.EngineDo(() => G.E.StartStationBatch(G.S, recipeId, requestKey, batches));
        HoldStation(res);
        if (res.Ok && !res.Duplicate) SetBatch(1);
    }

    private static string StartLabel(RecipeConfig r) => r.IsBuild ? "开始建造" : GameEngine.IsFieldPatchRecipe(r) ? "开始修补" : r.IsRepair ? "开始维护" : "开始制作";

    /// <summary>开始制作/建造/维护：内核再校验并预留；开始成功后保持面板（与原右栏确认一致），中央推进条接管进度与退出。</summary>
    private async Task Start(ActionRequest request)
    {
        if (_starting) return;
        _starting = true;
        try { await G.StartAction(request); }
        finally { _starting = false; }
    }

    private void Pick(string id) => Pick(id, false);

    private void Pick(string id, bool keepTab)
    {
        G.PeekClear();   // B42：明确点选结束悬停查看
        if (!keepTab && !id.StartsWith(ProcPrefix)) G.CraftTab = null;
        if (G.CraftRecipe != id)
        {
            G.CraftBatch = 1;
            G.CraftTarget = null;
            G.CraftPot = null;
        }
        G.CraftRecipe = id;
        // B13d（Q128）：选中一件配方/自动加工的预览即操作前引导的上下文（制作提交前）
        if (id.StartsWith(ProcPrefix)) G.Guide("process", id.Substring(ProcPrefix.Length));
        else G.Guide("recipe", id);
        G.Notify();
    }

    private void PickPot(int id)
    {
        G.CraftPot = G.CraftPot == id ? null : id;
        G.Notify();
    }

    private void PickPatch(int id)
    {
        G.CraftPatch = G.CraftPatch == id ? null : id;
        G.Notify();
    }

    private void PickTarget(int id)
    {
        G.CraftTarget = G.CraftTarget == id ? null : id;
        G.Notify();
    }

    private void SetBatch(int n)
    {
        G.CraftBatch = Math.Max(1, n);
        G.Notify();
    }

    private void ShowAll()
    {
        G.CraftCandidates = null;
        G.Notify();
    }

    private void TogglePreferred(int id)
    {
        if (!G.CraftPreferred.Remove(id)) G.CraftPreferred.Add(id);
        G.Notify();
    }

    private string BatchText(ItemInstance b, int n, bool pinned)
    {
        var where = b.IsCarried ? "随身" : "地面";
        var fresh = b.ExpiresAt.HasValue ? " · " + Ui.Fresh(b.ExpiresAt.Value - G.S.GameMinute) : "";
        return $"{where}×{n}{fresh}{(pinned ? " · 指定" : "")}";
    }

    /// <summary>材料槽将用到的批次：手工指定的在前，其余按最早到期、随身优先、实例 ID 自动补齐。</summary>
    private List<(ItemInstance inst, int n)> Fill(string itemId, int need, List<int> preferred)
    {
        var list = G.E.UsableBatches(G.S, itemId, true)
            .OrderBy(b => preferred.Contains(b.InstanceId) ? preferred.IndexOf(b.InstanceId) : int.MaxValue).ToList();
        var res = new List<(ItemInstance, int)>();
        foreach (var b in list)
        {
            if (need <= 0) break;
            var n = Math.Min(need, b.Count);
            res.Add((b, n));
            need -= n;
        }
        return res;
    }

    private void Close() => G.OpenPanel(null);
}
