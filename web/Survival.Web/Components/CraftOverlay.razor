@inherits GameComponent

@* 手工制作。Part="center"：中部的配方列表、材料与配方卡内唯一的“开始制作/开始建造”（S08 §5、S14 §14.1）；Part="detail"：右栏的详细预估（只读）。
   v0.4（统一卡片案第 6 节）：材料、产物、催化工具都是 图标+名称+数量/状态 的行，缺料整行标出；
   烧水、烤制、水煮改为火堆自动加工，这里只保留三条“处理说明”（图示步骤 + 查看火堆），不再有占用角色时间的开始按钮。
   火堆的投料、点火在地块栏第二行的火堆卡上（v0.7 起锅与食材直接嵌在火堆卡内）。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var lc = e.Location(here);
    var fac = s.Locations[here].Facility;
    var procId = G.CraftRecipe != null && G.CraftRecipe.StartsWith(ProcPrefix) ? G.CraftRecipe.Substring(ProcPrefix.Length) : null;
    var proc = procId == null ? null : e.Config.Processes.FirstOrDefault(p => p.Id == procId);
    // Q64：需要做法知识的配方（护拳绑带=营区登记默认知识）没学会时不列出
    var recipeId = G.CraftRecipe != null && e.Config.Recipes.Any(r => r.Id == G.CraftRecipe && e.RecipeKnown(s, r)) ? G.CraftRecipe : "knife";
    var rc = e.Recipe(recipeId);
    var main = s.Main;
    var craftPaused = main != null && main.Status == ActionStatus.Paused && (main.Type == ActionType.Craft || main.Type == ActionType.Build);
    var busy = G.Running || s.Sub != null;
    var candidates = G.CraftCandidates;
    // 拆解（B4）走配方流程但只在选中装备的卡下开始，不进手工制作列表
    var recipes = (candidates == null ? e.Config.Recipes : e.Config.Recipes.Where(r => candidates.Contains(r.Id))).Where(r => !r.IsSalvage && e.RecipeKnown(s, r)).ToList();
    var preferred = G.CraftPreferred.Where(id => s.Items.Any(i => i.InstanceId == id && rc.Inputs.ContainsKey(i.ItemId))).ToList();
    var batchable = !rc.IsBuild && !rc.IsRepair;
    var batch = batchable ? Math.Max(1, G.CraftBatch) : 1;
    var request = ActionRequest.Craft(recipeId, rc.NeedsExplicitPot ? G.CraftPot : null, preferred, batch);
    if (rc.IsRepair) request.InstanceId = G.CraftTarget;
}

@if (Part == "center")
{
    <div class="sub-panel" role="dialog" aria-label="手工制作与营地设施">
        <div class="sub-head">
            @* 试玩修复 M77-B7（Q21）：材料来源等教学短文移进悬浮说明 *@
            <div><h2>手工制作</h2><span class="sub" title="@($"材料来自随身与{lc.Name}地面（火堆与锅里的物资要先取出）；配方全部已知；在配方卡下方开始，详细预估在右栏对象信息。")">配方 · 详细预估在右栏 ⓘ</span></div>
            <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
        </div>
        <div class="sub-body craft-grid">
            <div class="recipe-list">
                @if (candidates != null)
                {
                    <div class="tiny muted candidates-head">拖拽找到的候选配方 · 缺料的不能开始 <button class="linkish" @onclick="ShowAll">显示全部</button></div>
                }
                @foreach (var r in recipes)
                {
                    var id = r.Id;
                    var built = r.FacilityResult != null && lc.CanBuildShelter && (r.FacilityResult == "shelterBuilt" ? fac.ShelterBuilt : fac.BedBuilt);
                    var icon = r.FacilityResult == "shelterBuilt" ? "shelter" : r.FacilityResult == "bedBuilt" ? "bed" : r.IsRepair ? "repair" : r.Outputs.Keys.First();
                    var why = candidates != null ? e.CanStart(s, ActionRequest.Craft(id)) : null;
                    <button class="recipe @(id == recipeId && proc == null ? "on" : "") @(why != null ? "missing" : "")" @onclick="() => Pick(id)" title="@why">
                        @Icons.Markup(icon)
                        <span>@r.Name<small>@(built ? "已建造" : why != null ? why : $"{r.BaseMinutes}分钟{(r.IsBuild ? " · 营地" : "")}")</small></span>
                    </button>
                }
                @if (candidates == null)
                {
                    <div class="tiny muted candidates-head">火堆自动加工 · 处理说明</div>
                    @foreach (var p in e.Config.Processes)
                    {
                        var pid = p.Id;
                        <button class="recipe proc @(procId == pid ? "on" : "")" @onclick="() => Pick(ProcPrefix + pid)">
                            @Icons.Markup(p.OutputId)
                            <span>@ProcTitle(p)<small>自动加工 · 受热@(p.HeatMinutes)分钟</small></span>
                        </button>
                    }
                }
            </div>

            <div class="craft-side">
                @if (proc != null)
                {
                    <div class="panel craft-mats">
                        @* Q21：处理说明与“不占角色时间”教学短文移进悬浮说明 *@
                        <div class="eyebrow" title="@($"{ProcHint(proc)} 不额外占角色主行动，仍需世界时间推进：放进去后角色可以去探索、清理、休息或睡眠，世界时间推进时火堆自动加工；浏览与离线不推进。")">处理说明 · 自动加工 ⓘ</div>
                        <div class="steps">
                            @foreach (var (icon, name, note) in Steps(proc))
                            {
                                <ItemRow Icon="@icon" Name="@name" Status="@note" CssClass="step" />
                            }
                        </div>
                        <div class="btn-row" style="margin-top:10px">
                            <button class="secondary" disabled="@(!lc.HasFire)" title="@(lc.HasFire ? "关闭手工制作，在地块栏第二行选中火堆" : $"{lc.Name}没有火堆，回到营地才能加工")"
                                    @onclick="G.SelectFire">查看火堆 ▸</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="panel craft-mats">
                        <div class="eyebrow" title="@RecipeHint(rc)">@(rc.IsBuild ? "营地设施" : "配方") · @rc.Name ⓘ</div>
                        @if (rc.IsRepair)
                        {
                            var cands = e.RepairCandidates(s);
                            <div class="tiny muted">选择要维护的工具或装备（随身、穿戴中或当前地面；锅须先取下并清空）</div>
                            <div class="repair-list">
                                @foreach (var t in cands)
                                {
                                    var tid = t.InstanceId;
                                    var why = e.RepairBlocked(s, tid, out _);
                                    <button type="button" class="repair-pick @(G.CraftTarget == tid ? "on" : "") @(why != null ? "missing" : "")" title="@(why ?? "选择这件工具")" @onclick="() => PickTarget(tid)">
                                        <span class="ir-icon">@Icons.Markup(t.ItemId)</span>
                                        <span><b>@e.ItemName(t.ItemId)#@tid</b><small>@e.WherePath(s, t) · 耐久@(GameEngine.DurabilityText(t))@(why != null ? $" · {why}" : "")</small></span>
                                    </button>
                                }
                                @if (cands.Count == 0) { <div class="risk none">随身、穿戴中和当前地面都没有带耐久的工具或装备。</div> }
                            </div>
                        }
                        @if (rc.NeedsExplicitPot)
                        {
                            var pots = s.Items.Where(i => e.IsPot(i) && e.PlaceOf(s, i) is var pl && (pl == ItemInstance.Carried || pl == here)).ToList();
                            <div class="tiny muted">指定一口取下并清空的锅（不消耗；不会自动装锅或倒出原锅内容）</div>
                            <div class="repair-list">
                                @foreach (var pot in pots)
                                {
                                    var pid = pot.InstanceId;
                                    var why = e.ExplicitPotBlocked(s, pid, out _);
                                    <button type="button" class="repair-pick @(G.CraftPot == pid ? "on" : "") @(why != null ? "missing" : "")" title="@(why ?? "指定这口锅")" @onclick="() => PickPot(pid)">
                                        <span class="ir-icon">@Icons.Markup(pot.ItemId)</span>
                                        <span><b>@e.ItemName(pot.ItemId)#@pid</b><small>@e.WherePath(s, pot) · @e.PotLabel(s, pot)@(why != null ? $" · {why}" : "")</small></span>
                                    </button>
                                }
                                @if (pots.Count == 0) { <div class="risk none">随身和当前地面没有锅。</div> }
                            </div>
                        }
                        @if (batchable)
                        {
                            var maxBatch = rc.Inputs.Count == 0 ? 1 : Math.Max(1, rc.Inputs.Min(kv => e.AvailableCount(s, kv.Key, true) / Math.Max(1, kv.Value)));
                            <div class="batch-row">
                                <span class="tiny muted">批量制作</span>
                                <button type="button" class="tbar-step" aria-label="减少件数" disabled="@(batch <= 1)" @onclick="() => SetBatch(batch - 1)">−</button>
                                <b>@batch</b>
                                <button type="button" class="tbar-step" aria-label="增加件数" disabled="@(batch >= maxBatch)" @onclick="() => SetBatch(batch + 1)">+</button>
                                <span class="tiny muted">材料最多够@(maxBatch)件；同批次合并工作量，高熟练度一段可做多件</span>
                            </div>
                        }
                        <div class="tiny muted">原料</div>
                        @foreach (var kv in rc.Inputs)
                        {
                            var item = kv.Key;
                            var need = kv.Value * batch;
                            var have = e.AvailableCount(s, item, true);
                            var carried = e.UsableBatches(s, item, false).Sum(i => i.Count);
                            var reserved = s.Items.Where(i => i.ItemId == item && i.ReservedBy != null && (i.IsCarried || i.Owner == here)).Sum(i => i.Count);
                            var plan = Fill(item, need, preferred);
                            var lack = Math.Max(0, need - have);
                            <ItemRow Icon="@item" Name="@e.ItemName(item)" Qty="@($"需{need}")" Missing="@(lack > 0)" CssClass="mat-row"
                                     Status="@($"现有{have}（随身{carried}／地面{have - carried}）{(reserved > 0 ? $" · 预留{reserved}" : "")}{(lack > 0 ? $" · 缺少{lack}" : "")}")"
                                     DataDrop="@($"slot:{recipeId}:{item}")" Title="把具体批次的卡拖到这里指定使用">
                                <span class="slot-batches">
                                    @foreach (var (b, n) in plan)
                                    {
                                        var bid = b.InstanceId;
                                        var pinned = preferred.Contains(bid);
                                        <button type="button" class="batch-chip @(pinned ? "on" : "")" title="@(pinned ? "已手工指定，点击取消" : "点击固定使用这一批")" @onclick="() => TogglePreferred(bid)">
                                            @BatchText(b, n, pinned)
                                        </button>
                                    }
                                </span>
                            </ItemRow>
                        }
                        @foreach (var tag in rc.Catalysts)
                        {
                            var cfg = e.Config.Items.First(i => i.ToolTag == tag);
                            var tool = e.AccessibleTool(s, tag);
                            <ItemRow Icon="@cfg.Id" Name="@(tool == null ? cfg.Name : $"{cfg.Name}#{tool.InstanceId}")" Qty="催化工具" Missing="@(tool == null)"
                                     Status="@(tool == null ? "缺少：需随身或在当前地面" : $"{(tool.IsCarried ? "随身" : "地面")} · 不消耗")" />
                        }
                        <div class="tiny muted" style="margin-top:8px">产物</div>
                        @if (rc.FacilityResult != null)
                        {
                            var icon = rc.FacilityResult == "shelterBuilt" ? "shelter" : "bed";
                            <ItemRow Icon="@icon" Name="@rc.Name.Replace("建", "").Replace("铺", "")" Qty="×1" Status="@($"建在{lc.Name}，不可搬动")" />
                        }
                        @foreach (var kv in rc.Outputs)
                        {
                            <ItemRow Icon="@kv.Key" Name="@e.ItemName(kv.Key)" Qty="@($"×{kv.Value * batch}")" Status="@($"完成后放在{lc.Name}地面")" />
                        }
                        @* 唯一“开始制作/开始建造”入口在所选配方卡内（S08 §5、S14 §14.1）：选配方、改件数、指定批次/锅只预览，不扣物不预留；
                           点开始才交内核按真实材料/工具/锅/占用重验并预留开工（E.Start），执行中锁住按钮，重复点击不重复制作。右栏只作可选详细预测。 *@
                        @{
                            var p = G.Preview(request);
                            var startBusy = busy || (main != null && !p.AsSubAction) || _starting;
                            <div class="craft-go">
                                <span class="cg-facts">
                                    @if (p.Ok)
                                    {
                                        <b>@Clock.Duration(p.EstimatedMinutes)</b><small>预计@(Clock.HHmm(p.EstimatedEndMinute))完成@(p.Warnings.Count > 0 ? " · " + p.Warnings[0] : "")</small>
                                    }
                                    else
                                    {
                                        <small class="warn-text">@p.Reason</small>
                                    }
                                </span>
                                <button type="button" class="primary cg-start" disabled="@(!p.Ok || startBusy)" title="@(p.Ok ? "确认后才预留材料并推进游戏时间" : p.Reason)"
                                        @onclick="() => Start(request)">@(p.Ok ? p.ConfirmText : StartLabel(rc))</button>
                            </div>
                        }
                    </div>
                }
                @if (lc.HasFire)
                {
                    var used = e.FireContents(s, here).Count;
                    <div class="panel fire-box">
                        <ItemRow Icon="@(fac.FireLit ? "fire_lit" : "fire_out")" Name="营地火堆" Qty="@(fac.FireLit ? "燃烧中" : fac.WentOut ? "熄灭" : "未点燃")"
                                 Status="@($"燃料{fac.FuelMinutes}/{e.Config.Fire.MaxFuelMinutes}分钟 · 内容物{used}/{e.Config.Fire.ProcessingSlots}")">
                            <button class="secondary" @onclick="G.SelectFire">查看火堆 ▸</button>
                        </ItemRow>
                    </div>
                }
            </div>
        </div>
    </div>
}
else if (proc != null)
{
    <div class="detail-scroll">
        <div class="op-head"><div class="eyebrow">处理说明 · 自动加工</div><h2>@ProcTitle(proc)</h2><p>@ProcHint(proc)</p></div>
        <div class="lines">
            <div><span>有效受热</span><b>@(proc.HeatMinutes)分钟</b></div>
            <div><span>占用角色</span><b>不占用</b></div>
            @if (proc.WaterCostMl > 0) { <div><span>耗水</span><b>每份@(e.ItemName(proc.RequiredLiquid ?? ""))@(proc.WaterCostMl)毫升</b></div> }
            <div><span>成品留在</span><b>@(proc.IsPotBatch ? "原锅" : proc.InPot ? "原锅食材位" : "原火堆加工位")</b></div>
        </div>
        @if (!proc.IsPotBatch)
        {
            var o = e.Item(proc.OutputId);
            <ItemRow Icon="@o.Id" Name="@o.Name" Qty="×1" Status="@($"{GameEngine.UseEffectText(o.Use!)} · 保质{o.ShelfLifeMinutes / 60}小时")" />
        }
    </div>
    <div class="detail-foot">
        <button class="primary" disabled="@(!lc.HasFire)" @onclick="G.SelectFire">查看火堆 ▸</button>
        <div class="under">没有开始按钮：放进燃烧的火堆即自动加工</div>
    </div>
}
else
{
    <PreviewView Request="request" Eyebrow="@($"手工制作 · {(rc.IsBuild ? "营地设施" : "配方")}")" Title="@rc.Name" Subtitle="@RecipeHint(rc)"
                 Confirmable="false" FootNote="@($"在中间配方卡下方点“{StartLabel(rc)}”；时间为预计值")" />
}

@code {
    [Parameter] public string Part { get; set; } = "center";

    /// <summary>处理说明条目在 CraftRecipe 里的前缀，避免与配方 ID 混淆。</summary>
    public const string ProcPrefix = "proc:";

    private string RecipeHint(RecipeConfig r)
    {
        var c = G.E.Config;
        string Range(string id) => c.Items.FirstOrDefault(i => i.Id == id)?.DurabilityMaxRange is double[] d ? $"最大耐久{Ui.T(d[0])}—{Ui.T(d[1])}（每件随机）" : "";
        var sh = c.HourlyRates["sleep_sheltered"];
        return r.Id switch
        {
            "knife" => $"纤维采集耗时从20分钟降到10分钟；也是刀剑类武器（练刀剑熟练度）。{Range("stone_knife")}。",
            "axe" => $"木材采集每次产出翻倍；也是斧类武器（练斧熟练度）。{Range("hatchet")}。",
            "bandage" => $"止血；健康+1×(1+0.02×医疗等级)，{c.ItemActions.BandageCooldownMinutes}分钟冷却；已感染时还能压低病毒。",
            "shelter" => $"营地可遮蔽睡眠（清醒{Ui.SignedT(sh.Wakefulness)}、体力{Ui.SignedT(sh.Energy)}、精神{Ui.SignedT(sh.Morale)}/小时），休息额外恢复精神。",
            "bed" => $"营地睡眠体力每小时额外{Ui.SignedT(c.FacilityEffects.BedExtraSleepEnergyPerHour)}。需要先建成遮蔽棚。",
            "repair_selected_tool" => $"选定一件随身、穿戴中或当前地面的工具或装备，恢复它自身最大耐久的{Ui.Pct(G.E.RepairFraction(G.S, r))}{(G.E.RepairFraction(G.S, r) > r.RestoreOwnDurabilityMaxFraction + 1e-9 ? "（穿着维护手册，替代" + Ui.Pct(r.RestoreOwnDurabilityMaxFraction) + "）" : "")}，不超过上限、不重抽最大耐久，品质与词条不变；满耐久不能维护。",
            "make_wooden_spear" => $"矛类武器，可打敌方1—3号位。{Range("wooden_spear")}。",
            "make_wooden_bow" => $"弓弩类武器，可打敌方1—4号位；每射直接消耗随身箭矢1。{Range("wooden_bow")}。",
            "make_arrows" => "木弓的箭矢，首版不回收。",
            "make_antiviral_cure" => "立即清除病毒感染。需医疗≥15、制造≥12，在营地制作，并指定一口取下并清空的锅（不消耗）；净水作为原料直接消耗，不自动装锅。",
            _ => "",
        };
    }

    private string ProcTitle(ProcessConfig p) => p.IsPotBatch ? "烧水" : $"{p.Name}{G.E.ItemName(p.InputId).Replace("生", "")}";

    private string ProcHint(ProcessConfig p)
    {
        var e = G.E;
        return (p.IsPotBatch ? "boil_water" : p.InPot ? "boil_root" : "roast_root") switch
        {
            "boil_water" => $"装了{e.ItemName(p.InputId)}的金属锅放进燃烧的火堆，0.5升或1升都是{p.HeatMinutes}分钟原地烧成{e.ItemName(p.OutputId)}；不自动补水。",
            "roast_root" => $"{e.ItemName(p.InputId)}直接放进燃烧火堆的空加工位，每份{p.HeatMinutes}分钟烤成{e.ItemName(p.OutputId)}，不需要锅和水。",
            "boil_root" => $"{e.ItemName(p.InputId)}放进有{e.ItemName(p.RequiredLiquid ?? "")}的锅、锅放进燃烧的火堆，每份{p.HeatMinutes}分钟煮成{e.ItemName(p.OutputId)}，完成时扣{p.WaterCostMl}毫升；空锅只存放不加工。",
            _ => "",
        };
    }

    /// <summary>图示步骤：每步一行“图标+名称+说明”。</summary>
    private List<(string icon, string name, string note)> Steps(ProcessConfig p)
    {
        var e = G.E;
        var heat = $"受热{p.HeatMinutes}分钟";
        return (p.IsPotBatch ? "boil_water" : p.InPot ? "boil_root" : "roast_root") switch
        {
            "boil_water" => new()
            {
                (p.InputId, e.ItemName(p.InputId), "1. 把水卡拖到锅的水量条，每份500毫升"),
                ("pot", "金属锅", "2. 把锅拖到火堆的空加工位"),
                ("fire_lit", "燃烧的火堆", $"3. 点火并保持燃料，{heat}"),
                (p.OutputId, e.ItemName(p.OutputId), "4. 留在原锅，可饮用或倒出"),
            },
            "roast_root" => new()
            {
                (p.InputId, e.ItemName(p.InputId), "1. 拖到火堆的空加工位（每份占1位）"),
                ("fire_lit", "燃烧的火堆", $"2. {heat}，熄火保留进度"),
                (p.OutputId, e.ItemName(p.OutputId), "3. 留在加工位，取出后食用"),
            },
            _ => new()
            {
                (p.RequiredLiquid ?? "clean_water", e.ItemName(p.RequiredLiquid ?? "clean_water"), $"1. 锅里装净水，每份食材预留{p.WaterCostMl}毫升"),
                (p.InputId, e.ItemName(p.InputId), "2. 拖到锅的食材区（最多2份）"),
                ("pot", "金属锅", "3. 锅放进火堆的空加工位"),
                ("fire_lit", "燃烧的火堆", $"4. {heat}，完成时扣水"),
                (p.OutputId, e.ItemName(p.OutputId), "5. 留在原锅食材位"),
            },
        };
    }

    private bool _starting;

    private static string StartLabel(RecipeConfig r) => r.IsBuild ? "开始建造" : r.IsRepair ? "开始维护" : "开始制作";

    /// <summary>开始制作/建造/维护：内核再校验并预留；开始成功后保持面板（与原右栏确认一致），中央推进条接管进度与退出。</summary>
    private async Task Start(ActionRequest request)
    {
        if (_starting) return;
        _starting = true;
        try { await G.StartAction(request); }
        finally { _starting = false; }
    }

    private void Pick(string id)
    {
        if (G.CraftRecipe != id)
        {
            G.CraftBatch = 1;
            G.CraftTarget = null;
            G.CraftPot = null;
        }
        G.CraftRecipe = id;
        G.Notify();
    }

    private void PickPot(int id)
    {
        G.CraftPot = G.CraftPot == id ? null : id;
        G.Notify();
    }

    private void PickTarget(int id)
    {
        G.CraftTarget = G.CraftTarget == id ? null : id;
        G.Notify();
    }

    private void SetBatch(int n)
    {
        G.CraftBatch = Math.Max(1, n);
        G.Notify();
    }

    private void ShowAll()
    {
        G.CraftCandidates = null;
        G.Notify();
    }

    private void TogglePreferred(int id)
    {
        if (!G.CraftPreferred.Remove(id)) G.CraftPreferred.Add(id);
        G.Notify();
    }

    private string BatchText(ItemInstance b, int n, bool pinned)
    {
        var where = b.IsCarried ? "随身" : "地面";
        var fresh = b.ExpiresAt.HasValue ? " · " + Ui.Fresh(b.ExpiresAt.Value - G.S.GameMinute) : "";
        return $"{where}×{n}{fresh}{(pinned ? " · 指定" : "")}";
    }

    /// <summary>材料槽将用到的批次：手工指定的在前，其余按最早到期、随身优先、实例 ID 自动补齐。</summary>
    private List<(ItemInstance inst, int n)> Fill(string itemId, int need, List<int> preferred)
    {
        var list = G.E.UsableBatches(G.S, itemId, true)
            .OrderBy(b => preferred.Contains(b.InstanceId) ? preferred.IndexOf(b.InstanceId) : int.MaxValue).ToList();
        var res = new List<(ItemInstance, int)>();
        foreach (var b in list)
        {
            if (need <= 0) break;
            var n = Math.Min(need, b.Count);
            res.Add((b, n));
            need -= n;
        }
        return res;
    }

    private void Close() => G.OpenPanel(null);
}
