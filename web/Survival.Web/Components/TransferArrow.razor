@inherits GameComponent

@* 物品卡右下角的三角箭头：打开拾取/放下数量框，可直接输入数字；只有 1 件时直接转移（试玩留言 fb68265e，按策划调整去掉长按）。 *@
<button type="button" class="card-arrow @(ToCarried ? "down" : "up")" disabled="@(!Enabled)"
        aria-label="@(ToCarried ? "拾取，可输入数量" : "放下，可输入数量")"
        title="@(ToCarried ? "拾取（可输入数量）" : "放下（可输入数量）")"
        @onclick="OnClick" @onclick:stopPropagation="true">@(ToCarried ? "▼" : "▲")</button>

@code {
    [Parameter] public string Owner { get; set; } = "";
    [Parameter] public string ItemId { get; set; } = "";
    [Parameter] public int? InstanceId { get; set; }
    [Parameter] public bool Enabled { get; set; } = true;

    private bool ToCarried => Owner != ItemInstance.Carried;

    private void OnClick()
    {
        if (!Enabled) return;
        if (InstanceId.HasValue) G.TransferOne(Owner, ItemId, InstanceId);
        else G.OpenQuantity(Owner, ItemId);
    }
}
