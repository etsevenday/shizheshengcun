@inject GameSession G
@implements IDisposable
@* 统一卡框（卡片统一与设施烹饪 v0.4 · 01 案第 2 节）：地点、设施、资源与地面/随身物品共用同一圆角、描边、标题与图片区。
   Wide 为左图右文（当前地图卡）；Dashed 为未建造；落点与拖拽键原样透传给 drag.js。
   B32a（逐字稿 §1.2 Q340、Q345；v0.9 06 §1—§4）：Ink2 为重墨 V2 卡模板——上部主图（右上角标），下部信息条「名称 + 一行副标」，
   风险、对象自身原因、已有健康条放紧凑第二行（Line2），主操作（Footer）仍在卡上：屏高 ≤800 在主图右侧、≥801 在信息条右侧（Q37）。
   状态叠层：Danger→危险、Busy→加工中、Dim→不可用（06 §4 独立叠层，不改卡片外尺寸）。 *@
@if (Ink2)
{
    <div id="@Id" class="ocard k2 @CssClass @(Selected ? "selected" : "") @(Dashed ? "dashed" : "") @(Dim ? "dim" : "") @(Blocked ? "st-disabled" : "") @(Danger ? "st-danger" : "") @(Busy ? "st-busy" : "") @(Fresh ? "fresh" : "") @(Footer != null ? "has-act" : "")"
         data-drop="@DataDrop" data-drop-level="@(DataDrop == null ? null : DropLevel)"
         data-drag="@DataDrag" data-drag-from="@DragFrom" data-drag-title="@DragTitle" data-card="@DataCard" data-peek="@EffPeek"
         role="button" tabindex="0" title="@Tooltip" aria-label="@(AriaLabel ?? Title)" aria-describedby="@DescribedBy"
         @onclick="Click" @onkeydown="Key">
        <div class="k2-art">
            @Art
            @if (!string.IsNullOrEmpty(Badge)) { <span class="k2-tag @BadgeClass">@Badge</span> }
            @if (!string.IsNullOrEmpty(Badge2)) { <span class="k2-tag k2-tag2">@Badge2</span> }
        </div>
        <div class="k2-info">
            <b class="k2-name" title="@Title">@Title</b>
            @if (SubContent != null) { <div class="k2-sub @SubClass" title="@SubTitle">@SubContent</div> }
            else if (!string.IsNullOrEmpty(Sub)) { <div class="k2-sub @SubClass" title="@(SubTitle ?? Sub)">@Sub</div> }
            @if (Line2 != null) { <div class="k2-l2">@Line2</div> }
        </div>
        @if (Footer != null) { <div class="k2-act">@Footer</div> }
    </div>
}
else
{
<div id="@Id" class="ocard @CssClass @(Selected ? "selected" : "") @(Dashed ? "dashed" : "") @(Dim ? "dim" : "") @(Wide ? "wide" : "") @(Fresh ? "fresh" : "")"
     data-drop="@DataDrop" data-drop-level="@(DataDrop == null ? null : DropLevel)"
     data-drag="@DataDrag" data-drag-from="@DragFrom" data-drag-title="@DragTitle" data-card="@DataCard" data-peek="@EffPeek"
     role="button" tabindex="0" title="@Tooltip" aria-label="@(AriaLabel ?? Title)" aria-describedby="@DescribedBy"
     @onclick="Click" @onkeydown="Key">
    <div class="oc-head">
        <b title="@Title">@Title</b>
        @if (!string.IsNullOrEmpty(Badge)) { <span class="oc-badge @BadgeClass">@Badge</span> }
    </div>
    <div class="oc-main">
        @if (Art != null) { <div class="oc-art">@Art</div> }
        @if (ChildContent != null) { <div class="oc-body">@ChildContent</div> }
    </div>
    @if (Footer != null) { <div class="oc-foot">@Footer</div> }
</div>
}

@code {
    /// <summary>DOM id（就近操作浮窗的锚点，S14 §14.1）。</summary>
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Badge { get; set; }
    [Parameter] public string BadgeClass { get; set; } = "";
    /// <summary>B32b（Q372）：第二个角标（火堆两个加工位都占用时「加工位满」），排在第一个角标下面。</summary>
    [Parameter] public string? Badge2 { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Dashed { get; set; }
    [Parameter] public bool Dim { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter] public bool Fresh { get; set; }
    [Parameter] public string? Tooltip { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    /// <summary>卡面的可访问说明（B39 Q312：人物卡与「交谈」按钮共用接取预告）。</summary>
    [Parameter] public string? DescribedBy { get; set; }
    [Parameter] public string? DataDrop { get; set; }
    [Parameter] public string DropLevel { get; set; } = "card";
    [Parameter] public string? DataDrag { get; set; }
    [Parameter] public string? DragFrom { get; set; }
    [Parameter] public string? DragTitle { get; set; }
    [Parameter] public string? DataCard { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public RenderFragment? Art { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    // ───── B32a 重墨 V2 卡模板（Q340） ─────
    /// <summary>用重墨 V2 卡模板（194×155 基准，三档按 Q325 比例）。</summary>
    [Parameter] public bool Ink2 { get; set; }
    /// <summary>名称下的一行副标（资源＝账短标·每次产量；敌踪＝健康数值；邻地＝方向·单程时间）。</summary>
    [Parameter] public string? Sub { get; set; }
    /// <summary>副标需要图标（四类账徽标、方位箭头）时用片段代替 Sub。</summary>
    [Parameter] public RenderFragment? SubContent { get; set; }
    [Parameter] public string? SubTitle { get; set; }
    [Parameter] public string SubClass { get; set; } = "";
    /// <summary>紧凑第二行：风险、对象自身原因、已有健康条。</summary>
    [Parameter] public RenderFragment? Line2 { get; set; }
    /// <summary>Q345 危险：敌对敌踪、腐败物品、耐久为 0 的工具。</summary>
    [Parameter] public bool Danger { get; set; }
    /// <summary>Q345 加工中：当前行动作用中的资源或设施、受热的锅或工位、晾制中的工位。</summary>
    [Parameter] public bool Busy { get; set; }
    /// <summary>Q345 不可用（对象自身阻断，Q252 资源自身原因）：与 Dim 同一叠层，单列参数方便与库存为 0 分开写。</summary>
    [Parameter] public bool Blocked { get; set; }

    // ───── B42 悬停即看右栏（S14 2026-11-12） ─────
    /// <summary>卡片本体的悬停热区键：有点击选择对象的卡传与点击同一身份（Peek.Sel…）；不传时按 Id 用公开条目键（Peek.Card），右栏显示本卡原公开内容。</summary>
    [Parameter] public string? PeekId { get; set; }
    /// <summary>不作悬停热区（极少数纯装饰卡）。</summary>
    [Parameter] public bool NoPeek { get; set; }
    /// <summary>BM1（Q487）：公开条目右栏在原公开内容之后另显示的同源详情（未建设施＝原点击对应设施配方的建造条件，只读）；没有时为 null。</summary>
    [Parameter] public RenderFragment? PeekExtra { get; set; }

    private string? EffPeek => NoPeek ? null : PeekId ?? (Id != null ? Peek.Card(Id) : null);
    private string? _peekReg;

    /// <summary>公开条目键：每次参数刷新登记本卡原公开标题、角标状态、悬停说明、主图与副标／第二行／正文（不含执行按钮），右栏读当前这份。</summary>
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        var k = EffPeek;
        if (_peekReg != null && _peekReg != k) { G.DropPeekFacts(_peekReg, this); _peekReg = null; }
        if (k == null || PeekKey.KindOf(k) != PeekKey.Card) return;
        G.SetPeekFacts(k, this, new PeekFacts
        {
            Title = Title,
            State = string.Join(" · ", new[] { Badge, Badge2 }.Where(x => !string.IsNullOrEmpty(x))) is { Length: > 0 } st ? st : null,
            Desc = Tooltip ?? SubTitle,
            Art = Art,
            Body = PeekBody,
            Extra = PeekExtra,
        });
        _peekReg = k;
    }

    // BM1（Q486 选 A）：右栏里说明（Tooltip ?? SubTitle）与文字副标去首尾空白后相同、或任一句整段包含另一句时只留说明行；
    // 说明为空保留副标，互不包含各留。只比这两段原文，不改卡面副标，不动标题、角标、第二行与正文。图标片段副标（SubContent）不做文字比较
    private RenderFragment PeekBody => @<div class="peek-lines">
        @if (SubContent != null) { <div class="k2-sub @SubClass">@SubContent</div> }
        else if (!string.IsNullOrEmpty(Sub) && !PeekText.SubRepeatsDesc(Tooltip ?? SubTitle, Sub)) { <div class="k2-sub @SubClass">@Sub</div> }
        @if (Line2 != null) { <div class="k2-l2">@Line2</div> }
        @if (ChildContent != null) { <div class="oc-body">@ChildContent</div> }
    </div>;

    public void Dispose()
    {
        if (_peekReg != null) G.DropPeekFacts(_peekReg, this);
    }

    private Task Click() => OnClick.InvokeAsync();

    private Task Key(KeyboardEventArgs ev) => ev.Key is "Enter" or " " ? OnClick.InvokeAsync() : Task.CompletedTask;
}
