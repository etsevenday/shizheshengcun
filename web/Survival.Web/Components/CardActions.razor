@inherits GameComponent

@* 选中卡片的操作内容（v0.7 第 3.2、7 节；S14 §18.3 起放在 CardPop 的锚定浮窗里，不再占文档流撑高所在行），一次只有一个。
   条内顺序：对象（图标、名称、完整来源、数量）→ 自用操作（食用1份/饮用1份/饮用1份（风险）/使用1份，旁边写明效果、5分钟、溢出与风险）
   → 转移目标/数量 → 明确的转移执行按钮。选中、改数量、选目标都不执行；点自用或执行按钮才提交，玩法层重新校验。
   根节点沿用 .tbar 类：app.js 把“选中后直接按数字/回车”转进这里的输入框与执行按钮（留言 fb68265e）。 *@
@{
    var m = Build();
}
@if (m != null)
{
    var e = G.E;
    var s = G.S;
    var moveBusy = e.IsBusy(s) || G.Running;
    SyncDefault(m);
    @* Esc 不在这里处理：交给 GameScreen 的 Esc 栈统一判定（先清选中），避免条内与全局各处理一次直接弹出菜单（试玩修复 B1） *@
    <div class="tbar cact" role="group" aria-label="@($"{m.Name}的操作")" @onclick:stopPropagation="true">
        <div class="ca-head">
            <span class="ir-icon">@Icons.Markup(m.Icon)</span>
            <span class="ca-title"><b>@m.Name</b><small>@m.From · ×@m.Available@(m.Batches != null ? $" · 所选批{BatchFresh(m.Batches.First(b => b.Key == m.BatchKey))}" : "")</small></span>
        </div>

        @if (m.Batches != null)
        {
            @* Q24：同物品多批叠卡，展开选批次；最早到期在前、无保质在后；所选批次决定下面的食用与转移 *@
            <div class="ca-batches" role="radiogroup" aria-label="选择批次（食用和转移都只用所选这一批）" title="点选批次：食用和转移都只用所选这一批">
                @foreach (var b in m.Batches)
                {
                    var bk = b.Key;
                    <button type="button" role="radio" aria-checked="@(bk == m.BatchKey)" class="ca-batch @(bk == m.BatchKey ? "on" : "") @(b.Spoiled ? "spoiled" : "") @(b.Reserved ? "reserved" : "")"
                            title="@BatchTitle(b)" @onclick="() => G.PickBatch(m.Owner, m.ItemId, bk)">
                        <b>×@b.Count</b><small>@BatchFresh(b)@(b.Reserved ? " · 预留" : "")</small>
                    </button>
                }
            </div>
        }

        @if (m.UseId.HasValue && s.Battle != null)
        {
            @* U728：战斗中卡下自用按钮改走战斗校验与 AP（绷带/抗生素/特效药 2AP），不绕到非战斗 5 分钟流程；食物与饮水战斗中禁用 *@
            var cfg = e.Item(m.ItemId);
            var act = cfg.Use!.IsBandage ? "bandage" : cfg.Use.IsAntibiotic ? "use_antibiotics" : cfg.Use.IsAntiviral ? "use_antiviral_cure" : null;
            if (act != null)
            {
                var why = e.CommandBlocked(s, BattleCommand.Of(act, null, m.UseId));
                <div class="ca-use-row">
                    <button type="button" class="ca-use" disabled="@(why != null || G.BattleBusy)" title="@(why ?? "选择这条战斗指令，在战斗操作台点“确认”执行")"
                            @onclick="() => G.PickBattleAction(act, m.UseId)">@GameEngine.ActionName(act)（战斗指令·2AP）</button>
                    <span class="ca-use-note">效果在确认时应用，不另跳5分钟</span>
                </div>
                @if (why != null) { <div class="ca-note bad">@why</div> }
            }
            else
            {
                <div class="ca-note">战斗中不能进食饮水，脱战后再补给</div>
            }
        }
        else if (m.UseId.HasValue)
        {
            var cfg = e.Item(m.ItemId);
            var p = G.Preview(ActionRequest.UseInstance(m.UseId.Value));
            var why = G.Running ? "行动进行中" : p.Ok ? null : p.Reason;
            <div class="ca-use-row">
                <button type="button" class="ca-use @(GameEngine.UseRisky(cfg) ? "risky" : "")" disabled="@(why != null || using_)" title="@(why ?? "点击即使用1份，耗时5分钟、不可中途取消")"
                        @onclick="() => Use(m.UseId.Value)">@GameEngine.UseButtonText(cfg)</button>
                <span class="ca-use-note">
                    @if (e.MedicineEffectText(s, cfg.Use!) is string med)
                    {
                        // 药品按这一次的实际效果写（冷却中不回血、病毒前后），与右栏和结果一致（试玩修复 G4）
                        @med<text> · @(e.Config.ItemActions.UseMinutes)分钟</text>
                    }
                    else
                    {
                        @GameEngine.UseEffectText(cfg.Use!)<text> · @(e.Config.ItemActions.UseMinutes)分钟（即时）</text>
                    }
                    @if (p.Ok && p.StatsAfterImmediate != null && !cfg.Use!.IsMedicine)
                    {
                        // 物品影响的属性一律列出（即时结算值，夹紧到 100 时写溢出），不因取整后相等就省略（试玩修复 B9）
                        foreach (var (id, delta) in Affected(cfg.Use!, e.UseHealthAmount(s, cfg.Use!)))
                        {
                            var raw = p.StatsBefore.Get(id) + delta;
                            var max = p.StatsBefore.Max(id);
                            var over = raw > max + 1e-9 ? raw - max : 0;
                            <em>@GameEngine.StatName(id)@Ui.N(p.StatsBefore.Get(id))→@Ui.N(p.StatsAfterImmediate.Get(id))@(over > 0 ? $"（溢出{Ui.N(over)}）" : "")</em>
                        }
                    }
                </span>
            </div>
            @if (e.UseRiskText(cfg) is string risk) { <div class="ca-note risk-line">⚠ @risk</div> }
            @* Q23：吃掉正在火堆/锅里加工的那一份，提前写明终止它的加工、释放它的预留 *@
            @if (e.FindItem(s, m.UseId.Value) is ItemInstance useIt && e.UseCookNote(s, useIt) is string cookNote) { <div class="ca-note warn">@(GameEngine.UseVerb(cfg))后：@cookNote</div> }
            @if (p.OverflowText is string ov) { <div class="ca-note warn">@ov</div> }
            @if (why != null) { <div class="ca-note bad">@(GameEngine.UseButtonText(cfg))：@why</div> }
        }

        @if (e.IsSubstance(m.ItemId))
        {
            var subs = (m.Instance != null ? new List<ItemInstance> { m.Instance } : s.Items.Where(i => i.Owner == m.Owner && i.ItemId == m.ItemId).ToList())
                .OrderByDescending(i => i.Source?.TutorialReward == true).ThenBy(i => i.InstanceId).ToList();
            foreach (var it in subs)
            {
                var freq = ActionRequest.Fuse(it.InstanceId);
                var fwhy = G.Running ? "行动进行中" : e.CanStart(s, freq);
                <div class="ca-use-row">
                    <button type="button" class="ca-use fuse" disabled="@(fwhy != null || using_)" title="@(fwhy ?? "饱饱吞噬融合这1份，确认后立即结算，之后5分钟不可取消")"
                            @onmouseenter="() => G.Hover(freq, FuseTitle)" @onmouseleave="() => G.Hover(null)"
                            @onclick="() => Fuse(freq)">吞噬融合1份·@(e.Config.ActiveSubstance.Fusion.Minutes)分钟</button>
                    <span class="ca-use-note">@e.SubstanceLabel(it)#@it.InstanceId（×@it.Count）→ @e.FusionOutcomeText(s, it)</span>
                </div>
                @if (fwhy != null) { <div class="ca-note bad">吞噬融合：@fwhy</div> }
            }
        }

        @if (m.Mode == Mode.Stack || m.Mode == Mode.Single)
        {
            var verb = m.ToCarried ? "拾取" : "放下";
            var to = m.ToCarried ? "随身" : "地面";
            var n = m.Mode == Mode.Single ? 1 : Parse();
            var invalid = n < 1 || n > m.Available;
            var tooHeavy = !invalid && m.ToCarried && n > m.Max;
            var unit = m.UnitGrams;
            var after = e.CarriedGrams(s) + (m.ToCarried ? 1 : -1) * unit * (invalid ? 0 : n);
            if (moveBusy)
            {
                <div class="ca-note">@(s.Battle != null ? "战斗中不能拾取、放下或投放物品" : s.Encounter != null ? "发现敌踪：先选择接敌或绕行" : "行动进行中，暂不能整理物品")</div>
            }
            else if (m.Available == 0)
            {
                <div class="ca-note">该物品正被当前行动预留，不能@(verb)</div>
            }
            else
            {
                <div class="tbar-row">
                    @if (m.Mode == Mode.Stack)
                    {
                        <button type="button" class="tbar-step" aria-label="减少" @onclick="() => Step(-1, m)">−</button>
                        <input @ref="input" type="text" inputmode="numeric" value="@text" @oninput="OnInput" aria-label="转移数量" />
                        <button type="button" class="tbar-step" aria-label="增加" @onclick="() => Step(1, m)">+</button>
                        <button type="button" class="tbar-max" @onclick="() => SetN(m.ToCarried ? m.Max : m.Available)">@(m.ToCarried ? $"最多{m.Max}" : "全部")</button>
                    }
                    <button type="button" class="tbar-go" disabled="@(invalid || tooHeavy || (m.ToCarried && m.Max < 1))" @onclick="() => Go(m, n)">@(verb)@(m.Instance != null ? m.Name : invalid ? "" : $"{n}份")到@(to)</button>
                </div>
                @if (m.Instance != null && e.CarcassOf(m.Instance.ItemId) != null)
                {
                    @* v0.5 §14：处理尸体 30 分钟（随身刀斧，成功磨损1），产生肉与兽皮 *@
                    var breq = ActionRequest.Butcher(m.Instance.InstanceId);
                    var bwhy = e.CanStart(s, breq);
                    <div class="tbar-row">
                        <button type="button" class="tbar-go alt" disabled="@(bwhy != null || G.Running)" title="@(bwhy ?? "单击直接开始；右侧显示预测")"
                                @onmouseenter="() => G.Hover(breq, ButcherTitle)" @onmouseleave="() => G.Hover(null)"
                                @onclick="() => Butcher(breq)">处理尸体·@(e.CarcassOf(m.Instance.ItemId)!.ButcherBaseMinutes)分钟</button>
                    </div>
                    @if (bwhy != null) { <div class="ca-note bad">处理尸体：@bwhy</div> }
                }
                @if (m.Instance != null && m.Instance.IsCarried && e.Weapon(m.Instance.ItemId) != null)
                {
                    @* 战前装备当前武器（v0.5 §04：入战前可免费调整；装备只是随身实例的引用，不复制、不额外计重） *@
                    var wid = m.Instance.InstanceId;
                    var equipped = s.EquippedWeaponId == wid;
                    <div class="tbar-row">
                        <button type="button" class="tbar-go alt" @onclick="() => G.Equip(equipped ? null : wid)">@(equipped ? "改回徒手" : "设为当前武器")</button>
                    </div>
                    <div class="ca-note">@(equipped ? "这是当前武器，开战时直接使用" : "开战时使用当前武器；战斗中换武器耗1AP")</div>
                }
                @if (m.PotInstance is ItemInstance pot && e.Location(s.CurrentLocation).HasFire)
                {
                    e.MaxPutInFire(s, pot, out var fireWhy);
                    <div class="tbar-row">
                        <button type="button" class="tbar-go alt" disabled="@(fireWhy != null)" title="@(fireWhy ?? "放进火堆空加工位，燃烧时自动烧水、水煮")" @onclick="() => PutInFire(pot.InstanceId)">放入火堆加工位</button>
                    </div>
                    @if (fireWhy != null) { <div class="ca-note bad">放入火堆：@fireWhy</div> }
                }
                @if (invalid) { <div class="ca-note bad">请输入 1 到 @m.Available 之间的数字</div> }
                else if (m.ToCarried && (m.Max < 1 || tooHeavy)) { <div class="ca-note bad">@(G.PickupLimitText(m.ItemId, m.Max < 1 ? 1 : n, m.Instance ?? m.Head) ?? $"最多可取{m.Max}份")</div> }
                else { <div class="ca-note @(after > e.Config.Carry.SoftGrams ? "warn" : "")">@(verb)后随身@(Ui.Kg(after))公斤@(after > e.Config.Carry.SoftGrams ? $"，超过{e.Config.Carry.SoftGrams / 1000}公斤会减速" : "")@(m.ToCarried ? $" · 随身{e.RootCardsAfter(s, m.Instance ?? m.Head, invalid ? 0 : n, null, 0)}/{e.MaxRootCards}张卡" : "") · 不耗时</div> }
            }
        }
        else if (m.Mode == Mode.TakeOut)
        {
            var it = m.Instance!;
            var zone = Target(m);
            var why = moveBusy ? "行动进行中，暂不能整理物品" : e.TakeOutBlocked(s, it, zone);
            var c = e.TakeOutConsequenceOf(s, it);
            var verb = e.IsPot(it) ? (zone == ItemInstance.Carried ? "拾取" : "取下") : "取出";
            <TargetPicker Value="@zone" Here="@s.CurrentLocation" OnPick="v => target = v" />
            <div class="tbar-row">
                <button type="button" class="tbar-go" disabled="@(why != null)" title="@why" @onclick="() => Take(it, zone)">@(verb)@(m.Name)@(e.IsPot(it) ? "（含内容）" : "")到@(zone == ItemInstance.Carried ? "随身" : "地面")</button>
            </div>
            @if (why != null) { <div class="ca-note bad">@why</div> }
            else
            {
                <div class="ca-note @(c.Resets.Count > 0 ? "warn" : "")">@c.Text@(zone == ItemInstance.Carried ? $" · 拾取后随身{Ui.Kg(c.CarriedGramsAfter)}公斤" : "") · 不耗时</div>
            }
        }
        else if (m.Mode == Mode.Decant)
        {
            var water = m.Instance!;
            var zone = Target(m);
            var max = e.MaxDecant(s, water, zone, out var why);
            if (moveBusy) why = "行动进行中，暂不能整理物品";
            var n = Parse();
            var invalid = n < 1 || n > Math.Max(1, max);
            <TargetPicker Value="@zone" Here="@s.CurrentLocation" OnPick="v => target = v" />
            @if (why == null)
            {
                <div class="tbar-row">
                    @if (max > 1)
                    {
                        <button type="button" class="tbar-step" aria-label="减少" @onclick="() => SetN(Math.Max(1, Parse() - 1))">−</button>
                        <input @ref="input" type="text" inputmode="numeric" value="@text" @oninput="OnInput" aria-label="转移数量" />
                        <button type="button" class="tbar-step" aria-label="增加" @onclick="() => SetN(Math.Min(max, Parse() + 1))">+</button>
                    }
                    <button type="button" class="tbar-go" disabled="@invalid" @onclick="() => Decant(water, zone, max > 1 ? n : 1)">取出@(e.ItemName(water.ItemId))@(max > 1 ? (invalid ? "" : $"{n}份") : "1份")到@(zone == ItemInstance.Carried ? "随身" : "地面")</button>
                </div>
                <div class="ca-note">每份@(e.PotConfig(m.PotInstance!).UnitMl)毫升 · 可取@(max)份 · 不耗时</div>
            }
            else
            {
                <div class="tbar-row"><button type="button" class="tbar-go" disabled>取出@(e.ItemName(water.ItemId))1份到@(zone == ItemInstance.Carried ? "随身" : "地面")</button></div>
                @* 与上面自用按钮的原因相同（如被水煮预留）时只写一次（试玩修复 B9） *@
                @if (!m.UseId.HasValue || G.Preview(ActionRequest.UseInstance(m.UseId.Value)).Reason != why)
                {
                    <div class="ca-note bad">@why</div>
                }
            }
        }
        else if (m.Mode == Mode.None && !m.UseId.HasValue)
        {
            <div class="ca-note">@m.Hint</div>
        }
        @if (m.Mode != Mode.None && m.Hint != null) { <div class="ca-note">@m.Hint</div> }
    </div>
}

@code {
    private enum Mode { None, Stack, Single, TakeOut, Decant }

    /// <summary>操作条模型：对象、来源、可转移数量与方式、可自用的实例。</summary>
    private sealed record Model(string Key, string ItemId, string Icon, string Name, string From, int Available, Mode Mode)
    {
        public int Max { get; init; }
        public bool ToCarried { get; init; }
        public int UnitGrams { get; init; }
        public int? ExpiresAt { get; init; }
        public string Owner { get; init; } = "";
        public ItemInstance? Instance { get; init; }
        public ItemInstance? PotInstance { get; init; }
        public int? UseId { get; init; }
        public string? Hint { get; init; }
        /// <summary>所选真实批次键（Q24）；转移只取这一批。</summary>
        public string? BatchKey { get; init; }
        /// <summary>所选批次里第一堆未预留的（转移的重量与卡数预演用）。</summary>
        public ItemInstance? Head { get; init; }
        /// <summary>随身同物品多批时的批次条（Q24 可展开选批次）；其余为 null。</summary>
        public List<ItemBatch>? Batches { get; init; }
    }

    private string BatchFresh(ItemBatch b) =>
        b.Spoiled ? "已腐败" : !b.ExpiresAt.HasValue ? "不会腐败" : Ui.Fresh(b.ExpiresAt.Value - G.S.GameMinute);

    private string BatchTitle(ItemBatch b) =>
        $"这一批×{b.Count}：{BatchFresh(b)}{(string.IsNullOrEmpty(b.GrantEventId) ? "" : " · 来源单独成批")}{(b.Reserved ? " · 正被当前行动预留" : "")}";

    private ElementReference input;
    private string text = "1";
    private string lastKey = "";
    private string? target;
    private bool using_;

    private Model? Build()
    {
        if (G.State == null || G.S.Progress.Dead) return null;
        var s = G.S;
        var e = G.E;
        var sel = G.Selected;
        var here = s.CurrentLocation;
        bool Here(ItemInstance i) { var p = e.PlaceOf(s, i); return p == ItemInstance.Carried || p == here; }
        int? UseOf(ItemInstance i) => GameEngine.CanSelfUse(e.Item(i.ItemId)) ? i.InstanceId : null;

        switch (sel.Kind)
        {
            case SelectionKind.PotLiquid:
            {
                var pot = sel.InstanceId is int pid ? e.FindItem(s, pid) : null;
                var water = pot == null ? null : e.PotLiquids(s, pot.InstanceId).FirstOrDefault(w => w.ItemId == sel.Id);
                if (pot == null || water == null || !Here(pot)) return null;
                return new Model($"liq:{pot.InstanceId}:{water.ItemId}", water.ItemId, water.ItemId, e.ItemName(water.ItemId),
                    $"{e.WherePath(s, pot)}／{e.ItemName(pot.ItemId)}#{pot.InstanceId}", water.Count, Mode.Decant)
                { Instance = water, PotInstance = pot, UseId = UseOf(water), Owner = water.Owner };
            }
            case SelectionKind.Tool when sel.InstanceId is int id:
            {
                var it = e.FindItem(s, id);
                if (it == null || !Here(it)) return null;
                var name = $"{e.ItemName(it.ItemId)}#{it.InstanceId}";
                if (it.InFacility || (it.InContainer && !e.IsLiquid(it)))
                    return new Model($"take:{id}", it.ItemId, it.ItemId, name, e.WherePath(s, it), 1, Mode.TakeOut)
                    { Instance = it, UseId = UseOf(it), Owner = it.Owner };
                if (it.Owner != ItemInstance.Carried && it.Owner != here) return null;
                var toCarried = it.Owner != ItemInstance.Carried;
                var free = it.ReservedBy == null && !e.IsLocked(s, it) ? 1 : 0;
                return new Model($"one:{id}", it.ItemId, it.ItemId, name, e.WherePath(s, it), free, Mode.Single)
                {
                    Instance = it, Owner = it.Owner, ToCarried = toCarried, UnitGrams = e.ItemGrams(s, it),
                    Max = toCarried ? G.MaxPickup(it.ItemId, free, it) : free, PotInstance = e.IsPot(it) ? it : null, UseId = UseOf(it),
                };
            }
            case SelectionKind.ItemGroup:
            {
                if (sel.Owner != ItemInstance.Carried && sel.Owner != here) return null;
                var all = s.Items.Where(i => i.Owner == sel.Owner && i.ItemId == sel.Id).ToList();
                if (all.Count == 0) return null;
                var toCarried = sel.Owner != ItemInstance.Carried;
                var from = sel.Owner == ItemInstance.Carried ? "随身" : $"{e.LocName(sel.Owner)}地面";
                // Q24：自用与转移都作用于所选真实批次（默认最前合法可用批次）；批次全被预留时仍给出那一批，让按钮写真实原因
                var batches = e.BatchesOf(s, sel.Owner, sel.Id);
                var chosen = G.CurrentBatch(sel.Owner, sel.Id, batches)!;
                var useInst = chosen.Stacks.FirstOrDefault(i => i.ReservedBy == null && !e.IsSpoiled(s, i)) ?? chosen.Stacks[0];
                var available = chosen.Reserved ? 0 : chosen.Count;
                var head = chosen.Stacks.FirstOrDefault(i => i.ReservedBy == null);
                var batchPick = batches.Count > 1 && sel.Owner == ItemInstance.Carried;
                return new Model($"grp:{sel.Owner}:{sel.Id}", sel.Id, sel.Id, e.ItemName(sel.Id), from, available, available == 1 ? Mode.Single : Mode.Stack)
                {
                    ToCarried = toCarried, Owner = sel.Owner, ExpiresAt = chosen.ExpiresAt, BatchKey = chosen.Key, UnitGrams = e.Item(sel.Id).WeightGrams,
                    Max = toCarried ? G.MaxPickup(sel.Id, available, head) : available, UseId = UseOf(useInst), Head = head,
                    Batches = batchPick ? batches : null,
                    Hint = batches.Count > 1 && !batchPick ? $"共{batches.Count}批，转移先取最早到期的有效批次（{BatchFresh(chosen)}）" : null,
                };
            }
        }
        return null;
    }

    private string Target(Model m) => target ?? (m.Mode == Mode.Decant || m.Mode == Mode.TakeOut
        ? (m.Instance != null && G.E.PlaceOf(G.S, m.Instance) == ItemInstance.Carried ? G.S.CurrentLocation : ItemInstance.Carried)
        : ItemInstance.Carried);

    /// <summary>选中的对象或它的可转移数量一变，就把数量与目标重置为默认（数量对转移生效，自用永远是1份）。</summary>
    private void SyncDefault(Model m)
    {
        var key = $"{m.Key}|{m.BatchKey}|{m.Available}";
        if (key == lastKey) return;
        var sameObject = lastKey.StartsWith(m.Key + "|");
        lastKey = key;
        if (!sameObject) target = null;
        text = m.Mode == Mode.Stack ? (m.ToCarried ? Math.Max(1, Math.Min(m.Available, m.Max)) : m.Available).ToString() : "1";
    }

    private static IEnumerable<(StatId, double)> Affected(ItemUseConfig u, double health)
    {
        if (u.Satiety != 0) yield return (StatId.Satiety, u.Satiety);
        if (u.Hydration != 0) yield return (StatId.Hydration, u.Hydration);
        if (health != 0) yield return (StatId.Health, health);
        if (u.Morale != 0) yield return (StatId.Morale, u.Morale);
    }

    private int Parse() => int.TryParse(text.Trim(), out var v) ? v : 0;

    private void OnInput(ChangeEventArgs ev) => text = new string((ev.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());

    private void SetN(int v) => text = Math.Max(1, v).ToString();

    private void Step(int d, Model m) => SetN(Math.Clamp(Parse() + d, 1, Math.Max(1, m.Available)));

    private async Task Use(int instanceId)
    {
        if (using_) return;
        using_ = true;
        try { await G.StartAction(ActionRequest.UseInstance(instanceId)); }
        finally { using_ = false; }
    }

    private void Go(Model m, int n)
    {
        var s = G.S;
        if (G.E.IsBusy(s) || G.Running) return;
        if (n < 1 || n > m.Available || (m.ToCarried && n > m.Max)) return;
        if (m.Instance != null) G.TransferOne(m.Instance.Owner, m.Instance.ItemId, m.Instance.InstanceId);
        else G.TransferBatch(m.Owner, m.ItemId, m.ExpiresAt, n, m.ToCarried, batchKey: m.BatchKey);
        // 这一堆全部转走后收起操作条
        if (m.Instance == null && !s.Items.Any(i => i.Owner == m.Owner && i.ItemId == m.ItemId)) G.ClearSelection();
    }

    private const string ButcherTitle = "处理尸体";
    private const string FuseTitle = "吞噬融合";

    private async Task Fuse(ActionRequest r)
    {
        if (using_) return;
        using_ = true;
        G.Hover(null);
        try { await G.StartAction(r); }
        finally { using_ = false; }
    }

    private async Task Butcher(ActionRequest r)
    {
        G.Hover(null);
        await G.StartAction(r);
    }

    private void PutInFire(int potId)
    {
        if (G.E.IsBusy(G.S) || G.Running) return;
        G.Instant(InstantRequest.PutInFire(potId));
    }

    private void Take(ItemInstance it, string zone)
    {
        if (G.E.IsBusy(G.S) || G.Running) return;
        G.TransferOne(it.Owner, it.ItemId, it.InstanceId, zone);
    }

    private void Decant(ItemInstance water, string zone, int n)
    {
        if (G.E.IsBusy(G.S) || G.Running) return;
        var liquid = water.ItemId;
        var res = G.Instant(InstantRequest.Decant(water.InstanceId, zone, n));
        // 锅里这种水取完了：选中跟到目标区的同类堆（新卡或并入已有堆），不留“假选中”（试玩修复 B1）
        if (res.Ok && G.Selected.Kind == SelectionKind.None) G.FollowToGroup(zone, liquid);
    }
}
