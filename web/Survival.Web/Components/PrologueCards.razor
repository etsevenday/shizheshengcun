@inherits GameComponent

@* 设施栏的人物组与可查看对象（开发计划 v0.9 B13，S15 §5、A10-TUTOR §6）：
   人物卡（首个 NPC 卡框架：B13 只有来客程望，B14 城市岗位在内核 NpcsHere 里扩展）与火堆/棚/床同栏共存，“交谈”0 分钟，不占物资卡与队伍容量；
   固定文书/路标卡（PRO15 救助残页、村庄南口路标）“查看”0 分钟，可重读。当前主目标指向的那张卡轻量点亮（细金框，不遮按钮）。
   试玩修复 M269：两种卡改用资源卡同一套设施行布局（res-card：上图下文、右侧单个主按钮，卡高跟设施行），不再超出设施行被当前地面栏盖住；
   点卡片本身也直接交谈/查看；“远行准备”入口移到任务框与任务册。 *@
@{
    var s = G.S;
    var e = G.E;
    var npcs = e.NpcsHere(s);
    var docs = e.DocumentsHere(s);
    var focus = G.TutorialFocus;
    var busy = G.Running;
}
@if (npcs.Count > 0)
{
    <div class="desk-group people">
        <div class="dg-title">人物</div>
        <div class="dg-cards">
            @foreach (var n in npcs)
            {
                var why = busy ? "行动进行中" : n.TalkBlocked;
                var id = n.NpcId;
                var post = n.Kind == "post";
                var companion = n.Kind == "companion";
                var items = n.ServiceCount + n.QuestCount;
                var tip = post
                    ? $"{n.Name}：{n.FactionName}·{n.Role}（{n.KindLabel}）。{n.Status}。{n.RecruitText}。{(n.QuestText.Length > 0 ? n.QuestText + "。" : "")}点卡片或“交谈”开始（不耗时，不赠物资、不改变身体状态；有可接的委托时交谈即接取）{(items > 0 ? "；“事项”查看可办的服务与委托" : "")}"
                    : companion
                        ? $"{n.Name}（固定队友·{n.Role}）：{n.Background}。{n.RecruitText}。点卡片或“{n.ActionLabel}”（0分钟）"
                        : $"{n.Name}：{n.Role}。{n.Status}。点卡片或“交谈”开始（不耗时，不赠物资、不改变身体状态；不是队友）";
                <ObjectCard @key="@("npc-" + id)" Id="@($"npc-{id}")" CssClass="@($"res-card npc-card{(post || companion ? " post-card" : "")}{(focus == "npc:" + id ? " tut-lit" : "")}")" Title="@n.Name" Badge="@(post || companion ? n.KindLabel : n.HasNews ? "来客" : "可交谈")" BadgeClass="@(n.HasNews ? "new" : "")"
                            Tooltip="@tip" OnClick="() => Talk(id, why)">
                    <Art><img class="npc-portrait" src="img/portraits/unknown.svg" alt="@($"{n.Name}（临时形象）")" draggable="false" /></Art>
                    <ChildContent>
                        @if (post || companion) { <div class="oc-line" title="@($"{n.FactionName} · {n.Role}")">@n.Role</div> }
                        <div class="oc-line" title="@($"{n.Role} · {n.Status}")">@(why ?? n.Status)</div>
                    </ChildContent>
                    <Footer>
                        <button type="button" class="loc-btn res-btn" disabled="@(why != null)" title="@(why ?? $"{n.ActionLabel}（0分钟）")"
                                @onclick="() => Talk(id, why)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                            <strong>@n.ActionLabel</strong><small>0分钟</small>
                        </button>
                        @if (items > 0)
                        {
                            <button type="button" class="loc-btn res-btn" title="查看这里可办的事项与委托（浏览不耗时）"
                                    @onclick="() => G.OpenCityServices(id)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <strong>事项</strong><small>@(items)项</small>
                            </button>
                        }
                    </Footer>
                </ObjectCard>
            }
        </div>
    </div>
}
@if (docs.Count > 0)
{
    <div class="desk-group docs">
        <div class="dg-title">可查看</div>
        <div class="dg-cards">
            @foreach (var d in docs)
            {
                var why = busy ? "行动进行中" : d.ReadBlocked;
                var id = d.Id;
                <ObjectCard @key="@("doc-" + id)" Id="@($"doc-{id}")" CssClass="@($"res-card doc-card{(d.Choices.Count > 0 ? " choice-card" : "")}{(focus == "doc:" + id ? " tut-lit" : "")}")" Title="@d.Title"
                            Tooltip="@($"{d.Title}：{d.Status}。点卡片或“查看”阅读（不耗时，不移动、不揭开未知地点；可重读）")" OnClick="() => Read(id, why)">
                    <Art>@Icons.Markup(id == "village_south_sign" ? "route" : "placeholder")</Art>
                    <ChildContent>
                        <div class="oc-line" title="@d.Status">@(why ?? d.Status)</div>
                    </ChildContent>
                    <Footer>
                        @if (d.Choices.Count > 0)
                        {
                            @foreach (var ch in d.Choices)
                            {
                                var cid = ch.Id;
                                <button type="button" class="loc-btn res-btn" disabled="@(why != null)" title="@(why ?? $"{ch.Label}（0分钟，不改变身体状态）")" aria-label="@ch.Label"
                                        @onclick="() => Read(id, why, cid)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <strong>@ShortChoice(ch)</strong><small>0分钟</small>
                                </button>
                            }
                        }
                        else
                        {
                            <button type="button" class="loc-btn res-btn" disabled="@(why != null)" title="@(why ?? "查看（0分钟）")"
                                    @onclick="() => Read(id, why)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                <strong>查看</strong><small>0分钟</small>
                            </button>
                        }
                    </Footer>
                </ObjectCard>
            }
        </div>
    </div>
}

@code {
    private void Talk(string id, string? why)
    {
        if (why != null) { G.Notice = why; G.Notify(); return; }
        G.TalkNpc(id);
    }

    /// <summary>
    /// 告示选项按钮上的短名（试玩修复 M306 A2：完整选项名放进 title/aria-label；原长名在 1280×720 下把两个按钮撑高，上沿被卡片裁掉）。
    /// </summary>
    private static string ShortChoice(CityChoiceView ch) => ch.Id switch
    {
        "academy_pass_read_only" => "只看记录",
        "academy_pass_decline_experiment" => "拒绝试验",
        _ => ch.Label,
    };

    private void Read(string id, string? why, string? choice = null)
    {
        if (why != null) { G.Notice = why; G.Notify(); return; }
        // 有选项的告示（r07 观察区通行）点卡片本身只提示先选范围
        if (choice == null && G.E.DocumentsHere(G.S).FirstOrDefault(d => d.Id == id)?.Choices.Count > 0) { G.Notice = "先选择通行范围"; G.Notify(); return; }
        G.ReadDocument(id, choice);
    }
}
