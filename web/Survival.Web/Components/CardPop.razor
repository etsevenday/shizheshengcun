@inherits GameComponent

@* 选卡操作浮窗（S14 §18.3、S07 联动；开发假设 H11）：选中物品卡/锅/锅里的水或食材/火堆直烤食材后，操作（食用、饮用、转移数量、
   取出、放入火堆……）统一放在脱离文档流、不撑高所属行的局部盘里；B31c 起按 Q324 在屏幕中央打开（原锚卡下方、翻转规则不再用）。
   锚点是被选中元素的 id="card-sel"（同屏只有一个选中对象）。× / Esc 只收起（清选中），不执行；锚点滚出或消失时收起。
   浮窗内仍是 CardActions（根节点 .tbar：app.js 的数字键/回车跳转依赖它），每次渲染按真实状态重算，失效对象不留旧按钮。
   另一个就近浮窗（移动、接近、点火工具菜单）打开时先让位，survivalPop 同一时刻只定位一个浮窗。 *@
@* M120：菜单（含战斗菜单）打开时让位，浮窗不压在菜单遮罩之上。B32d（逐字稿 §1.5 Q390）起菜单期间只隐藏（menu-hidden，display:none）、不卸载，
   盘内数量、去向等状态保留，关菜单后仍有效的原盘原样恢复，不用重新点来源卡（显示条件 CardPopShown 仍不含菜单期间） *@
@* B31c：同一显示条件另有 GameSession.CardPopShown（中央行动位据此判断有没有居中局部盘），两处须一致 *@
@* B45（FACPROC 第 3 条、Q548）：火堆加工菜单开着时不弹；火堆里的锅、水、食材只在右栏只读，执行在中央加工菜单（同 CardPopShown） *@
@* B32d（逐字稿 §1.5 Q378）：来源卡被新开的面板盖住时按来源失效收盘但保留选中（CardPopCovered）；玩家重新点来源卡（Select/PickBatch）再打开 *@
@if (G.State != null && G.Pop == null && G.FeedPending == null && !G.IgniteMenuOpen && !G.DialogueLocked && !G.OverflowPending && !G.DuplicateWeaponsPending
     && !G.CardPopCovered && G.Panel != GameSession.FireMenuPanel && G.Selected.Kind is SelectionKind.ItemGroup or SelectionKind.Tool or SelectionKind.PotLiquid
     && G.InFireCrumbs(G.Selected) == null)
{
    var pot = PotOf();
    var menuHide = G.MenuOpen || G.BattleMenuOpen ? " menu-hidden" : "";
    <AnchorPop AnchorId="card-sel" Title="" Place="below,above,right,left" Bound=".center" CssClass="@((pot != null ? "card-pop pot" : "card-pop") + menuHide)" OnClose="G.ClearSelection" OnCovered="G.CoverCardPop">
        @* 锅（或锅里的水/食材）：先放所选对象的操作（主按钮固定在浮窗上部可见，M78），再展开锅的完整内容（内容多时在自己的区内滚动；M77-B2） *@
        @if (G.CityBrowsing)
        {
            @* B24（A10-CITY §3、S07 中枢联动归档 1）：鸟瞰打开时第四行只看详情（右栏），会消费/转移/穿戴/融合/开始行动的入口不提交 *@
            <div class="tbar city-readonly" role="note"><b>鸟瞰浏览中 · 仅查看</b><span>@GameSession.CityReadOnlyText</span></div>
        }
        else
        {
            <CardActions />
            @if (pot != null) { <PotCard Pot="pot" Expanded="true" /> }
        }
    </AnchorPop>
}

@code {
    /// <summary>所选对象所属的锅：锅本身、锅里的水（PotLiquid）或锅里的一份食材；都不是为 null。</summary>
    private ItemInstance? PotOf()
    {
        var s = G.S;
        var e = G.E;
        var sel = G.Selected;
        if (sel.Kind == SelectionKind.PotLiquid && sel.InstanceId is int pid) return e.FindItem(s, pid);
        if (sel.Kind != SelectionKind.Tool || sel.InstanceId is not int id) return null;
        var it = e.FindItem(s, id);
        if (it == null) return null;
        if (e.IsPot(it)) return it;
        return it.InContainer ? e.ContainerOf(s, it) : null;
    }
}
