@inherits GameComponent

@* 状态说明弹层：六项求生状态，以及 v0.6 新增的免疫、病毒（非 Stats 键，人物页与左栏同源）。 *@
@{
    var key = G.Panel!.Substring("status:".Length);
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    StatId? id = Stats.All.Any(x => GameEngine.StatKey(x) == key) ? Stats.All.First(x => GameEngine.StatKey(x) == key) : null;
}

<div class="status-pop" role="dialog" aria-label="状态说明" style="left:240px;top:120px">
    @if (id is StatId sid)
    {
        var v = s.Stats.Get(sid);
        var th = cfg.Thresholds[key];
        <h3>@GameEngine.StatName(sid) <small class="muted">@Ui.N(v)/@Ui.T(s.Stats.Max(sid))</small></h3>
        <p>@Ui.StatExplain(e, sid)</p>
        <div class="lines">
            <div><span>提醒阈值</span><b>@(th.Inclusive ? "≤" : "<")@Ui.T(th.Value)</b></div>
            <div><span>当前</span><b class="@(th.IsBelow(v) ? "warn-text" : "")">@(v <= 0 && sid != StatId.Health ? "已归零" : th.IsBelow(v) ? "低于阈值" : "正常")</b></div>
            @if (sid == StatId.Hydration && e.ActiveConditions(s).FirstOrDefault(c => c.Id == "diarrhea") is ActiveCondition d)
            {
                <div><span>@d.Name</span><b class="warn-text">@(d.RemainingMinutes > 0 ? $"还剩{Clock.Duration(d.RemainingMinutes)}" : "持续中")</b></div>
            }
            @if (sid == StatId.Energy)
            {
                <div><span>工作倍率</span><b>@(th.IsBelow(v) ? $"×{Ui.T(cfg.WorkFactors.LowEnergy)}（低体力）" : "正常")</b></div>
            }
        </div>
    }
    else if (key == "immunity")
    {
        var (ir, _, why) = e.CurrentBodyRates(s);
        <h3>免疫力 <small class="muted">@Ui.N(s.Body.Immunity)/@Ui.T(cfg.Immunity.Max)</small></h3>
        <p>@Ui.ImmunityExplain(e)</p>
        <div class="lines">
            <div><span>按当前状态每小时</span><b class="@(ir < 0 ? "warn-text" : "")">@Ui.SignedT(ir)</b></div>
            <div><span>构成</span><b>@(why.Count == 0 ? "无增减（浏览与等待本身不改变免疫）" : string.Join("，", why))</b></div>
            <div><span>咬伤感染概率</span><b>@Ui.Pct(e.ExposureChance(s.Body.Immunity))（只有丧尸咬击命中且造成伤害才判定）</b></div>
        </div>
    }
    else
    {
        var b = s.Body;
        var (_, vr, _) = e.CurrentBodyRates(s);
        <h3>病毒 <small class="muted">@(b.Infected ? $"{Ui.N(b.VirusLoad)}/{Ui.T(cfg.Infection.ZombificationAtLoad)}" : "未感染")</small></h3>
        <p>@Ui.VirusExplain(e)</p>
        <div class="lines">
            <div><span>状态</span><b class="@(b.Infected ? "danger-text" : "")">@(b.Infected ? "已感染" : "未感染")</b></div>
            @if (b.Infected)
            {
                <div><span>按当前免疫每小时</span><b class="@(vr > 0 ? "warn-text" : "good-text")">@Ui.SignedT(vr)</b></div>
                <div><span>连续高免疫</span><b>@Clock.Duration(b.HighImmunityMinutes) / @Clock.Duration(cfg.Infection.NaturalCure.Minutes)（还需病毒≤@Ui.T(cfg.Infection.NaturalCure.LoadAtMost)）</b></div>
            }
        </div>
    }
    <button class="secondary" @onclick="Close">知道了</button>
</div>

@code {
    private void Close()
    {
        G.Panel = null;
        G.Notify();
    }
}
