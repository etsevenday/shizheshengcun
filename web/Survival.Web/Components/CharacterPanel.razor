@inherits GameComponent

@* 右栏“人物”一级页（S14 §12.1、S12 §7）：基础属性紧凑简表（名称、当前/上限、短标记），点任一属性在右栏原位打开二级说明页，Esc 返回一级；
   熟练度与词条只显示摘要 + 详情入口。异常状态列表已移到左栏属性下方的图标（S14 §12.2）；携带重量/负重规则板块已删除
   （左栏携重摘要、物品自身重量与负重校验保留，S06 §7）。数据与左栏同源（Stats、Body、SkillViews），查看不执行任何玩法。 *@
@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    var charPage = G.CharPage;
}
@if (charPage != null)
{
    <AttrDetail Page="@charPage" />
}
else
{
    var day = e.IsDaylight(s.GameMinute);
    var body = s.Body;
    var skills = e.SkillViews(s);
    var top = skills.OrderByDescending(x => x.Level).ThenByDescending(x => x.Xp).FirstOrDefault();
    <div class="detail-scroll char-panel" data-wheel="y">
        @* 读档升级说明、被拒绝操作的原因等提示：默认人物页也要看得到 *@
        @if (G.Notice != null) { <div class="notice">@G.Notice</div> }
        <div class="char-top">
            <b>人物</b>
            <span class="muted">@(day ? "白昼" : "夜间") · @(e.LocName(s.CurrentLocation))@(e.IsSheltered(s, s.CurrentLocation) ? "（遮蔽）" : "（露天）")</span>
        </div>

        <div class="attr-table" role="list" aria-label="基础属性">
            @foreach (var id in Stats.All)
            {
                var v = s.Stats.Get(id);
                var th = cfg.Thresholds[GameEngine.StatKey(id)];
                var below = th.IsBelow(v);
                var zero = v <= 0 && id != StatId.Health;
                var cls = zero || (id == StatId.Health && below) ? "critical" : below ? "warning" : "";
                var key = "stat:" + GameEngine.StatKey(id);
                <button type="button" role="listitem" class="attr-row @cls" @onclick="() => G.OpenCharPage(key)" title="@($"查看{GameEngine.StatName(id)}的作用、阈值与效果")">
                    <span class="ar-name">@GameEngine.StatName(id)</span>
                    <span class="ar-val">@Ui.N(v)<small>/@Ui.T(s.Stats.Max(id))</small></span>
                    <span class="ar-tag">@(zero ? "归零" : below ? "偏低" : "")</span>
                    <span class="ar-go" aria-hidden="true">›</span>
                    <span class="ar-bar track"><i style="width:@Ui.Bar(v, s.Stats.Max(id))%"></i></span>
                </button>
            }
            <button type="button" role="listitem" class="attr-row @(body.Immunity < 40 ? "warning" : "")" @onclick='() => G.OpenCharPage("immunity")' title="查看免疫力的作用与当前变化">
                <span class="ar-name">免疫力</span>
                <span class="ar-val">@Ui.N(body.Immunity)<small>/@Ui.T(cfg.Immunity.Max)</small></span>
                <span class="ar-tag">@(body.Immunity < 40 ? "偏低" : body.Immunity >= cfg.Infection.NaturalCure.ConsecutiveImmunityAtLeast ? "高免疫" : "")</span>
                <span class="ar-go" aria-hidden="true">›</span>
                <span class="ar-bar track"><i style="width:@Ui.Bar(body.Immunity, cfg.Immunity.Max)%"></i></span>
            </button>
            <button type="button" role="listitem" class="attr-row @(body.Infected ? (body.VirusLoad >= 50 ? "critical" : "warning") : "")" @onclick='() => G.OpenCharPage("virus")' title="查看病毒的作用与当前变化">
                <span class="ar-name">病毒</span>
                <span class="ar-val">@(body.Infected ? Ui.N(body.VirusLoad) : "未感染")@if (body.Infected) {<small>/@Ui.T(cfg.Infection.ZombificationAtLoad)</small>}</span>
                <span class="ar-tag">@(body.Infected ? "已感染" : "")</span>
                <span class="ar-go" aria-hidden="true">›</span>
                <span class="ar-bar track"><i style="width:@Ui.Bar(body.VirusLoad, cfg.Infection.ZombificationAtLoad)%"></i></span>
            </button>
        </div>

        <div class="char-sum">
            <button type="button" class="sum-row" @onclick='() => G.OpenCharPage("skills")' title="查看8项熟练度的等级与经验">
                <span class="sum-name">熟练度</span>
                <span class="sum-val">@(skills.Count)项@(top != null && top.Level > 0 ? $" · 最高{top.Name}{top.Level}级" : " · 均为0级")</span>
                <span class="ar-go" aria-hidden="true">详情 ›</span>
            </button>
            <button type="button" class="sum-row" @onclick='() => G.OpenCharPage("traits")' title="查看人物词条">
                <span class="sum-name">词条</span>
                <span class="sum-val">@(s.Traits.Count == 0 ? "暂无" : string.Join("、", s.Traits.Select(t => t.Label)))</span>
                <span class="ar-go" aria-hidden="true">详情 ›</span>
            </button>
        </div>
    </div>
    <div class="detail-foot">
        <div class="under">点属性看说明 · 查看不耗时；状态图标在左栏</div>
    </div>
}
