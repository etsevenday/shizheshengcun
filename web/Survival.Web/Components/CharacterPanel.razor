@inherits GameComponent

@* 右栏“人物”一级页（S14 §18.2 取代 §12.1 属性简表、S12 §7）：常态只放熟练度、词条两块，各自展开/收起；基础属性数值只在左栏，
   点左栏属性在右栏原位打开二级说明页（AttrDetail），Esc 返回一级。异常状态列表已移到左栏属性下方的图标（S14 §12.2）；携带重量/负重规则板块已删除
   （左栏携重摘要、物品自身重量与负重校验保留，S06 §7）。数据与左栏同源（Stats、Body、SkillViews），查看不执行任何玩法。 *@
@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    var charPage = G.CharPage;
}
@if (charPage != null)
{
    <AttrDetail Page="@charPage" />
}
else
{
    var day = e.IsDaylight(s.GameMinute);
    var body = s.Body;
    var skills = e.SkillViews(s);
    var top = skills.OrderByDescending(x => x.Level).ThenByDescending(x => x.Xp).FirstOrDefault();
    <div class="detail-scroll char-panel" data-wheel="y">
        @* 读档升级说明、被拒绝操作的原因等提示：默认人物页也要看得到 *@
        @if (G.Notice != null) { <div class="notice">@G.Notice</div> }
        <div class="char-top">
            <b>人物</b>
            <span class="muted">@(day ? "白昼" : "夜间") · @(e.LocName(s.CurrentLocation))@(e.IsSheltered(s, s.CurrentLocation) ? "（遮蔽）" : "（露天）")</span>
        </div>

        @* S14 §18.2：右栏人物常态只放熟练度与词条两块，各自展开/收起（折叠后标题与摘要仍可见）；基础属性数值只在左栏，
           点左栏属性在右栏原位看说明（AttrDetail）。 *@
        <section class="char-fold @(_skillsOpen ? "open" : "")" aria-label="熟练度">
            <button type="button" class="fold-head" aria-expanded="@_skillsOpen" @onclick="() => _skillsOpen = !_skillsOpen">
                <span class="fold-name">熟练度</span>
                <span class="fold-sum">@(skills.Count)项@(top != null && top.Level > 0 ? $" · 最高{top.Name}{top.Level}级" : " · 均为0级")</span>
                <span class="fold-arrow" aria-hidden="true">@(_skillsOpen ? "▾" : "▸")</span>
            </button>
            @if (_skillsOpen)
            {
                <div class="skill-list">
                    @foreach (var sk in skills)
                    {
                        <div class="skill-row">
                            <b>@sk.Name</b><span>@(sk.Level)级</span>
                            <div class="track thin"><i style="width:@Ui.Bar(sk.Xp, sk.NextXp)%"></i></div>
                            <small class="muted">经验@(sk.Xp)/@(sk.NextXp)</small>
                        </div>
                    }
                </div>
            }
        </section>
        <section class="char-fold @(_traitsOpen ? "open" : "")" aria-label="词条">
            <button type="button" class="fold-head" aria-expanded="@_traitsOpen" @onclick="() => _traitsOpen = !_traitsOpen">
                <span class="fold-name">词条</span>
                <span class="fold-sum">@(s.Traits.Count == 0 ? "暂无" : $"{s.Traits.Count}条")</span>
                <span class="fold-arrow" aria-hidden="true">@(_traitsOpen ? "▾" : "▸")</span>
            </button>
            @if (_traitsOpen)
            {
                @if (s.Traits.Count == 0)
                {
                    <div class="risk none">还没有词条。</div>
                }
                @foreach (var t in s.Traits)
                {
                    <div class="trait-row q-@t.Quality" title="直接攻击伤害平加（在技能/招式/站位/暴击乘算后、扣护甲前；推挡与出血不加）">
                        <b>@t.Label</b><small>@(t.Quality == "green" ? "绿色" : t.Quality)</small>
                    </div>
                }
            }
        </section>
    </div>
    <div class="detail-foot">
        <div class="under">基础属性在左栏，点左栏属性看说明 · 查看不耗时</div>
    </div>
}

@code {
    private bool _skillsOpen = true;
    private bool _traitsOpen = true;
}
