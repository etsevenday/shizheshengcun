@inherits GameComponent

@* 右栏“人物”一级页（S14 §18.2 取代 §12.1 属性简表、S12 §7）：常态只放熟练度、词条两块，各自展开/收起；基础属性数值只在左栏，
   点左栏属性在右栏原位打开二级说明页（AttrDetail），Esc 返回一级。异常状态列表已移到左栏属性下方的图标（S14 §12.2）；携带重量/负重规则板块已删除
   （左栏携重摘要、物品自身重量与负重校验保留，S06 §7）。数据与左栏同源（Stats、Body、SkillViews），查看不执行任何玩法。 *@
@{
    var s = G.S;
    var e = G.E;
    var cfg = e.Config;
    var charPage = G.CharPage;
    // S14 截图复核 §C：两块各自的展开/收起是玩家偏好（档案×角色×板块），不是组件字段，组件重建/切菜单/刷新/读档都恢复最近选择
    var equipOpen = G.IsFoldOpen(UiFoldPrefs.Equip);
    var skillsOpen = G.IsFoldOpen(UiFoldPrefs.Skills);
    var traitsOpen = G.IsFoldOpen(UiFoldPrefs.Traits);
    var foldLocked = G.FoldLocked;
    var lockWhy = foldLocked ? "对白或战斗进行中，暂不能折叠" : null;
}
@if (charPage != null)
{
    <AttrDetail Page="@charPage" />
}
else
{
    var day = e.IsDaylight(s.GameMinute);
    var body = s.Body;
    var skills = e.SkillViews(s);
    var top = skills.OrderByDescending(x => x.Level).ThenByDescending(x => x.Xp).FirstOrDefault();
    var passives = e.SurvivalPassiveLines(s.Player);
    <div class="detail-scroll char-panel" data-wheel="y">
        @* 读档升级说明、被拒绝操作的原因等提示：默认人物页也要看得到 *@
        @if (G.Notice != null) { <div class="notice">@G.Notice</div> }
        <div class="char-top">
            <b>人物</b>
            <span class="muted">@(day ? "白昼" : "夜间") · @(e.LocName(s.CurrentLocation))@(e.IsSheltered(s, s.CurrentLocation) ? "（遮蔽）" : "（露天）")</span>
        </div>

        @* B3（S06 全系统更新目标 §1、R02 §1、A05 §5、A10 §7；开发计划 v0.9 B3 H9）：七个穿戴槽的装备区，折叠偏好同熟练度/词条（档案×角色×板块）。
           穿戴物不占五张物资卡、重量计本人；点槽内武器可卸下回随身，卡位不够时给“放当前地面”。战斗中只读（不给卸下按钮；两把已锁定，用战斗区页签切换）。
           全屏整备面板留到后续批次（A10 §7.1 建议，Q41）。 *@
        <section class="char-fold equip-fold @(equipOpen ? "open" : "")" aria-label="装备" data-fold="equip">
            <button type="button" class="fold-head" aria-expanded="@equipOpen" disabled="@foldLocked" title="@(lockWhy ?? (equipOpen ? "收起装备（记住你的选择）" : "展开装备（记住你的选择）"))" @onclick="() => G.ToggleFold(UiFoldPrefs.Equip)">
                <span class="fold-name">装备</span>
                <span class="fold-sum">@EquipSummary()</span>
                <span class="fold-arrow" aria-hidden="true">@(equipOpen ? "▾" : "▸")</span>
            </button>
            @if (equipOpen)
            {
                <div class="equip-list">
                    @if (e.DuplicateWeaponsIllegal(s))
                    {
                        <div class="ca-note bad">两个武器槽是同类型武器（每人同类型最多1件）：安全空闲时会弹出整理窗。</div>
                    }
                    @foreach (var slot in EquipSlots.All)
                    {
                        var it = e.WornItem(s, GameState.PlayerId, slot);
                        var weaponSlot = EquipSlots.IsWeaponSlot(slot);
                        <div class="equip-row @(it == null ? "empty" : "")" data-slot="@slot">
                            <span class="eq-slot">@EquipSlots.Name(slot)</span>
                            @if (it == null)
                            {
                                <span class="eq-item muted" title="@($"选中随身或当前地面的{(weaponSlot ? "武器、盾或器具" : EquipSlots.Name(slot))}卡，点“装备到{EquipSlots.Name(slot)}”")">空</span>
                            }
                            else
                            {
                                @* R90b：名称（带实例号，同随身卡 R90f）一行、耐久/弹仓一行、按钮另起一行，1280 下三样都可读；战斗中只读不给按钮 *@
                                var name = e.ItemName(it.ItemId);
                                var why = e.UnequipBlocked(s, GameState.PlayerId, slot, false);
                                var groundWhy = e.UnequipBlocked(s, GameState.PlayerId, slot, true);
                                var stat = EquipStat(it);
                                <div class="eq-main" title="@($"{name}#{it.InstanceId} · {(e.WeaponKindOf(it.ItemId) is string wk ? WeaponKinds.Name(wk) : EquipSlots.Name(slot))} · {e.QualityName(it)}色 · {stat} · {Ui.KgText(e.ItemGrams(s, it))}（计入本人重量，不占物资卡）")">
                                    <span class="eq-item"><span class="eq-ico" aria-hidden="true">@Icons.Markup(it.ItemId)</span><span class="eq-name q-@(it.Quality ?? "white")">@name#@it.InstanceId</span><span class="eq-kg">@Ui.KgText(e.ItemGrams(s, it))</span></span>
                                    <small class="eq-stat">@stat</small>
                                    @if (s.Battle == null)
                                    {
                                        <span class="eq-btns">
                                            <button type="button" class="eq-btn" disabled="@(why != null)" title="@(why ?? $"卸下{name}，放回随身（占一张物资卡）")" @onclick="() => G.Unequip(slot, false)">卸下</button>
                                            @if (it.MaxDurability.HasValue && e.RepairRecipe is RecipeConfig rrc)
                                            {
                                                @* M120：穿戴中的装备直接在装备区维修（与卡下“维修”同一请求、预测与禁用原因） *@
                                                var rreq = new ActionRequest { Type = ActionType.Craft, TargetId = rrc.Id, InstanceId = it.InstanceId };
                                                var rwhy = G.Running ? "行动进行中" : e.CanStart(s, rreq);
                                                var rf = e.RepairFraction(s, rrc);
                                                var rto = Math.Min(it.MaxDurability.Value, (it.Durability ?? 0) + it.MaxDurability.Value * rf);
                                                <button type="button" class="eq-btn" disabled="@(rwhy != null)" title="@(rwhy ?? $"维修{name}：耐久{Ui.N(it.Durability ?? 0)}→{Ui.N(rto)}（恢复最大耐久{Ui.Pct(rf)}），消耗废金属1、零件1；单击直接开始")"
                                                        @onclick="() => Repair(rreq)">维修·@(rrc.BaseMinutes)分钟</button>
                                                @if (rwhy != null && !rwhy.Contains("耐久已满")) { <small class="eq-stat eq-why">维修：@rwhy</small> }
                                                else if (rwhy == null) { <small class="eq-stat">维修后耐久@(Ui.N(rto))</small> }
                                            }
                                            @if (why != null && groundWhy == null)
                                            {
                                                <button type="button" class="eq-btn alt" title="@($"把{name}放到{e.LocName(s.CurrentLocation)}地面")" @onclick="() => G.Unequip(slot, true)">放当前地面</button>
                                            }
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @* B4 H10：装备效果合计（R16 上限）：战斗类只显示，求生类生效中 *@
                    <div class="ca-note equip-fx">@e.BaseDefenseLine()</div>
                    @foreach (var line in e.EquipSummaryLines(s))
                    {
                        <div class="ca-note equip-fx">@line</div>
                    }
                    <div class="ca-note">穿戴不占@(e.MaxRootCards)张物资卡，重量计入本人（穿戴@(Ui.KgText(e.WornGrams(s)))）@(s.Battle != null ? " · 战斗中两把武器已锁定，用战斗区武器Ⅰ/武器Ⅱ页签切换" : " · 选中随身或当前地面的装备卡可装备，两武器同类型最多1件")</div>
                </div>
            }
        </section>

        @* S14 §18.2：右栏人物常态只放熟练度与词条两块，各自展开/收起（折叠后标题与摘要仍可见）；基础属性数值只在左栏，
           点左栏属性在右栏原位看说明（AttrDetail）。 *@
        <section class="char-fold @(skillsOpen ? "open" : "")" aria-label="熟练度" data-fold="skills">
            <button type="button" class="fold-head" aria-expanded="@skillsOpen" disabled="@foldLocked" title="@(lockWhy ?? (skillsOpen ? "收起熟练度（记住你的选择）" : "展开熟练度（记住你的选择）"))" @onclick="() => G.ToggleFold(UiFoldPrefs.Skills)">
                <span class="fold-name">熟练度</span>
                <span class="fold-sum">@(skills.Count)门@(top != null && top.Level > 1 ? $" · 最高{top.Name}{top.Level}级" : " · 均为1级")</span>
                <span class="fold-arrow" aria-hidden="true">@(skillsOpen ? "▾" : "▸")</span>
            </button>
            @if (skillsOpen)
            {
                @* B5（A06 §1/§4、开发计划 v0.9 B5 H10）：十五门按战斗/医疗/求生分组，等级/上限、本级经验或“满级”；悬停一门看它的 5 个专属技能。
                   完整 75 节点的成长页在 B10。 *@
                <div class="skill-list">
                    @foreach (var grp in new[] { ("combat", "战斗"), ("both", "医疗（战内外）"), ("survival", "求生") })
                    {
                        <div class="skill-group muted">@grp.Item2</div>
                        @foreach (var sk in skills.Where(x => x.Category == grp.Item1))
                        {
                            <div class="skill-row" data-skill="@sk.Id" title="@SkillNodesTip(sk)">
                                <b>@sk.Name</b><span>@(sk.Level)/@(sk.Cap)级</span>
                                <div class="track thin"><i style="width:@(sk.Maxed ? 100 : Ui.Bar(sk.Xp, sk.NextXp))%"></i></div>
                                <small class="muted">@(sk.Maxed ? "满级，不再获得经验" : $"经验{sk.Xp}/{sk.NextXp}")</small>
                            </div>
                        }
                    }
                    <div class="skill-group muted">已获得的求生被动（@(passives.Count)个）</div>
                    @foreach (var line in passives)
                    {
                        <div class="skill-passive" data-passive>@line</div>
                    }
                    @foreach (var line in e.CraftingStandingLines(s.Player))
                    {
                        <div class="skill-passive" data-standing>@line</div>
                    }
                </div>
            }
        </section>
        <section class="char-fold @(traitsOpen ? "open" : "")" aria-label="词条" data-fold="traits">
            <button type="button" class="fold-head" aria-expanded="@traitsOpen" disabled="@foldLocked" title="@(lockWhy ?? (traitsOpen ? "收起词条（记住你的选择）" : "展开词条（记住你的选择）"))" @onclick="() => G.ToggleFold(UiFoldPrefs.Traits)">
                <span class="fold-name">词条</span>
                <span class="fold-sum">@(s.Traits.Count == 0 ? "暂无" : $"{s.Traits.Count}条")</span>
                <span class="fold-arrow" aria-hidden="true">@(traitsOpen ? "▾" : "▸")</span>
            </button>
            @if (traitsOpen)
            {
                @if (s.Traits.Count == 0)
                {
                    <div class="risk none">还没有词条。</div>
                }
                @foreach (var t in s.Traits)
                {
                    <div class="trait-row q-@t.Quality" title="直接攻击伤害平加（在技能/招式/站位/暴击乘算后、扣护甲前；推挡与出血不加）">
                        <b>@t.Label</b><small>@(t.Quality == "green" ? "绿色" : t.Quality)</small>
                    </div>
                }
            }
        </section>
    </div>
    <div class="detail-foot">
        <div class="under">基础属性在左栏，点左栏属性看说明 · 查看不耗时</div>
    </div>
}

@code {
    /// <summary>一门熟练度的 5 个专属技能（悬停提示）：“1级 斩击：伤害×1.00（已解锁）”。</summary>
    private string SkillNodesTip(SkillView sk) =>
        string.Join("\n", sk.Nodes.Select(n => $"{n.Level}级 {n.Name}：{n.Text}（{(sk.Level >= n.Level ? (n.IsSurvival ? G.E.PassiveStatus(G.S.Player, n) : G.E.SkillExecOf(n.Id) is { NeedsAllies: true } ? "已解锁，需要队友（队友参战在后续版本）" : "已解锁，装上这一类武器后在该武器页使用") : "未解锁")}）"));

    private async Task Repair(ActionRequest r)
    {
        G.Hover(null);
        await G.StartAction(r);
    }

    /// <summary>装备区第二行：品质词条、耐久与弹仓（“绿·校准 · 耐久67.00/80.00 · 弹仓3/8”；木弓写随身箭矢数），没有的项不写；重量在名称行右侧。</summary>
    private string EquipStat(ItemInstance it)
    {
        var s = G.S;
        var e = G.E;
        var parts = new List<string>();
        if (it.Quality is "green" or "blue")
            parts.Add(it.Affixes is { Count: > 0 } af ? $"{e.QualityName(it)}·{string.Join("、", af.Select(id => e.Affix(id)?.Name ?? id))}" : $"{e.QualityName(it)}（无附加词条）");
        if (it.Durability.HasValue && it.MaxDurability.HasValue)
            parts.Add(it.Durability.Value <= 0 ? "已损坏（效果暂停）" : $"耐久{GameEngine.DurabilityText(it)}");
        if (e.Weapon(it.ItemId) is { } w)
        {
            if (w.UsesMagazine) parts.Add($"弹仓{it.LoadedAmmo}/{w.MagazineCapacity}");
            else if (w.ConsumesLooseAmmo && w.AmmoId != null) parts.Add($"随身{e.ItemName(w.AmmoId)}{s.Items.Where(i => i.IsCarried && i.ItemId == w.AmmoId).Sum(i => i.Count)}");
        }
        // 重量放在名称行右侧（B3a 试玩修复 6：第二行原先在 1280/1600/1920 都折行，“0.90公斤”单独掉一行）
        return string.Join(" · ", parts);
    }

    /// <summary>装备折叠后的摘要：“武器Ⅰ 石刀 · 武器Ⅱ 空”。</summary>
    private string EquipSummary()
    {
        var s = G.S;
        var e = G.E;
        string Name(string slot) => e.WornItem(s, GameState.PlayerId, slot) is ItemInstance it ? e.ItemName(it.ItemId) : "空";
        var others = EquipSlots.All.Where(x => !EquipSlots.IsWeaponSlot(x)).Count(x => e.WornItem(s, GameState.PlayerId, x) != null);
        return $"武器Ⅰ {Name(EquipSlots.Weapon1)} · 武器Ⅱ {Name(EquipSlots.Weapon2)}{(others > 0 ? $" · 其他{others}件" : "")}";
    }
}

