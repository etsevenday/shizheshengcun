@inherits GameComponent

@* 安全屋卡（S09 X2.2—X2.6、S14 设施栏；开发计划 v0.9 B17）：设施栏“设施”组。
   B17 试玩修复 B1：名称+角标一行（长名省略，悬停看全名），状态一行，两个短按钮单独占卡底一行平分（不再挤在右列竖排、角标不压按钮）。
   屋外：未建写第一条不合格原因（悬停列全），点卡打开“营地建造·建安全屋”；已建“进入”（0 分钟）与“面板”。
   屋内：屋内设施与柜子容量，“出门”与“柜子”。别处有已建安全屋时，未建卡另给“返程 ▸”（只看路线，不传送，B2）。 *@
@{
    var s = G.S;
    var e = G.E;
    var here = s.CurrentLocation;
    var inside = s.CurrentZone == GameState.SafehouseZone;
    var status = e.SafehouseStatus(s, here);
    var built = status == GameEngine.SafehouseBuiltStatus;
    var name = e.SafehouseName(s, here);
    var reasons = built ? new List<string>() : e.SafehouseSiteReasons(s, here);
    var doorWhy = built ? e.SafehouseDoorBlocked(s, !inside) : null;
    var interior = s.Locations[here].Safehouse?.Interior;
    var fav = s.FavoriteSafehouse == here;
    var elsewhere = e.BuiltSafehouses(s).Any(l => l != here);
    string badge = inside ? "屋内" : built ? "已建成" : status == GameEngine.SafehouseBuildingStatus ? "施工中" : "未建造";
    string line;
    string? cab = null, lead = null;
    if (inside)
    {
        var parts = new List<string> { interior?.BedBuilt == true ? "有床" : "无床", interior?.FireBuilt == true ? "有火" : "无火" };
        line = $"{string.Join("·", parts)}·柜{(e.CabinetGrams(s, here) / 1000.0):0.#}/{e.CabinetCapacityGrams / 1000}公斤";
        cab = $"柜{(e.CabinetGrams(s, here) / 1000.0):0.#}/{e.CabinetCapacityGrams / 1000}公斤";
        lead = string.Join("·", parts) + "·";
    }
    else if (built) line = "遮蔽·有柜";
    else if (status == GameEngine.SafehouseBuildingStatus) line = "施工中：完工后才有门与柜子";
    else line = reasons.Count == 0 ? $"可以建：{e.SafehouseRecipe.BaseMinutes}分钟" : reasons[0];
    // 卡名：地点名已在场景卡上，这里只写“安全屋”或玩家改的名字（全名在悬停），★ 表示常用
    var custom = s.Locations[here].Safehouse?.Name;
    var title = (built && !string.IsNullOrWhiteSpace(custom) ? custom! : "安全屋") + (fav ? " ★" : "");
    var tip = inside ? $"{name}屋内：{line}。不会遇到普通遭遇，时间、饮食与伤病照常推进；出门0分钟"
        // B41e2（Q446 ⑦【交开发方定】最小删词）：新版敌踪下敌踪在场本身不禁进出，删「敌踪待处理」
        : built ? (e.CardsV2(s) ? $"{name}：点“进入”0分钟进屋（战斗、行动中不能进出）" : $"{name}：点“进入”0分钟进屋（战斗、敌踪待处理、行动中不能进出）")
        : reasons.Count == 0 ? $"可以建：{string.Join("、", e.SafehouseRecipe.Inputs.Select(kv => $"{e.ItemName(kv.Key)}{kv.Value}"))}，{e.SafehouseRecipe.BaseMinutes}分钟；点击打开营地建造"
        : "建安全屋还差：" + string.Join("；", reasons);
}
@* B32b（逐字稿 §1.5 Q372）：重墨 V2 卡模板，副标沿当前屋内／屋外／施工／未建摘要，角标沿现行状态；进出与面板入口仍在卡上（Q347） *@
<ObjectCard Ink2="true" PeekId="@Peek.Card("safehouse")" CssClass="k2-fac k2-sh sh-card" Title="@title" Badge="@badge" BadgeClass="@(built ? "built" : "unbuilt")" Dashed="@(!built)"
            Tooltip="@tip" OnClick="Open" AriaLabel="@($"{title}，{badge}：{line}")" SubTitle="@tip"
            PeekSubText="@(cab != null ? lead + cab : line + (!built && reasons.Count > 1 ? $"（另{reasons.Count - 1}条）" : ""))">
    <Art>@Icons.Markup("shelter")</Art>
    <SubContent>
        @* N5：柜子重量段不拆行 *@
        <div class="oc-line">@if (cab != null) {@lead<span class="nw">@cab</span>} else {@line@(!built && reasons.Count > 1 ? $"（另{reasons.Count - 1}条）" : "")}</div>
    </SubContent>
    <Footer>
        @if (built)
        {
            <button type="button" class="loc-btn res-btn" disabled="@(doorWhy != null)" title="@(doorWhy ?? (inside ? "出门回到外部（0分钟）" : "进入安全屋（0分钟）"))"
                    @onclick="Door" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><strong>@(inside ? "出门" : "进入")</strong></button>
            <button type="button" class="loc-btn res-btn" title="@(inside ? "柜子存取、改名、收藏与返程路线" : "收藏、改名与返程路线（柜子只能在屋内存取）")"
                    @onclick="Panel" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><strong>@(inside ? "柜子" : "面板")</strong></button>
        }
        else if (elsewhere)
        {
            <button type="button" class="loc-btn res-btn" title="查看回已建安全屋的路线与合计分钟（只定位，不传送）"
                    @onclick="Panel" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"><strong>返程 ▸</strong></button>
        }
    </Footer>
</ObjectCard>

@code {
    private void Open()
    {
        var s = G.S;
        if (G.E.SafehouseBuilt(s, s.CurrentLocation)) { G.OpenPanel("safehouse"); return; }
        G.OpenPanel("craft", G.E.Config.Safehouse.BuildRecipe);
        G.CraftTab = "camp";
        G.Notify();
    }

    private void Door()
    {
        var inside = G.S.CurrentZone == GameState.SafehouseZone;
        G.EngineDo(() => inside ? G.E.ExitSafehouse(G.S) : G.E.EnterSafehouse(G.S));
    }

    private void Panel() => G.OpenPanel("safehouse");
}
