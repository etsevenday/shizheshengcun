@inherits GameComponent
@inject IJSRuntime JS

@if (Battle)
{
    @* 战斗菜单（开发计划 v0.5 假设 10）：只含继续、保存并返回标题；不含脱战，Esc 不能关掉覆盖层免费脱战 *@
    <div class="overlay" role="dialog" aria-label="战斗菜单" style="inset:14px auto auto 50%;transform:translateX(-50%);width:440px">
        <div class="overlay-head">
            <h2>@(G.S.Battle != null ? $"战斗菜单 · 第{G.S.Battle.Round}轮" : "菜单 · 敌踪选择中")</h2>
            <button class="secondary" @onclick="() => G.ToggleBattleMenu(false)">继续<kbd>Esc</kbd></button>
        </div>
        <div style="padding:18px;display:flex;flex-direction:column;gap:14px">
            @if (G.S.Battle != null)
            {
                <div class="tiny muted">战斗中不能通过菜单脱战；撤退请用指令条的“撤退”。每条指令与敌方行动后都已自动保存。</div>
            }
            else
            {
                <div class="tiny muted">发现敌踪后要先在中间选择“接敌”或“绕行”，菜单不能跳过这个选择；返回标题后再继续仍停在这里。</div>
            }
            <button class="secondary" @onclick="() => G.ToggleBattleMenu(false)">继续</button>
            <button class="secondary" @onclick="ToTitle">保存并返回标题</button>
        </div>
    </div>
    return;
}
<div class="overlay" role="dialog" aria-label="菜单" style="inset:14px auto auto 50%;transform:translateX(-50%);width:520px">
    <div class="overlay-head">
        <h2>菜单</h2>
        <button class="secondary" @onclick="Close">关闭<kbd>Esc</kbd></button>
    </div>
    <div class="menu-scroll" style="padding:18px;display:flex;flex-direction:column;gap:14px">
        <div>
            <div class="eyebrow" style="margin-bottom:6px">动画速度（每5分钟时间段）</div>
            <div class="btn-row">
                @foreach (var (label, ms) in new[] { ("快", 40), ("标准", 120), ("慢", 250) })
                {
                    var v = ms;
                    <button class="secondary @(G.SegmentDelayMs == ms ? "on" : "")" style="@(G.SegmentDelayMs == ms ? "border-color:var(--accent);color:var(--accent)" : "")" @onclick="() => SetSpeed(v)">@label</button>
                }
            </div>
        </div>
        <div class="lines">
            <div><span>种子</span><b>@G.S.Seed</b></div>
            <div><span>已推进时间段</span><b>@G.S.SegmentCount</b></div>
            <div><span>存档</span><b>本浏览器单槽，每段自动保存</b></div>
        </div>
        <button class="secondary" @onclick="Feedback">反馈与留言（F）</button>
        <button class="secondary" @onclick="ToTitle">返回标题（进度已保存）</button>
        @if (!confirmNew)
        {
            <button class="secondary danger" @onclick="() => confirmNew = true">重新开始…</button>
        }
        else
        {
            <div class="confirm-box">
                重新开始会清除当前存档，无法恢复。
                <div class="row">
                    <button class="secondary danger" @onclick="Restart">确认重新开始</button>
                    <button class="secondary" @onclick="() => confirmNew = false">取消</button>
                </div>
            </div>
        }
        @if (DebugBuild || DevMode)
        {
            <button class="secondary" @onclick="G.DebugFill">调试：在当前地面放一批物资</button>
        }
        @if (DevMode)
        {
            @* 开发入口（地址加 ?dev=1 才显示）：开发测试箱、放敌人、立即敌踪、感染与尸变测试。正式流程不可见。 *@
            <div class="dev-box">
                <div class="eyebrow">开发入口（?dev=1）</div>
                <div class="btn-row">
                    <button class="secondary" @onclick="DevKit">开发测试箱</button>
                    <button class="secondary" @onclick="DevEncounter">本地敌人立即形成敌踪</button>
                    <button class="secondary" @onclick="() => DevVirus(20)">感染（病毒20）</button>
                    <button class="secondary" @onclick="() => DevVirus(99.9)">病毒99.9（尸变测试）</button>
                    <button class="secondary" @onclick="DevDay2">跳到第2日08:00</button>
                    <button class="secondary" @onclick="DevMeds">药品各1（绷带/抗生素/特效药）</button>
                    <button class="secondary" @onclick="DevRepairMats">维护材料（废金属+零件）</button>
                    <button class="secondary" @onclick="DevSubstance">普通活性物质1份</button>
                    <button class="secondary" @onclick="DevRecipeMats">金属矛/弩/弩矢材料各1次</button>
                </div>
                @* B4（开发计划 v0.9 B4 H10）：一组七件装备（每槽一件）按指定品质放当前地面；B4 新导入物品按类放当前地面 *@
                <div class="btn-row">
                    <button class="secondary" @onclick='() => DevEquip("white")'>给一组装备（白）</button>
                    <button class="secondary" @onclick='() => DevEquip("green")'>给一组装备（绿）</button>
                    <button class="secondary" @onclick='() => DevEquip("blue")'>给一组装备（蓝）</button>
                    <button class="secondary" @onclick='() => DevNewItems("material")'>新物品（材料）</button>
                    <button class="secondary" @onclick='() => DevNewItems("food")'>新物品（食品）</button>
                    <button class="secondary" @onclick='() => DevNewItems("medical")'>新物品（医疗）</button>
                    <button class="secondary" @onclick="() => DevSkills(5, true)">求生熟练度全部5级</button>
                    <button class="secondary" @onclick="() => DevSkills(10, true)">求生熟练度全部10级</button>
                    <button class="secondary" @onclick="() => DevSkills(1, false)">熟练度全部回到1级</button>
                    @* B7（A06 §2）：战斗/医疗技能按 1/3/5/7/10 级解锁；技能器具一组放当前地面，供逐页试技能 *@
                    <button class="secondary" @onclick="() => DevSkills(3, false)">熟练度全部3级（含战斗）</button>
                    <button class="secondary" @onclick="() => DevSkills(5, false)">熟练度全部5级（含战斗）</button>
                    <button class="secondary" @onclick="() => DevSkills(7, false)">熟练度全部7级（含战斗）</button>
                    <button class="secondary" @onclick="() => DevSkills(10, false)">熟练度全部10级（含战斗）</button>
                    <button class="secondary" @onclick="DevSkillKit">技能器具一组（各类武器/盾/指挥/医疗与耗材）</button>
                    @* B6（R03 §3）：战术训练阶位 0/1/2 → 每次普通激活 3/4/5AP；训练入口（h03）在后续批次 *@
                    <button class="secondary" @onclick="() => DevTier(0)">战术训练阶位0（3AP）</button>
                    <button class="secondary" @onclick="() => DevTier(1)">战术训练阶位1（4AP）</button>
                    <button class="secondary" @onclick="() => DevTier(2)">战术训练阶位2（5AP）</button>
                </div>
                @* B7c（Q62）：容量 C 来自存档里的真实解锁事实；营区登记、两种关键记录的系统在后续批次，这里只供试玩造事实 *@
                <div class="btn-row">
                    <button class="secondary" @onclick='() => DevCapacity("hub_registered")'>记下营区登记（C2）</button>
                    <button class="secondary" @onclick='() => DevCapacity("church_route_record")'>记下教会路线记录（C3）</button>
                    <button class="secondary" @onclick='() => DevCapacity("academy_safety_record")'>记下学院安全记录（两种都有C4）</button>
                    <button class="secondary" @onclick="() => DevCapacity(null)">清除容量事实（回C1）</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugGiveWraps(G.S))">护拳绑带1件+制作材料</button>
                </div>
                @* B8（R08、A11 §6/§7）：正式招募任务（RN01—RN06）在后续批次，这里直接把六名命名角色登记入名册（同行未满 C 时直接编入） *@
                <div class="eyebrow">队伍（B8）：先记下容量事实再加人；营区＝临时营地</div>
                <div class="btn-row">
                    @foreach (var n in G.E.Config.Party.NamedCompanions)
                    {
                        var nid = n.ActorId;
                        <button class="secondary small-btn" @onclick="() => DevParty(st => G.E.DebugRecruit(st, nid))">加入名册：@n.Name</button>
                    }
                    <button class="secondary small-btn" @onclick="() => DevParty(st => G.E.DebugAddEscort(st))">加入通用护送员（跳过登记与30分钟）</button>
                </div>
                @foreach (var r in G.S.Roster.Where(r => !r.Dead))
                {
                    var rid = r.ActorId;
                    <div class="btn-row">
                        <span class="tiny">@r.Name（@(G.S.Party.Contains(rid) ? "同行" : "候补")）：</span>
                        <button class="secondary small-btn" @onclick="() => DevParty(st => G.E.DebugToggleActive(st, rid))">切换在队/候补</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "health1"))'>健康→1</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "virus79"))'>病毒→79</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "food41"))'>饱食水分→41</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "spear0"))'>武器耐久→0</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "kill"))'>队友死亡</button>
                    </div>
                }
                @{
                    // B7（A09 §1）：20 种新敌人只入数据、不进旧刷新池，只能从这里放出来试玩
                    var pooled = G.E.Config.WorldEnemies.Pools.Values.SelectMany(p => p.Values).SelectMany(l => l).Select(x => x.EnemyId).ToHashSet();
                }
                <div class="btn-row">
                    @foreach (var en in G.E.Config.Enemies.Where(x => pooled.Contains(x.Id)))
                    {
                        var id = en.Id;
                        <button class="secondary small-btn" @onclick="() => DevSpawn(id)">放@(en.Name)</button>
                    }
                </div>
                <div class="eyebrow">新敌人（A09，暂不刷新，只能从这里放）</div>
                <div class="btn-row">
                    @foreach (var en in G.E.Config.Enemies.Where(x => !pooled.Contains(x.Id)))
                    {
                        var id = en.Id;
                        <button class="secondary small-btn" @onclick="() => DevSpawn(id)" title="@($"{en.FamilyName}{(en.Elite ? "精英" : "")} · {en.Ap}AP · 己位{en.OwnSlots}→目标{en.TargetSlots}")">放@(en.Name)</button>
                    }
                </div>
            </div>
        }
        <div class="tiny muted">快捷键：M 地图 · C 手工制作 · R 休息 · L 日志 · F 反馈 · Esc 关闭当前面板。Esc 不会取消进行中的行动。</div>
    </div>
</div>

@code {
#if DEBUG
    private static readonly bool DebugBuild = true;
#else
    private static readonly bool DebugBuild = false;
#endif
    private bool confirmNew;

    [Parameter] public bool Battle { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private bool DevMode => Nav.Uri.Contains("dev=1");

    private void DevDone(string text)
    {
        G.Notice = text;
        G.Save();
        G.Panel = null;
        G.Notify();
    }

    private void DevMeds()
    {
        DevDone("绷带、抗生素、特效药各1（开发用）：" + G.E.DebugGiveCarriedOrGround(G.S, new[] { ("bandage", 1), ("antibiotics", 1), ("antiviral_cure", 1) }));
    }

    private void DevRepairMats()
    {
        DevDone("废金属、零件各1（开发用，可做一次工具维护）：" + G.E.DebugGiveCarriedOrGround(G.S, new[] { ("scrap", 1), ("parts", 1) }));
    }
    private void DevKit() => DevDone(G.E.DebugGiveDevKit(G.S));

    private void DevEquip(string quality) => DevDone(G.E.DebugGiveEquipmentSet(G.S, quality));

    private void DevNewItems(string kind) => DevDone(G.E.DebugGiveNewItems(G.S, kind));

    private void DevSkills(int level, bool survivalOnly) => DevDone(G.E.DebugSetSkillLevels(G.S, level, survivalOnly));

    private void DevTier(int tier) => DevDone(G.E.DebugSetTacticalTier(G.S, tier));

    private void DevCapacity(string? fact) => DevDone(G.E.DebugCapacityFact(G.S, fact));

    private void DevSkillKit() => DevDone(G.E.DebugGiveSkillKit(G.S));

    private void DevParty(Func<GameState, string> act)
    {
        G.DevParty(act);
        G.Panel = null;
        G.Notify();
    }

    private void DevSubstance()
    {
        var sub = G.E.Config.ActiveSubstance;
        var here = G.S.CurrentLocation;
        var made = G.E.CreateItems(G.S, sub.ItemId, 1, here, false, new ItemSource { GrantEventId = $"dev-{G.S.NextInstanceId}" }).Single();
        var picked = G.E.MaxPickup(G.S, made) >= 1 && G.E.DoInstant(G.S, InstantRequest.Pickup(made.InstanceId, 1)).Ok;
        DevDone(picked ? "普通白色活性物质1份已放到随身（开发用，融合无属性）。" : "普通白色活性物质1份放在当前地面（随身卡位已满；开发用，融合无属性）。");
    }

    private void DevRecipeMats()
    {
        var mats = new[] { "make_metal_spear", "make_crossbow", "make_bolts" }.SelectMany(rid => G.E.Recipe(rid).Inputs.Select(kv => (kv.Key, kv.Value)));
        DevDone("金属矛、弩、弩矢各一次的材料（开发用）：" + G.E.DebugGiveCarriedOrGround(G.S, mats));
    }

    private void DevEncounter() => DevDone(G.E.DebugForceEncounter(G.S) ? "已形成敌踪。" : "当前地点没有敌对敌人，或正在行动中。");

    private void DevVirus(double v) { G.E.DebugSetVirus(G.S, v); DevDone($"病毒设为{v}。"); }

    private void DevSpawn(string id)
    {
        if (G.E.DebugSpawnBlocked(G.S, G.S.CurrentLocation) is string why) { DevDone($"没有放置：{why}。"); return; }
        G.E.DebugSpawnEnemy(G.S, id, G.S.CurrentLocation);
        DevDone($"已在当前地点放置{G.E.Enemy(id).Name}。");
    }

    private void DevDay2()
    {
        var s = G.S;
        if (s.GameMinute < 1440 + 480) s.GameMinute = 1440 + 480;
        G.E.ResetWorldCursors(s);
        DevDone("已跳到第2日08:00（只改时钟，不结算身体消耗）。");
    }

    private void SetSpeed(int ms)
    {
        G.SegmentDelayMs = ms;
        G.Notify();
    }

    private async Task Feedback() => await JS.InvokeVoidAsync("survival.openFeedback");

    private void ToTitle()
    {
        G.Save();
        G.BackToTitle();
    }

    private void Restart()
    {
        G.ClearSave();
        G.NewGame();
    }

    private void Close()
    {
        G.Panel = null;
        G.Notify();
    }
}
