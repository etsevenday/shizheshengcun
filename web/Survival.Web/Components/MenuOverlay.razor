                <div class="eyebrow">三城鸟瞰与设施NPC卡（B24）：父节点首次到达自动打开一次；当前地点卡旁“主城鸟瞰”随时再开</div>
                <div class="btn-row">
                    <button class="secondary small-btn" title="记下营门登记授权与营区登记（同 B23 栏）" @onclick='() => DevDone(G.E.DebugExq(G.S, "register", "EXQ05"))'>记下营区登记</button>
                    @foreach (var (lid, label) in new[] { ("h01_gate", "营门"), ("h02_square", "营区广场"), ("h03_workshop", "营区工坊"), ("c02_church", "教会接待庭"), ("r02_academy", "科学院外院") })
                    {
                        var to = lid;
                        <button class="secondary small-btn" title="按实际到达处理（记到访、公开地点100%、接触事实、门槛重判）" @onclick="() => DevDone(G.E.DebugMapTeleport(G.S, to))">传送到@(label)</button>
                    }
                    <button class="secondary small-btn" title="记下“已听取教会公开路线说明”（训诫堂→典藏室开通，验证接待庭→训诫堂→典藏室）" @onclick='() => DevDone(G.E.DebugMapFact(G.S, "FA02_route_briefed"))'>记下教会路线简报</button>
                    <button class="secondary small-btn" title="清除各城“已自动展示”与待打开标记：再次到达父节点时自动打开一次" @onclick="() => DevDone(G.E.DebugResetCityOverview(G.S))">重置鸟瞰展示标记</button>
                </div>
                <div class="tiny muted">鸟瞰已展示：@(G.S.City.OverviewShown.Count == 0 ? "无" : string.Join("、", G.S.City.OverviewShown.Select(G.E.LocName)))@(G.S.City.OverviewPending != null ? $" · 待自动打开：{G.E.LocName(G.S.City.OverviewPending)}{(G.S.City.OverviewPendingLegacy ? "（旧档补显）" : "")}" : "")</div>
                @* B8（R08、A11 §6/§7）：正式招募任务（RN01—RN06）在后续批次，这里直接把六名命名角色登记入名册（同行未满 C 时直接编入） *@
                <div class="eyebrow">队伍（B8）：先记下容量事实再加人；营区＝临时营地</div>
                <div class="btn-row">
                    @foreach (var n in G.E.Config.Party.NamedCompanions)
                    {
                        var nid = n.ActorId;
                        <button class="secondary small-btn" @onclick="() => DevParty(st => G.E.DebugRecruit(st, nid))">加入名册：@n.Name</button>
                    }
                    <button class="secondary small-btn" @onclick="() => DevParty(st => G.E.DebugAddEscort(st))">加入通用护送员（跳过登记与30分钟）</button>
                </div>
                @* B9a：一步组出 2—4 人同行队伍（记下 C4 事实、按配置顺序编入命名角色），下一场战斗全员按编队号位入场 *@
                <div class="btn-row">
                    @for (var k = 2; k <= 4; k++)
                    {
                        var kk = k;
                        <button class="secondary small-btn" @onclick="() => DevParty(st => G.E.DebugQuickParty(st, kk))">组@(kk)人队（C4，直接编入）</button>
                    }
                    <button class="secondary small-btn" @onclick="() => DevParty(st => G.E.DebugGiveCompanionMeds(st))">同行队友各发药品（绷带/纱布/盐水各2）</button>
                    <button class="secondary small-btn" @onclick="() => DevParty(st => G.E.DebugPartyDrill(st))">全队木矛+信号哨（矛术5/指挥3，试架矛顺延与整队）</button>
                </div>
                @foreach (var r in G.S.Roster.Where(r => r.Present))
                {
                    var rid = r.ActorId;
                    <div class="btn-row">
                        <span class="tiny">@r.Name（@(G.S.Party.Contains(rid) ? "同行" : "候补")）：</span>
                        <button class="secondary small-btn" @onclick="() => DevParty(st => G.E.DebugToggleActive(st, rid))">切换在队/候补</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "health1"))'>健康→1</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "virus79"))'>病毒→79</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "food41"))'>饱食水分→41</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "food85"))'>饱食水分精神→85</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "wake50"))'>清醒→50</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "rested"))'>清醒95体力满</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "spear0"))'>武器耐久→0</button>
                        <button class="secondary small-btn" @onclick='() => DevParty(st => G.E.DebugActor(st, rid, "kill"))'>队友死亡</button>
                    </div>
                }
                @{
                    // B7（A09 §1）：20 种新敌人只入数据、不进旧刷新池，只能从这里放出来试玩
                    var pooled = G.E.Config.WorldEnemies.Pools.Values.SelectMany(p => p.Values).SelectMany(l => l).Select(x => x.EnemyId).ToHashSet();
                }
                <div class="btn-row">
                    @foreach (var en in G.E.Config.Enemies.Where(x => pooled.Contains(x.Id)))
                    {
                        var id = en.Id;
                        <button class="secondary small-btn" @onclick="() => DevSpawn(id)">放@(en.Name)</button>
                    }
                </div>
                <div class="eyebrow">其余敌人（A09；B20 起新区由人口区自然刷新、地牢有固定战，这里直接放到当前地点；城市与地牢房间不能放）</div>
                <div class="btn-row">
                    @foreach (var en in G.E.Config.Enemies.Where(x => !pooled.Contains(x.Id)))
                    {
                        var id = en.Id;
                        <button class="secondary small-btn" @onclick="() => DevSpawn(id)" title="@($"{en.FamilyName}{(en.Elite ? "精英" : "")} · {en.Ap}AP · 己位{en.OwnSlots}→目标{en.TargetSlots}")">放@(en.Name)</button>
                    }
                </div>
            </fieldset>
        }
        @* B43：键表与顶栏按钮同源（ShellKeys.TopTable），三处一致 *@
        <div class="tiny muted">快捷键：@ShellKeys.TopTable()。@ShellKeys.Esc 不会取消进行中的行动。</div>
    </div>
    <ExitSaveStatus />
    <div class="mm-foot">
        <button class="secondary" disabled="@(!ShellMenu.Enabled(ShellMenuItem.SaveToTitle, locked) || G.Saves?.WriteBlockedText != null)" title="@(lockTip ?? G.Saves?.WriteBlockedText)" @onclick="ToTitle">@ShellText.SaveToTitle</button>
        @* B31e（§1.3 Q353 选 A）：死亡结算页打开的菜单底部写「返回结算」，只收起菜单回到同一结算 *@
        <button class="primary" @ref="_first" @onclick="Close">@(dead ? ShellText.BackToSettlement : ShellText.ContinueGame) <kbd class="kc">@ShellKeys.Esc</kbd></button>
    </div>
</div>
</div>

@code {
    private string exqQuest = "EXQ05";   // B23 开发入口所选可选任务
#if DEBUG
    private static readonly bool DebugBuild = true;
#else
    private static readonly bool DebugBuild = false;
#endif
    private bool confirmNew;
    private string teleportTo = "m01_road";

    /// <summary>B11 开发入口可记的地图门槛事实（gate-contract factProducers；正式来源在 B13—B21）。再点一次清除。</summary>
    private static readonly (string Key, string Label)[] MapFacts =
    {
        ("camp_route_known", "来客路线已知（序章）"),
        ("checkpoint_obstruction_cleared", "检查哨路障已解决"),
        ("registration_authorized", "营门登记已授权"),
        ("hub_registered", "营区已登记"),
        ("FA02_route_briefed", "教会公开路线"),
        ("FA03_environment_briefed", "科学院环境路线"),
        ("academy_observation_pass", "观察通道确认"),
        ("FA02_record_credit", "教会记录资格"),
        ("trusted_legacy_QMAP02_completed", "旧档工业支援已完成（B14b 公共锻炉/军械台另一资格）"),
        ("FA03_record_credit", "科学院记录资格"),
        ("FA04_merged", "两份记录已合并"),
        ("communication_power_claimed", "警备仓备用电源已领取"),
    };

    [Parameter] public bool Battle { get; set; }
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private bool DevMode => Nav.Uri.Contains("dev=1");
    private string genDungeon = "d01";
    private string expDungeon = "d01";
    private string fixedTo = "d01_07";

    private string FixedLabel(Survival.Core.Config.FixedBattleConfig f) =>
        $"{G.E.LocName(f.NodeId)}（{f.NodeId}{(f.Guardian ? "，守卫" : "")}：{string.Join("、", f.EnemyOrder.Select(x => G.E.Enemy(x).Name))}）";

    private void DevRegionSpawn()
    {
        var added = G.E.DebugRegionSpawnCheck(G.S);
        DevDone((added.Count > 0 ? "人口区刷新：" + string.Join("、", added.Select(w => $"{G.E.Enemy(w.EnemyId).Name}（{G.E.LocName(w.LocationId)}）")) : $"人口区这次没有刷新：{G.E.RegionSpawnIdleReason(G.S)}") + "。" + G.E.DebugPopulationText(G.S));
    }

    /// <summary>B14 城市开发传送点（岗位所在地；r02 为科学院外院、没有岗位）。</summary>
    private static readonly (string, string)[] QuestRecords =
    {
        ("d01_08_unique", "圣所旧路档册"), ("d02_08_unique", "封存区安全规程"), ("d03_08_unique", "警备仓备用电源"), ("d04_07_unique", "通信站联络日志"),
    };

    private static readonly (string, string)[] QuestStops =
    {
        ("c05_admonition", "训诫堂（纪牧）"), ("c06_archive", "典藏室（宋烛）"), ("r05_testing", "检测室（季闻）"),
        ("r06_archive", "档案室（邵宁）"), ("r08_observation", "隔离观察区（尹珂）"),
        // B15a（Q152）：RN02—RN06 前置要的探索地点（到了再点“当前地点探索度→100%”）与沈禾的营区医务室
        ("a01_yard", "铁路货场（RN02 探索）"), ("b01_school", "安置学校（RN03 探索）"), ("w02_forest", "林间营址（RN04 探索）"),
        ("b03_hospital", "医院外院（RN06 探索）"), ("h04_infirmary", "营区医务室（沈禾）"),
    };

    private static readonly (string, string)[] CityStops =
    {
        ("h01_gate", "营门（陆衡·登记）"), ("h02_square", "营区广场（许安）"), ("h03_workshop", "营区工坊（罗铮·制作告示）"),
        ("h04_infirmary", "医务室（陈芷·换药/休息）"), ("h05_appraisal", "鉴定所（陶岑）"), ("h06_shelter", "收容所（杜穗）"),
        ("c02_church", "教会接待庭（祁闻）"), ("c04_alms", "施济处（白苓·配给）"), ("c07_sanctuary", "圣堂（傅珩·安静休息）"),
        ("r02_academy", "科学院外院"), ("r04_reception", "科学院接待处（温澄）"), ("r07_workshop", "试制工坊（何远·通行告示）"),
    };

    /// <summary>菜单打开时所在的真实地点（开发传送后据此判断是否离开了原地点）。</summary>
    private string? _locAtOpen;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _locAtOpen = G.State != null ? G.S.CurrentLocation : null;
        // Q387 / Q406：上一次菜单里「保存并返回标题」的失败提示与手动存档子页的失败只留在原画面，重新打开菜单时不带出来
        G.ExitSaveProblem = null;
        G.LeaveManualPage();
    }

    private void DevDone(string text)
    {
        // B31b 线上复验遗留（B31c 修）：开发传送离开原地点后，收起留在原地点的一级面板（事项盘等），与正常出发时 OpenPanel(null) 一致
        if (_locAtOpen != null && G.State != null && G.S.CurrentLocation != _locAtOpen && G.Panel != null) G.CloseAllPanels();
        // 试玩修复 M269 P8：先把内核事件（来客 Notice 等）送进结果提示，开发说明另写在 Notice，两条都能看到
        G.FlushEvents();
        G.Notice = text;
        G.Commit();
        G.SetMenu(false);
    }

    private void DevMeds()
    {
        DevDone("绷带、抗生素、特效药各1（开发用）：" + G.E.DebugGiveCarriedOrGround(G.S, new[] { ("bandage", 1), ("antibiotics", 1), ("antiviral_cure", 1) }));
    }

    private void DevRepairMats()
    {
        DevDone("废金属、零件各1（开发用，可做一次工具维护）：" + G.E.DebugGiveCarriedOrGround(G.S, new[] { ("scrap", 1), ("parts", 1) }));
    }
    private void DevKit() => DevDone(G.E.DebugGiveDevKit(G.S));

    private void DevEquip(string quality) => DevDone(G.E.DebugGiveEquipmentSet(G.S, quality));

    private void DevNewItems(string kind) => DevDone(G.E.DebugGiveNewItems(G.S, kind));

    private void DevSkills(int level, bool survivalOnly) => DevDone(G.E.DebugSetSkillLevels(G.S, level, survivalOnly));

    private void DevTier(int tier) => DevDone(G.E.DebugSetTacticalTier(G.S, tier));

    private void DevCapacity(string? fact) => DevDone(G.E.DebugCapacityFact(G.S, fact));

    private void DevSkillKit() => DevDone(G.E.DebugGiveSkillKit(G.S));

    private void DevParty(Func<GameState, string> act)
    {
        G.DevParty(act);
        G.SetMenu(false);
    }

    private void DevSubstance()
    {
        var sub = G.E.Config.ActiveSubstance;
        var here = G.S.CurrentLocation;
        var made = G.E.CreateItems(G.S, sub.ItemId, 1, here, false, new ItemSource { GrantEventId = $"dev-{G.S.NextInstanceId}" }).Single();
        var picked = G.E.MaxPickup(G.S, made) >= 1 && G.E.DoInstant(G.S, InstantRequest.Pickup(made.InstanceId, 1)).Ok;
        DevDone(picked ? "普通白色活性物质1份已放到随身（开发用，融合无属性）。" : "普通白色活性物质1份放在当前地面（随身卡位已满；开发用，融合无属性）。");
    }

    private void DevRecipeMats()
    {
        var mats = new[] { "make_metal_spear", "make_crossbow", "make_bolts" }.SelectMany(rid => G.E.Recipe(rid).Inputs.Select(kv => (kv.Key, kv.Value)));
        DevDone("金属矛、弩、弩矢各一次的材料（开发用）：" + G.E.DebugGiveCarriedOrGround(G.S, mats));
    }

    private void DevEncounter() => DevDone(G.E.DebugForceEncounter(G.S) ? "已形成敌踪。" : "当前地点没有敌对敌人，或正在行动中。");

    private void DevVirus(double v) { G.E.DebugSetVirus(G.S, v); DevDone($"病毒设为{v}。"); }

    private void DevSpawn(string id)
    {
        if (G.E.DebugSpawnBlocked(G.S, G.S.CurrentLocation) is string why) { DevDone($"没有放置：{why}。"); return; }
        G.E.DebugSpawnEnemy(G.S, id, G.S.CurrentLocation);
        DevDone($"已在当前地点放置{G.E.Enemy(id).Name}。");
    }

    private void DevRegionSpawn20()
    {
        var added = new List<Survival.Core.State.WorldEnemy>();
        for (var i = 0; i < 20; i++) added.AddRange(G.E.DebugRegionSpawnCheck(G.S));
        DevDone((added.Count > 0 ? $"人口区20次刷新出{added.Count}只：" + string.Join("、", added.Select(w => $"{G.E.Enemy(w.EnemyId).Name}（{G.E.LocName(w.LocationId)}）")) : $"人口区20次都没有刷新：{G.E.RegionSpawnIdleReason(G.S)}") + "。" + G.E.DebugPopulationText(G.S));
    }

    /// <summary>B22h：只往后拨时钟到第 day 日 08:00（不结算身体消耗），用于看稀有/强敌层开放。</summary>
    private void DevDayAt(int day)
    {
        var s = G.S;
        var at = (day - 1) * 1440 + 480;
        if (s.GameMinute < at) s.GameMinute = at;
        G.E.ResetWorldCursors(s);
        DevDone($"已跳到第{day}日08:00（只改时钟，不结算身体消耗；已过这个时刻则不动）。");
    }

    private void DevDay2()
    {
        var s = G.S;
        if (s.GameMinute < 1440 + 480) s.GameMinute = 1440 + 480;
        G.E.ResetWorldCursors(s);
        DevDone("已跳到第2日08:00（只改时钟，不结算身体消耗）。");
    }

    private async Task Feedback() => await JS.InvokeVoidAsync("survival.openFeedback");

    /// <summary>「保存并返回标题」（Q335 / Q387）：写每5分钟槽成功才回标题，失败留在菜单显示带槽名的失败句与「重试」。</summary>
    private void ToTitle() => G.SaveAndExit();

    private void Restart()
    {
        // Q386：只写新局初始快照到每5分钟槽；手动槽与每日槽不动
        G.NewGame();
    }

    private void Close()
    {
        G.ExitSaveProblem = null;
        G.SetMenu(false);
    }

    /// <summary>进入手动存档子页（Q405）。子页状态在会话里（BM2 Q500：ESC 先回菜单首页，由 GameScreen 的 ESC 路由同一处理）。</summary>
    private void OpenManual() => G.OpenManualPage();

    /// <summary>手动存档子页「返回」回到游戏菜单（Q405）；离开时清除该次失败与重试（Q406）。与 ESC 同一入口 CloseManualPage。</summary>
    private void LeaveManual() => G.CloseManualPage();

    /// <summary>终止远征确认窗（PXd）：先收菜单再开确认窗。</summary>
    private void OpenAbort()
    {
        G.SetMenu(false);
        G.OpenAbort();
    }

    private ElementReference _first;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 菜单打开时键盘焦点进菜单：回车／空格落在菜单自己的按钮上，不会推进背后的对白或下达战斗指令（Q322「菜单不会消费对白继续键」）
        // BM2（Q500）：从手动存档子页（「返回」或 ESC）回到菜单首页时，焦点同样回到菜单底部关闭键
        var backFromManual = _wasManual && !G.ManualPageOpen;
        _wasManual = G.ManualPageOpen;
        if (firstRender || backFromManual)
        {
            try { await _first.FocusAsync(); } catch (Exception) { /* 渲染尚未完成或已关闭 */ }
        }
    }

    private bool _wasManual;
}
