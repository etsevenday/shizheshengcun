@inherits GameComponent
@inject IJSRuntime JS
@using Survival.Core.Save

@{
    // B31b（逐字稿 §1.1 Q322）：强制对白锁期间只开放关闭菜单、阅读／动画偏好与反馈；其余入口按原锁禁用，悬停写原锁的说明。
    // B31d（§1.2 Q333 选 A）：死亡结算页打开的菜单同样只开放这几项（其余入口禁用，不加说明），关闭回到同一结算
    var dead = G.S.Progress.Dead;
    var locked = G.DialogueLocked || dead;
    var lockTip = G.DialogueLocked && !dead ? "请先读完对话" : null;
}
@if (Battle)
{
    @* 战斗菜单（P05g；开发计划 v0.5 假设 10、B9 A10 §6.3）：阅读字体、动画速度、系统说明、反馈与留言、保存并返回标题、返回战斗；不含脱战，
       Esc 不能关掉战斗免费脱战（菜单已开时 Esc 回战场）。标题与可访问名称同一句（ShellText.BattleUiMenuTitle）。
       B41e3：旧版“敌踪选择”层已删，这一层只在实际战斗中出现。 *@
    var inBattle = G.S.Battle != null;
    var menuTitle = ShellText.BattleUiMenuTitle(inBattle);
    <div class="menu-scrim" role="presentation">
        <div class="menu-modal overlay" role="dialog" aria-modal="true" aria-label="@menuTitle">
            <div class="overlay-head mm-head">
                <h2>@menuTitle</h2>
            </div>
            <div class="mm-body" data-wheel="y">
                @if (inBattle)
                {
                    @* B40（S01 Q388）：战斗菜单正式说明句 *@
                    <div class="tiny muted">@SaveSlots.BattleMenuNote</div>
                    @if (G.S.Expedition != null)
                    {
                        @* B21（R03 D5）：战斗中菜单的“终止远征”只解释，必须先普通撤退 *@
                        <button class="secondary" disabled title="先在战斗里撤退">终止本次远征</button>
                        <div class="tiny muted">战斗中不能直接终止远征：先用指令条的“撤退”离开这场战斗（地牢里撤退会退回来路上没有敌人的房间），再从菜单或安全点终止。</div>
                    }
                }
                @* B31a（Q295、Q321）：阅读字体与动画速度，与常态菜单同一偏好；战斗与敌踪选择中都可调，只改呈现 *@
                <PresentationSettings />
                @if (inBattle)
                {
                    @* B9（A10 §6.3）：战斗菜单含系统说明（阅读暂停，不触发敌方行动、不推进世界时间）；对白锁期间禁用 *@
                    <button class="secondary" disabled="@(!ShellMenu.Enabled(ShellMenuItem.Help, locked))" title="@lockTip" @onclick='() => { G.ToggleBattleMenu(false); G.OpenBattleDrawer("help"); }'>@ShellText.Help</button>
                }
                <button class="secondary" @onclick="Feedback">@ShellText.Feedback</button>
            </div>
            <ExitSaveStatus />
            <div class="mm-foot">
                <button class="secondary" disabled="@(!ShellMenu.Enabled(ShellMenuItem.SaveToTitle, locked) || G.Saves?.WriteBlockedText != null)" title="@(lockTip ?? G.Saves?.WriteBlockedText)" @onclick="ToTitle">@ShellText.SaveToTitle</button>
                <button class="primary" @ref="_first" @onclick="() => G.ToggleBattleMenu(false)">@(inBattle ? ShellText.BackToBattle : ShellText.ContinueGame) <kbd class="kc">@ShellKeys.Esc</kbd></button>
            </div>
        </div>
    </div>
    return;
}
@if (G.ManualPageOpen && !dead)
{
    <ManualSavePage OnBack="LeaveManual" />
    return;
}
@* 游戏菜单（PXb；Q322）：盖在当前画面上的居中一层，关闭后回到原场景；对白锁、行动推进和暂停中也可打开，不提交、取消或恢复世界行动 *@
<div class="menu-scrim" role="presentation">
<div class="menu-modal overlay menu-top" role="dialog" aria-modal="true" aria-label="@ShellText.GameMenu">
    <div class="overlay-head mm-head">
        <h2>@ShellText.GameMenu</h2>
    </div>
    <div class="mm-body menu-scroll" data-wheel="y">
        @* B31a（Q295、Q321）：阅读字体与动画速度（浏览器偏好，取代原「动画速度（每5分钟时间段）」40／120／250 档） *@
        <PresentationSettings />
        <div class="lines">
            <div><span>种子</span><b>@G.S.Seed</b></div>
            <div><span>已推进时间段</span><b>@G.S.SegmentCount</b></div>
        </div>
        @* B31d（§1.2 Q336 选 B）：原标题页底部「原型 · … · 存档版本N」与浏览器存档说明移到种子行下；版本值取实际构建与当前存档格式。
           浏览器存档说明用 PXb 逐字「存档保存在当前浏览器。」（与原标题页「存档保存在本浏览器」同义，不重复显示两句） *@
        <div class="tiny muted" data-version-line>@ShellText.VersionLine(G.AppBuild, GameState.CurrentSchema)</div>
        <div class="tiny muted">@ShellText.SaveNote</div>
        @if (G.Saves is { } sv)
        {
            @* B40（S01 Q387）：「存档保存在当前浏览器。」下三行——每5分钟、每日06:00、最新一份手动档的本地日期时刻；
               未写入「尚未保存」、时刻缺失「保存时间未记录」；浏览器读不出这个槽时也写「尚未保存」（Q413 选 B；选档页仍按 Q403 显示读取失败原因） *@
            <div class="tiny muted save-times">
                <div>@(SaveSlots.MenuAuto5Prefix + G.SlotTimeText(sv.Auto5Time()))</div>
                <div>@(SaveSlots.MenuDailyPrefix + G.SlotTimeText(sv.DailyTime()))</div>
                <div>@(SaveSlots.MenuManualPrefix + G.SlotTimeText(sv.LatestManualTime()))</div>
            </div>
            @if (!dead)
            {
                @* Q385 / Q408-3 / Q411：普通游戏菜单的「手动存档」入口；不可用时显示第一条命中的实际原因（写权限优先）。
                   战斗、敌踪（战斗层菜单）与死亡结算菜单不提供入口。 *@
                var manualWhy = sv.ManualBlockedText(G.S);
                <button class="secondary" disabled="@(manualWhy != null)" title="@manualWhy" @onclick="OpenManual">@SaveSlots.ManualPageTitle</button>
                @if (manualWhy != null) { <div class="tiny muted">@manualWhy</div> }
            }
        }
        @if (G.S.Expedition != null || G.E.ExpeditionEnabled(G.E.DungeonAt(G.S.CurrentLocation)))
        {
            @* B21（R03 D5、A10 §7）：非战斗时从菜单发起终止远征（先看同一预估，可取消）；撤出中只说明不可取消 *@
            var abortWhy = G.E.CanAbortExpedition(G.S);
            if (G.S.Expedition?.IsExtracting == true)
            {
                @* B40（S01 Q388）：撤出中的游戏菜单正式说明句 *@
                <div class="tiny muted">@SaveSlots.ExtractMenuNote</div>
            }
            else
            {
                <button class="secondary danger" disabled="@(abortWhy != null || !ShellMenu.Enabled(ShellMenuItem.AbortExpedition, locked))" title="@(lockTip ?? abortWhy ?? "先看即时损失与返程时间，确认前可以取消")" @onclick="OpenAbort">终止本次远征…</button>
                @if (abortWhy != null) { <div class="tiny muted">@abortWhy</div> }
            }
        }
        <button class="secondary" @onclick="Feedback">@ShellText.Feedback</button>
        @if (!confirmNew)
        {
            <button class="secondary danger" disabled="@(!ShellMenu.Enabled(ShellMenuItem.Restart, locked))" title="@lockTip" @onclick="() => confirmNew = true">@SaveSlots.RestartMenuButton</button>
        }
        else
        {
            @* B40（S01 Q386 / Q409-3）：局中「重新开始…」无论每5分钟槽是否为空都确认，与标题新游戏共用文案与「开始新游戏」「返回」 *@
            <div class="confirm-box">
                @SaveSlots.NewGameConfirmText
                <div class="row">
                    <button class="secondary danger" disabled="@locked" @onclick="Restart">@SaveSlots.NewGameConfirmButton</button>
                    <button class="secondary" @onclick="() => confirmNew = false">@SaveSlots.BackButton</button>
                </div>
            </div>
        }
        @if (DebugBuild || DevMode)
        {
            <button class="secondary" disabled="@locked" @onclick="G.DebugFill">调试：在当前地面放一批物资</button>
        }
        @if (DevMode)
        {
            @* 开发入口（地址加 ?dev=1 才显示）：开发测试箱、放敌人、立即敌踪、感染与尸变测试。正式流程不可见。 *@
            @* B31b 试玩修复（M614）：对白锁期间整组开发项禁用。用 fieldset disabled 而不是 inert：脚本 click() 也点不动，不会改世界状态 *@
            <fieldset class="dev-box" disabled="@(!ShellMenu.Enabled(ShellMenuItem.Dev, locked))">
                <div class="eyebrow">开发入口（?dev=1）</div>
                <div class="btn-row">
                    <button class="secondary" @onclick="DevKit">开发测试箱</button>
                    <button class="secondary" @onclick="DevEncounter">本地敌人立即形成敌踪</button>
                    <button class="secondary" @onclick="() => DevVirus(20)">感染（病毒20）</button>
                    <button class="secondary" @onclick="() => DevVirus(99.9)">病毒99.9（尸变测试）</button>
                    <button class="secondary" @onclick="DevDay2">跳到第2日08:00</button>
                    <button class="secondary" @onclick="DevMeds">药品各1（绷带/抗生素/特效药）</button>
                    <button class="secondary" @onclick="DevRepairMats">维护材料（废金属+零件）</button>
                    <button class="secondary" @onclick="DevSubstance">普通活性物质1份</button>
                    <button class="secondary" @onclick="DevRecipeMats">金属矛/弩/弩矢材料各1次</button>
                </div>
                @* B4（开发计划 v0.9 B4 H10）：一组七件装备（每槽一件）按指定品质放当前地面；B4 新导入物品按类放当前地面 *@
                <div class="btn-row">
                    <button class="secondary" @onclick='() => DevEquip("white")'>给一组装备（白）</button>
                    <button class="secondary" @onclick='() => DevEquip("green")'>给一组装备（绿）</button>
                    <button class="secondary" @onclick='() => DevEquip("blue")'>给一组装备（蓝）</button>
                    <button class="secondary" @onclick='() => DevNewItems("material")'>新物品（材料）</button>
                    <button class="secondary" @onclick='() => DevNewItems("food")'>新物品（食品）</button>
                    <button class="secondary" @onclick='() => DevNewItems("medical")'>新物品（医疗）</button>
                    <button class="secondary" @onclick="() => DevSkills(5, true)">求生熟练度全部5级</button>
                    <button class="secondary" @onclick="() => DevSkills(10, true)">求生熟练度全部10级</button>
                    <button class="secondary" @onclick="() => DevSkills(1, false)">熟练度全部回到1级</button>
                    @* B7（A06 §2）：战斗/医疗技能按 1/3/5/7/10 级解锁；技能器具一组放当前地面，供逐页试技能 *@
                    <button class="secondary" @onclick="() => DevSkills(3, false)">熟练度全部3级（含战斗）</button>
                    <button class="secondary" @onclick="() => DevSkills(5, false)">熟练度全部5级（含战斗）</button>
                    <button class="secondary" @onclick="() => DevSkills(7, false)">熟练度全部7级（含战斗）</button>
                    <button class="secondary" @onclick="() => DevSkills(10, false)">熟练度全部10级（含战斗）</button>
                    <button class="secondary" @onclick="DevSkillKit">技能器具一组（各类武器/盾/指挥/医疗与耗材）</button>
                    @* B6（R03 §3）：战术训练阶位 0/1/2 → 每次普通激活 3/4/5AP；正式训练入口在营区工坊罗铮“事项”（B15） *@
                    <button class="secondary" @onclick="() => DevTier(0)">战术训练阶位0（3AP）</button>
                    <button class="secondary" @onclick="() => DevTier(1)">战术训练阶位1（4AP）</button>
                    <button class="secondary" @onclick="() => DevTier(2)">战术训练阶位2（5AP）</button>
                </div>
                @* B7c（Q62）：容量 C 来自存档里的真实解锁事实；营区登记、两种关键记录的系统在后续批次，这里只供试玩造事实 *@
                <div class="btn-row">
                    <button class="secondary" @onclick='() => DevCapacity("hub_registered")'>记下营区登记（C2）</button>
                    <button class="secondary" @onclick='() => DevCapacity("church_route_record")'>记下圣所旧路档册（C3）</button>
                    <button class="secondary" @onclick='() => DevCapacity("academy_safety_record")'>记下封存区安全规程（两种都有C4）</button>
                    <button class="secondary" @onclick="() => DevCapacity(null)">清除容量事实（回C1）</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugGiveWraps(G.S))">护拳绑带1件+制作材料</button>
                </div>
                @* B10（A07 工坊、A05 §3）：工坊只能建在营地；蓝图的正常获取（地图固定箱/任务）在 B11 起，这里供试玩 *@
                <div class="eyebrow">工坊与装备制作（B10）</div>
                <div class="btn-row">
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugBuildAllWorkshops(G.S))">建全部工坊（营地）</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugLearnAllKnowledge(G.S))">学会全部做法与蓝图</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugWorkshopKit(G.S))">工坊材料包（放当前地面）</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugCharcoalKit(G.S))">煅烧木炭：木材×10（放当前地面）</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugMedicalMaterialKit(G.S))">医疗台三材料原料（盐水剂/消毒液/草药浸膏各一次）</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugForgeSteelKit(G.S))">锻炉钢材3份原料（铁矿料×9、木炭×6）</button>
                </div>
                @* B16（R48—R51）：新配方、净水片/滤芯、分量水壶、锅食谱、护理品与野外修补包 *@
                <div class="eyebrow">配方、水壶与复合锅（B16）</div>
                <div class="btn-row">
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugSupplyKit(G.S))">B16 材料包（学会两种做法，放当前地面）</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugGiveFieldPatchKit(G.S))">B22b 修补包试用组（白绿蓝包各2、白绿蓝砍刀、绿护甲、手枪、蓝包材料）</button>
                    <button class="secondary" @onclick='() => DevDone(G.E.DebugSetSkillLevel(G.S, "crafting", 7))'>制造熟练设为7级</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugPotRecipeKit(G.S))">锅食谱材料（谷物3、盐1、生肉1）</button>
                    <button class="secondary" title="B22c（Q170）：建晾制架（营地建造）与 4 肉 4 果八批；肉干要烹饪5级" @onclick="() => DevDone(G.E.DebugDryingKit(G.S))">晾制架材料＋八批原料（木材4、绳索2、生肉4、盐4、野果8）</button>
                    <button class="secondary" @onclick='() => DevDone(G.E.DebugSetSkillLevel(G.S, "cooking", 5))'>烹饪熟练设为5级</button>
                    <button class="secondary" @onclick='() => DevDone(G.E.DebugSetSkillLevel(G.S, "crafting", 3))'>制造熟练设为3级</button>
                    <button class="secondary" @onclick='() => DevDone(G.E.DebugSetSkillLevel(G.S, "medicine", 5))'>医疗熟练设为5级</button>
                </div>
                @* B29（R90—R96）：同行者、随身食水、腐败与锅水，试食饮局部盘和地牢饮水预告 *@
                <div class="eyebrow">同行食饮与饮水预算（B29）</div>
                <div class="btn-row">
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugFeedKit(G.S))">B29 食饮试玩组（同行两人、随身食水、地面水与耗材）</button>
                </div>
                @* B17（R52—R56）：安全屋与分区设施——选址、材料、直接建成、陶窑/净水台、野营布与柴炉 *@
                <div class="eyebrow">安全屋与分区设施（B17）</div>
                <div class="btn-row">
                    <button class="secondary" title="传送到营外安全屋地块（到访即探索100），记营区登记、清当地敌踪、制造至少1级" @onclick='() => DevDone(G.E.DebugSafehouseSite(G.S, "h05_homestead"))'>到营外安全屋地块（可建）</button>
                    <button class="secondary" title="当前地点（须在许可名单）探索100、记营区登记、清当地敌踪" @onclick="() => DevDone(G.E.DebugSafehouseSite(G.S, G.S.CurrentLocation))">当前地点设为可建（探索100/登记/清敌）</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugSafehouseKit(G.S))">安全屋＋床垫＋火堆材料（放当前地面）</button>
                    <button class="secondary" title="不扣材料、不花时间、不给经验" @onclick="() => DevDone(G.E.DebugBuildSafehouse(G.S))">直接建成本地安全屋</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugStationKit(G.S))">陶窑/净水台材料（制造3级、学会陶工）</button>
                    <button class="secondary" title="B22d：试陶窑6+净水台3+3=每日12" @onclick="() => DevDone(G.E.DebugStationInputs(G.S))">陶窑1批＋净水台2批原料</button>
                    <button class="secondary" title="B32e（Q380）：试多批排队、10批上限与「队列已满（10批）。」" @onclick="() => DevDone(G.E.DebugStationQueueInputs(G.S))">陶窑、净水台各11批原料</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugCampingKit(G.S))">野营布＋折叠柴炉＋木材2</button>
                    <button class="secondary" title="临时露营许可点之一（野外勘测点），可部署野营布与柴炉" @onclick='() => DevDone(G.E.DebugMapTeleport(G.S, "w19_survey"))'>传送到露营许可点（w19）</button>
                </div>
                @* B22e（Q173 按 B）：普通野外外部区可铺野营布、建野外火堆（石4木2）；柴炉仍只限 8 处露营许可点；城市公共地/地牢拒绝 *@
                <div class="eyebrow">野外野营布与固定火堆（B22e）</div>
                <div class="btn-row">
                    <button class="secondary" title="普通野外（不是露营许可点）：野营布可铺、野外火堆可建，柴炉不能部署" @onclick='() => DevDone(G.E.DebugMapTeleport(G.S, "field"))'>传送到农野荒地（普通野外）</button>
                    <button class="secondary" @onclick="() => DevDone(G.E.DebugWildFireKit(G.S))">建野外火堆材料：石块4＋木材2（放当前地面）</button>
                    <button class="secondary" title="城市公共地：野营布与野外火堆都应被拒" @onclick='() => DevDone(G.E.DebugMapTeleport(G.S, "h02_square"))'>传送到营区广场（应拒绝）</button>
                    <button class="secondary" title="地牢房间：野营布与野外火堆都应被拒" @onclick='() => DevDone(G.E.DebugMapTeleport(G.S, "d06_06"))'>传送到矿工营室（地牢，应拒绝）</button>
                </div>
                @* B13（R39—R43）：新手序章各阶段。只改剧情/时钟标记，不结算身体；来客在条件满足的安全边界登记 *@
                <div class="eyebrow">序章（B13）：首战记胜 → 跳到第5日08:00（来客登记）→ 回营地交谈 → 去村庄看路标</div>
                <div class="btn-row">
                    <button class="secondary" @onclick='() => DevDone(G.E.DebugPrologue(G.S, "won"))'>首战记为胜利（不发教学物质）</button>
                    <button class="secondary" @onclick='() => DevDone(G.E.DebugPrologue(G.S, "d5"))'>跳到第5日08:00（来客阈值）</button>
                    <button class="secondary" @onclick='() => DevDone(G.E.DebugPrologue(G.S, "camp"))'>传送到临时营地</button>
                    <button class="secondary" @onclick='() => DevDone(G.E.DebugPrologue(G.S, "village"))'>传送到废弃村庄</button>
