@inherits GameComponent

@* 火堆直烤位里的一份食材（v0.7 第 3.1 节）：真实实例卡——图标（拖拽把手）、名称#实例、加工状态与受热进度、三角箭头。
   点击只选中这份食材（不冒泡选中火堆）；已完成的成品仍占原加工位并保持可见。 *@
@{
    var s = G.S;
    var e = G.E;
    var name = $"{e.ItemName(Item.ItemId)}#{Item.InstanceId}";
    var proc = e.ProcessOf(s, Item);
    var spoiled = e.IsSpoiled(s, Item);
    var key = $"{Item.Owner}|{Item.ItemId}|{Item.InstanceId}";
    var where = e.WherePath(s, Item);
    var selected = G.Selected.Kind == SelectionKind.Tool && G.Selected.InstanceId == Item.InstanceId;
}
<div class="fc-food @(selected ? "selected" : "") @(spoiled ? "spoiled" : "")" id="@(selected ? "card-sel" : null)" data-card="@key" role="button" tabindex="0"
     title="@($"{name} · {where}：{e.ContentStatus(s, Item)}")"
     @onclick="Select" @onclick:stopPropagation="true" @onkeydown="Key" @onkeydown:stopPropagation="true">
    <div class="ff-head">
        <span class="pc-ico" data-drag="@($"card:{key}")" data-drag-title="@name" data-drag-from="@where">@Icons.Markup(Item.ItemId)</span>
        <span class="pc-text"><span class="pc-name">@name</span>@if (Slot.HasValue) {<span class="pc-status">加工位@(Slot)</span>}</span>
        <button type="button" class="row-arrow" aria-label="@($"把{name}取到随身")" title="取到随身（不打开操作条；点图标可选目的地）"
                disabled="@(G.E.IsBusy(s) || G.Running)" @onclick="Take" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">▼</button>
    </div>
    <div class="ff-status">@e.ContentStatus(s, Item)</div>
    @if (proc != null && !spoiled)
    {
        <div class="heat-track"><i style="width:@(Math.Min(100, proc.HeatDoneMinutes * 100 / Math.Max(1, proc.RequiredHeatMinutes)))%"></i></div>
    }
    @if (Item.ExpiresAt.HasValue) { <div class="ff-note">@Ui.FreshOf(e, s, Item)</div> }
</div>

@code {
    [Parameter, EditorRequired] public ItemInstance Item { get; set; } = null!;
    /// <summary>火堆加工位序号。</summary>
    [Parameter] public int? Slot { get; set; }

    private void Select() =>
        G.Select(new Selection { Kind = SelectionKind.Tool, Id = Item.ItemId, Owner = Item.Owner, InstanceId = Item.InstanceId });

    private void Take() => G.TransferOne(Item.Owner, Item.ItemId, Item.InstanceId, ItemInstance.Carried);

    private void Key(KeyboardEventArgs ev)
    {
        if (ev.Key is "Enter" or " ") Select();
    }
}
