@inherits GameComponent

@* 就近执行浮窗（S14 §14.1、S02 §5、R05 §7、S08 §5）：一个时刻只有一个当前操作上下文（G.Pop）。
   travel/mapnode：相邻地图卡或区域地图节点旁预览基础时间、预计完成、负重与入夜影响，“确认移动”一次确认；
   approach：敌踪卡旁对象/风险预览，“接近并开战”才按 R05 接敌；gather：拖工具到资源卡后在卡旁确认开始；
   charcoal：火堆卡“煅烧木炭”旁的投料确认（Q111，S14 本轮章）：4木→3炭、原料来源、空位、60有效分钟、燃料另计与冷火55提示，“确认投料”才投（0分钟）。
   每次渲染都从内核现算预览；目标失效（不再相邻、敌人离开、预览被替换）时直接收起，不保留失效按钮。
   点击执行再交给内核按真实 ID/所在地/占用重验（E.Start、E.Approach），执行中锁住按钮，重复点击不重复提交。
   B32f（逐字稿 §1.5 Q395，同 Q390 物品操作盘）：游戏菜单（含战斗菜单）打开期间只隐藏（menu-hidden）、不卸载，盘内状态保留；
   关菜单后仍有效的原盘恢复显示并按当前状态重算预览与按钮（每次渲染本来就现算）；目标失效照上面 Valid 收起；恢复不提交。 *@
@if (G.State != null && G.Pop is GameSession.PopContext pop && !G.DialogueLocked && Valid(pop))
{
    var s = G.S;
    var e = G.E;
    var busy = e.IsBusy(s) || G.Running || G.BattleBusy || _go;
    switch (pop.Kind)
    {
        case "travel":
        case "mapnode":
        {
            var to = pop.Id;
            var lc = e.Location(to);
            var ls = s.Locations[to];
            // B21（R03 D3）：01→危险房间要确认开始远征（同一预告 +“确认开始远征并前往”）；父地点→01 只是预告，正常移动
            var needExp = e.NeedsExpeditionConfirm(s, to);
            var req = ActionRequest.Travel(to, needExp);
            var p = G.Preview(req);
            var dTo = e.DungeonAt(to);
            var expPv = needExp ? e.ExpeditionPreview(s, dTo!)
                : dTo != null && e.ExpeditionEnabled(dTo) && e.BufferNodeOf(dTo) == to && e.DungeonAt(s.CurrentLocation) != dTo ? e.ExpeditionPreview(s, dTo) : null;
            // 未通关想原路离开：内核拒绝并写明惩罚；这里给“终止本次远征…”入口（同一确认窗）
            var leaveBlocked = !p.Ok && s.Expedition != null && !s.Expedition.IsExtracting && e.DungeonAt(to) != s.Expedition.DungeonId && e.CanAbortExpedition(s) == null;
            var dir = e.DirectionFromHere(s, to);
            var grams = e.CarriedGrams(s);
            var over = grams > e.Config.Carry.SoftGrams;
            var night = p.Ok && !e.IsDaylight(p.EstimatedEndMinute);
            var scene = ArtAssets.Scene(lc.Id, lc.Scene);
            @* B22f（Q202 ①，交开发方定）：远征入口浮窗限制在中部列里，不盖住右栏完整进入预告 *@
            <AnchorPop AnchorId="@pop.AnchorId" Title="@($"前往{lc.Name}")" CssClass="@("travel" + G.MenuHideCss)" Bound="@(expPv != null ? ".center" : null)"
                       Sub="@($"{(dir == MapDirection.None ? "" : GameEngine.DirectionHint(dir) + " · ")}{(ls.Visited ? "已访问" : "待访问")} · 单程{p.BaseMinutes}分钟")" OnClose="G.ClosePop">
                <Art><span class="apop-scene" style="background-image:url('@scene')"></span></Art>
                <ChildContent>
                    @if (p.Ok)
                    {
                        <div class="apop-facts">
                            <span title="预计耗时（含当前倍率）"><i class="pf-ico">⏱</i>@Clock.Duration(p.EstimatedMinutes)</span>
                            <span title="预计到达时刻"><i class="pf-ico">◷</i>@Clock.HHmm(p.EstimatedEndMinute)到达</span>
                            <span class="@(over ? "warn" : "")" title="当前携带重量（超过@(Ui.T(e.Config.Carry.SoftGrams / 1000.0))公斤减速）"><i class="pf-ico">⚖</i>@Ui.KgText(grams) · @(over ? "超重" : "轻装")</span>
                            @if (Math.Abs(p.FactorAtStart - 1) > 1e-9)
                            {
                                <span class="warn" title="工作倍率（夜间、超重、低体力相乘）"><i class="pf-ico">×</i>@p.FactorAtStart.ToString("0.##")@(p.FactorReasons.Count > 0 ? $"（{string.Join("，", p.FactorReasons)}）" : "")</span>
                            }
                        </div>
                        @if (night) { <div class="apop-risk night">☾ 到达时已入夜</div> }
                        @foreach (var w in p.Warnings) { <div class="apop-risk">@w</div> }
                    }
                    else
                    {
                        <div class="apop-risk">@p.Reason</div>
                    }
                    @if (expPv != null)
                    {
                        @* B21：就近浮窗只放要点（A10 §7 / S14 §14.1 不铺长说明），完整进入预告在右栏 *@
                        var warnCount = expPv.Members.Count(m => m.Warnings.Count > 0);
                        <div class="apop-risk exp-brief">@expPv.Name · @expPv.StatusName · 第@(expPv.Generation)代@(expPv.Continuation ? "（续探）" : "")</div>
                        <div class="apop-risk exp-brief">未通关离开要终止远征：扣属性＋惊魂未定，撤出至少@(expPv.ExtractMinMinutes)分钟</div>
                        @if (warnCount > 0) { <div class="apop-risk">⚠ @(warnCount)名同行状态偏低</div> }
                        <div class="apop-risk exp-brief muted">完整进入预告（全员状态、物资、已知敌人、时间）见右栏</div>
                    }
                    @if (G.Notice != null && _tried) { <div class="apop-risk">@G.Notice</div> }
                </ChildContent>
                <Actions>
                    @if (leaveBlocked)
                    {
                        <button type="button" class="secondary danger apop-go" disabled="@busy" @onclick="G.OpenAbort">终止本次远征…</button>
                    }
                    else
                    {
                        <button type="button" class="primary apop-go" data-enter disabled="@(!p.Ok || busy)" @onclick='() => Travel(req, pop.Kind == "mapnode")'>@(p.Ok ? (needExp ? "确认开始远征并前往" : "确认移动") : "无法移动")<EnterCap On="@(p.Ok && !busy)" /></button>
                    }
                    <button type="button" class="secondary apop-cancel" @onclick="G.ClosePop">取消<EscCap On="@G.EscOnDisk" /></button>
                </Actions>
            </AnchorPop>
            break;
        }
        case "approach":
        {
            var wid = int.Parse(pop.Id);
            var w = e.FindWorldEnemy(s, wid)!;
            var ec = e.Enemy(w.EnemyId);
            var why = e.CanApproach(s, wid);
            var weapon = e.CurrentWeapon(s, out var wi);
            var hit = e.OutOfBattleHit(s, ec);   // Q67：与战斗中同一公式（+8、疲劳一次×0.95）
            <AnchorPop AnchorId="@pop.AnchorId" Title="@($"接近{ec.Name}")" CssClass="@("approach" + G.MenuHideCss)"
                       Sub="@($"健康{Ui.N(w.Hp)}/{Ui.N(ec.Hp)} · {(w.Hostile ? "敌对" : "中立")} · 只与这一只交战")" OnClose="G.ClosePop">
                <Art>@Icons.Markup("enemy_" + ec.Id)</Art>
                <ChildContent>
                    <div class="apop-facts">
                        <span title="敌人对你的命中率与伤害"><i class="pf-ico">⚔</i>对你@(Ui.Pct(GameEngine.HitChance(ec.AttackRating, e.Config.Scope.BasePlayerDodge))) · 伤害@(Ui.N(ec.DamageMin))—@(Ui.N(ec.DamageMax))</span>
                        <span title="开战默认页（第一个有武器的页）的命中率（战斗中可切换武器页，0AP）"><span class="pf-weapon" aria-hidden="true">@Icons.Markup(wi?.ItemId ?? "fists")</span>@(e.DefaultWeaponPage(s) == 1 ? "Ⅰ" : "Ⅱ") @(wi == null ? "拳" : weapon.Name) · 命中@(Ui.Pct(hit.HitChance))</span>
                    </div>
                    @if (wi != null && weapon.UsesMagazine && wi.LoadedAmmo <= 0)
                    {
                        <div class="apop-risk">@($"{weapon.Name}")弹仓为0：开战后需先装填（1AP）</div>
                    }
                    @if (e.CanBite(ec)) { <div class="apop-risk">咬伤可能感染（当前一次@(Ui.Pct(e.ExposureChance(s.Body.Immunity)))）</div> }
                    else if (ec.IsZombie) { <div class="apop-note">它的意图里没有咬击，不会咬伤（攻击不传播病毒）</div> }
                    <div class="apop-note">@e.FearNote(s, new[] { w }, GameEngine.FearApproach)</div>
                    @if (why != null) { <div class="apop-risk">@why</div> }
                    @if (G.Notice != null && _tried) { <div class="apop-risk">@G.Notice</div> }
                </ChildContent>
                <Actions>
                    <button type="button" class="primary apop-go fight" data-enter disabled="@(why != null || busy)" @onclick="() => Approach(wid)">接近并开战<EnterCap On="@(why == null && !busy)" /></button>
                    <button type="button" class="secondary apop-cancel" @onclick="G.ClosePop">取消<EscCap On="@G.EscOnDisk" /></button>
                </Actions>
            </AnchorPop>
            break;
        }
        case GameSession.EnemyCardPop:
        {
            @* B41e1 新版敌踪居中操作盘（逐字稿「B41 Q426–Q428 正式文案」卡片、操作盘与倒计时；Q447 逐成员预览与受惊情境；Q457 收盘重验）：
               标题＝敌踪名；信息标签「警惕、接近、队长、成功率、耗时」；三种处理按钮「主动接近、潜行接近、躲避」，禁用时原因写在盘内（内核 CanApproachCard／CanStealthCard
               按逐字稿禁用表取第一条）；「返回」只收盘。主动接近点击即提交，潜行／躲避点击提交 5 分钟行动，带上盘里显示的队长与成功率，不另加确认，也不贴 Enter（Q499）。
               保留原命中、伤害、感染与受惊预览：组卡、固定战按锁定名单原顺序逐个成员；主动接近与潜行接近按 0.5 受惊情境，躲避按失败入战 1.0 并以「躲避失败时」开头。 *@
            var c = e.EnemyCardHere(s, pop.Id)!;   // Valid 已重验
            var key = c.Key;
            var leader = e.SquadLeaderId(s);
            var sneakRate = e.StealthRate(s, GameEngine.SneakKind, leader, c.Vigilance);
            var evadeRate = e.StealthRate(s, GameEngine.EvadeKind, leader, c.Vigilance);
            var whyApproach = e.CanApproachCard(s, key);
            var whySneak = e.CanStealthCard(s, key, GameEngine.SneakKind, leader, sneakRate);
            var whyEvade = e.CanStealthCard(s, key, GameEngine.EvadeKind, leader, evadeRate);
            var status = e.CardApproachStatus(s, c);
            var members = e.EnemyCardPreviewMembers(s, c);
            var weapon = e.CurrentWeapon(s, out var wi);
            var labels = GameEngine.EnemyDiskLabels;
            var sneakName = GameEngine.StealthActionName(GameEngine.SneakKind);
            var evadeName = GameEngine.StealthActionName(GameEngine.EvadeKind);
            var reasons = new[] { whyApproach, whySneak, whyEvade }.Where(x => x != null).Distinct().ToList();
            <AnchorPop AnchorId="@pop.AnchorId" Title="@c.Title" Sub="@c.Badge" CssClass="@("approach enemycard" + G.MenuHideCss)" OnClose="G.ClosePop">
                <Art>@Icons.Markup("enemy_" + c.EnemyIds[0])</Art>
                <ChildContent>
                    <div class="lines ecard-lines">
                        <div><span>@labels[0]</span><b>@GameEngine.VigilanceText(c.Vigilance)</b></div>
                        @if (status != null) { <div><span>@labels[1]</span><b>@status</b></div> }
                        <div><span>@labels[2]</span><b>@e.SquadLeaderText(s)</b></div>
                        <div><span>@labels[3]</span><b>@sneakName @GameEngine.StealthRateText(sneakRate)@if (!c.KeyEnemy) {<text> · @evadeName @GameEngine.StealthRateText(evadeRate)</text>}</b></div>
                        <div><span>@labels[4]</span><b>@e.StealthCheckMinutesText</b></div>
                    </div>
                    @foreach (var m in members)
                    {
                        var ec = e.Enemy(m.EnemyId);
                        var hit = e.OutOfBattleHit(s, ec);   // Q67：与战斗中同一公式（+8、疲劳一次×0.95）
                        <div class="apop-note ecard-member"><b>@ec.Name</b> 健康@(Ui.N(m.Enemy?.Hp ?? ec.Hp))/@(Ui.N(ec.Hp))</div>
                        <div class="apop-facts">
                            <span title="敌人对你的命中率与伤害"><i class="pf-ico">⚔</i>对你@(Ui.Pct(GameEngine.HitChance(ec.AttackRating, e.Config.Scope.BasePlayerDodge))) · 伤害@(Ui.N(ec.DamageMin))—@(Ui.N(ec.DamageMax))</span>
                            <span title="开战默认页（第一个有武器的页）的命中率（战斗中可切换武器页，0AP）"><span class="pf-weapon" aria-hidden="true">@Icons.Markup(wi?.ItemId ?? "fists")</span>@(e.DefaultWeaponPage(s) == 1 ? "Ⅰ" : "Ⅱ") @(wi == null ? "拳" : weapon.Name) · 命中@(Ui.Pct(hit.HitChance))</span>
                        </div>
                        @if (e.CanBite(ec)) { <div class="apop-risk">咬伤可能感染（当前一次@(Ui.Pct(e.ExposureChance(s.Body.Immunity)))）</div> }
                        else if (ec.IsZombie) { <div class="apop-note">它的意图里没有咬击，不会咬伤（攻击不传播病毒）</div> }
                    }
                    @if (wi != null && weapon.UsesMagazine && wi.LoadedAmmo <= 0)
                    {
                        <div class="apop-risk">@($"{weapon.Name}")弹仓为0：开战后需先装填（1AP）</div>
                    }
                    <div class="apop-note">@e.EnemyCardFearNote(s, c, false)</div>
                    @if (!c.KeyEnemy) { <div class="apop-note"><span class="ecard-cond">@GameEngine.EvadeFailFearPrefix</span>@e.EnemyCardFearNote(s, c, true)</div> }
                    @foreach (var r in reasons) { <div class="apop-risk ecard-why">@r</div> }
                    @if (G.Notice != null && _tried) { <div class="apop-risk">@G.Notice</div> }
                </ChildContent>
                <Actions>
                    <button type="button" class="primary apop-go fight" disabled="@(whyApproach != null || busy)" title="@whyApproach" @onclick="() => ApproachCard(key)">@GameEngine.ApproachCardButton</button>
                    <button type="button" class="secondary apop-go" disabled="@(whySneak != null || busy)" title="@whySneak" @onclick="() => StealthCard(key, GameEngine.SneakKind, leader, sneakRate)">@sneakName</button>
                    <button type="button" class="secondary apop-go" disabled="@(whyEvade != null || busy)" title="@whyEvade" @onclick="() => StealthCard(key, GameEngine.EvadeKind, leader, evadeRate)">@evadeName</button>
                    <button type="button" class="secondary apop-cancel" @onclick="G.ClosePop">@GameEngine.EnemyDiskBack<EscCap On="@G.EscOnDisk" /></button>
                </Actions>
            </AnchorPop>
            break;
        }
        case "lockstack":
        {
            @* B12（B11 遗留）：相邻栏未开通叠卡的逐条列表：按条件分组，原因写一次，每条写名称、方位、单程分钟；只看，不移动 *@
            var groups = e.AdjacentLockedGroups(s);
            var total = groups.Sum(g => g.Routes.Count);
            <AnchorPop AnchorId="@pop.AnchorId" Title="@($"{total}条路线未开通")" Sub="@(groups.Count == 1 ? "同一条件，满足后一起开通" : $"{groups.Count}种条件")" CssClass="@("lockstack" + G.MenuHideCss)" OnClose="G.ClosePop">
                <ChildContent>
                    @foreach (var (reason, routes) in groups)
                    {
                        <div class="apop-risk">路线未开通，@reason</div>
                        <ul class="lockstack-list">
                            @foreach (var lk in routes)
                            {
                                var d = e.DirectionFromHere(s, lk.Target);
                                <li><span>@e.LocName(lk.Target)</span><small>@(d == MapDirection.None ? "" : GameEngine.DirectionHint(d) + " · ")单程@(lk.Edge.BaseMinutes)分钟</small></li>
                            }
                        </ul>
                    }
                </ChildContent>
                <Actions>
                    <button type="button" class="secondary apop-cancel" @onclick="G.ClosePop">关闭<EscCap On="@G.EscOnDisk" /></button>
                </Actions>
            </AnchorPop>
            break;
        }
        case "charcoal":
        {
            var info = G.CharcoalPreview();
            var shown = G.CharcoalShown();
            var shortFuel = info.FuelWoodShort > 0;
            <AnchorPop AnchorId="@pop.AnchorId" Title="煅烧木炭" CssClass="@("charcoal" + G.MenuHideCss)" Place="above,below,right,left"
                       Sub="@($"{e.ItemName(info.InputId)}×{info.InputCount}→{e.ItemName(info.OutputId)}×{info.OutputCount} · 不耗时投料 · 不给经验")" OnClose="G.ClosePop">
                <Art>@Icons.Markup("charcoal")</Art>
                <ChildContent>
                    @* B32b（逐字稿 §1.5 Q365、P02f）：「投入木材」「剩余燃料」「工位」「耗时」逐行，按木炭操作预演取实际来源、数量、工位与燃料 *@
                    <div class="lines charcoal-lines">
                        <div title="原料只取你随身与当前地面未预留的木材（随身优先），不取队友或别处的"><span>投入木材</span><b>@(e.ItemName(info.InputId))×@(info.InputCount)（可用@(info.WoodAvailable)）</b></div>
                        <div><span>剩余燃料</span><b>@(info.FuelMinutes)分钟</b></div>
                        @if (CardStates.CharcoalSlotText(e, s) is string slotText)
                        {
                            <div title="每批占火堆2个加工位中的1位；可与1口锅或另一批并存"><span>工位</span><b>@slotText</b></div>
                        }
                        <div title="只在火堆燃烧且本段有完整5分钟燃料时计热；不受熟练度或装备加速"><span>耗时</span><b>@CardStates.CharcoalTimeText(info)</b></div>
                    </div>
                    @if (shown.Sources.Count > 0 && info.Ok)
                    {
                        @* Q113：系统自动分配（随身优先，不足再取当前地面），逐堆列来源/实例/数量；无来源切换控件 *@
                        <div class="apop-note" title="系统自动取料：先取你随身的木材，不够再取当前地面的；不取队友、别处或被预留/占用的木材">将取：@string.Join("、", shown.Sources)</div>
                        @if (!shown.Plan.SameAs(info.Plan))
                        {
                            <div class="apop-note">木材有变动：确认时会按上面的明细核对，来源不一致将不投料并刷新明细</div>
                        }
                    }
                    <div class="@(shortFuel ? "apop-risk" : "apop-note")">燃料另计：@info.FuelNote</div>
                    <div class="apop-note">熄火保留进度；取出未完成的一批退回@(info.InputCount)份木材、清进度，已烧燃料不退；完成后木炭留在加工位，取出才进包。</div>
                    @if (!info.Ok) { <div class="apop-risk">@info.Reason</div> }
                    @if (G.Notice != null && _tried) { <div class="apop-risk">@G.Notice</div> }
                </ChildContent>
                <Actions>
                    @* Q365：主按钮始终写「确认投料」，当前受阻时禁用，原因在盘内 *@
                    <button type="button" class="primary apop-go" data-enter disabled="@(!info.Ok || busy)" @onclick="LoadCharcoal">确认投料<EnterCap On="@(info.Ok && !busy)" /></button>
                    <button type="button" class="secondary apop-cancel" @onclick="G.ClosePop">取消<EscCap On="@G.EscOnDisk" /></button>
                </Actions>
            </AnchorPop>
            break;
        }
        case "harvest":
        {
            @* B32b（逐字稿 §1.2 Q346、§1.5 Q364）：晾制成品「收取」居中盘。两键各自按原去向校验直接提交，不另加确认；
               容量或其他校验失败时在盘内写实际原因、盘不关，可改选另一合法去向；成功后收盘并刷新该位。取消、×、遮罩、Esc 按 Q338 只收起。 *@
            var k = int.Parse(pop.Id);
            var v = e.DryingSlotViews(s).First(x => x.Slot == k);
            var dryBusy = G.Running || s.Sub != null || _go;
            <AnchorPop AnchorId="@pop.AnchorId" Title="@CardStates.HarvestTitle" CssClass="@("harvest" + G.MenuHideCss)" Sub="@($"{v.Title} · {v.RecipeName}")" OnClose="G.ClosePop">
                <Art>@Icons.Markup(e.DryingContents(s, s.Ground, k).FirstOrDefault()?.ItemId ?? "dried_meat")</Art>
                <ChildContent>
                    @foreach (var c in v.Contents) { <div class="apop-note">@c</div> }
                    @if (_harvestFail != null && _tried) { <div class="apop-risk">@_harvestFail</div> }
                </ChildContent>
                <Actions>
                    <button type="button" class="primary apop-go" disabled="@dryBusy" @onclick="() => Harvest(k, true)">@CardStates.HarvestToCarried</button>
                    <button type="button" class="secondary apop-go" disabled="@dryBusy" @onclick="() => Harvest(k, false)">@CardStates.HarvestToGround</button>
                    <button type="button" class="secondary apop-cancel" @onclick="G.ClosePop">取消<EscCap On="@G.EscOnDisk" /></button>
                </Actions>
            </AnchorPop>
            break;
        }
        case "gather":
        {
            var req = G.PendingAction!;
            var p = G.Preview(req);
            var r = e.Resource(req.TargetId);
            <AnchorPop AnchorId="@pop.AnchorId" Title="@G.PendingActionTitle" CssClass="@("gather" + G.MenuHideCss)" Sub="@($"{r.Name} · 拖入的工具")" OnClose="G.ClosePop">
                <Art>@Icons.Markup(Icons.ForResource(r.NodeId, r.Outputs))</Art>
                <ChildContent>
                    @if (p.Ok)
                    {
                        <div class="apop-facts">
                            <span><i class="pf-ico">⏱</i>@Clock.Duration(p.EstimatedMinutes)</span>
                            <span><i class="pf-ico">◷</i>@Clock.HHmm(p.EstimatedEndMinute)完成</span>
                            @foreach (var o in p.Outputs) { <span><span class="pf-weapon" aria-hidden="true">@Icons.Markup(o.ItemId)</span>@o.Name×@o.Count</span> }
                            @if (p.ToolName != null && p.ToolDurabilityBefore.HasValue)
                            {
                                <span title="使用拖入的这一把，不可用时不会自动换"><i class="pf-ico">⚒</i>@p.ToolName @Ui.N(p.ToolDurabilityBefore.Value)→@Ui.N(p.ToolDurabilityAfter ?? 0)</span>
                            }
                        </div>
                        @if (p.HazardProbability > 0) { <div class="apop-risk">@(p.HazardLabel)@(Ui.Pct(p.HazardProbability)) · 健康−@(Ui.T(p.HazardHealthLoss))</div> }
                        @foreach (var wn in p.Warnings) { <div class="apop-risk">@wn</div> }
                    }
                    else
                    {
                        <div class="apop-risk">@p.Reason</div>
                    }
                </ChildContent>
                <Actions>
                    <button type="button" class="primary apop-go" data-enter disabled="@(!p.Ok || busy)" @onclick="() => Gather(req)">@(p.Ok ? p.ConfirmText : "无法开始")<EnterCap On="@(p.Ok && !busy)" /></button>
                    <button type="button" class="secondary apop-cancel" @onclick="G.ClosePop">取消<EscCap On="@G.EscOnDisk" /></button>
                </Actions>
            </AnchorPop>
            break;
        }
    }
}

@code {
    private bool _go;
    private bool _tried;
    private GameSession.PopContext? _seen;

    /// <summary>浮窗目标仍然有效：相邻路线仍可走、敌人仍在本地可见、拖拽预览仍是当前选择。失效时不通知界面地收起。</summary>
    private bool Valid(GameSession.PopContext pop)
    {
        if (!ReferenceEquals(pop, _seen)) { _seen = pop; _tried = false; _harvestFail = null; }
        var s = G.S;
        var e = G.E;
        var ok = pop.Kind switch
        {
            "travel" => s.Battle == null && s.Encounter == null && G.Panel == null && e.AdjacentUnlocked(s).Any(x => x.Other(s.CurrentLocation) == pop.Id),
            "mapnode" => G.Panel == "map" && e.AdjacentUnlocked(s).Any(x => x.Other(s.CurrentLocation) == pop.Id),
            "approach" => s.Battle == null && s.Encounter == null && int.TryParse(pop.Id, out var wid) && e.VisibleEnemiesAt(s, s.CurrentLocation).Any(w => w.Id == wid),
            // B41e1（R05 Q457）：卡键仍在当前地点、当前区域的可操作卡里；失效即收盘（DropPop 一并清该卡详情），不改选别的敌人
            GameSession.EnemyCardPop => s.Battle == null && s.Encounter == null && e.CardsV2(s) && e.EnemyCardHere(s, pop.Id) != null,
            "charcoal" => s.Battle == null && s.Encounter == null && G.Panel == null && pop.Id == s.Ground && e.HasFireAt(s, s.Ground),
            "lockstack" => s.Battle == null && G.Panel == null && e.AdjacentLockedGroups(s).Any(g => g.Routes.Count >= 3),
            "harvest" => s.Battle == null && G.Panel == "drying" && e.DryingRackHere(s) && int.TryParse(pop.Id, out var hk) && e.DryingSlotAt(s, s.Ground, hk)?.Status == DryingSlot.Done,
            "gather" => G.Selected.Kind == SelectionKind.Action && G.PendingAction != null && G.PendingAction.Type == ActionType.Gather && G.PendingAction.TargetId == pop.Id,
            _ => true,
        };
        if (!ok) G.DropPop();
        return ok;
    }

    private async Task Travel(ActionRequest req, bool fromMap)
    {
        if (_go) return;
        _go = true;
        _tried = true;
        try
        {
            var t = G.StartAction(req);
            // 区域地图上确认后收起地图，让中央推进条与地块栏可见（原右栏确认的 OnStarted 行为）
            if (fromMap && G.S.Main?.Type == ActionType.Travel) G.OpenPanel(null);
            await t;
        }
        finally { _go = false; }
    }

    private async Task Approach(int wid)
    {
        if (_go) return;
        _go = true;
        _tried = true;
        try { await G.ApproachEnemy(wid); }
        finally { _go = false; }
    }

    /// <summary>B41e1：敌踪卡盘「主动接近」（盘内点击即提交；执行中锁按钮，重复点击不重复提交）。</summary>
    private async Task ApproachCard(string key)
    {
        if (_go) return;
        _go = true;
        _tried = true;
        try { await G.ApproachEnemyCard(key); }
        finally { _go = false; }
    }

    /// <summary>B41e1：敌踪卡盘「潜行接近」「躲避」（点击提交 5 分钟行动；带上盘里显示的队长与成功率，内核比对不一致时拒绝）。</summary>
    private async Task StealthCard(string key, string kind, string leaderId, int rate)
    {
        if (_go) return;
        _go = true;
        _tried = true;
        try { await G.StealthEnemyCard(key, kind, leaderId, rate); }
        finally { _go = false; }
    }

    private void LoadCharcoal()
    {
        if (_go) return;
        _go = true;
        _tried = true;
        try
        {
            // Q113：带上浮窗展示的明细确认；来源已变化时整条拒绝，浮窗留着、刷新明细并显示原因，玩家再点确认
            var res = G.ConfirmCharcoal();
            // B10b 试玩修复：投料后收起浮窗并清掉选中（被取走一部分的木材堆不再弹操作窗盖住火堆）
            if (res.Ok) G.ClearSelection();
        }
        finally { _go = false; }
    }

    /// <summary>Q364：本盘上一次提交被拒的实际原因（换盘时清掉）。</summary>
    private string? _harvestFail;

    private void Harvest(int slot, bool toCarried)
    {
        if (_go) return;
        _go = true;
        _tried = true;
        try
        {
            var r = G.EngineDo(() => G.E.TakeDrying(G.S, slot, toCarried, Guid.NewGuid().ToString("N")));
            _harvestFail = r.Ok ? null : r.Reason;
            if (r.Ok) G.ClosePop();
        }
        finally { _go = false; }
    }

    private async Task Gather(ActionRequest req)
    {
        if (_go) return;
        _go = true;
        _tried = true;
        try { await G.StartAction(req); }
        finally { _go = false; }
    }
}
