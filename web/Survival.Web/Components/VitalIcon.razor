@* Small HUD symbols remain vectors so they stay clear at every display scale. *@
<svg class="vital-icon" viewBox="0 0 32 36" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Stat)
    {
        case "health":
            <path d="M16 29 4 16C-2 8 9 1 16 10 23 1 34 8 28 16ZM5 12 7 8M22 8 25 10" />
            break;
        case "satiety":
            <path d="M5 4v10q0 5 4 5v13M9 4v11M13 4v10q0 5-4 5M24 4c-7 7-6 13-1 13h3V4Zm2 13v15" />
            break;
        case "hydration":
            <path d="M16 3C14 12 4 18 5 25c1 10 22 10 22-1C27 17 19 11 16 3ZM13 16c-6 9-4 11 0 12M19 27l2-2" />
            break;
        case "energy":
            <circle cx="20" cy="6" r="3" />
            <path d="m17 12-7 5-5-1m12-4 5 6 6 1M17 12l-4 10 7 3 2 8M13 22l-5 6-5 1M15 11l3 1" />
            break;
        case "wakefulness":
            <path d="M2 18s6-9 14-9 14 9 14 9-6 9-14 9S2 18 2 18ZM5 11l3-3M24 8l3 3" />
            <circle cx="16" cy="18" r="5" /><circle cx="16" cy="18" r="1.5" fill="currentColor" />
            break;
        case "morale":
            <path d="M10 32v-8l-5-1 1-6-3-1 4-6C8 0 26 1 28 13c1 6-4 9-6 12v7M10 9l5-2 5 2-2 5 4 3-3 5M11 13l3 1m-5 5h4M14 29h7" />
            break;
        case "immunity":
            <path d="m16 3 12 5-1 12c0 5-7 11-11 13C12 31 5 25 5 20L4 8Zm0 5v20M8 11l1 9 7 8M24 11l-1 9-7 8" />
            break;
        case "virus":
            <circle cx="16" cy="18" r="9" /><path d="M16 3v6m0 18v6M1 18h6m18 0h6M5 7l5 5m12 12 5 5M5 29l5-5m12-12 5-5M13 3h6m-6 30h6M1 15v6m30-6v6" />
            <circle cx="13" cy="15" r="1.5" /><circle cx="20" cy="18" r="1" /><circle cx="14" cy="22" r="1" />
            break;
    }
</svg>

@code {
    [Parameter] public string Stat { get; set; } = "";
}
