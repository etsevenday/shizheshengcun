{
  "desc": "B36a 休息页重排：同屏「休息」「睡眠」两行小时档（休息0.5／1／2小时、睡眠2／4／8小时，Q815、Q897 A）；真正新开不预选、开始键禁用「开始」＋「先选时长」（Q887 B、Q1124 A）；中部「休息条件」、无风险不出「风险」、不用「可用方式／预计恢复」（Q896 A）；悬停只换右栏预估、离开回所选或常规内容（Q815、Q1125 A）；点档才选中、开始另点；开工后留在进度浮窗下、结束回本页保留所选（Q1103 B、Q1123 A）；关页重开回未选。来源：doc/开发记录/B36a 阅读与队伍页.md（B36a.1 范围 6、B36a.4 休息页、偏差 5／6）",
  "batch": "B36a",
  "fixture": "new-game",
  "watch": ["pt=rest-start", "pt=rest-close"],
  "steps": [
    { "use": "continue" },
    { "key": "r" },
    { "expect": "pt=rest-plan" },

    { "note": "两行小时档（Q815 用户自定、Q897 A）" },
    { "expect": "pt=rest-row", "count": 2 },
    { "eval": "['rest','sleep'].map(k => [...document.querySelectorAll('[data-pt=rest-pick][data-kind=' + k + ']')].map(b => b.textContent.trim()).join(',')).join('|')", "equals": "0.5小时,1小时,2小时|2小时,4小时,8小时", "label": "休息0.5／1／2小时、睡眠2／4／8小时" },
    { "eval": "[...document.querySelectorAll('[data-pt=rest-row] h3')].map(h => h.firstChild.textContent.trim()).join(',')", "equals": "休息,睡眠" },

    { "note": "真正新开不预选（Q887 B、Q1124 A）" },
    { "expect": "[data-pt=rest-pick].on", "absent": true, "label": "不预选" },
    { "expect": "pt=rest-picked", "absent": true },
    { "expect": "pt=rest-start", "disabled": true, "label": "开始键禁用" },
    { "eval": "document.querySelector('[data-pt=rest-start]').firstChild.textContent.trim()", "equals": "开始", "label": "Q1124 A：没选时开始键写「开始」" },
    { "expect": "pt=rest-why", "textIs": "先选时长", "label": "Q887 B：短原因「先选时长」" },

    { "note": "中部（Q896 A）：「休息条件」照真实条件，没有风险不出「风险」，不用「可用方式」「预计恢复」" },
    { "expect": "pt=rest-cond", "text": "休息条件" },
    { "expect": "pt=rest-cond-text", "textIs": "露天", "label": "临时营地露天" },
    { "expect": "pt=rest-risk", "absent": true, "label": "新局精神60、不濒死：无「风险」" },
    { "expectNoText": ["可用方式", "预计恢复", "当前条件"], "in": ".rest-panel" },
    { "expect": "pt=pv-minutes", "absent": true, "label": "Q1125 A：没选也没悬停，右栏走常规内容" },
    { "expectText": "当前位置", "in": ".panel.detail" },
    { "shot": "rest-open", "mask": [".sl-now"] },

    { "note": "悬停只换右栏预估，不选中、不开始（Q815、Q887 B）" },
    { "hover": "[data-pt=rest-pick][data-kind=sleep][data-min='480']" },
    { "expect": "pt=pv-minutes", "textIs": "8小时", "label": "Q897 A：本页右栏计划时长用小时" },
    { "expectText": "休息与睡眠 · 睡眠", "in": ".panel.detail" },
    { "expect": "[data-pt=rest-pick].on", "absent": true, "label": "悬停不选中" },
    { "expect": "pt=rest-start", "disabled": true, "label": "悬停不启开始" },
    { "hover": [5, 700] },
    { "expect": "pt=pv-minutes", "absent": true, "label": "离开后右栏回常规内容（Q1125 A）" },

    { "note": "点一下才选中；悬停别的档只临时换右栏，离开回所选" },
    { "click": "[data-pt=rest-pick][data-kind=rest][data-min='30']" },
    { "expect": "[data-pt=rest-pick][data-kind=rest][data-min='30'].on", "label": "点选休息0.5小时" },
    { "expect": "[data-pt=rest-pick].on", "count": 1 },
    { "expect": "pt=rest-picked", "textIs": "休息 · 0.5小时", "label": "偏差6：开始条「{方式} · {小时}」" },
    { "expect": "pt=rest-start", "disabled": false },
    { "eval": "document.querySelector('[data-pt=rest-start]').firstChild.textContent.trim()", "equals": "休息0.5小时", "label": "Q897 A 例：开始键「休息0.5小时」" },
    { "expect": "pt=rest-why", "absent": true },
    { "hover": [5, 700] },
    { "expect": "pt=pv-minutes", "textIs": "0.5小时", "label": "右栏显示所选一档" },
    { "hover": "[data-pt=rest-pick][data-kind=sleep][data-min='240']" },
    { "expect": "pt=pv-minutes", "textIs": "4小时" },
    { "expect": "pt=rest-picked", "textIs": "休息 · 0.5小时", "label": "悬停不改所选" },
    { "hover": [5, 700] },
    { "expect": "pt=pv-minutes", "textIs": "0.5小时", "label": "离开回所选预估" },
    { "shot": "rest-picked", "mask": [".sl-now"] },

    { "note": "进子页（系统说明）再回来：同一窗口保留草稿（Q887 B）；关页重开回未选" },
    { "key": "h" },
    { "expect": ".help-panel" },
    { "click": "pt=help-exit" },
    { "expect": ".rest-panel", "label": "说明关掉回到休息页" },
    { "expect": "[data-pt=rest-pick][data-kind=rest][data-min='30'].on", "label": "子页返回保留所选" },
    { "click": "pt=rest-close" },
    { "expect": ".rest-panel", "absent": true },
    { "key": "r" },
    { "expect": "[data-pt=rest-pick].on", "absent": true, "label": "关页重开回未选" },
    { "expect": "pt=rest-start", "disabled": true },

    { "note": "开工：留在进度浮窗下，结束回本页，所选保留（Q1103 B、Q1123 A）" },
    { "click": "[data-pt=rest-pick][data-kind=rest][data-min='120']" },
    { "click": "pt=rest-start", "checks": false },
    { "wait": "[data-prog-lock]", "timeout": 5000, "checks": false },
    { "expect": ".rest-panel", "checks": false, "label": "进度浮窗下休息页仍在" },
    { "waitGone": "[data-prog-lock]", "timeout": 60000 },
    { "expect": ".rest-panel", "label": "结束回本页" },
    { "expect": "[data-pt=rest-pick][data-kind=rest][data-min='120'].on", "label": "Q1123 A：所选档保留" },
    { "expect": "pt=rest-picked", "textIs": "休息 · 2小时" },
    { "expectText": "休息结束（2小时）", "optional": true, "timeout": 1000, "label": "（记录）中央／日志沿原分钟格式（Q897 A），这里只记录" },
    { "wait": 600 },
    { "eval": "(a => a ? (a.getAttribute('data-pt') || a.className) : 'none')(document.activeElement)", "noAssert": true, "label": "（记录）结束后焦点在哪" },
    { "eval": "(document.documentElement.dataset.ptT = document.querySelector('.sl-now').textContent, true)" },
    { "key": "Enter", "checks": false, "label": "结束后直接按回车" },
    { "wait": 1500, "checks": false },
    { "eval": "!document.querySelector('[data-prog-lock]') && document.querySelector('.sl-now').textContent === document.documentElement.dataset.ptT", "label": "Q1123 A 用意：回车不会再休息一轮" },
    { "eval": "document.activeElement && document.activeElement.matches('[data-pt=rest-pick].on')", "label": "Q1123 A：焦点落所选时长（不落开始键、不只落在页面容器）" }
  ]
}
