{
  "desc": "B36a 系统说明的直接定位来路：①从食饮盘「查看食饮说明」进来——独立退出只写「返回」（不写「返回食饮」），正文「‹ 返回」只回所属主题；Esc 第1次回主题摘要、第2次回原食饮盘（Q955 B、Q890 B、Q899 A；合同 help）；②战斗菜单「系统说明」抽屉——退出写「关闭」，Esc 一次一层回战斗画面（开发假设 3、Q890 B）。来源：doc/开发记录/B36a 阅读与队伍页.md（B36a.1 范围 2、开发假设 2／3）",
  "batch": "B36a",
  "fixture": "new-game",
  "watch": ["pt=help-exit", "pt=help-back"],
  "steps": [
    { "use": "continue" },

    { "note": "①食饮来路：B29 食饮试玩组（同行林昭、周砚），拾取5份净水到随身，选随身净水 → 给同行者饮用 → 查看食饮说明" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text=B29 食饮试玩组", "label": "开发入口：B29 食饮试玩组" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "click": "pt=shelf-ground >> pt=card-clean_water" },
    { "click": "[aria-label=转移数量]" },
    { "key": "ctrl+a" },
    { "type": "5" },
    { "click": "text=拾取5份到随身" },
    { "key": "Escape", "while": "[aria-label=转移数量]", "max": 3 },
    { "click": "pt=shelf-carried >> pt=card-clean_water", "label": "选随身净水" },
    { "click": "[data-feed-entry]", "label": "给同行者饮用（食饮盘）" },
    { "expect": "[data-feed-help]" },
    { "click": "[data-feed-help]", "label": "查看食饮说明" },
    { "expect": ".help-panel" },
    { "expect": "[data-pt=help-entry][data-entry=feed-companion].on", "label": "直接定位到食饮条目" },
    { "expect": "[data-pt=help-topic][data-topic=body][aria-expanded=true]", "label": "所属主题在左栏展开" },
    { "expect": "pt=help-exit", "text": "返回", "label": "Q955 B：独立退出写「返回」" },
    { "expectNoText": "返回食饮", "in": ".help-panel", "label": "Q955 B：停用「返回食饮」" },
    { "expect": "pt=help-back", "text": "‹ 返回", "label": "Q899 A：正文内「‹ 返回」" },
    { "shot": "help-from-feed", "mask": [".sl-now"] },
    { "key": "Escape", "label": "Esc 第1次：条目 → 所属主题摘要（Q890 B，不一步直返）" },
    { "expect": ".help-panel" },
    { "expect": "pt=help-topic-summary", "text": "人物、生存与医疗" },
    { "expect": "pt=help-back", "absent": true },
    { "expect": "pt=help-exit", "text": "返回", "label": "主题摘要时退出仍写「返回」" },
    { "key": "Escape", "label": "Esc 第2次：回真实原入口（食饮盘）" },
    { "expect": ".help-panel", "absent": true },
    { "expect": "[data-feed-confirm]", "label": "回到原食饮盘" },
    { "click": "[data-feed-help]" },
    { "click": "pt=help-back", "label": "点「‹ 返回」只回所属主题" },
    { "expect": "pt=help-topic-summary" },
    { "expect": ".help-panel" },
    { "click": "pt=help-exit", "label": "主题摘要上点独立退出「返回」" },
    { "expect": ".help-panel", "absent": true },
    { "expect": "[data-feed-confirm]", "label": "独立退出回原食饮盘" },
    { "click": "[data-feed-help]" },
    { "click": "pt=help-exit", "label": "条目正文上直接点独立退出" },
    { "expect": ".help-panel", "absent": true },
    { "expect": "[data-feed-confirm]", "label": "一次回原食饮盘" },
    { "key": "Escape", "while": "[data-feed-confirm]", "max": 3 },

    { "note": "②战斗说明抽屉：去农野荒地（首战游荡尸）主动接近，战斗菜单 → 系统说明" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "select": "select[aria-label=传送目标]", "value": "field" },
    { "click": "text==传送（按实际到达处理）" },
    { "use": "dlg" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "click": "text==游荡尸" },
    { "click": "text==主动接近" },
    { "wait": ".anc.foe", "timeout": 10000 },
    { "use": "dlg" },
    { "key": "Escape", "until": ".menu-modal", "max": 3, "label": "战斗菜单（Esc）" },
    { "click": ".menu-modal >> text==系统说明" },
    { "expect": ".bfs-drawer .help-panel" },
    { "expect": "pt=help-summary", "count": 9, "label": "抽屉新开同样是9主题总览" },
    { "expect": "pt=help-exit", "text": "关闭", "label": "开发假设 3：战斗抽屉退回战斗画面写「关闭」" },
    { "click": "[data-pt=help-topic][data-topic=combat]" },
    { "click": "[data-pt=help-entry][data-entry=rounds]" },
    { "expect": ".help-article h3", "textIs": "回合与行动点" },
    { "shot": "help-battle", "mask": [".sl-now"] },
    { "key": "Escape", "label": "Esc 第1次：回主题摘要" },
    { "expect": ".bfs-drawer .help-panel" },
    { "expect": "pt=help-topic-summary", "text": "敌踪与战斗" },
    { "key": "Escape", "label": "Esc 第2次：回战斗画面" },
    { "expect": ".bfs-drawer", "absent": true },
    { "expect": ".anc.foe", "label": "仍在战斗中" },
    { "key": "Escape", "until": ".menu-modal", "max": 3 },
    { "click": ".menu-modal >> text==系统说明" },
    { "click": "[data-pt=help-topic][data-topic=combat]" },
    { "click": "[data-pt=help-entry][data-entry=rounds]" },
    { "click": "pt=help-exit", "label": "正文上点「关闭」" },
    { "expect": ".bfs-drawer", "absent": true },
    { "expect": ".anc.foe" }
  ]
}
