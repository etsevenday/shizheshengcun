{
  "desc": "B36a 队伍三页：编队「入场站位」「未分配」、删 Q825 旧句（Q825 A、Q950 A）；成长左标题「熟练度」、三组17项、详情头「当前等级／经验／下一个技能：」、技能卡单张说明、默认下一个未解锁、本次运行每门类记卡、切人保留、意志参考格只读、满级不编下一技能（Q823 A、Q824 A、Q892 B、Q951 A）；右栏人物页「入场站位」说明、「留守候补」组与「所在地点」直显、本地箱区默认收起／「查看认领箱」展开／「返回」收起、「认领箱」总标题（Q891 A、Q952 A）。来源：doc/开发记录/B36a 阅读与队伍页.md（B36a.1 范围 7—9，偏差 2／3／4）；合同 b36a-q950-q955-ui-copy.json formation／growth／reserve",
  "batch": "B36a",
  "fixture": "discard-list",
  "watch": ["pt=growth-card-desc"],
  "steps": [
    { "use": "continue" },

    { "note": "编队（Q950 A、Q825 A）：林昭同行在1号位或2号位，其余号位「未分配」" },
    { "key": "p" },
    { "eval": "/^入场站位 · 前排1号位→后排4号位 · 同行\\d+\\/C\\d+（C只限人数，不限号位）· 保存不花时间、AP和体力$/.test(document.querySelector('[data-pt=fm-sub]').textContent.trim())", "label": "Q950 A：副标「开战号位」换「入场站位」，其余原样" },
    { "expectNoText": ["开战号位", "空位", "队友暂时还不会跟你进战斗", "下一场只有你按这里的号位入场"], "in": ".formation-panel", "label": "Q950 A 不留旧名词；Q825 A 删旧句" },
    { "eval": "(() => { const els = [...document.querySelectorAll('.fm-slot.empty')]; return els.length > 0 && els.every(b => b.querySelector('[data-pt=fm-slot-name]').textContent.trim() === '未分配' && b.title === b.dataset.slot + '号位未分配：先点一名角色，再点这里'); })()", "label": "Q950 A：空号位「未分配」，悬停「{n}号位未分配：先点一名角色，再点这里」" },
    { "expect": "pt=fm-note", "text": "站位不会按武器自动更正", "label": "底部合法说明保留" },
    { "expect": "pt=fm-note", "text": "编入同行/留作候补在", "label": "Q825 A：前半句办理地点保留" },
    { "shot": "formation", "mask": [".sl-now"] },
    { "key": "Escape" },
    { "expect": ".formation-panel", "absent": true },
    { "eval": "[...document.querySelectorAll('button')].some(b => (b.title || '').startsWith('编队：安排入场站位（前排1→后排4）'))", "label": "偏差2：顶栏编队悬停也写「入场站位」" },

    { "note": "成长（Q951 A、Q824 A、Q892 B、Q823 A）" },
    { "key": "k" },
    { "expect": "pt=growth-list-title", "textIs": "熟练度" },
    { "eval": "[...document.querySelectorAll('.growth-list .skill-group')].map(e => e.textContent.trim()).join(',')", "equals": "战斗,医疗（战内外）,求生与行动", "label": "原三组保留" },
    { "expect": ".growth-skill", "count": 17, "label": "实际17项" },
    { "expect": ".growth-skill.on b", "textIs": "拳", "label": "Q823 A：首次默认拳" },
    { "eval": "/^当前等级 1\\/\\d+级$/.test(document.querySelector('[data-pt=growth-level]').textContent.trim())", "label": "「当前等级 {L}/{上限}级」" },
    { "eval": "/^经验 \\d+\\/\\d+，升到2级$/.test(document.querySelector('[data-pt=growth-xp]').textContent.trim())", "label": "「经验 {xp}/{升级所需}，升到{L+1}级」" },
    { "eval": "/^下一个技能：3级 \\S+$/.test(document.querySelector('[data-pt=growth-next]').textContent.trim())", "label": "「下一个技能：{L}级 {技能名}」（1级节点已解锁，下一个是3级）" },
    { "expect": "pt=growth-card", "count": 5, "label": "五卡一排" },
    { "expect": "pt=growth-card-desc", "count": 1, "label": "Q824 A：说明一次只显示一张" },
    { "eval": "document.querySelector('[data-pt=growth-card][aria-pressed]').dataset.card === document.querySelector('[data-pt=growth-card-desc]').dataset.card && document.querySelector('[data-pt=growth-card][aria-pressed] b').textContent.startsWith('3级')", "label": "Q824 A：默认下一个未解锁（3级）" },
    { "expect": "pt=growth-card-desc", "text": "未解锁" },
    { "expect": "pt=growth-card-desc", "text": "需要拳3级（当前1级）", "label": "锁级说明同原句" },
    { "expectText": "经验只给实际出手/工作的本人；两件同门类武器不叠经验、不多解锁技能。命中、伤害等公式见系统说明。", "in": ".growth-detail", "label": "普通底句保留" },
    { "shot": "growth-fists", "mask": [".sl-now"] },
    { "click": "[data-pt=growth-card]", "nth": 0, "label": "点1级卡" },
    { "eval": "document.querySelector('[data-pt=growth-card-desc] b').textContent.startsWith('1级')", "label": "说明切到1级卡" },
    { "expect": "pt=growth-card-desc", "text": "已解锁" },
    { "click": ".growth-skill", "nth": 1, "label": "换第2门" },
    { "eval": "document.querySelector('[data-pt=growth-card][aria-pressed]') ? document.querySelector('[data-pt=growth-card][aria-pressed] b').textContent.slice(0, 2) : 'none'", "noAssert": true, "label": "（记录）第2门默认卡" },
    { "click": ".growth-skill", "nth": 0, "label": "切回拳" },
    { "eval": "document.querySelector('[data-pt=growth-card-desc] b').textContent.startsWith('1级')", "label": "Q892 B：切回来恢复上次点的1级卡" },
    { "key": "Escape" },
    { "key": "k" },
    { "expect": ".growth-skill.on b", "textIs": "拳", "label": "Q823 A：关页重开记住门类" },
    { "eval": "document.querySelector('[data-pt=growth-card-desc] b').textContent.startsWith('1级')", "label": "Q892 B：关页重开恢复记卡" },
    { "click": ".gear-member[data-actor]:not(.on)", "label": "切到林昭" },
    { "expect": ".growth-skill.on b", "textIs": "拳", "label": "切人保留门类" },
    { "eval": "document.querySelector('[data-pt=growth-card-desc] b').textContent.startsWith('1级')", "label": "切人保留记卡（卡说明全角色共用）" },
    { "click": ".gear-member[data-actor]:not(.on)", "label": "切回你" },
    { "click": ".growth-skill[data-skill=willpower]", "label": "意志" },
    { "expect": "pt=growth-next", "absent": true, "label": "偏差4：意志没有「下一个技能」" },
    { "expect": "pt=growth-level", "text": "当前等级" },
    { "expect": "pt=growth-card", "count": 5, "label": "五个参考格" },
    { "expectNoText": ["已解锁", "未解锁"], "in": ".growth-detail", "label": "Q736：意志不写已解锁／未解锁" },
    { "expect": "pt=growth-card-desc", "count": 1 },
    { "click": "[data-pt=growth-card]", "nth": 4, "label": "点10级参考格（只读，不学习）" },
    { "eval": "document.querySelector('[data-pt=growth-card-desc]').dataset.card === document.querySelector('[data-pt=growth-card]:nth-child(5)').dataset.card", "label": "说明切到所点那格" },
    { "expect": "pt=growth-level", "text": "当前等级 1/", "label": "点格不改等级" },
    { "shot": "growth-will", "mask": [".sl-now"] },
    { "key": "Escape" },

    { "note": "满级：不编下一等级、下一个技能" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==熟练度全部10级（含战斗）" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "key": "k" },
    { "click": ".growth-skill", "nth": 1, "label": "第2门（没点过卡）" },
    { "expect": "pt=growth-xp", "textIs": "满级，不再获得经验" },
    { "expect": "pt=growth-next", "absent": true },
    { "eval": "document.querySelector('[data-pt=growth-card][aria-pressed] b').textContent.startsWith('10级')", "label": "Q824 A：全解锁默认最高一张" },
    { "key": "Escape" },

    { "note": "右栏人物页（Q950 A、Q952 A、Q891 A）" },
    { "click": "text==人物", "label": "右栏人物页" },
    { "click": "[aria-label=展开成员]", "optional": true, "timeout": 1500 },
    { "expect": "pt=party-note", "text": "入场站位在顶栏“编队”里改（任何地点空闲时都可以）", "label": "Q950 A：队伍说明「入场站位」" },
    { "expectNoText": "开战号位", "in": ".party-block" },
    { "expect": "pt=reserve-group", "absent": true, "label": "没有候补不出候补组" },
    { "expect": "pt=boxes", "absent": true, "label": "Q891 A：本地箱区默认收起" },
    { "expect": "pt=boxes-toggle", "textIs": "查看认领箱" },
    { "click": "pt=boxes-toggle" },
    { "expect": "pt=boxes-title", "textIs": "认领箱", "label": "Q952 A：展开区总标题「认领箱」" },
    { "expect": "pt=boxes >> [data-remains]", "count": 4, "label": "展开本地全部箱（遗物、认领箱、回收箱、旧实例遗物认领箱）" },
    { "expectText": ["退役寄存", "的遗物"], "in": "pt=boxes", "label": "原各箱名保留" },
    { "expect": "pt=boxes-toggle", "textIs": "返回", "label": "Q891 A：同一位置写「返回」" },
    { "eval": "(document.querySelector('[data-pt=boxes-title]').scrollIntoView({ block: 'start' }), true)", "label": "右栏滚到箱区（只为截图）" },
    { "shot": "boxes-open", "mask": [".sl-now"] },
    { "click": "pt=boxes-toggle" },
    { "expect": "pt=boxes", "absent": true, "label": "「返回」只收起箱区" },
    { "expect": "pt=party-note", "label": "队伍其余部分还在" },

    { "note": "留守候补（Q952 A）：开发入口把林昭切成候补" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==切换在队/候补", "nth": 0 },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "click": "[aria-label=展开成员]", "optional": true, "timeout": 1500 },
    { "expect": "pt=reserve-title", "textIs": "留守候补", "label": "候补单列「留守候补」组" },
    { "expect": "pt=reserve-group >> .party-row", "count": 1 },
    { "expect": "pt=reserve-group >> .party-pos", "textIs": "候补", "label": "每人行首仍「候补」" },
    { "eval": "/^所在地点 \\S+$/.test(document.querySelector('[data-pt=reserve-where]').textContent.trim())", "label": "「所在地点 {地点名}」直显在姓名行" },
    { "eval": "document.querySelector('[data-pt=reserve-where]').textContent.trim()", "noAssert": true, "label": "（记录）所在地点" },
    { "expectNoText": "· 在", "in": "pt=reserve-group >> .party-care", "label": "偏差3：作息行去掉重复的「· 在{地点}」" },
    { "eval": "!document.querySelector('.party-list:not(.party-reserves) .party-row.reserve')", "label": "同行列表里不再混候补" },
    { "expect": "pt=party-note", "text": "入场站位在顶栏“编队”里改", "label": "两段原说明保留（名词随 Q950）" },
    { "expectText": "候补在所在处", "in": ".party-block" },
    { "eval": "(document.querySelector('[data-pt=reserve-group]').scrollIntoView({ block: 'start' }), true)", "label": "右栏滚到候补组（只为截图）" },
    { "shot": "reserve", "mask": [".sl-now"] }
  ]
}
