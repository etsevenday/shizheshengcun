{
  "desc": "B67 R353 物品详情「已知工艺」（S08 D28、Q1040 B、Q1041 A；S14 D28-01、Q1040-01、Q1041-01）：陶壳前后工序例句、无工作台时只读门槛说明、逐步展开、点工序走原入口（陶窑工作区／手工制作）且不移动不开工；草药绷带工位写「手工制作」；生肉无入口；限制显现后节点消失；读档后折叠偏好。来源：doc/开发记录/B67 制作检索、工艺链与来源定位.md（B67.4 D28／Q1040／Q1041）",
  "batch": "B67",
  "fixture": "stations-built",
  "steps": [
    { "use": "continue" },
    { "key": "Escape", "until": ".menu-modal", "max": 4, "label": "ESC 直到游戏菜单打开" }, { "click": "text=新物品（材料）", "label": "开发入口：新物品（材料）各1（含陶壳、黏土）放临时营地地面" },
    { "use": "dlg" },
    { "click": "pt=shelf-ground >> pt=card-ceramic_shell", "label": "正式点选地面陶壳" },

    { "note": "D28：详情里「已知工艺」组，默认收起" },
    { "expect": "[data-fold=craftchain] .rail-fold-head .fold-name", "textIs": "已知工艺" },
    { "expect": "[data-fold=craftchain] .rail-fold-head", "inView": true },
    { "eval": "document.querySelector('[data-fold=craftchain] .rail-fold-head').getAttribute('aria-expanded')", "equals": "false", "label": "没有偏好时默认收起" },
    { "click": "[data-fold=craftchain] .rail-fold-head", "label": "展开「已知工艺」" },
    { "expect": "pt=chain-list" },
    { "eval": "JSON.stringify([...document.querySelectorAll('[data-pt=chain-list] > [data-pt=chain-node] > .chain-row [data-pt=chain-step]')].map(b => b.textContent.trim()))", "equals": "[\"黏土 → 陶窑 → 陶壳\",\"陶壳、木炭、布料 → 工作台 → 长效滤芯\",\"陶壳、木板、布料 → 手工制作 → 建固定净水台\"]", "label": "D28 例句：先上一步「黏土 → 陶窑 → 陶壳」，再后续「陶壳、木炭、布料 → 工作台 → 长效滤芯」；无实体工位写「手工制作」（Q1041）" },
    { "eval": "[...document.querySelectorAll('[data-pt=chain-list] > [data-pt=chain-node]')].map(n => n.dataset.dir).join(',')", "equals": "prev,next,next" },

    { "note": "Q1041-01：实体工位不可用（营地没有工作台）——点「长效滤芯」留在只读详情，沿原「需要{设施名}」说明，不投料不开工；再点收起" },
    { "eval": "(() => { window.__b67 = { clock: document.querySelector('.sl-clock').textContent.trim(), shell: document.querySelector('[data-pt=shelf-ground] [data-pt=card-ceramic_shell]').textContent.trim() }; return true; })()", "label": "记下时刻与地面陶壳卡面" },
    { "click": "[data-pt=chain-node][data-recipe=ex_filter_cartridge] > .chain-row [data-pt=chain-step]" },
    { "expect": "[data-craft-close]", "absent": true, "label": "不进工作区" },
    { "expect": "[data-pt=chain-node][data-recipe=ex_filter_cartridge] > [data-pt=chain-why] .warn-text", "text": "需要工作台", "label": "只读门槛说明「需要工作台…」" },
    { "expectNoText": ["行动进行中"] },
    { "shot": "chain-why" },
    { "click": "[data-pt=chain-node][data-recipe=ex_filter_cartridge] > .chain-row [data-pt=chain-step]", "label": "再点收起说明" },
    { "expect": "[data-pt=chain-node][data-recipe=ex_filter_cartridge] > [data-pt=chain-why]", "absent": true },

    { "note": "D28：多条路线可逐步展开；没有下一层的工序不给展开键" },
    { "expect": "[data-pt=chain-node][data-recipe=ex_ceramic_shell] > .chain-row [data-pt=chain-toggle]", "absent": true, "label": "陶窑的陶壳没有更前一步（无产黏土的公开配方）→ 无展开键" },
    { "eval": "document.querySelector('[data-pt=chain-list] > [data-pt=chain-node][data-recipe=ex_filter_cartridge] > .chain-row [data-pt=chain-toggle]').getAttribute('aria-expanded')", "equals": "false" },
    { "click": "[data-pt=chain-list] > [data-pt=chain-node][data-recipe=ex_filter_cartridge] > .chain-row [data-pt=chain-toggle]", "label": "展开长效滤芯的后续" },
    { "eval": "JSON.stringify([...document.querySelectorAll('[data-pt=chain-list] > [data-pt=chain-node][data-recipe=ex_filter_cartridge] > .chain-list > [data-pt=chain-node] > .chain-row [data-pt=chain-step]')].map(b => b.textContent.trim()))", "equals": "[\"脏水、长效滤芯 → 手工制作 → 滤芯处理脏水\"]", "label": "下一层：以长效滤芯为原料的「脏水、长效滤芯 → 手工制作 → 滤芯处理脏水」" },
    { "expect": "[data-pt=chain-list] > [data-pt=chain-node][data-recipe=ex_filter_cartridge] > .chain-row [data-pt=chain-toggle][aria-expanded=true]" },
    { "eval": "(() => { const r = document.querySelector('.rail-page') || document.body; return ![...document.querySelectorAll('[data-pt=chain-step]')].some(b => { const x = b.getBoundingClientRect(); const p = b.closest('[data-fold=craftchain]').getBoundingClientRect(); return x.right > p.right + 1 || x.left < p.left - 1; }); })()", "label": "工序整句在右栏内折行、不超出组宽" },
    { "shot": "chain-expanded" },

    { "note": "D28-01：点上一步「陶壳」（陶窑在本区、空闲）→ 进陶窑工作区并选中该配方；不移动陶壳、不开工、不推进时间" },
    { "click": "[data-pt=chain-node][data-recipe=ex_ceramic_shell] > .chain-row [data-pt=chain-step]" },
    { "expect": "[data-craft-close]", "label": "制作窗口打开" },
    { "expect": "[data-craft-site] .sub-head h2", "text": "陶窑", "label": "进陶窑工作区（原入口）" },
    { "expect": "[data-recipe=ex_ceramic_shell].on", "label": "选中陶壳配方" },
    { "expectNoText": ["行动进行中"], "label": "不自动开工" },
    { "eval": "document.querySelector('.sl-clock').textContent.trim() === window.__b67.clock", "label": "时间不推进" },
    { "note": "D25：设施工作区也有「搜索配方或材料」" },
    { "expect": "pt=craft-search", "inView": true },
    { "click": "pt=craft-search" },
    { "type": "黏土" },
    { "expect": "[data-recipe=ex_ceramic_shell]", "label": "陶窑工作区按原料名「黏土」命中陶壳" },
    { "key": "ctrl+a" }, { "key": "Backspace" },
    { "type": "钢材" },
    { "expect": "pt=craft-no-match", "textIs": "没有符合条件的配方。", "label": "不跨工坊取锻炉的钢材配方" },
    { "key": "Escape", "label": "ESC 关工作区" },
    { "expect": "[data-craft-close]", "absent": true },
    { "expect": "[data-fold=craftchain]", "label": "详情仍是陶壳（选中实物未变）" },
    { "eval": "document.querySelector('[data-pt=shelf-ground] [data-pt=card-ceramic_shell]').textContent.trim() === window.__b67.shell", "label": "地面陶壳未移动、未扣" },

    { "note": "Q1041：点无实体工位的「建固定净水台」→ 原手工制作入口并选中；换入口后搜索词已清" },
    { "click": "[data-pt=chain-node][data-recipe=build_water_station] > .chain-row [data-pt=chain-step]" },
    { "expect": "[data-craft-close]" },
    { "expect": "[data-craft-site=\"\"] .sub-head h2", "textIs": "手工制作" },
    { "expect": "[data-recipe=build_water_station].on" },
    { "eval": "document.querySelector('[data-pt=craft-search]').value", "equals": "", "label": "换工作区（陶窑 → 手工制作）搜索词清除" },
    { "expectNoText": ["行动进行中"] },
    { "key": "Escape" },

    { "note": "Q1041-01：草药绷带工位显示「手工制作」，点工序走原手工制作入口" },
    { "key": "Escape", "until": ".menu-modal", "max": 4, "label": "ESC 直到游戏菜单打开" }, { "click": "text=药品各1（绷带/抗生素/特效药）" },
    { "use": "dlg" },
    { "click": "pt=card-bandage", "label": "点选草药绷带" },
    { "expect": "[data-fold=craftchain] .rail-fold-head[aria-expanded=true]", "label": "同类对象沿刚才的展开偏好" },
    { "expect": "[data-pt=chain-node][data-recipe=bandage][data-dir=prev] > .chain-row [data-pt=chain-step]", "textIs": "布料、草药 → 手工制作 → 草药绷带", "label": "Q1041 例句" },
    { "click": "[data-pt=chain-node][data-recipe=bandage][data-dir=prev] > .chain-row [data-pt=chain-step]" },
    { "expect": "[data-craft-site=\"\"] .sub-head h2", "textIs": "手工制作" },
    { "expect": "[data-recipe=bandage].on" },
    { "expect": "pt=craft-start", "text": "开始制作", "label": "只到配方页，等玩家自己开工" },
    { "expectNoText": ["行动进行中"] },
    { "key": "Escape" },

    { "note": "Q1040-01：生肉只连火堆直烤、锅食谱、晾制等，不作节点 → 不显示「已知工艺」空入口" },
    { "key": "Escape", "until": ".menu-modal", "max": 4, "label": "ESC 直到游戏菜单打开" }, { "click": "text=锅食谱材料（谷物3、盐1、生肉1）" },
    { "use": "dlg" },
    { "click": "pt=shelf-ground >> pt=card-raw_meat", "label": "点选生肉" },
    { "expect": ".rail-page h2", "text": "生肉", "label": "详情已是生肉" },
    { "expect": "[data-fold=craftchain]", "absent": true, "label": "无「已知工艺」入口" },

    { "note": "D28-01：工作台可用时点后续「长效滤芯」进入可读配方（工作台工作区）" },
    { "key": "Escape", "until": ".menu-modal", "max": 4, "label": "ESC 直到游戏菜单打开" }, { "click": "text=B35a1 设施试用组", "label": "开发入口：营地建工作台／锻炉／缝纫台" },
    { "use": "dlg" },
    { "click": "pt=shelf-ground >> pt=card-ceramic_shell" },
    { "click": "[data-pt=chain-node][data-recipe=ex_filter_cartridge] > .chain-row [data-pt=chain-step]" },
    { "expect": "[data-craft-site] .sub-head h2", "text": "工作台", "label": "进工作台工作区" },
    { "expect": "[data-recipe=ex_filter_cartridge].on" },
    { "expectNoText": ["行动进行中"] },
    { "key": "Escape" },

    { "note": "D28-01：限制查看某条工艺后对应节点消失——布料的「净水操作套件」（制造3级显现）在熟练度回1级后消失" },
    { "click": "pt=card-cloth", "label": "点选布料" },
    { "expect": "[data-pt=chain-node][data-recipe=make_filter_token] > .chain-row [data-pt=chain-step]", "textIs": "布料、塑料 → 工作台 → 净水操作套件" },
    { "key": "Escape", "until": ".menu-modal", "max": 4, "label": "ESC 直到游戏菜单打开" }, { "click": "text=熟练度全部回到1级" },
    { "use": "dlg" },
    { "click": "pt=card-cloth" },
    { "expect": "[data-pt=chain-node][data-recipe=bandage]", "label": "其余公开节点仍在" },
    { "expect": "[data-pt=chain-node][data-recipe=make_filter_token]", "absent": true, "label": "净水操作套件节点消失" },

    { "note": "读档后：「已知工艺」展开偏好沿 Q589 按对象类型保留；工序列表照常" },
    { "use": "save-to-title" },
    { "use": "continue" },
    { "click": "pt=shelf-ground >> pt=card-ceramic_shell" },
    { "expect": "[data-fold=craftchain] .rail-fold-head[aria-expanded=true]" },
    { "expect": "[data-pt=chain-list] > [data-pt=chain-node][data-recipe=ex_ceramic_shell] > .chain-row [data-pt=chain-step]", "textIs": "黏土 → 陶窑 → 陶壳" }
  ]
}
