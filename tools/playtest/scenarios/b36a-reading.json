{
  "desc": "B36a 四个阅读页（目录左、内容右）：行动日志按天目录与 HH:mm（Q814 A、Q903 C）；生存提示两目录、删副标（Q822 A、Q903 C）；系统说明左栏主题展开条目、右栏总览／摘要／正文、两个退出控件、Esc 每次一层（Q812 A、Q889 A、Q899 A、Q821 A）；生存目标逐条任务、共用主目标区、阶段两段与当前角标、副标（Q813 B、Q888 A、Q898 B、Q954②③、D4）。页内换目录不压返回链，新开回默认（Q821 A，开发假设 1）。来源：doc/开发记录/B36a 阅读与队伍页.md（B36a.1 范围 1—5）",
  "batch": "B36a",
  "fixture": "new-game",
  "watch": ["pt=read-nav", "pt=log-close", "pt=tips-close", "pt=help-exit", "pt=goals-close"],
  "steps": [
    { "use": "continue" },

    { "note": "行动日志（Q814 A、Q903 C）：新局只有第1日，左栏「第1日」默认选中，右栏每条只写 HH:mm，原副标「最近{n}条 · 最新在上」" },
    { "key": "l" },
    { "expect": "pt=log-split" },
    { "expect": "pt=log-day", "count": 1 },
    { "expect": "[data-pt=log-day][data-day='1']", "textIs": "第1日" },
    { "expect": "[data-pt=log-day][data-day='1'][aria-pressed]", "label": "最新一天默认选中" },
    { "eval": "[...document.querySelectorAll('[data-pt=log-row] .t')].every(t => /^\\d\\d:\\d\\d$/.test(t.textContent.trim())) && document.querySelectorAll('[data-pt=log-row]').length > 0", "label": "Q903 C：每条只写 HH:mm（不写「第N日」）" },
    { "eval": "/^最近\\d+条 · 最新在上$/.test(document.querySelector('.log-panel .sub-head .sub').textContent.trim())", "label": "原副标保留" },
    { "expect": "pt=log-close", "text": "关闭", "label": "顶栏直开写「关闭」（Q821 A）" },
    { "shot": "log-day1", "mask": [".sl-now", ".footer"] },
    { "key": "Escape" },
    { "expect": ".log-panel", "absent": true },

    { "note": "造出第2日的记录：开发入口跳到第2日08:00，再休息0.5小时" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==跳到第2日08:00" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "key": "r" },
    { "click": "[data-pt=rest-pick][data-kind=rest][data-min='30']" },
    { "click": "pt=rest-start" },
    { "waitGone": "[data-prog-lock]", "timeout": 60000 },
    { "key": "Escape", "while": ".rest-panel", "max": 2 },
    { "key": "l" },
    { "eval": "[...document.querySelectorAll('[data-pt=log-day]')].map(b => b.textContent.trim()).join(',')", "equals": "第2日,第1日", "label": "Q814 A：最新的日在上" },
    { "expect": "[data-pt=log-day][data-day='2'][aria-pressed]", "label": "新开默认选最新一天" },
    { "click": "[data-pt=log-day][data-day='1']", "label": "换到第1日" },
    { "expect": "[data-pt=log-day][data-day='1'][aria-pressed]" },
    { "expectText": "你在临时营地醒来", "in": "pt=log-rows", "label": "第1日开局记录在右栏" },
    { "key": "Escape", "label": "换日不算一层：一次 Esc 就关页" },
    { "expect": ".log-panel", "absent": true },
    { "key": "l" },
    { "expect": "[data-pt=log-day][data-day='2'][aria-pressed]", "label": "关页重开回默认（最新一天）" },
    { "click": "pt=log-close" },
    { "expect": ".log-panel", "absent": true },

    { "note": "生存提示（Q822 A、Q903 C）：两目录「当前状况」「当前建议」，默认当前状况；建议全表并高亮当前一条；没有副标" },
    { "key": "t" },
    { "expect": "pt=tips-tab-now", "textIs": "当前状况" },
    { "expect": "pt=tips-tab-list", "textIs": "当前建议" },
    { "expect": "[data-pt=tips-tab-now][aria-pressed]", "label": "新开默认当前状况" },
    { "expect": "pt=tips-now" },
    { "expect": "pt=tips-list", "absent": true, "label": "右栏只显示所选一段" },
    { "expect": ".tips-panel .sub-head .sub", "absent": true, "label": "Q903 C：不另加副标" },
    { "expectNoText": "求生建议，不消耗时间", "in": ".tips-panel", "label": "Q903 C：删去原副标" },
    { "click": "pt=tips-tab-list" },
    { "expect": "pt=tips-list" },
    { "expect": "pt=tips-now", "absent": true },
    { "expect": "[data-pt=tip-row][data-now]", "count": 1, "label": "全表仍高亮当前一条" },
    { "shot": "tips-list" },
    { "key": "Escape", "label": "换目录不算一层" },
    { "expect": ".tips-panel", "absent": true },
    { "key": "t" },
    { "expect": "[data-pt=tips-tab-now][aria-pressed]", "label": "关页重开回默认当前状况" },
    { "click": "pt=tips-close" },

    { "note": "系统说明（Q812 A、Q889 A、Q899 A、Q821 A）：顶栏新开不选主题，右栏列9主题原摘要，只有一个退出控件「关闭」" },
    { "key": "h" },
    { "expect": "pt=read-nav" },
    { "expect": "pt=help-topic", "count": 9, "label": "左栏原9主题" },
    { "expect": "pt=help-summary", "count": 9, "label": "Q889 A：没选主题时右栏列9主题摘要" },
    { "expect": "pt=help-entry", "absent": true },
    { "expect": "pt=help-back", "absent": true, "label": "Q899 A：总览不出内部「‹ 返回」" },
    { "expect": "pt=help-exit", "text": "关闭" },
    { "shot": "help-overview" },
    { "click": "[data-pt=help-topic][data-topic=time]", "label": "选主题「时间、行动与保存」" },
    { "expect": "[data-pt=help-topic][data-topic=time][aria-expanded=true]" },
    { "expect": "pt=help-topic-summary", "text": "时间、行动与保存", "label": "未选条目显示该主题摘要" },
    { "expect": "pt=help-summary", "absent": true, "label": "右栏不再列9主题" },
    { "expect": "[data-pt=help-entry][data-entry=rest]", "textIs": "休息与睡眠", "label": "所选主题在左栏展开原条目" },
    { "expect": "pt=help-back", "absent": true, "label": "Q899 A：主题摘要不出「‹ 返回」" },
    { "click": "[data-pt=help-entry][data-entry=rest]" },
    { "expect": ".help-article h3", "textIs": "休息与睡眠" },
    { "expect": "pt=help-back", "text": "‹ 返回", "label": "条目正文才出内部「‹ 返回」" },
    { "expect": "pt=help-exit", "text": "关闭", "label": "两个退出控件同在" },
    { "shot": "help-entry" },
    { "click": "[data-pt=help-topic][data-topic=items]", "label": "左栏换主题（不压返回链）" },
    { "click": "[data-pt=help-entry][data-entry=spoil]" },
    { "expect": ".help-article h3", "textIs": "保质与腐败" },
    { "key": "Escape", "label": "Esc 第1次：条目 → 所属主题摘要" },
    { "expect": ".help-article", "absent": true },
    { "expect": "pt=help-topic-summary", "text": "物品、容器与负重" },
    { "expect": "[data-pt=help-entry][data-entry=spoil]", "label": "退回主题后左栏条目仍展开" },
    { "key": "Escape", "label": "Esc 第2次：只选了主题 → 关页（左栏换过的主题不多出层）" },
    { "expect": ".help-panel", "absent": true },
    { "key": "h" },
    { "expect": "pt=help-summary", "count": 9, "label": "关页重开回总览" },
    { "click": "[data-pt=help-topic][data-topic=map]" },
    { "click": "[data-pt=help-entry][data-entry=travel]" },
    { "click": "pt=help-back", "label": "点「‹ 返回」只回所属主题" },
    { "expect": "pt=help-topic-summary", "text": "地图、探索与资源" },
    { "expect": ".help-panel" },
    { "click": "[data-pt=help-entry][data-entry=travel]" },
    { "click": "pt=help-exit", "label": "正文里点独立退出直接关页" },
    { "expect": ".help-panel", "absent": true },

    { "note": "生存目标（Q813 B、Q888 A、Q898 B、Q954②③、D4）：左栏逐条任务，默认主目标对应任务，右栏上方共用主目标区、下方快捷按钮" },
    { "key": "j" },
    { "eval": "/^存活第\\d+日 · 序章任务\\d+\\/\\d+ · 建议日程，不是失败倒计时$/.test(document.querySelector('[data-pt=goals-sub]').textContent.trim())", "label": "Q954③ 合同 goals.pageSubtitle「存活第{日}日 · 序章任务{x}/{y} · 建议日程，不是失败倒计时」" },
    { "expect": "[data-pt=goal-item][aria-pressed]", "count": 1, "label": "默认选中一条" },
    { "eval": "document.querySelector('[data-pt=goal-detail]').dataset.goal === document.querySelector('[data-pt=goal-item][aria-pressed]').dataset.goal", "label": "右栏是所选任务" },
    { "expect": "pt=goal-main", "text": "主目标", "label": "Q888 A：共用主目标区" },
    { "eval": "document.querySelector('[data-pt=goal-main] header span').textContent.trim() === document.querySelector('[data-pt=goal-item][aria-pressed] b').textContent.trim()", "label": "Q888 A：默认选主目标原任务（主目标名＝所选任务名）" },
    { "expect": "pt=goal-quick", "label": "下方原快捷按钮" },
    { "expect": "pt=goal-stage", "label": "Q954②：任务名下写所属阶段" },
    { "expect": "pt=goal-stage-now", "textIs": "当前", "label": "当前阶段原「当前」角标" },
    { "expectNoText": ["所属阶段", "当前目标", "已完成"], "in": ".goals-panel", "label": "Q954② 无前缀；Q898 B 不加「当前目标／已完成」文字标签" },
    { "eval": "!document.querySelector('[data-pt=read-nav] .skill-group, [data-pt=read-nav] h3, [data-pt=read-nav] .goal-stage')", "label": "Q898 B：左栏不插阶段标题" },
    { "shot": "goals-default", "mask": [".sl-now"] },
    { "eval": "(document.querySelector('[data-pt=goal-item]:last-of-type').focus(), document.querySelector('.goals-panel').scrollTop === 0)", "label": "键盘聚焦到左栏最后一条：只滚左栏，页头不动" },
    { "click": "[data-pt=goal-item]:last-of-type", "label": "选左栏最后一条（后面阶段的任务）" },
    { "expect": "pt=goals-close", "inView": true, "label": "页头关闭键仍可见" },
    { "eval": "document.querySelector('[data-pt=goal-detail]').dataset.goal === document.querySelector('[data-pt=goal-item]:last-of-type').dataset.goal", "label": "右栏换成所选任务" },
    { "expect": "pt=goal-main", "label": "Q888 A：选哪条都保留主目标区" },
    { "expect": "pt=goal-quick" },
    { "expect": "pt=goal-stage" },
    { "expect": "pt=goal-stage-now", "absent": true, "label": "非当前阶段不带「当前」角标" },
    { "key": "Escape", "label": "换任务不算一层" },
    { "expect": ".goals-panel", "absent": true },
    { "key": "j" },
    { "eval": "document.querySelector('[data-pt=goal-main] header span').textContent.trim() === document.querySelector('[data-pt=goal-item][aria-pressed] b').textContent.trim()", "label": "关页重开回主目标对应任务" },
    { "click": "pt=goals-close" },
    { "expect": ".goals-panel", "absent": true },

    { "note": "盖在制作页上打开（Q821 A 例「从制作覆盖开的日志返回制作」）：退出写「返回」，换目录不加层，退出回制作页" },
    { "key": "c" },
    { "expect": ".panel-host[data-panel=craft]" },
    { "key": "l" },
    { "expect": ".panel-host[data-panel=log]" },
    { "expect": "pt=log-close", "text": "返回", "label": "下层有制作页：写「返回」" },
    { "click": "[data-pt=log-day][data-day='1']" },
    { "key": "Escape", "label": "换日不加层：一次回制作" },
    { "expect": ".panel-host[data-panel=craft]" },
    { "key": "h" },
    { "expect": "pt=help-exit", "text": "返回" },
    { "click": "[data-pt=help-topic][data-topic=camp]" },
    { "click": "[data-pt=help-entry][data-entry=craft]" },
    { "click": "[data-pt=help-topic][data-topic=time]", "label": "换主题（不压层）" },
    { "click": "[data-pt=help-entry][data-entry=work]" },
    { "key": "Escape", "label": "条目 → 主题" },
    { "expect": "pt=help-topic-summary", "text": "时间、行动与保存" },
    { "key": "Escape", "label": "主题 → 回制作页" },
    { "expect": ".panel-host[data-panel=craft]" },
    { "key": "Escape" },
    { "expect": ".panel-host[data-panel]", "absent": true }
  ]
}
