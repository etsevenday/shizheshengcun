{
  "desc": "B36a 回收箱卡「取出…」跳转（Q953 A，合同 boxJump）：父地点回收箱卡「取出…」切到右栏人物页、自动展开本地箱区、滚到并高亮对应箱一次，不取物、不耗时；「返回」照常收起；换地点再回来回默认收起（Q891 A）。造箱：开发入口进教会地下圣所入口缓冲，丢下打火器，回父地点记通关、快进、确认重置，旧实例遗留物迁到教堂墓园的旧实例遗物认领箱。来源：doc/开发记录/B36a 阅读与队伍页.md（B36a.1 范围 9，开发假设 11）",
  "batch": "B36a",
  "fixture": "new-game",
  "steps": [
    { "use": "continue" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==传送到入口缓冲（01）", "label": "开发入口：教会地下圣所入口缓冲（默认所选地牢 d01）" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "click": "pt=shelf-carried >> pt=card-lighter >> .card-arrow", "label": "把打火器放到缓冲地面（成为旧实例遗留物）" },
    { "expect": "pt=shelf-ground >> pt=card-lighter" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==传送到所选地牢父地点" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==所选地牢记为本代通关（写通关时刻）" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==时间快进到所选地牢可重置" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "click": "text=重置地牢…" },
    { "click": "text=确认重置" },
    { "expect": "text==取出…", "label": "父地点出现回收箱卡" },

    { "note": "跳转前：人物页箱区默认收起" },
    { "click": ".panel.detail >> text==人物" },
    { "click": "[aria-label=展开成员]", "optional": true, "timeout": 1500 },
    { "expect": "pt=boxes", "absent": true, "label": "Q891 A 默认收起" },
    { "expect": "pt=boxes-toggle", "textIs": "查看认领箱" },
    { "click": ".panel.detail >> text==对象", "label": "右栏切回对象" },
    { "eval": "(document.documentElement.dataset.ptT = document.querySelector('.sl-now').textContent, true)" },

    { "click": "text==取出…", "label": "回收箱卡「取出…」" },
    { "expect": "pt=boxes-toggle", "textIs": "返回", "label": "Q953 A：视同点了「查看认领箱」，自动展开" },
    { "expect": "pt=boxes-title", "textIs": "认领箱" },
    { "expect": "[data-remains=relic_d01]", "inView": true, "label": "滚到对应箱（旧实例遗物认领箱）" },
    { "expect": "[data-remains=relic_d01].flash-focus", "label": "高亮一次" },
    { "expectText": "打火器", "in": "[data-remains=relic_d01]" },
    { "eval": "document.querySelector('.sl-now').textContent === document.documentElement.dataset.ptT", "label": "只是导航：不耗时" },
    { "expect": "pt=shelf-carried >> pt=card-lighter", "absent": true, "label": "不自动取物" },
    { "shot": "boxjump", "mask": [".sl-now"] },
    { "click": "pt=boxes-toggle", "label": "「返回」" },
    { "expect": "pt=boxes", "absent": true, "label": "返回照常收起" },

    { "note": "换地点回默认收起（Q891 A「换区重验」）" },
    { "click": "pt=boxes-toggle" },
    { "expect": "pt=boxes" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "select": "select[aria-label=传送目标]", "value": "camp" },
    { "click": "text==传送（按实际到达处理）" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==传送到所选地牢父地点" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "click": ".panel.detail >> text==人物" },
    { "click": "[aria-label=展开成员]", "optional": true, "timeout": 1500 },
    { "expect": "pt=boxes-toggle", "textIs": "查看认领箱", "label": "换地点再回来：回默认收起" },
    { "expect": "pt=boxes", "absent": true }
  ]
}
