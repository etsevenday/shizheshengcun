{
  "desc": "B59b 晾制留位冻结保鲜（Q769-01—03、Q1033-02、Q1034 余料继续冻结）：临期野果拖入开晾后保质暂停、取到地面才恢复倒计时并到期转腐败物，位内余料仍暂停；只投临期生肉越过原截止仍是生肉、无缺料反馈，再拖盐开晾进度从0；余料「查看配方」补投开新批。来源：doc/开发记录/B59b 晾制保鲜冻结与到期即转腐败.md（B59b.4 R326）；S14「2026-11-20 Q769、Q770 晾制与腐败界面验收」、「2026-11-24 Q1033–Q1039」Q1033-02",
  "batch": "B59b",
  "fixture": "drying-rack",
  "watch": ["pt=fac-take"],
  "steps": [
    {"use": "continue"},
    {"key": "Escape", "until": "text==保存并返回标题", "max": 6, "label": "ESC 到游戏菜单"},
    {"click": "text=烹饪熟练设为5级", "label": "开发入口：烹饪5级（肉干要5级）"},
    {"key": "Escape", "until": "text==保存并返回标题", "max": 6},
    {"click": "text=腐败测试物资（10分钟后到期）", "label": "开发入口：地面野果早批2份、随身生肉1份，10分钟后到期"},
    {"key": "Escape", "while": "text==保存并返回标题", "max": 3},
    {"click": "pt=shelf-carried >> pt=card-spoiled_matter >> .card-arrow", "label": "随身腐败物放到地面（腾卡位）"},
    {"expect": "pt=shelf-carried >> pt=card-raw_meat", "text": "10分钟后腐败"},
    {"expect": "pt=shelf-ground >> pt=card-berry", "text": "10分钟后腐败"},
    {"click": "#drying-rack"},

    {"note": "11. Q769：临期野果拖到空工位2开晾 → 位内两份「保质暂停，剩余10分钟」（S11 §Q769 拖入即冻结）"},
    {"drag": "pt=shelf-ground >> pt=card-berry", "to": "[data-dry-slot='1'] >> pt=dry-toggle", "label": "地面野果拖到工位2"},
    {"expect": "[data-dry-slot='1']", "text": "晾制中"},
    {"expect": "pt=shelf-ground >> pt=card-berry", "text": "22小时后腐败", "label": "临期早批进了晾制位，地面只剩晚批"},

    {"note": "12. Q1033-02／Q769：只投临期生肉 → 留位冻结，无缺料提示"},
    {"drag": "pt=shelf-carried >> pt=card-raw_meat", "to": "[data-dry-slot='2'] >> pt=dry-toggle", "label": "随身临期生肉拖到工位3"},
    {"expect": "[data-dry-slot='2']", "text": "余料"},
    {"expect": "[data-dry-slot='2'] >> .dry-title", "textIs": "生肉等"},

    {"note": "等 1 小时（越过两样的原截止）"},
    {"key": "Escape", "while": ".drying-panel", "max": 3},
    {"key": "r"},
    {"click": ".rest-panel .choice >> text==1小时", "label": "休息1小时"},
    {"click": ".rest-panel .rg-start"},
    {"waitGone": "text=行动进行中", "timeout": 90000},
    {"key": "Escape", "while": ".rest-panel", "max": 2},
    {"click": "#drying-rack"},

    {"note": "11. 展开工位2 → 两张卡「保质暂停，剩余10分钟」"},
    {"click": "[data-dry-slot='1'] >> pt=dry-toggle", "label": "展开工位2"},
    {"expect": "[data-dry-slot='1'] >> pt=fac-item", "count": 2},
    {"expect": "[data-dry-slot='1'] >> pt=fac-item", "nth": 0, "text": "保质暂停，剩余10分钟"},
    {"expect": "[data-dry-slot='1'] >> pt=fac-item", "nth": 1, "text": "保质暂停，剩余10分钟"},

    {"note": "12. 越过原截止：工位3 仍是生肉，摘要无「缺料」「余料」，面板无缺料句"},
    {"expect": "[data-dry-slot='2'] >> .dry-title", "textIs": "生肉等"},
    {"expectNoText": ["缺料", "余料1", "原料不全"], "in": ".drying-panel .sub-head"},
    {"click": "[data-dry-slot='2'] >> pt=dry-toggle", "label": "展开工位3"},
    {"expect": "[data-dry-slot='2'] >> pt=fac-item", "text": "保质暂停，剩余10分钟"},
    {"expectNoText": ["腐败物", "原料不全", "缺料"], "in": "[data-dry-slot='2']"},
    {"expectNoText": ["原料不全", "缺料"], "in": ".event"},
    {"shot": "q769-frozen", "mask": [".sl-now", ".event"]},

    {"note": "12. 再拖盐 → 开晾，进度从0"},
    {"drag": "pt=shelf-ground >> pt=card-salt", "to": "[data-dry-slot='2'] >> pt=dry-toggle", "label": "盐拖到工位3"},
    {"expect": "[data-dry-slot='2']", "text": "晾制中"},
    {"expectText": "加工进度 0/180分钟", "in": "[data-dry-slot='2']"},

    {"note": "11. 取一张野果到地面 → 地面那份从剩余10分钟恢复倒计时；位里那张仍暂停"},
    {"click": "[data-dry-slot='1'] >> pt=fac-item", "nth": 0, "label": "点工位2第一张野果"},
    {"click": "pt=fac-take-ground"},
    {"click": "pt=fac-take-ok"},
    {"expect": "[data-dry-slot='1'] >> pt=fac-item", "count": 1},
    {"expect": "[data-dry-slot='1'] >> pt=fac-item", "text": "保质暂停，剩余10分钟"},
    {"expect": "pt=shelf-ground >> pt=card-berry", "text": "10分钟后腐败", "label": "地面野果恢复计时：10分钟后腐败（不是取出即腐败）"},
    {"eval": "(document.documentElement.dataset.ptBerry = document.querySelector('[data-pt=shelf-ground] [data-pt=card-berry]').innerText.match(/×([0-9]+)/)[1], document.documentElement.dataset.ptRot = document.querySelector('[data-pt=shelf-ground] [data-pt=card-spoiled_matter]').innerText.match(/×([0-9]+)/)[1], true)"},
    {"shot": "q769-taken", "mask": [".sl-now", ".event"]},

    {"note": "11. 等30分钟：地面取出的那份野果到期转腐败物（地面野果少1份），位内仍保质暂停"},
    {"key": "Escape", "while": ".drying-panel", "max": 3},
    {"key": "r"},
    {"click": ".rest-panel .choice >> text==30分钟", "label": "休息30分钟"},
    {"click": ".rest-panel .rg-start"},
    {"waitGone": "text=行动进行中", "timeout": 90000},
    {"key": "Escape", "while": ".rest-panel", "max": 2},
    {"eval": "+document.querySelector('[data-pt=shelf-ground] [data-pt=card-berry]').innerText.match(/×([0-9]+)/)[1] === +document.documentElement.dataset.ptBerry - 1", "label": "地面野果少了取出的那1份"},
    {"eval": "(()=>{const m=document.querySelector('[data-pt=shelf-ground] [data-pt=card-spoiled_matter]').innerText.match(/×([0-9]+)/);return +m[1]})() === +document.documentElement.dataset.ptRot + 1", "label": "地面腐败物多1份"},
    {"expect": "pt=shelf-ground >> pt=card-berry", "text": "小时后腐败"},
    {"click": "#drying-rack"},
    {"click": "[data-dry-slot='1'] >> pt=dry-toggle", "label": "展开工位2"},
    {"expect": "[data-dry-slot='1'] >> pt=fac-item", "nth": 0, "text": "保质暂停，剩余10分钟", "label": "位里那份仍暂停"},
    {"expectNoText": "腐败物", "in": "[data-dry-slot='1']"},
    {"shot": "q769-after", "mask": [".sl-now", ".event"]},

    {"note": "13. Q924／Q769-02：余料位（工位2 剩1份）「查看配方」补投 → 开新批、进度从0、无缺料提示"},
    {"click": "[data-dry-slot='1'] >> pt=dry-toggle", "label": "收起工位2", "optional": true},
    {"expect": "[data-dry-slot='1']", "text": "余料"},
    {"click": "[data-dry-slot='1'] >> pt=dry-refill"},
    {"click": "[data-dry-recipe] >> text==投料…", "label": "晾制果干 投料…"},
    {"click": ".dry-recipes >> text=确认投料", "label": "确认投料"},
    {"expect": "[data-dry-slot='1']", "text": "晾制中"},
    {"expectNoText": ["缺料", "原料不全"], "in": ".drying-panel"},
    {"click": "[data-dry-slot='1'] >> pt=dry-toggle", "label": "展开工位2", "optional": true},
    {"expectText": "加工进度 0/120分钟", "in": "[data-dry-slot='1']"}
  ]
}
