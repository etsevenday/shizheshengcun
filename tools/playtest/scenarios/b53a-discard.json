{
  "desc": "B53a 右栏永久丢弃：野果两批选数量丢弃、子区开着时空格／回车不穿透到选卡盘（试玩修复1）、1280 入口首屏可见（试玩修复3）、壶水与锅水、存档往返。来源：doc/开发记录/B53a 永久丢弃与晾制待清理.md（B53a.7／B53a.9）",
  "batch": "B53a",
  "fixture": "discard-kit",
  "watch": ["pt=discard", "pt=discard-water", "pt=discard-confirm", "pt=discard-next"],
  "steps": [
    { "use": "continue" },
    { "click": "pt=shelf-ground >> pt=card-berry", "label": "选地面野果" },
    { "expect": "pt=shelf-ground >> pt=card-berry", "text": "×8" },
    { "expect": "pt=discard", "inView": true, "label": "试玩修复3：丢弃入口首屏可见" },
    { "click": "pt=discard" },
    { "expect": "pt=discard-sub", "text": "总数8，可丢弃8" },
    { "shot": "berry-sub" },
    { "click": "pt=discard-qty" },
    { "note": "试玩修复1：数量层与确认层开着时，空格／回车不能落到背后的选卡盘（地面野果仍 ×8）" },
    { "key": "Space" }, { "key": "Enter" },
    { "expect": "pt=shelf-ground >> pt=card-berry", "text": "×8" },
    { "click": "pt=discard-plus" },
    { "click": "pt=discard-next" },
    { "expect": "pt=discard-confirm", "inView": true },
    { "key": "Space" }, { "key": "Enter" },
    { "expect": "pt=shelf-ground >> pt=card-berry", "text": "×8" },
    { "shot": "berry-confirm" },
    { "click": "pt=discard-confirm" },
    { "expectText": "已永久丢弃：野果×2" },
    { "expect": "pt=shelf-ground >> pt=card-berry", "text": "×6" },

    { "key": "Escape", "label": "关掉野果的操作窗" },
    { "note": "随身水壶：丢弃水 → 全部丢弃 → 确认" },
    { "click": "pt=shelf-carried >> pt=card-ration_canteen" },
    { "click": "pt=discard-water", "label": "丢弃水" },
    { "expect": "pt=discard-sub", "text": "750毫升" },
    { "click": "pt=discard-all" },
    { "click": "pt=discard-confirm" },
    { "expectText": "已永久丢弃" },
    { "key": "Escape" },

    { "note": "ESC 逐层退：打开子区、进数量层，Esc 两次回到未展开" },
    { "click": "pt=shelf-ground >> pt=card-berry" },
    { "click": "pt=discard" }, { "click": "pt=discard-qty" },
    { "key": "Escape" }, { "expect": "pt=discard-qty" },
    { "key": "Escape" }, { "expect": "pt=discard-sub", "absent": true },

    { "note": "存档往返：保存回标题再读档，地面野果仍 ×6" },
    { "use": "save-to-title" },
    { "use": "continue" },
    { "expect": "pt=shelf-ground >> pt=card-berry", "text": "×6" }
  ]
}
