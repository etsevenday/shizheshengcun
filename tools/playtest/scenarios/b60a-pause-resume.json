    { "loadSave": "city-square" },
    { "use": "continue" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==随身加重物到超过20公斤（负重倍率）", "label": "开发入口：超重（路程变长）" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==主角健康→0.3" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "key": "m", "optional": true, "until": ".city-layer", "max": 1 },
