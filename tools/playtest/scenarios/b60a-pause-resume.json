    { "eval": "document.activeElement && (document.activeElement.closest('.map-route, .map-wrap, [data-map-root]') ? 'map' : document.activeElement.tagName + '.' + document.activeElement.className)", "noAssert": true, "label": "（记录）退出后焦点所在" },
    { "key": "Escape" },
