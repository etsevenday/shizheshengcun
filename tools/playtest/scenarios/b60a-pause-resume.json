    { "expect": "pt=shelf-ground >> pt=card-stone_knife", "label": "工具没被搬动，仍在地面" },
    { "expect": "pt=shelf-ground >> pt=card-raw_meat", "label": "产物放在临时营地地面" },
    { "expect": "pt=shelf-ground >> pt=card-carcass_feral_dog", "absent": true, "label": "尸体已处理" },
    { "expect": ".sl-now", "text": "08:30", "label": "已推进5分钟＋剩余25分钟＝30分钟，没有重做" },

    { "note": "④ 地图不放行（Q1100 取消 Q569）：开着地图出发，途中健康偏低暂停——地图在遮罩下、「出发」灰、遮罩不为地图开口；退出后地图仍在（Q1103）、出发恢复可用" },
    { "loadSave": "new-game" },
    { "use": "continue" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==主角健康→0.3" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "key": "m" },
    { "click": "#mn-field" },
    { "click": "pt=map-depart", "checks": false },
