    { "key": "Escape", "until": "text==保存并返回标题", "max": 6, "checks": false, "label": "Esc 开游戏菜单（盖在暂停窗上）" },
    { "click": "text==保存并返回标题", "checks": false, "label": "暂停中保存并返回标题" },
