    { "eval": "(c => { const el = document.elementFromPoint(c.left + c.width / 2, c.top + c.height / 2); return !!el && !!el.closest('.pause-scrim, .prog-focus'); })(document.querySelector('[data-pt=shelf-ground] [data-pt=card-stone_knife]').getBoundingClientRect())", "label": "Q1100：指针落在遮罩上，点不到地面石刀" },
