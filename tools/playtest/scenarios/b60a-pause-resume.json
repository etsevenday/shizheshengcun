    { "expect": ".map-route", "label": "地图仍在（在暂停遮罩下）" },
    { "expect": "pt=map-depart", "disabled": true, "label": "Q1100：主行动暂停时地图「出发」是灰的" },
    { "eval": "document.querySelector('.pause-scrim').className", "equals": "pause-scrim", "label": "Q1100：遮罩不挂 Q569 返程让位类" },
    { "eval": "!!document.querySelector('.map-route').closest('[inert]')", "label": "Q1100：地图在遮罩下不可操作" },
    { "eval": "(c => { const el = document.elementFromPoint(c.left + c.width / 2, c.top + c.height / 2); return !!el && !!el.closest('.pause-scrim, .prog-focus'); })(document.querySelector('#mn-camp').getBoundingClientRect())", "label": "Q1100：点地图地点落在遮罩上" },
    { "expectNoText": "返回原地点", "in": "pt=pause-dialog", "label": "暂停窗没有新设前往入口" },
