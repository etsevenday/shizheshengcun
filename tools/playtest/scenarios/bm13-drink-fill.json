{
  "desc": "BM13（02 Q1010 A、Q1011 A）：①主角自饮水分接近上限时日志写实际补水（80→98→97.8，再喝300毫升写+2.2、99.8 再喝100毫升写+0.2），右栏预览仍是理论补水18；②同伴林昭水分85时喂300毫升写「水分+15」；③水壶装水窗标题下来源行：只有地面水时「来源：地面净水 60份」上限20；随身净水5份、地面50份、空壶时「来源：随身净水 5份」上限5且只从随身取；壶只剩2份空间时上限2。来源：doc/开发记录/BM13 次要问题合并.md（BM13.1、BM13.4）；02 Q1010、Q1011 策划答复；合同 b56-q1010-q1011-drink-delta-fill-source.json",
  "batch": "BM13",
  "fixture": "new-game",
  "watch": ["[data-drink]", "[data-canteen-op]", "pt=canteen-fill-source"],
  "steps": [
    { "use": "continue" },

    { "note": "路线1：主角自饮。新局水分80.00；先喝300毫升（80+18=98，未到上限，实际＝名义18）" },
    { "eval": "[...document.querySelectorAll('button')].map(b=>b.textContent.replace(/\\s+/g,'')).find(t=>t.startsWith('水分'))", "equals": "水分80.00/100", "label": "起点水分80.00" },
    { "click": "pt=shelf-ground >> pt=card-clean_water", "label": "选地面净水" },
    { "click": "[data-drink-entry]", "label": "饮用" },
    { "click": "[data-drink] [aria-label=增加]" },
    { "click": "[data-drink] [aria-label=增加]" },
    { "expect": "[data-drink-ml]", "textIs": "300毫升" },
    { "click": "[data-drink] .tbar-go", "label": "饮用300毫升" },
    { "expect": ".event", "text": "饮用净水300毫升：水分+18。", "timeout": 15000, "label": "80→98 未截断，写+18" },
    { "waitGone": "text=行动进行中", "timeout": 60000 },

    { "note": "水分98，5分钟后97.80（游戏内预测行同口径）；再喝300毫升：名义18，实际只到100 → 写+2.2（Q1010 A：补水前后实际差，按上限截断）" },
    { "eval": "[...document.querySelectorAll('button')].map(b=>b.textContent.replace(/\\s+/g,'')).find(t=>t.startsWith('水分'))", "equals": "水分97.80/100", "label": "喝前水分97.80" },
    { "click": "pt=shelf-ground >> pt=card-clean_water" },
    { "click": "[data-drink-entry]" },
    { "click": "[data-drink] [aria-label=增加]" },
    { "click": "[data-drink] [aria-label=增加]" },
    { "expect": "[data-drink-ml]", "textIs": "300毫升" },
    { "expect": "[data-drink-lines]", "text": "补水：18", "label": "右栏预览仍写理论补水18（Q1010 只改结果）" },
    { "click": "[data-drink] .tbar-go", "label": "饮用300毫升（近上限）" },
    { "expect": ".event", "text": "饮用净水300毫升：水分+2.2。", "timeout": 15000, "label": "Q1010 A：97.8 补18截到100，写实际+2.2" },
    { "expectNoText": "水分+18。", "in": ".event", "label": "不再写名义+18" },
    { "waitGone": "text=行动进行中", "timeout": 60000 },
    { "eval": "[...document.querySelectorAll('button')].map(b=>b.textContent.replace(/\\s+/g,'')).find(t=>t.startsWith('水分'))", "equals": "水分99.80/100", "label": "喝后到100、5分钟后99.80" },
    { "shot": "drink-cap-log", "mask": ["[data-detail-rail]"], "label": "日志栏：饮用净水300毫升：水分+2.2。" },

    { "note": "99.80 再喝100毫升：名义6，实际只补0.2" },
    { "click": "pt=shelf-ground >> pt=card-clean_water" },
    { "click": "[data-drink-entry]" },
    { "expect": "[data-drink-ml]", "textIs": "100毫升" },
    { "click": "[data-drink] .tbar-go", "label": "饮用100毫升（99.8）" },
    { "expect": ".event", "text": "饮用净水100毫升：水分+0.2。", "timeout": 15000, "label": "Q1010 A：99.8 补6截到100，写+0.2" },
    { "waitGone": "text=行动进行中", "timeout": 60000 },

    { "note": "路线2：同伴饮水。B29 食饮试玩组编入林昭、周砚；主角拾取5份净水到随身；林昭水分设85后喂300毫升 → 实际+15（名义18截到100）" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text=B29 食饮试玩组", "label": "开发入口：B29 食饮试玩组" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
