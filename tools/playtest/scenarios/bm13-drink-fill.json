    { "expect": "pt=canteen-op-confirm", "disabled": true },
    { "click": "[data-canteen-op] input" },
    { "key": "ctrl+a" },
    { "type": "10" },
    { "expect": "pt=canteen-op-confirm", "textIs": "确认10" },
    { "shot": "fill-ground", "mask": ["[data-detail-rail]"], "label": "装水窗：来源：地面净水 60份" },
    { "click": "pt=canteen-op-confirm", "label": "确认装10份" },
    { "expect": ".event", "text": "把地面净水1000毫升装进分量水壶（净水 1000/2000毫升）。" },
    { "expect": "pt=shelf-ground >> pt=card-clean_water", "text": "×50" },

    { "note": "壶 A 倒5份到随身：随身净水5份、地面仍50份、壶 A 余5份" },
    { "click": "[data-pt=canteen-pour][data-zone=carried]", "label": "倒出到随身" },
    { "click": "[data-canteen-op] input" },
    { "key": "ctrl+a" },
    { "type": "5" },
    { "click": "pt=canteen-op-confirm", "label": "确认倒5份" },
    { "expect": ".event", "text": "从分量水壶倒出净水500毫升到随身（剩净水 500/2000毫升）。" },
    { "expect": "pt=shelf-carried >> pt=card-clean_water", "text": "×5" },
    { "expect": "pt=shelf-ground >> pt=card-clean_water", "text": "×50" },
    { "key": "Escape", "while": "[data-canteen]", "max": 3, "label": "收起壶 A 操作窗" },

    { "note": "③ 随身净水5份、地面净水50份、空壶 B：随身优先 → 「来源：随身净水 5份」，上限 min(5,20)=5；确认后只扣随身、地面仍50" },
    { "click": "pt=shelf-ground >> pt=card-ration_canteen", "nth": 1, "label": "选地面空分量水壶 B" },
    { "expect": "[data-canteen]", "text": "空 0/2000毫升" },
    { "click": "[data-pt=canteen-fill][data-water=clean_water]", "label": "装入净水" },
    { "expect": "pt=canteen-fill-source", "textIs": "来源：随身净水 5份", "label": "Q1011 A：随身优先，来源写随身、该堆5份" },
    { "expect": "pt=canteen-fill-source", "inView": true },
    { "click": "[data-canteen-op] input" },
    { "key": "ctrl+a" },
    { "type": "6" },
    { "expect": "[data-canteen-op=fill]", "text": "请输入 1 到 5 之间的整数。", "label": "上限5（随身这堆），不是地面50" },
    { "expect": "pt=canteen-op-confirm", "disabled": true },
    { "click": "[data-canteen-op] input" },
    { "key": "ctrl+a" },
    { "type": "5" },
    { "expect": "pt=canteen-op-confirm", "textIs": "确认5" },
    { "expect": "[data-canteen-op] [aria-label=增加]", "disabled": false },
    { "shot": "fill-carried", "mask": ["[data-detail-rail]"], "label": "装水窗：来源：随身净水 5份" },
    { "click": "pt=canteen-op-confirm", "label": "确认装5份" },
    { "expect": ".event", "text": "把随身净水500毫升装进分量水壶（净水 500/2000毫升）。" },
    { "expect": "pt=shelf-carried >> pt=card-clean_water", "absent": true, "label": "随身那堆装完" },
    { "expect": "pt=shelf-ground >> pt=card-clean_water", "text": "×50", "label": "地面一份没动" },
    { "key": "Escape", "while": "[data-canteen]", "max": 3 },

    { "note": "壶只剩2份空间：壶 B 从地面再装13份到1800；再拾取5份净水到随身 → 「来源：随身净水 5份」，上限 min(5,2)=2" },
    { "click": "pt=shelf-ground >> pt=card-ration_canteen", "nth": 1, "label": "再选壶 B" },
    { "expect": "[data-canteen]", "text": "净水 500/2000毫升" },
    { "click": "[data-pt=canteen-fill][data-water=clean_water]" },
    { "expect": "pt=canteen-fill-source", "textIs": "来源：地面净水 50份", "label": "随身已无水，回到地面那堆" },
    { "click": "[data-canteen-op] input" },
    { "key": "ctrl+a" },
    { "type": "13" },
    { "click": "pt=canteen-op-confirm", "label": "确认装13份" },
    { "expect": ".event", "text": "把地面净水1300毫升装进分量水壶（净水 1800/2000毫升）。" },
    { "key": "Escape", "while": "[data-canteen]", "max": 3 },
    { "click": "pt=shelf-ground >> pt=card-clean_water", "label": "选地面净水（37份）" },
    { "click": "[aria-label=转移数量]" },
    { "key": "ctrl+a" },
    { "type": "5" },
    { "click": "text=拾取5份到随身", "label": "拾取5份到随身" },
    { "key": "Escape", "while": "[aria-label=转移数量]", "max": 3 },
    { "expect": "pt=shelf-carried >> pt=card-clean_water", "text": "×5" },
    { "click": "pt=shelf-ground >> pt=card-ration_canteen", "nth": 1, "label": "再选壶 B（1800/2000）" },
    { "expect": "[data-canteen]", "text": "净水 1800/2000毫升" },
    { "click": "[data-pt=canteen-fill][data-water=clean_water]" },
    { "expect": "pt=canteen-fill-source", "textIs": "来源：随身净水 5份", "label": "来源仍显示这堆5份" },
    { "click": "[data-canteen-op] input" },
    { "key": "ctrl+a" },
    { "type": "3" },
    { "expect": "[data-canteen-op=fill]", "text": "请输入 1 到 2 之间的整数。", "label": "Q1011 A：壶只剩2份空间时上限仍是2" },
    { "click": "[data-canteen-op] input" },
    { "key": "ctrl+a" },
    { "type": "2" },
    { "click": "pt=canteen-op-confirm", "label": "确认装2份" },
