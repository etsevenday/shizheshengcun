    { "expect": "pt=canteen-fill-source", "textIs": "来源：地面净水 60份", "label": "Q1011 A：来源行写地面、该堆60份" },
    { "expect": "pt=canteen-fill-source", "inView": true },
    { "click": "[data-canteen-op] input" },
    { "key": "ctrl+a" },
    { "type": "21" },
