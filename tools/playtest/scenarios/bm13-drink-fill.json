    { "expect": "pt=shelf-carried >> pt=card-clean_water", "text": "×5" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text==饱食水分精神→85", "nth": 0, "label": "开发入口：林昭饱食水分精神→85" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "click": "pt=shelf-carried >> pt=card-clean_water", "label": "选随身净水" },
    { "click": "[data-feed-entry]", "label": "给同行者饮用" },
    { "select": "select[aria-label=选择同行者]", "value": "林昭" },
    { "expect": "[data-feed-source]", "text": "你的随身物品" },
    { "expect": "[data-feed-stat]", "text": "水分85.00→", "label": "林昭喂前水分85.00" },
    { "click": "[data-feed-units] [aria-label=增加]" },
    { "click": "[data-feed-units] [aria-label=增加]" },
    { "expect": "[data-feed-ml]", "textIs": "300毫升" },
    { "click": "[data-feed-confirm]", "label": "给林昭饮用300毫升" },
    { "expect": ".event", "text": "林昭饮用了净水300毫升（取自你的随身物品）：水分+15。", "timeout": 15000, "label": "Q1010 A：同伴85补18截到100，写+15" },
    { "waitGone": "text=行动进行中", "timeout": 60000 },
    { "shot": "feed-cap-log", "mask": ["[data-detail-rail]"], "label": "日志栏：林昭饮用了净水300毫升…水分+15。" },
    { "click": "pt=shelf-carried >> pt=card-clean_water", "label": "选随身净水（余2份）" },
    { "click": "[data-feed-entry]" },
    { "select": "select[aria-label=选择同行者]", "value": "林昭" },
    { "expect": "[data-feed-stat]", "text": "水分99.80→", "label": "林昭到100后5分钟为99.80" },
    { "click": "[data-feed-confirm]", "label": "再给林昭饮用100毫升" },
    { "expect": ".event", "text": "林昭饮用了净水100毫升（取自你的随身物品）：水分+0.2。", "timeout": 15000, "label": "Q1010 A：同伴99.8补6截到100，写+0.2" },
    { "waitGone": "text=行动进行中", "timeout": 60000 },

    { "note": "路线3：装水窗来源行。重读新局存档，开发入口 B16 材料包×5：地面净水10+50＝60份、5个空分量水壶；随身无净水" },
    { "loadSave": "new-game" },
    { "use": "continue" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text=B16 材料包", "label": "开发入口：B16 材料包（1）" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text=B16 材料包", "label": "开发入口：B16 材料包（2）" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text=B16 材料包", "label": "开发入口：B16 材料包（3）" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text=B16 材料包", "label": "开发入口：B16 材料包（4）" },
    { "key": "Escape", "until": "text==保存并返回标题", "max": 6 },
    { "click": "text=B16 材料包", "label": "开发入口：B16 材料包（5）" },
    { "key": "Escape", "while": "text==保存并返回标题", "max": 3 },
    { "expect": "pt=shelf-ground >> pt=card-clean_water", "text": "×60" },
    { "expect": "pt=shelf-carried >> pt=card-clean_water", "absent": true },

    { "note": "④ 只有地面水：来源写「地面」、份数60；空壶空余20份 → 上限 min(60,20)=20" },
    { "click": "pt=shelf-ground >> pt=card-ration_canteen", "nth": 0, "label": "选地面分量水壶 A" },
    { "expect": "[data-canteen]", "text": "空 0/2000毫升" },
    { "click": "[data-pt=canteen-fill][data-water=clean_water]", "label": "装入净水" },
