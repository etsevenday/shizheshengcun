{
  "desc": "B59a 晾制架拖入即投料（Q1033-01／02）、静默拒绝（Q1029-01）、栏位收起标题与逐份卡（Q1034-01／02、Q1035-01）、取出收敛（Q1029-02）。来源：doc/开发记录/B59a 晾制架拖入即投料与槽位静默.md（B59a.4、B59a.5）；S14「2026-11-24 Q1033–Q1039 晾制与烹饪交互验收」",
  "batch": "B59a",
  "fixture": "drying-rack",
  "watch": ["pt=fac-take"],
  "steps": [
    {"use": "continue"},
    {"key": "Escape", "until": "text==保存并返回标题", "max": 6, "label": "ESC 到游戏菜单"},
    {"click": "text=烹饪熟练设为5级", "label": "开发入口：烹饪5级（肉干要5级）"},
    {"key": "Escape", "while": "text==保存并返回标题", "max": 3},

    {"note": "准备：地面野果点箭头 3 次 → 随身野果×3"},
    {"click": "pt=shelf-carried >> pt=card-spoiled_matter >> .card-arrow", "label": "随身腐败物放到地面（腾卡位）"},
    {"click": "pt=shelf-ground >> pt=card-berry >> .card-arrow"},
    {"click": "pt=shelf-ground >> pt=card-berry >> .card-arrow"},
    {"click": "pt=shelf-ground >> pt=card-berry >> .card-arrow"},
    {"expect": "pt=shelf-carried >> pt=card-berry", "text": "×3"},
    {"click": "#drying-rack"},
    {"expect": "[data-dry-slot='1']", "text": "空闲"},

    {"note": "1. Q1033-01：随身野果×3 拖到空工位2 → 投入2份并开始晾制，随身剩1；无提示、无日志"},
    {"eval": "(document.documentElement.dataset.ptEv = document.querySelector('.event').textContent.trim(), true)"},
    {"drag": "pt=shelf-carried >> pt=card-berry", "to": "[data-dry-slot='1'] >> pt=dry-toggle", "label": "拖到工位2", "holdEval": "!!document.querySelector('.drag-ghost.ok') && !document.querySelector('.drag-ghost.no')", "holdEquals": true},
    {"expect": "[data-dry-slot='1']", "text": "晾制中"},
    {"expect": "pt=shelf-carried >> pt=card-berry", "text": "×1", "label": "随身剩1（×1 时卡上不写数量则改看无 ×2）", "optional": true},
    {"expect": "pt=shelf-carried >> pt=card-berry", "label": "随身仍有野果"},
    {"expectNoText": ["×2", "×3"], "in": "pt=shelf-carried >> pt=card-berry", "label": "随身野果只剩1份"},
    {"expect": ".drying-panel .notice", "absent": true, "label": "无提示"},
    {"eval": "document.querySelector('.event').textContent.trim() === document.documentElement.dataset.ptEv", "label": "无新日志"},
    {"shot": "q1033-drop2", "mask": [".sl-now"]},

    {"note": "5. Q1034-01：占用栏收起标题「野果等」；展开后两张「野果」卡、配方、进度"},
    {"expect": "[data-dry-slot='1'] >> .dry-title", "textIs": "野果等"},
    {"click": "[data-dry-slot='1'] >> pt=dry-toggle", "label": "展开工位2"},
    {"expect": "[data-dry-slot='1'] >> .dry-title", "textIs": "工位2"},
    {"expect": "[data-dry-slot='1'] >> pt=fac-item", "count": 2},
    {"expect": "[data-dry-slot='1'] >> pt=fac-item", "nth": 1, "text": "野果"},
    {"expectText": ["配方 晾制果干", "加工进度 0/120分钟"], "in": "[data-dry-slot='1']"},

    {"note": "7. Q1035-01：点第二张野果卡 → 数量窗「最多 2」，只有这张高亮"},
    {"click": "[data-dry-slot='1'] >> pt=fac-item", "nth": 1, "label": "点第二张野果卡"},
    {"expect": "pt=fac-take", "text": "最多 2"},
    {"expect": "[data-dry-slot='1'] >> .fi-card.selected", "count": 1},
    {"eval": "document.querySelectorAll('[data-dry-slot=\"1\"] [data-pt=fac-item]')[1].classList.contains('selected')", "label": "高亮的是第二张"},
    {"shot": "q1035-take-box", "mask": [".sl-now"]},
    {"click": "pt=fac-take-cancel"},

    {"note": "8. Q1029-02：晾制位无取出／收取／清空按钮、无停止位说明"},
    {"expectNoText": ["收取", "清空", "取到随身", "取到地面"], "in": ".dry-grid"},
    {"eval": "[...document.querySelectorAll('.dry-grid button')].every(b => !/^(取出|收取|清空)/.test(b.textContent.trim()))", "label": "工位里没有取出／收取／清空按钮"},

    {"note": "2. Q1033-01：Shift 松手 → 数量框「投料 · 野果」默认2；改1后这一位留余料"},
    {"click": "pt=shelf-ground >> pt=card-berry >> .card-arrow"},
    {"click": "pt=shelf-ground >> pt=card-berry >> .card-arrow"},
    {"expect": "pt=shelf-carried >> pt=card-berry", "text": "×3"},
    {"drag": "pt=shelf-carried >> pt=card-berry", "to": "[data-dry-slot='2'] >> pt=dry-toggle", "shift": true, "label": "Shift 松手到工位3"},
    {"expect": "[aria-label=选择数量]", "text": "投料 · 野果"},
    {"expect": "[aria-label=选择数量] input", "label": "数量框有输入框"},
    {"eval": "document.querySelector('[aria-label=选择数量] input').value", "equals": "2", "label": "默认2"},
    {"shot": "q1033-shift-box", "mask": [".sl-now"]},
    {"click": "[aria-label=选择数量] [aria-label=减少]"},
    {"eval": "document.querySelector('[aria-label=选择数量] input').value", "equals": "1"},
    {"key": "Enter"},
    {"waitGone": "[aria-label=选择数量]"},
    {"expect": "[data-dry-slot='2']", "text": "余料"},
    {"expect": "pt=shelf-carried >> pt=card-berry", "text": "×2"},

    {"note": "6. Q1034-02：余料位有「查看配方」；架副标题无「余料n」"},
    {"expect": "[data-dry-slot='2'] >> pt=dry-refill", "textIs": "查看配方"},
    {"expectNoText": "余料1", "in": ".drying-panel .sub-head"},
    {"expectNoText": "缺料", "in": ".drying-panel .sub-head"},

    {"note": "4. Q1029-01：拖到在制位（工位1、工位2）→ 不高亮、无禁止标；松手什么都不发生、不落地面"},
    {"eval": "(document.documentElement.dataset.ptEv = document.querySelector('.event').textContent.trim(), document.documentElement.dataset.ptGb = (document.querySelector('[data-pt=shelf-ground] [data-pt=card-berry]')||{}).textContent, true)"},
    {"drag": "pt=shelf-carried >> pt=card-berry", "to": "[data-dry-slot='0'] >> pt=dry-toggle", "label": "拖到在制工位1", "holdEval": "!document.querySelector('[data-dry-slot=\"0\"]').matches('.drop-can,.drop-can-preview,.drop-hover,.drop-hover-no') && !document.querySelector('.drag-ghost.no')", "holdEquals": true},
    {"expect": "pt=shelf-carried >> pt=card-berry", "text": "×2"},
    {"eval": "(document.querySelector('[data-pt=shelf-ground] [data-pt=card-berry]')||{}).textContent === document.documentElement.dataset.ptGb", "label": "地面野果没变（没落地面）"},
    {"expect": ".drop-flash", "absent": true},
    {"expect": ".drying-panel .notice", "absent": true},
    {"eval": "document.querySelector('.event').textContent.trim() === document.documentElement.dataset.ptEv", "label": "无日志"},
    {"drag": "pt=shelf-carried >> pt=card-berry", "to": "[data-dry-slot='1'] >> pt=dry-toggle", "label": "拖到在制工位2（展开着）", "holdEval": "!document.querySelector('[data-dry-slot=\"1\"]').matches('.drop-can,.drop-can-preview,.drop-hover,.drop-hover-no') && !document.querySelector('.drag-ghost.no')", "holdEquals": true},
    {"expect": "pt=shelf-carried >> pt=card-berry", "text": "×2"},
    {"expect": "[data-dry-slot='1'] >> pt=fac-item", "count": 2},

    {"note": "13. Q769-02（B59b）：余料位拖入补投 → 开新批、进度从0、无缺料提示"},
    {"drag": "pt=shelf-carried >> pt=card-berry", "to": "[data-dry-slot='2'] >> pt=dry-toggle", "label": "补投到余料工位3"},
    {"expect": "[data-dry-slot='2']", "text": "晾制中"},
    {"expectNoText": "×2", "in": "pt=shelf-carried >> pt=card-berry"},
    {"click": "[data-dry-slot='2'] >> pt=dry-toggle"},
    {"expectText": "加工进度 0/120分钟", "in": "[data-dry-slot='2']"},
    {"expectNoText": ["缺料", "原料不全"], "in": ".drying-panel"},

    {"note": "3. Q1033-02：只拖生肉 → 位里留生肉、盐不被自动扣；再拖盐即开晾"},
    {"eval": "(document.documentElement.dataset.ptSalt = document.querySelector('[data-pt=shelf-ground] [data-pt=card-salt]').textContent, true)"},
    {"drag": "pt=shelf-ground >> pt=card-raw_meat", "to": "[data-dry-slot='3'] >> pt=dry-toggle", "label": "生肉拖到工位4"},
    {"expect": "[data-dry-slot='3']", "text": "余料"},
    {"expect": "[data-dry-slot='3'] >> .dry-title", "textIs": "生肉等"},
    {"expect": "pt=shelf-ground >> pt=card-raw_meat", "text": "×3"},
    {"eval": "document.querySelector('[data-pt=shelf-ground] [data-pt=card-salt]').textContent === document.documentElement.dataset.ptSalt", "label": "盐没被扣"},
    {"expectNoText": ["缺料", "原料不全"], "in": ".drying-panel"},
    {"shot": "q1033-meat-only", "mask": [".sl-now"]},
    {"drag": "pt=shelf-ground >> pt=card-salt", "to": "[data-dry-slot='3'] >> pt=dry-toggle", "label": "盐拖到工位4"},
    {"expect": "[data-dry-slot='3']", "text": "晾制中"},
    {"expect": "pt=shelf-ground >> pt=card-salt", "text": "×3"},

    {"note": "5. 取走首件后收起标题重算：工位4 展开取走生肉（箭头）→ 收起标题「盐等」；8. 取出不写日志"},
    {"click": "[data-dry-slot='3'] >> pt=dry-toggle", "label": "展开工位4"},
    {"eval": "(document.documentElement.dataset.ptEv = document.querySelector('.event').textContent.trim(), true)"},
    {"click": "[data-dry-slot='3'] >> pt=fac-item >> .card-arrow", "label": "生肉卡箭头取到随身"},
    {"expect": "pt=shelf-carried >> pt=card-raw_meat"},
    {"eval": "document.querySelector('.event').textContent.trim() === document.documentElement.dataset.ptEv", "label": "取出不写日志"},
    {"expect": "[data-dry-slot='3']", "text": "余料"},
    {"click": "[data-dry-slot='3'] >> pt=dry-toggle", "label": "收起工位4"},
    {"expect": "[data-dry-slot='3'] >> .dry-title", "textIs": "盐等"},

    {"note": "8. 空停止位／余料位最后一件取走 → 自动变回空位"},
    {"click": "[data-dry-slot='3'] >> pt=dry-toggle"},
    {"click": "[data-dry-slot='3'] >> pt=fac-item >> .card-arrow", "label": "盐卡箭头取走"},
    {"expect": "[data-dry-slot='3']", "text": "空闲"},
    {"expect": "[data-dry-slot='3'] >> pt=dry-view"},

    {"note": "8. 拖出：工位3 野果卡拖到当前地面（不写日志）"},
    {"eval": "(document.documentElement.dataset.ptEv = document.querySelector('.event').textContent.trim(), true)"},
    {"drag": "[data-dry-slot='2'] >> pt=fac-item", "to": "pt=shelf-ground", "label": "位内野果卡拖到地面"},
    {"expect": "[data-dry-slot='2'] >> pt=fac-item", "count": 1},
    {"eval": "document.querySelector('.event').textContent.trim() === document.documentElement.dataset.ptEv", "label": "拖出不写日志"},

    {"note": "8. 「全部取出」不写日志，取后各占用位回空位"},
    {"click": "pt=dry-take-all"},
    {"eval": "document.querySelector('.event').textContent.trim() === document.documentElement.dataset.ptEv", "label": "全部取出不写日志"},
    {"expect": "[data-dry-slot] >> pt=fac-item", "absent": true},
    {"expect": "pt=dry-view", "count": 8},
    {"shot": "after-take-all", "mask": [".sl-now"]},

    {"note": "探索补充（Q1029-01 不接受该物也静默；拖影短句；键盘展开）：全部取出后各位都空"},
    {"drag": "pt=shelf-carried >> pt=card-berry", "to": "[data-dry-slot='4'] >> pt=dry-toggle", "label": "拖到空工位5、悬停看拖影短句（暂用「投入{物名}×{n}」）", "holdEval": "(document.querySelector('.drag-ghost')||{}).textContent"},
    {"expect": "[data-dry-slot='4']", "text": "余料", "label": "随身只剩1份野果：投入1份成余料"},
    {"drag": "pt=shelf-ground >> pt=card-raw_meat", "to": "[data-dry-slot='5'] >> pt=dry-toggle", "label": "生肉拖到空工位6"},
    {"expect": "[data-dry-slot='5'] >> .dry-title", "textIs": "生肉等"},
    {"eval": "(document.documentElement.dataset.ptB = (document.querySelector('[data-pt=shelf-ground] [data-pt=card-berry]')||{}).innerText, true)"},
    {"drag": "pt=shelf-ground >> pt=card-berry", "to": "[data-dry-slot='5'] >> pt=dry-toggle", "label": "野果拖到生肉余料位（配方不含野果）", "holdEval": "!document.querySelector('[data-dry-slot=\"5\"]').matches('.drop-can,.drop-can-preview,.drop-hover,.drop-hover-no') && !document.querySelector('.drag-ghost.no')", "holdEquals": true},
    {"expect": "[data-dry-slot='5'] >> .dry-title", "textIs": "生肉等"},
    {"eval": "(document.querySelector('[data-pt=shelf-ground] [data-pt=card-berry]')||{}).innerText === document.documentElement.dataset.ptB", "label": "地面野果没变"},
    {"expect": ".drop-flash", "absent": true},
    {"drag": "pt=shelf-ground >> pt=card-spoiled_matter", "to": "[data-dry-slot='6'] >> pt=dry-toggle", "label": "腐败物拖到空工位7", "holdEval": "!document.querySelector('[data-dry-slot=\"6\"]').matches('.drop-can,.drop-can-preview,.drop-hover,.drop-hover-no') && !document.querySelector('.drag-ghost.no')", "holdEquals": true},
    {"expect": "[data-dry-slot='6']", "text": "空闲"},
    {"expect": ".drop-flash", "absent": true},
    {"click": "[data-dry-slot='5'] >> pt=dry-toggle", "label": "点一下展开"},
    {"expect": "[data-dry-slot='5'] >> pt=dry-toggle", "label": "aria-expanded"},
    {"eval": "document.querySelector('[data-dry-slot=\"5\"] [data-pt=dry-toggle]').getAttribute('aria-expanded')", "equals": "true"},
    {"eval": "(document.querySelector('[data-dry-slot=\"5\"] [data-pt=dry-toggle]').focus(), true)", "label": "键盘焦点放到工位6标题（点击展开后焦点回到 body，见报告）"},
    {"key": "Enter", "label": "焦点在标题上按 Enter 收起"},
    {"eval": "document.querySelector('[data-dry-slot=\"5\"] [data-pt=dry-toggle]').getAttribute('aria-expanded')", "equals": "false"},
    {"key": "Space", "label": "空格再展开"},
    {"eval": "document.querySelector('[data-dry-slot=\"5\"] [data-pt=dry-toggle]').getAttribute('aria-expanded')", "equals": "true"},

    {"note": "M1138 贴边自动滚动复核：① 从当前地面慢拖（约1秒，经过面板下沿）进上排工位2，面板不应被自动滚动；③ 在面板内停留0.4秒后拖到下沿，照常自动滚动"},
    {"click": "[data-dry-slot='4'] >> pt=dry-toggle", "label": "再展开工位5让面板更长"},
    {"eval": "(document.querySelector('.drying-panel .sh-body').scrollTop = 0, true)"},
    {"eval": "document.querySelector('.drying-panel .sh-body').scrollHeight > document.querySelector('.drying-panel .sh-body').clientHeight", "label": "面板可滚（复核才有意义）"},
    {"drag": "pt=shelf-ground >> pt=card-berry", "to": "[data-dry-slot='1'] >> pt=dry-toggle", "steps": 40, "stepMs": 25, "label": "① 地面野果慢拖到工位2", "holdEval": "document.querySelector('.drying-panel .sh-body').scrollTop", "holdEquals": 0},
    {"expect": "[data-dry-slot='1']", "text": "晾制中"},
    {"eval": "(document.querySelector('.drying-panel .sh-body').scrollTop = 0, true)"},
    {"drag": "[data-dry-slot='5'] >> pt=fac-item", "to": ".drying-panel .sh-body", "toAt": [0.5,0.97], "dwell": 400, "steps": 8, "stepMs": 25, "hold": 700, "noRelocate": true, "label": "③ 位内生肉卡先在面板内停0.4秒再拖到下沿", "holdEval": "document.querySelector('.drying-panel .sh-body').scrollTop > 0", "holdEquals": true}
  ]
}
