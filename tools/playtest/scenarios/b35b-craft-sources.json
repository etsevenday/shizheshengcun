{
  "desc": "B35b 材料来源侧页：两组与默认选中（Q599 B、Q911 A）、在地图上定位→地图“返回材料来源”→侧页保留所选→返回配方（Q592 A）、左列改选一次退出且不保留旧选择（Q949 A）、普通地图不受影响。来源：doc/开发记录/B35b 制作页三列与来源侧页.md（B35b.4 Q592／Q599／Q911／Q949）",
  "batch": "B35b",
  "fixture": "new-game",
  "watch": ["pt=src-back", "pt=src-locate", "pt=map-close"],
  "steps": [
    { "use": "continue" },
    { "key": "Escape" }, { "click": "text=传送到农野荒地（普通野外）", "label": "开发入口：传送到农野荒地（有荒地纤维丛）" },
    { "use": "dlg" },
    { "key": "c" },
    { "click": "[data-recipe=make_wooden_bow]", "label": "木弓：木材、植物纤维都缺" },
    { "click": "[data-source-item=fiber]", "label": "植物纤维“查看来源”" },

    { "note": "Q599 B：“可获取”“其他已知来源”两组、可获取在前；Q911 A：默认选首个可获取且有已知地点的行" },
    { "expect": "pt=craft-sources", "text": "材料来源" },
    { "expect": "pt=src-group-usable", "textIs": "可获取" },
    { "expect": "pt=src-group-other", "textIs": "其他已知来源" },
    { "eval": "!!(document.querySelector('[data-pt=src-group-usable]').compareDocumentPosition(document.querySelector('[data-pt=src-group-other]')) & Node.DOCUMENT_POSITION_FOLLOWING)", "label": "可获取组在前" },
    { "expect": "[data-pt=src-row][aria-pressed=true]", "count": 1 },
    { "expect": "[data-pt=src-row][aria-pressed=true]", "text": "荒地纤维丛", "label": "默认选中农野荒地·荒地纤维丛" },
    { "expect": "pt=src-detail-title", "text": "荒地纤维丛" },
    { "expect": "pt=src-locate", "textIs": "在地图上定位", "disabled": false, "inView": true },
    { "expect": "pt=src-back", "text": "返回配方", "inView": true },
    { "expect": "pt=craft-run", "absent": true },
    { "shot": "src-default" },

    { "note": "Q592 A：在地图上定位 → 地图只高亮该地点、不列来源、不设目的地；关闭键“返回材料来源”" },
    { "click": "pt=src-locate" },
    { "expect": ".map-route", "label": "地图打开" },
    { "expect": "pt=map-close", "text": "返回材料来源" },
    { "expect": ".source-spot", "count": 1 },
    { "expect": "#mn-field.source-spot", "label": "高亮农野荒地" },
    { "expect": "pt=map-depart", "absent": true, "label": "只定位、不设移动目的地" },
    { "expectNoText": ["的已知来源", "返回制作"], "label": "地图上不再浮来源列表" },
    { "shot": "map-locate" },
    { "key": "Escape", "label": "ESC：地图 → 来源侧页" },
    { "expect": ".map-route", "absent": true },
    { "expect": "pt=craft-sources", "label": "回到来源侧页（不是配方）" },
    { "expect": "[data-pt=src-row][aria-pressed=true]", "text": "荒地纤维丛", "label": "保留所选来源" },
    { "expect": "pt=src-detail-title", "text": "荒地纤维丛" },
    { "click": "pt=src-locate", "label": "再定位一次" },
    { "click": "pt=map-close", "label": "点“返回材料来源”" },
    { "expect": ".map-route", "absent": true },
    { "expect": "pt=craft-sources" },
    { "expect": "[data-pt=src-row][aria-pressed=true]", "text": "荒地纤维丛" },
    { "click": "pt=src-back", "label": "返回配方" },
    { "expect": "pt=craft-sources", "absent": true },
    { "expect": "pt=craft-run", "inView": true },
    { "expect": "[data-recipe=make_wooden_bow].on" },

    { "note": "Q949 A：侧页开着时左列配方可点，点一次即退出侧页并改选；不保留旧来源选择；导航不开工不扣物" },
    { "click": "[data-source-item=fiber]" },
    { "click": "[data-pt=src-row][aria-pressed=false]", "label": "手选另一行（概率来源）" },
    { "expect": "pt=src-detail-title", "text": "概率来源" },
    { "click": "[data-recipe=make_rope]", "label": "左列点“绳索”" },
    { "expect": "pt=craft-sources", "absent": true, "label": "一次退出侧页" },
    { "expect": "[data-recipe=make_rope].on", "label": "改选绳索" },
    { "expect": "pt=craft-run", "inView": true },
    { "expect": "pt=craft-start", "textIs": "开始制作", "disabled": true },
    { "expectNoText": ["行动进行中"], "label": "导航不开工" },
    { "click": "[data-source-item=fiber]", "label": "绳索的植物纤维“查看来源”" },
    { "expect": "[data-pt=src-row][aria-pressed=true]", "text": "荒地纤维丛", "label": "旧手选（概率来源）不保留，按默认重选" },
    { "click": "[data-tab=all]", "label": "侧页开着时左列点“全部配方”分类" },
    { "expect": "pt=craft-sources", "absent": true, "label": "改分类也一次退出侧页" },
    { "expect": "[data-tab=all].on" },
    { "expect": "[data-craft-close]", "label": "制作窗口仍开着" },

    { "note": "ESC 逐层：侧页 → 配方 → 关窗口" },
    { "click": "[data-recipe=make_wooden_bow]" },
    { "click": "[data-source-item=fiber]" },
    { "key": "Escape" },
    { "expect": "pt=craft-sources", "absent": true },
    { "expect": "[data-craft-close]" },
    { "key": "Escape" },
    { "expect": "[data-craft-close]", "absent": true },

    { "note": "普通地图（M）：关闭键照原写法、没有来源高亮" },
    { "key": "m" },
    { "expect": ".map-route" },
    { "expect": "pt=map-close", "text": "关闭" },
    { "expectNoText": ["返回材料来源"] },
    { "expect": ".source-spot", "absent": true },
    { "key": "Escape" },
    { "expect": ".map-route", "absent": true },

    { "note": "Q599 B（放最后，失败不挡前面各项）：悬停有已知地点的来源行，右栏只读显示该地点详情；不改所选、不开图、不出发" },
    { "key": "c" },
    { "click": "[data-recipe=make_wooden_bow]" },
    { "click": "[data-source-item=fiber]" },
    { "hover": "[data-recipe=knife]", "label": "先把指针放到左列石刀上" },
    { "hover": "[data-pt=src-row][aria-pressed=true]", "label": "悬停农野荒地·荒地纤维丛行" },
    { "expect": "[data-peek-shown^=node] h2", "text": "农野荒地", "label": "右栏只读显示农野荒地详情（Q599 B）" },
    { "expect": "[data-pt=src-row][aria-pressed=true]", "text": "荒地纤维丛", "label": "悬停不改所选" },
    { "expect": ".map-route", "absent": true, "label": "不开图" },
    { "key": "Escape" },
    { "key": "Escape" }
  ]
}
